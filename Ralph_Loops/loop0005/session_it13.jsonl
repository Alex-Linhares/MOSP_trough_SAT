earch\"];\n    NS  [label=\"ns(G)\\nnode search\\n[9], [10]\"];\n    PES [label=\"pes(G)\\nprogressive edge search\"];\n    ES  [label=\"es(G)\\nedge search\\n[10]\"];\n  }\n\n  TH  [label=\"θ(G)\\ninterval thickness\\n[5] not held; [6], [9]\"];\n  NU  [label=\"ν(G)\\nnarrowness\\n[11]\"];\n  SB  [label=\"sb(G)\\nsplit bandwidth\\n[12]\"];\n  VSG [label=\"VSG(G)\\nLengauer's vertex game\\n[14]\"];\n  CW  [label=\"cw(G), mcw(G)\\n(modified) cutwidth\\n[14], cited as edge separation\", color=\"#b22222\", fontcolor=\"#b22222\"];\n\n  // exact identities\n  VS  -- PW  [label=\"vs = pw\\nvertexSeparation_eq_pathwidth\"];\n  Z   -- PW  [label=\"Z = pw + 1  [M ≠ 0]\\nmospValue_eq_pathwidth_add_one\"];\n  T   -- Z   [label=\"t = Z  [M ≠ 0]\\ntracks_eq_mospValue\"];\n  L   -- TH  [label=\"tracks = θ(H)  [every net has a gate]\\ntracks_eq_intervalThickness\"];\n  MF  -- T   [label=\"= t\\nfoldTracks_eq_tracks\"];\n  TH  -- PW  [label=\"θ = pw + 1  [V ≠ ∅]\\nintervalThickness_eq_pathwidth_add_one\"];\n  NU  -- PW  [label=\"ν = pw + 1  [V ≠ ∅]\\nnarrowness_eq_pathwidth_add_one\"];\n  MNS -- VS  [label=\"mns = vs + 1  [≥ 1 edge]\\nmonotoneNodeSearch_eq_vertexSeparation_add_one\"];\n  MNS -- TH  [label=\"mns = θ  [≥ 1 edge]\\nmonotoneNodeSearch_eq_intervalThickness\"];\n  VSG -- VS  [label=\"VSG = max(1, vs)\\nvsg_eq_max\"];\n\n  // inequalities and bands, proved\n  SB  -- PW  [style=dashed, label=\"pw ≤ sb ≤ pw + 1\\npathwidth_le_splitBandwidth_le_pathwidth_add_one\"];\n  PES -- VS  [style=dashed, label=\"vs ≤ pes ≤ vs + 2\\nvertexSeparation_le_progressiveEdgeSearch_le_add_two\"];\n  ES  -- VS  [style=dashed, label=\"es ≤ vs + 2\\nedgeSearch_le_vertexSeparation_add_two\"];\n  NS  -- VS  [style=dashed, label=\"ns ≤ vs + 1\\nnodeSearch_le_vertexSeparation_add_one\"];\n\n  // the monotonicity halves: named Props, not proved\n  NS  -- MNS [style=dotted, label=\"ns = mns\\nNodeSearchMonotonicity (gap)\"];\n  ES  -- PES [style=dotted, label=\"es = pes\\nEdgeSearchMonotonicity (gap)\"]