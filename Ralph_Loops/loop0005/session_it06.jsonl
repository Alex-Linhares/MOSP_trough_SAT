table def bagOf (D : PathDecomposition M.mospGraph) (p : Pt) : Fin (D.length + 1) :=\nMOSPGraph.lean:375:theorem customers_subset_bag_bagOf (D : PathDecomposition M.mospGraph) (p : Pt) :\nMOSPGraph.lean:381:theorem activeSet_subset_bag_of_sorted (D : PathDecomposition M.mospGraph)\nMOSPGraph.lean:407:theorem exists_maxOpenStacks_le_width_add_one (D : PathDecomposition M.mospGraph) :\nMOSPGraph.lean:423:theorem mospValue_le_width_add_one (D : PathDecomposition M.mospGraph) :\nMOSPGraph.lean:429:theorem mospValue_le_pathwidth_add_one :\nMOSPGraph.lean:438:theorem one_le_maxOpenStacks (σ : LinearLayout Pt) (h : ∃ c p, M.requires c p) :\nMOSPGraph.lean:447:theorem one_le_mospValue (h : ∃ c p, M.requires c p) : 1 ≤ M.mospValue := by\nMOSPGraph.lean:454:theorem pathwidth_add_one_le_mospValue (h : ∃ c p, M.requires c p) :\nMOSPGraph.lean:464:theorem mospValue_eq_pathwidth_add_one (h : ∃ c p, M.requires c p) :\nMOSPGraph.lean:469:theorem mospValue_eq_zero_of_forall_not (h : ∀ c p, ¬ M.requires c p) : M.mospValue = 0 := by\nMOSPGraph.lean:487:theorem pathwidth_mospGraph_eq_zero_of_forall_not (h : ∀ c p, ¬ M.requires c p) :","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
