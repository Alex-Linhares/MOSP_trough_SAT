\n\nvariable {N Gt : Type*} [Fintype N] [DecidableEq N] [Fintype Gt] [DecidableEq Gt]\n\nnamespace NetGateMatrix\n\nvariable (M : NetGateMatrix N Gt) [DecidableRel M.conn]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
