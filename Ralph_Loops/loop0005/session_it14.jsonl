notoneNodeSearch_star3` — (b): both are `2`.\n* `card_kpD_three`, `kpD_card_le_three`, `kpD_max_iff` — (c): `|D₃| = 3`, the\n  unique maximum; `kp_claim2_fails_star3` — the inclusion (2) fails at every\n  point where exactly the first three vertices have accepted a searcher.\n* `kirousisPapadimitriou_claim2_false` — (d), the headline.\n* `kpStrategy_not_visitsOnce` — the strategy is excluded only by Corollary 2.4's\n  normal form (no vertex visited twice).\n* `kpClearTime_eq`, `dBy_clearTime_card_le`, `dBy_clearTime_eq` — the repair on\n  this example: with the clearing times computed from the game, ordering by\n  decreasing clearing time gives `Dᵢ = {0}` for every `i`, one vertex, which is\n  `ns − 1` and guarded throughout the second half of the run.\n-/\n\nimport MOSPFormalization.Complex.NodeSearch\nimport Mathlib.Tactic.IntervalCases\n\nset_option linter.unusedSectionVars false\n\nnamespace MOSPFormalization\n\nnamespace Complex\n\nopen Finset\n\n/-! ### Simulating a recontamination-free run with finite sets -/\n\nsection Sim\n\nvariable {V : Type*} [Fintype V] [DecidableEq V]\nvariable (G : SimpleGraph V) [DecidableRel G.Adj]\n\ninstance (S : Finset V) (e : Sym2 V) : Decidable (Guarded S e) := by\n  unfold Guarded; infer_instance\n\n82:def guardsAfter (S : Finset V) (ms : List (SearchMove V)) : Finset V :=\n86:def guardsCost : Finset V → List (SearchMove V) → ℕ\n90:theorem runSearch_guards (s : SearchState V) (ms : List (SearchMove V)) :\n96:theorem searchCost_eq_guardsCost (s : SearchState V) (ms : List (SearchMove V)) :\n108:def SafeMove (C : Finset (Sym2 V)) : SearchMove V → Prop\n116:def simStep (S : Finset V) (C : Finset (Sym2 V)) (m : SearchMove V) : Finset (Sym2 V) :=\n120:def SimOK : Finset V → Finset (Sym2 V) → List (SearchMove V) → Prop\n132:def simFinal : Finset V → Finset (Sym2 V) → List (SearchMove V) → Finset (Sym2 V)\n136:theorem step_of_safe {s : SearchState V} {C : Finset (Sym2 V)} (hC : s.contaminated = ↑C)\n162:theorem sim_correct {s : SearchState V} {C : Finset (Sym2 V)} (hC : s.contaminated = ↑C)\n175:theorem contaminated_eq_of_searchCost_le_one {s : SearchState V}\n201:theorem two_le_of_isNodeSearch {u v : V} (huv : G.Adj u v) {k : ℕ}\n214:def SearchMove.placesOn (v : V) : SearchMove V → Bool\n220:def firstAccept (ms : List (SearchMove V)) (v : V) : ℕ := ms.findIdx (SearchMove.placesOn v)\n224:def kpLayout (ms : List (SearchMove V)) (v : V) : ℕ :=\n228:def kpD (ms : List (SearchMove V)) (i : ℕ) : Finset V :=\n232:def acceptedBy (ms : List (SearchMove V)) (t : ℕ) : Finset V :=\n237:def VisitsOnce (ms : List (SearchMove V)) : Prop :=\n253:def kpStrategy : List (SearchMove (Fin 4)) :=\n257:theorem kpStrategy_simOK : SimOK star3 ∅ star3.edgeFinset kpStrategy := by decide\n259:theorem kpStrategy_simFinal : simFinal ∅ star3.edgeFinset kpStrategy = ∅ := by decide\n262:theorem kpStrategy_noRecontamination_and_clears :\n272:theorem searchCost_kpStrategy : searchCost star3 (searchInit star3) kpStrategy = 2 := by\n276:theorem kpStrategy_isMonotoneNodeSearch : IsMonotoneNodeSearch star3 2 kpStrategy :=\n280:theorem star3_adj_01 : star3.Adj 0 1 := by decide\n283:theorem nodeSearch_star3 : nodeSearch star3 = 2 := by\n290:theorem monotoneNodeSearch_star3 : monotoneNodeSearch star3 = 2 := by\n299:theorem kpStrategy_optimal :\n308:theorem kpStrategy_not_visitsOnce : ¬ VisitsOnce kpStrategy := by decide\n311:theorem kpLayout_kpStrategy :\n315:theorem kpD_one : kpD star3 kpStrategy 1 = {1} := by decide\n316:theorem kpD_two : kpD star3 kpStrategy 2 = {1, 2} := by decide\n317:theorem kpD_three : kpD star3 kpStrategy 3 = {1, 2, 3} := by decide\n320:theorem card_kpD_three : (kpD star3 kpStrategy 3).card = 3 := by decide\n323:theorem kpD_card_le_three : ∀ i, 1 ≤ i → i < 4 →\n327:theorem kpD_max_iff (i₀ : ℕ) (h1 : 1 ≤ i₀) (h4 : i₀ < 4) :\n337:theorem guards_take (t : ℕ) :\n344:theorem acceptedBy_eq_iff (t : ℕ) :\n362:theorem kp_claim2_fails_star3 (t : ℕ)\n372:theorem contaminated_take (t : ℕ) :\n389:def kpClearKey : Fin 4 → ℕ := ![12, 8, 10, 12]\n391:theorem kpClearTime_eq (v : Fin 4) : kpClearTime v = kpClearKey v := by\n407:def layoutBy (key : Fin 4 → ℕ) (v : Fin 4) : ℕ := (univ.filter fun w => key w < key v).card + 1\n410:def dBy (key : Fin 4 → ℕ) (i : ℕ) : Finset (Fin 4) :=\n416:theorem dBy_clearTime_card_le (i : ℕ) :\n438:theorem dBy_clearTime_eq (i : ℕ) (h1 : 1 ≤ i) (h4 : i < 4) :\n454:theorem kirousisPapadimitriou_claim2_false :\n623189e9b Lean: the gap in Kirousis & Papadimitriou (1986)'s proof of ns >= vs + 1, proved; proof_reductions.md corrected","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
