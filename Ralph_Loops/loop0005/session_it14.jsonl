ixSet_iff, gt_iff_lt, not_le]","+    unfold vertexSepAt","+    rw [hact]","+    exact hX.width _ (hτn v)","+  exact (vertexSeparation_le_vertexSepOfLayout G σ).trans hvs","+"," end Complex"," "," end MOSPFormalization"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/lean/MOSPFormalization/Complex/NodeMonotonicity.lean"]}}}
