\"].nunique() == 1","+    assert (d5[\"optimum\"] == 6).all()","+    matrix = density_matrix(frame, \"fixed\", 1, \"classes\")","+    assert list(matrix.columns) == [\"d\", 6]","+    assert matrix.loc[matrix[\"d\"] == 5.0, 6].iloc[0] == \"1/4\"","+    complete = density_matrix(frame, \"fixed\", 1, \"complete\")","+    assert complete.loc[complete[\"d\"] == 5.0, 6].iloc[0] == \"100%\"","+    decomposable = density_matrix(frame, \"fixed\", 1, \"decomposable\")","+    assert decomposable.loc[decomposable[\"d\"] == 5.0, 6].iloc[0] == \"0%\"","+    text = campaign_tables(frame)","+    assert \"core-hours\" in text and \"m = 2n\" in text and \"m = 1n\" in text","+    assert pd.isna(frame[\"nodes_default\"]).sum() == 0"]}]},{"filePath":"/home/al/dev/MOSP/learning/data/ensemble/solutions/ens_b_n25_m25_p0.2_i110.json","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":36,"lines":["+{","+  \"instance_name\": \"ens_b_n25_m25_p0.2_i110\",","+  \"n_customers\": 25,","+  \"n_patterns\": 25,","+  \"mosp_value\": 13,","+  \"ordering\": [","+    15,","+    0,","+    5,","+    13,","+    17,","+    21,","+    23,","+    9,","+    20,","+    19,","+    4,","+    11,","+    16,","+    1,","+    12,","+    14,","+    3,","+    22,","+    6,","+    2,","+    10,","+    7,","+    8,","+    18,","+    24","+  ],","+  \"provenance\": \"certified:bound\",","+  \"lower_bound\": 13,","+  \"lower_bound_source\": \"degeneracy\"","+}"]}],"created":true},{"filePath":"/home/al/dev/MOSP/learning/data/ensemble/solutions/ens_b_n25_m25_p0.2_i108.json","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":36,"lines":["+{","+  \"instance_name\": \"ens_b_n25_m25_p0.2_i108\",","+  \"n_customers\": 25,","+  \"n_patterns\": 25,","+  \"mosp_value\": 16,","+  \"ordering\": [","+    1,","+    11,","+    8,","+    10,","+    2,","+    19,","+    22,","+    13,","+    21,","+    0,","+    4,","+    7,","+    23,","+    18,","+    5,","+    17,","+    24,","+    14,","+    3,","+    15,","+    16,",