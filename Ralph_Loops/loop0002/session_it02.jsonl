 floatfmt: str = \".3g\") -> str:\n496:def tables(frame: pd.DataFrame, hours: float = 2.5, workers: int = 16) -> str:\n521:def main() -> None:\n522:    parser = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])\n523:    parser.add_argument(\"--pilot\", action=\"store_true\", help=\"run the §9 pilot cells\")\n524:    parser.add_argument(\"--extension\", action=\"store_true\",\n526:    parser.add_argument(\"--cells\", nargs=\"*\", default=[],\n528:    parser.add_argument(\"--per-cell\", type=int, default=PILOT_PER_CELL)\n529:    parser.add_argument(\"--workers\", type=int, default=16)\n530:    parser.add_argument(\"--deadline\", type=float, default=60.0,\n532:    parser.add_argument(\"--solve-budget\", type=float, default=600.0,\n534:    parser.add_argument(\"--csv\", type=Path, default=RESULTS_CSV)\n535:    parser.add_argument(\"--write-instances\", action=\"store_true\",\n538:    parser.add_argument(\"--verify-manifest\", type=int, default=None, metavar=\"N\",\n540:    parser.add_argument(\"--tables-only\", action=\"store_true\")\n541:    parser.add_argument(\"--hours\", type=float, default=2.5)\n542:    parser.add_argument(\"--out\", type=Path, default=DEFAULT_OUT)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
