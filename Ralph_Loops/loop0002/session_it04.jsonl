edupe(frame: pd.DataFrame) -> pd.DataFrame:\nlearning/ensemble.py:359:def _cell_order(frame: pd.DataFrame) -> pd.DataFrame:\nlearning/ensemble.py:363:def cost_table(frame: pd.DataFrame) -> pd.DataFrame:\nlearning/ensemble.py:391:def cost_by_size(frame: pd.DataFrame) -> pd.DataFrame:\nlearning/ensemble.py:408:def config_ratio(frame: pd.DataFrame) -> pd.DataFrame:\nlearning/ensemble.py:424:def audit(frame: pd.DataFrame) -> dict[str, int]:\nlearning/ensemble.py:445:def affordable(frame: pd.DataFrame, cells: list[Cell], hours: float = 2.5,\nlearning/ensemble.py:488:def item02_cells(sizes=ITEM02_N, ratios=ITEM02_M_RATIOS, ds=ITEM02_D, ps=ITEM02_P) -> list[Cell]:\nlearning/ensemble.py:508:def campaign_summary(frame: pd.DataFrame) -> pd.DataFrame:\nlearning/ensemble.py:529:def density_matrix(frame: pd.DataFrame, generator: str, ratio: int,\nlearning/ensemble.py:559:def campaign_tables(frame: pd.DataFrame) -> str:\nlearning/ensemble.py:576:def _md(frame: pd.DataFrame, floatfmt: str = \".3g\") -> str:\nlearning/ensemble.py:580:def tables(frame: pd.DataFrame, hours: float = 2.5, workers: int = 16) -> str:\nlearning/ensemble.py:606:def main() -> None:\n----\n     1\tinstance_name\n     2\tcell\n     3\tgenerator\n     4\tn\n     5\tm\n     6\tparam\n     7\tindex\n     8\tseed\n     9\tsolve_seconds\n    10\toptimum\n    11\tsolve_nodes\n    12\tsolve_proof\n    13\tcertified\n    14\twitness_ok\n    15\tstatus_default\n    16\tnodes_default\n    17\tseconds_default\n    18\tstatus_csearch\n    19\tnodes_csearch\n    20\tseconds_csearch\n    21\tn_customers\n    22\tn_patterns\n    23\tn_ones\n    24\tdensity\n    25\tshape_ratio\n    26\tdistinct_col_frac\n    27\tdistinct_row_frac\n    28\tdominated_col_frac\n    29\trow_min\n    30\trow_max\n    31\trow_mean\n    32\trow_std\n    33\tcol_min\n    34\tcol_max\n    35\tcol_mean\n    36\tcol_std\n    37\tcol_max_frac\n    38\tg_nodes\n    39\tg_edges\n    40\tg_density\n    41\tg_components\n    42\tg_largest_comp_frac\n    43\tg_clustering\n    44\tg_degeneracy\n    45\tg_deg_min\n    46\tg_deg_max\n    47\tg_deg_mean\n    48\tg_deg_std\n    49\tlb_trivial\n    50\tlb_contraction\n    51\tlb_best\n    52\tub_mcn\n    53\tub_cs_dfs\n    54\tub_best\n    55\tbound_gap\n    56\tbound_gap_frac\n    57\ttw_min_fill\n    58\ttw_min_degree\n    59\tbw_rcm\n    60\tspectral_radius\n    61\tfiedler\n    62\tfiedler_lcc\n    63\tcc_products\n    64\tcc_greedy\n    65\tsep_size\n    66\tsep_frac\n    67\trig_edge_prob\n    68\trig_deg_expected\n    69\trig_density_ratio\n    70\tfeature_seconds\n    71\tmatrix_digest\n    72\tgraph_cert\n    73\tbipartite_cert\n    74\twl_hash\n    75\taut_order\n    76\tcomplete_graph\n    77\ttotal_seconds\n37801 learning/data/ensemble/results.csv","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
