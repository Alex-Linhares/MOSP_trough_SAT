ashEditDiff":{"files":[{"filePath":"/home/al/dev/MOSP/Ralph_Loops/loop0002/session_it04.jsonl","hunks":[{"oldStart":323,"oldLines":3,"newStart":323,"newLines":7,"lines":[" {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Ahk4hw7K7Zi7fTNyFrhEgr\",\"type\":\"tool_result\",\"content\":\"ok\\n.......                                                                  [100%]\\n7 passed in 3.79s\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"c7f6ac10-5cdb-425b-85a9-2cf007661e3c\",\"uuid\":\"b2960818-fda0-444a-9bf4-c5b8bd03a003\",\"timestamp\":\"2026-09-26T06:22:01.989Z\",\"tool_use_result\":{\"stdout\":\"ok\\n.......                                                                  [100%]\\n7 passed in 3.79s\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false,\"bashEditDiff\":{\"files\":[{\"filePath\":\"/home/al/dev/MOSP/learning/concentration.py\",\"hunks\":[{\"oldStart\":476,\"oldLines\":6,\"newStart\":476,\"newLines\":86,\"lines\":[\" \",\" \",\" # ----------------------------------------------------------------------------\",\"+# structural forms: linear in n with a slope that saturates in the degree\",\"+# ----------------------------------------------------------------------------\",\"+\",\"+STRUCTURAL = {\",\"+    # name: (function of (n, D, *params), initial params, printed form)\",\"+    \\\"a + n·D/(D + c)\\\": (lambda n, D, a, c: a + n * D / (D + c), (3.0, 20.0), \\\"a + n · D / (D + c)\\\"),\",\"+    \\\"a + b·n·D/(D + c)\\\": (lambda n, D, a, b, c: a + b * n * D / (D + c), (3.0, 1.0, 20.0), \\\"a + b · n · D / (D + c)\\\"),\",\"+    \\\"a + n·(1 − exp(−D/τ))\\\": (lambda n, D, a, t: a + n * (1 - np.exp(-D / t)), (3.0, 20.0), \\\"a + n · (1 − exp(−D / τ))\\\"),\",\"+    \\\"a + n·√D/(√D + c)\\\": (lambda n, D, a, c: a + n * np.sqrt(D) / (np.sqrt(D) + c), (3.0, 5.0), \\\"a + n · √D / (√D + c)\\\"),\",\"+}\",\"+\",\"+\",\"+def _fit_form(fn, n, D, y, p0):\",\"+    \\\"\\\"\\\"Least squares start, then least absolute deviation by Nelder–Mead.\\\"\\\"\\\"\",\"+    from scipy.optimize import curve_fit, minimize\",\"+    try:\",\"+        popt, _ = curve_fit(lambda x, *p: fn(x[0], x[1], *p), np.stack([n, D]), y, p0=p0, maxfev=20000)\",\"+    except RuntimeError:\",\"+        popt = np.asarray(p0, dtype=float)\",\"+    res = minimize(lambda p: np.abs(fn(n, D, *p) - y).mean(), popt, method=\\\"Nelder-Mead\\\",\",\"+                   options={\\\"xatol\\\": 1e-6, \\\"fatol\\\": 1e-8, \\\"maxiter\\\": 4000})\",\"+    return res.x if res.success or np.isfinite(res.fun) else popt\",\"+\",\"+\",\"+def structural_fits(cells: pd.DataFrame, frame: pd.DataFrame) -> dict:\",\"+    \\\"\\\"\\\"`E[opt] ≈ a + n · s(D)`, `D = deg_nom` the nominal mean degree of the\",\"+    random intersection graph, with a saturating slope `s(D) → 1` as `D → ∞`\",\"+    (the complete graph) and `s(D) → 0` as `D → 0`. Four forms, each with two\",\"+    or three constants fitted by least absolute deviation on the cell means;\",\"+    scored leave-one-size-out, extrapolated from `n ≤ 30` to 35 and 40, and\",\"+    the best form's residual on every instance with the counts below and\",\"+    above the optimum. **Not a bound.** The forms are chosen by hand from the\",\"+    slope-by-degree table, so choosing among four is the only selection.\\\"\\\"\\\"\",\"+    n = cells[\\\"n\\\"].to_numpy(dtype=float)\",\"+    D = cells[\\\"deg_nom\\\"].to_numpy(dtype=float)\",\"+    y = cells[\\\"mean\\\"].to_numpy(dtype=float)\",\"+    folds = _n_folds(n)\",\"+    rows = []\",\"+    fitted = {}\",\"+    for name, (fn, p0, printed) in STRUCTURAL.items():\",\"+        pred = np.zeros_like(y)\",\"+        for tr, te in folds:\",\"+            p = _fit_form(fn, n[tr], D[tr], y[tr], p0)\",\"+            pred[te] = fn(n[te], D[te], *p)\",\"+        train = n <= 30\",\"+        p_small = _fit_form(fn, n[train], D[train], y[train], p0)\",\"+        ex = _scores(fn(n[~train], D[~train], *p_small), y[~train])\",\"+        p_all = _fit_form(fn, n, D, y, p0)\",\"+        fitted[name] = p_all\",\"+        rows.append({\\\"form\\\": printed, \\\"constants (all cells)\\\": \\\", \\\".join(f\\\"{v:.3g}\\\" for v in p_all),\",\"+                     \\\"mae (held-out n)\\\": _scores(pred, y)[\\\"mae\\\"], \\\"exact (held-out n)\\\": _scores(pred, y)[\\\"exact\\\"],\",\"+                     \\\"mae n≤30 → 35,40\\\": ex[\\\"mae\\\"], \\\"bias n≤30 → 35,40\\\": float((fn(n[~train], D[~train], *p_small) - y[~train]).mean()),\",\"+                     \\\"mae in-sample\\\": _scores(fn(n, D, *p_all), y)[\\\"mae\\\"]})\",\"+    table = pd.DataFrame(rows).sort_values(\\\"mae (held-out n)\\\").reset_index(drop=True)\",\"+    best = table.iloc[0][\\\"form\\\"]\",\"+    best_name = next(k for k, v in STRUCTURAL.items() if v[2] == best)\",\"+    fn, _, printed = STRUCTURAL[best_name]\",\"+    p_all = fitted[best_name]\",\"+    inst = nominal_features(frame[\\\"n\\\"], frame[\\\"m\\\"], frame[\\\"generator\\\"], frame[\\\"param\\\"])\",\"+    opt = frame[\\\"optimum\\\"].to_numpy(dtype=float)\",\"+    pred_i = fn(inst[\\\"n\\\"], inst[\\\"deg_nom\\\"], *p_all)\",\"+    err = pred_i - opt\",\"+    r = np.round(pred_i)\",\"+    inst_row = {\\\"estimate\\\": f\\\"{printed} with ({', '.join(f'{v:.3g}' for v in p_all)})\\\", **_scores(pred_i, opt),\",\"+                \\\"below\\\": int((r < opt).sum()), \\\"above\\\": int((r > opt).sum()),\",\"+                \\\"max_below\\\": float((opt - r).max()), \\\"max_above\\\": float((r - opt).max()),\",\"+                **{f\\\"q{int(q * 100):02d}\\\": float(np.quantile(err, q)) for q in (0.05, 0.25, 0.5, 0.75, 0.95)}}\",\"+    by_n = pd.DataFrame({\\\"n\\\": frame[\\\"n\\\"], \\\"err\\\": err}).groupby(\\\"n\\\")[\\\"err\\\"].agg(\",\"+        mae=lambda s: s.abs().mean(), bias=\\\"mean\\\", exact=lambda s: (s.abs() <= 0.5).mean()).reset_index()\",\"+    by_series = pd.DataFrame({\\\"series\\\": frame[\\\"series\\\"], \\\"err\\\": err}).groupby(\\\"series\\\")[\\\"err\\\"].agg(\",\"+        mae=lambda s: s.abs().mean(), bias=\\\"mean\\\").reset_index()\",\"+    # the slope s(D) the best form implies, at a few degrees\",\"+    grid = np.array([2, 4, 9, 16, 25, 36, 64, 100, 200], dtype=float)\",\"+    slope_curve = pd.DataFrame({\\\"D (nominal mean degree)\\\": grid,\",\"+                                \\\"implied asymptotic optimum / n\\\": [float(fn(1e6, d, *p_all) / 1e6) for d in grid]})\",\"+    return {\\\"table\\\": table, \\\"best\\\": best_name, \\\"constants\\\": p_all, \\\"instance_residual\\\": pd.DataFrame([inst_row]),\",\"+            \\\"by_n\\\": by_n, \\\"by_series\\\": by_series, \\\"slope_curve\\\": slope_curve}\",\"+\",\"+\",\"+# ----------------------------------------------------------------------------\",\" # the sandwich and pw − tw on the ensemble\",\" # ----------------------------------------------------------------------------\",\" \"]},{\"oldStart\":591,\"oldLines\":7,\"newStart\":671,\"newLines\":7,\"lines\":[\"     ax.set_yscale(\\\"log\\\")\",\"     ax.set_xlabel(\\\"n (customers)\\\")\",\"     ax.set_ylabel(\\\"CV of the optimum (log)\\\")\",\"-    ax.set_title(\\\"(b) Bernoulli p, m = n: flat only below the giant component\\\", fontsize=10, loc=\\\"left\\\")\",\"+    ax.set_title(\\\"(b) Bernoulli p, m = n: flat only at or below the giant-component threshold\\\", fontsize=10, loc=\\\"left\\\")\",\"     ax.legend(fontsize=7, ncol=2, frameon=False)\",\"     # (c) E[opt] against n, fixed m = n\",\"     ax = axes[1, 0]\"]},{\"oldStart\":652,\"oldLines\":6,\"newStart\":732,\"newLines\":7,\"lines\":[\"     lin = linearity(cells)\",\"     sbd = slope_by_degree(lin)\",\"     fm = formula(cells, frame, nested=nested, workers=workers)\",\"+    st = structural_fits(cells, frame)\",\"     sw = sandwich(frame)\",\"     pt = pw_minus_tw(frame)\",\" \"]},{\"oldStart\":701,\"oldLines\":6,\"newStart\":782,\"newLines\":16,\"lines\":[\"     parts.append(_md(fm[\\\"residual_by_n\\\"], \\\".3f\\\"))\",\"     parts.append(\\\"\\\\nMonomial residual by series and regime (of the cell at its n):\\\\n\\\")\",\"     parts.append(_md(fm[\\\"residual_by_series_regime\\\"], \\\".3f\\\"))\",\"+    parts.append(\\\"\\\\n## Structural forms: E[opt] ≈ a + n · s(D), D the nominal mean degree (**not a bound**)\\\\n\\\")\",\"+    parts.append(_md(st[\\\"table\\\"], \\\".3f\\\"))\",\"+    parts.append(f\\\"\\\\nBest form `{st['best']}`, constants {tuple(round(float(v), 3) for v in st['constants'])}; per-instance residual on all instances:\\\\n\\\")\",\"+    parts.append(_md(st[\\\"instance_residual\\\"], \\\".3f\\\"))\",\"+    parts.append(\\\"\\\\nby n:\\\\n\\\")\",\"+    parts.append(_md(st[\\\"by_n\\\"], \\\".3f\\\"))\",\"+    parts.append(\\\"\\\\nby series:\\\\n\\\")\",\"+    parts.append(_md(st[\\\"by_series\\\"], \\\".3f\\\"))\",\"+    parts.append(\\\"\\\\nthe slope s(D) = lim optimum / n the best form implies:\\\\n\\\")\",\"+    parts.append(_md(st[\\\"slope_curve\\\"], \\\".3f\\\"))\",\"     parts.append(\\\"\\\\n## The sandwich on the ensemble (constants fixed by hand)\\\\n\\\")\",\"     parts.append(_md(sw[\\\"table\\\"], \\\".3f\\\"))\",\"     parts.append(\\\"\\\\n\\\" + \\\"\\\\n\\\".join(f\\\"- {k}: {v}\\\" for k, v in sw[\\\"checks\\\"].items()))\"]},{\"oldStart\":736,\"oldLines\":6,\"newStart\":827,\"newLines\":12,\"lines\":[\"         \\\"formula_cell_mae\\\": float(fm[\\\"monomials\\\"].iloc[0][\\\"mae\\\"]),\",\"         \\\"nested_cell_mae\\\": fm[\\\"nested\\\"][\\\"monomial\\\"][\\\"mae\\\"] if \\\"nested\\\" in fm else None,\",\"         \\\"instance_mae\\\": fm[\\\"instance_residuals\\\"].set_index(\\\"estimate\\\")[\\\"mae\\\"].round(3).to_dict(),\",\"+        \\\"structural\\\": {\\\"best\\\": st[\\\"best\\\"], \\\"constants\\\": [round(float(v), 4) for v in st[\\\"constants\\\"]],\",\"+                       \\\"cell_mae_heldout_n\\\": round(float(st[\\\"table\\\"].iloc[0][\\\"mae (held-out n)\\\"]), 3),\",\"+                       \\\"extrapolation_mae\\\": round(float(st[\\\"table\\\"].iloc[0][\\\"mae n≤30 → 35,40\\\"]), 3),\",\"+                       \\\"instance_mae\\\": round(float(st[\\\"instance_residual\\\"].iloc[0][\\\"mae\\\"]), 3)},\",\"+        \\\"pw_minus_tw\\\": {\\\"certified_pw_gt_tw_share_by_n\\\": pt[\\\"by_n\\\"].set_index(\\\"n\\\")[\\\"min(tw_mf, tw_md): res > 0\\\"].round(3).to_dict(),\",\"+                        \\\"res_tw_max\\\": float(pt[\\\"by_n\\\"][\\\"res_tw max\\\"].max())},\",\"         \\\"lambda_median_by_n\\\": sw[\\\"lambda_by_n\\\"].set_index(\\\"n\\\")[\\\"median\\\"].round(3).to_dict(),\",\"         \\\"lambda_spearman\\\": {k: round(v, 2) for k, v in sw[\\\"lambda_spearman\\\"].items()},\",\"     }\"]}]},{\"filePath\":\"/home/al/dev/MOSP/tests/test_concentration.py\",\"hunks\":[{\"oldStart\":1,\"oldLines\":0,\"newStart\":1,\"newLines\":117,\"lines\":[\"+\\\"\\\"\\\"Guards on the concentration study (`learning.concentration`).\",\"+\",\"+Every quantity the report quotes is computed here on a frame small enough to\",\"+check by hand: the nominal random-intersection-graph features, the per-cell\",\"+moments, the kill verdict, the linear law, the sandwich position λ, the\",\"+pathwidth-minus-treewidth bracket, and the saturating structural fit on\",\"+exact synthetic data.\",\"+\\\"\\\"\\\"\",\"+\",\"+import numpy as np\",\"+import pandas as pd\",\"+import pytest\",\"+\",\"+from learning import hardness_map\",\"+from learning.concentration import (\",\"+    cell_stats,\",\"+    kill_verdict,\",\"+    linearity,\",\"+    nominal_features,\",\"+    prepare,\",\"+    regime_of,\",\"+    structural_fits,\",\"+)\",\"+\",\"+\",\"+def _frame(rows: list[dict]) -> pd.DataFrame:\",\"+    \\\"\\\"\\\"A campaign-shaped frame from a few hand-written rows.\\\"\\\"\\\"\",\"+    base = {\\\"generator\\\": \\\"fixed\\\", \\\"n\\\": 10, \\\"m\\\": 10, \\\"param\\\": 2, \\\"nodes_default\\\": 1, \\\"nodes_csearch\\\": 1,\",\"+            \\\"g_components\\\": 1, \\\"g_largest_comp_frac\\\": 1.0, \\\"col_mean\\\": 2.0, \\\"density\\\": 0.2,\",\"+            \\\"g_deg_mean\\\": 2.0, \\\"ub_best\\\": 3, \\\"lb_best\\\": 3, \\\"g_degeneracy\\\": 2, \\\"bw_rcm\\\": 2,\",\"+            \\\"tw_min_fill\\\": 2, \\\"tw_min_degree\\\": 2, \\\"complete_graph\\\": False, \\\"g_deg_std\\\": 0.0,\",\"+            \\\"g_density\\\": 0.5, \\\"n_customers\\\": 10, \\\"optimum\\\": 3}\",\"+    out = []\",\"+    for i, r in enumerate(rows):\",\"+        d = {**base, **r}\",\"+        d.setdefault(\\\"instance_name\\\", f\\\"i{i}\\\")\",\"+        d.setdefault(\\\"graph_cert\\\", f\\\"c{i}\\\")\",\"+        d[\\\"cell\\\"] = f\\\"{d['generator']}:{d['n']}:{d['m']}:{d['param']}\\\"\",\"+        out.append(d)\",\"+    return prepare(hardness_map.prepare(pd.DataFrame(out)))\",\"+\",\"+\",\"+def test_nominal_features_by_hand():\",\"+    f = nominal_features([4, 10], [1, 20], [\\\"bernoulli\\\", \\\"fixed\\\"], [0.5, 2])\",\"+    assert f[\\\"p_nom\\\"][0] == 0.5 and f[\\\"q_nom\\\"][0] == pytest.approx(0.25)   # 1 − (1 − ¼)^1\",\"+    assert f[\\\"deg_nom\\\"][0] == pytest.approx(3 * 0.25)\",\"+    assert f[\\\"p_nom\\\"][1] == pytest.approx(0.2) and f[\\\"d_nom\\\"][1] == pytest.approx(2.0)\",\"+    assert f[\\\"k_nom\\\"][1] == pytest.approx(4.0)                              # 20 products × 0.2\",\"+\",\"+\",\"+def test_cell_moments_by_hand():\",\"+    frame = _frame([{\\\"optimum\\\": 2}, {\\\"optimum\\\": 2}, {\\\"optimum\\\": 4}, {\\\"optimum\\\": 4}])\",\"+    cells = cell_stats(frame)\",\"+    assert len(cells) == 1\",\"+    c = cells.iloc[0]\",\"+    assert c[\\\"mean\\\"] == 3.0\",\"+    assert c[\\\"std\\\"] == pytest.approx(np.sqrt(4 / 3))\",\"+    assert c[\\\"cv\\\"] == pytest.approx(np.sqrt(4 / 3) / 3)\",\"+    assert c[\\\"mode_share\\\"] == 0.5 and c[\\\"min\\\"] == 2 and c[\\\"max\\\"] == 4\",\"+    assert c[\\\"opt_frac\\\"] == pytest.approx(0.3)\",\"+\",\"+\",\"+def test_kill_verdict_fires_only_at_largest_n():\",\"+    wide = [{\\\"n\\\": 40, \\\"optimum\\\": v} for v in (2, 2, 4, 4)]          # cv 0.385 at n = 40\",\"+    narrow = [{\\\"n\\\": 40, \\\"optimum\\\": v} for v in (3, 3, 3, 4)]        # cv 0.154\",\"+    early = [{\\\"n\\\": 10, \\\"optimum\\\": v} for v in (2, 2, 4, 4)]\",\"+    assert kill_verdict(cell_stats(_frame(wide)))[\\\"kill_fires\\\"]\",\"+    v = kill_verdict(cell_stats(_frame(narrow + early)))\",\"+    assert not v[\\\"kill_fires\\\"] and v[\\\"cells_above_total\\\"] == 1\",\"+\",\"+\",\"+def test_linearity_recovers_an_exact_line():\",\"+    rows = []\",\"+    for n in (15, 20, 25, 30, 40):\",\"+        for i in range(3):\",\"+            rows.append({\\\"n\\\": n, \\\"m\\\": n, \\\"param\\\": 3, \\\"optimum\\\": 3 + 0.2 * n + (i - 1) * 0.0, \\\"col_mean\\\": 3.0})\",\"+    lin = linearity(cell_stats(_frame(rows)))\",\"+    assert len(lin) == 1\",\"+    assert lin.iloc[0][\\\"slope\\\"] == pytest.approx(0.2)\",\"+    assert lin.iloc[0][\\\"intercept\\\"] == pytest.approx(3.0)\",\"+    assert lin.iloc[0][\\\"r2\\\"] == pytest.approx(1.0)\",\"+    assert lin.iloc[0][\\\"regime\\\"] == \\\"super\\\"\",\"+\",\"+\",\"+def test_regime_of_by_hand():\",\"+    assert regime_of({\\\"opt_frac\\\": 1.0, \\\"lcc_frac\\\": 1.0}) == \\\"complete\\\"\",\"+    assert regime_of({\\\"opt_frac\\\": 0.3, \\\"lcc_frac\\\": 0.2}) == \\\"sub\\\"\",\"+    assert regime_of({\\\"opt_frac\\\": 0.3, \\\"lcc_frac\\\": 0.7}) == \\\"critical\\\"\",\"+    assert regime_of({\\\"opt_frac\\\": 0.3, \\\"lcc_frac\\\": 0.99}) == \\\"super\\\"\",\"+\",\"+\",\"+def test_lambda_and_the_treewidth_bracket_by_hand():\",\"+    frame = _frame([\",\"+        {\\\"optimum\\\": 5, \\\"g_degeneracy\\\": 2, \\\"bw_rcm\\\": 6, \\\"tw_min_fill\\\": 3, \\\"tw_min_degree\\\": 2},\",\"+        {\\\"optimum\\\": 3, \\\"g_degeneracy\\\": 2, \\\"bw_rcm\\\": 2, \\\"tw_min_fill\\\": 2, \\\"tw_min_degree\\\": 2},\",\"+    ])\",\"+    a, b = frame.iloc[0], frame.iloc[1]\",\"+    assert a[\\\"lam\\\"] == pytest.approx(0.5)                # (5 − 1 − 2) / (6 − 2)\",\"+    assert not a[\\\"forced\\\"] and b[\\\"forced\\\"] and np.isnan(b[\\\"lam\\\"])\",\"+    assert a[\\\"res_tw\\\"] == 1 and a[\\\"res_tw2\\\"] == 2 and a[\\\"res_deg\\\"] == 2   # res_tw ≤ pw − tw ≤ res_deg\",\"+    assert b[\\\"res_tw\\\"] == 0 and b[\\\"res_deg\\\"] == 0\",\"+\",\"+\",\"+def test_structural_fit_recovers_exact_constants():\",\"+    rows = []\",\"+    for n in (15, 20, 25, 30, 35, 40):\",\"+        for d in (2, 3, 5, 8):\",\"+            f = nominal_features([n], [n], [\\\"fixed\\\"], [d])\",\"+            mean = 2.0 + n * f[\\\"deg_nom\\\"][0] / (f[\\\"deg_nom\\\"][0] + 10.0)\",\"+            for i in range(2):\",\"+                rows.append({\\\"n\\\": n, \\\"m\\\": n, \\\"param\\\": d, \\\"optimum\\\": mean, \\\"col_mean\\\": float(d)})\",\"+    frame = _frame(rows)\",\"+    st = structural_fits(cell_stats(frame), frame)\",\"+    assert st[\\\"best\\\"] == \\\"a + n·D/(D + c)\\\"\",\"+    assert st[\\\"constants\\\"][0] == pytest.approx(2.0, abs=1e-3)\",\"+    assert st[\\\"constants\\\"][1] == pytest.approx(10.0, abs=1e-2)\",\"+    assert st[\\\"table\\\"].iloc[0][\\\"mae (held-out n)\\\"] < 1e-3\"]}],\"created\":true},{\"filePath\":\"/home/al/dev/MOSP/Ralph_Loops/loop0002/session_it04.jsonl\",\"hunks\":[{\"oldStart\":318,\"oldLines\":3,\"newStart\":318,\"newLines\":5,\"lines\":[\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-fable-5-1\\\",\\\"id\\\":\\\"msg_011CfRZsQVho76GcaPwmiwW5\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"thinking\\\",\\\"thinking\\\":\\\"\\\",\\\"signature\\\":\\\"\\\"}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":32,\\\"cache_creation_input_tokens\\\":6256,\\\"cache_read_input_tokens\\\":157397,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":6256,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":6,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"c7f6ac10-5cdb-425b-85a9-2cf007661e3c\\\",\\\"uuid\\\":\\\"15754329-d829-4ebc-ae73-e2ebdcb85b85\\\",\\\"timestamp\\\":\\\"2026-09-26T06:21:00.906Z\\\",\\\"request_id\\\":\\\"req_011CfRZsPKWy6zJkjDuwR3ok\\\"}\",\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-fable-5-1\\\",\\\"id\\\":\\\"msg_011CfRZsQVho76GcaPwmiwW5\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Now the saturating structural fit and the tests, which are independent of each other.\\\"}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":32,\\\"cache_creation_input_tokens\\\":6256,\\\"cache_read_input_tokens\\\":157397,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":6256,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":6,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"c7f6ac10-5cdb-425b-85a9-2cf007661e3c\\\",\\\"uuid\\\":\\\"4a864057-0182-490d-b2ee-eebfdc9f8421\\\",\\\"timestamp\\\":\\\"2026-09-26T06:21:00.908Z\\\",\\\"request_id\\\":\\\"req_011CfRZsPKWy6zJkjDuwR3ok\\\"}\",\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-fable-5-1\\\",\\\"id\\\":\\\"msg_011CfRZsQVho76GcaPwmiwW5\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"tool_use\\\",\\\"id\\\":\\\"toolu_01Ahk4hw7K7Zi7fTNyFrhEgr\\\",\\\"name\\\":\\\"Bash\\\",\\\"input\\\":{\\\"command\\\":\\\"python - <<'EOF'\\\\np='learning/concentration.py'; s=open(p).read()\\\\nanchor = '''# ----------------------------------------------------------------------------\\\\n# the sandwich and pw − tw on the ensemble\\\\n# ----------------------------------------------------------------------------\\\\n'''\\\\nnew = '''# ----------------------------------------------------------------------------\\\\n# structural forms: linear in n with a slope that saturates in the degree\\\\n# ----------------------------------------------------------------------------\\\\n\\\\nSTRUCTURAL = {\\\\n    # name: (function of (n, D, *params), initial params, printed form)\\\\n    \\\\\\\"a + n·D/(D + c)\\\\\\\": (lambda n, D, a, c: a + n * D / (D + c), (3.0, 20.0), \\\\\\\"a + n · D / (D + c)\\\\\\\"),\\\\n    \\\\\\\"a + b·n·D/(D + c)\\\\\\\": (lambda n, D, a, b, c: a + b * n * D / (D + c), (3.0, 1.0, 20.0), \\\\\\\"a + b · n · D / (D + c)\\\\\\\"),\\\\n    \\\\\\\"a + n·(1 − exp(−D/τ))\\\\\\\": (lambda n, D, a, t: a + n * (1 - np.exp(-D / t)), (3.0, 20.0), \\\\\\\"a + n · (1 − exp(−D / τ))\\\\\\\"),\\\\n    \\\\\\\"a + n·√D/(√D + c)\\\\\\\": (lambda n, D, a, c: a + n * np.sqrt(D) / (np.sqrt(D) + c), (3.0, 5.0), \\\\\\\"a + n · √D / (√D + c)\\\\\\\"),\\\\n}\\\\n\\\\n\\\\ndef _fit_form(fn, n, D, y, p0):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Least squares start, then least absolute deviation by Nelder–Mead.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    from scipy.optimize import curve_fit, minimize\\\\n    try:\\\\n        popt, _ = curve_fit(lambda x, *p: fn(x[0], x[1], *p), np.stack([n, D]), y, p0=p0, maxfev=20000)\\\\n    except RuntimeError:\\\\n        popt = np.asarray(p0, dtype=float)\\\\n    res = minimize(lambda p: np.abs(fn(n, D, *p) - y).mean(), popt, method=\\\\\\\"Nelder-Mead\\\\\\\",\\\\n                   options={\\\\\\\"xatol\\\\\\\": 1e-6, \\\\\\\"fatol\\\\\\\": 1e-8, \\\\\\\"maxiter\\\\\\\": 4000})\\\\n    return res.x if res.success or np.isfinite(res.fun) else popt\\\\n\\\\n\\\\ndef structural_fits(cells: pd.DataFrame, frame: pd.DataFrame) -> dict:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"`E[opt] ≈ a + n · s(D)`, `D = deg_nom` the nominal mean degree of the\\\\n    random intersection graph, with a saturating slope `s(D) → 1` as `D → ∞`\\\\n    (the complete graph) and `s(D) → 0` as `D → 0`. Four forms, each with two\\\\n    or three constants fitted by least absolute deviation on the cell means;\\\\n    scored leave-one-size-out, extrapolated from `n ≤ 30` to 35 and 40, and\\\\n    the best form's residual on every instance with the counts below and\\\\n    above the optimum. **Not a bound.** The forms are chosen by hand from the\\\\n    slope-by-degree table, so choosing among four is the only selection.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    n = cells[\\\\\\\"n\\\\\\\"].to_numpy(dtype=float)\\\\n    D = cells[\\\\\\\"deg_nom\\\\\\\"].to_numpy(dtype=float)\\\\n    y = cells[\\\\\\\"mean\\\\\\\"].to_numpy(dtype=float)\\\\n    folds = _n_folds(n)\\\\n    rows = []\\\\n    fitted = {}\\\\n    for name, (fn, p0, printed) in STRUCTURAL.items():\\\\n        pred = np.zeros_like(y)\\\\n        for tr, te in folds:\\\\n            p = _fit_form(fn, n[tr], D[tr], y[tr], p0)\\\\n            pred[te] = fn(n[te], D[te], *p)\\\\n        train = n <= 30\\\\n        p_small = _fit_form(fn, n[train], D[train], y[train], p0)\\\\n        ex = _scores(fn(n[~train], D[~train], *p_small), y[~train])\\\\n        p_all = _fit_form(fn, n, D, y, p0)\\\\n        fitted[name] = p_all\\\\n        rows.append({\\\\\\\"form\\\\\\\": printed, \\\\\\\"constants (all cells)\\\\\\\": \\\\\\\", \\\\\\\".join(f\\\\\\\"{v:.3g}\\\\\\\" for v in p_all),\\\\n                     \\\\\\\"mae (held-out n)\\\\\\\": _scores(pred, y)[\\\\\\\"mae\\\\\\\"], \\\\\\\"exact (held-out n)\\\\\\\": _scores(pred, y)[\\\\\\\"exact\\\\\\\"],\\\\n                     \\\\\\\"mae n≤30 → 35,40\\\\\\\": ex[\\\\\\\"mae\\\\\\\"], \\\\\\\"bias n≤30 → 35,40\\\\\\\": float((fn(n[~train], D[~train], *p_small) - y[~train]).mean()),\\\\n                     \\\\\\\"mae in-sample\\\\\\\": _scores(fn(n, D, *p_all), y)[\\\\\\\"mae\\\\\\\"]})\\\\n    table = pd.DataFrame(rows).sort_values(\\\\\\\"mae (held-out n)\\\\\\\").reset_index(drop=True)\\\\n    best = table.iloc[0][\\\\\\\"form\\\\\\\"]\\\\n    best_name = next(k for k, v in STRUCTURAL.items() if v[2] == best)\\\\n    fn, _, printed = STRUCTURAL[best_name]\\\\n    p_all = fitted[best_name]\\\\n    inst = nominal_features(frame[\\\\\\\"n\\\\\\\"], frame[\\\\\\\"m\\\\\\\"], frame[\\\\\\\"generator\\\\\\\"], frame[\\\\\\\"param\\\\\\\"])\\\\n    opt = frame[\\\\\\\"optimum\\\\\\\"].to_numpy(dtype=float)\\\\n    pred_i = fn(inst[\\\\\\\"n\\\\\\\"], inst[\\\\\\\"deg_nom\\\\\\\"], *p_all)\\\\n    err = pred_i - opt\\\\n    r = np.round(pred_i)\\\\n    inst_row = {\\\\\\\"estimate\\\\\\\": f\\\\\\\"{printed} with ({', '.join(f'{v:.3g}' for v in p_all)})\\\\\\\", **_scores(pred_i, opt),\\\\n                \\\\\\\"below\\\\\\\": int((r < opt).sum()), \\\\\\\"above\\\\\\\": int((r > opt).sum()),\\\\n                \\\\\\\"max_below\\\\\\\": float((opt - r).max()), \\\\\\\"max_above\\\\\\\": float((r - opt).max()),\\\\n                **{f\\\\\\\"q{int(q * 100):02d}\\\\\\\": float(np.quantile(err, q)) for q in (0.05, 0.25, 0.5, 0.75, 0.95)}}\\\\n    by_n = pd.DataFrame({\\\\\\\"n\\\\\\\": frame[\\\\\\\"n\\\\\\\"], \\\\\\\"err\\\\\\\": err}).groupby(\\\\\\\"n\\\\\\\")[\\\\\\\"err\\\\\\\"].agg(\\\\n        mae=lambda s: s.abs().mean(), bias=\\\\\\\"mean\\\\\\\", exact=lambda s: (s.abs() <= 0.5).mean()).reset_index()\\\\n    by_series = pd.DataFrame({\\\\\\\"series\\\\\\\": frame[\\\\\\\"series\\\\\\\"], \\\\\\\"err\\\\\\\": err}).groupby(\\\\\\\"series\\\\\\\")[\\\\\\\"err\\\\\\\"].agg(\\\\n        mae=lambda s: s.abs().mean(), bias=\\\\\\\"mean\\\\\\\").reset_index()\\\\n    # the slope s(D) the best form implies, at a few degrees\\\\n    grid = np.array([2, 4, 9, 16, 25, 36, 64, 100, 200], dtype=float)\\\\n    slope_curve = pd.DataFrame({\\\\\\\"D (nominal mean degree)\\\\\\\": grid,\\\\n                                \\\\\\\"implied asymptotic optimum / n\\\\\\\": [float(fn(1e6, d, *p_all) / 1e6) for d in grid]})\\\\n    return {\\\\\\\"table\\\\\\\": table, \\\\\\\"best\\\\\\\": best_name, \\\\\\\"constants\\\\\\\": p_all, \\\\\\\"instance_residual\\\\\\\": pd.DataFrame([inst_row]),\\\\n            \\\\\\\"by_n\\\\\\\": by_n, \\\\\\\"by_series\\\\\\\": by_series, \\\\\\\"slope_curve\\\\\\\": slope_curve}\\\\n\\\\n\\\\n''' + anchor\\\\nassert anchor in s\\\\ns = s.replace(anchor, new)\\\\n\\\\n# wire into report\\\\ns = s.replace('''    fm = formula(cells, frame, nested=nested, workers=workers)\\\\n    sw = sandwich(frame)''','''    fm = formula(cells, frame, nested=nested, workers=workers)\\\\n    st = structural_fits(cells, frame)\\\\n    sw = sandwich(frame)''')\\\\ns = s.replace('''    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\n## The sandwich on the ensemble (constants fixed by hand)\\\\\\\\\\\\\\\\n\\\\\\\")''',\\\\n'''    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\n## Structural forms: E[opt] ≈ a + n · s(D), D the nominal mean degree (**not a bound**)\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"table\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(f\\\\\\\"\\\\\\\\\\\\\\\\nBest form `{st['best']}`, constants {tuple(round(float(v), 3) for v in st['constants'])}; per-instance residual on all instances:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"instance_residual\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\nby n:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"by_n\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\nby series:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"by_series\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\nthe slope s(D) = lim optimum / n the best form implies:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"slope_curve\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\n## The sandwich on the ensemble (constants fixed by hand)\\\\\\\\\\\\\\\\n\\\\\\\")''')\\\\ns = s.replace('''        \\\\\\\"instance_mae\\\\\\\": fm[\\\\\\\"instance_residuals\\\\\\\"].set_index(\\\\\\\"estimate\\\\\\\")[\\\\\\\"mae\\\\\\\"].round(3).to_dict(),''',\\\\n'''        \\\\\\\"instance_mae\\\\\\\": fm[\\\\\\\"instance_residuals\\\\\\\"].set_index(\\\\\\\"estimate\\\\\\\")[\\\\\\\"mae\\\\\\\"].round(3).to_dict(),\\\\n        \\\\\\\"structural\\\\\\\": {\\\\\\\"best\\\\\\\": st[\\\\\\\"best\\\\\\\"], \\\\\\\"constants\\\\\\\": [round(float(v), 4) for v in st[\\\\\\\"constants\\\\\\\"]],\\\\n                       \\\\\\\"cell_mae_heldout_n\\\\\\\": round(float(st[\\\\\\\"table\\\\\\\"].iloc[0][\\\\\\\"mae (held-out n)\\\\\\\"]), 3),\\\\n                       \\\\\\\"extrapolation_mae\\\\\\\": round(float(st[\\\\\\\"table\\\\\\\"].iloc[0][\\\\\\\"mae n≤30 → 35,40\\\\\\\"]), 3),\\\\n                       \\\\\\\"instance_mae\\\\\\\": round(float(st[\\\\\\\"instance_residual\\\\\\\"].iloc[0][\\\\\\\"mae\\\\\\\"]), 3)},\\\\n        \\\\\\\"pw_minus_tw\\\\\\\": {\\\\\\\"certified_pw_gt_tw_share_by_n\\\\\\\": pt[\\\\\\\"by_n\\\\\\\"].set_index(\\\\\\\"n\\\\\\\")[\\\\\\\"min(tw_mf, tw_md): res > 0\\\\\\\"].round(3).to_dict(),\\\\n                        \\\\\\\"res_tw_max\\\\\\\": float(pt[\\\\\\\"by_n\\\\\\\"][\\\\\\\"res_tw max\\\\\\\"].max())},''')\\\\ns = s.replace('''ax.set_title(\\\\\\\"(b) Bernoulli p, m = n: flat only below the giant component\\\\\\\"''',\\\\n              '''ax.set_title(\\\\\\\"(b) Bernoulli p, m = n: flat only at or below the giant-component threshold\\\\\\\"''')\\\\nopen(p,'w').write(s)\\\\nprint('ok')\\\\nEOF\\\\ncat > tests/test_concentration.py <<'EOF'\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Guards on the concentration study (`learning.concentration`).\\\\n\\\\nEvery quantity the report quotes is computed here on a frame small enough to\\\\ncheck by hand: the nominal random-intersection-graph features, the per-cell\\\\nmoments, the kill verdict, the linear law, the sandwich position λ, the\\\\npathwidth-minus-treewidth bracket, and the saturating structural fit on\\\\nexact synthetic data.\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nimport numpy as np\\\\nimport pandas as pd\\\\nimport pytest\\\\n\\\\nfrom learning import hardness_map\\\\nfrom learning.concentration import (\\\\n    cell_stats,\\\\n    kill_verdict,\\\\n    linearity,\\\\n    nominal_features,\\\\n    prepare,\\\\n    regime_of,\\\\n    structural_fits,\\\\n)\\\\n\\\\n\\\\ndef _frame(rows: list[dict]) -> pd.DataFrame:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A campaign-shaped frame from a few hand-written rows.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    base = {\\\\\\\"generator\\\\\\\": \\\\\\\"fixed\\\\\\\", \\\\\\\"n\\\\\\\": 10, \\\\\\\"m\\\\\\\": 10, \\\\\\\"param\\\\\\\": 2, \\\\\\\"nodes_default\\\\\\\": 1, \\\\\\\"nodes_csearch\\\\\\\": 1,\\\\n            \\\\\\\"g_components\\\\\\\": 1, \\\\\\\"g_largest_comp_frac\\\\\\\": 1.0, \\\\\\\"col_mean\\\\\\\": 2.0, \\\\\\\"density\\\\\\\": 0.2,\\\\n            \\\\\\\"g_deg_mean\\\\\\\": 2.0, \\\\\\\"ub_best\\\\\\\": 3, \\\\\\\"lb_best\\\\\\\": 3, \\\\\\\"g_degeneracy\\\\\\\": 2, \\\\\\\"bw_rcm\\\\\\\": 2,\\\\n            \\\\\\\"tw_min_fill\\\\\\\": 2, \\\\\\\"tw_min_degree\\\\\\\": 2, \\\\\\\"complete_graph\\\\\\\": False, \\\\\\\"g_deg_std\\\\\\\": 0.0,\\\\n            \\\\\\\"g_density\\\\\\\": 0.5, \\\\\\\"n_customers\\\\\\\": 10, \\\\\\\"optimum\\\\\\\": 3}\\\\n    out = []\\\\n    for i, r in enumerate(rows):\\\\n        d = {**base, **r}\\\\n        d.setdefault(\\\\\\\"instance_name\\\\\\\", f\\\\\\\"i{i}\\\\\\\")\\\\n        d.setdefault(\\\\\\\"graph_cert\\\\\\\", f\\\\\\\"c{i}\\\\\\\")\\\\n        d[\\\\\\\"cell\\\\\\\"] = f\\\\\\\"{d['generator']}:{d['n']}:{d['m']}:{d['param']}\\\\\\\"\\\\n        out.append(d)\\\\n    return prepare(hardness_map.prepare(pd.DataFrame(out)))\\\\n\\\\n\\\\ndef test_nominal_features_by_hand():\\\\n    f = nominal_features([4, 10], [1, 20], [\\\\\\\"bernoulli\\\\\\\", \\\\\\\"fixed\\\\\\\"], [0.5, 2])\\\\n    assert f[\\\\\\\"p_nom\\\\\\\"][0] == 0.5 and f[\\\\\\\"q_nom\\\\\\\"][0] == pytest.approx(0.25)   # 1 − (1 − ¼)^1\\\\n    assert f[\\\\\\\"deg_nom\\\\\\\"][0] == pytest.approx(3 * 0.25)\\\\n    assert f[\\\\\\\"p_nom\\\\\\\"][1] == pytest.approx(0.2) and f[\\\\\\\"d_nom\\\\\\\"][1] == pytest.approx(2.0)\\\\n    assert f[\\\\\\\"k_nom\\\\\\\"][1] == pytest.approx(4.0)                              # 20 products × 0.2\\\\n\\\\n\\\\ndef test_cell_moments_by_hand():\\\\n    frame = _frame([{\\\\\\\"optimum\\\\\\\": 2}, {\\\\\\\"optimum\\\\\\\": 2}, {\\\\\\\"optimum\\\\\\\": 4}, {\\\\\\\"optimum\\\\\\\": 4}])\\\\n    cells = cell_stats(frame)\\\\n    assert len(cells) == 1\\\\n    c = cells.iloc[0]\\\\n    assert c[\\\\\\\"mean\\\\\\\"] == 3.0\\\\n    assert c[\\\\\\\"std\\\\\\\"] == pytest.approx(np.sqrt(4 / 3))\\\\n    assert c[\\\\\\\"cv\\\\\\\"] == pytest.approx(np.sqrt(4 / 3) / 3)\\\\n    assert c[\\\\\\\"mode_share\\\\\\\"] == 0.5 and c[\\\\\\\"min\\\\\\\"] == 2 and c[\\\\\\\"max\\\\\\\"] == 4\\\\n    assert c[\\\\\\\"opt_frac\\\\\\\"] == pytest.approx(0.3)\\\\n\\\\n\\\\ndef test_kill_verdict_fires_only_at_largest_n():\\\\n    wide = [{\\\\\\\"n\\\\\\\": 40, \\\\\\\"optimum\\\\\\\": v} for v in (2, 2, 4, 4)]          # cv 0.385 at n = 40\\\\n    narrow = [{\\\\\\\"n\\\\\\\": 40, \\\\\\\"optimum\\\\\\\": v} for v in (3, 3, 3, 4)]        # cv 0.154\\\\n    early = [{\\\\\\\"n\\\\\\\": 10, \\\\\\\"optimum\\\\\\\": v} for v in (2, 2, 4, 4)]\\\\n    assert kill_verdict(cell_stats(_frame(wide)))[\\\\\\\"kill_fires\\\\\\\"]\\\\n    v = kill_verdict(cell_stats(_frame(narrow + early)))\\\\n    assert not v[\\\\\\\"kill_fires\\\\\\\"] and v[\\\\\\\"cells_above_total\\\\\\\"] == 1\\\\n\\\\n\\\\ndef test_linearity_recovers_an_exact_line():\\\\n    rows = []\\\\n    for n in (15, 20, 25, 30, 40):\\\\n        for i in range(3):\\\\n            rows.append({\\\\\\\"n\\\\\\\": n, \\\\\\\"m\\\\\\\": n, \\\\\\\"param\\\\\\\": 3, \\\\\\\"optimum\\\\\\\": 3 + 0.2 * n + (i - 1) * 0.0, \\\\\\\"col_mean\\\\\\\": 3.0})\\\\n    lin = linearity(cell_stats(_frame(rows)))\\\\n    assert len(lin) == 1\\\\n    assert lin.iloc[0][\\\\\\\"slope\\\\\\\"] == pytest.approx(0.2)\\\\n    assert lin.iloc[0][\\\\\\\"intercept\\\\\\\"] == pytest.approx(3.0)\\\\n    assert lin.iloc[0][\\\\\\\"r2\\\\\\\"] == pytest.approx(1.0)\\\\n    assert lin.iloc[0][\\\\\\\"regime\\\\\\\"] == \\\\\\\"super\\\\\\\"\\\\n\\\\n\\\\ndef test_regime_of_by_hand():\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 1.0, \\\\\\\"lcc_frac\\\\\\\": 1.0}) == \\\\\\\"complete\\\\\\\"\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 0.3, \\\\\\\"lcc_frac\\\\\\\": 0.2}) == \\\\\\\"sub\\\\\\\"\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 0.3, \\\\\\\"lcc_frac\\\\\\\": 0.7}) == \\\\\\\"critical\\\\\\\"\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 0.3, \\\\\\\"lcc_frac\\\\\\\": 0.99}) == \\\\\\\"super\\\\\\\"\\\\n\\\\n\\\\ndef test_lambda_and_the_treewidth_bracket_by_hand():\\\\n    frame = _frame([\\\\n        {\\\\\\\"optimum\\\\\\\": 5, \\\\\\\"g_degeneracy\\\\\\\": 2, \\\\\\\"bw_rcm\\\\\\\": 6, \\\\\\\"tw_min_fill\\\\\\\": 3, \\\\\\\"tw_min_degree\\\\\\\": 2},\\\\n        {\\\\\\\"optimum\\\\\\\": 3, \\\\\\\"g_degeneracy\\\\\\\": 2, \\\\\\\"bw_rcm\\\\\\\": 2, \\\\\\\"tw_min_fill\\\\\\\": 2, \\\\\\\"tw_min_degree\\\\\\\": 2},\\\\n    ])\\\\n    a, b = frame.iloc[0], frame.iloc[1]\\\\n    assert a[\\\\\\\"lam\\\\\\\"] == pytest.approx(0.5)                # (5 − 1 − 2) / (6 − 2)\\\\n    assert not a[\\\\\\\"forced\\\\\\\"] and b[\\\\\\\"forced\\\\\\\"] and np.isnan(b[\\\\\\\"lam\\\\\\\"])\\\\n    assert a[\\\\\\\"res_tw\\\\\\\"] == 1 and a[\\\\\\\"res_tw2\\\\\\\"] == 2 and a[\\\\\\\"res_deg\\\\\\\"] == 2   # res_tw ≤ pw − tw ≤ res_deg\\\\n    assert b[\\\\\\\"res_tw\\\\\\\"] == 0 and b[\\\\\\\"res_deg\\\\\\\"] == 0\\\\n\\\\n\\\\ndef test_structural_fit_recovers_exact_constants():\\\\n    rows = []\\\\n    for n in (15, 20, 25, 30, 35, 40):\\\\n        for d in (2, 3, 5, 8):\\\\n            f = nominal_features([n], [n], [\\\\\\\"fixed\\\\\\\"], [d])\\\\n            mean = 2.0 + n * f[\\\\\\\"deg_nom\\\\\\\"][0] / (f[\\\\\\\"deg_nom\\\\\\\"][0] + 10.0)\\\\n            for i in range(2):\\\\n                rows.append({\\\\\\\"n\\\\\\\": n, \\\\\\\"m\\\\\\\": n, \\\\\\\"param\\\\\\\": d, \\\\\\\"optimum\\\\\\\": mean, \\\\\\\"col_mean\\\\\\\": float(d)})\\\\n    frame = _frame(rows)\\\\n    st = structural_fits(cell_stats(frame), frame)\\\\n    assert st[\\\\\\\"best\\\\\\\"] == \\\\\\\"a + n·D/(D + c)\\\\\\\"\\\\n    assert st[\\\\\\\"constants\\\\\\\"][0] == pytest.approx(2.0, abs=1e-3)\\\\n    assert st[\\\\\\\"constants\\\\\\\"][1] == pytest.approx(10.0, abs=1e-2)\\\\n    assert st[\\\\\\\"table\\\\\\\"].iloc[0][\\\\\\\"mae (held-out n)\\\\\\\"] < 1e-3\\\\nEOF\\\\npython -m pytest tests/test_concentration.py -q -x 2>&1 | tail -15\\\",\\\"description\\\":\\\"Add structural fits to the module, write tests, run them\\\",\\\"timeout\\\":300000},\\\"caller\\\":{\\\"type\\\":\\\"direct\\\"}}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":32,\\\"cache_creation_input_tokens\\\":6256,\\\"cache_read_input_tokens\\\":157397,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":6256,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":6,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"c7f6ac10-5cdb-425b-85a9-2cf007661e3c\\\",\\\"uuid\\\":\\\"750de064-1511-411a-bc6e-4a41f31bade8\\\",\\\"timestamp\\\":\\\"2026-09-26T06:21:57.748Z\\\",\\\"request_id\\\":\\\"req_011CfRZsPKWy6zJkjDuwR3ok\\\",\\\"wire_tool_inputs\\\":{\\\"toolu_01Ahk4hw7K7Zi7fTNyFrhEgr\\\":{\\\"command\\\":\\\"cd /home/al/dev/MOSP && python - <<'EOF'\\\\np='learning/concentration.py'; s=open(p).read()\\\\nanchor = '''# ----------------------------------------------------------------------------\\\\n# the sandwich and pw − tw on the ensemble\\\\n# ----------------------------------------------------------------------------\\\\n'''\\\\nnew = '''# ----------------------------------------------------------------------------\\\\n# structural forms: linear in n with a slope that saturates in the degree\\\\n# ----------------------------------------------------------------------------\\\\n\\\\nSTRUCTURAL = {\\\\n    # name: (function of (n, D, *params), initial params, printed form)\\\\n    \\\\\\\"a + n·D/(D + c)\\\\\\\": (lambda n, D, a, c: a + n * D / (D + c), (3.0, 20.0), \\\\\\\"a + n · D / (D + c)\\\\\\\"),\\\\n    \\\\\\\"a + b·n·D/(D + c)\\\\\\\": (lambda n, D, a, b, c: a + b * n * D / (D + c), (3.0, 1.0, 20.0), \\\\\\\"a + b · n · D / (D + c)\\\\\\\"),\\\\n    \\\\\\\"a + n·(1 − exp(−D/τ))\\\\\\\": (lambda n, D, a, t: a + n * (1 - np.exp(-D / t)), (3.0, 20.0), \\\\\\\"a + n · (1 − exp(−D / τ))\\\\\\\"),\\\\n    \\\\\\\"a + n·√D/(√D + c)\\\\\\\": (lambda n, D, a, c: a + n * np.sqrt(D) / (np.sqrt(D) + c), (3.0, 5.0), \\\\\\\"a + n · √D / (√D + c)\\\\\\\"),\\\\n}\\\\n\\\\n\\\\ndef _fit_form(fn, n, D, y, p0):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Least squares start, then least absolute deviation by Nelder–Mead.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    from scipy.optimize import curve_fit, minimize\\\\n    try:\\\\n        popt, _ = curve_fit(lambda x, *p: fn(x[0], x[1], *p), np.stack([n, D]), y, p0=p0, maxfev=20000)\\\\n    except RuntimeError:\\\\n        popt = np.asarray(p0, dtype=float)\\\\n    res = minimize(lambda p: np.abs(fn(n, D, *p) - y).mean(), popt, method=\\\\\\\"Nelder-Mead\\\\\\\",\\\\n                   options={\\\\\\\"xatol\\\\\\\": 1e-6, \\\\\\\"fatol\\\\\\\": 1e-8, \\\\\\\"maxiter\\\\\\\": 4000})\\\\n    return res.x if res.success or np.isfinite(res.fun) else popt\\\\n\\\\n\\\\ndef structural_fits(cells: pd.DataFrame, frame: pd.DataFrame) -> dict:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"`E[opt] ≈ a + n · s(D)`, `D = deg_nom` the nominal mean degree of the\\\\n    random intersection graph, with a saturating slope `s(D) → 1` as `D → ∞`\\\\n    (the complete graph) and `s(D) → 0` as `D → 0`. Four forms, each with two\\\\n    or three constants fitted by least absolute deviation on the cell means;\\\\n    scored leave-one-size-out, extrapolated from `n ≤ 30` to 35 and 40, and\\\\n    the best form's residual on every instance with the counts below and\\\\n    above the optimum. **Not a bound.** The forms are chosen by hand from the\\\\n    slope-by-degree table, so choosing among four is the only selection.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    n = cells[\\\\\\\"n\\\\\\\"].to_numpy(dtype=float)\\\\n    D = cells[\\\\\\\"deg_nom\\\\\\\"].to_numpy(dtype=float)\\\\n    y = cells[\\\\\\\"mean\\\\\\\"].to_numpy(dtype=float)\\\\n    folds = _n_folds(n)\\\\n    rows = []\\\\n    fitted = {}\\\\n    for name, (fn, p0, printed) in STRUCTURAL.items():\\\\n        pred = np.zeros_like(y)\\\\n        for tr, te in folds:\\\\n            p = _fit_form(fn, n[tr], D[tr], y[tr], p0)\\\\n            pred[te] = fn(n[te], D[te], *p)\\\\n        train = n <= 30\\\\n        p_small = _fit_form(fn, n[train], D[train], y[train], p0)\\\\n        ex = _scores(fn(n[~train], D[~train], *p_small), y[~train])\\\\n        p_all = _fit_form(fn, n, D, y, p0)\\\\n        fitted[name] = p_all\\\\n        rows.append({\\\\\\\"form\\\\\\\": printed, \\\\\\\"constants (all cells)\\\\\\\": \\\\\\\", \\\\\\\".join(f\\\\\\\"{v:.3g}\\\\\\\" for v in p_all),\\\\n                     \\\\\\\"mae (held-out n)\\\\\\\": _scores(pred, y)[\\\\\\\"mae\\\\\\\"], \\\\\\\"exact (held-out n)\\\\\\\": _scores(pred, y)[\\\\\\\"exact\\\\\\\"],\\\\n                     \\\\\\\"mae n≤30 → 35,40\\\\\\\": ex[\\\\\\\"mae\\\\\\\"], \\\\\\\"bias n≤30 → 35,40\\\\\\\": float((fn(n[~train], D[~train], *p_small) - y[~train]).mean()),\\\\n                     \\\\\\\"mae in-sample\\\\\\\": _scores(fn(n, D, *p_all), y)[\\\\\\\"mae\\\\\\\"]})\\\\n    table = pd.DataFrame(rows).sort_values(\\\\\\\"mae (held-out n)\\\\\\\").reset_index(drop=True)\\\\n    best = table.iloc[0][\\\\\\\"form\\\\\\\"]\\\\n    best_name = next(k for k, v in STRUCTURAL.items() if v[2] == best)\\\\n    fn, _, printed = STRUCTURAL[best_name]\\\\n    p_all = fitted[best_name]\\\\n    inst = nominal_features(frame[\\\\\\\"n\\\\\\\"], frame[\\\\\\\"m\\\\\\\"], frame[\\\\\\\"generator\\\\\\\"], frame[\\\\\\\"param\\\\\\\"])\\\\n    opt = frame[\\\\\\\"optimum\\\\\\\"].to_numpy(dtype=float)\\\\n    pred_i = fn(inst[\\\\\\\"n\\\\\\\"], inst[\\\\\\\"deg_nom\\\\\\\"], *p_all)\\\\n    err = pred_i - opt\\\\n    r = np.round(pred_i)\\\\n    inst_row = {\\\\\\\"estimate\\\\\\\": f\\\\\\\"{printed} with ({', '.join(f'{v:.3g}' for v in p_all)})\\\\\\\", **_scores(pred_i, opt),\\\\n                \\\\\\\"below\\\\\\\": int((r < opt).sum()), \\\\\\\"above\\\\\\\": int((r > opt).sum()),\\\\n                \\\\\\\"max_below\\\\\\\": float((opt - r).max()), \\\\\\\"max_above\\\\\\\": float((r - opt).max()),\\\\n                **{f\\\\\\\"q{int(q * 100):02d}\\\\\\\": float(np.quantile(err, q)) for q in (0.05, 0.25, 0.5, 0.75, 0.95)}}\\\\n    by_n = pd.DataFrame({\\\\\\\"n\\\\\\\": frame[\\\\\\\"n\\\\\\\"], \\\\\\\"err\\\\\\\": err}).groupby(\\\\\\\"n\\\\\\\")[\\\\\\\"err\\\\\\\"].agg(\\\\n        mae=lambda s: s.abs().mean(), bias=\\\\\\\"mean\\\\\\\", exact=lambda s: (s.abs() <= 0.5).mean()).reset_index()\\\\n    by_series = pd.DataFrame({\\\\\\\"series\\\\\\\": frame[\\\\\\\"series\\\\\\\"], \\\\\\\"err\\\\\\\": err}).groupby(\\\\\\\"series\\\\\\\")[\\\\\\\"err\\\\\\\"].agg(\\\\n        mae=lambda s: s.abs().mean(), bias=\\\\\\\"mean\\\\\\\").reset_index()\\\\n    # the slope s(D) the best form implies, at a few degrees\\\\n    grid = np.array([2, 4, 9, 16, 25, 36, 64, 100, 200], dtype=float)\\\\n    slope_curve = pd.DataFrame({\\\\\\\"D (nominal mean degree)\\\\\\\": grid,\\\\n                                \\\\\\\"implied asymptotic optimum / n\\\\\\\": [float(fn(1e6, d, *p_all) / 1e6) for d in grid]})\\\\n    return {\\\\\\\"table\\\\\\\": table, \\\\\\\"best\\\\\\\": best_name, \\\\\\\"constants\\\\\\\": p_all, \\\\\\\"instance_residual\\\\\\\": pd.DataFrame([inst_row]),\\\\n            \\\\\\\"by_n\\\\\\\": by_n, \\\\\\\"by_series\\\\\\\": by_series, \\\\\\\"slope_curve\\\\\\\": slope_curve}\\\\n\\\\n\\\\n''' + anchor\\\\nassert anchor in s\\\\ns = s.replace(anchor, new)\\\\n\\\\n# wire into report\\\\ns = s.replace('''    fm = formula(cells, frame, nested=nested, workers=workers)\\\\n    sw = sandwich(frame)''','''    fm = formula(cells, frame, nested=nested, workers=workers)\\\\n    st = structural_fits(cells, frame)\\\\n    sw = sandwich(frame)''')\\\\ns = s.replace('''    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\n## The sandwich on the ensemble (constants fixed by hand)\\\\\\\\\\\\\\\\n\\\\\\\")''',\\\\n'''    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\n## Structural forms: E[opt] ≈ a + n · s(D), D the nominal mean degree (**not a bound**)\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"table\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(f\\\\\\\"\\\\\\\\\\\\\\\\nBest form `{st['best']}`, constants {tuple(round(float(v), 3) for v in st['constants'])}; per-instance residual on all instances:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"instance_residual\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\nby n:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"by_n\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\nby series:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"by_series\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\nthe slope s(D) = lim optimum / n the best form implies:\\\\\\\\\\\\\\\\n\\\\\\\")\\\\n    parts.append(_md(st[\\\\\\\"slope_curve\\\\\\\"], \\\\\\\".3f\\\\\\\"))\\\\n    parts.append(\\\\\\\"\\\\\\\\\\\\\\\\n## The sandwich on the ensemble (constants fixed by hand)\\\\\\\\\\\\\\\\n\\\\\\\")''')\\\\ns = s.replace('''        \\\\\\\"instance_mae\\\\\\\": fm[\\\\\\\"instance_residuals\\\\\\\"].set_index(\\\\\\\"estimate\\\\\\\")[\\\\\\\"mae\\\\\\\"].round(3).to_dict(),''',\\\\n'''        \\\\\\\"instance_mae\\\\\\\": fm[\\\\\\\"instance_residuals\\\\\\\"].set_index(\\\\\\\"estimate\\\\\\\")[\\\\\\\"mae\\\\\\\"].round(3).to_dict(),\\\\n        \\\\\\\"structural\\\\\\\": {\\\\\\\"best\\\\\\\": st[\\\\\\\"best\\\\\\\"], \\\\\\\"constants\\\\\\\": [round(float(v), 4) for v in st[\\\\\\\"constants\\\\\\\"]],\\\\n                       \\\\\\\"cell_mae_heldout_n\\\\\\\": round(float(st[\\\\\\\"table\\\\\\\"].iloc[0][\\\\\\\"mae (held-out n)\\\\\\\"]), 3),\\\\n                       \\\\\\\"extrapolation_mae\\\\\\\": round(float(st[\\\\\\\"table\\\\\\\"].iloc[0][\\\\\\\"mae n≤30 → 35,40\\\\\\\"]), 3),\\\\n                       \\\\\\\"instance_mae\\\\\\\": round(float(st[\\\\\\\"instance_residual\\\\\\\"].iloc[0][\\\\\\\"mae\\\\\\\"]), 3)},\\\\n        \\\\\\\"pw_minus_tw\\\\\\\": {\\\\\\\"certified_pw_gt_tw_share_by_n\\\\\\\": pt[\\\\\\\"by_n\\\\\\\"].set_index(\\\\\\\"n\\\\\\\")[\\\\\\\"min(tw_mf, tw_md): res > 0\\\\\\\"].round(3).to_dict(),\\\\n                        \\\\\\\"res_tw_max\\\\\\\": float(pt[\\\\\\\"by_n\\\\\\\"][\\\\\\\"res_tw max\\\\\\\"].max())},''')\\\\ns = s.replace('''ax.set_title(\\\\\\\"(b) Bernoulli p, m = n: flat only below the giant component\\\\\\\"''',\\\\n              '''ax.set_title(\\\\\\\"(b) Bernoulli p, m = n: flat only at or below the giant-component threshold\\\\\\\"''')\\\\nopen(p,'w').write(s)\\\\nprint('ok')\\\\nEOF\\\\ncat > tests/test_concentration.py <<'EOF'\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Guards on the concentration study (`learning.concentration`).\\\\n\\\\nEvery quantity the report quotes is computed here on a frame small enough to\\\\ncheck by hand: the nominal random-intersection-graph features, the per-cell\\\\nmoments, the kill verdict, the linear law, the sandwich position λ, the\\\\npathwidth-minus-treewidth bracket, and the saturating structural fit on\\\\nexact synthetic data.\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nimport numpy as np\\\\nimport pandas as pd\\\\nimport pytest\\\\n\\\\nfrom learning import hardness_map\\\\nfrom learning.concentration import (\\\\n    cell_stats,\\\\n    kill_verdict,\\\\n    linearity,\\\\n    nominal_features,\\\\n    prepare,\\\\n    regime_of,\\\\n    structural_fits,\\\\n)\\\\n\\\\n\\\\ndef _frame(rows: list[dict]) -> pd.DataFrame:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A campaign-shaped frame from a few hand-written rows.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    base = {\\\\\\\"generator\\\\\\\": \\\\\\\"fixed\\\\\\\", \\\\\\\"n\\\\\\\": 10, \\\\\\\"m\\\\\\\": 10, \\\\\\\"param\\\\\\\": 2, \\\\\\\"nodes_default\\\\\\\": 1, \\\\\\\"nodes_csearch\\\\\\\": 1,\\\\n            \\\\\\\"g_components\\\\\\\": 1, \\\\\\\"g_largest_comp_frac\\\\\\\": 1.0, \\\\\\\"col_mean\\\\\\\": 2.0, \\\\\\\"density\\\\\\\": 0.2,\\\\n            \\\\\\\"g_deg_mean\\\\\\\": 2.0, \\\\\\\"ub_best\\\\\\\": 3, \\\\\\\"lb_best\\\\\\\": 3, \\\\\\\"g_degeneracy\\\\\\\": 2, \\\\\\\"bw_rcm\\\\\\\": 2,\\\\n            \\\\\\\"tw_min_fill\\\\\\\": 2, \\\\\\\"tw_min_degree\\\\\\\": 2, \\\\\\\"complete_graph\\\\\\\": False, \\\\\\\"g_deg_std\\\\\\\": 0.0,\\\\n            \\\\\\\"g_density\\\\\\\": 0.5, \\\\\\\"n_customers\\\\\\\": 10, \\\\\\\"optimum\\\\\\\": 3}\\\\n    out = []\\\\n    for i, r in enumerate(rows):\\\\n        d = {**base, **r}\\\\n        d.setdefault(\\\\\\\"instance_name\\\\\\\", f\\\\\\\"i{i}\\\\\\\")\\\\n        d.setdefault(\\\\\\\"graph_cert\\\\\\\", f\\\\\\\"c{i}\\\\\\\")\\\\n        d[\\\\\\\"cell\\\\\\\"] = f\\\\\\\"{d['generator']}:{d['n']}:{d['m']}:{d['param']}\\\\\\\"\\\\n        out.append(d)\\\\n    return prepare(hardness_map.prepare(pd.DataFrame(out)))\\\\n\\\\n\\\\ndef test_nominal_features_by_hand():\\\\n    f = nominal_features([4, 10], [1, 20], [\\\\\\\"bernoulli\\\\\\\", \\\\\\\"fixed\\\\\\\"], [0.5, 2])\\\\n    assert f[\\\\\\\"p_nom\\\\\\\"][0] == 0.5 and f[\\\\\\\"q_nom\\\\\\\"][0] == pytest.approx(0.25)   # 1 − (1 − ¼)^1\\\\n    assert f[\\\\\\\"deg_nom\\\\\\\"][0] == pytest.approx(3 * 0.25)\\\\n    assert f[\\\\\\\"p_nom\\\\\\\"][1] == pytest.approx(0.2) and f[\\\\\\\"d_nom\\\\\\\"][1] == pytest.approx(2.0)\\\\n    assert f[\\\\\\\"k_nom\\\\\\\"][1] == pytest.approx(4.0)                              # 20 products × 0.2\\\\n\\\\n\\\\ndef test_cell_moments_by_hand():\\\\n    frame = _frame([{\\\\\\\"optimum\\\\\\\": 2}, {\\\\\\\"optimum\\\\\\\": 2}, {\\\\\\\"optimum\\\\\\\": 4}, {\\\\\\\"optimum\\\\\\\": 4}])\\\\n    cells = cell_stats(frame)\\\\n    assert len(cells) == 1\\\\n    c = cells.iloc[0]\\\\n    assert c[\\\\\\\"mean\\\\\\\"] == 3.0\\\\n    assert c[\\\\\\\"std\\\\\\\"] == pytest.approx(np.sqrt(4 / 3))\\\\n    assert c[\\\\\\\"cv\\\\\\\"] == pytest.approx(np.sqrt(4 / 3) / 3)\\\\n    assert c[\\\\\\\"mode_share\\\\\\\"] == 0.5 and c[\\\\\\\"min\\\\\\\"] == 2 and c[\\\\\\\"max\\\\\\\"] == 4\\\\n    assert c[\\\\\\\"opt_frac\\\\\\\"] == pytest.approx(0.3)\\\\n\\\\n\\\\ndef test_kill_verdict_fires_only_at_largest_n():\\\\n    wide = [{\\\\\\\"n\\\\\\\": 40, \\\\\\\"optimum\\\\\\\": v} for v in (2, 2, 4, 4)]          # cv 0.385 at n = 40\\\\n    narrow = [{\\\\\\\"n\\\\\\\": 40, \\\\\\\"optimum\\\\\\\": v} for v in (3, 3, 3, 4)]        # cv 0.154\\\\n    early = [{\\\\\\\"n\\\\\\\": 10, \\\\\\\"optimum\\\\\\\": v} for v in (2, 2, 4, 4)]\\\\n    assert kill_verdict(cell_stats(_frame(wide)))[\\\\\\\"kill_fires\\\\\\\"]\\\\n    v = kill_verdict(cell_stats(_frame(narrow + early)))\\\\n    assert not v[\\\\\\\"kill_fires\\\\\\\"] and v[\\\\\\\"cells_above_total\\\\\\\"] == 1\\\\n\\\\n\\\\ndef test_linearity_recovers_an_exact_line():\\\\n    rows = []\\\\n    for n in (15, 20, 25, 30, 40):\\\\n        for i in range(3):\\\\n            rows.append({\\\\\\\"n\\\\\\\": n, \\\\\\\"m\\\\\\\": n, \\\\\\\"param\\\\\\\": 3, \\\\\\\"optimum\\\\\\\": 3 + 0.2 * n + (i - 1) * 0.0, \\\\\\\"col_mean\\\\\\\": 3.0})\\\\n    lin = linearity(cell_stats(_frame(rows)))\\\\n    assert len(lin) == 1\\\\n    assert lin.iloc[0][\\\\\\\"slope\\\\\\\"] == pytest.approx(0.2)\\\\n    assert lin.iloc[0][\\\\\\\"intercept\\\\\\\"] == pytest.approx(3.0)\\\\n    assert lin.iloc[0][\\\\\\\"r2\\\\\\\"] == pytest.approx(1.0)\\\\n    assert lin.iloc[0][\\\\\\\"regime\\\\\\\"] == \\\\\\\"super\\\\\\\"\\\\n\\\\n\\\\ndef test_regime_of_by_hand():\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 1.0, \\\\\\\"lcc_frac\\\\\\\": 1.0}) == \\\\\\\"complete\\\\\\\"\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 0.3, \\\\\\\"lcc_frac\\\\\\\": 0.2}) == \\\\\\\"sub\\\\\\\"\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 0.3, \\\\\\\"lcc_frac\\\\\\\": 0.7}) == \\\\\\\"critical\\\\\\\"\\\\n    assert regime_of({\\\\\\\"opt_frac\\\\\\\": 0.3, \\\\\\\"lcc_frac\\\\\\\": 0.99}) == \\\\\\\"super\\\\\\\"\\\\n\\\\n\\\\ndef test_lambda_and_the_treewidth_bracket_by_hand():\\\\n    frame = _frame([\\\\n        {\\\\\\\"optimum\\\\\\\": 5, \\\\\\\"g_degeneracy\\\\\\\": 2, \\\\\\\"bw_rcm\\\\\\\": 6, \\\\\\\"tw_min_fill\\\\\\\": 3, \\\\\\\"tw_min_degree\\\\\\\": 2},\\\\n        {\\\\\\\"optimum\\\\\\\": 3, \\\\\\\"g_degeneracy\\\\\\\": 2, \\\\\\\"bw_rcm\\\\\\\": 2, \\\\\\\"tw_min_fill\\\\\\\": 2, \\\\\\\"tw_min_degree\\\\\\\": 2},\\\\n    ])\\\\n    a, b = frame.iloc[0], frame.iloc[1]\\\\n    assert a[\\\\\\\"lam\\\\\\\"] == pytest.approx(0.5)                # (5 − 1 − 2) / (6 − 2)\\\\n    assert not a[\\\\\\\"forced\\\\\\\"] and b[\\\\\\\"forced\\\\\\\"] and np.isnan(b[\\\\\\\"lam\\\\\\\"])\\\\n    assert a[\\\\\\\"res_tw\\\\\\\"] == 1 and a[\\\\\\\"res_tw2\\\\\\\"] == 2 and a[\\\\\\\"res_deg\\\\\\\"] == 2   # res_tw ≤ pw − tw ≤ res_deg\\\\n    assert b[\\\\\\\"res_tw\\\\\\\"] == 0 and b[\\\\\\\"res_deg\\\\\\\"] == 0\\\\n\\\\n\\\\ndef test_structural_fit_recovers_exact_constants():\\\\n    rows = []\\\\n    for n in (15, 20, 25, 30, 35, 40):\\\\n        for d in (2, 3, 5, 8):\\\\n            f = nominal_features([n], [n], [\\\\\\\"fixed\\\\\\\"], [d])\\\\n            mean = 2.0 + n * f[\\\\\\\"deg_nom\\\\\\\"][0] / (f[\\\\\\\"deg_nom\\\\\\\"][0] + 10.0)\\\\n            for i in range(2):\\\\n                rows.append({\\\\\\\"n\\\\\\\": n, \\\\\\\"m\\\\\\\": n, \\\\\\\"param\\\\\\\": d, \\\\\\\"optimum\\\\\\\": mean, \\\\\\\"col_mean\\\\\\\": float(d)})\\\\n    frame = _frame(rows)\\\\n    st = structural_fits(cell_stats(frame), frame)\\\\n    assert st[\\\\\\\"best\\\\\\\"] == \\\\\\\"a + n·D/(D + c)\\\\\\\"\\\\n    assert st[\\\\\\\"constants\\\\\\\"][0] == pytest.approx(2.0, abs=1e-3)\\\\n    assert st[\\\\\\\"constants\\\\\\\"][1] == pytest.approx(10.0, abs=1e-2)\\\\n    assert st[\\\\\\\"table\\\\\\\"].iloc[0][\\\\\\\"mae (held-out n)\\\\\\\"] < 1e-3\\\\nEOF\\\\npython -m pytest tests/test_concentration.py -q -x 2>&1 | tail -15\\\",\\\"description\\\":\\\"Add structural fits to the module, write tests, run them\\\",\\\"timeout\\\":300000}},\\\"wire_ingest_context\\\":{\\\"toolu_01Ahk4hw7K7Zi7fTNyFrhEgr\\\":{\\\"cwd\\\":\\\"/home/al/dev/MOSP\\\"}}}\",\"+{\\\"type\\\":\\\"system\\\",\\\"subtype\\\":\\\"task_started\\\",\\\"task_id\\\":\\\"btuperujf\\\",\\\"tool_use_id\\\":\\\"toolu_01Ahk4hw7K7Zi7fTNyFrhEgr\\\",\\\"description\\\":\\\"Add structural fits to the module, write tests, run them\\\",\\\"is_backgrounded\\\":false,\\\"task_type\\\":\\\"local_bash\\\",\\\"uuid\\\":\\\"349514e9-75f8-4124-89d2-abf926335894\\\",\\\"session_id\\\":\\\"c7f6ac10-5cdb-425b-85a9-2cf007661e3c\\\"}\",\"+{\\\"type\\\":\\\"system\\\",\\\"subtype\\\":\\\"task_notification\\\",\\\"task_id\\\":\\\"btuperujf\\\",\\\"tool_use_id\\\":\\\"toolu_01Ahk4hw7K7Zi7fTNyFrhEgr\\\",\\\"status\\\":\\\"completed\\\",\\\"output_file\\\":\\\"\\\",\\\"summary\\\":\\\"Add structural fits to the module, write tests, run them\\\",\\\"uuid\\\":\\\"2617c09a-82cf-49bd-ba49-3adb58ba45d6\\\",\\\"session_id