())}: \"","+                 f\"{verdict['series_above']}; of those with a giant component (largest component ≥ {LCC_SUPER} of n): \"","+                 f\"{verdict['cells_above_supercritical']} (largest component fraction among them at most \"","+                 f\"{verdict['max_lcc_frac_above']:.2f}); at n = {int(cells['n'].max())}: \"","                  f\"{verdict['cells_above_at_n_max']}. **Kill fires: {verdict['kill_fires']}.**\\n\")","     for stat, title in ((\"cv\", \"CV of the optimum\"), (\"mean\", \"mean optimum\"), (\"std\", \"standard deviation\"),","                         (\"mode_share\", \"share of instances at the modal optimum\"), (\"lcc_frac\", \"largest component fraction (mean)\")):"]},{"oldStart":691,"oldLines":7,"newStart":699,"newLines":7,"lines":["     parts.append(_md(fm[\"instance_residuals\"], \".3f\"))","     parts.append(\"\\nMonomial residual by n:\\n\")","     parts.append(_md(fm[\"residual_by_n\"], \".3f\"))","-    parts.append(\"\\nMonomial residual by series and regime (`sub` = nominal degree ≤ 1):\\n\")","+    parts.append(\"\\nMonomial residual by series and regime (of the cell at its n):\\n\")","     parts.append(_md(fm[\"residual_by_series_regime\"], \".3f\"))","     parts.append(\"\\n## The sandwich on the ensemble (constants fixed by hand)\\n\")","     parts.append(_md(sw[\"table\"], \".3f\"))"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/learning/concentration.py"]}}}
