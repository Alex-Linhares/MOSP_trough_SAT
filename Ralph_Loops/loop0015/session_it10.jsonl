t[:start]+new+t[end:])\n\np='sec2_statement.tex'; s=open(p).read()\nassert \"number with 2,390 digits\" in s\ns=s.replace(\"number with 2,390 digits\",\"number with 2,391 digits\"); open(p,'w').write(s)\n\np='sec4_proof.tex'; s=open(p).read()\nassert \"forty-year-old hypothesis\" in s\ns=s.replace(\"forty-year-old hypothesis\",\"twenty-five-year-old hypothesis\"); open(p,'w').write(s)\n\np='sec10_conclusion.tex'; s=open(p).read()\nold=(\"The bound's constants exist and are never computed; the proof\\nwrites down at least 257 for the exponent's constant and at least\\n28,701 for the leading one (Sections~\\\\ref{sec:statement} and\\n\\\\ref{sec:proof}).\")\nassert old in s\ns=s.replace(old,\"The bound's constants exist and are never computed; where the proof\\nwrites values down, its construction has at least 257 for the\\nexponent's constant, and the theorem it exhibits has at least 258\\nthere and at least 28,701 in front (Sections~\\\\ref{sec:statement} and\\n\\\\ref{sec:proof}).\")\nopen(p,'w').write(s)\nprint(\"sec2/sec4/sec10 ok\")\nEOF\ngrep -n \"^EXIT\\|GATE\" /tmp/gate_it10.log | tail -3","description":"Write the shortened abstract and apply the three section fixes"}},"wire_ingest_context":{"toolu_01XxQXuz7NjUcySiWjq54iww":{"cwd":"/home/al/dev/MOSP/paper3/latex"}}}
