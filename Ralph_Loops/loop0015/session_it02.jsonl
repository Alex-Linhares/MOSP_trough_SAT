 List Bool) : List Bool :=\n    58\t  bits.foldr (fun b rest => true :: b :: rest) [false]\n    59\t\n    60\tdef encodeList {α : Type*} (enc : α → List Bool) : List α → List Bool\n    61\t  | [] => [false]\n    62\t  | a :: as => true :: (frame (enc a) ++ encodeList enc as)\n    63\t\n    64\tdef literalCode {n : ℕ} (l : SAT.Literal (Fin n)) : ℕ :=\n    65\t  2 * l.variable.val + if l.positive then 1 else 0\n    66\t\n    67\tdef clauseNumbers {n : ℕ} (C : SAT.Clause (Fin n)) : List ℕ :=\n    68\t  (C.image literalCode).sort (· ≤ ·)\n    69\t\n    70\tdef cnfNumbers {n : ℕ} (F : SAT.CNF (Fin n)) : List (List ℕ) :=\n    71\t  (F.image clauseNumbers).sort (· ≤ ·)\n    72\t\n    73\tdef encodeCNFBody {n : ℕ} (F : SAT.CNF (Fin n)) : List Bool :=\n    74\t  encodeList (encodeList encodeNat) (cnfNumbers F)\n    75\t\n    76\tdef encodeCNF {n : ℕ} (F : SAT.CNF (Fin n)) : List Bool :=\n    77\t  encodeNat n ++ encodeCNFBody F\n    78\t\n    79\tdef formulaBitLength {n : ℕ} (F : SAT.CNF (Fin n)) : ℕ := (encodeCNF F).length\n    80\t\n    81\tend OAI.Algorithms.SubexponentialSAT.Encoding\n    82\t\n    83\tnamespace OAI.Algorithms.SubexponentialSAT.Computation\n    84\t\n    85\tuniverse u\n    86\t\n    87\tinductive Trace {α : Type u} (step : α → Option α) : ℕ → α → α → Prop\n    88\t  | refl (a : α) : Trace step 0 a a\n    89\t  | cons {n : ℕ} {a b c : α} :\n    90\t      step a = some b → Trace step n b c → Trace step (n + 1) a c\n    91\t\n    92\tstructure PrimitiveMachine where\n    93\t  tapeCount : ℕ\n    94\t  stateCount : ℕ\n    95\t  inputTape : Fin tapeCount\n    96\t  start : Fin stateCount\n    97\t  scan : Fin stateCount → Fin tapeCount\n    98\t  transition : Fin stateCount → Option Bool →\n    99\t    Bool ⊕ (Fin stateCount × Turing.TM0.Stmt (Option Bool))\n   100\t\n   101\tnamespace PrimitiveMachine\n   102\t\n   103\tstructure Cfg (machine : PrimitiveMachine) where\n   104\t  state : Bool ⊕ Fin machine.stateCount\n   105\t  tapes : Fin machine.tapeCount 