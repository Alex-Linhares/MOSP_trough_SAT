    4100 * (Encoding.formulaBitLength F + 1) ^ 2 + 15) ≤\n          5022740 * (Encoding.formulaBitLength F + 1) ^ 2 := by\n        have hbase : Encoding.formulaBitLength F + 1 ≤\n            (Encoding.formulaBitLength F + 1) ^ 2 := Nat.le_self_pow (by decide) _\n        omega\n      exact (Nat.cast_le.mpr (hsmall.trans hpoly)).trans\n        (hspaceBound (Encoding.formulaBitLength F)).2\n  · obtain ⟨time, final, htrace, hhalt, hcount, hanswer, htime, hprefix⟩ :=\n      hlarge n F hw (by omega)\n    refine ⟨time, final, htrace, hcount, hanswer, hhalt,\n      countWord_toNat _, countWord_count_length F,\n      htime.trans (htimeBound n (Encoding.formulaBitLength F)).1, ?_⟩\n    intro prefixSteps intermediate hp htr\n    have hreal : (visitedSpace intermediate : ℝ) ≤\n        (S : ℝ) * ((Encoding.formulaBitLength F : ℝ) + 1) ^ e := by\n      exact_mod_cast hprefix prefixSteps intermediate hp htr\n    exact hreal.trans (hspaceBound (Encoding.formulaBitLength F)).1\n\n/-- One fixed primitive machine exactly counts every bounded-width formula,\ndecides satisfiability, meets the square-root-logarithmic time bound, and uses\n== contract 785-795\n        ((Nat.le_max_right _ _).trans hs)).trans hfinal\n\n/-- Uniform counting contract for the fixed native leaf. The remaining\nhypotheses concern only numerical caps chosen by the outer program. There\nis no local execution, query evaluator, successful code or resource service\npremise. -/\ntheorem uniform_contract (k parameterCoefficient parameterDegree : ℕ) (hk : 2 ≤ k) :\n    ∃ Cs spaceDegree : ℕ, ∃ Ct At : ℝ, ∃ timeDegree cutoff : ℕ,\n      1 ≤ Ct ∧ 1 ≤ At ∧ 1 ≤ timeDegree ∧\n      ∀ n inputLength parameterBound bound : ℕ, cutoff ≤ n → n ≤ inputLength →\n      parameterBound ≤ parameterCoefficient * (inputLength + 1) ^ parameterDegree →\n== Statement.lean head\nimport OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.Asymptotics\nimport OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.EncodingBounds\n\n/-! Numerical transport for the frozen endpoint signatures in `specification/main-theorem.md`.\nThe existence of the required finite counting program is not asserted in this module. -/\n\nnamespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace\n\ntheorem runtimeBound_le_eth {n k : ℕ} (F : SAT.CNF (Fin n))\n    (hw : SAT.WidthAtMost k F) (hn : 20 ≤ n) {C A : ℝ}\n    (hC : 0 ≤ C) (hA : 0 ≤ A) (d : ℕ) :\n    SqrtLog.Statement.runtimeBound C A d (Encoding.formulaBitLength F) n ≤\n9:theorem runtimeBound_le_eth {n k : ℕ} (F : SAT.CNF (Fin n))\n== comparator README lines in replay README?\n15:the one theorem the comparator JSON names\n190:| the replay copy | `git rev-parse HEAD` = `4eaee87548250b2682affda7d05d947c05554bae`, the same as the pristine clone; the comparator file and the solution files hash the same in both (`logs/run2/hashes.txt`) |\n192:Hashes (`logs/run2/hashes.txt`, `sha256sum`): the comparator statement\n230:is still not the comparator run (no statement-level match through\n5:\\placeholder{Item 08 drafts this section: the human audit of the August 2026 results (arXiv 2608.14673), the working group named in the collection's history, Impagliazzo--Paturi, Impagliazzo--Paturi--Zane, the comparator mechanism, nanoda; ``we found no prior statement'', never ``first''. Ends with what this does not claim''.}\nShell cwd was reset to /home/al/dev/MOSP","is_error":false}]},"parent_tool_use_id":null,"session_id":"a784a7f7-656a-4734-be78-2354d2f491db","uuid":"1948f08d-911a-4e85-a1d0-257183f5e8e0","timestamp":"2026-11-05T03:33:27.627Z","tool_use_result":{"stdout":"theorem compiled_exact_count_and_sat (k : ℕ) (hk : 2 ≤ k) :\n    ∃ (labels : ℕ) (program : BitProgram.Program 80 1220 labels)\n      (C A S : ℝ) (d e : ℕ),\n      program.outputStack = 1216 ∧\n      0 < C ∧ 0 < A ∧ 0 < S ∧ 0 < d ∧ 0 < e ∧\n      ∀ (n : ℕ) (F : SAT.CNF (Fin n)), SAT.WidthAtMost k F →\n        ∃ (time : ℕ) (final : LocatedCfg (GuardedCompiler.primitive program)),\n          Computation.Trace (locatedStep (GuardedCompiler.pri