x\" / \"data\" / \"doi_check.json\"","+UA = {\"User-Agent\": \"paper3-refcheck/0.1 (mailto:none@example.org)\"}","+# Disagreements read by hand and accepted, with the reason.","+KNOWN: dict[str, str] = {}","+","+","+def lookup(e: dict) -> dict | None:","+    \"\"\"Best Crossref match for an entry without a DOI, by bibliographic query.\"\"\"","+    first = e.get(\"author\", \"\").split(\" and \")[0]","+    q = f\"{e.get('title', '')} {first} {e.get('year', '')}\"","+    url = \"https://api.crossref.org/works?rows=3&query.bibliographic=\" + urllib.parse.quote(q)","+    req = urllib.request.Request(url, headers=UA)","+    items = json.load(urllib.request.urlopen(req, timeout=30))[\"message\"][\"items\"]","+    for m in items:","+        title = (m.get(\"title\") or [\"\"])[0]","+        fam = (m.get(\"author\") or [{}])[0].get(\"family\", \"\")","+        year = (m.get(\"issued\", {}).get(\"date-parts\") or [[None]])[0][0]","+        t_ok = norm(title).startswith(norm(e[\"title\"])[:40]) or norm(e[\"title\"]).startswith(norm(title)[:40])","+        f = first.split(\",\")[0] if \",\" in first else first.split()[-1]","+        a_ok = norm(fam) == norm(f) or norm(f).endswith(norm(fam))","+        if t_ok and a_ok:","+            return {\"doi\": m[\"DOI\"], \"title\": title, \"year\": year, \"first_author\": fam,","+                    \"container\": (m.get(\"container-title\") or [\"\"])[0], \"type\": m.get(\"type\")}","+    return None","+","+","+def main() -> int:","+    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\")[0])","+    ap.add_argument(\"--refresh\", action=\"store_true\")","+    ap.add_argument(\"--lookup\", action=\"store_true\")","+    args = ap.parse_args()","+    cache = {} if args.refresh or not CACHE.exists() else json.loads(CACHE.read_text())","+    bad = 0","+    es = entries(BIB.read_text())","+    print(f\"# {date.today().isoformat()} {BIB.relative_to(ROOT)}\")","+    for e in es:","+        doi = e.get(\"doi\")","+        if not doi