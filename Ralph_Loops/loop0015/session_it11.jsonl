ing dense {CSPs}},\n  booktitle = {44th International Colloquium on Automata, Languages, and Programming (ICALP 2017)},\n  series    = {LIPIcs},\n  volume    = {80},\n  pages     = {78:1--78:15},\n  year      = {2017},\n  note      = {Entry copied from the manuscript's reference list, extract lines 3759--3761; no DOI checked}\n}\n\n% The randomised Gap-ETH (the manuscript's \"[CCK+20, Conjecture 2.5]\"). Extract lines 3689-3691.\n@article{Chalermsook2020,\n  author  = {Chalermsook, Parinya and Cygan, Marek and Kortsarz, Guy and Laekhanukit, Bundit and Manurangsi, Pasin and Nanongkai, Danupon and Trevisan, Luca},\n  title   = {From {Gap-Exponential} {Time} {Hypothesis} to fixed parameter tractable inapproximability: {Clique}, {Dominating} {Set}, and more},\n  journal = {SIAM Journal on Computing},\n  volume  = {49}, number = {4}, pages = {772--810}, year = {2020},\n  note    = {Entry copied from the manuscript's reference list, extract lines 3689--3691; no DOI checked}\n}\n\n% NSETH. Extract lines 3686-3688 ([CGI+16]).\n@inproceedings{Carmosino2016,\n  author    = {Carmosino, Marco L. and Gao, Jiawei and Impagliazzo, Russell and Mihajlin, Ivan and Paturi, Ramamohan and Schneider, Stefan},\n  title     = {Nondeterministic extensions of the {Strong} {Exponential} {Time} {Hypothesis} and consequences for non-reducibility},\n  booktitle = {7th Innovations in Theoretical Computer Science Conference (ITCS 2016)},\n  pages     = {261--270},\n  year      = {2016},\n  note      = {Entry copied from the manuscript's reference list, extract lines 3686--3688; no DOI checked}\n}\n\n% #ETH and the bounded-error randomised ETH (the manuscript's \"[DHM+14, Section 1]\"). Extract lines 3708-3710.\n@article{Dell2014,\n  author  = {Dell, Holger and Husfeldt, Thore and Marx, D{\\'a}niel and Taslaman, Nina and Wahl{\\'e}n, Martin},\n  title   = {Exponential time complexity of the permanent and the {Tutte} polynomial},\n  journal = {ACM Transactions on Algorithms},\n  volume  = {10}, numb