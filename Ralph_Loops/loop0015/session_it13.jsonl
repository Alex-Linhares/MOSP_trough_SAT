ems \"XX:\" pattern\nop_heads=re.findall(r'(S[1-8]|0[1-9][a-g]|08x[a-d]|1[0-2][a-g]):', desc)\nprint('open heads', len(op_heads))\nimport collections\ndup=[k for k,v in collections.Counter(res+proc+op_heads).items() if v>1]\nprint('dups', dup)\nmissing=allentries-set(res+proc+op_heads); print('missing', sorted(missing))\nextra=set(res+proc+op_heads)-allentries; print('extra', extra)\nbib=re.findall(pat, tail[tail.index('Fourteen'):tail.index('The rest')])\nprint('bib', len(bib), bib, set(bib)-set(op_heads))\nEOF","description":"Check the open-questions subsection's arithmetic: every entry once, 7/15/39, 14 bibliographic"}},"wire_ingest_context":{"toolu_01UmVt8uWg4SzfonuvbMf4Dq":{"cwd":"/home/al/dev/MOSP/paper3/latex"}}}
