:6,"newStart":260,"newLines":28,"lines":["     return problems, agree_enum, agree_approx, within"," "," ","+CLONE = pathlib.Path.home() / \"dev\" / \"untrusted\" / \"openai-math\"","+FAMILY = CLONE / \"lean\" / \"OAI\" / \"Algorithms\" / \"SubexponentialSAT\"","+","+","+def clone_check() -> dict:","+    \"\"\"Read-only (open() only): the family has no #eval, no `def main`, no IO action; the","+    comparator theorem is existential in the machine.  So no implementation of the verified","+    machine that could be run is on record in the clone.\"\"\"","+    import re","+    n_files = n_eval = n_main = n_io = 0","+    for f in FAMILY.rglob(\"*.lean\"):","+        n_files += 1","+        txt = f.read_text(errors=\"replace\")","+        n_eval += len(re.findall(r\"^\\s*#eval\\b\", txt, re.M))","+        n_main += len(re.findall(r\"^\\s*def\\s+main\\b\", txt, re.M))","+        n_io += len(re.findall(r\"\\bIO\\s+(Unit|Bool|Nat|String|\\()\", txt))","+    comp = (CLONE / \"lean\" / \"ComparatorChallenges\" / \"SubexponentialSAT.lean\").read_text().splitlines()","+    existential = comp[194].strip().startswith(\"∃ (machine : Computation.PrimitiveMachine)\")","+    return {\"family_files\": n_files, \"eval\": n_eval, \"def_main\": n_main, \"io_actions\": n_io,","+            \"theorem_existential_in_machine\": existential}","+","+"," def summary(rows):","     out = {}","     for r in rows:"]},{"oldStart":396,"oldLines":6,"newStart":418,"newLines":11,"lines":["             print(f\"n={n}: measured CaDiCaL median {st[0]:.4f} s against 2^n guarantee {scale * 2 ** n:.3g} s \"","                   f\"({math.log10(scale * 2 ** n / st[0]):.1f} decades) and 2^rho guarantee {scale * 2 ** rho(n):.3g} s \"","                   f\"({math.log10(scale * 2 ** rho(n) / st[0]):.1f} decades)\")","+    if CLONE.exists():","+        cc = clone_check()","+        print(f\"clone (read-only): {cc}\")","+        if cc[\"eval\"] or cc[\"def_main\"] or cc[\"io_actions\"] or not cc[\"theorem_existentia