rn M"," "," ","+def pad_with_aux(B: np.ndarray, U: np.ndarray, sigma: np.ndarray, kmin_pattern: int = 2,","+                 patterns_first: bool = False) -> np.ndarray:","+    \"\"\"The fitted generator's repairs as a deterministic function of the base","+    matrix and `omega` (customers first, then patterns; `patterns_first` for","+    the variant). `M >= B` entrywise for every `(B, omega)`.\"\"\"","+    if patterns_first:","+        return pad_customers_with_aux(pad_patterns_with_aux(B, sigma, kmin_pattern), U)","+    return pad_patterns_with_aux(pad_customers_with_aux(B, U), sigma, kmin_pattern)","+","+"," def unconditional_pad(B: np.ndarray, U: np.ndarray, sigma: np.ndarray, kmin_pattern: int = 2) -> np.ndarray:","     \"\"\"`M+ = B` with every pad applied whether needed or not: entry `(U[j], j)`","     for every customer and the first `kmin_pattern` of `sigma[i]` for every","-    pattern. `pad_with_aux(B, U, sigma) <= M+` and `M+` is monotone in `B` at","-    fixed `omega`, which `pad_with_aux` is not.\"\"\"","+    pattern. `pad_with_aux(B, U, sigma) <= M+` in both orders, and `M+` is","+    monotone in `B` at fixed `omega`, which `pad_with_aux` is not.\"\"\"","     M = B.copy()","     m, n = M.shape","     M[U, np.arange(n)] = True"]},{"oldStart":993,"oldLines":12,"newStart":1052,"newLines":12,"lines":["     return bool(B.any(axis=0).all() and (B.sum(axis=1) >= kmin_pattern).all())"," "," ","-def generator_draw(n: int, m: int, p: float, rng: np.random.Generator) -> dict:","+def generator_draw(n: int, m: int, p: float, rng: np.random.Generator, patterns_first: bool = False) -> dict:","     \"\"\"One draw of the fitted generator with its coupling: the base `B`, the","     padded `M`, the unconditional `M+`, and the events.\"\"\"","     B = rng.random((m, n)) < p","     U, sigma = draw_aux(m, n, rng)","-    M = pad_with_aux(B, U, sigma)","+    M = pad_with_aux(B, U, sigma, patterns_first=patterns_first)","     Mp = unconditional_pad(B, U, sigma)","     return {