iles":[{"filePath":"/home/al/dev/MOSP/learning/first_moment.py","hunks":[{"oldStart":1130,"oldLines":3,"newStart":1130,"newLines":65,"lines":["         best = min(f[S & ~(1 << v)] for v in range(n) if (S >> v) & 1)","         f[S] = max(cost, best)","     return f[full]","+","+","+# --- the quenched form: a Chernoff typical set on the i.i.d. sizes -------------","+","+","+def size_law(n: int, p: float, kmin: int = 0) -> tuple[np.ndarray, np.ndarray]:","+    \"\"\"The pattern-size law before the customer pad: `s ~ Bin(n, p)`, lifted to","+    `max(s, kmin)` (`kmin = 2` is the patterns-first pattern pad). Returns the","+    distinct sizes and their probabilities.\"\"\"","+    pmf = np.array([math.exp(log_binomial_pmf(n, p, s)) for s in range(n + 1)])","+    sizes = np.maximum(np.arange(n + 1), kmin)","+    out: dict[int, float] = {}","+    for s, w in zip(sizes, pmf):","+        out[int(s)] = out.get(int(s), 0.0) + float(w)","+    ss = np.array(sorted(out))","+    return ss, np.array([out[int(s)] for s in ss])","+","+","+def log_bound_quenched(n: int, m: int, p: float, k: int, kmin: int = 0,","+                       a_points: int = 400, lambdas: np.ndarray | None = None) -> float:","+    \"\"\"log of the rigorous *quenched* union bound on `P(pw <= k)` when the","+    patterns are independent uniform sets of i.i.d. sizes `s_j ~ max(Bin(n, p), kmin)`","+    (Lemma V1 / Theorem V3 of §10 of the report): with `X_j = log q(n, t, s_j)`,","+","+        P(pw <= k) <= min_a [ C(n,t) C(n-t,t-1) e^{m a} + min_{lambda > 0} e^{-lambda m a} (E e^{lambda X})^m ],","+","+    because given sizes with `sum_j X_j <= m a` the uniform-model union bound is","+    at most the first term, and the second is Chernoff's bound on the sizes","+    being atypical. Sizes with `q = 0` (a pattern too large to miss either","+    side) only lower the sum and are kept at `X = -inf` in the first term and","+    dropped from the moment generating function, which can only enlarge the","+    bound. `kmin = 0` is the Bernoulli base, `kmin = 2` the patterns-first pad.\"\"\"","+    t = (n - k + 1) // 2","+    if t < 1 or 2 * t - 1 > n:","+        return math.inf","+    ss, pr = size_law(n, p, kmin)","+    X = np.array([lq(n, t, int(s)) for s in ss])","+    finite = np.isfinite(X)","+    if not finite.any():","+        return -math.inf","+    Xf, prf = X[finite], pr[finite]","+    if lambdas is None:","+        lambdas = np.logspace(-2, 2.5, 120)","+    # log E e^{lambda X} over the finite part (the -inf sizes contribute 0)","+    lmgf = np.array([math.log(float(np.sum(prf * np.exp(lam * Xf)))) if np.sum(prf * np.exp(lam * Xf)) > 0 else -math.inf","+                     for lam in lambdas])","+    mean_x = float(np.sum(prf * Xf) / np.sum(prf)) if np.sum(prf) > 0 else float(Xf.min())","+    lo, hi = min(mean_x, float(Xf.min())), float(Xf.max())","+    a_grid = np.linspace(lo, hi, a_points)","+    lp = log_pairs(n, t)","+    best = math.inf","+    for a in a_grid:","+        first = lp + m * a","+        tail = float(np.min(-lambdas * m * a + m * lmgf))","+        mx = max(first, tail)","+        best = min(best, mx + math.log(math.exp(first - mx) + math.exp(tail - mx)))","+    return best","+","+","+def floors_quenched(n: int, m: int, p: float, kmin: int = 0, log_factor: float = 0.0) -> tuple[int, int]:","+    \"\"\"Floors from `log_bound_quenched + log_factor` (`log_factor = -log P(accepted)` for the rejection).\"\"\"","+    return floors_from(log_bound_quenched(n, m, p, k, kmin) + log_factor for k in range(n))"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/learning/first_moment.py"]}},"tool_result_meta":[{"id":"toolu_011WfFVfgzju6mybYwgcNzaW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
