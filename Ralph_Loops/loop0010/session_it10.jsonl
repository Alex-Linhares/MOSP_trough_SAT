kmin: int = 0, log_factor: float = 0.0) -> tuple[int, int]:\n    \"\"\"Floors from `log_bound_quenched + log_factor` (`log_factor = -log P(accepted)` for the rejection).\"\"\"\n    return floors_from(log_bound_quenched(n, m, p, k, kmin) + log_factor for k in range(n))''',\n'''def floors_quenched(n: int, m: int, p: float, kmin: int = 0, log_factor: float = 0.0) -> tuple[int, int]:\n    \"\"\"Floors from `log_bound_quenched + log_factor` (`log_factor = -log P(accepted)` for the rejection).\"\"\"\n    return floors_from(log_bound_quenched(n, m, p, k, kmin) + log_factor for k in range(n))\n\n\ndef floors_best(n: int, m: int, p: float, kmin: int = 0, log_factor: float = 0.0) -> tuple[int, int]:\n    \"\"\"Floors from the smaller of the annealed and quenched bounds, plus `log_factor`.\"\"\"\n    return floors_from(log_bound_best(n, m, p, k, kmin) + log_factor for k in range(n))''')\nf.write_text(s)\nEOF\npython - <<'EOF'\nimport learning.first_moment as fm, time\nt0=time.time()\nfor cls in [(30,30,2),(30,30,4),(50,50,4),(125,125,2),(125,125,4),(125,125,6),(125,125,10),(100,50,6)]:\n    n,m,d = cls; p=d/n\n    print(cls, \"annealed\", fm.floors_bernoulli(n,m,p), \"quenched\", fm.floors_quenched(n,m,p), \"best\", fm.floors_best(n,m,p), \"| trunc annealed\", fm.floors_truncated(n,m,p), \"quenched\", fm.floors_quenched(n,m,p,2), \"best\", fm.floors_best(n,m,p,2))\nprint(time.time()-t0)\nEOF","description":"Refine the quenched bound into its binned form and compare with the annealed one"}},"wire_ingest_context":{"toolu_01DvE9bYAMSwWvN3RL269ZHX":{"cwd":"/home/al/dev/MOSP"}}}
