eld B, w","+","+","+def test_empty_pair_probability_and_cut_bound_by_enumeration():","+    m, n, p = 2, 5, Fraction(1, 3)","+    A, R = {0, 1}, {2}","+    t = 2","+    empty = Fraction(0)","+    disconnected = Fraction(0)","+    for B, w in _enumerate_base(m, n, p):","+        meets_both = any(B[i, list(A)].any() and B[i, list(R)].any() for i in range(m))","+        empty += w * (not meets_both)","+        disconnected += w * (not mosp_connected(B))","+    formula = ((1 - p) ** t + (1 - p) ** (t - 1) - (1 - p) ** (2 * t - 1)) ** m","+    assert empty == formula","+    # the closed-form cut bound is a bound on P(G_B disconnected) (a union bound, so above it)","+    assert float(disconnected) <= math.exp(log_disconnected_bound(n, m, float(p))) + 1e-12","+    # and the repair bound is a bound on P(some repair fires)","+    repair = sum(w for B, w in _enumerate_base(m, n, p) if not no_repair_needed(B))","+    assert float(repair) <= math.exp(log_repair_bound(n, m, float(p))) + 1e-12","+","+","+def _random_base(rng, m, n, p):","+    return rng.random((m, n)) < p","+","+","+def test_repairs_only_add_and_are_dominated_by_the_unconditional_pad():","+    rng = np.random.default_rng(10)","+    for _ in range(300):","+        m, n = int(rng.integers(2, 7)), int(rng.integers(2, 8))","+        B = _random_base(rng, m, n, rng.uniform(0.05, 0.5))","+        U, sigma = draw_aux(m, n, rng)","+        for first in (False, True):","+            M = pad_with_aux(B, U, sigma, patterns_first=first)","+            Mp = unconditional_pad(B, U, sigma)","+            assert np.all(M >= B) and np.all(Mp >= M)","+            assert M.any(axis=0).all() and (M.sum(axis=1) >= 2).all()","+            # the pads add exactly the deficiency, in the order applied","+            if not first:","+                M1 = pad_customers_with_aux(B, U)","+                assert (M1.sum() - B.sum()) == (~B.any(axis=0)).sum()","+                assert (M.sum() - M1.sum()) == np.clip(2 - M1.sum(axis=1), 0, None).sum()","+            # the unconditional pad is monotone in the base","+            extra = _random_base(rng, m, n, 0.2)","+            assert np.all(unconditional_pad(B | extra, U, sigma) >= Mp)","+            if no_repair_needed(B):","+                assert np.array_equal(M, B)","+","+","+def test_pattern_pad_rows_are_uniform_sets_of_the_truncated_size():","+    # the patterns-first lemma: given |B[i]| = s, the padded row is a uniform set of size max(s, 2)","+    rng = np.random.default_rng(11)","+    n, draws = 5, 20000","+    counts = {s: {} for s in (0, 1, 2)}","+    for _ in range(draws):","+        B = _random_base(rng, 1, n, 0.25)","+        s = int(B.sum())","+        if s > 2:","+            continue","+        _, sigma = draw_aux(1, n, rng)","+        row = tuple(np.flatnonzero(pad_patterns_with_aux(B, sigma)[0]))","+        counts[s][row] = counts[s].get(row, 0) + 1","+    for s in (0, 1, 2):","+        rows = counts[s]","+        assert len(rows) == math.comb(n, 2)","+        total = sum(rows.values())","+        expected = total / math.comb(n, 2)","+        chi2 = sum((c - expected) ** 2 / expected for c in rows.values())","+        assert chi2 < 40  # 9 degrees of freedom; 99.9% point is 27.9, with margin","+","+","+def test_empty_pairs_of_the_padded_graph_are_empty_in_the_base_and_pathwidth_is_monotone():","+    from fixed_parameter_algorithm.pathwidth import compute_pathwidth","+    import networkx as nx","+","+    rng = np.random.default_rng(12)","+    for _ in range(60):","+        m, n = int(rng.integers(2, 7)), int(rng.integers(3, 8))","+        B = _random_base(rng, m, n, rng.uniform(0.05, 0.4))","+        U, sigma = draw_aux(m, n, rng)","+        M = pad_with_aux(B, U, sigma)","+        adjB, adjM = customer_masks(B), customer_masks(M)","+        assert all(a & b == a for a, b in zip(adjB, adjM))  # G_B is a subgraph of G_M","+        for A in range(1, 1 << n):","+            for R in range(1, 1 << n):","+                if A & R:","+                    continue","+                emptyM = all(not ((mask := sum(1 << int(c) for c in np.flatnonzero(M[i]))) & A and mask & R) for i in range(m))","+                emptyB = all(not ((mask := sum(1 << int(c) for c in np.flatnonzero(B[i]))) & A and mask & R) for i in range(m))","+                assert (not emptyM) or emptyB","+        pwB, pwM = vertex_separation_brute(adjB), vertex_separation_brute(adjM)","+        assert pwB <= pwM","+        G = nx.Graph()","+        G.add_nodes_from(range(n))","+        G.add_edges_from((u, v) for u in range(n) for v in range(u + 1, n) if (adjM[u] >> v) & 1)","+        assert compute_pathwidth(G)[0] == pwM","+","+","+def test_the_repair_map_is_not_monotone_in_the_base():","+    # B: patterns {3,4}, {}, {3,4}; customers 1, 2 empty. The pads make it connected.","+    # B' = B + two ones: pattern 2 = {1, 2}; no pad fires and the instance is disconnected.","+    B = np.zeros((3, 5), bool)","+    B[0, [3, 4]] = True","+    B[2, [3, 4]] = True","+    U = np.array([0, 0, 0, 0, 0])","+    sigma = np.array([[3, 4, 0, 1, 2]] * 3)","+    M = pad_with_aux(B, U, sigma)","+    Bp = B.copy()","+    Bp[1, [1, 2]] = True","+    Mp = pad_with_aux(Bp, U, sigma)","+    assert np.all(Bp >= B)","+    assert mosp_connected(M) and not mosp_connected(Mp)","+    assert not np.all(Mp >= M)","+    # and the pathwidth of the padded graph can fall when the base grows","+    assert vertex_separation_brute(customer_masks(Mp)) < vertex_separation_brute(customer_masks(M))","+    # while the unconditional pad is monotone and its connectivity increasing here","+    assert np.all(unconditional_pad(Bp, U, sigma) >= unconditional_pad(B, U, sigma))","+","+","+def test_rigorous_floors_are_monotone_and_ordered():","+    n, m = 40, 40","+    for d in (2, 4, 6, 10):","+        p = d / n","+        b, tr = floors_bernoulli(n, m, p), floors_truncated(n, m, p)","+        assert b[1] <= b[0] and tr[1] <= tr[0]","+        assert tr[0] >= b[0] and tr[1] >= b[1]","+        # monotone in p (the floor at p is valid for every density above p)","+        assert floors_bernoulli(n, m, 1.1 * p)[1] >= b[1]","+        # the rejection forms are ordered: closed/trivial <= harris_plus <= base, harris_E <= base","+        r = rejection_floors(n, m, p, p_acc=0.5, p_acc_plus=0.8)","+        assert r[\"trivial\"][1] <= r[\"harris_plus\"][1] <= r[\"base\"][1]","+        assert r[\"harris_E\"][1] <= r[\"base\"][1]","+        assert r[\"closed\"][1] <= r[\"base\"][1]","+        # the trivial form at acceptance 1 is the base","+        assert rejection_floors(n, m, p, p_acc=1.0)[\"trivial\"] == r[\"base\"]","+    assert floors_bernoulli(125, 125, 10 / 125) == floors_truncated(125, 125, 10 / 125)","+","+","+def test_wilson_interval_contains_the_point_estimate():","+    lo, hi = wilson(3, 200)","+    assert lo < 3 / 200 < hi and 0 <= lo and hi <= 1","+    assert wilson(0, 0) == (0.0, 1.0)"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/tests/test_first_moment.py"]}},"tool_result_meta":[{"id":"toolu_01DX5Xy3yyT6RqrfpkbXkWs9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
