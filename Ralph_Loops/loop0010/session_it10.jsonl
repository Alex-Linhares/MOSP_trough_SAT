+        terms.append(math.log(m) + math.log(n) + math.log(p) + (n - 1) * lp)","+    mx = max(terms)","+    return mx + math.log(sum(math.exp(x - mx) for x in terms))","+","+","+def rejection_floors(n: int, m: int, p: float, p_acc: float, p_acc_plus: float | None = None) -> dict[str, tuple[int, int]]:","+    \"\"\"The rigorous floors on the optimum of an *accepted* instance, given the","+    acceptance probability `p_acc` (and `P(conn M+)`, `p_acc_plus`): `base` (no","+    rejection; valid for the generator without the discard), `trivial`","+    (`/ p_acc`), `harris_plus` (`* p_acc_plus / p_acc`), `harris_E` (`+ P(E^c)","+    / p_acc` with the closed-form union bound on `P(E^c)`) and `closed`","+    (`/ (1 - P(G_B disconnected))` with the closed-form cut bound, no measured","+    quantity at all; `(0, 0)` where that bound is vacuous).\"\"\"","+    out = {\"base\": floors_bernoulli(n, m, p)}","+    out[\"trivial\"] = floors_bernoulli(n, m, p, log_factor=-math.log(p_acc))","+    if p_acc_plus is not None:","+        out[\"harris_plus\"] = floors_bernoulli(n, m, p, log_factor=math.log(p_acc_plus) - math.log(p_acc))","+    out[\"harris_E\"] = floors_bernoulli(n, m, p, additive=math.exp(log_repair_bound(n, m, p)) / p_acc)","+    ld = log_disconnected_bound(n, m, p)","+    if ld < 0:","+        out[\"closed\"] = floors_bernoulli(n, m, p, log_factor=-math.log1p(-math.exp(ld)))","+    else:","+        out[\"closed\"] = (0, 0)","+    return out","+","+","+# --- the generator with its auxiliary randomness made explicit ---------------","+","+","+def draw_aux(m: int, n: int, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:","+    \"\"\"`omega = (U, sigma)`: `U[j]` a uniform pattern for customer `j`,","+    `sigma[i]` a uniform order of the customers for pattern `i`; independent of","+    the base matrix.\"\"\"","+    U = rng.integers(0, m, size=n)","+    sigma = np.argsort(rng.random((m, n)), axis=1)","+    return U, sigma","+","+","+def pad_with_aux(B: np.ndarray, U: np.ndarray, sigma: np.ndarray, kmin_pattern: int = 2) -> np.ndarray:","+    \"\"\"The fitted generator's repairs as a deterministic function of the base","+    matrix and `omega`: every empty customer `j` joins pattern `U[j]`; every","+    pattern `i` with fewer than `kmin_pattern` customers gains the first ones","+    it lacks in the order `sigma[i]`. Same law as `gen_candidates.pad_patterns","+    (pad_customers(B, 1), 2)`; `M >= B` entrywise for every `(B, omega)`.\"\"\"","+    M = B.copy()","+    for j in np.flatnonzero(~M.any(axis=0)):","+        M[U[j], j] = True","+    for i in np.flatnonzero(M.sum(axis=1) < kmin_pattern):","+        need = kmin_pattern - int(M[i].sum())","+        for c in sigma[i]:","+            if need == 0:","+                break","+            if not M[i, c]:","+                M[i, c] = True","+                need -= 1","+    return M","+","+","+def unconditional_pad(B: np.ndarray, U: np.ndarray, sigma: np.ndarray, kmin_pattern: int = 2) -> np.ndarray:","+    \"\"\"`M+ = B` with every pad applied whether needed or not: entry `(U[j], j)`","+    for every customer and the first `kmin_pattern` of `sigma[i]` for every","+    pattern. `pad_with_aux(B, U, sigma) <= M+` and `M+` is monotone in `B` at","+    fixed `omega`, which `pad_with_aux` is not.\"\"\"","+    M = B.copy()","+    m, n = M.shape","+    M[U, np.arange(n)] = True","+    for i in range(m):","+        M[i, sigma[i][:kmin_pattern]] = True","+    return M","+","+","+def mosp_connected(M: np.ndarray) -> bool:","+    \"\"\"Is the MOSP graph of the `patterns x customers` matrix connected (customers","+    adjacent iff they share a pattern)? As `gen_candidates.mosp_connected`.\"\"\"","+    m, n = M.shape","+    seen_c = np.zeros(n, bool)","+    seen_c[0] = True","+    while True:","+        seen_p = M[:, seen_c].any(axis=1)","+        new_c = M[seen_p].any(axis=0) | seen_c","+        if new_c.sum() == seen_c.sum():","+            return bool(seen_c.all())","+        seen_c = new_c","+","+","+def no_repair_needed(B: np.ndarray, kmin_pattern: int = 2) -> bool:","+    \"\"\"The event `E`: every customer of `B` has a pattern and every pattern has","+    at least `kmin_pattern` customers, so the repairs do nothing.\"\"\"","+    return bool(B.any(axis=0).all() and (B.sum(axis=1) >= kmin_pattern).all())","+","+","+def generator_draw(n: int, m: int, p: float, rng: np.random.Generator) -> dict:","+    \"\"\"One draw of the fitted generator with its coupling: the base `B`, the","+    padded `M`, the unconditional `M+`, and the events.\"\"\"","+    B = rng.random((m, n)) < p","+    U, sigma = draw_aux(m, n, rng)","+    M = pad_with_aux(B, U, sigma)","+    Mp = unconditional_pad(B, U, sigma)","+    return {\"B\": B, \"M\": M, \"Mp\": Mp, \"U\": U, \"sigma\": sigma,","+            \"accepted\": mosp_connected(M), \"accepted_plus\": mosp_connected(Mp),","+            \"base_connected\": mosp_connected(B), \"no_repair\": no_repair_needed(B)}","+","+","+def generator_event_rates(n: int, m: int, p: float, draws: int, seed: int = 0,","+                          min_accepted: int = 0, max_draws: int | None = None) -> dict:","+    \"\"\"Counts over independent draws of `accepted`, `accepted_plus` (`M+`","+    connected), `base_connected`, `no_repair` and `repair_and_accepted`;","+    draws continue past `draws` until `min_accepted` acceptances or","+    `max_draws`.\"\"\"","+    rng = np.random.default_rng(seed)","+    c = {\"draws\": 0, \"accepted\": 0, \"accepted_plus\": 0, \"base_connected\": 0, \"no_repair\": 0, \"repair_and_accepted\": 0}","+    cap = max_draws if max_draws is not None else draws","+    while c[\"draws\"] < draws or (c[\"accepted\"] < min_accepted and c[\"draws\"] < cap):","+        d = generator_draw(n, m, p, rng)","+        c[\"draws\"] += 1","+        c[\"accepted\"] += d[\"accepted\"]","+        c[\"accepted_plus\"] += d[\"accepted_plus\"]","+        c[\"base_connected\"] += d[\"base_connected\"]","+        c[\"no_repair\"] += d[\"no_repair\"]","+        c[\"repair_and_accepted\"] += (not d[\"no_repair\"]) and d[\"accepted\"]","+    return c","+","+","+def wilson(successes: int, trials: int, z: float = 1.959964) -> tuple[float, float]:","+    \"\"\"Wilson 95% interval for a binomial proportion.\"\"\"","+    if trials == 0:","+        return 0.0, 1.0","+    ph = successes / trials","+    den = 1 + z * z / trials","+    centre = (ph + z * z / (2 * trials)) / den","+    half = z * math.sqrt(ph * (1 - ph) / trials + z * z / (4 * trials * trials)) / den","+    return max(0.0, centre - half), min(1.0, centre + half)","+","+","+# --- exact pathwidth of a tiny graph, for the checks -------------------------","+","+","+def customer_masks(M: np.ndarray) -> list[int]:","+    \"\"\"Adjacency bit masks of the MOSP graph of a `patterns x customers` matrix.\"\"\"","+    m, n = M.shape","+    adj = [0] * n","+    for i in range(m):","+        cols = np.flatnonzero(M[i])","+        mask = sum(1 << int(c) for c in cols)","+        for c in cols:","+            adj[int(c)] |= mask & ~(1 << int(c))","+    return adj","+","+","+def vertex_separation_brute(adj: list[int]) -> int:","+    \"\"\"The vertex separation (= pathwidth) of a graph on `n <= 16` vertices given","+    as adjacency bit masks, by the subset DP `f(S) = max(cost(S), min_v f(S - v))`","+    with `cost(S)` the number of placed vertices with a neighbour outside.\"\"\"","+    n = len(adj)","+    full = (1 << n) - 1","+    f = [0] * (1 << n)","+    for S in range(1, 1 << n):","+        cost = 0","+        rest = full & ~S","+        T = S","+        while T:","+            v = T & -T","+            T ^= v","+            if adj[v.bit_length() - 1] & rest:","+                cost += 1","+        best = min(f[S & ~(1 << v)] for v in range(n) if (S >> v) & 1)","+        f[S] = max(cost, best)","+    return f[full]"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/learning/first_moment.py"]}},"tool_result_meta":[{"id":"toolu_0187aBXyee1xascHojkyL9MZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
