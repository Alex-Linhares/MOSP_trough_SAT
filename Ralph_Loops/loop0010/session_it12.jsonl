\"12\"], \"graph theory\"),\n    (\"edge separation\", \"Edge separation\", [\"14\"], \"graph theory\"),\n]\nCITE = {\"1\": \"Yanasse1997b\", \"4\": \"LY2002ref4\", \"5\": \"LY2002ref5\", \"6\": \"LY2002ref6\",\n        \"7\": \"LY2002ref7\", \"8\": \"LY2002ref8\", \"9\": \"LY2002ref9\", \"10\": \"LY2002ref10\",\n        \"11\": \"LY2002ref11\", \"12\": \"LY2002ref12\", \"13\": \"LY2002ref13\", \"14\": \"LY2002ref14\"}\n\n\ndef names_table() -> str:\n    from paper1.section2_figures import QUERIES, numbers\n    num = numbers()\n    disc_of = {k: d for k, _, d, _ in QUERIES}\n    words = {\"GT\": \"graph theory\", \"VLSI\": \"VLSI\", \"OR\": \"operations research\"}\n    n, cited = num[\"names\"], num[\"cited_by\"]\n----\n71\n14:@article{LY2002,\n26:@article{Yanasse1997b,\n35:@article{LY2002ref4,\n45:@inproceedings{LY2002ref5,\n54:@incollection{LY2002ref6,\n64:@article{LY2002ref7,\n73:@article{LY2002ref8,\n82:@article{LY2002ref9,\n90:@article{LY2002ref10,\n98:@article{LY2002ref11,\n107:@article{LY2002ref12,\n115:@article{LY2002ref13,\n123:@article{LY2002ref14,\n137:@article{Yanasse1997a,\n145:@article{YanasseSenne2010,\n154:@article{FellowsLangston1987,\n162:@inproceedings{FellowsLangston1989,\n172:@article{EllisSudboroughTurner1994,\n181:@article{BienstockSeymour1991,\n190:@article{LaPaugh1993,\n201:@misc{Priem2022,\n211:@inproceedings{ChuStuckey2009,\n225:@phdthesis{Linhares2001,\n237:@article{GarciaDeLaBandaStuckey2007,\n245:@phdthesis{Chu2011,\n257:@phdthesis{Fink2012,\n267:@article{Frinhani2018,\n277:@article{MartinYanassePinto2022,\n285:@inproceedings{Beck2025,\n298:@inproceedings{SuchanVillanger2009,\n307:@article{Bodlaender2012,\n316:@inproceedings{CoudertMazauricNisse2014,\n326:@article{CoudertMazauricNisse2016,\n335:@inproceedings{KobayashiKomuroTamaki2014,\n347:@article{Kitsunai2016,\n358:@article{FaggioliBentivoglio1998,\n367:@inproceedings{SmithGent2005,\n375:@article{CarvalhoSoma2015,\n384:@article{OliveiraLorena2002,\n393:@article{Duarte2012,\n403:@article{MartiCamposPinana2008,\n411:@article{Mallach2018,\n420:@article{DiBattista1997,\n430:@inproceedings{PACE2016,\n441:@inproceedings{PACE2017,\n453:@misc{TreewidthLIB,\n462:@misc{freetdi,\n473:@article{BRST1991,\n484:@article{KumfertPothen1997,\n493:@inproceedings{SuchanTodinca2007,\n503:@article{BodlaenderWolleKoster2006,\n514:@article{BodlaenderKoster2011,\n526:@article{EllisWarren2008,\n538:@inproceedings{MouraUllrich2021,\n549:@inproceedings{Mathlib2020,\n558:@inproceedings{CaDiCaL2024,\n569:@inproceedings{WetzlerHeuleHunt2014,\n580:@inproceedings{PySAT2018,\n591:@article{McKayPiperno2014,\n602:@techreport{DeGiovanni2010,\n612:@article{DeGiovanni2013a,\n624:@article{DeGiovanni2013b,\n636:@book{Knuth2015,\n644:@article{Harper1966,\n655:@article{ChandranKavitha2006,\n667:@article{Turner1986,\n675:@article{DiazPetitSernaTrevisan2001,\n683:@article{PerarnauSerra2014,\n691:@article{LeeLeeOum2012,\n699:@book{CoverThomas2006,\n708:@article{Gao2012,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01M2P9McZWsGoRWE4sABo5np","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
