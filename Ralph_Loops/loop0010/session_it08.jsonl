log(\"d mu e | beta* | beta*_1 beta*_2 beta*_3 beta*_4 | beta*_2 - beta* | at beta*+0.005: min_pos g2, argmin, #neg of 465, g1\", f)","+        for r in rows:","+            log(f\"{r['d']:2d} {r['mu']:>3} {r['e']:4.1f} | {r['beta_star']:.4f} | {r['beta_1']:.4f} {r['beta_2']:.4f} {r['beta_3']:.4f} {r['beta_4']:.4f} | {r['beta_2']-r['beta_star']:+.4f} | \"","+                + (f\"{r['g2_min']:+.4f} {r['g2_argmin']} {r['g2_negative']} {r['g1_at_probe']:+.4f}\" if 'g2_min' in r else \"(beta* = 0)\") + f\"  [{r['secs']:.0f} s]\", f)","+        # the degenerate limit at (6, 1): p_2 - p_1 = eps around the balanced point","+        d, mu = 6, 1","+        bs = beta_star(mu, [d])","+        beta = bs - 0.005","+        g1 = nested_rate_sup(1, beta, mu, [d])[0]","+        log(f\"\\n(6, 1) at beta = beta* - 0.005 = {beta:.4f}: single pair exponent {g1:+.5f}; ell = 2 with p_1 = balanced, p_2 = balanced + eps:\", f)","+        for eps in (0.1, 0.03, 0.01, 0.003, 0.001, 0.0003, 0.0001):","+            p1 = (1 - beta) / 2","+            g = nested_rate_sup(2, beta, mu, [d], positions=[p1, p1 + eps], starts=3, cloud=20)[0]","+            log(f\"  eps = {eps:<7} exponent {g:+.5f}  excess over single pair {g - g1:+.5f}  (eps log(1/eps) = {eps*math.log(1/eps):.5f})\", f)","+","+","+# ---------------------------------------------------------------- floors","+def floor_job(args):","+    key, name, sizes = args","+    n, m, d = key","+    t0 = time.time()","+    old = floors(n, sizes)","+    f1 = nested_floors(1, n, sizes)","+    f2 = nested_floors(2, n, sizes, k_min=max(0, old[0] - 6))","+    # position search at ell = 2: +-3 around equal spacing, at k = f2 floor (<1) and above","+    k = f2[0] - 2","+    best_k = k","+    for kk in range(max(0, k), n):","+        base = [int(round(p)) for p in equal_positions(2, n, kk)]","+        found = False","+        for a in range(-3, 4):","+            for b in range(-3, 4):","+                pos = [base[0] + a, base[1] + b]","+              