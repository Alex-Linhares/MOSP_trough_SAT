e_file\": \"\", \"collection\": \"simulation\", \"series\": f\"{gen} n={n} d={d}\", \"generator\": gen,\n                \"param\": d, \"cell\": f\"{gen}_n{n}_m{m}_d{d}\", \"optimum\": opt, \"certified\": True})\n    return row\n\n\ndef simulation_rows(workers: int, sim_csv: Path = SIM_CSV) -> pd.DataFrame:\n    \"\"\"The 7,200 generator simulations, regenerated from their seeds with the\n    scratch generator; their optima are certified (`sim_solutions/`).\"\"\"\n    if not sim_csv.exists():\n        return pd.DataFrame()\n    f = pd.read_csv(sim_csv)\n    jobs = [(r.gen, int(r.n), int(r.m), int(r.d), int(r.seed), int(r.ones), int(r.opt)) for r in f.itertuples()]\n    return pd.DataFrame(_map(_sim_job, jobs, workers))\n\n\ndef _map(fn, jobs, workers: int) -> list:\n----\n9:## 1. The map: every instance on record placed by its excess (item 01, 2026-10-31)\n49:### 1.1 Findings\n144:### 1.2 Kill verdict\n153:### 1.3 What this does not claim\n164:### 1.4 Figure\n174:### 1.5 Tables, in full\n887:## 2. `opt / n` against the excess: one parameter, or two? (item 02, 2026-11-01)\n935:### 2.1 Findings\n1024:### 2.2 Kill verdict\n1035:### 2.3 What this does not claim\n1055:### 2.4 Figure\n1068:### 2.5 Tables, in full\n1282:## 3. The forest regime, by brute force (item 03, 2026-11-01)\n1378:### 3.1 Findings\n1484:### 3.2 Kill verdict\n1504:### 3.3 What this does not claim\n1526:### 3.4 Tables, in full\n1881:### 3.5 The two censored random block trees, rerun for an hour each\n1903:## 4. Industrial instances: the 24 SCOOP instances in the excess (item 04, 2026-11-01)\n1984:### 4.1 Findings\n2090:### 4.2 The planner's statement (a draft of the paper's paragraph)\n2134:### 4.3 Kill verdict\n2144:### 4.4 What this does not claim\n2165:### 4.5 Tables, in full\n----\n\n#### The cost model against the counts on record\n\n| collection           | config   | rows          |   counts | n range   |   MAE (decades) |    bias |   max abs err |   within a decade |\n|:---------------------|:-