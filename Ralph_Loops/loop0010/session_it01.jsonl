\", \\\"r\\\", \\\"n\\\"]):\",\"         g = g.sort_values(\\\"e median\\\")\",\"         e, y = g[\\\"e median\\\"].to_numpy(), g[\\\"lcc frac\\\"].to_numpy()\",\"         e_g = float(g[\\\"e_g(r)\\\"].iloc[0])\",\"+        r_exact = float(frame.loc[(frame[\\\"generator\\\"] == gen) & (frame[\\\"r_label\\\"] == rl), \\\"r\\\"].median())\",\"+        if (gen, rl) not in repaired:\",\"+            repaired[(gen, rl)] = repaired_giant_threshold_excess(gen, r_exact)\",\"         row = {\\\"generator\\\": gen, \\\"r\\\": rl, \\\"n\\\": int(n), \\\"cells\\\": len(g), \\\"e range\\\": f\\\"{e.min():.2f}-{e.max():.2f}\\\",\",\"-               \\\"lcc range\\\": f\\\"{y.min():.2f}-{y.max():.2f}\\\", \\\"e_g(r)\\\": e_g}\",\"+               \\\"lcc range\\\": f\\\"{y.min():.2f}-{y.max():.2f}\\\", \\\"e_g(r)\\\": e_g, \\\"e_g repaired\\\": repaired[(gen, rl)]}\",\"         above = y >= 0.5\",\"         if above.all():\",\"             row.update({\\\"crossing\\\": np.nan, \\\"delta\\\": np.nan, \\\"verdict\\\": \\\"not observable (all cells above 1/2)\\\"})\"]},{\"oldStart\":543,\"oldLines\":16,\"newStart\":560,\"newLines\":15,\"lines\":[\"         ax.tick_params(colors=\\\"#52514e\\\", labelsize=8)\",\"     for ax in axes[-1]:\",\"         ax.set_xlabel(\\\"excess e = (n_ones − m) / n\\\", fontsize=9, color=\\\"#52514e\\\")\",\"-    for ax in axes[:, 0]:\",\"-        ax.set_ylabel(\\\"largest component of B, fraction of n + m\\\", fontsize=9, color=\\\"#52514e\\\")\",\"-    handles, labels = axes.ravel()[0].get_legend_handles_labels()\",\"-    if not handles:\",\"-        for ax in axes.ravel():\",\"-            handles, labels = ax.get_legend_handles_labels()\",\"-            if handles:\",\"-                break\",\"-    fig.legend(handles, labels, loc=\\\"upper right\\\", frameon=False, fontsize=9, ncol=2)\",\"-    fig.tight_layout(rect=(0, 0, 1, 0.96))\",\"+    fig.supylabel(\\\"largest component of B, fraction of its n + m vertices (cell means)\\\", fontsize=9,\",\"+                  color=\\\"#52514e\\\")\",\"+    seen: dict[str, object] = {}\",\"+    for ax in axes.ravel():\",\"+        for h, lab in zip(*ax.get_legend_handles_labels()):\",\"+            seen.setdefault(lab, h)\",\"+    labels = [f\\\"{lab} generator (paler = smaller n; dashed: e_g(r); dotted: one half)\\\" for lab in seen]\",\"+    fig.legend(list(seen.values()), labels, loc=\\\"upper right\\\", frameon=False, fontsize=9, ncol=1)\",\"+    fig.tight_layout(rect=(0.02, 0, 1, 0.93))\",\"     out.parent.mkdir(parents=True, exist_ok=True)\",\"     fig.savefig(out, dpi=150, facecolor=\\\"#fcfcfb\\\")\",\"     plt.close(fig)\"]}]},{\"filePath\":\"/home/al/dev/MOSP/tests/test_excess.py\",\"hunks\":[{\"oldStart\":1,\"oldLines\":0,\"newStart\":1,\"newLines\":117,\"lines\":[\"+\\\"\\\"\\\"loop0010 item 01: the excess `e = (n_ones - m) / n`, the incidence graph's\",\"+components and cyclomatic number, the forest flag against the (2, 2)-core, and\",\"+the three lines, on hand-checkable matrices.\\\"\\\"\\\"\",\"+\",\"+import numpy as np\",\"+import pandas as pd\",\"+import pytest\",\"+\",\"+from learning.excess import (collection_of, crossing_table, excess, giant_threshold_excess, incidence_stats,\",\"+                             ratio_label, repaired_giant_threshold_excess, series_table)\",\"+\",\"+# A forest: the path c0 - p0 - c1 - p1 - c2 in the incidence graph.\",\"+PATH = np.array([[1, 0],\",\"+                 [1, 1],\",\"+                 [0, 1]])\",\"+# A non-forest: K_{2,2} plus a pendant pattern on c0, one cycle.\",\"+CYCLE = np.array([[1, 1, 1],\",\"+                  [1, 1, 0]])\",\"+# Two components, one of them a 4-cycle: gamma = 1, kappa = 2.\",\"+TWO = np.array([[1, 1, 0],\",\"+                [1, 1, 0],\",\"+                [0, 0, 1]])\",\"+\",\"+\",\"+def test_path_is_a_forest_by_hand():\",\"+    s = incidence_stats(PATH)\",\"+    assert (s[\\\"n\\\"], s[\\\"m\\\"], s[\\\"n_ones\\\"]) == (3, 2, 4)\",\"+    assert s[\\\"e\\\"] == pytest.approx((4 - 2) / 3)          # mean patterns per customer 4/3, minus one\",\"+    assert s[\\\"kappa\\\"] == 1 and s[\\\"gamma\\\"] == 0 and s[\\\"forest\\\"]\",\"+    assert s[\\\"lcc_frac\\\"] == 1.0 and s[\\\"lcc_cust_frac\\\"] == 1.0\",\"+    assert s[\\\"core2_cust_frac\\\"] == 0.0 and s[\\\"core2_vertex_frac\\\"] == 0.0\",\"+\",\"+\",\"+def test_cycle_by_hand():\",\"+    s = incidence_stats(CYCLE)\",\"+    assert (s[\\\"n\\\"], s[\\\"m\\\"], s[\\\"n_ones\\\"]) == (2, 3, 5)\",\"+    assert s[\\\"e\\\"] == pytest.approx((5 - 3) / 2)\",\"+    assert s[\\\"kappa\\\"] == 1\",\"+    assert s[\\\"gamma\\\"] == 5 - 2 - 3 + 1 == 1 and not s[\\\"forest\\\"]\",\"+    assert s[\\\"gamma_n\\\"] == pytest.approx(0.5)\",\"+    # the 2-core is the 4-cycle: both customers, two of the three patterns\",\"+    assert s[\\\"core2_cust_frac\\\"] == 1.0 and s[\\\"core2_prod_frac\\\"] == pytest.approx(2 / 3)\",\"+    assert s[\\\"core2_vertex_frac\\\"] == pytest.approx(4 / 5)\",\"+\",\"+\",\"+def test_two_components_by_hand():\",\"+    s = incidence_stats(TWO)\",\"+    assert s[\\\"kappa\\\"] == 2\",\"+    assert s[\\\"gamma\\\"] == 5 - 3 - 3 + 2 == 1\",\"+    assert s[\\\"gamma_n\\\"] == pytest.approx(s[\\\"e\\\"] - 1 + s[\\\"kappa\\\"] / s[\\\"n\\\"])   # the identity gamma/n = e - 1 + kappa/n\",\"+    assert s[\\\"lcc_frac\\\"] == pytest.approx(4 / 6) and s[\\\"lcc_cust_frac\\\"] == pytest.approx(2 / 3)\",\"+    assert not s[\\\"forest\\\"]\",\"+\",\"+\",\"+def test_excess_is_r_times_c_minus_one():\",\"+    rng = np.random.default_rng(7)\",\"+    for _ in range(20):\",\"+        n, m = int(rng.integers(2, 30)), int(rng.integers(2, 40))\",\"+        a = (rng.random((n, m)) < 0.3).astype(int)\",\"+        a[np.arange(n), rng.integers(0, m, n)] = 1\",\"+        a[rng.integers(0, n, m), np.arange(m)] = 1\",\"+        s = incidence_stats(a)\",\"+        assert s[\\\"e\\\"] == pytest.approx(excess(n, m, a.sum()))\",\"+        assert s[\\\"e\\\"] == pytest.approx(s[\\\"r\\\"] * (s[\\\"c\\\"] - 1))\",\"+        assert s[\\\"gamma_n\\\"] == pytest.approx(s[\\\"e\\\"] - 1 + s[\\\"kappa\\\"] / n)\",\"+        assert s[\\\"forest\\\"] == (s[\\\"core2_vertex_frac\\\"] == 0.0)\",\"+\",\"+\",\"+def test_giant_threshold_in_excess_coordinates():\",\"+    # fixed sizes: r c (c - 1) = 1 with e = r (c - 1)\",\"+    for r in (0.125, 0.5, 1.0, 2.0, 8.0):\",\"+        e = giant_threshold_excess(r)\",\"+        c = 1 + e / r\",\"+        assert r * c * (c - 1) == pytest.approx(1.0)\",\"+    assert giant_threshold_excess(1.0) == pytest.approx((np.sqrt(5) - 1) / 2)\",\"+    # Poisson sizes: r c^2 = 1\",\"+    assert giant_threshold_excess(0.25, \\\"bernoulli\\\") == pytest.approx(0.5 - 0.25)\",\"+    # the padded generators have a higher threshold than the unpadded fixed form at r = 1/2\",\"+    assert repaired_giant_threshold_excess(\\\"fixed\\\", 0.5) > giant_threshold_excess(0.5)\",\"+\",\"+\",\"+def test_ratio_labels_absorb_the_frames_rounding():\",\"+    assert ratio_label(0.12) == \\\"n/8\\\" and ratio_label(0.24) == \\\"n/4\\\" and ratio_label(0.493) == \\\"n/2\\\"\",\"+    assert ratio_label(1.0) == \\\"n\\\" and ratio_label(8.0) == \\\"8n\\\"\",\"+\",\"+\",\"+def test_collections_and_classes():\",\"+    assert collection_of(\\\"benchmarks/instances/MOSP_Instances/Chu_Stuckey/Random-125-125-2-2.txt\\\",\",\"+                         \\\"Random-125-125-2-2_0\\\") == (\\\"Chu & Stuckey\\\", \\\"Random-125-125-2\\\")\",\"+    assert collection_of(\\\"benchmarks/instances/ChallengeInstances2005/Harvey/wbo_10_10.txt\\\", \\\"x\\\") == (\\\"Harvey\\\", \\\"wbo_10_10\\\")\",\"+    assert collection_of(\\\"benchmarks/instances/MOSP_Instances/SCOOP/scoop-B_REVAL_145.txt\\\", \\\"scoop-B_REVAL_145_0\\\") == (\\\"SCOOP\\\", \\\"SCOOP\\\")\",\"+    assert collection_of(\\\"benchmarks/instances/MOSP_Instances/Faggioli_Bentivoglio/x.txt\\\", \\\"y\\\")[0] == \\\"Faggioli-Bentivoglio\\\"\",\"+\",\"+\",\"+def _synthetic_frame() -> pd.DataFrame:\",\"+    \\\"\\\"\\\"Three cells of one series whose largest component rises through one half.\\\"\\\"\\\"\",\"+    rows = []\",\"+    for param, e, lcc in ((2, 0.4, 0.2), (3, 0.8, 0.6), (4, 1.2, 0.9)):\",\"+        for i in range(3):\",\"+            rows.append({\\\"source\\\": \\\"ensemble\\\", \\\"generator\\\": \\\"fixed\\\", \\\"r_label\\\": \\\"n\\\", \\\"r\\\": 1.0, \\\"param\\\": param,\",\"+                         \\\"n\\\": 50, \\\"m\\\": 50, \\\"e\\\": e, \\\"gamma_n\\\": e - 1 + 0.02, \\\"forest\\\": False,\",\"+                         \\\"core2_cust_frac\\\": 0.5, \\\"lcc_frac\\\": lcc, \\\"lcc_cust_frac\\\": lcc, \\\"certified\\\": True})\",\"+    return pd.DataFrame(rows)\",\"+\",\"+\",\"+def test_crossing_is_interpolated_between_the_straddling_cells():\",\"+    f = _synthetic_frame()\",\"+    cells = series_table(f)\",\"+    assert len(cells) == 3 and list(cells[\\\"param\\\"]) == [2, 3, 4]\",\"+    cross = crossing_table(f, min_n=50)\",\"+    assert len(cross) == 1\",\"+    # between (0.4, 0.2) and (0.8, 0.6): one half at e = 0.7\",\"+    assert cross[\\\"crossing\\\"].iloc[0] == pytest.approx(0.7)\",\"+    assert cross[\\\"delta\\\"].iloc[0] == pytest.approx(0.7 - giant_threshold_excess(1.0))\",\"+    assert cross[\\\"verdict\\\"].iloc[0] == \\\"within tolerance\\\"\",\"+    f.loc[:, \\\"lcc_frac\\\"] = 0.9\",\"+    assert crossing_table(f, min_n=50)[\\\"verdict\\\"].iloc[0].startswith(\\\"not observable\\\")\"]}],\"created\":true},{\"filePath\":\"/home/al/dev/MOSP/Ralph_Loops/loop0010/session_it01.jsonl\",\"hunks\":[{\"oldStart\":230,\"oldLines\":3,\"newStart\":230,\"newLines\":5,\"lines\":[\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-fable-5-1\\\",\\\"id\\\":\\\"msg_011Cgb7fMPL44S2ZXUka6sBU\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"thinking\\\",\\\"thinking\\\":\\\"\\\",\\\"signature\\\":\\\"\\\"}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":32,\\\"cache_creation_input_tokens\\\":3006,\\\"cache_read_input_tokens\\\":146870,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":3006,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":8,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\",\\\"speed\\\":\\\"standard\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"6fbbd79f-1a23-452c-9cee-0dd980004c76\\\",\\\"uuid\\\":\\\"b23effcf-041d-4cfb-90f8-2904baee256e\\\",\\\"timestamp\\\":\\\"2026-10-31T22:37:39.528Z\\\",\\\"request_id\\\":\\\"req_011Cgb7fM11RZ7SdJiqizrHm\\\",\\\"thinking_duration_ms\\\":10799,\\\"thinking_display\\\":\\\"updates\\\"}\",\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-fable-5-1\\\",\\\"id\\\":\\\"msg_011Cgb7fMPL44S2ZXUka6sBU\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Next I'll make four independent changes: the repaired-generator threshold beside `e_g(r)` in the check table, the figure's legend and y-label, the CSV reader's dtype warning, and the test module.\\\"}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":32,\\\"cache_creation_input_tokens\\\":3006,\\\"cache_read_input_tokens\\\":146870,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":3006,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":8,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\",\\\"speed\\\":\\\"standard\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"6fbbd79f-1a23-452c-9cee-0dd980004c76\\\",\\\"uuid\\\":\\\"a72c3c07-dcc4-4869-8f45-676fd7287dee\\\",\\\"timestamp\\\":\\\"2026-10-31T22:37:39.532Z\\\",\\\"request_id\\\":\\\"req_011Cgb7fM11RZ7SdJiqizrHm\\\"}\",\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-fable-5-1\\\",\\\"id\\\":\\\"msg_011Cgb7fMPL44S2ZXUka6sBU\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"tool_use\\\",\\\"id\\\":\\\"toolu_012k4kvoU3NHBcBL4kPBF1DB\\\",\\\"name\\\":\\\"Bash\\\",\\\"input\\\":{\\\"command\\\":\\\"python3 - <<'EOF'\\\\nfrom pathlib import Path\\\\np = Path(\\\\\\\"learning/excess.py\\\\\\\"); s = p.read_text()\\\\n\\\\n# 1. repaired threshold column in the check table\\\\ns = s.replace('''def crossing_table(frame: pd.DataFrame, min_n: int = CHECK_MIN_N, tol: float = CHECK_TOLERANCE) -> pd.DataFrame:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The stated check. For every ensemble series `(generator, r, n)` at\\\\n    `n >= min_n`, the cells ordered by their median `e`; the `e` at which the\\\\n    mean largest-component fraction of `B` crosses one half (linear\\\\n    interpolation between the two cells that straddle it), against `e_g(r)`.\\\\n    A series whose cells all sit on one side of one half cannot test the\\\\n    prediction and says so.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    cells = series_table(frame)\\\\n    cells = cells[cells[\\\\\\\"n\\\\\\\"] >= min_n]\\\\n    rows = []\\\\n    for (gen, rl, n), g in cells.groupby([\\\\\\\"generator\\\\\\\", \\\\\\\"r\\\\\\\", \\\\\\\"n\\\\\\\"]):\\\\n        g = g.sort_values(\\\\\\\"e median\\\\\\\")\\\\n        e, y = g[\\\\\\\"e median\\\\\\\"].to_numpy(), g[\\\\\\\"lcc frac\\\\\\\"].to_numpy()\\\\n        e_g = float(g[\\\\\\\"e_g(r)\\\\\\\"].iloc[0])\\\\n        row = {\\\\\\\"generator\\\\\\\": gen, \\\\\\\"r\\\\\\\": rl, \\\\\\\"n\\\\\\\": int(n), \\\\\\\"cells\\\\\\\": len(g), \\\\\\\"e range\\\\\\\": f\\\\\\\"{e.min():.2f}-{e.max():.2f}\\\\\\\",\\\\n               \\\\\\\"lcc range\\\\\\\": f\\\\\\\"{y.min():.2f}-{y.max():.2f}\\\\\\\", \\\\\\\"e_g(r)\\\\\\\": e_g}''',\\\\n'''def repaired_giant_threshold_excess(generator: str, r: float) -> float:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The giant-component threshold of the incidence graph in excess\\\\n    coordinates under the generators' actual degree distributions (empty\\\\n    customers padded to one pattern, empty patterns to one customer), from the\\\\n    configuration-model 2-core fixed point of `learning.cover_excess`; the\\\\n    2-core appears continuously at the branching-factor-one point.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    from learning.cover_excess import core_threshold_col_mean\\\\n    c = core_threshold_col_mean(generator, r, 2, 2, repair=True)\\\\n    return float(r * (c - 1.0)) if np.isfinite(c) else np.nan\\\\n\\\\n\\\\ndef crossing_table(frame: pd.DataFrame, min_n: int = CHECK_MIN_N, tol: float = CHECK_TOLERANCE) -> pd.DataFrame:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The stated check. For every ensemble series `(generator, r, n)` at\\\\n    `n >= min_n`, the cells ordered by their median `e`; the `e` at which the\\\\n    mean largest-component fraction of `B` crosses one half (linear\\\\n    interpolation between the two cells that straddle it), against `e_g(r)`.\\\\n    A series whose cells all sit on one side of one half cannot test the\\\\n    prediction and says so. `e_g repaired` is the same threshold under the\\\\n    generators' padded degree distributions, for information; the verdict is\\\\n    against the plan's `e_g(r)`.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    cells = series_table(frame)\\\\n    cells = cells[cells[\\\\\\\"n\\\\\\\"] >= min_n]\\\\n    rows = []\\\\n    repaired = {}\\\\n    for (gen, rl, n), g in cells.groupby([\\\\\\\"generator\\\\\\\", \\\\\\\"r\\\\\\\", \\\\\\\"n\\\\\\\"]):\\\\n        g = g.sort_values(\\\\\\\"e median\\\\\\\")\\\\n        e, y = g[\\\\\\\"e median\\\\\\\"].to_numpy(), g[\\\\\\\"lcc frac\\\\\\\"].to_numpy()\\\\n        e_g = float(g[\\\\\\\"e_g(r)\\\\\\\"].iloc[0])\\\\n        r_exact = float(frame.loc[(frame[\\\\\\\"generator\\\\\\\"] == gen) & (frame[\\\\\\\"r_label\\\\\\\"] == rl), \\\\\\\"r\\\\\\\"].median())\\\\n        if (gen, rl) not in repaired:\\\\n            repaired[(gen, rl)] = repaired_giant_threshold_excess(gen, r_exact)\\\\n        row = {\\\\\\\"generator\\\\\\\": gen, \\\\\\\"r\\\\\\\": rl, \\\\\\\"n\\\\\\\": int(n), \\\\\\\"cells\\\\\\\": len(g), \\\\\\\"e range\\\\\\\": f\\\\\\\"{e.min():.2f}-{e.max():.2f}\\\\\\\",\\\\n               \\\\\\\"lcc range\\\\\\\": f\\\\\\\"{y.min():.2f}-{y.max():.2f}\\\\\\\", \\\\\\\"e_g(r)\\\\\\\": e_g, \\\\\\\"e_g repaired\\\\\\\": repaired[(gen, rl)]}''')\\\\n\\\\n# 2. legend across all axes, one y-label\\\\ns = s.replace('''    for ax in axes[:, 0]:\\\\n        ax.set_ylabel(\\\\\\\"largest component of B, fraction of n + m\\\\\\\", fontsize=9, color=\\\\\\\"#52514e\\\\\\\")\\\\n    handles, labels = axes.ravel()[0].get_legend_handles_labels()\\\\n    if not handles:\\\\n        for ax in axes.ravel():\\\\n            handles, labels = ax.get_legend_handles_labels()\\\\n            if handles:\\\\n                break\\\\n    fig.legend(handles, labels, loc=\\\\\\\"upper right\\\\\\\", frameon=False, fontsize=9, ncol=2)\\\\n    fig.tight_layout(rect=(0, 0, 1, 0.96))''',\\\\n'''    fig.supylabel(\\\\\\\"largest component of B, fraction of its n + m vertices (cell means)\\\\\\\", fontsize=9,\\\\n                  color=\\\\\\\"#52514e\\\\\\\")\\\\n    seen: dict[str, object] = {}\\\\n    for ax in axes.ravel():\\\\n        for h, lab in zip(*ax.get_legend_handles_labels()):\\\\n            seen.setdefault(lab, h)\\\\n    labels = [f\\\\\\\"{lab} generator (paler = smaller n; dashed: e_g(r); dotted: one half)\\\\\\\" for lab in seen]\\\\n    fig.legend(list(seen.values()), labels, loc=\\\\\\\"upper right\\\\\\\", frameon=False, fontsize=9, ncol=1)\\\\n    fig.tight_layout(rect=(0.02, 0, 1, 0.93))''')\\\\n\\\\n# 3. dtype warning\\\\ns = s.replace('''    return pd.read_csv(path)\\\\n\\\\n\\\\n# ----------------------------------------------------------------------------\\\\n# tables''', '''    return pd.read_csv(path, low_memory=False)\\\\n\\\\n\\\\n# ----------------------------------------------------------------------------\\\\n# tables''')\\\\np.write_text(s)\\\\nEOF\\\\ncat > tests/test_excess.py <<'EOF'\\\\n\\\\\\\"\\\\\\\"\\\\\\\"loop0010 item 01: the excess `e = (n_ones - m) / n`, the incidence graph's\\\\ncomponents and cyclomatic number, the forest flag against the (2, 2)-core, and\\\\nthe three lines, on hand-checkable matrices.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nimport numpy as np\\\\nimport pandas as pd\\\\nimport pytest\\\\n\\\\nfrom learning.excess import (collection_of, crossing_table, excess, giant_threshold_excess, incidence_stats,\\\\n                             ratio_label, repaired_giant_threshold_excess, series_table)\\\\n\\\\n# A forest: the path c0 - p0 - c1 - p1 - c2 in the incidence graph.\\\\nPATH = np.array([[1, 0],\\\\n                 [1, 1],\\\\n                 [0, 1]])\\\\n# A non-forest: K_{2,2} plus a pendant pattern on c0, one cycle.\\\\nCYCLE = np.array([[1, 1, 1],\\\\n                  [1, 1, 0]])\\\\n# Two components, one of them a 4-cycle: gamma = 1, kappa = 2.\\\\nTWO = np.array([[1, 1, 0],\\\\n                [1, 1, 0],\\\\n                [0, 0, 1]])\\\\n\\\\n\\\\ndef test_path_is_a_forest_by_hand():\\\\n    s = incidence_stats(PATH)\\\\n    assert (s[\\\\\\\"n\\\\\\\"], s[\\\\\\\"m\\\\\\\"], s[\\\\\\\"n_ones\\\\\\\"]) == (3, 2, 4)\\\\n    assert s[\\\\\\\"e\\\\\\\"] == pytest.approx((4 - 2) / 3)          # mean patterns per customer 4/3, minus one\\\\n    assert s[\\\\\\\"kappa\\\\\\\"] == 1 and s[\\\\\\\"gamma\\\\\\\"] == 0 and s[\\\\\\\"forest\\\\\\\"]\\\\n    assert s[\\\\\\\"lcc_frac\\\\\\\"] == 1.0 and s[\\\\\\\"lcc_cust_frac\\\\\\\"] == 1.0\\\\n    assert s[\\\\\\\"core2_cust_frac\\\\\\\"] == 0.0 and s[\\\\\\\"core2_vertex_frac\\\\\\\"] == 0.0\\\\n\\\\n\\\\ndef test_cycle_by_hand():\\\\n    s = incidence_stats(CYCLE)\\\\n    assert (s[\\\\\\\"n\\\\\\\"], s[\\\\\\\"m\\\\\\\"], s[\\\\\\\"n_ones\\\\\\\"]) == (2, 3, 5)\\\\n    assert s[\\\\\\\"e\\\\\\\"] == pytest.approx((5 - 3) / 2)\\\\n    assert s[\\\\\\\"kappa\\\\\\\"] == 1\\\\n    assert s[\\\\\\\"gamma\\\\\\\"] == 5 - 2 - 3 + 1 == 1 and not s[\\\\\\\"forest\\\\\\\"]\\\\n    assert s[\\\\\\\"gamma_n\\\\\\\"] == pytest.approx(0.5)\\\\n    # the 2-core is the 4-cycle: both customers, two of the three patterns\\\\n    assert s[\\\\\\\"core2_cust_frac\\\\\\\"] == 1.0 and s[\\\\\\\"core2_prod_frac\\\\\\\"] == pytest.approx(2 / 3)\\\\n    assert s[\\\\\\\"core2_vertex_frac\\\\\\\"] == pytest.approx(4 / 5)\\\\n\\\\n\\\\ndef test_two_components_by_hand():\\\\n    s = incidence_stats(TWO)\\\\n    assert s[\\\\\\\"kappa\\\\\\\"] == 2\\\\n    assert s[\\\\\\\"gamma\\\\\\\"] == 5 - 3 - 3 + 2 == 1\\\\n    assert s[\\\\\\\"gamma_n\\\\\\\"] == pytest.approx(s[\\\\\\\"e\\\\\\\"] - 1 + s[\\\\\\\"kappa\\\\\\\"] / s[\\\\\\\"n\\\\\\\"])   # the identity gamma/n = e - 1 + kappa/n\\\\n    assert s[\\\\\\\"lcc_frac\\\\\\\"] == pytest.approx(4 / 6) and s[\\\\\\\"lcc_cust_frac\\\\\\\"] == pytest.approx(2 / 3)\\\\n    assert not s[\\\\\\\"forest\\\\\\\"]\\\\n\\\\n\\\\ndef test_excess_is_r_times_c_minus_one():\\\\n    rng = np.random.default_rng(7)\\\\n    for _ in range(20):\\\\n        n, m = int(rng.integers(2, 30)), int(rng.integers(2, 40))\\\\n        a = (rng.random((n, m)) < 0.3).astype(int)\\\\n        a[np.arange(n), rng.integers(0, m, n)] = 1\\\\n        a[rng.integers(0, n, m), np.arange(m)] = 1\\\\n        s = incidence_stats(a)\\\\n        assert s[\\\\\\\"e\\\\\\\"] == pytest.approx(excess(n, m, a.sum()))\\\\n        assert s[\\\\\\\"e\\\\\\\"] == pytest.approx(s[\\\\\\\"r\\\\\\\"] * (s[\\\\\\\"c\\\\\\\"] - 1))\\\\n        assert s[\\\\\\\"gamma_n\\\\\\\"] == pytest.approx(s[\\\\\\\"e\\\\\\\"] - 1 + s[\\\\\\\"kappa\\\\\\\"] / n)\\\\n        assert s[\\\\\\\"forest\\\\\\\"] == (s[\\\\\\\"core2_vertex_frac\\\\\\\"] == 0.0)\\\\n\\\\n\\\\ndef test_giant_threshold_in_excess_coordinates():\\\\n    # fixed sizes: r c (c - 1) = 1 with e = r (c - 1)\\\\n    for r in (0.125, 0.5, 1.0, 2.0, 8.0):\\\\n        e = giant_threshold_excess(r)\\\\n        c = 1 + e / r\\\\n        assert r * c * (c - 1) == pytest.approx(1.0)\\\\n    assert giant_threshold_excess(1.0) == pytest.approx((np.sqrt(5) - 1) / 2)\\\\n    # Poisson sizes: r c^2 = 1\\\\n    assert giant_threshold_excess(0.25, \\\\\\\"bernoulli\\\\\\\") == pytest.approx(0.5 - 0.25)\\\\n    # the padded generators have a higher threshold than the unpadded fixed form at r = 1/2\\\\n    assert repaired_giant_threshold_excess(\\\\\\\"fixed\\\\\\\", 0.5) > giant_threshold_excess(0.5)\\\\n\\\\n\\\\ndef test_ratio_labels_absorb_the_frames_rounding():\\\\n    assert ratio_label(0.12) == \\\\\\\"n/8\\\\\\\" and ratio_label(0.24) == \\\\\\\"n/4\\\\\\\" and ratio_label(0.493) == \\\\\\\"n/2\\\\\\\"\\\\n    assert ratio_label(1.0) == \\\\\\\"n\\\\\\\" and ratio_label(8.0) == \\\\\\\"8n\\\\\\\"\\\\n\\\\n\\\\ndef test_collections_and_classes():\\\\n    assert collection_of(\\\\\\\"benchmarks/instances/MOSP_Instances/Chu_Stuckey/Random-125-125-2-2.txt\\\\\\\",\\\\n                         \\\\\\\"Random-125-125-2-2_0\\\\\\\") == (\\\\\\\"Chu & Stuckey\\\\\\\", \\\\\\\"Random-125-125-2\\\\\\\")\\\\n    assert collection_of(\\\\\\\"benchmarks/instances/ChallengeInstances2005/Harvey/wbo_10_10.txt\\\\\\\", \\\\\\\"x\\\\\\\") == (\\\\\\\"Harvey\\\\\\\", \\\\\\\"wbo_10_10\\\\\\\")\\\\n    assert collection_of(\\\\\\\"benchmarks/instances/MOSP_Instances/SCOOP/scoop-B_REVAL_145.txt\\\\\\\", \\\\\\\"scoop-B_REVAL_145_0\\\\\\\") == (\\\\\\\"SCOOP\\\\\\\", \\\\\\\"SCOOP\\\\\\\")\\\\n    assert collection_of(\\\\\\\"benchmarks/instances/MOSP_Instances/Faggioli_Bentivoglio/x.txt\\\\\\\", \\\\\\\"y\\\\\\\")[0] == \\\\\\\"Faggioli-Bentivoglio\\\\\\\"\\\\n\\\\n\\\\ndef _synthetic_frame() -> pd.DataFrame:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Three cells of one series whose largest component rises through one half.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    rows = []\\\\n    for param, e, lcc in ((2, 0.4, 0.2), (3, 0.8, 0.6), (4, 1.2, 0.9)):\\\\n        for i in range(3):\\\\n            rows.append({\\\\\\\"source\\\\\\\": \\\\\\\"ensemble\\\\\\\", \\\\\\\"generator\\\\\\\": \\\\\\\"fixed\\\\\\\", \\\\\\\"r_label\\\\\\\": \\\\\\\"n\\\\\\\", \\\\\\\"r\\\\\\\": 1.0, \\\\\\\"param\\\\\\\": param,\\\\n                         \\\\\\\"n\\\\\\\": 50, \\\\\\\"m\\\\\\\": 50, \\\\\\\"e\\\\\\\": e, \\\\\\\"gamma_n\\\\\\\": e - 1 + 0.02, \\\\\\\"forest\\\\\\\": False,\\\\n                         \\\\\\\"core2_cust_frac\\\\\\\": 0.5, \\\\\\\"lcc_frac\\\\\\\": lcc, \\\\\\\"lcc_cust_frac\\\\\\\": lcc, \\\\\\\"certified\\\\\\\": True})\\\\n    return pd.DataFrame(rows)\\\\n\\\\n\\\\ndef test_crossing_is_interpolated_between_the_straddling_cells():\\\\n    f = _synthetic_frame()\\\\n    cells = series_table(f)\\\\n    assert len(cells) == 3 and list(cells[\\\\\\\"param\\\\\\\"]) == [2, 3, 4]\\\\n    cross = crossing_table(f, min_n=50)\\\\n    assert len(cross) == 1\\\\n    # between (0.4, 0.2) and (0.8, 0.6): one half at e = 0.7\\\\n    assert cross[\\\\\\\"crossing\\\\\\\"].iloc[0] == pytest.approx(0.7)\\\\n    assert cross[\\\\\\\"delta\\\\\\\"].iloc[0] == pytest.approx(0.7 - giant_threshold_excess(1.0))\\\\n    assert cross[\\\\\\\"verdict\\\\\\\"].iloc[0] == \\\\\\\"within tolerance\\\\\\\"\\\\n    f.loc[:, \\\\\\\"lcc_frac\\\\\\\"] = 0.9\\\\n    assert crossing_table(f, min_n=50)[\\\\\\\"verdict\\\\\\\"].iloc[0].startswith(\\\\\\\"not observable\\\\\\\")\\\\nEOF\\\\nnice -n 19 python3 -m pytest tests/test_excess.py -q 2>&1 | tail -5\\\",\\\"description\\\":\\\"Apply module edits, write tests, run them\\\",\\\"timeout\\\":300000},\\\"caller\\\":{\\\"type\\\":\\\"direct\\\"}}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":32,\\\"cache_creation_input_tokens\\\":3006,\\\"cache_read_input_tokens\\\":146870,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":3006,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":8,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\",\\\"speed\\\":\\\"standard\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"6fbbd79f-1a23-452c-9cee-0dd980004c76\\\",\\\"uuid\\\":\\\"85c1db30-8486-4fb6-acf5-be424b99beec\\\",\\\"timestamp\\\":\\\"2026-10-31T22:38:26.725Z\\\",\\\"request_id\\\":\\\"req_011Cgb7fM11RZ7SdJiqizrHm\\\",\\\"wire_tool_inputs\\\":{\\\"toolu_012k4kvoU3NHBcBL4kPBF1DB\\\":{\\\"command\\\":\\\"cd /home/al/dev/MOSP && python3 - <<'EOF'\\\\nfrom pathlib import Path\\\\np = Path(\\\\\\\"learning/excess.py\\\\\\\"); s = p.read_text()\\\\n\\\\n# 1. repaired threshold column in the check table\\\\ns = s.replace('''def crossing_table(frame: pd.DataFrame, min_n: int = CHECK_MIN_N, tol: float = CHECK_TOLERANCE) -> pd.DataFrame:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The stated check. For every ensemble series `(generator, r, n)` at\\\\n    `n >= min_n`, the cells ordered by their median `e`; the `e` at which the\\\\n    mean largest-component fraction of `B` crosses one half (linear\\\\n    interpolation between the two cells that straddle it), against `e_g(r)`.\\\\n    A series whose cells all sit on one side of one half cannot test the\\\\n    prediction and says so.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    cells = series_table(frame)\\\\n    cells = cells[cells[\\\\\\\"n\\\\\\\"] >= min_n]\\\\n    rows = []\\\\n    for (gen, rl, n), g in cells.groupby([\\\\\\\"generator\\\\\\\", \\\\\\\"r\\\\\\\", \\\\\\\"n\\\\\\\"]):\\\\n        g = g.sort_values(\\\\\\\"e median\\\\\\\")\\\\n        e, y = g[\\\\\\\"e median\\\\\\\"].to_numpy(), g[\\\\\\\"lcc frac\\\\\\\"].to_numpy()\\\\n        e_g = float(g[\\\\\\\"e_g(r)\\\\\\\"].iloc[0])\\\\n        row = {\\\\\\\"generator\\\\\\\": gen, \\\\\\\"r\\\\\\\": rl, \\\\\\\"n\\\\\\\": int(n), \\\\\\\"cells\\\\\\\": len(g), \\\\\\\"e range\\\\\\\": f\\\\\\\"{e.min():.2f}-{e.max():.2f}\\\\\\\",\\\\n               \\\\\\\"lcc range\\\\\\\": f\\\\\\\"{y.min():.2f}-{y.max():.2f}\\\\\\\", \\\\\\\"e_g(r)\\\\\\\": e_g}''',\\\\n'''def repaired_giant_threshold_excess(generator: str, r: float) -> float:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The giant-component threshold of the incidence graph in excess\\\\n    coordinates under the generators' actual degree distributions (empty\\\\n    customers padded to one pattern, empty patterns to one customer), from the\\\\n    configuration-model 2-core fixed point of `learning.cover_excess`; the\\\\n    2-core appears continuously at the branching-factor-one point.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    from learning.cover_excess import core_threshold_col_mean\\\\n    c = core_threshold_col_mean(generator, r, 2, 2, repair=True)\\\\n    return float(r * (c - 1.0)) if np.isfinite(c) else np.nan\\\\n\\\\n\\\\ndef crossing_table(frame: pd.DataFrame, min_n: int = CHECK_MIN_N, tol: float = CHECK_TOLERANCE) -> pd.DataFrame:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The stated check. For every ensemble series `(generator, r, n)` at\\\\n    `n >= min_n`, the cells ordered by their median `e`; the `e` at which the\\\\n    mean largest-component fraction of `B` crosses one half (linear\\\\n    interpolation between the two cells that straddle it), against `e_g(r)`.\\\\n    A series whose cells all sit on one side of one half cannot test the\\\\n    prediction and says so. `e_g repaired` is the same threshold under the\\\\n    generators' padded degree distributions, for information; the verdict is\\\\n    against the plan's `e_g(r)`.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    cells = series_table(frame)\\\\n    cells = cells[cells[\\\\\\\"n\\\\\\\"] >= min_n]\\\\n    rows = []\\\\n    repaired = {}\\\\n    for (gen, rl, n), g in cells.groupby([\\\\\\\"generator\\\\\\\", \\\\\\\"r\\\\\\\", \\\\\\\"n\\\\\\\"]):\\\\n        g = g.sort_values(\\\\\\\"e median\\\\\\\")\\\\n        e, y = g[\\\\\\\"e median\\\\\\\"].to_numpy(), g[\\\\\\\"lcc frac\\\\\\\"].to_numpy()\\\\n        e_g = float(g[\\\\\\\"e_g(r)\\\\\\\"].iloc[0])\\\\n        r_exact = float(frame.loc[(frame[\\\\\\\"generator\\\\\\\"] == gen) & (frame[\\\\\\\"r_label\\\\\\\"] == rl), \\\\\\\"r\\\\\\\"].median())\\\\n        if (gen, rl) not in repaired:\\\\n            repaired[(gen, rl)] = repaired_giant_threshold_excess(gen, r_exact)\\\\n        row = {\\\\\\\"generator\\\\\\\": gen, \\\\\\\"r\\\\\\\": rl, \\\\\\\"n\\\\\\\": int(n), \\\\\\\"cells\\\\\\\": len(g), \\\\\\\"e range\\\\\\\": f\\\\\\\"{e.min():.2f}-{e.max():.2f}\\\\\\\",\\\\n               \\\\\\\"lcc range\\\\\\\": f\\\\\\\"{y.min():.2f}-{y.max():.2f}\\\\\\\", \\\\\\\"e_g(r)\\\\\\\": e_g, \\\\\\\"e_g repaired\\\\\\\": repaired[(gen, rl)]}''')\\\\n\\\\n# 2. legend across all axes, one y-label\\\\ns = s.replace('''    for ax in axes[:, 0]:\\\\n        ax.set_ylabel(\\\\\\\"largest component of B, fraction of n + m\\\\\\\", fontsize=9, color=\\\\\\\"#52514e\\\\\\\")\\\\n    handles, labels = axes.ravel()[0].get_legend_handles_labels()\\\\n    if not handles:\\\\n        for ax in axes.ravel():\\\\n            handles, labels = ax.get_legend_handles_labels()\\\\n            if handles:\\\\n                break\\\\n    fig.legend(handles, labels, loc=\\\\\\\"upper right\\\\\\\", frameon=False, fontsize=9, ncol=2)\\\\n    fig.tight_layout(rect=(0, 0, 1, 0.96))''',\\\\n'''    fig.supylabel(\\\\\\\"largest component of B, fraction of its n + m vertices (cell means)\\\\\\\", fontsize=9,\\\\n                  color=\\\\\\\"#52514e\\\\\\\")\\\\n    seen: dict[str, object] = {}\\\\n    for ax in axes.ravel():\\\\n        for h, lab in zip(*ax.get_legend_handles_labels()):\\\\n            seen.setdefault(lab, h)\\\\n    labels = [f\\\\\\\"{lab} generator (paler = smaller n; dashed: e_g(r); dotted: one half)\\\\\\\" for lab in seen]\\\\n    fig.legend(list(seen.values()), labels, loc=\\\\\\\"upper right\\\\\\\", frameon=False, fontsize=9, ncol=1)\\\\n    fig.tight_layout(rect=(0.02, 0, 1, 0.93))''')\\\\n