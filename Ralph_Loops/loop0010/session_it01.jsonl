{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T6wKT35PBdMcxgeaeHU1LN","type":"tool_result","content":"\"\"\"Candidate generators for the Chu & Stuckey Random-n-m-d classes.\nMatrix convention here: M is (m patterns) x (n customers), bool.  d = nominal mean customers per pattern.\nEvery candidate returns an accepted matrix or None if the attempt cap is hit; `attempts` is recorded\nthrough the returned tuple (M, tries).\"\"\"\nimport numpy as np\n\ndef mosp_connected(M):\n    m, n = M.shape\n    seen_c = np.zeros(n, bool); seen_c[0] = True\n    while True:\n        seen_p = M[:, seen_c].any(axis=1)\n        new_c = M[seen_p].any(axis=0) | seen_c\n        if new_c.sum() == seen_c.sum():\n            return bool(seen_c.all())\n        seen_c = new_c\n\ndef bern(n, m, p, rng):\n    return rng.random((m, n)) < p\n\ndef fixed(n, m, d, rng):\n    idx = rng.random((m, n)).argsort(axis=1)[:, :d]\n    M = np.zeros((m, n), bool)\n    M[np.arange(m)[:, None], idx] = True\n    return M\n\ndef pad_customers(M, kmin, rng):\n    \"\"\"every customer (column) with fewer than kmin patterns joins random patterns it is not in.\"\"\"\n    m, n = M.shape\n    for j in np.flatnonzero(M.sum(axis=0) < kmin):\n        need = kmin - M[:, j].sum()\n        cand = np.flatnonzero(~M[:, j])\n        M[rng.choice(cand, need, replace=False), j] = True\n    return M\n\ndef pad_patterns(M, kmin, rng):\n    \"\"\"every pattern (row) with fewer than kmin customers gains random customers it does not have.\"\"\"\n    m, n = M.shape\n    for i in np.flatnonzero(M.sum(axis=1) < kmin):\n        need = kmin - M[i].sum()\n        cand = np.flatnonzero(~M[i])\n        M[i, rng.choice(cand, need, replace=False)] = True\n    return M\n\ndef resample_patterns(M, kmin, p, rng):\n    \"\"\"rows with fewer than kmin ones are redrawn (truncated binomial rows).\"\"\"\n    m, n = M.shape\n    while True:\n        bad = np.flatnonzero(M.sum(axis=1) < kmin)\n        if len(bad) == 0: return M\n        M[bad] = rng.random((len(bad), n)) < p\n\ndef with_rejection(draw, cap):\n    def g(n, m, d, rng):\n        for t in range(1, cap + 1):\n            M = draw(n, m, d, rng)\n            if mosp_connected(M): return M, t\n        return None, cap\n    return g\n\ndef no_rejection(draw):\n    def g(n, m, d, rng):\n        return draw(n, m, d, rng), 1\n    return g\n\nCAP = 2000\nCANDIDATES = {\n    # (i) exactly d per pattern, customers padded to >= 2\n    \"i_fixed_padC2\":        no_rejection(lambda n, m, d, r: pad_customers(fixed(n, m, d, r), 2, r)),\n    # (ii) Bernoulli(d/n), customers padded to >= 2\n    \"ii_bern_padC2\":        no_rejection(lambda n, m, d, r: pad_customers(bern(n, m, d / n, r), 2, r)),\n    # (iii) = (i) + discard decomposable\n    \"iii_fixed_padC2_conn\": with_rejection(lambda n, m, d, r: pad_customers(fixed(n, m, d, r), 2, r), CAP),\n    # the paper as written: Bernoulli(d/n), discard decomposable, nothing else\n    \"paper_bern_conn\":      with_rejection(lambda n, m, d, r: bern(n, m, d / n, r), CAP),\n    # Bernoulli, patterns padded to >= 2, discard decomposable\n    \"bern_padP2_conn\":      with_rejection(lambda n, m, d, r: pad_patterns(bern(n, m, d / n, r), 2, r), CAP),\n    # Bernoulli, patterns redrawn until >= 2 (truncated rows), discard decomposable\n    \"bern_truncP2_conn\":    with_rejection(lambda n, m, d, r: resample_patterns(bern(n, m, d / n, r), 2, d / n, r), CAP),\n    # Bernoulli, customers padded to >= 1 then patterns padded to >= 2, discard decomposable\n    \"bern_padC1_padP2_conn\": with_rejection(lambda n, m, d, r: pad_patterns(pad_customers(bern(n, m, d / n, r), 1, r), 2, r), CAP),\n    # same, patterns first then customers\n    \"bern_padP2_padC1_conn\": with_rejection(lambda n, m, d, r: pad_customers(pad_patterns(bern(n, m, d / n, r), 2, r), 1, r), CAP),\n    # Bernoulli, customers padded to >= 1 only, discard decomposable (control: should fail the row minimum)\n    \"bern_padC1_conn\":      with_rejection(lambda n, m, d, r: pad_customers(bern(n, m, d / n, r), 1, r), CAP),\n    # Bernoulli, customers padded to >= 1, patterns to >= 2, no rejection (how much does the discard do?)\n    \"bern_padC1_padP2\":     no_rejection(lambda n, m, d, r: pad_patterns(pad_customers(bern(n, m, d / n, r), 1, r), 2, r)),\n    # fixed d, patterns already >= 2, customers padded to >= 1, discard decomposable\n    \"fixed_padC1_conn\":     with_rejection(lambda n, m, d, r: pad_customers(fixed(n, m, d, r), 1, r), CAP),\n}\n\ndef stats(M):\n    \"\"\"per-instance statistics used for the fit.\"\"\"\n    rs = M.sum(axis=1); cs = M.sum(axis=0)\n    return dict(ones=int(rs.sum()), row_mean=rs.mean(), row_var=rs.var(), row_min=int(rs.min()), row_max=int(rs.max()),\n                col_mean=cs.mean(), col_var=cs.var(), col_min=int(cs.min()), col_max=int(cs.max()),\n                frac_row2=(rs == 2).mean(), frac_row3=(rs == 3).mean(), frac_col1=(cs == 1).mean(), frac_col2=(cs == 2).mean(),\n                rowcol_corr=_rowcol_corr(M, rs, cs))\n\ndef _rowcol_corr(M, rs, cs):\n    # correlation over incidences between the pattern's size and the customer's count\n    i, j = np.nonzero(M)\n    a = rs[i].astype(float); b = cs[j].astype(float)\n    if a.std() == 0 or b.std() == 0: return 0.0\n    return float(np.corrcoef(a, b)[0, 1])\n\n# --- intermediate variants (added after the first fit: padding undershoots the ones count, truncation overshoots) ---\ndef resample_empty_rows(M, p, rng):\n    \"\"\"rows with no ones are redrawn until non-empty; rows with one 1 are left for padding.\"\"\"\n    m, n = M.shape\n    while True:\n        bad = np.flatnonzero(M.sum(axis=1) == 0)\n        if len(bad) == 0: return M\n        M[bad] = rng.random((len(bad), n)) < p\nCANDIDATES.update({\n    # empty patterns redrawn, size-1 patterns padded to 2, empty customers padded to 1, discard decomposable\n    \"bern_redraw0_padP2_padC1_conn\": with_rejection(lambda n, m, d, r: pad_customers(pad_patterns(resample_empty_rows(bern(n, m, d / n, r), d / n, r), 2, r), 1, r), CAP),\n    # the best-fit family with the density lifted 5% (diagnostic: is the residual a density offset?)\n    \"bern105_padC1_padP2_conn\": with_rejection(lambda n, m, d, r: pad_patterns(pad_customers(bern(n, m, 1.05 * d / n, r), 1, r), 2, r), CAP),\n    \"bern110_padC1_padP2_conn\": with_rejection(lambda n, m, d, r: pad_patterns(pad_customers(bern(n, m, 1.10 * d / n, r), 1, r), 2, r), CAP),\n})\n====RT\n44:RESULTS_RATIO_CSV = ENSEMBLE_DIR / \"results_ratio.csv\"\n169:def branching_factor(r: float, c: float, generator: str) -> float:\n179:def excess(r: float, c: float) -> float:\n187:def giant_threshold_col_mean(r: float, generator: str) -> float:\n281:def load_frames(campaign_csv: Path = RESULTS_CSV, upward_csv: Path = RESULTS_UPWARD_CSV,\ndef load_frames(campaign_csv: Path = RESULTS_CSV, upward_csv: Path = RESULTS_UPWARD_CSV,\n                ratio_csv: Path = RESULTS_RATIO_CSV) -> pd.DataFrame:\n    parts = []\n    for source, csv in ((\"campaign\", campaign_csv), (\"upward\", upward_csv), (\"ratio\", ratio_csv)):\n        f = load_results(csv)\n        if len(f):\n            f = f.copy()\n            if source == \"upward\":\n                f = apply_finish(f, csv.with_name(\"results_upward_finish.csv\"))\n            f[\"source\"] = source\n            parts.append(f)\n    if not parts:\n        return pd.DataFrame()\n    return derive(pd.concat(parts, ignore_index=True))\n\n\ndef _cens_median(v: np.ndarray, c: np.ndarray) -> tuple[float, bool]:\n    if len(v) == 0:\n        return np.nan, False\n    med = float(np.median(v))\n    return med, bool(np.any(c & (v <= med)))\n\n\ndef cell_medians(frame: pd.DataFrame, config: str = \"default\") -> pd.DataFrame:\n    \"\"\"Per (generator, ratio_label, n, param): the censoring-aware median of\n    log10(1 + nodes), the realised density and the median of every candidate.\"\"\"\ndef giant_threshold_col_mean(r: float, generator: str) -> float:\n    \"\"\"col_mean at which the branching factor is 1.\"\"\"\n    if generator == \"fixed\":\n        return 0.5 * (1.0 + np.sqrt(1.0 + 4.0 / r))\n    return 1.0 / np.sqrt(r)\n\n\ndef tree_threshold_col_mean(r: float) -> float:\n    return 1.0 + 1.0 / r\n\n\ndef invert_candidate(candidate: str, target: float, r: float, n: float, generator: str) -> float:\n    \"\"\"col_mean at which an analytic candidate takes `target` on a series with\n    ratio r (m = r n): the hypothesis 'the ridge is where candidate = target'.\"\"\"\n    m = r * n\n====GATE\n#!/usr/bin/env python3\n\"\"\"Regression gate for loop0010 (the excess phase diagram).\n\nPasses only if all five hold:\n1. `lake build` in lean/ succeeds;\n2. every `.lean` file under lean/MOSPFormalization/ (top level, Complex/ and\n   Search/) is imported by lean/MOSPFormalization.lean, so the build really\n   checks it;\n3. the number of `sorry` in Lean *code* (comments and docstrings stripped) is\n   at most the baseline (0: the development has none since Appendix E) plus\n   the entries in allowed_sorries.txt, and no `axiom` declaration exists;\n4. `python -m pytest tests/ -q -x` passes, and so does `pytest` in\n   pathwidth_solver/;\n5. the paper builds with no undefined references (`make -C paper1/latex check`).\n\n    python3 Ralph_Loops/loop0010/gate.py\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nREPO = HERE.parents[1]\nLEAN = REPO / \"lean\"\nBASELINE_SORRIES = 0\nALLOWED = HERE / \"allowed_sorries.txt\"\nPAPER = REPO / \"paper1\" / \"latex\"\n\n\ndef strip_comments(src: str) -> str:\n    out, i, depth = [], 0, 0\n    while i < len(src):\n        if src.startswith(\"/-\", i):\n            depth += 1; i += 2; continue\n        if depth and src.startswith(\"-/\", i):\n            depth -= 1; i += 2; continue\n        if depth:\n            i += 1; continue\n        if src.startswith(\"--\", i):\n            j = src.find(\"\\n\", i); i = len(src) if j < 0 else j; continue\n        if src[i] == '\"':\n            j = i + 1\n            while j < len(src) and src[j] != '\"':\n                j += 2 if src[j] == \"\\\\\" else 1\n            i = j + 1; continue\n        out.append(src[i]); i += 1\n    return \"\".join(out)\n\n\ndef main() -> int:\n    ok = True\n    b = subprocess.run([\"lake\", \"build\"], cwd=LEAN, capture_output=True, text=True, errors=\"replace\")\n    tail = \"\\n\".join((b.stdout + b.stderr).splitlines()[-25:])\n    if b.returncode != 0:\n        print(\"GATE FAIL: lake build\\n\" + tail); return 1\n    print(\"lake build: ok\")\n\n    root = (LEAN / \"MOSPFormalization.lean\").read_text()\n    for f in sorted((LEAN / \"MOSPFormalization\").rglob(\"*.lean\")):\n        mod = \"MOSPFormalization.\" + \".\".join(f.relative_to(LEAN / \"MOSPFormalization\").with_suffix(\"\").parts)\n        if not re.search(rf\"^import {re.escape(mod)}\\s*$\", root, re.M):\n            print(f\"GATE FAIL: {mod} is not imported by MOSPFormalization.lean\"); ok = False\n\n    sorries, axioms = [], []\n    for f in sorted((LEAN / \"MOSPFormalization\").rglob(\"*.lean\")):\n        code = strip_comments(f.read_text())\n        for n, line in enumerate(code.splitlines(), 1):\n            if re.search(r\"\\bsorry\\b\", line):\n                sorries.append(f\"{f.relative_to(LEAN)}:{n}\")\n            if re.match(r\"\\s*(private\\s+)?axiom\\b\", line):\n                axioms.append(f\"{f.relative_to(LEAN)}:{n}\")\n    allowed = [l for l in ALLOWED.read_text().splitlines() if l.strip() and not l.startswith(\"#\")] if ALLOWED.exists() else []\n    limit = BASELINE_SORRIES + len(allowed)\n    print(f\"sorry in code: {len(sorries)} (limit {limit}): {sorries}\")\n    if len(sorries) > limit:\n        print(\"GATE FAIL: more sorry than the baseline plus allowed_sorries.txt\"); ok = False\n    if axioms:\n====TEST\n\"\"\"§36: the cover excess against the thresholds of the random bipartite\nincidence graph -- the configuration-model cores, the peeler, the\ndominance reduction and the scoring tables, on hand-checkable cases.\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom learning.cover_excess import (RATIOS, bipartite_components, connectivity_col_mean, core_fixed_point,\n                                   core_quantities, core_record, core_threshold_col_mean, degree_pmfs,\n                                   dominance_record, invert_analytic, measure_instance, peel, size_biased,\n                                   threshold_summary, threshold_table)\nfrom learning.ridge_theory import giant_threshold_col_mean\nfrom mosp.instance import MOSPInstance\n\n\ndef test_degree_pmfs_have_the_right_means_and_no_empty_rows():\n    p_c, p_p = degree_pmfs(\"fixed\", 1.0, 3.0, repair=False)\n    k = np.arange(len(p_c))\n    assert (k * p_c).sum() == pytest.approx(3.0, rel=1e-6)          # Poisson(r c)\n    assert p_p[3] == pytest.approx(1.0)                              # every product has exactly d customers\n    p_c, p_p = degree_pmfs(\"fixed\", 1.0, 3.0, repair=True)\n    assert p_c[0] == 0.0                                             # the empty-row repair\n    assert (np.arange(len(p_p)) * p_p).sum() == pytest.approx(3.0)  # and the products receive them: the realised mean stays c\n    assert p_p[2] > 0.0                                              # so the design d sits below the realised col_mean\n    p_c, p_p = degree_pmfs(\"bernoulli\", 0.5, 4.0, repair=False)\n    assert (np.arange(len(p_p)) * p_p).sum() == pytest.approx(4.0 / (1 - np.exp(-4.0)), rel=1e-3)\n\n\ndef test_size_biased_of_a_point_mass_is_the_point_mass_minus_one():\n    pmf = np.zeros(6)\n    pmf[4] = 1.0\n    q = size_biased(pmf)\n    assert q[3] == pytest.approx(1.0)\n\n\ndef test_two_core_appears_at_the_giant_threshold():\n    # continuous transition: the 2-core is empty below the branching-factor-1 point and present above it\n    for gen, r in ((\"fixed\", 1.0), (\"bernoulli\",