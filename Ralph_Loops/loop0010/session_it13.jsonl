(c : C) : c ∈ M.customers p ↔ M.requires c p := by\n173:  simp [customers]\n179:theorem customers_isClique (p : Pt) : M.mospGraph.IsClique (M.customers p : Set C) := by\n180:  rw [SimpleGraph.isClique_iff]\n182:  exact ⟨hne, p, (M.mem_customers_iff p c).mp (Finset.mem_coe.mp hc),\n183:    (M.mem_customers_iff p d).mp (Finset.mem_coe.mp hd)⟩\n218:/-- The customers whose stack is open at step `i`. -/\n240:`i < |Pt|` the customers open at step `i`; for `i = |Pt| + e c` the singleton of a\n241:customer `c` with no pattern, so that such customers are covered too. The two\n288:`|Pt|` stack bags followed by `|C|` bags, of which the ones for customers with no\n370:/-- A bag containing all the customers of pattern `p`, which exist by the Helly\n373:  Classical.choose (D.exists_bag_of_isClique (M.customers p) (M.customers_isClique p))\n375:theorem customers_subset_bag_bagOf (D : PathDecomposition M.mospGraph) (p : Pt) :\n376:    M.customers p ⊆ D.bag (M.bagOf D p) :=\n377:  Classical.choose_spec (D.exists_bag_of_isClique (M.customers p) (M.customers_isClique p))\n8:and a binary relation `requires` indicating which customers need which patterns.\n23:    `requires c p` means customer `c` needs pattern `p`. -/\n25:  requires : C → P → Prop\n31:variable (M : MOSPInstance C P) [DecidableRel M.requires]\n34:def customers (p : P) : Finset C :=\n35:  Finset.univ.filter (fun c => M.requires c p)\n39:  Finset.univ.filter (fun p => M.requires c p)\n43:  p ≠ q ∧ ∃ c, M.requires c p ∧ M.requires c q","is_error":false}]},"parent_tool_use_id":null,"session_id":"9eaef906-d850-4c3f-88f5-ed685df4fdaf","uuid":"5deb0b4e-9fbe-406e-a0ee-923629c97097","timestamp":"2026-11-01T08:27:15.165Z","tool_use_result":{"stdout":"572:theorem card_union_add_card_inter (s t : Finset α) :\n.lake/packages/mathlib/Mathlib/Data/Finset/Erase.lean:63:theorem ne_of_mem_erase : b ∈ erase s a → b ≠ a := fun h => (mem_erase.1 h).1\n.lake/packages/mathlib/Mathlib/Data/Finset/Erase.lean:65:theorem mem_of_mem_erase : b ∈ era