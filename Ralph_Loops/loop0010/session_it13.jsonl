n nx.find_cliques(g))","+        assert omega - 1 <= val <= _lemma_p_exhaustive(g) <= _exact_pw(g)","+        assert info[\"omega\"] == omega and not info[\"censored\"]","+        cand, extra = pendant_candidate(g, None, Budget(seconds=5.0))","+        assert cand == val + 1 and extra[\"censored_eval\"] is False","+","+","+def test_depth_one_family_is_exact_both_ways():","+    \"\"\"F2 (on paper, §6 of the phase diagram): `K_s` with a pendant `K_t` at `q` of its","+    vertices has pathwidth `max(s − 1, t + ⌈q/2⌉ − 2)`; the lower half is","+    `pathwidth_ge_of_pendant_cliques` (with `t = q = s`,","+    `pathwidth_ge_of_clique_pendant_cliques`: `⌈3s/2⌉ − 2`), and the graph evaluation","+    attains it.\"\"\"","+    for s in range(2, 6):","+        for t in range(2, 6):","+            for q in range(1, s + 1):","+                g = _clique_with_pendants(s, t, q)","+                if g.number_of_nodes() > 13:","+                    continue","+                want = max(s - 1, t + (q + 1) // 2 - 2)","+                assert _exact_pw(g) == want","+                val, _ = pendant_graph_bound(g)","+                assert val == want","+    for s in range(2, 5):","+        assert pendant_graph_bound(_clique_with_pendants(s, s, s))[0] == s + (s + 1) // 2 - 2","+","+","+def test_mosp_form_on_tiny_instances():","+    \"\"\"`mospValue_ge_of_pendant_patterns`: the pattern evaluation of Lemma P","+    (`pendant_lower_bound`, pathwidth units) plus one never exceeds the MOSP value, by","+    brute force over pattern orders.\"\"\"","+    rng = np.random.default_rng(1303)","+    checked = above = 0","+    for _ in range(80):","+        n = int(rng.integers(2, 8))","+        m = int(rng.integers(1, 6))","+        pats = [sorted(rng.choice(n, size=int(rng.integers(1, min(4, n) + 1)), replace=False).tolist())","+                for _ in range(m)]","+        value = pendant_lower_bound(pats) + 1","+        mosp = _brute_mosp(n, pats)","+        assert value <= mosp","+        checked += 1","+        above += value > max(len(p) for p in pats)","+    assert checked == 80","+","+","+def test_censoring_is_reported_and_still_valid():","+    \"\"\"With the caps set absurdly low the evaluation says so and stays a valid bound.\"\"\"","+    g = _clique_with_pendants(4, 4, 4)","+    val, info = pendant_graph_bound(g, max_r=1, max_q=2, max_cliques=3)","+    assert info[\"censored\"] and val <= _exact_pw(g)"]}],"created":true}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/tests/test_pendant_cliques.py"]}},"tool_result_meta":[{"id":"toolu_01WKsgUyEC3BCk1CrTb14W6f","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
