{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017bH7mjMLYsyg5N6Ygs334D","type":"tool_result","content":"def analyse(\n    instance: MOSPInstance,\n    optimum: int | None = None,\n    witness: list[int] | None = None,\n    max_products_exact: int = 20,\n) -> dict:\n    \"\"\"Every count and statistic for one instance.\n\n    `optimum` is the certified value when known; the construction minimum is\n    checked against it and an `audit` field records the comparison. When it is\n    None the construction minimum is the optimum.\n    \"\"\"\n    comp = Compact(instance)\n    a = comp.a\n    row: dict[str, object] = {\n        \"instance_name\": instance.name,\n        \"n_customers\": instance.n_customers,\n        \"n_patterns\": instance.n_patterns,\n        \"n_active\": a,\n        \"m_active\": comp.m,\n        \"density\": float(np.asarray(instance.matrix).mean()) if instance.n_patterns else 0.0,\n    }\n    search_w, constr_w = closing_weights(comp)\n    min_construction = lattice_minimum(constr_w, a)\n    min_search = lattice_minimum(search_w, a)\n    k = min_construction if optimum is None else int(optimum)\n    row.update({\n        \"optimum\": k,\n        \"min_construction\": min_construction,\n        \"min_search\": min_search,\n        \"audit_construction\": min_construction == k,\n        \"audit_search\": min_search == k,\n        \"complete_graph\": k == a,\n    })\n    f_c, g_c = lattice_counts(constr_w, a, k)\n    f_s, g_s = lattice_counts(search_w, a, k)\n    count_closing = f_c[(1 << a) - 1]\n    count_search = f_s[(1 << a) - 1]\n    twin = comp.twin_factor()\n    row.update({\n        \"count_closing\": count_closing,\n        \"count_search\": count_search,\n        \"twin_factor\": twin,\n        \"closing_up_to_twins\": count_closing // twin,\n        \"closing_fraction\": count_closing / math.factorial(a) if a else float(\"nan\"),\n        \"unique_closing\": count_closing // twin == 1,\n    })\n    row.update({f\"all_{key}\": val for key, val in\n                path_weighted_choices(constr_w, a, k, f_c, g_c).items()})\n\n    if witness is not None:\n        closing = _customer_order_from_products(instance, witness)\n        info = witness_choices(comp, constr_w, k, g_c, closing)\n        ch = info[\"choices\"]\n        constructed = product_order_from_customers(instance, closing)\n        row.update({\n            \"witness_value\": max_open_stacks(instance, list(witness)),\n            \"witness_construction_value\": max_open_stacks(instance, constructed),\n            \"witness_construction_optimal\": info[\"optimal\"],\n            \"witness_search_cost\": _cs_cost(_search_masks(instance), closing),\n            \"witness_mean_choices\": float(np.mean(ch)) if ch else float(\"nan\"),\n            \"witness_ceiling\": float(np.mean([1 / c for c in ch])) if ch else float(\"nan\"),\n            \"witness_forced_frac\": float(np.mean([c == 1 for c in ch])) if ch else float(\"nan\"),\n            \"witness_steps\": len(ch),\n            \"witness_forced_steps\": sum(c == 1 for c in ch),\n            \"witness_inv_sum\": float(sum(1 / c for c in ch)),\n        })\n        row[\"witness_search_optimal\"] = row[\"witness_search_cost\"] == k\n        # Reversal is not a symmetry of closing orders; this measures how often\n        # it happens to preserve optimality anyway.\n        reverse = witness_choices(comp, constr_w, k, g_c, closing[::-1])\n        row[\"witness_reverse_optimal\"] = reverse[\"optimal\"]\n\n    if comp.m <= max_products_exact:\n        min_products, count_products = product_lattice(comp)\n        col = comp.column_factor()\n        row.update({\n            \"min_products\": min_products,\n            \"audit_products\": min_products == k,\n            \"count_products\": count_products,\n            \"column_factor\": col,\n            \"products_up_to_columns_reversal\": count_products // col / 2,\n            \"unique_products\": count_products // col == 2,\n            \"products_fraction\": count_products / math.factorial(comp.m) if comp.m else float(\"nan\"),\n        })\n    return row\n\n\ndef _search_masks(instance: MOSPInstance) -> list[int]:\n=====\ndef _popcount32(a: np.ndarray) -> np.ndarray:\n    return _POPCOUNT8[a.view(np.uint8)].reshape(-1, 4).sum(axis=1, dtype=np.uint8)\n\n\ndef feasible_states(instance: MOSPInstance, k: int) -> int:\n    \"\"\"The number of customer sets S (including the empty set and V) whose\n    closed neighbourhood has at most k customers outside S; n <= 25.\"\"\"\n    a = np.asarray(instance.matrix, dtype=np.int64)\n    n = a.shape[0]\n    if n > 25:\n        raise ValueError(\"subset DP is for n <= 25\")\n    adj = (a @ a.T) > 0\n    masks = np.array([int(\"\".join(\"1\" if adj[i, j] else \"0\" for j in reversed(range(n))), 2) for i in range(n)],\n                     dtype=np.uint32)\n    nb = np.zeros(1 << n, dtype=np.uint32)\n    for b in range(n):\n        lo, hi = 1 << b, 1 << (b + 1)\n        nb[lo:hi] = nb[:lo] | masks[b]\n    idx = np.arange(1 << n, dtype=np.uint32)\n    cost = _popcount32(nb).astype(np.int16) - _popcount32(idx).astype(np.int16)\n    return int(np.count_nonzero(cost <= k))\n\n\ndef reachable_states(instance: MOSPInstance, k: int) -> tuple[int, int]:\n    \"\"\"(feasible, reachable): the number of customer sets S whose closing step\n    fits -- the search's cost of closing the last customer of S is\n    |N[S]| - |S| + 1 (every customer of N[S] has opened, those of S other than\n    the one being closed have closed) -- and the number of those reachable\n    from the empty set through a chain of fitting sets, S \\\\ {c} -> S. The\n    reachable count is the search tree without dominance and without the memo:\n    the state space the refutation at k = optimum - 1 has to exhaust.\"\"\"\n    a = np.asarray(instance.matrix, dtype=np.int64)\n    n = a.shape[0]\n    if n > 25:\n        raise ValueError(\"subset DP is for n <= 25\")\n    adj = (a @ a.T) > 0\n    masks = np.array([int(\"\".join(\"1\" if adj[i, j] else \"0\" for j in reversed(range(n))), 2) for i in range(n)],\n                     dtype=np.uint32)\n    size = 1 << n\n    nb = np.zeros(size, dtype=np.uint32)\n    for b in range(n):\n        lo, hi = 1 << b, 1 << (b + 1)\n        nb[lo:hi] = nb[:lo] | masks[b]\n    idx = np.arange(size, dtype=np.uint32)\n    pop = _popcount32(idx).astype(np.int16)\n    fits = (_popcount32(nb).astype(np.int16) - pop + 1) <= k\n    fits[0] = True\n    order = np.argsort(pop, kind=\"stable\").astype(np.uint32)\n    counts = np.bincount(pop, minlength=n + 1)\n    starts = np.concatenate([[0], np.cumsum(counts)])\n    reach = np.zeros(size, dtype=bool)\n    reach[0] = True\n    for s in range(1, n + 1):\n        layer = order[starts[s]:starts[s + 1]]\n        pred = np.zeros(len(layer), dtype=bool)\n        for b in range(n):\n            bit = np.uint32(1 << b)\n            has = (layer & bit) != 0\n            pred |= has & reach[layer ^ bit]\n        reach[layer] = fits[layer] & pred\n    return int(np.count_nonzero(fits)), int(np.count_nonzero(reach))\n\n\ndef expected_feasible_states(n: int, m: float, c: float, generator: str, k: float) -> float:\n=====\ndef sizes_text(matrix: np.ndarray) -> str:\n    \"\"\"The pattern-size histogram of a matrix as `size:count;...` (column sums).\"\"\"\n    sizes = np.asarray(matrix).sum(axis=0)\n    values, counts = np.unique(sizes, return_counts=True)\n    return \";\".join(f\"{int(v)}:{int(c)}\" for v, c in zip(values, counts))\n\n\ndef sizes_from_text(text: str) -> dict[int, int]:\n    out: dict[int, int] = {}\n    for part in str(text).split(\";\"):\n        if part:\n            v, c = part.split(\":\")\n            out[int(v)] = out.get(int(v), 0) + int(c)\n    return out\n\n\ndef _rule_on(instance: MOSPInstance) -> tuple[int, float]:\n    from satisfiability.heuristics import two_key_rule\n    t = time.perf_counter()\n    value, _ordering = two_key_rule(instance)\n    return int(value), time.perf_counter() - t\n\n\ndef _rule_ensemble_job(args) -> dict:\n    frame_name, cell_text, index, name, n_ones_recorded, optimum, certified = args\n    cell = Cell.parse(cell_text)\n    inst = generate(cell, index)\n    if inst.name != name or int(inst.matrix.sum()) != n_ones_recorded:\n        raise AssertionError(f\"{name}: regeneration does not match the record\")\n    value, seconds = _rule_on(inst)\n    return {\"source\": \"ensemble\", \"frame\": frame_name, \"instance_name\": name, \"cell\": cell.id,\n            \"generator\": cell.generator, \"param\": cell.param, \"n\": cell.n, \"m\": cell.m,\n            \"n_ones\": n_ones_recorded, \"optimum\": optimum if certified else np.nan, \"certified\": bool(certified),\n            \"rule\": value, \"rule_seconds\": seconds, \"sizes\": sizes_text(inst.matrix)}\n\n\ndef _rule_corpus_job(args) -> dict:\n    source_file, name, matrix = args\n    inst = MOSPInstance.from_matrix(matrix, name=name)\n    value, seconds = _rule_on(inst)\n    optimum, provenance = solution_record(inst)\n    certified = provenance.startswith(\"certified\")\n    collection, cls = collection_of(source_file, name)\n    n, m = matrix.shape\n    match = _CS_NAME.match(name)\n    return {\"source\": \"corpus\", \"frame\": \"corpus\", \"instance_name\": name, \"cell\": cls,\n            \"generator\": \"chu_stuckey\" if match else collection, \"param\": int(match.group(3)) if match else np.nan,\n            \"n\": n, \"m\": m, \"n_ones\": int(np.asarray(matrix).sum()), \"optimum\": optimum if certified else np.nan,\n            \"certified\": certified, \"rule\": value, \"rule_seconds\": seconds, \"sizes\": sizes_text(matrix)}\n\n\ndef rule_rows(workers: int, out: Path = RULE_CSV, ensemble_dir: Path = ENSEMBLE_DIR) -> pd.DataFrame:\n    \"\"\"The two-key closing rule (`satisfiability.heuristics.two_key_rule`,\n    valued by simulation) on every ensemble instance (regenerated from its\n    seed) and every corpus instance, with the certified optimum beside it and\n    the pattern-size histogram the first moment needs. A scoring run: nothing is\n    solved, nothing is written to the compute ledger or to `solutions/`.\"\"\"\n    from learning.dataset import enumerate_instances\n    started = time.time()\n    ens = _map(_rule_ensemble_job, ensemble_jobs(ensemble_dir), workers)\n    corpus = _map(_rule_corpus_job, [(str(path), inst.name, inst.matrix) for path, inst in enumerate_instances()],\n                  workers)\n    frame = pd.DataFrame(ens + corpus)\n    frame[\"e\"] = excess(frame[\"n\"], frame[\"m\"], frame[\"n_ones\"])\n    frame[\"r\"] = frame[\"m\"] / frame[\"n\"]\n    frame[\"r_label\"] = [ratio_label(r) for r in frame[\"r\"]]\n    frame[\"rule_gap\"] = frame[\"rule\"] - frame[\"optimum\"]\n    out.parent.mkdir(parents=True, exist_ok=True)\n    frame.to_csv(out, index=False)\n    print(f\"rule: {len(frame)} rows ({len(ens)} ensemble, {len(corpus)} corpus), \"\n          f\"{frame['rule_seconds'].sum():.1f} s of rule time, {time.time() - started:.0f} s wall -> {out}\", flush=True)\n    return frame\n\n\ndef load_rule(path: Path = RULE_CSV) -> pd.DataFrame:\n    if not path.exists():\n        raise FileNotFoundError(f\"{path} does not exist; run `python -m learning.excess --stage rule` first\")\n    return pd.read_csv(path, low_memory=False)\n\n\ndef _ols(x: np.ndarray, y: np.ndarray) -> tuple[float, float, float, float]:\n=====\ndef main() -> None:\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--stage\", choices=(\"build\", \"tables\", \"figure\", \"all\", \"rule\", \"slopes\", \"figure-opt\",\n                                        \"constructions\", \"constructions-tables\", \"figure-constructions\",\n                                        \"forest_check\"),\n                    default=\"all\")\n    ap.add_argument(\"--workers\", type=int, default=None)\n    ap.add_argument(\"--out\", type=Path, default=OUT_CSV)\n    args = ap.parse_args()\n    workers = args.workers if args.workers is not None else default_workers()\n    if args.stage == \"rule\":\n        rule_rows(workers)\n        return\n    if args.stage == \"slopes\":\n        print(slopes_tables(load_rule()))\n        return\n    if args.stage == \"figure-opt\":\n        print(f\"figure -> {figure_opt(load_rule())}\")\n        return\n    if args.stage == \"forest_check\":\n        from learning import forest_theorems as ft\n        print(ft.run(workers))\n        return\n    if args.stage.endswith(\"constructions\") or args.stage == \"constructions-tables\":\n        from learning import excess_constructions as ec\n        if args.stage == \"constructions\":\n            ec.run(ec.grid_jobs(), workers)\n        elif args.stage == \"constructions-tables\":\n            print(ec.tables(ec.load()))\n        else:\n            print(f\"figure -> {ec.figure(ec.load())}\")\n        return\n    if args.stage in (\"build\", \"all\"):\n        frame = build(workers, args.out)\n    else:\n        frame = load(args.out)\n    if args.stage in (\"tables\", \"all\"):\n        print(tables(frame))\n    if args.stage in (\"figure\", \"all\"):\n        print(f\"figure -> {figure(frame)}\")\n\n\nif __name__ == \"__main__\":\n    main()","is_error":false}]},"parent_tool_use_id":null,"session_id":"7a8ec96c-60f9-4968-b844-122ae8421af8","uuid":"6abebfa2-fcb9-4906-a6d5-356ed3a96623","timestamp":"2026-11-01T05:23:25.282Z","tool_use_result":{"stdout":"def analyse(\n    instance: MOSPInstance,\n    optimum: int | None = None,\n    witness: list[int] | None = None,\n    max_products_exact: int = 20,\n) -> dict:\n    \"\"\"Every count and statistic for one instance.\n\n    `optimum` is the certified value when known; the construction minimum is\n    checked against it and an `audit` field records the comparison. When it is\n    None the construction minimum is the optimum.\n    \"\"\"\n    comp = Compact(instance)\n    a = comp.a\n    