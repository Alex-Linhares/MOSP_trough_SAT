int]:\nlearning/cover_excess.py:770:def expected_feasible_states(n: int, m: float, c: float, generator: str, k: float) -> float:\nlearning/cover_excess.py:797:def _states_job(args) -> dict:\nlearning/cover_excess.py:812:def measure_states(csv: Path = STATES_CSV, sizes=(20, 25), per_cell: dict | None = None,\nlearning/cover_excess.py:844:def states_tables(states: pd.DataFrame, frame: pd.DataFrame | None = None) -> dict:\n86:def excess(n: float, m: float, n_ones: float) -> float:\n91:def giant_threshold_excess(r: float, generator: str = \"fixed\") -> float:\n107:def ratio_label(r: float) -> str:\n119:def incidence_components(matrix: np.ndarray) -> np.ndarray:\n129:def incidence_stats(matrix: np.ndarray) -> dict:\n166:def collection_of(source_file: str, instance_name: str) -> tuple[str, str]:\n184:def solution_record(instance: MOSPInstance, solutions_dir: Path = SOLUTIONS_DIR) -> tuple[float, str]:\n199:def _corpus_job(args) -> dict:\n210:def corpus_rows(workers: int) -> pd.DataFrame:\n222:def _ensemble_job(args) -> dict:\n239:def ensemble_jobs(ensemble_dir: Path = ENSEMBLE_DIR) -> list[tuple]:\n259:def ensemble_rows(workers: int, ensemble_dir: Path = ENSEMBLE_DIR) -> pd.DataFrame:\n266:def _sim_job(args) -> dict:\n284:def simulation_rows(workers: int, sim_csv: Path = SIM_CSV) -> pd.DataFrame:\n294:def _map(fn, jobs, workers: int) -> list:\n301:def default_workers(cap: int = 8) -> int:\n307:def build(workers: int, out: Path = OUT_CSV) -> pd.DataFrame:\n330:def load(path: Path = OUT_CSV) -> pd.DataFrame:\n341:def _quantile_row(group: pd.DataFrame) -> dict:\n359:def collection_table(frame: pd.DataFrame) -> pd.DataFrame:\n382:def series_table(frame: pd.DataFrame, source: str = \"ensemble\") -> pd.DataFrame:\n407:def repaired_giant_threshold_excess(generator: str, r: float) -> float:\n418:def crossing_table(frame: pd.DataFrame, min_n: int = CHECK_MIN_N, tol: float = CHECK_TOLERANCE) -> pd.DataFrame:\n463:def bound_gap_table(frame: pd.DataFrame) -> tuple[pd.DataFrame, pd.Da