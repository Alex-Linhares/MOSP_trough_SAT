{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01673USiKRLHMz73ByH8p18p","type":"tool_result","content":"        patterns.append([hub] + list(range(count, count + s - 1)))\n        count += s - 1\n    return patterns\n\n\n# ----------------------------------------------------------------------------\n# graphs\n# ----------------------------------------------------------------------------\n\n\ndef n_customers(patterns: Patterns) -> int:\n    return 1 + max(v for p in patterns for v in p)\n\n\ndef matrix_of(patterns: Patterns, n: int | None = None) -> np.ndarray:\n    \"\"\"The `n x m` 0/1 matrix, rows = customers, columns = patterns.\"\"\"\n    n = n_customers(patterns) if n is None else n\n    a = np.zeros((n, len(patterns)), dtype=int)\n    for j, p in enumerate(patterns):\n        a[p, j] = 1\n    return a\n\n\ndef mosp_graph(patterns: Patterns, n: int | None = None) -> nx.Graph:\n    \"\"\"Customers as vertices, a clique per pattern.\"\"\"\n    n = n_customers(patterns) if n is None else n\n    g = nx.Graph()\n    g.add_nodes_from(range(n))\n    for p in patterns:\n        for i, u in enumerate(p):\n            for v in p[i + 1:]:\n                g.add_edge(u, v)\n    return g\n\n\ndef incidence_graph(patterns: Patterns, n: int | None = None) -> nx.Graph:\n    \"\"\"Customers `0..n-1` and patterns `n..n+m-1`, an edge per one of the matrix.\"\"\"\n    n = n_customers(patterns) if n is None else n\n    g = nx.Graph()\n    g.add_nodes_from(range(n + len(patterns)))\n    for j, p in enumerate(patterns):\n        for v in p:\n            g.add_edge(v, n + j)\n    return g\n\n\ndef pattern_adjacency(patterns: Patterns) -> nx.Graph:\n    \"\"\"Patterns as vertices, adjacent when they share a customer.\"\"\"\n    g = nx.Graph()\n    g.add_nodes_from(range(len(patterns)))\n    owner: dict[int, list[int]] = {}\n    for j, p in enumerate(patterns):\n        for v in p:\n            owner.setdefault(v, []).append(j)\n    for js in owner.values():\n        for i, a in enumerate(js):\n            for b in js[i + 1:]:\n                g.add_edge(a, b)\n    return g\n\n\ndef is_incidence_forest(patterns: Patterns, n: int | None = None) -> bool:\n    return nx.is_forest(incidence_graph(patterns, n))\n\n\ndef block_height(patterns: Patterns) -> int:\n    \"\"\"The radius of the pattern adjacency forest in pattern steps, maximised\n    over components: `h` for `CT(s, h, b)`, 0 for a single pattern.\"\"\"\n    g = pattern_adjacency(patterns)\n    best = 0\n    for comp in nx.connected_components(g):\n        sub = g.subgraph(comp)\n        best = max(best, nx.radius(sub))\n    return best\n\n\ndef ternary_subtree_height(tree: nx.Graph) -> int:\n    \"\"\"The height of the largest complete ternary tree contained in `tree` as a\n    rooted subtree (every internal vertex with at least three children), over\n    all roots. A lower bound on the tree's pathwidth: the complete ternary tree\n    of height `h` has pathwidth `h` (`TreeBound.lean: pathwidth_ternaryTree`)\n    and pathwidth is monotone under subgraphs.\"\"\"\n    if not nx.is_forest(tree):\n        raise ValueError(\"needs a forest\")\n    import sys\n    sys.setrecursionlimit(max(sys.getrecursionlimit(), 4 * tree.number_of_nodes() + 100))\n\n    def height(v, parent):\n        kids = sorted((height(w, v) for w in tree.neighbors(v) if w != parent), reverse=True)\n        return 1 + kids[2] if len(kids) >= 3 else 0\n\n    return max((height(v, None) for v in tree.nodes), default=0)\n\n\ndef largest_pattern(patterns: Patterns) -> int:\n    return max(len(p) for p in patterns)\n\"\"\"Item 03: the C program against an independent exact method on small block graphs -- Chou, Ko, Ho &\nChen's Theorem 4 (learning/chou_block.py; exponential as implemented, so n <= 30 here): every clique tree\nand caterpillar of cliques with at most 30 vertices, and 300 random block trees at n in {8, 12, 16, 20, 24},\nd in {2, 3, 4, 6}, 15 per cell (seeds 9000 + 100 n + 10 d + i). A disagreement would mean one of the two is wrong.\n    cd /home/al/dev/MOSP && nice -n 19 python3 reports/scratch/forest_regime/cross_check.py > reports/scratch/forest_regime/cross_check.log\n\"\"\"\nimport csv, sys, time\nfrom pathlib import Path\nHERE = Path(__file__).resolve().parent\nsys.path.insert(0, str(HERE.parents[2]))\nfrom learning.block_trees import (caterpillar_of_cliques, clique_tree, graph6, mosp_graph, random_block_tree,\n                                  run_pathwidth_one)\nfrom learning.chou_block import is_block_graph, pathwidth_block_graph\nt0 = time.time(); checked = dis = 0\nfor r in csv.DictReader(open(HERE / \"ct_values.csv\")):\n    if int(r[\"n\"]) > 30: continue\n    P, _ = clique_tree(int(r[\"s\"]), int(r[\"h\"]), int(r[\"b\"])); pw = pathwidth_block_graph(mosp_graph(P)); checked += 1\n    ok = pw == int(r[\"pw\"]); dis += not ok\n    print(f\"CT({r['s']},{r['h']},{r['b']}) n={r['n']} C={r['pw']} chou={pw} {'ok' if ok else 'DISAGREE'}\")\nfor r in csv.DictReader(open(HERE / \"caterpillar_values.csv\")):\n    if int(r[\"n\"]) > 30: continue\n    P = caterpillar_of_cliques(int(r[\"s\"]), int(r[\"length\"])); pw = pathwidth_block_graph(mosp_graph(P)); checked += 1\n    ok = pw == int(r[\"pw\"]); dis += not ok\n    print(f\"CAT(s={r['s']},L={r['length']}) n={r['n']} C={r['pw']} chou={pw} {'ok' if ok else 'DISAGREE'}\")\ncnt = 0\nfor n in (8, 12, 16, 20, 24):\n    for d in (2, 3, 4, 6):\n        for i in range(15):\n            P = random_block_tree(n, d, 9000 + 100 * n + 10 * d + i); G = mosp_graph(P)\n            assert is_block_graph(G)\n            c = run_pathwidth_one(graph6(G), 120)[\"width\"]; p = pathwidth_block_graph(G); checked += 1; cnt += 1\n            if c != p: dis += 1; print(f\"DISAGREE random n={n} d={d} i={i}: C={c} chou={p}\")\nprint(f\"random block trees: {cnt}; total checked {checked}; disagreements {dis}; {time.time()-t0:.0f}s\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"48469461-e175-4b11-b2f6-f6452d21449c