{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QPJUC2bGq52wMDCAdQ1Fdf","type":"tool_result","content":"5:    e = (n_ones - m) / n = (mean patterns per customer) - 1 = r (c - 1),\n7:with `r = m / n` and `c = n_ones / m` the mean customers per pattern. The\n9:`kappa` components, so its cyclomatic number is `gamma = n_ones - n - m + kappa`\n10:and `gamma / n = e - 1 + kappa / n`. `B` is a forest iff `gamma = 0` iff its\n14:section 0): `e = 1`, where the first-moment bound turns on; the hardness ridge at\n15:`e ~ 2-2.4`; and `e_g(r) = (sqrt(r^2 + 4 r) - r) / 2`, the giant component of\n17:`r c (c - 1) = 1` in excess coordinates). This module computes `e`, `r`, `c`,\n25:every ensemble series at `n >= 50`.\n36:    python -m learning.excess --stage slopes        # item 02: opt = a + b n per series, e-matched pairs, beta*\n40:from __future__ import annotations\n42:import argparse\n43:import os\n44:import re\n45:import sys\n46:import time\n47:from concurrent.futures import ProcessPoolExecutor\n48:from pathlib import Path\n50:import numpy as np\n51:import pandas as pd\n52:from scipy.sparse import coo_matrix\n53:from scipy.sparse.csgraph import connected_components\n55:from learning.cover_excess import peel\n56:from learning.ensemble import ENSEMBLE_DIR, Cell, generate\n57:from mosp.instance import MOSPInstance\n59:DATA_DIR = Path(\"learning/data\")\n60:OUT_CSV = DATA_DIR / \"excess.csv\"\n61:INSTANCES_CSV = DATA_DIR / \"instances.csv\"\n62:SOLUTIONS_DIR = Path(\"solutions\")\n63:RULE_CSV = DATA_DIR / \"excess_rule.csv\"\n64:FIGURE_OPT = Path(\"reports/figures/excess_opt.png\")\n65:BOUND_GAP_CSV = DATA_DIR / \"bound_gap.csv\"\n66:SIM_DIR = Path(\"reports/scratch/clique_cover_moment\")\n67:SIM_CSV = SIM_DIR / \"floor_violation.csv\"\n68:FIGURE = Path(\"reports/figures/excess_giant_component.png\")\n69:FRAMES = {\"campaign\": \"results.csv\", \"upward\": \"results_upward.csv\",\n71:RATIO_LABELS = {0.125: \"n/8\", 0.25: \"n/4\", 0.5: \"n/2\", 1.0: \"n\", 2.0: \"2n\", 4.0: \"4n\", 8.0: \"8n\"}\n72:CHECK_TOLERANCE = 0.15\n73:CHECK_MIN_N = 50\n74:QUANTILES = (0.0, 0.1, 0.25, 0.5, 0.75, 0.9, 1.0)\n75:QUANTILE_NAMES = (\"min\", \"q10\", \"q25\", \"median\", \"q75\", \"q90\", \"max\")\ndef _corpus_job(args) -> dict:\n    source_file, name, matrix = args\n    row = incidence_stats(matrix)\n    collection, cls = collection_of(source_file, name)\n    value, provenance = solution_record(MOSPInstance.from_matrix(matrix, name=name))\n    row.update({\"source\": \"corpus\", \"frame\": \"corpus\", \"instance_name\": name, \"source_file\": source_file,\n                \"collection\": collection, \"series\": cls, \"generator\": \"\", \"param\": np.nan,\n                \"provenance\": provenance, \"optimum\": value})\n    return row\n\n\ndef corpus_rows(workers: int) -> pd.DataFrame:\n    \"\"\"One row per instance of the benchmark tree, with its cached optimum and\n    provenance read from `solutions/` (read only); `certified` is read from the\n    provenance, never assumed, and the optimum is blanked where it is not.\"\"\"\n    from learning.dataset import enumerate_instances\n    jobs = [(str(path), inst.name, inst.matrix) for path, inst in enumerate_instances()]\n    frame = pd.DataFrame(_map(_corpus_job, jobs, workers))\n    frame[\"certified\"] = frame[\"provenance\"].fillna(\"\").str.startswith(\"certified\")\n    frame.loc[~frame[\"certified\"], \"optimum\"] = np.nan\n    return frame\n\n\nclass Cell:\n    \"\"\"One point of the design: a generator, a size and a density parameter.\"\"\"\n\n    generator: str\n    n: int\n    m: int\n    param: float\n\n    def __post_init__(self) -> None:\n        if self.generator not in GENERATORS:\n            raise ValueError(f\"generator must be one of {GENERATORS}, got {self.generator!r}\")\n\n    @property\n    def id(self) -> str:\n        tag = \"p\" if self.generator == \"bernoulli\" else \"d\"\n        return f\"{self.generator[0]}_n{self.n}_m{self.m}_{tag}{self.param:g}\"\n\n    @staticmethod\n    def parse(text: str) -> \"Cell\":\n        \"\"\"`b:20:40:0.1` or `f:20:20:2`.\"\"\"\n        gen, n, m, param = text.split(\":\")\n        generator = {\"b\": \"bernoulli\", \"f\": \"fixed\"}.get(gen, gen)\n        return Cell(generator, int(n), int(m), float(param))\n\n\ndef cell_seed(cell: Cell, index: int) -> int:\n    \"\"\"The seed of the `index`-th instance of a cell: a CRC of its identity.\n\n    Deterministic across machines and Python versions, and independent of the\n    order in which cells are run, so that a cell can be regenerated alone.\n    \"\"\"\n    return zlib.crc32(f\"{cell.id}:{index}\".encode()) & 0x7FFFFFFF\n\n\ndef instance_name(cell: Cell, index: int) -> str:\n    return f\"ens_{cell.id}_i{index:03d}\"\n\n\ndef generate(cell: Cell, index: int) -> MOSPInstance:\n    \"\"\"The `index`-th instance of a cell, byte for byte the same every time.\"\"\"\n    seed = cell_seed(cell, index)\n    name = instance_name(cell, index)\n    if cell.generator == \"bernoulli\":\n        return generate_random_instance(cell.n, cell.m, cell.param, seed=seed, name=name)\n    return generate_structured_instance(cell.n, cell.m, int(cell.param), seed=seed, name=name)\n\n\ndef pilot_cells(sizes=PILOT_N, ds=PILOT_D, ps=PILOT_P, m_ratio: int = 1) -> list[Cell]:\n    cells = []\n    for n in sizes:\n        m = m_ratio * n\n        cells += [Cell(\"fixed\", n, m, d) for d in ds if d <= n]\n        cells += [Cell(\"bernoulli\", n, m, p) for p in ps]\n    return cells\n\n\ndef extension_cells(sizes=PILOT_N) -> list[Cell]:\n    \"\"\"m = 2n at every pilot density, and p = 0.025 at m = n: what the pilot\n    grid does not cover but item 02's grid does.\"\"\"\n    cells = []\n    for ratio in EXTENSION_M_RATIOS:\n        cells += pilot_cells(sizes, EXTENSION_D, EXTENSION_P, m_ratio=ratio)\n    cells += [Cell(\"bernoulli\", n, n, p) for n in sizes for p in EXTENSION_P if p not in PILOT_P]\n    return cells\n\n\n# ----------------------------------------------------------------------------\n# one instance\n# ----------------------------------------------------------------------------\n\n\ndef analyse(instance: MOSPInstance, cell: Cell, index: int, solutions_dir: Path,\n            deadline_seconds: float | None = 60.0,\n            solve_budget: float | None = 600.0) -> dict:\n    \"\"\"Solve, verify, refute under both configurations, featurise, certify.\n\n    `optimum` is a certified optimum when `certified` is true; when the solve\n    budget ran out it is a verified upper bound and the refutation is skipped\n    (`status_*` = `\"uncertified\"`). A refutation that returns `\"sat\"` would\n    mean the solver's own optimum is wrong; that is recorded, never hidden.\n    \"\"\"\n    from learning.canonical import canonical_record\n    from learning.features import instance_features\n    from learning.node_counts import refute\n    from mosp.verify import max_open_stacks\n    from satisfiability.mosp_solver import solve_mosp_exact","is_error":false}]},"parent_tool_use_id":null,"session_id":"44e8c6d7-9d93-4ce6-b6cb-7af364193448","uuid":"4793c4b5-4ce2-4e26-84d3-bb7ffff6a156","timestamp":"2026-11-01T00:16:47.028Z","tool_use_result":{"stdout":"5:    e = (n_ones - m) / n = (mean patterns per customer) - 1 = r (c - 1),\n7:with `r = m / n` and `c = n_ones / m` the mean customers per pattern. The\n9:`kappa` components, so its cyclomatic number is `gamma = n_ones - n - m + kappa`\n10:and `gamma / n = e - 1 + kappa / n`. `B` is a forest iff `gamma = 0` iff its\n14:section 0): `e = 1`, where the first-moment bound turns on; the hardness ridge at\n15:`e ~ 2-2.4`; and `e_g(r) = (sqrt(r^2 + 4 r) - r) / 2`, the giant component of\n17:`r c (c - 1) = 1` in excess coordinates). This module computes `e`, `r`, `c`,\n25:every ensemble series at `n >= 50`.\n36:    python -m learning.excess --stage slopes        # item 02: opt = a + b n per series, e-matched pairs, beta*\n40:from __future__ import annotations\n42:import argparse\n43:impo