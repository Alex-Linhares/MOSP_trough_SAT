{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0143YEQNhueLWJEYrgkZVmAV","type":"tool_result","content":"149:- [ ] **04 Industrial instances: the 24 SCOOP instances in the excess.**\n\"\"\"loop0010 item 01: the excess `e = (n_ones - m) / n`, the incidence graph's\ncomponents and cyclomatic number, the forest flag against the (2, 2)-core, and\nthe three lines, on hand-checkable matrices.\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom learning.excess import (collection_of, crossing_table, excess, giant_threshold_excess, incidence_stats,\n                             ratio_label, repaired_giant_threshold_excess, series_table)\n\n# A forest: the path c0 - p0 - c1 - p1 - c2 in the incidence graph.\nPATH = np.array([[1, 0],\n                 [1, 1],\n                 [0, 1]])\n# A non-forest: K_{2,2} plus a pendant pattern on c0, one cycle.\nCYCLE = np.array([[1, 1, 1],\n                  [1, 1, 0]])\n# Two components, one of them a 4-cycle: gamma = 1, kappa = 2.\nTWO = np.array([[1, 1, 0],\n                [1, 1, 0],\n                [0, 0, 1]])\n\n\ndef test_path_is_a_forest_by_hand():\n    s = incidence_stats(PATH)\n    assert (s[\"n\"], s[\"m\"], s[\"n_ones\"]) == (3, 2, 4)\n    assert s[\"e\"] == pytest.approx((4 - 2) / 3)          # mean patterns per customer 4/3, minus one\n    assert s[\"kappa\"] == 1 and s[\"gamma\"] == 0 and s[\"forest\"]\n    assert s[\"lcc_frac\"] == 1.0 and s[\"lcc_cust_frac\"] == 1.0\n    assert s[\"core2_cust_frac\"] == 0.0 and s[\"core2_vertex_frac\"] == 0.0\n\n\ndef test_cycle_by_hand():\n    s = incidence_stats(CYCLE)\n    assert (s[\"n\"], s[\"m\"], s[\"n_ones\"]) == (2, 3, 5)\n    assert s[\"e\"] == pytest.approx((5 - 3) / 2)\n    assert s[\"kappa\"] == 1\n    assert s[\"gamma\"] == 5 - 2 - 3 + 1 == 1 and not s[\"forest\"]\n    assert s[\"gamma_n\"] == pytest.approx(0.5)\n25:def test_path_is_a_forest_by_hand():\n34:def test_cycle_by_hand():\n46:def test_two_components_by_hand():\n55:def test_excess_is_r_times_c_minus_one():\n69:def test_giant_threshold_in_excess_coordinates():\n83:def test_ratio_labels_absorb_the_frames_rounding():\n88:def test_collections_and_classes():\n107:def test_crossing_is_interpolated_between_the_straddling_cells():\n129:def test_sizes_histogram_round_trips():\n138:def test_ols_recovers_a_line_and_its_errors():\n157:def test_series_slopes_and_matched_pairs_on_synthetic_series():\n186:def test_rule_by_bin_counts_every_certified_instance_once():\n#!/usr/bin/env python3\n\"\"\"Regression gate for loop0010 (the excess phase diagram).\n\nPasses only if all five hold:\n1. `lake build` in lean/ succeeds;\n2. every `.lean` file under lean/MOSPFormalization/ (top level, Complex/ and\n   Search/) is imported by lean/MOSPFormalization.lean, so the build really\n   checks it;\n3. the number of `sorry` in Lean *code* (comments and docstrings stripped) is\n   at most the baseline (0: the development has none since Appendix E) plus\n   the entries in allowed_sorries.txt, and no `axiom` declaration exists;\n4. `python -m pytest tests/ -q -x` passes, and so does `pytest` in\n   pathwidth_solver/;\n5. the paper builds with no undefined references (`make -C paper1/latex check`).\n\n    python3 Ralph_Loops/loop0010/gate.py\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nREPO = HERE.parents[1]\nLEAN = REPO / \"lean\"\nBASELINE_SORRIES = 0\nALLOWED = HERE / \"allowed_sorries.txt\"\nPAPER = REPO / \"paper1\" / \"latex\"\n\n\ndef strip_comments(src: str) -> str:\n    out, i, depth = [], 0, 0\n    while i < len(src):\n        if src.startswith(\"/-\", i):\n            depth += 1; i += 2; continue\n        if depth and src.startswith(\"-/\", i):\n            depth -= 1; i += 2; continue\n        if depth:\n            i += 1; continue\n        if src.startswith(\"--\", i):\n            j = src.find(\"\\n\", i); i = len(src) if j < 0 else j; continue\n        if src[i] == '\"':\n            j = i + 1\n            while j < len(src) and src[j] != '\"':\n                j += 2 if src[j] == \"\\\\\" else 1\n            i = j + 1; continue\n        out.append(src[i]); i += 1\n    return \"\".join(out)\n\n\ndef main() -> int:\n    ok = True\n    b = subprocess.run([\"lake\", \"build\"], cwd=LEAN, capture_output=True, text=True, errors=\"replace\")\n    tail = \"\\n\".join((b.stdout + b.stderr).splitlines()[-25:])\n    if b.returncode != 0:\n        print(\"GATE FAIL: lake build\\n\" + tail); return 1\n    print(\"lake build: ok\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"bbb55d20-e727-4bb1-ab21-f3ce640d1d39","uuid":"e66b7ae6-98f0-4c5d-8d75-26d78b4e4a67","timestamp":"2026-11-01T01:55:16.685Z","tool_use_result":{"stdout":"149:- [ ] **04 Industrial instances: the 24 SCOOP instances in the excess.**\n\"\"\"loop0010 item 01: the excess `e = (n_ones - m) / n`, the incidence graph's\ncomponents and cyclomatic number, the forest flag against the (2, 2)-core, and\nthe three lines, on hand-checkable matrices.\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom learning.excess import (collection_of, crossing_table, excess, giant_threshold_excess, incidence_stats,\n                             ratio_label, repaired_giant_threshold_excess, series_table)\n\n# A forest: the path c0 - p0 - c1 - p1 - c2 in the incidence graph.\nPATH = np.array([[1, 0],\n                 [1, 1],\n                 [0, 1]])\n# A non-forest: K_{2,2} plus a pendant pattern on c0, one cycle.\nCYCLE = np.array([[1, 1, 1],\n                  [1, 1, 0]])\n# Two components, one of them a 4-cycle: gamma = 1, kappa = 2.\nTWO = np.array([[1, 1, 0],\n                [1, 1, 0],\n                [0, 0, 1]])\n\n\ndef test_path_is_a_forest_by_hand():\n    s = incidence_stats(PATH)\n    assert (s[\"n\"], s[\"m\"], s[\"n_ones\"]) == (3, 2, 4)\n    assert s[\"e\"] == pytest.approx((4 - 2) / 3)          # mean patterns per