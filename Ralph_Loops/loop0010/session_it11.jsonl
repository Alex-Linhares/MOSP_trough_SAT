be realised as a layout up to ties:\nvertices with strictly smaller key come strictly earlier. This generalises\n`exists_monotone_layout`, which is the case `f = lastBag`. -/\ntheorem exists_layout_sorted {ι : Type*} [LinearOrder ι] (f : V → ι) :\n    ∃ σ : LinearLayout V, ∀ u v : V, f u < f v → (σ u).val < (σ v).val := by\n  classical\n  let e := Fintype.equivFin V\n  let _ : LinearOrder V :=\n    LinearOrder.lift' (fun v => toLex (f v, e v)) (by\n      intro u v huv\n      have huv' : (f u, e u) = (f v, e v) := huv\n      exact e.injective (congr_arg Prod.snd huv'))\n  let iso : Fin (Fintype.card V) ≃o V := monoEquivOfFin V rfl\n  refine ⟨iso.symm.toEquiv, fun u v hlt => ?_⟩\n  have hu_lt_v : toLex (f u, e u) < toLex (f v, e v) := by\n    rw [Prod.Lex.toLex_lt_toLex]\n    exact Or.inl hlt\n  exact iso.symm.strictMono (show u < v from hu_lt_v)\n\nend Graph\n\n/-! ### The MOSP graph -/\n\nvariable {C Pt : Type*} [Fintype C] [DecidableEq C] [Fintype Pt] [DecidableEq Pt]\n\n----\n62:namespace MOSPFormalization\n64:/-! ### Graph-level lemmas -/\n66:section Graph\n70:namespace PathDecomposition\n78:theorem exists_bag_of_isClique (D : PathDecomposition G) (K : Finset V)\n94:theorem card_le_width_add_one_of_isClique (D : PathDecomposition G) (K : Finset V)\n99:end PathDecomposition\n102:theorem exists_pathDecomposition_width_eq (G : SimpleGraph V) :\n110:theorem card_le_pathwidth_add_one_of_isClique (G : SimpleGraph V) (K : Finset V)\n119:theorem exists_layout_sorted {ι : Type*} [LinearOrder ι] (f : V → ι) :\n135:end Graph\n141:namespace MOSPInstance\n146:def shares (c d : C) : Prop :=\n156:def mospGraph : SimpleGraph C where\n169:theorem mospGraph_adj_iff (c d : C) :\n172:theorem mem_customers_iff (p : Pt) (c : C) : c ∈ M.customers p ↔ M.requires c p := by\n175:theorem mem_patterns_iff (c : C) (p : Pt) : p ∈ M.patterns c ↔ M.requires c p := by\n179:theorem customers_isClique (p : Pt) : M.mospGraph.IsClique (M.customers p : Set C) := by\n187:theorem isActive_iff (σ : LinearLayout Pt) (c : C) (i : ℕ) :\n193:theorem isActive_of_requires (σ : LinearLayout Pt) {c : C} {p : Pt} (h : M.requires c p) :\n198:theorem isActive_of_between (σ : LinearLayout Pt) {c : C} {i j k : ℕ}\n207:theorem exists_requires_of_isActive (σ : LinearLayout Pt) {c : C} {i : ℕ}\n213:theorem lt_card_of_isActive (σ : LinearLayout Pt) {c : C} {i : ℕ}\n219:def activeSet (σ : LinearLayout Pt) (i : ℕ) : Finset C :=\n222:theorem mem_activeSet_iff (σ : LinearLayout Pt) (i : ℕ) (c : C) :\n226:theorem card_activeSet (σ : LinearLayout Pt) (i : ℕ) :\n229:theorem openStacksAt_le_maxOpenStacks (σ : LinearLayout Pt) {i : ℕ}\n243:def stackBag (σ : LinearLayout Pt) (e : C ≃ Fin (Fintype.card C)) (i : ℕ) : Finset C :=\n247:theorem mem_stackBag_iff (σ : LinearLayout Pt) (e : C ≃ Fin (Fintype.card C)) (i : ℕ)\n252:theorem patterns_eq_empty_iff (c : C) : M.patterns c = ∅ ↔ ∀ p, ¬ M.requires c p := by\n256:theorem stackBag_subset_activeSet (σ : LinearLayout Pt) (e : C ≃ Fin (Fintype.card C))\n266:theorem card_stackBag_le_one (σ : LinearLayout Pt) (e : C ≃ Fin (Fintype.card C))\n277:theorem card_stackBag_le (σ : LinearLayout Pt) (e : C ≃ Fin (Fintype.card C)) (i : ℕ) :\n291:def stackDecomposition (σ : LinearLayout Pt) (e : C ≃ Fin (Fintype.card C)) :\n332:theorem stackDecomposition_width_le (σ : LinearLayout Pt) (e : C ≃ Fin (Fintype.card C)) :\n346:theorem pathwidth_le_maxOpenStacks_sub_one (σ : LinearLayout Pt) :\n353:theorem exists_maxOpenStacks_eq_mospValue :\n362:theorem pathwidth_le_mospValue_sub_one :\n372:noncomputable def bagOf (D : PathDecomposition M.mospGraph) (p : Pt) : Fin (D.length + 1) :=\n375:theorem customers_subset_bag_bagOf (D : PathDecomposition M.mospGraph) (p : Pt) :\n381:theorem activeSet_subset_bag_of_sorted (D : PathDecomposition M.mospGraph)\n407:theorem exists_maxOpenStacks_le_width_add_one (D : PathDecomposition M.mospGraph) :\n423:theorem mospValue_le_width_add_one (D : PathDecomposition M.mospGraph) :\n429:theorem mospValue_le_pathwidth_add_one :\n438:theorem one_le_maxOpenStacks (σ : LinearLayout Pt) (h : ∃ c p, M.requires c p) :\n447:theorem one_le_mospValue (h : ∃ c p, M.requires c p) : 1 ≤ M.mospValue := by\n454:theorem pathwidth_add_one_le_mospValue (h : ∃ c p, M.requires c p) :\n460:/-- **Main theorem** (Yanasse 1997c; Linhares & Yanasse 2002): the MOSP value is\n464:theorem mospValue_eq_pathwidth_add_one (h : ∃ c p, M.requires c p) :\n469:theorem mospValue_eq_zero_of_forall_not (h : ∀ c p, ¬ M.requires c p) : M.mospValue = 0 := by\n487:theorem pathwidth_mospGraph_eq_zero_of_forall_not (h : ∀ c p, ¬ M.requires c p) :\n493:end MOSPInstance\n495:end MOSPFormalization","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RH9Rr4gxYpHQs1kkp6gJ47","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
