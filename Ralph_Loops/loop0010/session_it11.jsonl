pattern `j` iff `c ∈ S j`. -/\ndef coverInstance (S : Fin m → Finset C) : MOSPInstance C (Fin m) :=\n  ⟨fun c j => c ∈ S j⟩\n\ninstance (S : Fin m → Finset C) : DecidableRel (coverInstance S).requires :=\n  fun c j => inferInstanceAs (Decidable (c ∈ S j))\n\ntheorem coverInstance_requires {S : Fin m → Finset C} {c : C} {j : Fin m} :\n    (coverInstance S).requires c j ↔ c ∈ S j := Iff.rfl\n\n/-- The graph of a cover: the MOSP graph of its instance, customers adjacent iff\nsome pattern contains both. -/\nabbrev coverGraph (S : Fin m → Finset C) : SimpleGraph C :=\n  (coverInstance S).mospGraph\n\ntheorem coverGraph_adj {S : Fin m → Finset C} {u v : C} :\n    (coverGraph S).Adj u v ↔ u ≠ v ∧ ∃ j, u ∈ S j ∧ v ∈ S j := Iff.rfl\n\n/-! ### Empty pairs of a cover -/\n\n/-- For disjoint `A`, `R`: `(A, R)` is an empty pair of the cover's graph iff no\npattern meets both sides. -/\ntheorem isEmptyPair_coverGraph_iff {S : Fin m → Finset C} {A R : Finset C}\n    (hAR : Disjoint A R) :\n    IsEmptyPair (coverGraph S) A R ↔ ∀ j, Disjoint (S j) A ∨ Disjoint (S j) R := by\n  constructor\n  · intro h j\n    by_contra hc\n    rw [not_or, Finset.not_disjoint_iff, Finset.not_disjoint_iff] at hc\n90:def covers (s : Fin m → ℕ) : Finset (Fin m → Finset C) :=\n93:theorem mem_covers {s : Fin m → ℕ} {S : Fin m → Finset C} :\n98:theorem card_covers (s : Fin m → ℕ) :\n103:def coverInstance (S : Fin m → Finset C) : MOSPInstance C (Fin m) :=\n109:theorem coverInstance_requires {S : Fin m → Finset C} {c : C} {j : Fin m} :\n117:theorem coverGraph_adj {S : Fin m → Finset C} {u v : C} :\n124:theorem isEmptyPair_coverGraph_iff {S : Fin m → Finset C} {A R : Finset C}\n143:theorem card_powersetCard_filter_disjoint (A : Finset C) (s : ℕ) :\n160:def avoidCount (n a r s : ℕ) : ℕ :=\n166:theorem avoidCount_eq {n t s : ℕ} (ht : 1 ≤ t) :\n176:theorem card_filter_avoid {A R : Finset C} (hAR : Disjoint A R) (s : ℕ) :\n206:def emptyPairCovers (s : Fin m → ℕ) (A R : Finset C) : Finset (Fin m → Finset C) :=\n210:theorem mem_emptyPairCovers {s : Fin m → ℕ} {A R : Finset C} {S : Fin m → Finset C} :\n219:theorem card_emptyPairCovers (s : Fin m → ℕ) {A R : Finset C} (hAR : Disjoint A R) :\n229:noncomputable def coversOfPathwidthLe (s : Fin m → ℕ) (k : ℕ) : Finset (Fin m → Finset C) := by\n232:theorem mem_coversOfPathwidthLe {s : Fin m → ℕ} {k : ℕ} {S : Fin m → Finset C} :\n239:theorem mem_biUnion_emptyPairCovers {s : Fin m → ℕ} {k : ℕ} (hk : k < Fintype.card C)\n264:theorem card_coversOfPathwidthLe_le (s : Fin m → ℕ) (k : ℕ) (hk : k < Fintype.card C) :\n292:theorem prob_coversOfPathwidthLe_le (s : Fin m → ℕ) (k : ℕ) (hk : k < Fintype.card C) :\n321:noncomputable def coversOfMospValueLe (s : Fin m → ℕ) (k : ℕ) : Finset (Fin m → Finset C) := by\n324:theorem mem_coversOfMospValueLe {s : Fin m → ℕ} {k : ℕ} {S : Fin m → Finset C} :\n330:theorem exists_requires_of_mem_covers {s : Fin m → ℕ} (hm : 0 < m) (hs : ∀ j, 1 ≤ s j)\n341:theorem coversOfMospValueLe_eq_coversOfPathwidthLe {s : Fin m → ℕ} (hm : 0 < m)\n362:theorem card_coversOfMospValueLe_le (s : Fin m → ℕ) (hm : 0 < m) (hs : ∀ j, 1 ≤ s j)\n375:theorem prob_coversOfMospValueLe_le (s : Fin m → ℕ) (hm : 0 < m) (hs : ∀ j, 1 ≤ s j)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015tnCMYKbNCqeLbDF2Q2324","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
