-------------------------------------","+# item 02: the two-key rule on every instance, and opt / n against the excess","+# ----------------------------------------------------------------------------"," ","+SLOPE_MIN_N = 30","+PAIR_TOLERANCE = 0.05","+E_BINS = [0.0, 0.62, 1.0, 1.5, 2.0, 2.4, 3.0, 4.0, 6.0, 10.0, np.inf]","+E_BIN_LABELS = [\"[0, 0.62)\", \"[0.62, 1)\", \"[1, 1.5)\", \"[1.5, 2)\", \"[2, 2.4)\", \"[2.4, 3)\", \"[3, 4)\", \"[4, 6)\",","+                \"[6, 10)\", \">= 10\"]","+_CS_NAME = re.compile(r\"^Random-(\\d+)-(\\d+)-(\\d+)-\\d+_\\d+$\")"," ","+","+def sizes_text(matrix: np.ndarray) -> str:","+    \"\"\"The pattern-size histogram of a matrix as `size:count;...` (column sums).\"\"\"","+    sizes = np.asarray(matrix).sum(axis=0)","+    values, counts = np.unique(sizes, return_counts=True)","+    return \";\".join(f\"{int(v)}:{int(c)}\" for v, c in zip(values, counts))","+","+","+def sizes_from_text(text: str) -> dict[int, int]:","+    out: dict[int, int] = {}","+    for part in str(text).split(\";\"):","+        if part:","+            v, c = part.split(\":\")","+            out[int(v)] = out.get(int(v), 0) + int(c)","+    return out","+","+","+def _rule_on(instance: MOSPInstance) -> tuple[int, float]:","+    from satisfiability.heuristics import two_key_rule","+    t = time.perf_counter()","+    value, _ordering = two_key_rule(instance)","+    return int(value), time.perf_counter() - t","+","+","+def _rule_ensemble_job(args) -> dict:","+    frame_name, cell_text, index, name, n_ones_recorded, optimum, certified = args","+    cell = Cell.parse(cell_text)","+    inst = generate(cell, index)","+    if inst.name != name or int(inst.matrix.sum()) != n_ones_recorded:","+        raise AssertionError(f\"{name}: regeneration does not match the record\")","+    value, seconds = _rule_on(inst)","+    return {\"source\": \"ensemble\", \"frame\": frame_name, \"instance_name\": name, \"cell\": cell.id,","+            \"generator\": cell.generator, \"param\": cell.param, \"n\": cell.n, \"m\": cell.m,","+            \"n_ones\": n_ones_recorded, \"optimum\": optimum if certified else np.nan, \"certified\": bool(certified),","+            \"rule\": value, \"rule_seconds\": seconds, \"sizes\": sizes_text(inst.matrix)}","+","+","+def _rule_corpus_job(args) -> dict:","+    source_file, name, matrix = args","+    inst = MOSPInstance.from_matrix(matrix, name=name)","+    value, seconds = _rule_on(inst)","+    optimum, provenance = solution_record(inst)","+    certified = provenance.startswith(\"certified\")","+    collection, cls = collection_of(source_file, name)","+    n, m = matrix.shape","+    match = _CS_NAME.match(name)","+    return {\"source\": \"corpus\", \"frame\": \"corpus\", \"instance_name\": name, \"cell\": cls,","+            \"generator\": \"chu_stuckey\" if match else collection, \"param\": int(match.group(3)) if match else np.nan,","+            \"n\": n, \"m\": m, \"n_ones\": int(np.asarray(matrix).sum()), \"optimum\": optimum if certified else np.nan,","+            \"certified\": certified, \"rule\": value, \"rule_seconds\": seconds, \"sizes\": sizes_text(matrix)}","+","+","+def rule_rows(workers: int, out: Path = RULE_CSV, ensemble_dir: Path = ENSEMBLE_DIR) -> pd.DataFrame:","+    \"\"\"The two-key closing rule (`satisfiability.heuristics.two_key_rule`,","+    valued by simulation) on every ensemble instance (regenerated from its","+    seed) and every corpus instance, with the certified optimum beside it and","+    the pattern-size histogram the first moment needs. A scoring run: nothing is","+    solved, nothing is written to the compute ledger or to `solutions/`.\"\"\"","+    from learning.dataset import enumerate_instances","+    started = time.time()","+    ens = _map(_rule_ensemble_job, ensemble_jobs(ensemble_dir), workers)","+    corpus = _map(_rule_corpus_job, [(str(path), inst.name, inst.matrix) for path, inst in enumerate_instances()],","+                  workers)","+    frame = pd.DataFrame(ens + corpus)","+    frame[\"e\"] = excess(frame[\"n\"], frame[\"m\"], frame[\"n_ones\"])","+    frame[\"r\"] = frame[\"m\"] / frame[\"n\"]","+    frame[\"r_label\"] = [ratio_label(r) for r in frame[\"r\"]]","+    frame[\"rule_gap\"] = frame[\"rule\"] - frame[\"optimum\"]","+    out.parent.mkdir(parents=True, exist_ok=True)","+    frame.to_csv(out, index=False)","+    print(f\"rule: {len(frame)} rows ({len(ens)} ensemble, {len(corpus)} corpus), \"","+          f\"{frame['rule_seconds'].sum():.1f} s of rule time, {time.time() - started:.0f} s wall -> {out}\", flush=True)","+    return frame","+","+","+def load_rule(path: Path = RULE_CSV) -> pd.DataFrame:","+    if not path.exists():","+        raise FileNotFoundError(f\"{path} does not exist; run `python -m learning.excess --stage rule` first\")","+    return pd.read_csv(path, low_memory=False)","+","+","+def _ols(x: np.ndarray, y: np.ndarray) -> tuple[float, float, float, float]:","+    \"\"\"(a, b, se_a, se_b) of `y = a + b x` by least squares; nan where not estimable.\"\"\"","+    x, y = np.asarray(x, float), np.asarray(y, float)","+    if len(x) < 3 or np.ptp(x) == 0:","+        return np.nan, np.nan, np.nan, np.nan","+    xm = x.mean()","+    sxx = float(((x - xm) ** 2).sum())","+    b = float(((x - xm) * (y - y.mean())).sum() / sxx)","+    a = float(y.mean() - b * xm)","+    resid = y - a - b * x","+    s2 = float((resid ** 2).sum() / (len(x) - 2))","+    return a, b, float(np.sqrt(s2 * (1 / len(x) + xm ** 2 / sxx))), float(np.sqrt(s2 / sxx))","+","+","+def series_key(frame: pd.DataFrame) -> pd.Series:","+    \"\"\"`(generator, r_label, param)`: the ensemble series across `n`, and for","+    the corpus the Chu & Stuckey class across `n` (`chu_stuckey`, `r`, `d`).\"\"\"","+    return frame[\"generator\"].astype(str) + \"|\" + frame[\"r_label\"].astype(str) + \"|\" + frame[\"param\"].map(","+        lambda p: f\"{p:g}\")","+","+","+def series_slopes(rule: pd.DataFrame, min_n: int = SLOPE_MIN_N, min_sizes: int = 3) -> pd.DataFrame:","+    \"\"\"Per series with at least `min_sizes` distinct `n >= min_n`: the fit","+    `opt = a + b n` on the certified instances (one point per instance, so the","+    standard error carries the within-cell spread), the same fit for the","+    rule's value, the realised excess (mean over the fitted instances; never","+    the nominal `r (d - 1)`), `beta*` at the series' realised size histogram","+    and `mu = m / n`, and the rule's exactness and gap.\"\"\"","+    from learning.first_moment import beta_star","+    f = rule[rule[\"certified\"] & rule[\"optimum\"].notna() & (rule[\"n\"] >= min_n)].copy()","+    f = f[f[\"generator\"].isin([\"fixed\", \"bernoulli\", \"chu_stuckey\"])]","+    f[\"key\"] = series_key(f)","+    rows = []","+    for key, g in f.groupby(\"key\"):","+        sizes = sorted(set(g[\"n\"]))","+        if len(sizes) < min_sizes:","+            continue","+        gen, rl, param = key.split(\"|\")","+        a, b, se_a, se_b = _ols(g[\"n\"], g[\"optimum\"])","+        ar, br, _, se_br = _ols(g[\"n\"], g[\"rule\"])","+        hist: dict[int, int] = {}","+        for text in g[\"sizes\"]:","+            for v, c in sizes_from_text(text).items():","+                hist[v] = hist.get(v, 0) + c","+        mu = float(g[\"r\"].mean())","+        top = g[g[\"n\"] == sizes[-1]]","+        rows.append({","+            \"generator\": gen, \"r\": rl, \"param\": float(param), \"key\": key,","+            \"e\": float(g[\"e\"].mean()), \"e sd\": float(g[\"e\"].std()), \"mu\": mu,","+            \"mean size\": float(sum(v * c for v, c in hist.items()) / sum(hist.values())),","+            \"n sizes\": \", \".join(str(int(x)) for x in sizes), \"instances\": len(g),","+            \"a\": a, \"b\": b, \"se b\": se_b, \"b rule\": br, \"se b rule\": se_br,","+            \"opt/n at max n\": float((top[\"optimum\"] / top[\"n\"]).mean()),","+            \"rule/n at max n\": float((top[\"rule\"] / top[\"n\"]).mean()),","+            \"beta* (sizes)\": beta_star(mu, hist),","+            \"beta* (fixed d)\": beta_star(mu, [int(round(float(param)))]) if gen in (\"fixed\", \"chu_stuckey\") else np.nan,","+            \"rule exact\": float((g[\"rule_gap\"] == 0).mean()), \"rule gap mean\": float(g[\"rule_gap\"].mean()),","+            \"rule gap max\": int(g[\"rule_gap\"].max()), \"rule gap/n mean\": float((g[\"rule_gap\"] / g[\"n\"]).mean()),","+        })","+    out = pd.DataFrame(rows)","+    if out.empty:","+        return out","+    gen_order = {\"fixed\": 0, \"bernoulli\": 1, \"chu_stuckey\": 2}","+    out[\"_g\"] = out[\"generator\"].map(gen_order)","+    out[\"_r\"] = [float(RATIO_LABELS_INV[r]) for r in out[\"r\"]]","+    return out.sort_values([\"_g\", \"_r\", \"param\"]).drop(columns=[\"_g\", \"_r\"]).reset_index(drop=True)","+","+","+def matched_pairs(slopes: pd.DataFrame, tol: float = PAIR_TOLERANCE) -> pd.DataFrame:","+    \"\"\"Every pair of series whose realised `e` agree within `tol` and whose","+    `(generator, d or p, mu)` differ: the two slopes, their difference, twice","+    the larger standard error, and whether they differ by more than that. The","+    kill criterion of item 02 counts the pairs that differ.\"\"\"","+    rows = []","+    s = slopes.reset_index(drop=True)","+    for i in range(len(s)):","+        for j in range(i + 1, len(s)):","+            x, y = s.iloc[i], s.iloc[j]","+            if abs(x[\"e\"] - y[\"e\"]) > tol:","+                continue","+            if (x[\"generator\"], x[\"param\"], x[\"r\"]) == (y[\"generator\"], y[\"param\"], y[\"r\"]):","+                continue","+            two_se = 2 * max(x[\"se b\"], y[\"se b\"])","+            diff = x[\"b\"] - y[\"b\"]","+            rows.append({\"series 1\": f\"{x['generator']} r={x['r']} {x['param']:g}\",","+                         \"series 2\": f\"{y['generator']} r={y['r']} {y['param']:g}\",","+                         \"e 1\": x[\"e\"], \"e 2\": y[\"e\"], \"b 1\": x[\"b\"], \"b 2\": y[\"b\"], \"diff\": diff,","+                         \"2 max se\": two_se, \"|diff| / 2 max se\": abs(diff) / two_se if two_se > 0 else np.inf,","+                         \"differ\": bool(abs(diff) > two_se),","+                         \"beta* 1\": x[\"beta* (sizes)\"], \"beta* 2\": y[\"beta* (sizes)\"],","+                         \"rule/n 1\": x[\"rule/n at max n\"], \"rule/n 2\": y[\"rule/n at max n\"]})","+    out = pd.DataFrame(rows)","+    return out.sort_values([\"e 1\", \"series 1\"]).reset_index(drop=True) if len(out) else out","+","+","+def rule_by_bin(rule: pd.DataFrame) -> pd.DataFrame:","+    \"\"\"The rule against the certified optimum per excess bin and source:","+    count, exact share, mean and maximum gap, mean gap / n, and the rule's","+    value as a fraction of `n` beside the optimum's.\"\"\"","+    f = rule[rule[\"certified\"] & rule[\"optimum\"].notna()].copy()","+    f[\"bin\"] = pd.cut(f[\"e\"], E_BINS, labels=E_BIN_LABELS, right=False)","+    rows = []","+    for (src, b), g in f.groupby([\"source\", \"bin\"], observed=True):","+        rows.append({\"source\": src, \"e bin\": b, \"count\": len(g), \"n range\": f\"{int(g['n'].min())}-{int(g['n'].max())}\",","+                     \"exact\": float((g[\"rule_gap\"] == 0).mean()), \"gap mean\": float(g[\"rule_gap\"].mean()),","+                     \"gap q90\": float(g[\"rule_gap\"].quantile(0.9)), \"gap max\": int(g[\"rule_gap\"].max()),","+                     \"gap/n mean\": float((g[\"rule_gap\"] / g[\"n\"]).mean()),","+                     \"opt/n mean\": float((g[\"optimum\"] / g[\"n\"]).mean()),","+                     \"rule/n mean\": float((g[\"rule\"] / g[\"n\"]).mean())})","+    return pd.DataFrame(rows)","+","+","+def rule_worst(rule: pd.DataFrame, top: int = 10) -> pd.DataFrame:","+    f = rule[rule[\"certified\"] & rule[\"optimum\"].notna()]","+    cols = [\"source\", \"instance_name\", \"n\", \"m\", \"e\", \"optimum\", \"rule\", \"rule_gap\"]","+    return f.sort_values([\"rule_gap\", \"n\"], ascending=[False, True]).head(top)[cols].reset_index(drop=True)","+","+","+def slopes_tables(rule: pd.DataFrame) -> str:","+    slopes = series_slopes(rule)","+    pairs = matched_pairs(slopes)","+    bins = rule_by_bin(rule)","+    worst = rule_worst(rule)","+    scored = rule[rule[\"certified\"] & rule[\"optimum\"].notna()]","+    n_differ = int(pairs[\"differ\"].sum()) if len(pairs) else 0","+    verdict = (\"the one-parameter hypothesis is DEAD (slopes differ on at least half of the e-matched pairs)\"","+               if len(pairs) and n_differ * 2 >= len(pairs) else","+               \"the one-parameter hypothesis SURVIVES this test (slopes differ on fewer than half of the pairs)\")","+    cols = [\"generator\", \"r\", \"param\", \"e\", \"mu\", \"mean size\", \"n sizes\", \"instances\", \"a\", \"b\", \"se b\", \"b rule\",","+            \"opt/n at max n\", \"rule/n at max n\", \"beta* (sizes)\", \"beta* (fixed d)\", \"rule exact\", \"rule gap mean\",","+            \"rule gap max\"]","+    parts = [","+        f\"Scored: {len(scored)} certified instances ({', '.join(f'{s} {len(g)}' for s, g in scored.groupby('source'))}), \"","+        f\"rule time {rule['rule_seconds'].sum():.1f} s in all; series with >= 3 sizes at n >= {SLOPE_MIN_N}: {len(slopes)}; \"","+        f\"e-matched pairs (|Δe| <= {PAIR_TOLERANCE}, different (generator, d or p, mu)): {len(pairs)}, \"","+        f\"of which {n_differ} differ by more than twice the larger standard error. Verdict: {verdict}.\",","+        \"\\n### Per series: opt = a + b n on n >= 30, the rule, beta*\\n\", _md(slopes[cols]),","+        \"\\n### The e-matched pairs\\n\", _md(pairs),","+        \"\\n### The rule against the optimum, per excess bin\\n\", _md(bins),","+        \"\\n### The rule's worst cases\\n\", _md(worst),","+    ]","+    return \"\\n\".join(parts)","+","+","+QUANTITY_COLOURS = {\"b (certified slope)\": \"#2a78d6\", \"rule / n at largest n\": \"#eb6834\", \"beta* (first moment)\": \"#1baf7a\"}","+","+","+def figure_opt(rule: pd.DataFrame, out: Path = FIGURE_OPT) -> Path:","+    \"\"\"Small multiples, one per product ratio `r`: against the series' realised","+    `e`, the certified slope `b` with its 2-se bar, the rule's `width / n` at","+    the largest `n`, and `beta*` at the realised sizes; one marker per series;","+    filled markers the fixed generator, hollow the Bernoulli, squares the","+    Chu & Stuckey classes. Three quantities, three categorical slots; PNG.\"\"\"","+    import matplotlib","+    matplotlib.use(\"Agg\")","+    import matplotlib.pyplot as plt","+","+    slopes = series_slopes(rule)","+    ratios = sorted(set(slopes[\"r\"]), key=lambda r: RATIO_LABELS_INV[r])","+    ncol = 4","+    nrow = int(np.ceil(len(ratios) / ncol))","+    fig, axes = plt.subplots(nrow, ncol, figsize=(3.3 * ncol, 2.9 * nrow), sharey=True, squeeze=False)","+    for ax in axes.ravel()[len(ratios):]:","+        ax.axis(\"off\")","+    markers = {\"fixed\": dict(marker=\"o\", fillstyle=\"full\"), \"bernoulli\": dict(marker=\"o\", fillstyle=\"none\"),","+               \"chu_stuckey\": dict(marker=\"s\", fillstyle=\"full\")}","+    for ax, rl in zip(axes.ravel(), ratios):","+        g = slopes[slopes[\"r\"] == rl]","+        ax.axvline(1.0, color=\"#d8d7d2\", lw=1, zorder=0)","+        ax.axvspan(2.0, 2.4, color=\"#f1f0eb\", zorder=0)","+        for gen, s in g.groupby(\"generator\"):","+            mk = markers[gen]","+            ax.errorbar(s[\"e\"], s[\"b\"], yerr=2 * s[\"se b\"], fmt=\"none\", ecolor=QUANTITY_COLOURS[\"b (certified slope)\"],","+                        elinewidth=1, zorder=2)","+            ax.plot(s[\"e\"], s[\"b\"], ls=\"none\", ms=6, color=QUANTITY_COLOURS[\"b (certified slope)\"], zorder=3, **mk)","+            ax.plot(s[\"e\"], s[\"rule/n at max n\"], ls=\"none\", ms=6, color=QUANTITY_COLOURS[\"rule / n at largest n\"],","+                    zorder=3, **mk)","+            ax.plot(s[\"e\"], s[\"beta* (sizes)\"], ls=\"none\", ms=6, color=QUANTITY_COLOURS[\"beta* (first moment)\"],","+                    zorder=3, **mk)","+        ax.set_title(f\"r = {rl}\", fontsize=10, color=\"#0b0b0b\", loc=\"left\")","+        ax.set_xscale(\"log\")","+        ax.set_ylim(-0.02, 1.02)","+        ax.grid(False)","+        for side in (\"top\", \"right\"):","+            ax.spines[side].set_visible(False)","+        for side in (\"left\", \"bottom\"):","+            ax.spines[side].set_color(\"#c3c2b7\")","+        ax.tick_params(colors=\"#52514e\", labelsize=8)","+    for ax in axes[-1]:","+        ax.set_xlabel(\"realised excess e (log scale)\", fontsize=9, color=\"#52514e\")","+    fig.supylabel(\"per customer\", fontsize=9, color=\"#52514e\")","+    from matplotlib.lines import Line2D","+    handles = [Line2D([], [], ls=\"none\", marker=\"o\", color=c, ms=6, label=k) for k, c in QUANTITY_COLOURS.items()]","+    handles += [Line2D([], [], ls=\"none\", marker=\"o\", color=\"#52514e\", ms=6, label=\"fixed generator\"),","+                Line2D([], [], ls=\"none\", marker=\"o\", fillstyle=\"none\", color=\"#52514e\", ms=6, label=\"Bernoulli generator\"),","+                Line2D([], [], ls=\"none\", marker=\"s\", color=\"#52514e\", ms=6, label=\"Chu & Stuckey classes\")]","+    fig.legend(handles=handles, loc=\"upper right\", frameon=False, fontsize=8, ncol=2)","+    fig.text(0.02, 0.955, \"grey line e = 1 (first moment turns on); band e = 2–2.4 (the hardness ridge); \"","+             \"bars ± 2 se on b\", fontsize=8, color=\"#52514e\")","+    fig.tight_layout(rect=(0.02, 0, 1, 0.92))","+    out.parent.mkdir(parents=True, exist_ok=True)","+    fig.savefig(out, dpi=150, facecolor=\"#fcfcfb\")","+    plt.close(fig)","+    return out","+","+","+# ----------------------------------------------------------------------------","+","+"," def main() -> None:","     ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)","-    ap.add_argument(\"--stage\", choices=(\"build\", \"tables\", \"figure\