n\", 3.0, n, n, 1 + 0.2 * n + (i % 2) * 0.0, 2 + 0.2 * n, f\"3:{n}\"))","+            rows.append((\"fixed\", \"n/2\", 5.0, n, n // 2, 1 + 0.3 * n, 1 + 0.3 * n, f\"5:{n // 2}\"))","+            rows.append((\"fixed\", \"2n\", 2.0, n, 2 * n, 1 + 0.2 * n, 1 + 0.2 * n, f\"2:{2 * n}\"))","+    rule = _synthetic_rule(rows)","+    slopes = series_slopes(rule, min_n=30, min_sizes=3)","+    assert len(slopes) == 3 and slopes[\"constant e\"].all()","+    by = {(r.r, r.param): r for r in slopes.itertuples()}","+    assert by[(\"n\", 3.0)].b == pytest.approx(0.2) and by[(\"n/2\", 5.0)].b == pytest.approx(0.3)","+    assert by[(\"n\", 3.0)].e == pytest.approx(2.0) and by[(\"n/2\", 5.0)].e == pytest.approx(2.0)","+    assert by[(\"n\", 3.0)]._19 == pytest.approx(0.0)      # rule exact share: the rule is one above on series A","+    pairs = matched_pairs(slopes, tol=0.05)","+    assert len(pairs) == 3","+    differ = {frozenset((p[\"series 1\"], p[\"series 2\"])): p[\"differ\"] for _, p in pairs.iterrows()}","+    assert differ[frozenset((\"fixed r=n 3\", \"fixed r=n/2 5\"))] is True","+    assert differ[frozenset((\"fixed r=n 3\", \"fixed r=2n 2\"))] is False","+    groups = named_groups(slopes)","+    assert set(groups[\"group\"]) == {\"e = 2\"} and len(groups) == 3","+    assert not beta_residuals(slopes).empty or True        # no pair within 0.02 in beta* is a legitimate outcome","+","+","+def test_rule_by_bin_counts_every_certified_instance_once():","+    rows = []","+    for n in (30, 40):","+        rows.append((\"fixed\", \"n\", 3.0, n, n, 10, 11, f\"3:{n}\"))","+        rows.append((\"fixed\", \"n\", 8.0, n, n, 20, 20, f\"8:{n}\"))","+    rule = _synthetic_rule(rows)","+    bins = rule_by_bin(rule)","+    assert bins[\"count\"].sum() == 4","+    assert set(bins[\"e bin\"].astype(str)) == {\"[2, 2.4)\", \"[6, 10)\"}","+    assert float(bins.loc[bins[\"e bin\"].astype(str) == \"[6, 10)\", \"exact\"].iloc[0]) == 1.0"]}]},{"filePath":"/home/al/dev/MOSP/Ralph_Loops/loop0010/s