ixed\\\", \\\"n\\\", 9.0), (\\\"fixed\\\", \\\"2n\\\", 5.0)],\\n}\\n\\n\\ndef named_groups(slopes: pd.DataFrame) -> pd.DataFrame:\\n    \\\"\\\"\\\"The item's e-matched groups of the fixed generator (`(d, mu)` at equal\\n    nominal excess), with the realised `e`, `b`, `beta*`, `b - beta*` and the\\n    rule's `width / n`; a row is marked where its realised `e` is more than\\n    `PAIR_TOLERANCE` from the group's first member.\\\"\\\"\\\"\\n    rows = []\\n    for label, members in NAMED_GROUPS.items():\\n        ref = None\\n        for gen, rl, param in members:\\n            hit = slopes[(slopes[\\\"generator\\\"] == gen) & (slopes[\\\"r\\\"] == rl) & (slopes[\\\"param\\\"] == param)]\\n            if hit.empty:\\n                continue\\n            x = hit.iloc[0]\\n            ref = x[\\\"e\\\"] if ref is None else ref\\n            rows.append({\\\"group\\\": label, \\\"d\\\": int(param), \\\"mu\\\": x[\\\"mu\\\"], \\\"e\\\": x[\\\"e\\\"],\\n                         \\\"within tolerance\\\": bool(abs(x[\\\"e\\\"] - ref) <= PAIR_TOLERANCE),\\n                         \\\"b\\\": x[\\\"b\\\"], \\\"se b\\\": x[\\\"se b\\\"], \\\"beta*\\\": x[\\\"beta* (sizes)\\\"], \\\"b - beta*\\\": x[\\\"b\\\"] - x[\\\"beta* (sizes)\\\"],\\n                         \\\"rule/n at max n\\\": x[\\\"rule/n at max n\\\"], \\\"rule/n - b\\\": x[\\\"rule/n at max n\\\"] - x[\\\"b\\\"]})\\n    return pd.DataFrame(rows)\\n\\n\\ndef beta_residuals(slopes: pd.DataFrame) -> pd.DataFrame:\\n    \\\"\\\"\\\"Per constant-e series: `b - beta*`, and for each pair of constant-e\\n    series with `beta*` within 0.02 of each other, whether the slopes differ by\\n    more than twice the larger standard error -- the same test as the\\n    e-matched pairs, with `beta*` as the matching coordinate.\\\"\\\"\\\"\\n    s = slopes[slopes[\\\"constant e\\\"]].reset_index(drop=True)\\n    rows = []\\n    for i in range(len(s)):\\n        for j in range(i + 1, len(s)):\\n            x, y = s.iloc[i], s.iloc[j]\\n            if abs(x[\\\"beta* (sizes)\\\"] - y[\\\"beta* (sizes)\\\"]) > 0.02:\\n                continue\\n            if (x[\\\"generator\\\"], x[\\\"param\\\"], x[\\\"r\\\"]) == (y[\\\"generator\\\"], y[\\\"param\\\"], y[\\\"r\\\"]):\\n                continue\\n            two_se = 2 * max(x[\\\"se b\\\"], y[\\\"se b\\\"])\\n            rows.append({\\\"series 1\\\": f\\\"{x['generator']} r={x['r']} {x['param']:g}\\\",\\n                         \\\"series 2\\\": f\\\"{y['generator']} r={y['r']} {y['param']:g}\\\",\\n                         \\\"beta* 1\\\": x[\\\"beta* (sizes)\\\"], \\\"beta* 2\\\": y[\\\"beta* (sizes)\\\"], \\\"e 1\\\": x[\\\"e\\\"], \\\"e 2\\\": y[\\\"e\\\"],\\n                         \\\"b 1\\\": x[\\\"b\\\"], \\\"b 2\\\": y[\\\"b\\\"], \\\"diff\\\": x[\\\"b\\\"] - y[\\\"b\\\"], \\\"2 max se\\\": two_se,\\n                         \\\"differ\\\": bool(abs(x[\\\"b\\\"] - y[\\\"b\\\"]) > two_se)})\\n    out = pd.DataFrame(rows)\\n    return out.sort_values(\\\"beta* 1\\\").reset_index(drop=True) if len(out) else out\\n\\n\\ndef slopes_tables(rule: pd.DataFrame) -> str:'''\\nassert old in s; s = s.replace(old, new, 1)\\n\\n# 5. the figure: constant-e series only, linear x, one row\\nold = s[s.index(\\\"def figure_opt(\\\"):s.index(\\\"# ----------------------------------------------------------------------------\\\\n\\\\n\\\\ndef main()\\\")]\\nnew = '''def figure_opt(rule: pd.DataFrame, out: Path = FIGURE_OPT) -> Path:\\n    \\\"\\\"\\\"Small multiples, one per product ratio `r`, for the constant-e series\\n    (the fixed generator and the Chu & Stuckey classes; a Bernoulli series at\\n    fixed `p` has `e` growing with `n` and is left out): against the series'\\n    realised `e`, the certified slope `b` with its 2-se bar, the rule's\\n    `width / n` at the largest `n`, and `beta*` at the realised sizes; one\\n    marker per series, circles the fixed generator, squares the Chu & Stuckey\\n    classes. Three quantities, three categorical slots; PNG for the report.\\\"\\\"\\\"\\n    import matplotlib\\n    matplotlib.use(\\\"Agg\\\")\\n    import matplotlib.pyplot as plt\\n    from matplotlib.lines import Line2D\\n\\n    slopes = series_slopes(rule)\\n    slopes = slopes[slopes[\\\"constant e\\\"]]\\n    ratios = sorted(set(slopes[\\\"r\\\"]), key=lambda r: RATIO_LABELS_INV[r])\\n    fig, axes = plt.subplots(1, len(ratios), figsize=(3.4 * len(ratios), 3.4), sharey=True, squeeze=False)\\n    markers = {\\\"fixed\\\": \\\"o\\\", \\\"chu_stuckey\\\": \\\"s\\\", \\\"bernoulli\\\": \\\"D\\\"}\\n    for ax, rl in zip(axes.ravel(), ratios):\\n        g = slopes[slopes[\\\"r\\\"] == rl]\\n        ax.axvline(1.0, color=\\\"#d8d7d2\\\", lw=1, zorder=0)\\n        ax.axvspan(2.0, 2.4, color=\\\"#f1f0eb\\\", zorder=0)\\n        for gen, s in g.groupby(\\\"generator\\\"):\\n            mk = markers[gen]\\n            ax.errorbar(s[\\\"e\\\"], s[\\\"b\\\"], yerr=2 * s[\\\"se b\\\"], fmt=\\\"none\\\", ecolor=QUANTITY_COLOURS[\\\"b (certified slope)\\\"],\\n                        elinewidth=1, zorder=2)\\n            for key, col in QUANTITY_COLOURS.items():\\n                y = {\\\"b (certified slope)\\\": \\\"b\\\", \\\"rule / n at largest n\\\": \\\"rule/n at max n\\\",\\n                     \\\"beta* (first moment)\\\": \\\"beta* (sizes)\\\"}[key]\\n                ax.plot(s[\\\"e\\\"], s[y], ls=\\\"none\\\", marker=mk, ms=6, color=col, zorder=3)\\n        ax.set_title(f\\\"r = m / n = {rl}\\\", fontsize=10, color=\\\"#0b0b0b\\\", loc=\\\"left\\\")\\n        ax.set_xlim(0, float(g[\\\"e\\\"].max()) * 1.08)\\n        ax.set_ylim(-0.02, 1.0)\\n        ax.grid(False)\\n        for side in (\\\"top\\\", \\\"right\\\"):\\n            ax.spines[side].set_visible(False)\\n        for side in (\\\"left\\\", \\\"bottom\\\"):\\n            ax.spines[side].set_color(\\\"#c3c2b7\\\")\\n        ax.tick_params(colors=\\\"#52514e\\\", labelsize=8)\\n        ax.set_xlabel(\\\"realised excess e\\\", fontsize=9, color=\\\"#52514e\\\")\\n    axes[0, 0].set_ylabel(\\\"per customer\\\", fontsize=9, color=\\\"#52514e\\\")\\n    handles = [Line2D([], [], ls=\\\"none\\\", marker=\\\"o\\\", color=c, ms=6, label=k) for k, c in QUANTITY_COLOURS.items()]\\n    handles += [Line2D([], [], ls=\\\"none\\\", marker=\\\"o\\\", color=\\\"#52514e\\\", ms=6, label=\\\"fixed generator, n = 30–100\\\"),\\n                Line2D([], [], ls=\\\"none\\\", marker=\\\"s\\\", color=\\\"#52514e\\\", ms=6, label=\\\"Chu & Stuckey classes, n = 30–125\\\")]\\n    fig.legend(handles=handles, loc=\\\"upper right\\\", frameon=False, fontsize=8, ncol=2)\\n    fig.text(0.01, 0.95, \\\"grey line: e = 1, where the first moment turns on; band: e = 2–2.4, the hardness ridge; \\\"\\n             \\\"bars: ± 2 se on b\\\", fontsize=8, color=\\\"#52514e\\\")\\n    fig.tight_layout(rect=(0, 0, 1, 0.86))\\n    out.parent.mkdir(parents=True, exist_ok=True)\\n    fig.savefig(out, dpi=150, facecolor=\\\"#fcfcfb\\\")\\n    plt.close(fig)\\n    return out\\n\\n\\n'''\\ns = s.replace(old, new)\\np.write_text(s); print(\\\"patched\\\")\\nPYEOF\\ncat >> tests/test_excess.py <<'EOF'\\n\\n\\n# ---------------------------------------------------------------------------\\n# item 02: the rule stage and the slopes\\n# ---------------------------------------------------------------------------\\n\\nfrom learning.excess import (_ols, beta_residuals, matched_pairs, named_groups, rule_by_bin, series_slopes,  # noqa: E402\\n                             sizes_from_text, sizes_text)\\n\\n\\ndef test_sizes_histogram_round_trips():\\n    m = np.array([[1, 1, 0, 1],\\n                  [1, 0, 1, 1],\\n                  [0, 0, 1, 1]])\\n    assert sizes_text(m) == \\\"1:1;2:2;3:1\\\"\\n    assert sizes_from_text(sizes_text(m)) == {1: 1, 2: 2, 3: 1}\\n    assert sum(sizes_from_text(sizes_text(m)).values()) == m.shape[1]\\n\\n\\ndef test_ols_recovers_a_line_and_its_errors():\\n    x = np.array([30, 30, 40, 40, 50, 50], float)\\n    a, b, se_a, se_b = _ols(x, 2 + 0.5 * x)\\n    assert a == pytest.approx(2.0) and b == pytest.approx(0.5)\\n    assert se_b == pytest.approx(0.0, abs=1e-12)\\n    assert np.isnan(_ols(np.array([30, 30, 30]), np.array([1, 2, 3]))[1])   # no spread in n\\n\\n\\ndef _synthetic_rule(rows):\\n    f = pd.DataFrame(rows, columns=[\\\"generator\\\", \\\"r_label\\\", \\\"param\\\", \\\"n\\\", \\\"m\\\", \\\"optimum\\\", \\\"rule\\\", \\\"sizes\\\"])\\n    f[\\\"source\\\"] = \\\"ensemble\\\"\\n    f[\\\"certified\\\"] = True\\n    f[\\\"n_ones\\\"] = [sum(int(v) * int(c) for v, c in (p.split(\\\":\\\") for p in s.split(\\\";\\\"))) for s in f[\\\"sizes\\\"]]\\n    f[\\\"e\\\"] = (f[\\\"n_ones\\\"] - f[\\\"m\\\"]) / f[\\\"n\\\"]\\n    f[\\\"r\\\"] = f[\\\"m\\\"] / f[\\\"n\\\"]\\n    f[\\\"rule_gap\\\"] = f[\\\"rule\\\"] - f[\\\"optimum\\\"]\\n    return f\\n\\n\\ndef test_series_slopes_and_matched_pairs_on_synthetic_series():\\n    rows = []\\n    # series A: fixed d = 3 at m = n, opt = 1 + 0.2 n exactly, sizes all 3 (e = 2)\\n    # series B: fixed d = 5 at m = n/2, opt = 1 + 0.3 n, sizes all 5 (e = 2)\\n    # series C: like B but opt = 1 + 0.2 n (agrees with A)\\n    for n in (30, 40, 50):\\n        for i in range(4):\\n            rows.append((\\\"fixed\\\", \\\"n\\\", 3.0, n, n, 1 + 0.2 * n + (i % 2) * 0.0, 2 + 0.2 * n, f\\\"3:{n}\\\"))\\n            rows.append((\\\"fixed\\\", \\\"n/2\\\", 5.0, n, n // 2, 1 + 0.3 * n, 1 + 0.3 * n, f\\\"5:{n // 2}\\\"))\\n            rows.append((\\\"fixed\\\", \\\"2n\\\", 2.0, n, 2 * n, 1 + 0.2 * n, 1 + 0.2 * n, f\\\"2:{2 * n}\\\"))\\n    rule = _synthetic_rule(rows)\\n    slopes = series_slopes(rule, min_n=30, min_sizes=3)\\n    assert len(slopes) == 3 and slopes[\\\"constant e\\\"].all()\\n    by = {(r.r, r.param): r for r in slopes.itertuples()}\\n    assert by[(\\\"n\\\", 3.0)].b == pytest.approx(0.2) and by[(\\\"n/2\\\", 5.0)].b == pytest.approx(0.3)\\n    assert by[(\\\"n\\\", 3.0)].e == pytest.approx(2.0) and by[(\\\"n/2\\\", 5.0)].e == pytest.approx(2.0)\\n    assert by[(\\\"n\\\", 3.0)]._19 == pytest.approx(0.0)      # rule exact share: the rule is one above on series A\\n    pairs = matched_pairs(slopes, tol=0.05)\\n    assert len(pairs) == 3\\n    differ = {frozenset((p[\\\"series 1\\\"], p[\\\"series 2\\\"])): p[\\\"differ\\\"] for _, p in pairs.iterrows()}\\n    assert differ[frozenset((\\\"fixed r=n 3\\\", \\\"fixed r=n/2 5\\\"))] is True\\n    assert differ[frozenset((\\\"fixed r=n 3\\\", \\\"fixed r=2n 2\\\"))] is False\\n    groups = named_groups(slopes)\\n    assert set(groups[\\\"group\\\"]) == {\\\"e = 2\\\"} and len(groups) == 3\\n    assert not beta_residuals(slopes).empty or True        # no pair within 0.02 in beta* is a legitimate outcome\\n\\n\\ndef test_rule_by_bin_counts_every_certified_instance_once():\\n    rows = []\\n    for n in (30, 40):\\n        rows.append((\\\"fixed\\\", \\\"n\\\", 3.0, n, n, 10, 11, f\\\"3:{n}\\\"))\\n        rows.append((\\\"fixed\\\", \\\"n\\\", 8.0, n, n, 20, 20, f\\\"8:{n}\\\"))\\n    rule = _synthetic_rule(rows)\\n    bins = rule_by_bin(rule)\\n    assert bins[\\\"count\\\"].sum() == 4\\n    assert set(bins[\\\"e bin\\\"].astype(str)) == {\\\"[2, 2.4)\\\", \\\"[6, 10)\\\"}\\n    assert float(bins.loc[bins[\\\"e bin\\\"].astype(str) == \\\"[6, 10)\\\", \\\"exact\\\"].iloc[0]) == 1.0\\nEOF\\npython3 -m pytest tests/test_excess.py -q 2>&1 | tail -3\",\"description\":\"Patch the slopes stage and figure, add item-02 tests, run them\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":5601,\"cache_read_input_tokens\":161663,\"cache_creation\":{\"ephemeral_5m_input_tokens\":5601,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"171f3