from collections import deque\ndef fam(masks,k,start):\n  n=len(masks); full=(1<<n)-1; M=Model(masks,k)\n  seen={start}; dq=deque([start])\n  while dq:\n    T=dq.popleft()\n    for c in bits(full&~T):\n      if M.cost(T,c)<=k:\n        T2=T|1<<c\n        if T2 not in seen: seen.add(T2); dq.append(T2)\n  assert full not in seen\n  return \"{\"+\", \".join(\"{\"+\", \".join(map(str,bits(T)))+\"}\" for T in sorted(seen,key=lambda t:(bin(t).count('1'),t)))+\"}\"\ndef order(masks,k,T):\n  n=len(masks); full=(1<<n)-1; M=Model(masks,k); out=[]\n  while T!=full:\n    for c in bits(full&~T):\n      if M.cost(T,c)<=k and M.plain(T|1<<c): out.append(c); T|=1<<c; break\n  return out\ncex=DEFINITE_CEX[0][0]\nprint(fam(cex,6,1))\nA=[3375,1051,1165,15,18,289,704,1732,3361,704,3463,3329]\nprint(fam(A,4,1<<4)); print(order(A,4,(1<<6)|(1<<9)))\nB=[139,59,12,15,178,242,224,241]\nprint(order(B,4,0b1100))\nEOF\npython3 /tmp/fam.py"}},"wire_ingest_context":{"toolu_01Y544xcZXADQkPAeURkQXBY":{"cwd":"/home/al/dev/MOSP"}}}
