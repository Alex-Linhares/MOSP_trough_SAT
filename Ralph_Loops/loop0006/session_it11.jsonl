erOfLayout (τ : LinearLayout V) (i : Fin (Fintype.card V)) :\n502:variable (G)\n505:theorem orderCost_le_iff (k : ℕ) :\n510:  | nil => intro T; simp [orderCost]\n511:  | cons c l ih =>\n517:      | zero => simpa using h0\n518:      | succ j =>\n531:theorem orderCost_orderOfLayout_le_iff (τ : LinearLayout V) (k : ℕ) :\n548:theorem orderCost_ofFn_eq_outNarrowness (τ : LinearLayout V) :\n554:theorem orderCost_ofFn_eq_vertexSepOfLayout_add_one [Nonempty V] (τ : LinearLayout V) :\n562:theorem solvable_empty_iff_exists_outNarrowness_le (k : ℕ) :\n572:theorem solvable_empty_iff_narrowness_le (k : ℕ) :\n584:theorem searchSol_empty_iff_narrowness_le (k : ℕ) :\n588:theorem searchSol_empty_iff_vertexSeparation_add_one_le [Nonempty V] (k : ℕ) :\n593:theorem searchSol_empty_iff_pathwidth_add_one_le [Nonempty V] (k : ℕ) :\n600:theorem searchSol_mospGraph_iff_mospValue_le {C Pt : Type*} [Fintype C] [DecidableEq C]\n607:end Search\n609:end MOSPFormalization","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
