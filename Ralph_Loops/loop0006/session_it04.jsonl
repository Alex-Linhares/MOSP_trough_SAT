{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JGByjhy75BPrQ2wRY7auHP","type":"tool_result","content":"1\ttheorem PebbleStep.reflTransGen_mono {D : Digraph α} {K K' : ℕ} (hK : K ≤ K')\n2\t    {P Q : PebblePosition α} (h : Relation.ReflTransGen (PebbleStep D K) P Q) :\n3\t    Relation.ReflTransGen (PebbleStep D K') P Q := by\n4\t  induction h with\n5\t  | refl => exact .refl\n6\t  | tail _ hs ih =>\n7\t    obtain ⟨m, hm, hQ, hc⟩ := hs\n8\t    exact ih.tail ⟨m, hm, hQ, hc.trans hK⟩\n9\t\n10\ttheorem PebblesWithin.mono {D : Digraph α} {K K' : ℕ} (h : PebblesWithin D K) (hK : K ≤ K') :\n11\t    PebblesWithin D K' :=\n12\t  PebbleStep.reflTransGen_mono hK h\n13\t\n14\t/-- A play as a sequence of positions indexed by time. -/\n15\ttheorem exists_seq_of_reflTransGen {β : Type*} {r : β → β → Prop} {a b : β}\n16\t    (h : Relation.ReflTransGen r a b) :\n17\t    ∃ (T : ℕ) (P : ℕ → β), P 0 = a ∧ P T = b ∧ ∀ i < T, r (P i) (P (i + 1)) := by\n18\t  induction h with\n19\t  | refl => exact ⟨0, fun _ => a, rfl, rfl, fun i hi => absurd hi (Nat.not_lt_zero _)⟩\n20\t  | tail _ hbc ih =>\n21\t    obtain ⟨T, P, h0, hT, hs⟩ := ih\n22\t    rename_i b' c _\n23\t    refine ⟨T + 1, fun i => if i ≤ T then P i else c, by simp [h0], by simp, ?_⟩\n24\t    intro i hi\n25\t    by_cases hiT : i < T\n26\t    · simpa [hiT.le, Nat.succ_le_of_lt hiT] using hs i hiT\n27\t    · have : i = T := by omega\n28\t      subst this\n29\t      simpa [hT] using hbc\n30\t\n31\tend Game\n32\t\n33\t/-! ### What a play implies -/\n34\t\n35\tsection Plays\n36\t\n37\topen PebblePhase\n38\t\n39\tvariable {α : Type*} [Fintype α] [DecidableEq α] {D : Digraph α} {K : ℕ}\n40\t\n41\ttheorem PebbleStep.rank_le {P Q : PebblePosition α} (h : PebbleStep D K P Q) (x : α) :\n42\t    (P x).rank ≤ (Q x).rank := by\n43\t  obtain ⟨m, hm, rfl, -⟩ := h\n44\t  unfold PebbleMove.apply\n45\t  by_cases hx : x = m.target\n46\t  · subst hx\n47\t    rw [Function.update_self]\n48\t    cases m <;> simp_all [PebbleMove.Legal, PebbleMove.result, PebbleMove.target]\n49\t  · rw [Function.update_of_ne hx]\n50\t\n51\t/-- The only move that takes a vertex from unturned to turned is its turn, and it needs\n52\tevery immediate predecessor pebbled. -/\n53\ttheorem PebbleStep.of_turned {P Q : PebblePosition α} (h : PebbleStep D K P Q) {x : α}\n54\t    (hP : (P x).rank ≤ 1) (hQ : 2 ≤ (Q x).rank) :\n55\t    P x = white ∧ ∀ y, D.Adj y x → (P y).Pebbled := by\n56\t  obtain ⟨m, hm, rfl, -⟩ := h\n57\t  unfold PebbleMove.apply at hQ\n58\t  by_cases hx : x = m.target\n59\t  · subst hx\n60\t    rw [Function.update_self] at hQ\n61\t    cases m with\n62\t    | place y => simp [PebbleMove.result] at hQ\n63\t    | turn y => exact hm\n64\t    | remove y =>\n65\t      simp only [PebbleMove.Legal] at hm\n66\t      simp [PebbleMove.target, hm] at hP\n67\t  · rw [Function.update_of_ne hx] at hQ; omega\n68\t\n69\ttheorem PebbleStep.numPebbles_le {P Q : PebblePosition α} (h : PebbleStep D K P Q) :\n70\t    numPebbles Q ≤ K := by\n71\t  obtain ⟨_, _, rfl, hc⟩ := h; exact hc\n72\t\n73\tvariable {T : ℕ} {P : ℕ → PebblePosition α}\n74\t\n75\ttheorem seq_rank_mono (hs : ∀ i < T, PebbleStep D K (P i) (P (i + 1))) {i j : ℕ}\n76\t    (hij : i ≤ j) (hj : j ≤ T) (x : α) : (P i x).rank ≤ (P j x).rank := by\n77\t  induction j, hij using Nat.le_induction with\n78\t  | base => exact le_rfl\n79\t  | succ j _ ih => exact (ih (by omega)).trans ((hs j (by omega)).rank_le x)\n80\t\n81\t/-- Every vertex that ends turned was turned at some time `i < T`, with its immediate\n82\tpredecessors pebbled at that time. -/\n83\ttheorem seq_exists_turn (hs : ∀ i < T, PebbleStep D K (P i) (P (i + 1))) {x : α}\n84\t    (h0 : (P 0 x).rank ≤ 1) (hT : 2 ≤ (P T x).rank) :\n85\t    ∃ i < T, (P i x).rank ≤ 1 ∧ P i x = white ∧ ∀ y, D.Adj y x → (P i y).Pebbled := by\n86\t  classical\n87\t  have hex : ∃ j, j ≤ T ∧ 2 ≤ (P j x).rank := ⟨T, le_rfl, hT⟩\n88\t  have hjT : Nat.find hex ≤ T := (Nat.find_spec hex).1\n89\t  have hj2 : 2 ≤ (P (Nat.find hex) x).rank := (Nat.find_spec hex).2\n90\t  have hj0 : Nat.find hex ≠ 0 := by intro h; rw [h] at hj2; omega\n91\t  obtain ⟨i, hi1⟩ : ∃ i, Nat.find hex = i + 1 := ⟨Nat.find hex - 1, by omega⟩\n92\t  have hi : (P i x).rank ≤ 1 := by\n93\t    by_contra hc\n94\t    exact Nat.find_min hex (show i < Nat.find hex by omega) ⟨by omega, by omega⟩\n95\t  rw [hi1] at hj2\n96\t  exact ⟨i, by omega, hi, (hs i (by omega)).of_turned hi hj2⟩\n97\t\n98\ttheorem seq_numPebbles_le (hs : ∀ i < T, PebbleStep D K (P i) (P (i + 1)))\n99\t    (h0 : P 0 = fun _ => fresh) {i : ℕ} (hi : i ≤ T) : numPebbles (P i) ≤ K := by\n100\t  rcases i with _ | i\n101\t  · rw [h0]; simp [numPebbles, Pebbled]\n102\t  · exact (hs i (by omega)).numPebbles_le\n103\t\n104\tend Plays\n105\t\n106\t/-! ### Lengauer's `G_d` -/\n107\t\n108\tsection Gd\n109\t\n110\tvariable {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n111\t\n112\t/-- Lengauer's `G_d` (Def. 1b, p. 469): `V_d = V ∪ E`, with arcs `v → {v, w}` and\n113\t`w → {v, w}` for every edge `{v, w}`; the edges of `G` themselves are discarded. -/\n114\tdef lengauerD : Digraph (V ⊕ G.edgeSet) where\n115\t  Adj a b := match a, b with\n116\t    | .inl v, .inr e => v ∈ (e : Sym2 V)\n117\t    | _, _ => False\n118\t\n119\tvariable {G}\n120\t\n121\t@[simp] theorem lengauerD_adj_inl_inr {v : V} {e : G.edgeSet} :\n122\t    (lengauerD G).Adj (.inl v) (.inr e) ↔ v ∈ (e : Sym2 V) := Iff.rfl\n123\t\n124\t@[simp] theorem lengauerD_not_adj_to_inl {a : V ⊕ G.edgeSet} {v : V} :\n125\t    ¬ (lengauerD G).Adj a (.inl v) := by\n126\t  rcases a with u | e <;> exact id\n127\t\n128\t@[simp] theorem lengauerD_not_adj_from_inr {e : G.edgeSet} {b : V ⊕ G.edgeSet} :\n129\t    ¬ (lengauerD G).Adj (.inr e) b := by\n130\t  rcases b with u | f <;> exact id\n131\t\n132\tvariable (G)\n133\t\n134\t/-- `G_d` is a dag of depth one: it has no directed path of length two, hence no cycle. -/\n135\ttheorem lengauerD_no_path_two (a b c : V ⊕ G.edgeSet) :\n136\t    ¬ ((lengauerD G).Adj a b ∧ (lengauerD G).Adj b c) := by\n137\t  rintro ⟨hab, hbc⟩\n138\t  rcases b with v | e\n139\t  · exact lengauerD_not_adj_to_inl hab\n140\t  · exact lengauerD_not_adj_from_inr hbc\n141\t\n142\tend Gd\n143\t\n144\t/-! ### The layout a play induces -/\n145\t\n146\tsection Lower\n147\t\n148\topen PebblePhase\n149\t\n150\tvariable {V : Type*} [Fintype V] [DecidableEq V] {G : SimpleGraph V} [DecidableRel G.Adj]\n151\t\n152\t/-- The vertices outside `S` with a neighbour in `S`: the active suffix of a layout whose\n153\tprefix is `S`. -/\n154\tdef outerBoundary (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) : Finset V :=\n155\t  univ.filter fun w => w ∉ S ∧ ∃ u ∈ S, G.Adj u w\n156\t\n157\ttheorem mem_outerBoundary {S : Finset V} {w : V} :\n158\t    w ∈ outerBoundary G S ↔ w ∉ S ∧ ∃ u ∈ S, G.Adj u w := by\n159\t  simp [outerBoundary]\n160\t\n161\ttheorem PebbleStep.eq_target {α : Type*} [Fintype α] [DecidableEq α] {D : Digraph α} {K : ℕ}\n162\t    {P Q : PebblePosition α} (h : PebbleStep D K P Q) {x y : α} (hx : P x ≠ Q x)\n163\t    (hy : P y ≠ Q y) : x = y := by\n164\t  obtain ⟨m, -, rfl, -⟩ := h\n165\t  unfold PebbleMove.apply at hx hy\n166\t  have h1 : x = m.target := by\n167\t    by_contra h; exact hx (Function.update_of_ne h _ _).symm\n168\t  have h2 : y = m.target := by\n169\t    by_contra h; exact hy (Function.update_of_ne h _ _).symm\n170\t  rw [h1, h2]\n171\t\n172\tvariable {K T : ℕ} {P : ℕ → PebblePosition (V ⊕ G.edgeSet)}\n173\t\n174\t/-- The heart of Theorem 3 (⇒). Let `S` be the vertices of `G` cleared by time `t`. Take the\n175\tedge between `S` and the rest that is turned last; when it turns, it, its endpoint in `S`,\n176\tand every vertex of the outer boundary of `S` carry pebbles. -/\n177\ttheorem outerBoundary_card_le\n178\t    (hs : ∀ i < T, PebbleStep (lengauerD G) (K + 2) (P i) (P (i + 1)))\n179\t    (h0 : P 0 = fun _ => fresh) (hT : P T = fun _ => done)\n180\t    (hc : ∀ i ≤ T, numPebbles (P i) ≤ K + 2) {t : ℕ} (ht : t ≤ T) :\n181\t    (outerBoundary G (univ.filter fun v => P t (.inl v) = done)).card ≤ K := by\n182\t  classical\n183\t  set S := univ.filter fun v => P t (.inl v) = done with hS\n184\t  set B := outerBoundary G S with hB\n185\t  rcases B.eq_empty_or_nonempty with hBe | ⟨b₀, hb₀⟩\n186\t  · rw [hBe]; exact Nat.zero_le _\n187\t  -- turn times of all edge vertices\n188\t  have hturn : ∀ e : G.edgeSet, ∃ i < T, (P i (.inr e)).rank ≤ 1 ∧ P i (.inr e) = white ∧\n189\t      ∀ y, (lengauerD G).Adj y (.inr e) → (P i y).Pebbled := fun e =>\n190\t    seq_exists_turn hs (by rw [h0]; simp) (by rw [hT]; simp)\n191\t  choose τ hτT hτ1 hτw hτp using hturn\n192\t  have hmono := fun {i j} (hij : i ≤ j) (hj : j ≤ T) x => seq_rank_mono hs (P := P) hij hj x\n193\t  -- the cut edges\n194\t  set C : Finset G.edgeSet := univ.filter fun e => ∃ a ∈ S, ∃ b ∉ S, (e : Sym2 V) = s(a, b)\n195\t  obtain ⟨u₀, hu₀S, hu₀⟩ := (mem_outerBoundary.mp hb₀).2\n196\t  have hC : C.Nonempty := ⟨⟨s(u₀, b₀), hu₀⟩, by\n197\t    simp only [C, mem_filter, mem_univ, true_and]\n198\t    exact ⟨u₀, hu₀S, b₀, (mem_outerBoundary.mp hb₀).1, rfl⟩⟩\n199\t  obtain ⟨e, heC, hemax⟩ := C.exists_max_image τ hC\n200\t  obtain ⟨a, haS, b, hbS, hab⟩ := by simpa [C] using heC\n201\t  have hapeb : (P (τ e) (.inl a)).Pebbled :=\n202\t    hτp e _ (by simp [hab])\n203\t  have haS' : P t (.inl a) = done := by simpa [S] using haS\n204\t  -- the last turn happens before `t`\n205\t  have hτt : τ e < t := by\n206\t    by_contra hle\n207\t    have := hmono (not_lt.mp hle) (hτT e).le (.inl a)\n208\t    rw [haS'] at this\n209\t    have := (pebbled_iff_rank _).mp hapeb\n210\t    simp at *; omega\n211\t  -- every boundary vertex is pebbled at the last turn\n212\t  have hBpeb : ∀ w ∈ B, (P (τ e) (.inl w)).Pebbled := by\n213\t    intro w hw\n214\t    obtain ⟨hwS, u, huS, huw⟩ := mem_outerBoundary.mp hw\n215\t    set e' : G.edgeSet := ⟨s(u, w), huw⟩\n216\t    have he'C : e' ∈ C := by\n217\t      simp only [C, mem_filter, mem_univ, true_and]; exact ⟨u, huS, w, hwS, rfl⟩\n218\t    have hle := hemax e' he'C\n219\t    have h1 := (pebbled_iff_rank _).mp (hτp e' (.inl w) (by simp [e']))\n220\t    have h2 := hmono hle (hτT e).le (.inl w)\n221\t    have h3 := hmono hτt.le ht (.inl w)\n222\t    have h4 : (P t (.inl w)).rank ≠ 3 := by\n223\t      rw [Ne, ← eq_done_iff_rank]; simpa [S] using hwS\n224\t    have h5 := rank_le_three (P t (.inl w))\n225\t    rw [pebbled_iff_rank]; omega\n226\t  have hsub : insert (.inr e) (insert (.inl a) (B.map Embedding.inl)) ⊆\n227\t      univ.filter fun x => (P (τ e) x).Pebbled := by\n228\t    intro x hx\n229\t    simp only [mem_insert, mem_map, Embedding.inl_apply] at hx\n230\t    simp only [mem_filter, mem_univ, true_and]\n231\t    rcases hx with rfl | rfl | ⟨w, hw, rfl⟩\n232\t    · rw [hτw e]; exact Or.inl rfl\n233\t    · exact hapeb\n234\t    · exact hBpeb w hw\n235\t  have hcard := card_le_card hsub\n236\t  rw [card_insert_of_notMem (by simp), card_insert_of_notMem (by\n237\t    simp only [mem_map, Embedding.inl_apply, Sum.inl.injEq, not_exists, not_and]\n238\t    rintro w hw rfl; exact (mem_outerBoundary.mp hw).1 haS), card_map] at hcard\n239\t  have := hc (τ e) (hτT e).le\n240\t  unfold numPebbles at this\n241\t  omega\n242\t\n243\t/-- A layout listing the vertices in increasing order of an injective key. -/\n244\ttheorem exists_layout_of_injective {r : V → ℕ} (hr : Injective r) :\n245\t    ∃ σ : LinearLayout V, ∀ u v, σ u ≤ σ v ↔ r u ≤ r v := by\n246\t  classical\n247\t  set s := univ.image r\n248\t  have hs : s.card = Fintype.card V := by rw [card_image_of_injective _ hr, card_univ]\n249\t  set e := s.orderIsoOfFin hs\n250\t  let f : V → Fin (Fintype.card V) := fun v => e.symm ⟨r v, mem_image_of_mem r (mem_univ v)⟩\n251\t  have hf : Injective f := by\n252\t    intro u v h\n253\t    have := congrArg Subtype.val (e.symm.injective h)\n254\t    exact hr this\n255\t  have hbij : Bijective f := (Fintype.bijective_iff_injective_and_card f).mpr ⟨hf, by simp⟩\n256\t  refine ⟨Equiv.ofBijective f hbij, fun u v => ?_⟩\n257\t  simp only [Equiv.ofBijective_apply, f, OrderIso.le_iff_le, Subtype.mk_le_mk]\n258\t\n259\t/-- **Theorem 3 (⇒)**: if `G_d` can be pebbled progressively with `K + 2` pebbles, then\n260\t`vs(G) ≤ K`. The layout lists the vertices of `G` in the order they lose their pebble. -/\n261\ttheorem vertexSeparation_le_of_pebblesWithin (h : PebblesWithin (lengauerD G) (K + 2)) :\n262\t    vertexSeparation G ≤ K := by\n263\t  classical\n264\t  obtain ⟨T, P, h0, hT, hs⟩ := exists_seq_of_reflTransGen h\n265\t  have hc : ∀ i ≤ T, numPebbles (P i) ≤ K + 2 := by\n266\t    intro i hi\n267\t    rcases i with _ | i\n268\t    · rw [h0]; simp [numPebbles, Pebbled]\n269\t    · exact (hs i (by omega)).numPebbles_le\n270\t  have hmono := fun {i j} (hij : i ≤ j) (hj : j ≤ T) x => seq_rank_mono hs (P := P) hij hj x\n271\t  have hex : ∀ v : V, ∃ t, P t (.inl v) = done := fun v => ⟨T, by rw [hT]⟩\n272\t  let r : V → ℕ := fun v => Nat.find (hex v)\n273\t  have hrT : ∀ v, r v ≤ T := fun v => Nat.find_min' (hex v) (by rw [hT])\n274\t  have hdone : ∀ v t, t ≤ T → (P t (.inl v) = done ↔ r v ≤ t) := by\n275\t    intro v t ht\n276\t    constructor\n277\t    · exact fun h => Nat.find_min' (hex v) h\n278\t    · intro hle\n279\t      have h1 := hmono hle ht (.inl v)\n280\t      have h2 : P (r v) (.inl v) = done := Nat.find_spec (hex v)\n281\t      rw [h2] at h1\n282\t      rw [eq_done_iff_rank]\n283\t      have := rank_le_three (P t (.inl v)); simp at h1; omega\n284\t  have hr : Injective r := by\n285\t    intro u v huv\n286\t    have hu : P (r u) (.inl u) = done := Nat.find_spec (hex u)\n287\t    have hv : P (r v) (.inl v) = done := Nat.find_spec (hex v)\n288\t    have hpos : r u ≠ 0 := by\n289\t      intro h; rw [h, h0] at hu; exact PebblePhase.noConfusion hu\n290\t    obtain ⟨i, hi⟩ : ∃ i, r u = i + 1 := ⟨r u - 1, by omega⟩\n291\t    have hu' : P i (.inl u) ≠ done := fun h =>\n292\t      Nat.find_min (hex u) (show i < r u by omega) h\n293\t    have hv' : P i (.inl v) ≠ done := fun h =>\n294\t      Nat.find_min (hex v) (show i < r v by omega) h\n295\t    rw [hi] at hu; rw [← huv, hi] at hv\n296\t    have := (hs i (by have := hrT u; omega)).eq_target (x := .inl u) (y := .inl v)\n297\t      (by rw [hu]; exact hu') (by rw [hv]; exact hv')\n298\t    exact Sum.inl_injective this\n299\t  obtain ⟨σ, hσ⟩ := exists_layout_of_injective hr\n300\t  refine (vertexSeparation_le_vertexSepOfLayout G σ).trans ?_\n301\t  rw [vertexSepOfLayout_le_iff]\n302\t  intro i hi\n303\t  set v := σ.symm ⟨i, hi⟩\n304\t  have hkey : activeSuffix G σ i = outerBoundary G (univ.filter fun u => P (r v) (.inl u) = done) := by\n305\t    have hpre : ∀ u, (σ u).val ≤ i ↔ P (r v) (.inl u) = done := by\n306\t      intro u\n307\t      rw [hdone u _ (hrT v), ← hσ]\n308\t      simp [v, Fin.le_def]\n309\t    ext w\n310\t    simp only [mem_activeSuffix_iff, mem_outerBoundary, mem_prefixSet_iff, mem_filter,\n311\t      mem_univ, true_and, hpre, gt_iff_lt, ← not_le]\n312\t  unfold vertexSepAt\n313\t  rw [hkey]\n314\t  exact outerBoundary_card_le hs h0 hT hc (hrT v)\n315\t\n316\t/-- With an edge `{a, b}`, `G_d` needs three pebbles: when `{a, b}` turns black, `a` and `b`\n317\tcarry pebbles too. -/\n318\ttheorem three_le_of_pebblesWithin {a b : V} (hab : G.Adj a b)\n319\t    (h : PebblesWithin (lengauerD G) K) : 3 ≤ K := by\n320\t  classical\n321\t  obtain ⟨T, P, h0, hT, hs⟩ := exists_seq_of_reflTransGen h\n322\t  set e : G.edgeSet := ⟨s(a, b), hab⟩\n323\t  obtain ⟨i, hiT, -, hw, hp⟩ := seq_exists_turn hs (x := .inr e) (by rw [h0]; simp)\n324\t    (by rw [hT]; simp)\n325\t  have hsub : ({.inr e, .inl a, .inl b} : Finset (V ⊕ G.edgeSet)) ⊆\n326\t      univ.filter fun x => (P i x).Pebbled := by\n327\t    intro x hx\n328\t    simp only [mem_insert, mem_singleton] at hx\n329\t    simp only [mem_filter, mem_univ, true_and]\n330\t    rcases hx with rfl | rfl | rfl\n331\t    · rw [hw]; exact Or.inl rfl\n332\t    · exact hp _ (by simp [e])\n333\t    · exact hp _ (by simp [e])\n334\t  have hcard := card_le_card hsub\n335\t  rw [card_insert_of_notMem (by simp), card_insert_of_notMem (by simp [hab.ne]),\n336\t    card_singleton] at hcard\n337\t  exact hcard.trans (seq_numPebbles_le hs h0 hiT.le)\n338\t\n339\t/-- With a vertex, one pebble is needed. -/\n340\ttheorem one_le_of_pebblesWithin (v : V) (h : PebblesWithin (lengauerD G) K) : 1 ≤ K := by\n341\t  classical\n342\t  obtain ⟨T, P, h0, hT, hs⟩ := exists_seq_of_reflTransGen h\n343\t  obtain ⟨i, hiT, -, hw, -⟩ := seq_exists_turn hs (x := .inl v) (by rw [h0]; simp)\n344\t    (by rw [hT]; simp)\n345\t  have hsub : ({.inl v} : Finset (V ⊕ G.edgeSet)) ⊆ univ.filter fun x => (P i x).Pebbled := by\n346\t    intro x hx\n347\t    rw [mem_singleton] at hx; subst hx\n348\t    simp only [mem_filter, mem_univ, true_and]; rw [hw]; exact Or.inl rfl\n349\t  have hcard := card_le_card hsub\n350\t  rw [card_singleton] at hcard\n351\t  exact hcard.trans (seq_numPebbles_le hs h0 hiT.le)\n352\t\n353\tend Lower\n354\t\n355\t/-! ### The strategy a layout induces -/\n356\t\n357\tsection Upper\n358\t\n359\topen PebblePhase\n360\t\n361\tvariable {V : Type*} [Fintype V] [DecidableEq V] {G : SimpleGraph V} [DecidableRel G.Adj]\n362\tvariable {K : ℕ}\n363\t\n364\tlocal notation \"Reach\" => Relation.ReflTransGen (PebbleStep (lengauerD G) K)\n365\t\n366\ttheorem numPebbles_le_of_subset {α : Type*} [Fintype α] [DecidableEq α] {P : PebblePosition α}\n367\t    {Y : Finset α} (h : ∀ x, (P x).Pebbled → x ∈ Y) : numPebbles P ≤ Y.card :=\n368\t  card_le_card fun x hx => h x (by simpa using hx)\n369\t\n370\ttheorem reach_move {P : PebblePosition (V ⊕ G.edgeSet)} (m : PebbleMove (V ⊕ G.edgeSet))\n371\t    (hm : m.Legal (lengauerD G) P) (hc : numPebbles (m.apply P) ≤ K) :\n372\t    Reach P (m.apply P) :=\n373\t  Relation.ReflTransGen.single ⟨m, hm, rfl, hc⟩\n374\t\n375\tvariable (G) in\n376\t/-- The positions the strategy passes through: `S` the cleared vertices of `G`, `B` the\n377\tblack ones, `F` the cleared edge vertices; everything else is pebble-free. -/\n378\tdef buildPos (S B : Finset V) (F : Finset G.edgeSet) : PebblePosition (V ⊕ G.edgeSet)\n379\t  | .inl w => if w ∈ S then done else if w ∈ B then black else fresh\n380\t  | .inr e => if e ∈ F then done else fresh\n381\t\n382\ttheorem buildPos_pebbled {S B : Finset V} {F : Finset G.edgeSet} {x : V ⊕ G.edgeSet}\n383\t    (h : (buildPos G S B F x).Pebbled) : x ∈ B.map Embedding.inl := by\n384\t  rcases x with w | e\n385\t  · simp only [buildPos] at h\n386\t    split_ifs at h with h1 h2 <;> simp_all [Pebbled]\n387\t  · simp only [buildPos] at h\n388\t    split_ifs at h <;> simp [Pebbled] at h\n389\t\n390\ttheorem numPebbles_buildPos_le (S B : Finset V) (F : Finset G.edgeSet) :\n391\t    numPebbles (buildPos G S B F) ≤ B.card := by\n392\t  have := numPebbles_le_of_subset (fun x h => buildPos_pebbled (S := S) (B := B) (F := F) h)\n393\t  rwa [card_map] at this\n394\t\n395\t/-- Blacken one pebble-free vertex of `G`: place a white pebble and turn it (a source). -/\n396\ttheorem reach_raise {S B : Finset V} {F : Finset G.edgeSet} {x : V} (hxS : x ∉ S) (hxB : x ∉ B)\n397\t    (hK : (insert x B).card ≤ K) :\n398\t    Reach (buildPos G S B F) (buildPos G S (insert x B) F) := by\n399\t  set P₀ := buildPos G S B F\n400\t  have h1 : Reach P₀ ((PebbleMove.place (Sum.inl x)).apply P₀) := by\n401\t    refine reach_move _ (by simp [PebbleMove.Legal, P₀, buildPos, hxS, hxB]) ?_\n402\t    refine (numPebbles_le_of_subset (Y := (insert x B).map Embedding.inl) ?_).trans\n403\t      (by rwa [card_map])\n404\t    intro y hy\n405\t    by_cases hyx : y = .inl x\n406\t    · subst hyx; simp\n407\t    · rw [PebbleMove.apply, PebbleMove.target, Function.update_of_ne hyx] at hy\n408\t      exact map_subset_map.mpr (subset_insert _ _) (buildPos_pebbled hy)\n409\t  refine h1.trans ?_\n410\t  set P₁ := (PebbleMove.place (Sum.inl x)).apply P₀\n411\t  have heq : (PebbleMove.turn (Sum.inl x)).apply P₁ = buildPos G S (insert x B) F := by\n412\t    funext y\n413\t    rcases y with w | e\n414\t    · by_cases hw : w = x\n415\t      · subst hw\n416\t        simp [PebbleMove.apply, PebbleMove.target, PebbleMove.result, buildPos, hxS]\n417\t      · simp [PebbleMove.apply, PebbleMove.target, P₁, P₀, buildPos, hw]\n418\t    · simp [PebbleMove.apply, PebbleMove.target, P₁, P₀, buildPos]\n419\t  rw [← heq]\n420\t  refine reach_move _ ⟨by simp [P₁, PebbleMove.apply, PebbleMove.target, PebbleMove.result],\n421\t    fun y hy => absurd hy lengauerD_not_adj_to_inl⟩ ?_\n422\t  rw [heq]; exact (numPebbles_buildPos_le _ _ _).trans hK\n423\t\n424\t/-- Clear one edge vertex whose endpoints are black: place, turn, remove. -/\n425\ttheorem reach_edge {S B : Finset V} {F : Finset G.edgeSet} {e : G.edgeSet} (heF : e ∉ F)\n426\t    (hends : ∀ u ∈ (e : Sym2 V), u ∈ B ∧ u ∉ S) (hK : B.card + 1 ≤ K) :\n427\t    Reach (buildPos G S B F) (buildPos G S B (insert e F)) := by\n428\t  set P₀ := buildPos G S B F\n429\t  have hcnt : ∀ P : PebblePosition (V ⊕ G.edgeSet), (∀ y, y ≠ .inr e → P y = P₀ y) →\n430\t      numPebbles P ≤ K := by\n431\t    intro P hP\n432\t    refine (numPebbles_le_of_subset (Y := insert (.inr e) (B.map Embedding.inl)) ?_).trans\n433\t      ((card_insert_le _ _).trans (by rwa [card_map]))\n434\t    intro y hy\n435\t    by_cases hye : y = .inr e\n436\t    · subst hye; simp\n437\t    · rw [hP y hye] at hy; exact mem_insert_of_mem (buildPos_pebbled hy)\n438\t  set P₁ := (PebbleMove.place (Sum.inr e)).apply P₀\n439\t  set P₂ := (PebbleMove.turn (Sum.inr e)).apply P₁\n440\t  have hP₁ : ∀ y, y ≠ .inr e → P₁ y = P₀ y := fun y hy => by\n441\t    simp [P₁, PebbleMove.apply, PebbleMove.target, Function.update_of_ne hy]\n442\t  have hP₂ : ∀ y, y ≠ .inr e → P₂ y = P₀ y := fun y hy => by\n443\t    simp [P₂, PebbleMove.apply, PebbleMove.target, Function.update_of_ne hy, hP₁ y hy]\n444\t  have h1 : Reach P₀ P₁ :=\n445\t    reach_move _ (by simp [PebbleMove.Legal, P₀, buildPos, heF]) (hcnt _ hP₁)\n446\t  have h2 : Reach P₁ P₂ := by\n447\t    refine reach_move _ ⟨by simp [P₁, PebbleMove.apply, PebbleMove.target,\n448\t      PebbleMove.result], ?_⟩ (hcnt _ hP₂)\n449\t    intro y hy\n450\t    rcases y with u | f\n451\t    · have hu := hends u hy\n452\t      rw [hP₁ _ (by simp)]\n453\t      simp [P₀, buildPos, hu.1, hu.2, Pebbled]\n454\t    · exact absurd hy lengauerD_not_adj_from_inr\n455\t  have heq : (PebbleMove.remove (Sum.inr e)).apply P₂ = buildPos G S B (insert e F) := by\n456\t    funext y\n457\t    by_cases hye : y = .inr e\n458\t    · subst hye; simp [PebbleMove.apply, PebbleMove.target, PebbleMove.result, buildPos]\n459\t    · rw [PebbleMove.apply, PebbleMove.target, Function.update_of_ne hye, hP₂ y hye]\n460\t      rcases y with w | f\n461\t      · simp [P₀, buildPos]\n462\t      · have : f ≠ e := fun h => hye (by rw [h])\n463\t        simp [P₀, buildPos, this]\n464\t  have h3 : Reach P₂ (buildPos G S B (insert e F)) := by\n465\t    rw [← heq]\n466\t    refine reach_move _ (by simp [P₂, PebbleMove.Legal, PebbleMove.apply, PebbleMove.target,\n467\t      PebbleMove.result]) ?_\n468\t    rw [heq]; exact (numPebbles_buildPos_le _ _ _).trans (by omega)\n469\t  exact h1.trans (h2.trans h3)\n470\t\n471\t/-- Remove the black pebble from a vertex of `G`. -/\n472\ttheorem reach_clear {S B : Finset V} {F : Finset G.edgeSet} {x : V} (hxS : x ∉ S) (hxB : x ∈ B)\n473\t    (hK : B.card ≤ K) :\n474\t    Reach (buildPos G S B F) (buildPos G (insert x S) B F) := by\n475\t  have heq : (PebbleMove.remove (Sum.inl x)).apply (buildPos G S B F) =\n476\t      buildPos G (insert x S) B F := by\n477\t    funext y\n478\t    rcases y with w | e\n479\t    · by_cases hw : w = x\n480\t      · subst hw; simp [PebbleMove.apply, PebbleMove.target, PebbleMove.result, buildPos]\n481\t      · simp [PebbleMove.apply, PebbleMove.target, buildPos, hw]\n482\t    · simp [PebbleMove.apply, PebbleMove.target, buildPos]\n483\t  rw [← heq]\n484\t  refine reach_move _ (by simp [PebbleMove.Legal, buildPos, hxS, hxB]) ?_\n485\t  rw [heq]; exact (numPebbles_buildPos_le _ _ _).trans hK\n486\t\n487\ttheorem reach_raise_set {S B : Finset V} {F : Finset G.edgeSet} (X : Finset V)\n488\t    (hXS : Disjoint X S) (hXB : Disjoint X B) (hK : (B ∪ X).card ≤ K) :\n489\t    Reach (buildPos G S B F) (buildPos G S (B ∪ X) F) := by\n490\t  induction X using Finset.induction_on with\n491\t  | empty => simp; exact .refl\n492\t  | insert x X hx ih =>\n493\t    have hxS : x ∉ S := disjoint_left.mp hXS (mem_insert_self _ _)\n494\t    have hxB : x ∉ B := disjoint_left.mp hXB (mem_insert_self _ _)\n495\t    have hsub : (B ∪ X).card ≤ (B ∪ insert x X).card :=\n496\t      card_le_card (union_subset_union le_rfl (subset_insert _ _))\n497\t    refine (ih (disjoint_of_subset_left (subset_insert _ _) hXS)\n498\t      (disjoint_of_subset_left (subset_insert _ _) hXB) (hsub.trans hK)).trans ?_\n499\t    rw [union_insert]\n500\t    exact reach_raise hxS (by simp [hxB, hx]) (by rwa [← union_insert])\n501\t\n502\ttheorem reach_edge_set {S B : Finset V} {F : Finset G.edgeSet} (Y : Finset G.edgeSet)\n503\t    (hYF : Disjoint Y F) (hends : ∀ e ∈ Y, ∀ u ∈ (e : Sym2 V), u ∈ B ∧ u ∉ S)\n504\t    (hK : Y.Nonempty → B.card + 1 ≤ K) :\n505\t    Reach (buildPos G S B F) (buildPos G S B (F ∪ Y)) := by\n506\t  induction Y using Finset.induction_on with\n507\t  | empty => simp; exact .refl\n508\t  | insert e Y he ih =>\n509\t    refine (ih (disjoint_of_subset_left (subset_insert _ _) hYF)\n510\t      (fun f hf => hends f (mem_insert_of_mem hf))\n511\t      (fun _ => hK (insert_nonempty _ _))).trans ?_\n512\t    rw [union_insert]\n513\t    exact reach_edge (by simp [disjoint_left.mp hYF (mem_insert_self _ _), he])\n514\t      (hends e (mem_insert_self _ _)) (hK (insert_nonempty _ _))\n515\t\n516\tvariable (G) in\n517\t/-- The edges with an endpoint in `S`. -/\n518\tdef clearedEdges (S : Finset V) : Finset G.edgeSet :=\n519\t  univ.filter fun e => ∃ u ∈ S, u ∈ (e : Sym2 V)\n520\t\n521\tvariable (G) in\n522\t/-- The position after the strategy has cleared the vertices `S`: their outer boundary is\n523\tblack, the edges at `S` are cleared, everything else is pebble-free. -/\n524\tdef layoutPos (S : Finset V) : PebblePosition (V ⊕ G.edgeSet) :=\n525\t  buildPos G S (outerBoundary G S) (clearedEdges G S)\n526\t\n527\t/-- One step of the strategy: clear `v`. Blacken the pebble-free vertices of `N[v]`, clear\n528\tevery edge at `v` not yet cleared, then remove `v`. At most the new boundary, `v`, and one\n529\tedge vertex are pebbled at any instant. -/\n530\ttheorem reach_layoutPos_insert {S : Finset V} {v : V} (hv : v ∉ S)\n531\t    (hK1 : (outerBoundary G (insert v S)).card + 1 ≤ K)\n532\t    (hK2 : (∃ w, G.Adj v w) → (outerBoundary G (insert v S)).card + 2 ≤ K) :\n533\t    Reach (layoutPos G S) (layoutPos G (insert v S)) := by\n534\t  classical\n535\t  set A := outerBoundary G S\n536\t  set A' := outerBoundary G (insert v S)\n537\t  set X := univ.filter fun w => (w = v ∨ G.Adj v w) ∧ w ∉ S ∧ w ∉ A\n538\t  set B₁ := A ∪ X\n539\t  have hB₁ : B₁ ⊆ insert v A' := by\n540\t    intro w hw\n541\t    rcases mem_union.mp hw with hw | hw\n542\t    · obtain ⟨hwS, u, huS, huw⟩ := mem_outerBoundary.mp hw\n543\t      by_cases hwv : w = v\n544\t      · simp [hwv]\n545\t      · exact mem_insert_of_mem (mem_outerBoundary.mpr\n546\t          ⟨by simp [hwv, hwS], u, mem_insert_of_mem huS, huw⟩)\n547\t    · simp only [X, mem_filter, mem_univ, true_and] at hw\n548\t      obtain ⟨hvw | hvw, hwS, -⟩ := hw\n549\t      · simp [hvw]\n550\t      · exact mem_insert_of_mem (mem_outerBoundary.mpr\n551\t          ⟨by simp [hvw.ne.symm, hwS], v, mem_insert_self _ _, hvw⟩)\n552\t  have hcard : B₁.card ≤ A'.card + 1 :=\n553\t    (card_le_card hB₁).trans (card_insert_le _ _)\n554\t  have hvB : v ∈ B₁ := by\n555\t    by_cases hvA : v ∈ A\n556\t    · exact mem_union_left _ hvA\n557\t    · exact mem_union_right _ (by simp [X, hv, hvA])\n558\t  set Y := univ.filter fun e : G.edgeSet => v ∈ (e : Sym2 V) ∧ e ∉ clearedEdges G S\n559\t  have h1 : Reach (layoutPos G S) (buildPos G S B₁ (clearedEdges G S)) :=\n560\t    reach_raise_set X (by rw [disjoint_left]; intro w hw; simp [X] at hw; exact hw.2.1)\n561\t      (by rw [disjoint_left]; intro w hw; simp [X] at hw; exact hw.2.2)\n562\t      (by have : B₁.card ≤ K := by omega\n563\t          exact this)\n564\t  have h2 : Reach (buildPos G S B₁ (clearedEdges G S))\n565\t      (buildPos G S B₁ (clearedEdges G S ∪ Y)) := by\n566\t    refine reach_edge_set Y (by rw [disjoint_left]; intro e he; simp [Y] at he; exact he.2)\n567\t      ?_ ?_\n568\t    · intro e he u hu\n569\t      simp only [Y, mem_filter, mem_univ, true_and] at he\n570\t      obtain ⟨hve, heF⟩ := he\n571\t      have huS : u ∉ S := fun huS => heF (by simp [clearedEdges]; exact ⟨u, huS, hu⟩)\n572\t      refine ⟨?_, huS⟩\n573\t      obtain ⟨w, hw⟩ := Sym2.mem_iff_exists.mp hve\n574\t      have hvw : G.Adj v w := by\n575\t        have := e.2; rw [hw] at this; exact this\n576\t      rw [hw, Sym2.mem_iff] at hu\n577\t      by_cases huA : u ∈ A\n578\t      · exact mem_union_left _ huA\n579\t      · rcases hu with rfl | rfl\n580\t        · exact mem_union_right _ (by simp [X, huS, huA])\n581\t        · exact mem_union_right _ (by simp [X, huS, huA, hvw])\n582\t    · rintro ⟨e, he⟩\n583\t      simp only [Y, mem_filter, mem_univ, true_and] at he\n584\t      obtain ⟨w, hw⟩ := Sym2.mem_iff_exists.mp he.1\n585\t      have hvw : G.Adj v w := by\n586\t        have := e.2; rw [hw] at this; exact this\n587\t      have := hK2 ⟨w, hvw⟩; omega\n588\t  have h3 : Reach (buildPos G S B₁ (clearedEdges G S ∪ Y))\n589\t      (buildPos G (insert v S) B₁ (clearedEdges G S ∪ Y)) :=\n590\t    reach_clear hv hvB (by omega)\n591\t  have heq : buildPos G (insert v S) B₁ (clearedEdges G S ∪ Y) = layoutPos G (insert v S) := by\n592\t    funext y\n593\t    rcases y with w | e\n594\t    · simp only [layoutPos, buildPos]\n595\t      by_cases hw : w ∈ insert v S\n596\t      · simp [hw]\n597\t      · have hwv : w ≠ v := fun h => hw (by simp [h])\n598\t        have hwS : w ∉ S := fun h => hw (mem_insert_of_mem h)\n599\t        have hiff : w ∈ B₁ ↔ w ∈ A' := by\n600\t          simp only [B₁, A, A', X, mem_union, mem_filter, mem_univ, true_and,\n601\t            mem_outerBoundary, mem_insert, hwv, hwS, false_or, not_false_eq_true,\n602\t            true_and, exists_eq_or_imp]\n603\t          by_cases hp : ∃ u ∈ S, G.Adj u w <;> simp only [hp] <;> tauto\n604\t        exact if_congr Iff.rfl rfl (if_congr hiff rfl rfl)\n605\t    · simp only [layoutPos, buildPos]\n606\t      have hC : ∀ T : Finset V, e ∈ clearedEdges G T ↔ ∃ u ∈ T, u ∈ (e : Sym2 V) := by\n607\t        intro T; simp [clearedEdges]\n608\t      have hY : e ∈ Y ↔ v ∈ (e : Sym2 V) ∧ e ∉ clearedEdges G S := by simp [Y]\n609\t      have hiff : e ∈ clearedEdges G S ∪ Y ↔ e ∈ clearedEdges G (insert v S) := by\n610\t        rw [mem_union, hY, hC, hC]\n611\t        simp only [mem_insert, exists_eq_or_imp]\n612\t        generalize (∃ u ∈ S, u ∈ (e : Sym2 V)) = p\n613\t        generalize (v ∈ (e : Sym2 V)) = q\n614\t        exact ⟨fun h => h.elim Or.inr (fun h => Or.inl h.1), fun h => h.elim\n615\t          (fun hq => (Classical.em p).elim Or.inl (fun hp => Or.inr ⟨hq, hp⟩)) Or.inl⟩\n616\t      exact if_congr hiff rfl rfl\n617\t  rw [← heq]\n618\t  exact h1.trans (h2.trans h3)\n619\t\n620\ttheorem layoutPos_empty : layoutPos G ∅ = fun _ => fresh := by\n621\t  funext y; rcases y with w | e <;> simp [layoutPos, buildPos, outerBoundary, clearedEdges]\n622\t\n623\ttheorem layoutPos_univ : layoutPos G univ = fun _ => done := by\n624\t  funext y\n625\t  rcases y with w | ⟨e, he⟩\n626\t  · simp [layoutPos, buildPos]\n627\t  · simp only [layoutPos, buildPos, clearedEdges, mem_filter, mem_univ, true_and]\n628\t    have : ∃ u, u ∈ e := by\n629\t      induction e using Sym2.ind with\n630\t      | h a b => exact ⟨a, Sym2.mem_mk_left a b⟩\n631\t    simp [this]\n632\t\n633\t/-- **Theorem 3 (⇐)**, from any layout: clearing the vertices of `G` in layout order pebbles\n634\t`G_d` progressively. The pebbles in play are the active suffix, the vertex being cleared,\n635\tand one edge vertex. -/\n636\ttheorem pebblesWithin_of_layout (σ : LinearLayout V)\n637\t    (h1 : ∀ i, i < Fintype.card V → vertexSepAt G σ i + 1 ≤ K)\n638\t    (h2 : ∀ i (hi : i < Fintype.card V), (∃ w, G.Adj (σ.symm ⟨i, hi⟩) w) →\n639\t      vertexSepAt G σ i + 2 ≤ K) :\n640\t    PebblesWithin (lengauerD G) K := by\n641\t  classical\n642\t  let Tset : ℕ → Finset V := fun i => univ.filter fun v => (σ v).val < i\n643\t  have hstep : ∀ i ≤ Fintype.card V, Reach (layoutPos G ∅) (layoutPos G (Tset i)) := by\n644\t    intro i hi\n645\t    induction i with\n646\t    | zero =>\n647\t      have : Tset 0 = ∅ := by ext; simp [Tset]\n648\t      rw [this]\n649\t    | succ i ih =>\n650\t      have hi' : i < Fintype.card V := by omega\n651\t      set v := σ.symm ⟨i, hi'⟩\n652\t      have hins : Tset (i + 1) = insert v (Tset i) := by\n653\t        ext u\n654\t        simp only [Tset, mem_filter, mem_univ, true_and, mem_insert]\n655\t        constructor\n656\t        · intro h\n657\t          rcases Nat.lt_succ_iff_lt_or_eq.mp h with h | h\n658\t          · exact Or.inr h\n659\t          · left; simp [v, ← h]\n660\t        · rintro (rfl | h)\n661\t          · simp [v]\n662\t          · omega\n663\t      have hvT : v ∉ Tset i := by simp [Tset, v]\n664\t      have hbd : outerBoundary G (Tset (i + 1)) = activeSuffix G σ i := by\n665\t        ext w\n666\t        simp only [mem_outerBoundary, mem_activeSuffix_iff, mem_prefixSet_iff, Tset,\n667\t          mem_filter, mem_univ, true_and, Nat.lt_succ_iff, not_le, gt_iff_lt]\n668\t      refine (ih (by omega)).trans ?_\n669\t      rw [hins]\n670\t      rw [hins] at hbd\n671\t      refine reach_layoutPos_insert hvT ?_ ?_\n672\t      · rw [hbd]; exact h1 i hi'\n673\t      · rw [hbd]; exact h2 i hi'\n674\t  have hall : Tset (Fintype.card V) = univ := by ext v; simp [Tset]\n675\t  have := hstep _ le_rfl\n676\t  rw [hall, layoutPos_univ, layoutPos_empty] at this\n677\t  exact this\n678\t\n679\tend Upper\n680\t\n681\t/-! ### Theorem 3 -/\n682\t\n683\tsection Theorem3\n684\t\n685\tvariable {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n686\t\n687\t/-- **Lengauer (1981) Theorem 3, with `vs`**: for every graph and every `K ≥ 0`,\n688\t`vs(G) ≤ K ⇔ G_d` can be pebbled progressively with `K + 2` pebbles. -/\n689\ttheorem pebblesWithin_lengauerD_iff (K : ℕ) :\n690\t    PebblesWithin (lengauerD G) (K + 2) ↔ vertexSeparation G ≤ K := by\n691\t  refine ⟨vertexSeparation_le_of_pebblesWithin, fun h => ?_⟩\n692\t  obtain ⟨σ, hσ⟩ := exists_layout_vertexSeparation G\n693\t  have hat : ∀ i, i < Fintype.card V → vertexSepAt G σ i ≤ K := fun i hi =>\n694\t    ((vertexSepOfLayout_le_iff G σ _).mp (hσ.trans_le h)) i hi\n695\t  exact pebblesWithin_of_layout σ (fun i hi => by have := hat i hi; omega)\n696\t    (fun i hi _ => by have := hat i hi; omega)\n697\t\n698\t/-- **Lengauer (1981) Theorem 3, as stated** (p. 472): \"The instance `(G, K)` of VSG is\n699\tpositive if and only if the instance `(G_d, K + 2)` of PBWP is positive\", `K` a positive\n700\tinteger. -/\n701\ttheorem isPositiveVSG_iff_isPositivePBWP_lengauerD {K : ℕ} (hK : 0 < K) :\n702\t    IsPositiveVSG G K ↔ IsPositivePBWP (lengauerD G) (K + 2) := by\n703\t  rw [isPositiveVSG_iff, IsPositivePBWP, pebblesWithin_lengauerD_iff]\n704\t  omega\n705\t\n706\t/-- **The pebbling number of `G_d`**: `pbw(G_d) = vs(G) + 2` for every graph with an edge. -/\n707\ttheorem pbw_lengauerD {a b : V} (hab : G.Adj a b) :\n708\t    pbw (lengauerD G) = vertexSeparation G + 2 := by\n709\t  have hmem : vertexSeparation G + 2 ∈ {K | PebblesWithin (lengauerD G) K} :=\n710\t    (pebblesWithin_lengauerD_iff G _).mpr le_rfl\n711\t  unfold pbw\n712\t  apply le_antisymm\n713\t  · exact Nat.sInf_le hmem\n714\t  · apply le_csInf ⟨_, hmem⟩\n715\t    intro K hK\n716\t    have h3 := three_le_of_pebblesWithin hab hK\n717\t    obtain ⟨K', rfl⟩ : ∃ K', K = K' + 2 := ⟨K - 2, by omega⟩\n718\t    have := (pebblesWithin_lengauerD_iff G K').mp hK\n719\t    omega\n720\t\n721\t/-- `pbw(G_d) = pw(G) + 2` for every graph with an edge (with Kinnersley's theorem). -/\n722\ttheorem pbw_lengauerD_eq_pathwidth {a b : V} (hab : G.Adj a b) :\n723\t    pbw (lengauerD G) = pathwidth G + 2 := by\n724\t  rw [pbw_lengauerD G hab, vertexSeparation_eq_pathwidth]\n725\t\n726\t/-- `pbw(G_d) = VSG(G) + 2` for every graph with an edge: Theorem 3 as a number. -/\n727\ttheorem pbw_lengauerD_eq_vsg {a b : V} (hab : G.Adj a b) :\n728\t    pbw (lengauerD G) = vsg G + 2 := by\n729\t  rw [pbw_lengauerD G hab, vsg_eq_vertexSeparation G hab]\n730\t\n731\t/-- **Edge case**: on an edgeless graph with a vertex, `G_d` is `G` with no arcs and one\n732\tpebble suffices, so `pbw(G_d) = 1`, while `vs(G) + 2 = 2` and `VSG(G) + 2 = 3`. The number\n733\tform of Theorem 3 needs an edge; the instance forms above do not. -/\n734\ttheorem pbw_lengauerD_of_edgeless (h : ∀ u v, ¬ G.Adj u v) (v₀ : V) :\n735\t    pbw (lengauerD G) = 1 := by\n736\t  have hwithin : PebblesWithin (lengauerD G) 1 := by\n737\t    have hzero : ∀ (σ : LinearLayout V) i, vertexSepAt G σ i = 0 := by\n738\t      intro σ i\n739\t      unfold vertexSepAt\n740\t      rw [card_eq_zero, eq_empty_iff_forall_notMem]\n741\t      intro w hw\n742\t      obtain ⟨-, u, -, huw⟩ := (mem_activeSuffix_iff G σ i w).mp hw\n743\t      exact h u w huw\n744\t    exact pebblesWithin_of_layout (Fintype.equivFin V) (fun i _ => by rw [hzero])\n745\t      (fun i _ ⟨w, hw⟩ => absurd hw (h _ _))\n746\t  unfold pbw\n747\t  apply le_antisymm (Nat.sInf_le (show 1 ∈ {K | PebblesWithin (lengauerD G) K} from hwithin))\n748\t  apply le_csInf ⟨1, hwithin⟩\n749\t  intro K hK\n750\t  exact one_le_of_pebblesWithin v₀ hK\n751\t\n752\tend Theorem3\n753\t\n754\tend Complex\n755\t\n756\tend MOSPFormalization\n757\t"}]},"parent_tool_use_id":null,"session_id":"0ad89bb0-108d-46ad-9278-059e6bd9be28","uuid":"39e8a906-7226-4f52-8134-37dc39bb5b87","timestamp":"2026-09-30T21:11:59.778Z","tool_use_result":{"type":"text","file":{"filePath":"/home/al/.claude/projects/-home-al-dev-MOSP/0ad89bb0-108d-46ad-9278-059e6bd9be28/tool-results/bzjpbejdn.txt","content":"theorem PebbleStep.reflTransGen_mono {D : Digraph α} {K K' : ℕ} (hK : K ≤ K')\n    {P Q : PebblePosition α} (h : Relation.ReflTransGen (PebbleStep D K) P Q) :\n    Relation.ReflTransGen (PebbleStep D K') P Q := by\n  induction h with\n  | refl => exact .refl\n  | tail _ hs ih =>\n    obtain ⟨m, hm, hQ, hc⟩ := hs\n    exact ih.tail ⟨m, hm, hQ, hc.trans hK⟩\n\ntheorem PebblesWithin.mono {D : Digraph α} {K K' : ℕ} (h : PebblesWithin D K) (hK : K ≤ K') :\n    PebblesWithin D K' :=\n  PebbleStep.reflTransGen_mono hK h\n\n/-- A play as a sequence of positions indexed by time. -/\ntheorem exists_seq_of_reflTransGen {β : Type*} {r : β → β → Prop} {a b : β}\n    (h : Relation.ReflTransGen r a b) :\n    ∃ (T : ℕ) (P : ℕ → β), P 0 = a ∧ P T = b ∧ ∀ i < T, r (P i) (P (i + 1)) := by\n  induction h with\n  | refl => exact ⟨0, fun _ => a, rfl, rfl, fun i hi => absurd hi (Nat.not_lt_zero _)⟩\n  | tail _ hbc ih =>\n    obtain ⟨T, P, h0, hT, hs⟩ := ih\n    rename_i b' c _\n    refine ⟨T + 1, fun i => if i ≤ T then P i else c, by simp [h0], by simp, ?_⟩\n    intro i hi\n    by_cases hiT : i < T\n    · simpa [hiT.le, Nat.succ_le_of_lt hiT] using hs i hiT\n    · have : i = T := by omega\n      subst this\n      simpa [hT] using hbc\n\nend Game\n\n/-! ### What a play implies -/\n\nsection Plays\n\nopen PebblePhase\n\nvariable {α : Type*} [Fintype α] [DecidableEq α] {D : Digraph α} {K : ℕ}\n\ntheorem PebbleStep.rank_le {P Q : PebblePosition α} (h : PebbleStep D K P Q) (x : α) :\n    (P x).rank ≤ (Q x).rank := by\n  obtain ⟨m, hm, rfl, -⟩ := h\n  unfold PebbleMove.apply\n  by_cases hx : x = m.target\n  · subst hx\n    rw [Function.update_self]\n    cases m <;> simp_all [PebbleMove.Legal, PebbleMove.result, PebbleMove.target]\n  · rw [Function.update_of_ne hx]\n\n/-- The only move that takes a vertex from unturned to turned is its turn, and it needs\nevery immediate predecessor pebbled. -/\ntheorem PebbleStep.of_turned {P Q : PebblePosition α} (h : PebbleStep D K P Q) {x : α}\n    (hP : (P x).rank ≤ 1) (hQ : 2 ≤ (Q x).rank) :\n    P x = white ∧ ∀ y, D.Adj y x → (P y).Pebbled := by\n  obtain ⟨m, hm, rfl, -⟩ := h\n  unfold PebbleMove.apply at hQ\n  by_cases hx : x = m.target\n  · subst hx\n    rw [Function.update_self] at hQ\n    cases m with\n    | place y => simp [PebbleMove.result] at hQ\n    | turn y => exact hm\n    | remove y =>\n      simp only [PebbleMove.Legal] at hm\n      simp [PebbleMove.target, hm] at hP\n  · rw [Function.update_of_ne hx] at hQ; omega\n\ntheorem PebbleStep.numPebbles_le {P Q : PebblePosition α} (h : PebbleStep D K P Q) :\n    numPebbles Q ≤ K := by\n  obtain ⟨_, _, rfl, hc⟩ := h; exact hc\n\nvariable {T : ℕ} {P : ℕ → PebblePosition α}\n\ntheorem seq_rank_mono (hs : ∀ i < T, PebbleStep D K (P i) (P (i + 1))) {i j : ℕ}\n    (hij : i ≤ j) (hj : j ≤ T) (x : α) : (P i x).rank ≤ (P j x).rank := by\n  induction j, hij using Nat.le_induction with\n  | base => exact le_rfl\n  | succ j _ ih => exact (ih (by omega)).trans ((hs j (by omega)).rank_le x)\n\n/-- Every vertex that ends turned was turned at some time `i < T`, with its immediate\npredecessors pebbled at that time. -/\ntheorem seq_exists_turn (hs : ∀ i < T, PebbleStep D K (P i) (P (i + 1))) {x : α}\n    (h0 : (P 0 x).rank ≤ 1) (hT : 2 ≤ (P T x).rank) :\n    ∃ i < T, (P i x).rank ≤ 1 ∧ P i x = white ∧ ∀ y, D.Adj y x → (P i y).Pebbled := by\n  classical\n  have hex : ∃ j, j ≤ T ∧ 2 ≤ (P j x).rank := ⟨T, le_rfl, hT⟩\n  have hjT : Nat.find hex ≤ T := (Nat.find_spec hex).1\n  have hj2 : 2 ≤ (P (Nat.find hex) x).rank := (Nat.find_spec hex).2\n  have hj0 : Nat.find hex ≠ 0 := by intro h; rw [h] at hj2; omega\n  obtain ⟨i, hi1⟩ : ∃ i, Nat.find hex = i + 1 := ⟨Nat.find hex - 1, by omega⟩\n  have hi : (P i x).rank ≤ 1 := by\n    by_contra hc\n    exact Nat.find_min hex (show i < Nat.find hex by omega) ⟨by omega, by omega⟩\n  rw [hi1] at hj2\n  exact ⟨i, by omega, hi, (hs i (by omega)).of_turned hi hj2⟩\n\ntheorem seq_numPebbles_le (hs : ∀ i < T, PebbleStep D K (P i) (P (i + 1)))\n    (h0 : P 0 = fun _ => fresh) {i : ℕ} (hi : i ≤ T) : numPebbles (P i) ≤ K := by\n  rcases i with _ | i\n  · rw [h0]; simp [numPebbles, Pebbled]\n  · exact (hs i (by omega)).numPebbles_le\n\nend Plays\n\n/-! ### Lengauer's `G_d` -/\n\nsection Gd\n\nvariable {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n\n/-- Lengauer's `G_d` (Def. 1b, p. 469): `V_d = V ∪ E`, with arcs `v → {v, w}` and\n`w → {v, w}` for every edge `{v, w}`; the edges of `G` themselves are discarded. -/\ndef lengauerD : Digraph (V ⊕ G.edgeSet) where\n  Adj a b := match a, b with\n    | .inl v, .inr e => v ∈ (e : Sym2 V)\n    | _, _ => False\n\nvariable {G}\n\n@[simp] theorem lengauerD_adj_inl_inr {v : V} {e : G.edgeSet} :\n    (lengauerD G).Adj (.inl v) (.inr e) ↔ v ∈ (e : Sym2 V) := Iff.rfl\n\n@[simp] theorem lengauerD_not_adj_to_inl {a : V ⊕ G.edgeSet} {v : V} :\n    ¬ (lengauerD G).Adj a (.inl v) := by\n  rcases a with u | e <;> exact id\n\n@[simp] theorem lengauerD_not_adj_from_inr {e : G.edgeSet} {b : V ⊕ G.edgeSet} :\n    ¬ (lengauerD G).Adj (.inr e) b := by\n  rcases b with u | f <;> exact id\n\nvariable (G)\n\n/-- `G_d` is a dag of depth one: it has no directed path of length two, hence no cycle. -/\ntheorem lengauerD_no_path_two (a b c : V ⊕ G.edgeSet) :\n    ¬ ((lengauerD G).Adj a b ∧ (lengauerD G).Adj b c) := by\n  rintro ⟨hab, hbc⟩\n  rcases b with v | e\n  · exact lengauerD_not_adj_to_inl hab\n  · exact lengauerD_not_adj_from_inr hbc\n\nend Gd\n\n/-! ### The layout a play induces -/\n\nsection Lower\n\nopen PebblePhase\n\nvariable {V : Type*} [Fintype V] [DecidableEq V] {G : SimpleGraph V} [DecidableRel G.Adj]\n\n/-- The vertices outside `S` with a neighbour in `S`: the active suffix of a layout whose\nprefix is `S`. -/\ndef outerBoundary (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) : Finset V :=\n  univ.filter fun w => w ∉ S ∧ ∃ u ∈ S, G.Adj u w\n\ntheorem mem_outerBoundary {S : Finset V} {w : V} :\n    w ∈ outerBoundary G S ↔ w ∉ S ∧ ∃ u ∈ S, G.Adj u w := by\n  simp [outerBoundary]\n\ntheorem PebbleStep.eq_target {α : Type*} [Fintype α] [DecidableEq α] {D : Digraph α} {K : ℕ}\n    {P Q : PebblePosition α} (h : PebbleStep D K P Q) {x y : α} (hx : P x ≠ Q x)\n    (hy : P y ≠ Q y) : x = y := by\n  obtain ⟨m, -, rfl, -⟩ := h\n  unfold PebbleMove.apply at hx hy\n  have h1 : x = m.target := by\n    by_contra h; exact hx (Function.update_of_ne h _ _).symm\n  have h2 : y = m.target := by\n    by_contra h; exact hy (Function.update_of_ne h _ _).symm\n  rw [h1, h2]\n\nvariable {K T : ℕ} {P : ℕ → PebblePosition (V ⊕ G.edgeSet)}\n\n/-- The heart of Theorem 3 (⇒). Let `S` be the vertices of `G` cleared by time `t`. Take the\nedge between `S` and the rest that is turned last; when it turns, it, its endpoint in `S`,\nand every vertex of the outer boundary of `S` carry pebbles. -/\ntheorem outerBoundary_card_le\n    (hs : ∀ i < T, PebbleStep (lengauerD G) (K + 2) (P i) (P (i + 1)))\n    (h0 : P 0 = fun _ => fresh) (hT : P T = fun _ => done)\n    (hc : ∀ i ≤ T, numPebbles (P i) ≤ K + 2) {t : ℕ} (ht : t ≤ T) :\n    (outerBoundary G (univ.filter fun v => P t (.inl v) = done)).card ≤ K := by\n  classical\n  set S := univ.filter fun v => P t (.inl v) = done with hS\n  set B := outerBoundary G S with hB\n  rcases B.eq_empty_or_nonempty with hBe | ⟨b₀, hb₀⟩\n  · rw [hBe]; exact Nat.zero_le _\n  -- turn times of all edge vertices\n  have hturn : ∀ e : G.edgeSet, ∃ i < T, (P i (.inr e)).rank ≤ 1 ∧ P i (.inr e) = white ∧\n      ∀ y, (lengauerD G).Adj y (.inr e) → (P i y).Pebbled := fun e =>\n    seq_exists_turn hs (by rw [h0]; simp) (by rw [hT]; simp)\n  choose τ hτT hτ1 hτw hτp using hturn\n  have hmono := fun {i j} (hij : i ≤ j) (hj : j ≤ T) x => seq_rank_mono hs (P := P) hij hj x\n  -- the cut edges\n  set C : Finset G.edgeSet := univ.filter fun e => ∃ a ∈ S, ∃ b ∉ S, (e : Sym2 V) = s(a, b)\n  obtain ⟨u₀, hu₀S, hu₀⟩ := (mem_outerBoundary.mp hb₀).2\n  have hC : C.Nonempty := ⟨⟨s(u₀, b₀), hu₀⟩, by\n    simp only [C, mem_filter, mem_univ, true_and]\n    exact ⟨u₀, hu₀S, b₀, (mem_outerBoundary.mp hb₀).1, rfl⟩⟩\n  obtain ⟨e, heC, hemax⟩ := C.exists_max_image τ hC\n  obtain ⟨a, haS, b, hbS, hab⟩ := by simpa [C] using heC\n  have hapeb : (P (τ e) (.inl a)).Pebbled :=\n    hτp e _ (by simp [hab])\n  have haS' : P t (.inl a) = done := by simpa [S] using haS\n  -- the last turn happens before `t`\n  have hτt : τ e < t := by\n    by_contra hle\n    have := hmono (not_lt.mp hle) (hτT e).le (.inl a)\n    rw [haS'] at this\n    have := (pebbled_iff_rank _).mp hapeb\n    simp at *; omega\n  -- every boundary vertex is pebbled at the last turn\n  have hBpeb : ∀ w ∈ B, (P (τ e) (.inl w)).Pebbled := by\n    intro w hw\n    obtain ⟨hwS, u, huS, huw⟩ := mem_outerBoundary.mp hw\n    set e' : G.edgeSet := ⟨s(u, w), huw⟩\n    have he'C : e' ∈ C := by\n      simp only [C, mem_filter, mem_univ, true_and]; exact ⟨u, huS, w, hwS, rfl⟩\n    have hle := hemax e' he'C\n    have h1 := (pebbled_iff_rank _).mp (hτp e' (.inl w) (by simp [e']))\n    have h2 := hmono hle (hτT e).le (.inl w)\n    have h3 := hmono hτt.le ht (.inl w)\n    have h4 : (P t (.inl w)).rank ≠ 3 := by\n      rw [Ne, ← eq_done_iff_rank]; simpa [S] using hwS\n    have h5 := rank_le_three (P t (.inl w))\n    rw [pebbled_iff_rank]; omega\n  have hsub : insert (.inr e) (insert (.inl a) (B.map Embedding.inl)) ⊆\n      univ.filter fun x => (P (τ e) x).Pebbled := by\n    intro x hx\n    simp only [mem_insert, mem_map, Embedding.inl_apply] at hx\n    simp only [mem_filter, mem_univ, true_and]\n    rcases hx with rfl | rfl | ⟨w, hw, rfl⟩\n    · rw [hτw e]; exact Or.inl rfl\n    · exact hapeb\n    · exact hBpeb w hw\n  have hcard := card_le_card hsub\n  rw [card_insert_of_notMem (by simp), card_insert_of_notMem (by\n    simp only [mem_map, Embedding.inl_apply, Sum.inl.injEq, not_exists, not_and]\n    rintro w hw rfl; exact (mem_outerBoundary.mp hw).1 haS), card_map] at hcard\n  have := hc (τ e) (hτT e).le\n  unfold numPebbles at this\n  omega\n\n/-- A layout listing the vertices in increasing order of an injective key. -/\ntheorem exists_layout_of_injective {r : V → ℕ} (hr : Injective r) :\n    ∃ σ : LinearLayout V, ∀ u v, σ u ≤ σ v ↔ r u ≤ r v := by\n  classical\n  set s := univ.image r\n  have hs : s.card = Fintype.card V := by rw [card_image_of_injective _ hr, card_univ]\n  set e := s.orderIsoOfFin hs\n  let f : V → Fin (Fintype.card V) := fun v => e.symm ⟨r v, mem_image_of_mem r (mem_univ v)⟩\n  have hf : Injective f := by\n    intro u v h\n    have := congrArg Subtype.val (e.symm.injective h)\n    exact hr this\n  have hbij : Bijective f := (Fintype.bijective_iff_injective_and_card f).mpr ⟨hf, by simp⟩\n  refine ⟨Equiv.ofBijective f hbij, fun u v => ?_⟩\n  simp only [Equiv.ofBijective_apply, f, OrderIso.le_iff_le, Subtype.mk_le_mk]\n\n/-- **Theorem 3 (⇒)**: if `G_d` can be pebbled progressively with `K + 2` pebbles, then\n`vs(G) ≤ K`. The layout lists the vertices of `G` in the order they lose their pebble. -/\ntheorem vertexSeparation_le_of_pebblesWithin (h : PebblesWithin (lengauerD G) (K + 2)) :\n    vertexSeparation G ≤ K := by\n  classical\n  obtain ⟨T, P, h0, hT, hs⟩ := exists_seq_of_reflTransGen h\n  have hc : ∀ i ≤ T, numPebbles (P i) ≤ K + 2 := by\n    intro i hi\n    rcases i with _ | i\n    · rw [h0]; simp [numPebbles, Pebbled]\n    · exact (hs i (by omega)).numPebbles_le\n  have hmono := fun {i j} (hij : i ≤ j) (hj : j ≤ T) x => seq_rank_mono hs (P := P) hij hj x\n  have hex : ∀ v : V, ∃ t, P t (.inl v) = done := fun v => ⟨T, by rw [hT]⟩\n  let r : V → ℕ := fun v => Nat.find (hex v)\n  have hrT : ∀ v, r v ≤ T := fun v => Nat.find_min' (hex v) (by rw [hT])\n  have hdone : ∀ v t, t ≤ T → (P t (.inl v) = done ↔ r v ≤ t) := by\n    intro v t ht\n    constructor\n    · exact fun h => Nat.find_min' (hex v) h\n    · intro hle\n      have h1 := hmono hle ht (.inl v)\n      have h2 : P (r v) (.inl v) = done := Nat.find_spec (hex v)\n      rw [h2] at h1\n      rw [eq_done_iff_rank]\n      have := rank_le_three (P t (.inl v)); simp at h1; omega\n  have hr : Injective r := by\n    intro u v huv\n    have hu : P (r u) (.inl u) = done := Nat.find_spec (hex u)\n    have hv : P (r v) (.inl v) = done := Nat.find_spec (hex v)\n    have hpos : r u ≠ 0 := by\n      intro h; rw [h, h0] at hu; exact PebblePhase.noConfusion hu\n    obtain ⟨i, hi⟩ : ∃ i, r u = i + 1 := ⟨r u - 1, by omega⟩\n    have hu' : P i (.inl u) ≠ done := fun h =>\n      Nat.find_min (hex u) (show i < r u by omega) h\n    have hv' : P i (.inl v) ≠ done := fun h =>\n      Nat.find_min (hex v) (show i < r v by omega) h\n    rw [hi] at hu; rw [← huv, hi] at hv\n    have := (hs i (by have := hrT u; omega)).eq_target (x := .inl u) (y := .inl v)\n      (by rw [hu]; exact hu') (by rw [hv]; exact hv')\n    exact Sum.inl_injective this\n  obtain ⟨σ, hσ⟩ := exists_layout_of_injective hr\n  refine (vertexSeparation_le_vertexSepOfLayout G σ).trans ?_\n  rw [vertexSepOfLayout_le_iff]\n  intro i hi\n  set v := σ.symm ⟨i, hi⟩\n  have hkey : activeSuffix G σ i = outerBoundary G (univ.filter fun u => P (r v) (.inl u) = done) := by\n    have hpre : ∀ u, (σ u).val ≤ i ↔ P (r v) (.inl u) = done := by\n      intro u\n      rw [hdone u _ (hrT v), ← hσ]\n      simp [v, Fin.le_def]\n    ext w\n    simp only [mem_activeSuffix_iff, mem_outerBoundary, mem_prefixSet_iff, mem_filter,\n      mem_univ, true_and, hpre, gt_iff_lt, ← not_le]\n  unfold vertexSepAt\n  rw [hkey]\n  exact outerBoundary_card_le hs h0 hT hc (hrT v)\n\n/-- With an edge `{a, b}`, `G_d` needs three pebbles: when `{a, b}` turns black, `a` and `b`\ncarry pebbles too. -/\ntheorem three_le_of_pebblesWithin {a b : V} (hab : G.Adj a b)\n    (h : PebblesWithin (lengauerD G) K) : 3 ≤ K := by\n  classical\n  obtain ⟨T, P, h0, hT, hs⟩ := exists_seq_of_reflTransGen h\n  set e : G.edgeSet := ⟨s(a, b), hab⟩\n  obtain ⟨i, hiT, -, hw, hp⟩ := seq_exists_turn hs (x := .inr e) (by rw [h0]; simp)\n    (by rw [hT]; simp)\n  have hsub : ({.inr e, .inl a, .inl b} : Finset (V ⊕ G.edgeSet)) ⊆\n      univ.filter fun x => (P i x).Pebbled := by\n    intro x hx\n    simp only [mem_insert, mem_singleton] at hx\n    simp only [mem_filter, mem_univ, true_and]\n    rcases hx with rfl | rfl | rfl\n    · rw [hw]; exact Or.inl rfl\n    · exact hp _ (by simp [e])\n    · exact hp _ (by simp [e])\n  have hcard := card_le_card hsub\n  rw [card_insert_of_notMem (by simp), card_insert_of_notMem (by simp [hab.ne]),\n    card_singleton] at hcard\n  exact hcard.trans (seq_numPebbles_le hs h0 hiT.le)\n\n/-- With a vertex, one pebble is needed. -/\ntheorem one_le_of_pebblesWithin (v : V) (h : PebblesWithin (lengauerD G) K) : 1 ≤ K := by\n  classical\n  obtain ⟨T, P, h0, hT, hs⟩ := exists_seq_of_reflTransGen h\n  obtain ⟨i, hiT, -, hw, -⟩ := seq_exists_turn hs (x := .inl v) (by rw [h0]; simp)\n    (by rw [hT]; simp)\n  have hsub : ({.inl v} : Finset (V ⊕ G.edgeSet)) ⊆ univ.filter fun x => (P i x).Pebbled := by\n    intro x hx\n    rw [mem_singleton] at hx; subst hx\n    simp only [mem_filter, mem_univ, true_and]; rw [hw]; exact Or.inl rfl\n  have hcard := card_le_card hsub\n  rw [card_singleton] at hcard\n  exact hcard.trans (seq_numPebbles_le hs h0 hiT.le)\n\nend Lower\n\n/-! ### The strategy a layout induces -/\n\nsection Upper\n\nopen PebblePhase\n\nvariable {V : Type*} [Fintype V] [DecidableEq V] {G : SimpleGraph V} [DecidableRel G.Adj]\nvariable {K : ℕ}\n\nlocal notation \"Reach\" => Relation.ReflTransGen (PebbleStep (lengauerD G) K)\n\ntheorem numPebbles_le_of_subset {α : Type*} [Fintype α] [DecidableEq α] {P : PebblePosition α}\n    {Y : Finset α} (h : ∀ x, (P x).Pebbled → x ∈ Y) : numPebbles P ≤ Y.card :=\n  card_le_card fun x hx => h x (by simpa using hx)\n\ntheorem reach_move {P : PebblePosition (V ⊕ G.edgeSet)} (m : PebbleMove (V ⊕ G.edgeSet))\n    (hm : m.Legal (lengauerD G) P) (hc : numPebbles (m.apply P) ≤ K) :\n    Reach P (m.apply P) :=\n  Relation.ReflTransGen.single ⟨m, hm, rfl, hc⟩\n\nvariable (G) in\n/-- The positions the strategy passes through: `S` the cleared vertices of `G`, `B` the\nblack ones, `F` the cleared edge vertices; everything else is pebble-free. -/\ndef buildPos (S B : Finset V) (F : Finset G.edgeSet) : PebblePosition (V ⊕ G.edgeSet)\n  | .inl w => if w ∈ S then done else if w ∈ B then black else fresh\n  | .inr e => if e ∈ F then done else fresh\n\ntheorem buildPos_pebbled {S B : Finset V} {F : Finset G.edgeSet} {x : V ⊕ G.edgeSet}\n    (h : (buildPos G S B F x).Pebbled) : x ∈ B.map Embedding.inl := by\n  rcases x with w | e\n  · simp only [buildPos] at h\n    split_ifs at h with h1 h2 <;> simp_all [Pebbled]\n  · simp only [buildPos] at h\n    split_ifs at h <;> simp [Pebbled] at h\n\ntheorem numPebbles_buildPos_le (S B : Finset V) (F : Finset G.edgeSet) :\n    numPebbles (buildPos G S B F) ≤ B.card := by\n  have := numPebbles_le_of_subset (fun x h => buildPos_pebbled (S := S) (B := B) (F := F) h)\n  rwa [card_map] at this\n\n/-- Blacken one pebble-free vertex of `G`: place a white pebble and turn it (a source). -/\ntheorem reach_raise {S B : Finset V} {F : Finset G.edgeSet} {x : V} (hxS : x ∉ S) (hxB : x ∉ B)\n    (hK : (insert x B).card ≤ K) :\n    Reach (buildPos G S B F) (buildPos G S (insert x B) F) := by\n  set P₀ := buildPos G S B F\n  have h1 : Reach P₀ ((PebbleMove.place (Sum.inl x)).apply P₀) := by\n    refine reach_move _ (by simp [PebbleMove.Legal, P₀, buildPos, hxS, hxB]) ?_\n    refine (numPebbles_le_of_subset (Y := (insert x B).map Embedding.inl) ?_).trans\n      (by rwa [card_map])\n    intro y hy\n    by_cases hyx : y = .inl x\n    · subst hyx; simp\n    · rw [PebbleMove.apply, PebbleMove.target, Function.update_of_ne hyx] at hy\n      exact map_subset_map.mpr (subset_insert _ _) (buildPos_pebbled hy)\n  refine h1.trans ?_\n  set P₁ := (PebbleMove.place (Sum.inl x)).apply P₀\n  have heq : (PebbleMove.turn (Sum.inl x)).apply P₁ = buildPos G S (insert x B) F := by\n    funext y\n    rcases y with w | e\n    · by_cases hw : w = x\n      · subst hw\n        simp [PebbleMove.apply, PebbleMove.target, PebbleMove.result, buildPos, hxS]\n      · simp [PebbleMove.apply, PebbleMove.target, P₁, P₀, buildPos, hw]\n    · simp [PebbleMove.apply, PebbleMove.target, P₁, P₀, buildPos]\n  rw [← heq]\n  refine reach_move _ ⟨by simp [P₁, PebbleMove.apply, PebbleMove.target, PebbleMove.result],\n    fun y hy => absurd hy lengauerD_not_adj_to_inl⟩ ?_\n  rw [heq]; exact (numPebbles_buildPos_le _ _ _).trans hK\n\n/-- Clear one edge vertex whose endpoints are black: place, turn, remove. -/\ntheorem reach_edge {S B : Finset V} {F : Finset G.edgeSet} {e : G.edgeSet} (heF : e ∉ F)\n    (hends : ∀ u ∈ (e : Sym2 V), u ∈ B ∧ u ∉ S) (hK : B.card + 1 ≤ K) :\n    Reach (buildPos G S B F) (buildPos G S B (insert e F)) := by\n  set P₀ := buildPos G S B F\n  have hcnt : ∀ P : PebblePosition (V ⊕ G.edgeSet), (∀ y, y ≠ .inr e → P y = P₀ y) →\n      numPebbles P ≤ K := by\n    intro P hP\n    refine (numPebbles_le_of_subset (Y := insert (.inr e) (B.map Embedding.inl)) ?_).trans\n      ((card_insert_le _ _).trans (by rwa [card_map]))\n    intro y hy\n    by_cases hye : y = .inr e\n    · subst hye; simp\n    · rw [hP y hye] at hy; exact mem_insert_of_mem (buildPos_pebbled hy)\n  set P₁ := (PebbleMove.place (Sum.inr e)).apply P₀\n  set P₂ := (PebbleMove.turn (Sum.inr e)).apply P₁\n  have hP₁ : ∀ y, y ≠ .inr e → P₁ y = P₀ y := fun y hy => by\n    simp [P₁, PebbleMove.apply, PebbleMove.target, Function.update_of_ne hy]\n  have hP₂ : ∀ y, y ≠ .inr e → P₂ y = P₀ y := fun y hy => by\n    simp [P₂, PebbleMove.apply, PebbleMove.target, Function.update_of_ne hy, hP₁ y hy]\n  have h1 : Reach P₀ P₁ :=\n    reach_move _ (by simp [PebbleMove.Legal, P₀, buildPos, heF]) (hcnt _ hP₁)\n  have h2 : Reach P₁ P₂ := by\n    refine reach_move _ ⟨by simp [P₁, PebbleMove.apply, PebbleMove.target,\n      PebbleMove.result], ?_⟩ (hcnt _ hP₂)\n    intro y hy\n    rcases y with u | f\n    · have hu := hends u hy\n      rw [hP₁ _ (by simp)]\n      simp [P₀, buildPos, hu.1, hu.2, Pebbled]\n    · exact absurd hy lengauerD_not_adj_from_inr\n  have heq : (PebbleMove.remove (Sum.inr e)).apply P₂ = buildPos G S B (insert e F) := by\n    funext y\n    by_cases hye : y = .inr e\n    · subst hye; simp [PebbleMove.apply, PebbleMove.target, PebbleMove.result, buildPos]\n    · rw [PebbleMove.apply, PebbleMove.target, Function.update_of_ne hye, hP₂ y hye]\n      rcases y with w | f\n      · simp [P₀, buildPos]\n      · have : f ≠ e := fun h => hye (by rw [h])\n        simp [P₀, buildPos, this]\n  have h3 : Reach P₂ (buildPos G S B (insert e F)) := by\n    rw [← heq]\n    refine reach_move _ (by simp [P₂, PebbleMove.Legal, PebbleMove.apply, PebbleMove.target,\n      PebbleMove.result]) ?_\n    rw [heq]; exact (numPebbles_buildPos_le _ _ _).trans (by omega)\n  exact h1.trans (h2.trans h3)\n\n/-- Remove the black pebble from a vertex of `G`. -/\ntheorem reach_clear {S B : Finset V} {F : Finset G.edgeSet} {x : V} (hxS : x ∉ S) (hxB : x ∈ B)\n    (hK : B.card ≤ K) :\n    Reach (buildPos G S B F) (buildPos G (insert x S) B F) := by\n  have heq : (PebbleMove.remove (Sum.inl x)).apply (buildPos G S B F) =\n      buildPos G (insert x S) B F := by\n    funext y\n    rcases y with w | e\n    · by_cases hw : w = x\n      · subst hw; simp [PebbleMove.apply, PebbleMove.target, PebbleMove.result, buildPos]\n      · simp [PebbleMove.apply, PebbleMove.target, buildPos, hw]\n    · simp [PebbleMove.apply, PebbleMove.target, buildPos]\n  rw [← heq]\n  refine reach_move _ (by simp [PebbleMove.Legal, buildPos, hxS, hxB]) ?_\n  rw [heq]; exact (numPebbles_buildPos_le _ _ _).trans hK\n\ntheorem reach_raise_set {S B : Finset V} {F : Finset G.edgeSet} (X : Finset V)\n    (hXS : Disjoint X S) (hXB : Disjoint X B) (hK : (B ∪ X).card ≤ K) :\n    Reach (buildPos G S B F) (buildPos G S (B ∪ X) F) := by\n  induction X using Finset.induction_on with\n  | empty => simp; exact .refl\n  | insert x X hx ih =>\n    have hxS : x ∉ S := disjoint_left.mp hXS (mem_insert_self _ _)\n    have hxB : x ∉ B := disjoint_left.mp hXB (mem_insert_self _ _)\n    have hsub : (B ∪ X).card ≤ (B ∪ insert x X).card :=\n      card_le_card (union_subset_union le_rfl (subset_insert _ _))\n    refine (ih (disjoint_of_subset_left (subset_insert _ _) hXS)\n      (disjoint_of_subset_left (subset_insert _ _) hXB) (hsub.trans hK)).trans ?_\n    rw [union_insert]\n    exact reach_raise hxS (by simp [hxB, hx]) (by rwa [← union_insert])\n\ntheorem reach_edge_set {S B : Finset V} {F : Finset G.edgeSet} (Y : Finset G.edgeSet)\n    (hYF : Disjoint Y F) (hends : ∀ e ∈ Y, ∀ u ∈ (e : Sym2 V), u ∈ B ∧ u ∉ S)\n    (hK : Y.Nonempty → B.card + 1 ≤ K) :\n    Reach (buildPos G S B F) (buildPos G S B (F ∪ Y)) := by\n  induction Y using Finset.induction_on with\n  | empty => simp; exact .refl\n  | insert e Y he ih =>\n    refine (ih (disjoint_of_subset_left (subset_insert _ _) hYF)\n      (fun f hf => hends f (mem_insert_of_mem hf))\n      (fun _ => hK (insert_nonempty _ _))).trans ?_\n    rw [union_insert]\n    exact reach_edge (by simp [disjoint_left.mp hYF (mem_insert_self _ _), he])\n      (hends e (mem_insert_self _ _)) (hK (insert_nonempty _ _))\n\nvariable (G) in\n/-- The edges with an endpoint in `S`. -/\ndef clearedEdges (S : Finset V) : Finset G.edgeSet :=\n  univ.filter fun e => ∃ u ∈ S, u ∈ (e : Sym2 V)\n\nvariable (G) in\n/-- The position after the strategy has cleared the vertices `S`: their outer boundary is\nblack, the edges at `S` are cleared, everything else is pebble-free. -/\ndef layoutPos (S : Finset V) : PebblePosition (V ⊕ G.edgeSet) :=\n  buildPos G S (outerBoundary G S) (clearedEdges G S)\n\n/-- One step of the strategy: clear `v`. Blacken the pebble-free vertices of `N[v]`, clear\nevery edge at `v` not yet cleared, then remove `v`. At most the new boundary, `v`, and one\nedge vertex are pebbled at any instant. -/\ntheorem reach_layoutPos_insert {S : Finset V} {v : V} (hv : v ∉ S)\n    (hK1 : (outerBoundary G (insert v S)).card + 1 ≤ K)\n    (hK2 : (∃ w, G.Adj v w) → (outerBoundary G (insert v S)).card + 2 ≤ K) :\n    Reach (layoutPos G S) (layoutPos G (insert v S)) := by\n  classical\n  set A := outerBoundary G S\n  set A' := outerBoundary G (insert v S)\n  set X := univ.filter fun w => (w = v ∨ G.Adj v w) ∧ w ∉ S ∧ w ∉ A\n  set B₁ := A ∪ X\n  have hB₁ : B₁ ⊆ insert v A' := by\n    intro w hw\n    rcases mem_union.mp hw with hw | hw\n    · obtain ⟨hwS, u, huS, huw⟩ := mem_outerBoundary.mp hw\n      by_cases hwv : w = v\n      · simp [hwv]\n      · exact mem_insert_of_mem (mem_outerBoundary.mpr\n          ⟨by simp [hwv, hwS], u, mem_insert_of_mem huS, huw⟩)\n    · simp only [X, mem_filter, mem_univ, true_and] at hw\n      obtain ⟨hvw | hvw, hwS, -⟩ := hw\n      · simp [hvw]\n      · exact mem_insert_of_mem (mem_outerBoundary.mpr\n          ⟨by simp [hvw.ne.symm, hwS], v, mem_insert_self _ _, hvw⟩)\n  have hcard : B₁.card ≤ A'.card + 1 :=\n    (card_le_card hB₁).trans (card_insert_le _ _)\n  have hvB : v ∈ B₁ := by\n    by_cases hvA : v ∈ A\n    · exact mem_union_left _ hvA\n    · exact mem_union_right _ (by simp [X, hv, hvA])\n  set Y := univ.filter fun e : G.edgeSet => v ∈ (e : Sym2 V) ∧ e ∉ clearedEdges G S\n  have h1 : Reach (layoutPos G S) (buildPos G S B₁ (clearedEdges G S)) :=\n    reach_raise_set X (by rw [disjoint_left]; intro w hw; simp [X] at hw; exact hw.2.1)\n      (by rw [disjoint_left]; intro w hw; simp [X] at hw; exact hw.2.2)\n      (by have : B₁.card ≤ K := by omega\n          exact this)\n  have h2 : Reach (buildPos G S B₁ (clearedEdges G S))\n      (buildPos G S B₁ (clearedEdges G S ∪ Y)) := by\n    refine reach_edge_set Y (by rw [disjoint_left]; intro e he; simp [Y] at he; exact he.2)\n      ?_ ?_\n    · intro e he u hu\n      simp only [Y, mem_filter, mem_univ, true_and] at he\n      obtain ⟨hve, heF⟩ := he\n      have huS : u ∉ S := fun huS => heF (by simp [clearedEdges]; exact ⟨u, huS, hu⟩)\n      refine ⟨?_, huS⟩\n      obtain ⟨w, hw⟩ := Sym2.mem_iff_exists.mp hve\n      have hvw : G.Adj v w := by\n        have := e.2; rw [hw] at this; exact this\n      rw [hw, Sym2.mem_iff] at hu\n      by_cases huA : u ∈ A\n      · exact mem_union_left _ huA\n      · rcases hu with rfl | rfl\n        · exact mem_union_right _ (by simp [X, huS, huA])\n        · exact mem_union_right _ (by simp [X, huS, huA, hvw])\n    · rintro ⟨e, he⟩\n      simp only [Y, mem_filter, mem_univ, true_and] at he\n      obtain ⟨w, hw⟩ := Sym2.mem_iff_exists.mp he.1\n      have hvw : G.Adj v w := by\n        have := e.2; rw [hw] at this; exact this\n      have := hK2 ⟨w, hvw⟩; omega\n  have h3 : Reach (buildPos G S B₁ (clearedEdges G S ∪ Y))\n      (buildPos G (insert v S) B₁ (clearedEdges G S ∪ Y)) :=\n    reach_clear hv hvB (by omega)\n  have heq : buildPos G (insert v S) B₁ (clearedEdges G S ∪ Y) = layoutPos G (insert v S) := by\n    funext y\n    rcases y with w | e\n    · simp only [layoutPos, buildPos]\n      by_cases hw : w ∈ insert v S\n      · simp [hw]\n      · have hwv : w ≠ v := fun h => hw (by simp [h])\n        have hwS : w ∉ S := fun h => hw (mem_insert_of_mem h)\n        have hiff : w ∈ B₁ ↔ w ∈ A' := by\n          simp only [B₁, A, A', X, mem_union, mem_filter, mem_univ, true_and,\n            mem_outerBoundary, mem_insert, hwv, hwS, false_or, not_false_eq_true,\n            true_and, exists_eq_or_imp]\n          by_cases hp : ∃ u ∈ S, G.Adj u w <;> simp only [hp] <;> tauto\n        exact if_congr Iff.rfl rfl (if_congr hiff rfl rfl)\n    · simp only [layoutPos, buildPos]\n      have hC : ∀ T : Finset V, e ∈ clearedEdges G T ↔ ∃ u ∈ T, u ∈ (e : Sym2 V) := by\n        intro T; simp [clearedEdges]\n      have hY : e ∈ Y ↔ v ∈ (e : Sym2 V) ∧ e ∉ clearedEdges G S := by simp [Y]\n      have hiff : e ∈ clearedEdges G S ∪ Y ↔ e ∈ clearedEdges G (insert v S) := by\n        rw [mem_union, hY, hC, hC]\n        simp only [mem_insert, exists_eq_or_imp]\n        generalize (∃ u ∈ S, u ∈ (e : Sym2 V)) = p\n        generalize (v ∈ (e : Sym2 V)) = q\n        exact ⟨fun h => h.elim Or.inr (fun h => Or.inl h.1), fun h => h.elim\n          (fun hq => (Classical.em p).elim Or.inl (fun hp => Or.inr ⟨hq, hp⟩)) Or.inl⟩\n      exact if_congr hiff rfl rfl\n  rw [← heq]\n  exact h1.trans (h2.trans h3)\n\ntheorem layoutPos_empty : layoutPos G ∅ = fun _ => fresh := by\n  funext y; rcases y with w | e <;> simp [layoutPos, buildPos, outerBoundary, clearedEdges]\n\ntheorem layoutPos_univ : layoutPos G univ = fun _ => done := by\n  funext y\n  rcases y with w | ⟨e, he⟩\n  · simp [layoutPos, buildPos]\n  · simp only [layoutPos, buildPos, clearedEdges, mem_filter, mem_univ, true_and]\n    have : ∃ u, u ∈ e := by\n      induction e using Sym2.ind with\n      | h a b => exact ⟨a, Sym2.mem_mk_left a b⟩\n    simp [this]\n\n/-- **Theorem 3 (⇐)**, from any layout: clearing the vertices of `G` in layout order pebbles\n`G_d` progressively. The pebbles in play are the active suffix, the vertex being cleared,\nand one edge vertex. -/\ntheorem pebblesWithin_of_layout (σ : LinearLayout V)\n    (h1 : ∀ i, i < Fintype.card V → vertexSepAt G σ i + 1 ≤ K)\n    (h2 : ∀ i (hi : i < Fintype.card V), (∃ w, G.Adj (σ.symm ⟨i, hi⟩) w) →\n      vertexSepAt G σ i + 2 ≤ K) :\n    PebblesWithin (lengauerD G) K := by\n  classical\n  let Tset : ℕ → Finset V := fun i => univ.filter fun v => (σ v).val < i\n  have hstep : ∀ i ≤ Fintype.card V, Reach (layoutPos G ∅) (layoutPos G (Tset i)) := by\n    intro i hi\n    induction i with\n    | zero =>\n      have : Tset 0 = ∅ := by ext; simp [Tset]\n      rw [this]\n    | succ i ih =>\n      have hi' : i < Fintype.card V := by omega\n      set v := σ.symm ⟨i, hi'⟩\n      have hins : Tset (i + 1) = insert v (Tset i) := by\n        ext u\n        simp only [Tset, mem_filter, mem_univ, true_and, mem_insert]\n        constructor\n        · intro h\n          rcases Nat.lt_succ_iff_lt_or_eq.mp h with h | h\n          · exact Or.inr h\n          · left; simp [v, ← h]\n        · rintro (rfl | h)\n          · simp [v]\n          · omega\n      have hvT : v ∉ Tset i := by simp [Tset, v]\n      have hbd : outerBoundary G (Tset (i + 1)) = activeSuffix G σ i := by\n        ext w\n        simp only [mem_outerBoundary, mem_activeSuffix_iff, mem_prefixSet_iff, Tset,\n          mem_filter, mem_univ, true_and, Nat.lt_succ_iff, not_le, gt_iff_lt]\n      refine (ih (by omega)).trans ?_\n      rw [hins]\n      rw [hins] at hbd\n      refine reach_layoutPos_insert hvT ?_ ?_\n      · rw [hbd]; exact h1 i hi'\n      · rw [hbd]; exact h2 i hi'\n  have hall : Tset (Fintype.card V) = univ := by ext v; simp [Tset]\n  have := hstep _ le_rfl\n  rw [hall, layoutPos_univ, layoutPos_empty] at this\n  exact this\n\nend Upper\n\n/-! ### Theorem 3 -/\n\nsection Theorem3\n\nvariable {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n\n/-- **Lengauer (1981) Theorem 3, with `vs`**: for every graph and every `K ≥ 0`,\n`vs(G) ≤ K ⇔ G_d` can be pebbled progressively with `K + 2` pebbles. -/\ntheorem pebblesWithin_lengauerD_iff (K : ℕ) :\n    PebblesWithin (lengauerD G) (K + 2) ↔ vertexSeparation G ≤ K := by\n  refine ⟨vertexSeparation_le_of_pebblesWithin, fun h => ?_⟩\n  obtain ⟨σ, hσ⟩ := exists_layout_vertexSeparation G\n  have hat : ∀ i, i < Fintype.card V → vertexSepAt G σ i ≤ K := fun i hi =>\n    ((vertexSepOfLayout_le_iff G σ _).mp (hσ.trans_le h)) i hi\n  exact pebblesWithin_of_layout σ (fun i hi => by have := hat i hi; omega)\n    (fun i hi _ => by have := hat i hi; omega)\n\n/-- **Lengauer (1981) Theorem 3, as stated** (p. 472): \"The instance `(G, K)` of VSG is\npositive if and only if the instance `(G_d, K + 2)` of PBWP is positive\", `K` a positive\ninteger. -/\ntheorem isPositiveVSG_iff_isPositivePBWP_lengauerD {K : ℕ} (hK : 0 < K) :\n    IsPositiveVSG G K ↔ IsPositivePBWP (lengauerD G) (K + 2) := by\n  rw [isPositiveVSG_iff, IsPositivePBWP, pebblesWithin_lengauerD_iff]\n  omega\n\n/-- **The pebbling number of `G_d`**: `pbw(G_d) = vs(G) + 2` for every graph with an edge. -/\ntheorem pbw_lengauerD {a b : V} (hab : G.Adj a b) :\n    pbw (lengauerD G) = vertexSeparation G + 2 := by\n  have hmem : vertexSeparation G + 2 ∈ {K | PebblesWithin (lengauerD G) K} :=\n    (pebblesWithin_lengauerD_iff G _).mpr le_rfl\n  unfold pbw\n  apply le_antisymm\n  · exact Nat.sInf_le hmem\n  · apply le_csInf ⟨_, hmem⟩\n    intro K hK\n    have h3 := three_le_of_pebblesWithin hab hK\n    obtain ⟨K', rfl⟩ : ∃ K', K = K' + 2 := ⟨K - 2, by omega⟩\n    have := (pebblesWithin_lengauerD_iff G K').mp hK\n    omega\n\n/-- `pbw(G_d) = pw(G) + 2` for every graph with an edge (with Kinnersley's theorem). -/\ntheorem pbw_lengauerD_eq_pathwidth {a b : V} (hab : G.Adj a b) :\n    pbw (lengauerD G) = pathwidth G + 2 := by\n  rw [pbw_lengauerD G hab, vertexSeparation_eq_pathwidth]\n\n/-- `pbw(G_d) = VSG(G) + 2` for every graph with an edge: Theorem 3 as a number. -/\ntheorem pbw_lengauerD_eq_vsg {a b : V} (hab : G.Adj a b) :\n    pbw (lengauerD G) = vsg G + 2 := by\n  rw [pbw_lengauerD G hab, vsg_eq_vertexSeparation G hab]\n\n/-- **Edge case**: on an edgeless graph with a vertex, `G_d` is `G` with no arcs and one\npebble suffices, so `pbw(G_d) = 1`, while `vs(G) + 2 = 2` and `VSG(G) + 2 = 3`. The number\nform of Theorem 3 needs an edge; the instance forms above do not. -/\ntheorem pbw_lengauerD_of_edgeless (h : ∀ u v, ¬ G.Adj u v) (v₀ : V) :\n    pbw (lengauerD G) = 1 := by\n  have hwithin : PebblesWithin (lengauerD G) 1 := by\n    have hzero : ∀ (σ : LinearLayout V) i, vertexSepAt G σ i = 0 := by\n      intro σ i\n      unfold vertexSepAt\n      rw [card_eq_zero, eq_empty_iff_forall_notMem]\n      intro w hw\n      obtain ⟨-, u, -, huw⟩ := (mem_activeSuffix_iff G σ i w).mp hw\n      exact h u w huw\n    exact pebblesWithin_of_layout (Fintype.equivFin V) (fun i _ => by rw [hzero])\n      (fun i _ ⟨w, hw⟩ => absurd hw (h _ _))\n  unfold pbw\n  apply le_antisymm (Nat.sInf_le (show 1 ∈ {K | PebblesWithin (lengauerD G) K} from hwithin))\n  apply le_csInf ⟨1, hwithin⟩\n  intro K hK\n  exact one_le_of_pebblesWithin v₀ hK\n\nend Theorem3\n\nend Complex\n\nend MOSPFormalization\n","numLines":757,"startLine":1,"totalLines":757}}}
