ds : 0;\n   543\t    s.path = out_path;\n   544\t\n   545\t    s.neighbour = malloc(sizeof(mask_t) * (size_t) n);\n   546\t    if (!s.neighbour) return -2;\n   547\t    for (int i = 0; i < n; i++)\n   548\t        s.neighbour[i] = ((mask_t) neighbours[2 * i + 1] << 64) |\n   549\t                         (mask_t) neighbours[2 * i];\n   550\t    s.full = n == 128 ? ~(mask_t) 0 : (BIT(n) - 1);\n   551\t\n   552\t    if (use_memo) {\n   553\t        size_t capacity = 1u << 20;         /* grows nothing; sized once */\n   554\t        while (capacity < (size_t) memo_limit * 2 && capacity < (1u << 26))\n   555\t            capacity <<= 1;\n   556\t        if (!memo_init(&s.memo, capacity, (size_t) memo_limit)) {\n   557\t            free(s.neighbour);\n   558\t            return -2;\n   559\t        }\n   560\t    }\n   561\t\n   562\t    int found = search(&s, 0, 0, 0);\n   563\t    *out_nodes = s.nodes;\n   564\t    *out_len = found ? s.depth : 0;\n   565\t\n   566\t    free(s.neighbour);\n   567\t    free(s.memo.slots);\n   568\t    return found ? 1 : (s.aborted ? -1 : 0);\n   569\t}\n   570\t\n   571\t/* `cs_decide` plus the fan-order flag; kept with its signature for the same\n   572\t * reason as `cs_decide`. Today's better-move rule, always. */\n   573\tint cs_decide_fan(int n, int k,\n   574\t                  const uint64_t *neighbours,\n   575\t                  long long max_nodes, double seconds,\n   576\t                  int subset_rule, int definite_move, int use_memo,\n   577\t                  int restrict_frontier, long long memo_limit,\n   578\t                  int better_move, int better_move_dominators, int old_move,\n   579\t                  int fan_order,\n   580\t                  int *out_path, long long *out_nodes, int *out_len) {\n   581\t    return cs_decide_variant(n, k, neighbours, max_nodes, seconds,\n   582\t                             subset_rule, definite_move, use_memo,\n   583\t                             restrict_frontier, memo_limit,\n   584\t                             better_move, better_move_dominators, old_move,\n   585\t                             fan_order, 0, out_path, out_nodes, out_len);\n   586\t}\n   587\t\n   588\t/* The original entry point, kept with its signature so a process that loaded\n   589\t * the library before `fan_order` existed -- a multi-day `benchmarks.recertify`\n   590\t * run forks its workers late -- calls a function that still means what it\n   591\t * meant. Ties by customer index, as always. */\n   592\tint cs_decide(int n, int k,\n   593\t              const uint64_t *neighbours,\n   594\t              long long max_nodes, double seconds,\n   595\t              int subset_rule, int definite_move, int use_memo,\n   596\t              int restrict_frontier, long long memo_limit,\n   597\t              int better_move, int better_move_dominators, int old_move,\n   598\t              int *out_path, long long *out_nodes, int *out_len) {\n   599\t    return cs_decide_fan(n, k, neighbours, max_nodes, seconds,\n   600\t                         subset_rule, definite_move, use_memo,\n   601\t                         restrict_frontier, memo_limit,\n   602\t                         better_move, better_move_dominators, old_move,\n   603\t                         FAN_ORDER_INDEX, out_path, out_nodes, out_len);\n   604\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
