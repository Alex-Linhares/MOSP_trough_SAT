uint64_t low = (uint64_t) x;\n    53\t    return low ? __builtin_ctzll(low) : 64 + __builtin_ctzll((uint64_t)(x >> 64));\n    54\t}\n    55\t\n    56\t/* Open-addressing set of refuted states. The Python uses a Python set with a\n    57\t * cap; this is the same idea with linear probing. Zero marks an empty slot,\n    58\t * which is safe because the empty closed-set is never refuted: it is the root,\n    59\t * and reaching it again would mean the whole search had already failed. */\n    60\ttypedef struct {\n    61\t    mask_t  *slots;\n    62\t    size_t   capacity;      /* a power of two, or 0 when memoisation is off */\n    63\t    size_t   used;\n    64\t    size_t   limit;\n    65\t} memo_t;\n    66\t\n    67\tstatic int memo_init(memo_t *m, size_t capacity, size_t limit) {\n    68\t    m->slots = calloc(capacity, sizeof(mask_t));\n    69\t    if (!m->slots) return 0;\n    70\t    m->capacity = capacity;\n    71\t    m->used = 0;\n    72\t    m->limit = limit;\n    73\t    return 1;\n    74\t}\n    75\t\n    76\tstatic inline size_t memo_hash(mask_t key, size_t capacity) {\n    77\t    uint64_t h = (uint64_t) key ^ ((uint64_t)(key >> 64) * 0x9E3779B97F4A7C15ULL);\n    78\t    h ^= h >> 29; h *= 0xBF58476D1CE4E5B9ULL; h ^= h >> 32;\n    79\t    return (size_t) h & (capacity - 1);\n    80\t}\n    81\t\n    82\tstatic int memo_has(const memo_t *m, mask_t key) {\n    83\t    if (!m->capacity) return 0;\n    84\t    size_t i = memo_hash(key, m->capacity);\n    85\t    while (m->slots[i]) {\n    86\t        if (m->slots[i] == key) return 1;\n    87\t        i = (i + 1) & (m->capacity - 1);\n    88\t    }\n    89\t    return 0;\n    90\t}\n    91\t\n    92\tstatic void memo_add(memo_t *m, mask_t key) {\n    93\t    /* Stop filling past the limit, and never past 70% load: linear probing\n    94\t     * degrades badly when full, and an unbounded table on a multi-day run is\n    95\t     * how a machine dies. */\n    96\t    if (!m->capacity || m->used >= m->limit ||\n    97\t        m->used * 10 >= m->capacity * 7) return;\n    98\t    size_t i = memo_hash(key, m->capacity);\n    99\t    while (m->slots[i]) {\n   100\t        if (m->slots[i] == key) return;\n   101\t        i = (i + 1) & (m->capacity - 1);\n   102\t    }\n   103\t    m->slots[i] = key;\n   104\t    m->used++;\n   105\t}\n   106\t\n   107\ttypedef struct {\n   108\t    int      n;                 /* active customers */\n   109\t    int      k;                 /* the budget on open stacks */\n   110\t    mask_t   full;\n   111\t    mask_t  *neighbour;         /* self-inclusive neighbourhoods */\n   112\t    memo_t   memo;\n   113\t    int      subset_rule;\n   114\t    int      definite_move;\n   115\t    int      better_move;\n   116\t    int      better_move_dominators;   /* how many q to try; 0 for all */\n   117\t    int      better_move_variant;      /* BM_OLD_* bits; 0 is today's rule */\n   118\t    int      old_move;\n   119\t    int      fan_order;         /* 0: ties by customer index; 1: by remaining degree, highest first */\n   120\t    int      use_memo;\n   121\t    int      restrict_frontier;\n   122\t    long long nodes;\n   123\t    long long max_nodes;        /* < 0 for unlimited */\n   124\t    double   deadline;          /* <= 0 for none, else CLOCK_MONOTONIC seconds */\n   125\t    int      aborted;\n   126\t    int     *path;\n   127\t    int      depth;\n   128\t} search_t;\n   129\t\n   130\tstatic double monotonic_now(void) {\n   131\t    struct timespec ts;\n   132\t    clock_gettime(CLOCK_MONOTONIC, &ts);\n   133\t    return (double) ts.tv_sec + (double) ts.tv_nsec * 1e-9;\n   134\t}\n   135\t\n   136\tstatic int search(search_t *s, mask_t closed, mask_t opened, mask_t seen);\n   137\t\n   138\t/* The subset rule over the candidates in `costs`/`who`/`index_of`, measured\n   139\t * against every remaining customer not in `exclude` (0 in today's rule).\n   140\t * Returns the surviving count. */\n   141\tstatic int subset_pass(const search_t *s, const int *ids, const mask_t *opens,\n   142\t                       const int *sizes, int n_remaining, mask_t exclude,\n   143\t                       int *costs, int *who, int *index_of, int count) {\n   144\t    int kept = 0;\n   145\t    for (int i = 0; i < count; i++) {\n   146\t        int c = who[i];\n   147\t        int at = index_of[i];\n   148\t        mask_t own = opens[at];\n   149\t        int own_size = sizes[at];\n   150\t        int dominated = 0;\n   151\t        for (int j = 0; j < n_remaining && !dominated; j++) {\n   152\t            if (sizes[j] > own_size) continue;      /* cannot be a subset */\n   153\t            int d = ids[j];\n   154\t            if (d == c) continue;\n   155\t            if (exclude && ((exclude >> d) & 1)) continue;   /* BM_SUBSET_RESTRICTED */\n   156\t            mask_t other = opens[j];\n   157\t            if ((other & ~own) == 0 && (other != own || d < c)) dominated = 1;\n   158\t        }\n   159\t        if (!dominated) { costs[kept] = costs[i]; who[kept] = c;\n   160\t                          index_of[kept] = index_of[i]; kept++; }\n   161\t    }\n   162\t    /* Every candidate dominated by a non-candidate would empty the list;\n   163\t     * keep the original in that case, as the Python does. */\n   164\t    return kept ? kept : count;\n   165\t}\n   166\t\n   167\t/* Theorem 2 over the candidates in `costs`/`who`/`index_of`. Returns the\n   168\t * surviving count. */\n   169\tstatic int better_move_pass(const search_t *s, mask_t closed, mask_t opened,\n   170\t                            int *costs, int *who, int *index_of, int count,\n   171\t                            mask_t *discarded) {\n   172\t    /* Theorem 2, \"better move\". If S ++ [q] and S ++ [r, q] are both playable\n   173\t     * and close(q, S u {r}) >= open(q, S u {r}), then any solution extending\n   174\t     * S ++ [r] has one extending S ++ [q], so r can go. Theorem 1 is the case\n   175\t     * where one q beats every r at once