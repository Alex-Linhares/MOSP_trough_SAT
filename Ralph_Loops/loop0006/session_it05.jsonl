nnected graphs need nothing special: an isolated\n  vertex is put in and moved out in the same step, costing one place; so an\n  edgeless nonempty graph has `ν = 1 = pw + 1`.\n-/\n\nimport MOSPFormalization.VSEquivPW\n\nset_option linter.unusedSectionVars false\n\n93:def MovedAt (σ : LinearLayout V) (i : ℕ) (v : V) : Prop :=\n101:def shackAfterPut (σ : LinearLayout V) (i : ℕ) : Finset V :=\n105:def shackAfterMove (σ : LinearLayout V) (i : ℕ) : Finset V :=\n110:noncomputable def inNarrowness (σ : LinearLayout V) : ℕ :=\n116:noncomputable def narrowness : ℕ :=\n124:def EnteredBy (τ : LinearLayout V) (i : ℕ) (v : V) : Prop :=\n131:def outShackBeforeMove (τ : LinearLayout V) (i : ℕ) : Finset V :=\n135:def outShackAfterMove (τ : LinearLayout V) (i : ℕ) : Finset V :=\n140:noncomputable def outNarrowness (τ : LinearLayout V) : ℕ :=\n145:noncomputable def outNarrownessGraph : ℕ :=\n150:theorem mem_shackAfterPut_iff (σ : LinearLayout V) (i : ℕ) (v : V) :\n168:theorem shackAfterMove_subset_shackAfterPut (σ : LinearLayout V) (i : ℕ) :\n175:theorem outShackAfterMove_subset_outShackBeforeMove (τ : LinearLayout V) (i : ℕ) :\n183:theorem inNarrowness_eq_sup (σ : LinearLayout V) :\n192:theorem outNarrowness_eq_sup (τ : LinearLayout V) :\n204:def reverseLayout (σ : LinearLayout V) : LinearLayout V :=\n217:theorem sup_comp_rev {n : ℕ} (f : Fin n → ℕ) :\n227:theorem shackAfterPut_eq_insert_activeSuffix (σ : LinearLayout V)\n254:theorem card_shackAfterPut (σ : LinearLayout V) (i : Fin (Fintype.card V)) :\n265:theorem inNarrowness_eq_vertexSepOfLayout_reverse [Nonempty V] (σ : LinearLayout V) :\n296:theorem outShackBeforeMove_reverse (σ : LinearLayout V) (i : Fin (Fintype.card V)) :\n314:theorem outNarrowness_reverse (σ : LinearLayout V) :\n324:theorem exists_inNarrowness_iff_exists_outNarrowness (k : ℕ) :\n335:theorem outNarrownessGraph_eq_narrowness :\n344:theorem narrowness_eq_vertexSeparation_add_one [Nonempty V] :\n363:theorem narrowness_eq_pathwidth_add_one [Nonempty V] :\n368:the