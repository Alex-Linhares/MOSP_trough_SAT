ct\", 0.4, 0),\n    (\"L\", \"TH\", r\"$=\\theta(H)$\", \"exact\", 0.5, 0),\n    (\"TH\", \"PW\", r\"$\\theta=\\mathrm{pw}+1$\", \"exact\", 0.5, 0),\n    (\"VS\", \"PW\", r\"$\\mathrm{vs}=\\mathrm{pw}$\", \"exact\", 0.5, 0),\n    (\"NU\", \"PW\", r\"$\\nu=\\mathrm{pw}+1$\", \"exact\", 0.45, 0),\n    (\"VSG\", \"VS\", r\"$=\\max(1,\\mathrm{vs})$\", \"exact\", 0.45, 0),\n    (\"MNS\", \"VS\", r\"$=\\mathrm{vs}+1$\", \"exact\", 0.5, 0),\n    (\"NS\", \"MNS\", r\"$\\mathrm{ns}=\\mathrm{mns}$\", \"exact\", 0.5, 0),\n    (\"SB\", \"PW\", r\"$\\mathrm{pw}\\leq\\mathrm{sb}\\leq\\mathrm{pw}+1$\", \"band\", 0.4, 0),\n    (\"PES\", \"VS\", r\"$\\mathrm{vs}\\leq\\cdot\\leq\\mathrm{vs}+2$\", \"band\", 0.5, 0),\n    (\"ES\", \"VS\", \"\", \"band\", 0.5, 0),\n    (\"ES\", \"PES\", r\"$\\mathrm{es}=\\mathrm{pes}$?\", \"gap\", 0.5, 0),\n    (\"PLA\", \"T\", \"✗ gap unbounded\", \"false\", 0.5, -0.45),\n    (\"CW\", \"PW\", \"✗ unbounded\\non stars\", \"false\", 0.5, 0),\n]\n\n\ndef draw() -> Path:\n    import matplotlib\n    matplotlib.use(\"Agg\")\n    import matplotlib.pyplot as plt\n    plt.rcParams.update({\"pdf.fonttype\": 42, \"ps.fonttype\": 42, \"font.family\": \"DejaVu Sans\",\n                         \"mathtext.fontset\": \"dejavusans\"})\n\n    fig = plt.figure(figsize=(WIDTH, HEIGHT))\n    ax = fig.add_axes((0, 0, 1, 1))\n    ax.set_xlim(0, 6.75)\n    ax.set_ylim(-0.55, 3.45)\n    ax.axis(\"off\")\n\n    boxes = {}\n    for name, (x, y, label, false) in NODES.items():\n        hub = name == \"PW\"\n        boxes[name] = ax.text(\n            x, y, label, ha=\"center\", va=\"center\", fontsize=8 if hub else 7.5,\n            fontweight=\"bold\" if hub else \"normal\", color=RED if false else \"0.05\",\n            linespacing=1.15, zorder=3,\n            bbox=dict(boxstyle=\"round,pad=0.3\", fc=\"0.9\" if hub else \"white\",\n                      ec=RED if false else \"0.15\", lw=1.0 if hub else 0.6))\n    fig.canvas.draw()\n\n    styles = {\"exact\": (\"-\", \"0.15\"),