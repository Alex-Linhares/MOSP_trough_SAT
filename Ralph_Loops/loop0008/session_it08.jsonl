{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfeszGHCJntRs3y3QhBXr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011PuwDuvyYFZXdg5b26FJVW","name":"Write","input":{"file_path":"/home/al/dev/MOSP/paper2/latex/make_tables.py","content":"\"\"\"Paper 2's tables, generated from the recorded data (loop0008 item 08).\n\n    python -m paper2.latex.make_tables          # writes paper2/latex/tables/*.tex\n\nReads only; writes nothing outside `paper2/latex/tables/`. Every table the\nLaTeX draft inputs from `tables/` comes from here, and each file says in a\ncomment which records it was made from.\n\n- `names.tex`        section 2: name usage and citations (`paper2.section2_figures.numbers`,\n                     from the OpenAlex caches of 2026-09-29);\n- `cost.tex`         section 4: nodes, repaired against published rules\n                     (`paper2/data/solver_fix_cost_{mosp40,cs,cs125,pw}.csv`);\n- `split.tex`        section 4: the re-certifications of the root split\n                     (`paper2/data/solver_fix_split_{tasks,results}.csv`, read as they are now);\n- `certificates.tex` section 4: certificates under the repaired rules\n                     (`paper2/data/certificates/repaired.csv`);\n- `dataset.tex`      section 4: the dataset by collection\n                     (`paper2/data/dataset/classes.csv.gz`, `index.csv.gz`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport gzip\nfrom collections import Counter, defaultdict\nfrom datetime import datetime\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nDATA = ROOT / \"paper2\" / \"data\"\nOUT = Path(__file__).resolve().parent / \"tables\"\n\nDONE = {\"sat\", \"unsat\"}\n\n\ndef _n(x: int) -> str:\n    \"\"\"An integer with thin-space-free comma thousands, as the prose has it.\"\"\"\n    return f\"{x:,}\"\n\n\ndef _write(name: str, source: str, body: list[str]) -> str:\n    OUT.mkdir(exist_ok=True)\n    text = \"\\n\".join([f\"% Generated by python -m paper2.latex.make_tables. Source: {source}.\",\n                      \"% Do not edit by hand.\", *body]) + \"\\n\"\n    (OUT / name).write_text(text)\n    return text\n\n\n# --- section 2 -------------------------------------------------------------\n\nORDER = [  # (key in numbers()[\"names\"], printed name, Table 1 ref keys, discipline)\n    (\"graph path-width\", \"Path-width\", [\"13\"], \"graph theory\"),\n    (\"gate matrix layout\", \"Gate matrix layout\", [\"6\", \"8\"], \"VLSI\"),\n    (\"PLA folding\", \"PLA folding\", [\"6\"], \"VLSI\"),\n    (\"MOSP\", \"MOSP\", [\"1\", \"4\"], \"operations research\"),\n    (\"vertex separation\", \"Vertex separation\", [\"13\"], \"graph theory\"),\n    (\"edge search game\", \"Edge search\", [\"10\"], \"graph theory\"),\n    (\"node search game\", \"Node search\", [\"9\"], \"graph theory\"),\n    (\"one-dimensional logic\", \"One-dimensional logic\", [\"7\"], \"VLSI\"),\n    (\"interval thickness\", \"Interval thickness\", [\"5\"], \"graph theory\"),\n    (\"narrowness\", \"Narrowness\", [\"11\"], \"graph theory\"),\n    (\"split bandwidth\", \"Split bandwidth\", [\"12\"], \"graph theory\"),\n    (\"edge separation\", \"Edge separation\", [\"14\"], \"graph theory\"),\n]\nCITE = {\"1\": \"LY2002ref1\", \"4\": \"LY2002ref4\", \"5\": \"LY2002ref5\", \"6\": \"LY2002ref6\",\n        \"7\": \"LY2002ref7\", \"8\": \"LY2002ref8\", \"9\": \"LY2002ref9\", \"10\": \"LY2002ref10\",\n        \"11\": \"LY2002ref11\", \"12\": \"LY2002ref12\", \"13\": \"LY2002ref13\", \"14\": \"LY2002ref14\"}\n\n\ndef names_table() -> str:\n    from paper2.section2_figures import numbers\n    num = numbers()\n    n, cited = num[\"names\"], num[\"cited_by\"]\n    rows = []\n    for key, label, refs, disc in ORDER:\n        c = \" / \".join(_n(cited[r]) if r in cited else \"--\" for r in refs)\n        src = \"; \".join(f\"\\\\citet{{{CITE[r]}}}\" for r in refs)\n        rel = _n(n[key][\"relevant\"])\n        if key == \"graph path-width\":\n            rel += \"$^{a}$\"\n        rows.append(f\"{label} & {disc} & {rel} & {_n(n[key]['hits'])} & {src} & {c} \\\\\\\\\")\n    pw = n[\"graph path-width\"]\n    small = sum(v[\"relevant\"] for k, v in n.items() if k != \"graph path-width\")\n    body = [\n        \"\\\\begin{tabular}{@{}llrrp{4.6cm}r@{}}\",\n        \"\\\\toprule\",\n        \"Problem & Discipline & Relevant & Hits & Table~1 reference & Citations \\\\\\\\\",\n        \"\\\\midrule\", *rows, \"\\\\midrule\",\n        f\"All twelve & & {_n(pw['relevant'] + small)} & {_n(num['hits_total'])} & & \\\\\\\\\",\n        \"\\\\bottomrule\", \"\\\\end{tabular}\",\n        f\"% check: other eleven = {small}; pathwidth distinct = {pw['distinct']}; \"\n        f\"fetched {num['candidates_fetched']}, citations {num['citations_fetched']}\",\n    ]\n    return _write(\"names.tex\", \"paper2.section2_figures.numbers() (OpenAlex caches, \"\n                  f\"{num['candidates_fetched']})\", body)\n\n\n# --- section 4: cost -------------------------------------------------------\n\ndef _mosp_pairs(stage: str, config: str):\n    d = defaultdict(dict)\n    with open(DATA / f\"solver_fix_cost_{stage}.csv\") as f:\n        for r in csv.DictReader(f):\n            if r[\"config\"] == config:\n                d[(r[\"instance_name\"], r[\"k\"])][r[\"setting\"]] = r\n    total = both = 0\n    old = rep = 0\n    worst = 0.0\n    for v in d.values():\n        if len(v) < 2:\n            continue\n        total += 1\n        o, r = v[\"old\"], v[\"repaired\"]\n        if o[\"status\"] in DONE and r[\"status\"] in DONE:\n            both += 1\n            old += int(o[\"nodes\"])\n            rep += int(r[\"nodes\"])\n            if int(o[\"nodes\"]):\n                worst = max(worst, int(r[\"nodes\"]) / int(o[\"nodes\"]))\n    return total, both, old, rep, worst\n\n\ndef _pw_pairs():\n    rows = list(csv.DictReader(open(DATA / \"solver_fix_cost_pw.csv\")))\n    # a job writes its two rows together; the pair is the row order (as solver_fix_cost_tables)\n    total = both = old = rep = 0\n    for i in range(0, len(rows), 2):\n        a, b = rows[i], rows[i + 1]\n        assert {a[\"setting\"], b[\"setting\"]} == {\"old\", \"repaired\"}\n        o, r = (a, b) if a[\"setting\"] == \"old\" else (b, a)\n        total += 1\n        if o[\"proof\"] in (\"refutation\", \"bound\") and r[\"proof\"] in (\"refutation\", \"bound\"):\n            both += 1\n            old += int(o[\"nodes\"])\n            rep += int(r[\"nodes\"])\n    return total, both, old, rep\n\n\ndef cost_table() -> str:\n    lines = []\n    for stage, config, label, size in [\n        (\"mosp40\", \"default\", \"MOSP corpus, \\\\texttt{default}\", \"9--40\"),\n        (\"mosp40\", \"csearch\", \"MOSP corpus, \\\\texttt{csearch}\", \"9--40\"),\n        (\"cs\", \"csearch\", \"Chu \\\\& Stuckey classes\", \"50--100\"),\n        (\"cs125\", \"csearch\", \"Chu \\\\& Stuckey classes, cap $2\\\\times10^8$ nodes\", \"125\"),\n    ]:\n        total, both, old, rep, worst = _mosp_pairs(stage, config)\n        lines.append(f\"{label} & {size} & {_n(both)} of {_n(total)} & {_n(old)} & {_n(rep)} & \"\n                     f\"{rep / old:.5f} & {worst:.3f} \\\\\\\\\")\n    total, both, old, rep = _pw_pairs()\n    lines.append(f\"Graph pathwidth, whole descents & 4--2{{,}}916 & {_n(both)} of {_n(total)} & \"\n                 f\"{_n(old)} & {_n(rep)} & {rep / old:.3f} & -- \\\\\\\\\")\n    body = [\"\\\\begin{tabular}{@{}llrrrrr@{}}\", \"\\\\toprule\",\n            \"Where & Vertices & Pairs finished & Nodes, published & Nodes, repaired & Ratio & \"\n            \"Worst pair \\\\\\\\\", \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    return _write(\"cost.tex\", \"paper2/data/solver_fix_cost_{mosp40,cs,cs125,pw}.csv\", body)\n\n\n# --- section 4: the root split ----------------------------------------------\n\ndef split_table() -> str:\n    from paper2.solver_fix_split import RESULTS, TASKS, _read_rows, targets\n    rows = _read_rows(TASKS)\n    finished = {r[\"instance_name\"]: r for r in _read_rows(RESULTS)}\n    lines = []\n    for t in targets():\n        name = t[\"instance_name\"]\n        mine = [r for r in rows if r[\"instance_name\"] == name and int(r[\"k\"]) == t[\"k\"]]\n        done = [r for r in mine if r[\"kind\"] == \"task\" and r[\"status\"] == \"unsat\"]\n        secs = sum(float(r[\"seconds\"] or 0) for r in mine)\n        if name in finished:\n            state, nodes = \"refuted\", int(finished[name][\"total_nodes\"])\n        else:\n            state = \"in flight\" if mine else \"not started\"\n            nodes = sum(int(r[\"nodes\"]) for r in done)\n        mant, exp = f\"{nodes:.2e}\".split(\"e\")\n        lines.append(f\"\\\\texttt{{{name}}} & {t['value']} & {t['k']} & {state} & {_n(len(done))} & \"\n                     f\"${mant}\\\\times10^{{{int(exp)}}}$ & {secs / 3600:.1f} \\\\\\\\\")\n    stamp = max((r.get(\"finished\") or r.get(\"time\") or \"\" for r in rows), default=\"\")\n    body = [\"\\\\begin{tabular}{@{}lrrlrrr@{}}\", \"\\\\toprule\",\n            \"Instance & Value & $k$ & State & Tasks refuted & Nodes & Core-hours \\\\\\\\\",\n            \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\",\n            f\"% read {datetime.now():%Y-%m-%d %H:%M}; last task stamp {stamp}\"]\n    return _write(\"split.tex\", \"paper2/data/solver_fix_split_{tasks,results}.csv, \"\n                  f\"read {datetime.now():%Y-%m-%d %H:%M}\", body)\n\n\n# --- section 4: certificates -------------------------------------------------\n\nBANDS = [(9, 10), (11, 20), (21, 30), (31, 40), (41, 50), (51, 60), (61, 75)]\n\n\ndef certificates_table() -> str:\n    rows = list(csv.DictReader(open(DATA / \"certificates\" / \"repaired.csv\")))\n    lines = []\n    tot = Counter()\n    for config in (\"csearch\", \"default\"):\n        for lo, hi in BANDS:\n            x = [r for r in rows if r[\"config\"] == config and lo <= int(r[\"n\"]) <= hi]\n            if not x or (config == \"default\" and hi <= 40):\n                continue\n            ref = [r for r in x if r[\"status\"] == \"unsat\"]\n            ok = [r for r in ref if r[\"check_ok\"] == \"True\"]\n            rej = [r for r in ref if r[\"check_ok\"] == \"False\"]\n            gz = sorted(int(r[\"gz_bytes\"]) for r in ok)\n            ms = sorted(1000 * float(r[\"check_seconds\"]) for r in ok)\n            med = lambda v: v[len(v) // 2] if v else 0  # noqa: E731\n            lines.append(f\"{lo}--{hi} & \\\\texttt{{{config}}} & {_n(len(x))} & {_n(len(ok))} & \"\n                         f\"{len(rej)} & {_n(len(x) - len(ref))} & \"\n                         f\"{_n(sum(int(r['steps_definite']) for r in ok))} & \"\n                         f\"{_n(sum(int(r['steps_better']) for r in ok))} & \"\n                         f\"{_n(sum(int(r['matching_edges']) for r in ok))} & \"\n                         f\"{_n(med(gz))} & {med(ms):.2f} \\\\\\\\\")\n        if config == \"csearch\":\n            lines.append(\"\\\\midrule\")\n        for r in rows:\n            if r[\"config\"] == config:\n                tot[(config, \"n\")] += 1\n                tot[(config, \"ok\")] += r[\"check_ok\"] == \"True\"\n                tot[(config, \"rej\")] += r[\"status\"] == \"unsat\" and r[\"check_ok\"] == \"False\"\n                if r[\"check_ok\"] == \"True\":\n                    tot[(config, \"gz\")] += int(r[\"gz_bytes\"])\n                    tot[(config, \"s\")] += float(r[\"check_seconds\"])\n                    tot[(config, \"nodes\")] += int(r[\"nodes\"])\n    body = [\"\\\\begin{tabular}{@{}llrrrrrrrrr@{}}\", \"\\\\toprule\",\n            \"Customers & Config. & Inst. & Verified & Rejected & Unknown & Definite & Better & \"\n            \"Matching edges & gz bytes (median) & Check ms (median) \\\\\\\\\",\n            \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    for c in (\"csearch\", \"default\"):\n        body.append(f\"% total {c}: {tot[(c, 'ok')]} of {tot[(c, 'n')]} verified, \"\n                    f\"{tot[(c, 'rej')]} rejected, {tot[(c, 'gz')] / 1e6:.2f} MB gz, \"\n                    f\"{tot[(c, 's')]:.1f} s, {tot[(c, 'nodes')]} nodes\")\n    return _write(\"certificates.tex\", \"paper2/data/certificates/repaired.csv\", body)\n\n\n# --- section 4: dataset ------------------------------------------------------\n\ndef dataset_table() -> str:\n    with gzip.open(DATA / \"dataset\" / \"index.csv.gz\", \"rt\") as f:\n        idx = list(csv.DictReader(f))\n    with gzip.open(DATA / \"dataset\" / \"classes.csv.gz\", \"rt\") as f:\n        cls = list(csv.DictReader(f))\n    files = Counter(r[\"collection\"] for r in idx)\n    distinct = defaultdict(set)\n    for r in idx:\n        distinct[r[\"collection\"]].add(r[\"cls\"])\n    order = list(dict.fromkeys(r[\"collection\"] for r in idx))\n    prov = defaultdict(Counter)\n    for c in cls:\n        p = c[\"provenance\"] or \"none\"\n        if c[\"witness\"] != \"1\" and p != \"none\":\n            p = \"nowit\"\n        prov[c[\"owner\"]][p] += 1\n    lines = []\n    tot = Counter()\n    for col in order:\n        p = prov[col]\n        new = sum(p.values())\n        row = [files[col], len(distinct[col]), new, p[\"certified:refutation\"],\n               p[\"certified:bound\"], p[\"solution\"], p[\"nowit\"] + p[\"none\"]]\n        for i, v in enumerate(row):\n            if i != 1:\n                tot[i] += v\n        label = col.replace(\"&\", \"\\\\&\")\n        lines.append(f\"{label} & \" + \" & \".join(_n(v) for v in row) + \" \\\\\\\\\")\n    lines.append(\"\\\\midrule\")\n    lines.append(\"All & \" + \" & \".join(\"\" if i == 1 else _n(tot[i]) for i in range(7)) + \" \\\\\\\\\")\n    body = [\"\\\\begin{tabular}{@{}lrrrrrrr@{}}\", \"\\\\toprule\",\n            \"Collection & Files & Classes & Owned & Refutation & Bound & Upper bound & \"\n            \"No witnessed value \\\\\\\\\", \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    return _write(\"dataset.tex\", \"paper2/data/dataset/{index,classes}.csv.gz\", body)\n\n\ndef main() -> None:\n    for f in (names_table, cost_table, split_table, certificates_table, dataset_table):\n        text = f()\n        print(text.splitlines()[0])\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2618,"cache_read_input_tokens":235963,"cache_creation":{"ephemeral_5m_input_tokens":2618,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7884aff6-aa71-4f85-a709-a301fa2453ad","uuid":"2e6760c8-f9dc-4d42-bf46-27fdc59e46fd","timestamp":"2026-10-03T07:06:51.372Z","request_id":"req_011CfeszFsNznUb2QMLP3aQD","wire_tool_inputs":{"toolu_011PuwDuvyYFZXdg5b26FJVW":{"file_path":"/home/al/dev/MOSP/paper2/latex/make_tables.py","content":"\"\"\"Paper 2's tables, generated from the recorded data (loop0008 item 08).\n\n    python -m paper2.latex.make_tables          # writes paper2/latex/tables/*.tex\n\nReads only; writes nothing outside `paper2/latex/tables/`. Every table the\nLaTeX draft inputs from `tables/` comes from here, and each file says in a\ncomment which records it was made from.\n\n- `names.tex`        section 2: name usage and citations (`paper2.section2_figures.numbers`,\n                     from the OpenAlex caches of 2026-09-29);\n- `cost.tex`         section 4: nodes, repaired against published rules\n                     (`paper2/data/solver_fix_cost_{mosp40,cs,cs125,pw}.csv`);\n- `split.tex`        section 4: the re-certifications of the root split\n                     (`paper2/data/solver_fix_split_{tasks,results}.csv`, read as they are now);\n- `certificates.tex` section 4: certificates under the repaired rules\n                     (`paper2/data/certificates/repaired.csv`);\n- `dataset.tex`      section 4: the dataset by collection\n                     (`paper2/data/dataset/classes.csv.gz`, `index.csv.gz`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport gzip\nfrom collections import Counter, defaultdict\nfrom datetime import datetime\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nDATA = ROOT / \"paper2\" / \"data\"\nOUT = Path(__file__).resolve().parent / \"tables\"\n\nDONE = {\"sat\", \"unsat\"}\n\n\ndef _n(x: int) -> str:\n    \"\"\"An integer with thin-space-free comma thousands, as the prose has it.\"\"\"\n    return f\"{x:,}\"\n\n\ndef _write(name: str, source: str, body: list[str]) -> str:\n    OUT.mkdir(exist_ok=True)\n    text = \"\\n\".join([f\"% Generated by python -m paper2.latex.make_tables. Source: {source}.\",\n                      \"% Do not edit by hand.\", *body]) + \"\\n\"\n    (OUT / name).write_text(text)\n    return text\n\n\n# --- section 2 -------------------------------------------------------------\n\nORDER = [  # (key in numbers()[\"names\"], printed name, Table 1 ref keys, discipline)\n    (\"graph path-width\", \"Path-width\", [\"13\"], \"graph theory\"),\n    (\"gate matrix layout\", \"Gate matrix layout\", [\"6\", \"8\"], \"VLSI\"),\n    (\"PLA folding\", \"PLA folding\", [\"6\"], \"VLSI\"),\n    (\"MOSP\", \"MOSP\", [\"1\", \"4\"], \"operations research\"),\n    (\"vertex separation\", \"Vertex separation\", [\"13\"], \"graph theory\"),\n    (\"edge search game\", \"Edge search\", [\"10\"], \"graph theory\"),\n    (\"node search game\", \"Node search\", [\"9\"], \"graph theory\"),\n    (\"one-dimensional logic\", \"One-dimensional logic\", [\"7\"], \"VLSI\"),\n    (\"interval thickness\", \"Interval thickness\", [\"5\"], \"graph theory\"),\n    (\"narrowness\", \"Narrowness\", [\"11\"], \"graph theory\"),\n    (\"split bandwidth\", \"Split bandwidth\", [\"12\"], \"graph theory\"),\n    (\"edge separation\", \"Edge separation\", [\"14\"], \"graph theory\"),\n]\nCITE = {\"1\": \"LY2002ref1\", \"4\": \"LY2002ref4\", \"5\": \"LY2002ref5\", \"6\": \"LY2002ref6\",\n        \"7\": \"LY2002ref7\", \"8\": \"LY2002ref8\", \"9\": \"LY2002ref9\", \"10\": \"LY2002ref10\",\n        \"11\": \"LY2002ref11\", \"12\": \"LY2002ref12\", \"13\": \"LY2002ref13\", \"14\": \"LY2002ref14\"}\n\n\ndef names_table() -> str:\n    from paper2.section2_figures import numbers\n    num = numbers()\n    n, cited = num[\"names\"], num[\"cited_by\"]\n    rows = []\n    for key, label, refs, disc in ORDER:\n        c = \" / \".join(_n(cited[r]) if r in cited else \"--\" for r in refs)\n        src = \"; \".join(f\"\\\\citet{{{CITE[r]}}}\" for r in refs)\n        rel = _n(n[key][\"relevant\"])\n        if key == \"graph path-width\":\n            rel += \"$^{a}$\"\n        rows.append(f\"{label} & {disc} & {rel} & {_n(n[key]['hits'])} & {src} & {c} \\\\\\\\\")\n    pw = n[\"graph path-width\"]\n    small = sum(v[\"relevant\"] for k, v in n.items() if k != \"graph path-width\")\n    body = [\n        \"\\\\begin{tabular}{@{}llrrp{4.6cm}r@{}}\",\n        \"\\\\toprule\",\n        \"Problem & Discipline & Relevant & Hits & Table~1 reference & Citations \\\\\\\\\",\n        \"\\\\midrule\", *rows, \"\\\\midrule\",\n        f\"All twelve & & {_n(pw['relevant'] + small)} & {_n(num['hits_total'])} & & \\\\\\\\\",\n        \"\\\\bottomrule\", \"\\\\end{tabular}\",\n        f\"% check: other eleven = {small}; pathwidth distinct = {pw['distinct']}; \"\n        f\"fetched {num['candidates_fetched']}, citations {num['citations_fetched']}\",\n    ]\n    return _write(\"names.tex\", \"paper2.section2_figures.numbers() (OpenAlex caches, \"\n                  f\"{num['candidates_fetched']})\", body)\n\n\n# --- section 4: cost -------------------------------------------------------\n\ndef _mosp_pairs(stage: str, config: str):\n    d = defaultdict(dict)\n    with open(DATA / f\"solver_fix_cost_{stage}.csv\") as f:\n        for r in csv.DictReader(f):\n            if r[\"config\"] == config:\n                d[(r[\"instance_name\"], r[\"k\"])][r[\"setting\"]] = r\n    total = both = 0\n    old = rep = 0\n    worst = 0.0\n    for v in d.values():\n        if len(v) < 2:\n            continue\n        total += 1\n        o, r = v[\"old\"], v[\"repaired\"]\n        if o[\"status\"] in DONE and r[\"status\"] in DONE:\n            both += 1\n            old += int(o[\"nodes\"])\n            rep += int(r[\"nodes\"])\n            if int(o[\"nodes\"]):\n                worst = max(worst, int(r[\"nodes\"]) / int(o[\"nodes\"]))\n    return total, both, old, rep, worst\n\n\ndef _pw_pairs():\n    rows = list(csv.DictReader(open(DATA / \"solver_fix_cost_pw.csv\")))\n    # a job writes its two rows together; the pair is the row order (as solver_fix_cost_tables)\n    total = both = old = rep = 0\n    for i in range(0, len(rows), 2):\n        a, b = rows[i], rows[i + 1]\n        assert {a[\"setting\"], b[\"setting\"]} == {\"old\", \"repaired\"}\n        o, r = (a, b) if a[\"setting\"] == \"old\" else (b, a)\n        total += 1\n        if o[\"proof\"] in (\"refutation\", \"bound\") and r[\"proof\"] in (\"refutation\", \"bound\"):\n            both += 1\n            old += int(o[\"nodes\"])\n            rep += int(r[\"nodes\"])\n    return total, both, old, rep\n\n\ndef cost_table() -> str:\n    lines = []\n    for stage, config, label, size in [\n        (\"mosp40\", \"default\", \"MOSP corpus, \\\\texttt{default}\", \"9--40\"),\n        (\"mosp40\", \"csearch\", \"MOSP corpus, \\\\texttt{csearch}\", \"9--40\"),\n        (\"cs\", \"csearch\", \"Chu \\\\& Stuckey classes\", \"50--100\"),\n        (\"cs125\", \"csearch\", \"Chu \\\\& Stuckey classes, cap $2\\\\times10^8$ nodes\", \"125\"),\n    ]:\n        total, both, old, rep, worst = _mosp_pairs(stage, config)\n        lines.append(f\"{label} & {size} & {_n(both)} of {_n(total)} & {_n(old)} & {_n(rep)} & \"\n                     f\"{rep / old:.5f} & {worst:.3f} \\\\\\\\\")\n    total, both, old, rep = _pw_pairs()\n    lines.append(f\"Graph pathwidth, whole descents & 4--2{{,}}916 & {_n(both)} of {_n(total)} & \"\n                 f\"{_n(old)} & {_n(rep)} & {rep / old:.3f} & -- \\\\\\\\\")\n    body = [\"\\\\begin{tabular}{@{}llrrrrr@{}}\", \"\\\\toprule\",\n            \"Where & Vertices & Pairs finished & Nodes, published & Nodes, repaired & Ratio & \"\n            \"Worst pair \\\\\\\\\", \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    return _write(\"cost.tex\", \"paper2/data/solver_fix_cost_{mosp40,cs,cs125,pw}.csv\", body)\n\n\n# --- section 4: the root split ----------------------------------------------\n\ndef split_table() -> str:\n    from paper2.solver_fix_split import RESULTS, TASKS, _read_rows, targets\n    rows = _read_rows(TASKS)\n    finished = {r[\"instance_name\"]: r for r in _read_rows(RESULTS)}\n    lines = []\n    for t in targets():\n        name = t[\"instance_name\"]\n        mine = [r for r in rows if r[\"instance_name\"] == name and int(r[\"k\"]) == t[\"k\"]]\n        done = [r for r in mine if r[\"kind\"] == \"task\" and r[\"status\"] == \"unsat\"]\n        secs = sum(float(r[\"seconds\"] or 0) for r in mine)\n        if name in finished:\n            state, nodes = \"refuted\", int(finished[name][\"total_nodes\"])\n        else:\n            state = \"in flight\" if mine else \"not started\"\n            nodes = sum(int(r[\"nodes\"]) for r in done)\n        mant, exp = f\"{nodes:.2e}\".split(\"e\")\n        lines.append(f\"\\\\texttt{{{name}}} & {t['value']} & {t['k']} & {state} & {_n(len(done))} & \"\n                     f\"${mant}\\\\times10^{{{int(exp)}}}$ & {secs / 3600:.1f} \\\\\\\\\")\n    stamp = max((r.get(\"finished\") or r.get(\"time\") or \"\" for r in rows), default=\"\")\n    body = [\"\\\\begin{tabular}{@{}lrrlrrr@{}}\", \"\\\\toprule\",\n            \"Instance & Value & $k$ & State & Tasks refuted & Nodes & Core-hours \\\\\\\\\",\n            \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\",\n            f\"% read {datetime.now():%Y-%m-%d %H:%M}; last task stamp {stamp}\"]\n    return _write(\"split.tex\", \"paper2/data/solver_fix_split_{tasks,results}.csv, \"\n                  f\"read {datetime.now():%Y-%m-%d %H:%M}\", body)\n\n\n# --- section 4: certificates -------------------------------------------------\n\nBANDS = [(9, 10), (11, 20), (21, 30), (31, 40), (41, 50), (51, 60), (61, 75)]\n\n\ndef certificates_table() -> str:\n    rows = list(csv.DictReader(open(DATA / \"certificates\" / \"repaired.csv\")))\n    lines = []\n    tot = Counter()\n    for config in (\"csearch\", \"default\"):\n        for lo, hi in BANDS:\n            x = [r for r in rows if r[\"config\"] == config and lo <= int(r[\"n\"]) <= hi]\n            if not x or (config == \"default\" and hi <= 40):\n                continue\n            ref = [r for r in x if r[\"status\"] == \"unsat\"]\n            ok = [r for r in ref if r[\"check_ok\"] == \"True\"]\n            rej = [r for r in ref if r[\"check_ok\"] == \"False\"]\n            gz = sorted(int(r[\"gz_bytes\"]) for r in ok)\n            ms = sorted(1000 * float(r[\"check_seconds\"]) for r in ok)\n            med = lambda v: v[len(v) // 2] if v else 0  # noqa: E731\n            lines.append(f\"{lo}--{hi} & \\\\texttt{{{config}}} & {_n(len(x))} & {_n(len(ok))} & \"\n                         f\"{len(rej)} & {_n(len(x) - len(ref))} & \"\n                         f\"{_n(sum(int(r['steps_definite']) for r in ok))} & \"\n                         f\"{_n(sum(int(r['steps_better']) for r in ok))} & \"\n                         f\"{_n(sum(int(r['matching_edges']) for r in ok))} & \"\n                         f\"{_n(med(gz))} & {med(ms):.2f} \\\\\\\\\")\n        if config == \"csearch\":\n            lines.append(\"\\\\midrule\")\n        for r in rows:\n            if r[\"config\"] == config:\n                tot[(config, \"n\")] += 1\n                tot[(config, \"ok\")] += r[\"check_ok\"] == \"True\"\n                tot[(config, \"rej\")] += r[\"status\"] == \"unsat\" and r[\"check_ok\"] == \"False\"\n                if r[\"check_ok\"] == \"True\":\n                    tot[(config, \"gz\")] += int(r[\"gz_bytes\"])\n                    tot[(config, \"s\")] += float(r[\"check_seconds\"])\n                    tot[(config, \"nodes\")] += int(r[\"nodes\"])\n    body = [\"\\\\begin{tabular}{@{}llrrrrrrrrr@{}}\", \"\\\\toprule\",\n            \"Customers & Config. & Inst. & Verified & Rejected & Unknown & Definite & Better & \"\n            \"Matching edges & gz bytes (median) & Check ms (median) \\\\\\\\\",\n            \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    for c in (\"csearch\", \"default\"):\n        body.append(f\"% total {c}: {tot[(c, 'ok')]} of {tot[(c, 'n')]} verified, \"\n                    f\"{tot[(c, 'rej')]} rejected, {tot[(c, 'gz')] / 1e6:.2f} MB gz, \"\n                    f\"{tot[(c, 's')]:.1f} s, {tot[(c, 'nodes')]} nodes\")\n    return _write(\"certificates.tex\", \"paper2/data/certificates/repaired.csv\", body)\n\n\n# --- section 4: dataset ------------------------------------------------------\n\ndef dataset_table() -> str:\n    with gzip.open(DATA / \"dataset\" / \"index.csv.gz\", \"rt\") as f:\n        idx = list(csv.DictReader(f))\n    with gzip.open(DATA / \"dataset\" / \"classes.csv.gz\", \"rt\") as f:\n        cls = list(csv.DictReader(f))\n    files = Counter(r[\"collection\"] for r in idx)\n    distinct = defaultdict(set)\n    for r in idx:\n        distinct[r[\"collection\"]].add(r[\"cls\"])\n    order = list(dict.fromkeys(r[\"collection\"] for r in idx))\n    prov = defaultdict(Counter)\n    for c in cls:\n        p = c[\"provenance\"] or \"none\"\n        if c[\"witness\"] != \"1\" and p != \"none\":\n            p = \"nowit\"\n        prov[c[\"owner\"]][p] += 1\n    lines = []\n    tot = Counter()\n    for col in order:\n        p = prov[col]\n        new = sum(p.values())\n        row = [files[col], len(distinct[col]), new, p[\"certified:refutation\"],\n               p[\"certified:bound\"], p[\"solution\"], p[\"nowit\"] + p[\"none\"]]\n        for i, v in enumerate(row):\n            if i != 1:\n                tot[i] += v\n        label = col.replace(\"&\", \"\\\\&\")\n        lines.append(f\"{label} & \" + \" & \".join(_n(v) for v in row) + \" \\\\\\\\\")\n    lines.append(\"\\\\midrule\")\n    lines.append(\"All & \" + \" & \".join(\"\" if i == 1 else _n(tot[i]) for i in range(7)) + \" \\\\\\\\\")\n    body = [\"\\\\begin{tabular}{@{}lrrrrrrr@{}}\", \"\\\\toprule\",\n            \"Collection & Files & Classes & Owned & Refutation & Bound & Upper bound & \"\n            \"No witnessed value \\\\\\\\\", \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    return _write(\"dataset.tex\", \"paper2/data/dataset/{index,classes}.csv.gz\", body)\n\n\ndef main() -> None:\n    for f in (names_table, cost_table, split_table, certificates_table, dataset_table):\n        text = f()\n        print(text.splitlines()[0])\n\n\nif __name__ == \"__main__\":\n    main()\n"}}}
