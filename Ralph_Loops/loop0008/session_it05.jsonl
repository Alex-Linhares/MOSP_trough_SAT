{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0152cWUAeEhYXwjjHbB8gXvZ","type":"tool_result","content":"def certified_targets(instance_dir: Path, solutions_dir: Path,\n                      max_customers: int, limit: int | None = None) -> list[tuple]:\n    \"\"\"Every certified instance small enough to run, as picklable job tuples.\"\"\"\n    jobs = []\n    for filepath, instance in enumerate_instances(instance_dir):\n        if instance.n_customers > max_customers or instance.n_patterns == 0:\n            continue\n        path = _solution_path(instance, solutions_dir)\n        if not path.exists():\n            continue\n        data = json.loads(path.read_text())\n        if data.get(\"provenance\") not in CERTIFIED:\n            continue\n        optimum = int(data[\"mosp_value\"])\n        if optimum <= 1:\n            continue          # nothing to refute below 1\n        collection = filepath.parts[2] if len(filepath.parts) > 2 else \"\"\n        jobs.append((instance.matrix.tolist(), instance.name, str(filepath),\n                     collection, optimum, None))\n    if limit is not None:\n        jobs = jobs[:limit]\n    return jobs\n\n\ndef run(jobs: list[tuple], deadline_seconds: float, workers: int) -> pd.DataFrame:\ncandidates_to_classify.tsv\ncomplex_check.json\ndataset\ndataset_index.log\ndataset_run.log\ndataset_run2.log\nopenalex_candidates.json\nopenalex_citations.json\nopenalex_trends.json\npebbling_check.json\npebbling_gu_check.json\npebbling_strategy_check.json\nprior_art\nrelevance_labels.json\nsearch_better_check.json\nsearch_check.json\nsearch_decide_check.json\nsearch_definite_check.json\nsearch_hall_check.json\nsearch_memo_check.json\nsearch_model_check.json\nsearch_subset_check.json\nsolver_fix_bench.csv\nsolver_fix_bench_tables.md\nsolver_fix_c_check.json\nsolver_fix_check.json\nsolver_fix_cost_cs.csv\nsolver_fix_cost_cs.log\nsolver_fix_cost_cs125.csv\nsolver_fix_cost_cs125.log","is_error":false}]},"parent_tool_