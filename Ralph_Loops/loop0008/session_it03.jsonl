Basic.lean:531:theorem orderCost_orderOfLayout_le_iff (τ : LinearLayout V) (k : ℕ) :\nBasic.lean:548:theorem orderCost_ofFn_eq_outNarrowness (τ : LinearLayout V) :\nBasic.lean:554:theorem orderCost_ofFn_eq_vertexSepOfLayout_add_one [Nonempty V] (τ : LinearLayout V) :\nBasic.lean:562:theorem solvable_empty_iff_exists_outNarrowness_le (k : ℕ) :\nBasic.lean:572:theorem solvable_empty_iff_narrowness_le (k : ℕ) :\nBasic.lean:584:theorem searchSol_empty_iff_narrowness_le (k : ℕ) :\nBasic.lean:588:theorem searchSol_empty_iff_vertexSeparation_add_one_le [Nonempty V] (k : ℕ) :\nBasic.lean:593:theorem searchSol_empty_iff_pathwidth_add_one_le [Nonempty V] (k : ℕ) :\nBasic.lean:600:theorem searchSol_mospGraph_iff_mospValue_le {C Pt : Type*} [Fintype C] [DecidableEq C]\nDefiniteMove.lean:56:definitions and checks them by brute force; see `paper2/search_soundness.md` §4.2.\nDefiniteMove.lean:75:def openStacks (T : Finset V) : ℕ := (opened G T \\ T).card\nDefiniteMove.lean:78:def newlyOpened (S : Finset V) (c : V) : Finset V := nbhd G c \\ opened G S\nDefiniteMove.lean:81:def openCount (S : Finset V) (c : V) : ℕ := (newlyOpened G S c).card\nDefiniteMove.lean:85:def closeCount (S : Finset V) (q : V) : ℕ :=\nDefiniteMove.lean:89:def IsDefinite (S : Finset V) (q : V) : Prop := openCount G S q ≤ closeCount G S q\nDefiniteMove.lean:93:def IsHereditarilyDefinite (S : Finset V) (q : V) : Prop :=\nDefiniteMove.lean:104:theorem openStacks_add_card (T : Finset V) : openStacks G T + T.card = (opened G T).card :=\nDefiniteMove.lean:107:theorem opened_union (A B : Finset V) : opened G (A ∪ B) = opened G A ∪ opened G B := by\nDefiniteMove.lean:118:theorem opened_inter_subset (A B : Finset V) :\nDefiniteMove.lean:124:theorem openStacks_submodular (A B : Finset V) :\nDefiniteMove.lean:137:theorem stepCost_eq_openStacks_insert_add_one {T : Finset V} {c : V} (hc : c ∉ T) :\nDefiniteMove.lean:154:theorem cl_cl (T : Finset V) : cl G (cl G T) = cl G T := by\nDefiniteMove.lean:159:theorem subset_cl_ins