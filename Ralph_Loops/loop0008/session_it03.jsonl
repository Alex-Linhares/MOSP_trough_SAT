\nit is committable from `{2}`, with border `2` against the child's `3`. -/\\ntheorem cex_isCommittable_234 :\\n    IsCommittable cexGraph {2} {2, 3, 4} ∧ openStacks cexGraph {2, 3, 4} = 2 ∧\\n      openStacks cexGraph (cl cexGraph (insert 0 {2})) = 3 := by\\n  refine ⟨⟨by decide, fun X hSX hXW => ?_⟩, by decide, by rw [cex_cl_insert]; decide⟩\\n  have hX : X ∈ ({2, 3, 4} : Finset (Fin 14)).powerset := Finset.mem_powerset.2 hXW\\n  revert hSX\\n  revert X\\n  decide\\n\\nend Search\\n\\nend MOSPFormalization'''\\nassert s.endswith(\\\"end Search\\\\n\\\\nend MOSPFormalization\\\")\\ns=s[:-len(\\\"end Search\\\\n\\\\nend MOSPFormalization\\\")].rstrip()+tail+\\\"\\\\n\\\"\\nopen(p,'w').write(s)\\nE\\ngrep -n \\\"cex_cl_insert\\\" MOSPFormalization/Search/DefiniteMove.lean | head -3; time timeout 1500 lake env lean MOSPFormalization/Search/Layout.lean 2>&1 | head -40\",\"uuid\":\"18ac5f80-4591-4afd-83ce-47f4a6e215de\",\"session_id\":\"3e233eac-acc6-45da-bdf4-c3a7e4de0805\"}"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/lean/MOSPFormalization/Search/Layout.lean","/home/al/dev/MOSP/Ralph_Loops/loop0008/session_it03.jsonl"]}}}
