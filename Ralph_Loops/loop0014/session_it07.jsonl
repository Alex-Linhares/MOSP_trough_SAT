    best = 0\n234-    masks = _prefix_masks(order)\n235-    for i in range(n - 1):\n236-        pre = masks[i]\n237-        cnt = sum(1 for v in order[: i + 1] if adj[v] & ~pre)\n238-        best = max(best, cnt)\n239-    return best\n240-\n241-\n86:def graph(n, edges):\n87-    \"\"\"`(n, adj)` from an edge list on vertices `0..n-1`.\"\"\"\n88-    adj = [0] * n\n89-    for u, v in edges:\n90-        if u == v:\n91-            raise ValueError(\"loops are not graphs here\")\n92-        adj[u] |= 1 << v\n93-        adj[v] |= 1 << u\n94-    return n, tuple(adj)\n702:def two_expansion(g):\n703-    \"\"\"EST 1994 Thm 2.2: every edge subdivided twice.\"\"\"\n704-    n, adj = g\n705-    es = edges_of(g)\n706-    new = []\n707-    for i, (u, v) in enumerate(es):\n708-        a, b = n + 2 * i, n + 2 * i + 1\n709-        new += [(u, a), (a, b), (b, v)]\n710-    return graph(n + 2 * len(es), new)\n711-\n712-\n713-# ----------------------------------------------------------------------------\n714-# Split and interval bandwidth: Fomin 1998 sec. 3\n715-# ----------------------------------------------------------------------------\n716-\nThe directed pathwidth of G is defined similarly to the pathwidth of an undirected\ngraph. According to Barát [1], the notion of directed pathwidth was introduced by\nReed, Thomas, and Seymour around 1995.\n    For an undirected graph G, let Ĝ denote the digraph obtained from G by replacing\neach edge {u, v} by a pair of directed edges (u, v) and (v, u). Then, condition 2\nfor G implies condition 2’ for Ĝ and, conversely, condition 2’ for Ĝ together with\ncondition 3 implies condition 2 for G. Therefore, a directed path-decomposition of\nĜ is a path-decomposition of G and vice versa. Thus, the problem of computing the\npathwidth of an undirected graph is a special case of the problem of computing the\ndirected pathwidth of a digraph. On the other hand, directed pathwidth is of interest\nsince some problems, such as Directed Hamiltonicity, are polynomial time solvable\n\"\"\"loop0014 item 04: the structural claims of `reports/subexp_pathwidth.md` §4\n(cobipartite normal form, split dichotomy, twin lemma) against brute force on\nsmall graphs (the full atlas run is `python -m learning.subexp_classes`).\"\"\"\nimport random\n\nfrom learning import subexp_classes as sc\nfrom learning.subexp_reductions import atlas, vs\nfrom paper1.complex_check import graph\n\n\ndef _graphs(nmax):\n    return atlas(nmax)\n\n\ndef test_cobipartite_normal_form_matches_vs_on_every_partition():\n    for g in _graphs(5):\n        v = vs(g)\n        for A, B in sc.cobipartitions(g):\n            assert sc.cobipartite_normal_form(g, A, B) == v\n\n\ndef test_some_optimal_layout_places_one_clique_first():\n    for g in _graphs(5):\n        v = vs(g)\n        for A, B in sc.cobipartitions(g):\n            assert min(sc.one_side_first_layout_value(g, A, B),\n                       sc.one_side_first_layout_value(g, B, A)) == v\n\n\ndef test_corollary_4_2_decision_on_every_partition_and_k():\n    for g in _graphs(5):\n        v = vs(g)\n        for A, B in sc.cobipartitions(g):\n            for k in range(g[0] + 1):\n                assert sc.cobipartite_decision(g, A, B, k) == (v <= k)\n\n\ndef test_cobipartite_patterns_to_six_vertices():\n    for a in range(1, 4):\n        for b in range(a, 7 - a):","is_error":false}]},"parent_tool_use_id":null,"session_id":"09aaa989-9eda-444c-a4fd-1cc6d69ace0c","uuid":"8ac9973a-6fc6-45ff-8e49-d77c66adba55","timestamp":"2026-11-05T00:14:35.668Z","tool_use_result":{"stdout":"\"\"\"Reductions into pathwidth / vertex separation with their vertex blow-up\n(loop0014 item 03, `reports/subexp_pathwidth.md` §3).\nEvery reduction the catalogue calls *linear in the vertices* is implemented\nhere and checked against brute-force vertex separation on every graph of the\nnetworkx atlas (all graphs to 7 vertices), plus the quadratic one of Lengauer\n(1981) for the record. The checks write their log under\n`reports/scr