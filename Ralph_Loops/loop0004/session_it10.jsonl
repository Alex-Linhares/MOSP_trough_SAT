 zip(pts.loc[np.isfinite(h100), \"generator\"].str[0] + \":\" + pts.loc[np.isfinite(h100), \"ratio_label\"],\n                                                (h100 - pts[\"height\"].to_numpy(float))[np.isfinite(h100)]))''')\n# model_table's own fit must exclude n = 100 from the fitted coefficients? No: in-sample fit uses all exact points;\n# make the fit and the 100-cell prediction use n <= 75 only, so the 100 location stays a held-out check\ns = s.replace('''    pts = fit_points(peaks, generator)\n    pts = pts[pts[\"n\"] >= min_n].reset_index(drop=True)\n    rows = []\n    for model, text in MODELS.items():\n        beta = fit(model, pts)''', '''    pts = fit_points(peaks, generator)\n    pts = pts[pts[\"n\"] >= min_n].reset_index(drop=True)\n    fit_pts = pts[pts[\"n\"] <= 75].reset_index(drop=True)      # n = 100 is held out everywhere\n    rows = []\n    for model, text in MODELS.items():\n        beta = fit(model, fit_pts)''')\ns = s.replace('''        row = {\"model\": model, \"formula\": text, \"params\": len(beta), \"points\": len(pts),\n               \"coef\": \", \".join(f\"{b:.4g}\" for b in beta)}\n        row.update({f\"in_{k}\": v for k, v in _err(pts[\"height\"], predict(model, beta, pts)).items()})''',\n'''        row = {\"model\": model, \"formula\": text, \"params\": len(beta), \"points\": len(fit_pts),\n               \"coef\": \", \".join(f\"{b:.4g}\" for b in beta)}\n        row.update({f\"in_{k}\": v for k, v in _err(fit_pts[\"height\"], predict(model, beta, fit_pts)).items()})''')\np.write_text(s)\nt = Path(\"tests/test_ridge_height.py\"); u = t.read_text()\nu = u.replace('''def _synthetic_peaks(law, ns=(20, 30, 40, 50, 60, 75), rs=(0.25, 0.5, 1.0, 2.0), generator=\"fixed\"):''',\n              '''def _synthetic_peaks(law, ns=(20, 30, 40, 50, 60, 75, 100), rs=(0.25, 0.5, 1.0, 2.0), generator=\"fixed\"):''')\nu = u.replace('''    for scheme in (\"loso\", \"lono\", \"extrap75\"):\n        h = heldout(\"n·g(r) linear\", pts, scheme)\n        d 