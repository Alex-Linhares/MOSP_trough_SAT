workers\", flush=True)\n    if not jobs:\n        return load_calls(calls_csv)\n    t0 = time.time()\n    with multiprocessing.get_context(\"fork\").Pool(min(workers, len(jobs))) as pool:\n        for row in pool.imap_unordered(_decide_job, jobs):\n            _append(row, calls_csv)\n            if row[\"status\"] == \"sat\":\n                save_witness(generate(CELL, indices[row[\"instance_name\"]]), row[\"achieved\"], row[\"ordering\"], certified=False)\n            if verbose:\n                print(f\"[{time.time() - t0:7.0f}s] {row['instance_name']} {config} k={row['k']}: {row['status']} \"\n                      f\"{row['nodes']:,} nodes {row['seconds']:.0f} s\", flush=True)\n    return load_calls(calls_csv)\n\n\n''' + anchor\nassert anchor in s\ns = s.replace(anchor, new)\ns = s.replace('''    ap.add_argument(\"--stage\", choices=(\"price\", \"run\", \"tables\"), required=True)''',\n              '''    ap.add_argument(\"--stage\", choices=(\"price\", \"run\", \"refute-censored\", \"tables\"), required=True)''')\ns = s.replace('''    elif args.stage == \"run\":\n        run(args.workers, args.wall, args.deadline)\n''', '''    elif args.stage == \"run\":\n        run(args.workers, args.wall, args.deadline)\n    elif args.stage == \"refute-censored\":\n        refute_censored(args.workers, args.deadline)\n''')\ns = s.replace('''    python -m learning.ridge100 --stage run --workers 16 --wall 6300 --deadline 2400\n''', '''    python -m learning.ridge100 --stage run --workers 16 --wall 6300 --deadline 2400\n    python -m learning.ridge100 --stage refute-censored --workers 7 --deadline 1800   # default lower bounds for censored instances\n''')\np.write_text(s)\nEOF\npython -c \"import learning.ridge100\" && nohup python -m learning.ridge100 --stage refute-censored --workers 7 --deadline 1800 > learning/data/ensemble/ridge100_refute_censored.log 2>&1 &\nsleep 20; cat learning/data/ensemble/ridge100_refute_censored.log; uptime","description":"Add the refute-censor