re(te2[\"source\"] == \"corpus\", te2[\"instance_name\"].str.rsplit(\"-\", n=1).str[0],\n                                te2[\"instance_name\"].str.rsplit(\"_i\", n=1).str[0])\n        te2[\"hit\"] = within_decade(te2[\"pred\"], te2[f\"y_{cfg}\"], te2[f\"cens_{cfg}\"])\n        te2[\"err\"] = np.where(te2[f\"cens_{cfg}\"], np.nan, te2[\"pred\"] - te2[f\"y_{cfg}\"])\n        percls = te2.groupby([\"class\", \"n\"]).agg(counts=(\"pred\", \"size\"), censored=(f\"cens_{cfg}\", \"sum\"),\n                                                  median_y=(f\"y_{cfg}\", \"median\"), median_pred=(\"pred\", \"median\"),\n                                                  bias=(\"err\", \"mean\"), within_decade=(\"hit\", \"mean\")).reset_index()\n====HEUR\n828:STRATEGIES: dict[str, Strategy] = {\n833:    \"cs-dfs\": restricted_dfs,\n838:    \"rule+cs-dfs\": rule_then_dfs,\n839:    \"mcnh\": mcnh,\n846:DEFAULT_STRATEGY = \"mcn+tabu\"\n849:def upper_bound(\n57:def least_cost_node(instance: MOSPInstance, **_: object) -> UpperBound:\n128:def product_order_from_customers(\n158:def customer_tabu(\n239:def _mcn_customer_order(instance: MOSPInstance) -> list[int]:\n263:def _neighbour_masks(instance: MOSPInstance) -> list[int]:\n288:def fan_sort_key(fan_order: str, masks: Sequence[int], remaining: int):\n304:def _cs_cost(masks: Sequence[int], order: Sequence[int]) -> int:\n321:def restricted_dfs(\n430:def mcn_tabu_then_dfs(\n453:def _customer_order_from_products(\n469:def tabu(instance: MOSPInstance, seed: int = 42, **_: object) -> UpperBound:\n477:def mcn_then_tabu(instance: MOSPInstance, seed: int = 42, **_: object) -> UpperBound:\n498:def two_key_closing_order(instance: MOSPInstance) -> list[int]:\n547:def two_key_rule(instance: MOSPInstance, **_: object) -> UpperBound:\n553:def rule_then_dfs(\n571:def _load_cached(path: str):\n577:def _learned_model(model_path: object = None):\n600:def learned(\n617:def learned_then_dfs(\n637:def _mosp_graph_untraversed(instance: MOSPInstance) -> list[int