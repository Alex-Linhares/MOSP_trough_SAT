{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BLCQRpHtp7r3J1f3fCvAzr","type":"tool_result","content":"n,m,edges,omega,components,pendant,pendant_censored_eval,pendant_cliques,pendant_seconds,pendant_subproblems,pendant_censored,instance_name,source\n134,37,572,11,1,11,False,55,0.001,0,False,scoop-A_FA+AA-_13_0,corpus\n125,125,402,8,1,8,False,132,0.001,0,False,Random-125-125-2-4_0,corpus\n6377 reports/scratch/pendant_cliques/harness_values.csv\n\n# ----------------------------------------------------------------------------\n# Lemma P on a graph (loop0010 item 13): the evaluation `PendantCliques.lean` licenses\n# ----------------------------------------------------------------------------\n\ndef pendant_graph_bound(graph, max_r: int = 500, max_q: int = 5000, max_cliques: int = 50000,\n                        deadline: float | None = None) -> tuple[int, dict]:\n    \"\"\"Lemma P evaluated on a graph: `R` over the largest maximal cliques (at most\n    `max_r`), the pendant cliques over the largest maximal cliques `Q'` (at most\n    `max_q`), each cut down to `Q' \\\\ (R \\\\ {v})` for every `v ∈ Q' ∩ R` — the largest\n    sub-clique of `Q'` meeting `R` exactly in `v` — the largest such per `v`, sorted;\n    the best `t_q + ceil(q / 2) - 2` over the `q` largest. Returns the bound in\n    **pathwidth units** (`optimum - 1`), floored at `ω - 1`, with a dict saying\n    whether any cap was hit (`censored`: the evaluation is then over a subset of the\n    cliques, still a valid bound by `pathwidth_ge_of_pendant_cliques`). No part of\n    this is used by the solver.\"\"\"\n    import itertools\n    import time\n\n    import networkx as nx\n\n    nodes = list(graph.nodes())\n    index = {v: i for i, v in enumerate(nodes)}\n    cliques: list[int] = []\n    censored = False\n    for clique in itertools.islice(nx.find_cliques(graph), max_cliques + 1):\n        if len(cliques) >= max_cliques:\n            censored = True\n            break\n        mask = 0\n        for v in clique:\n            mask |= 1 << index[v]\n        cliques.append(mask)\n        if deadline is not None and time.monotonic() > deadline:\n            censored = True\n            break\n    cliques.sort(key=lambda m: -bin(m).count(\"1\"))\n    sizes = {m: bin(m).count(\"1\") for m in cliques}\n    omega = max(sizes.values(), default=1)\n    best = omega - 1\n    rs = cliques[:max_r]\n    qs = cliques[:max_q]\n    censored = censored or len(rs) < len(cliques) or len(qs) < len(cliques)\n    for R in rs:\n        per_vertex: dict[int, int] = {}\n        for Q in qs:\n            meet = Q & R\n            if meet == 0 or Q == R:\n                continue\n            size = sizes[Q] - bin(meet).count(\"1\") + 1\n            if size < 2:\n                continue\n            while meet:\n                low = meet & -meet\n                if per_vertex.get(low, 0) < size:\n                    per_vertex[low] = size\n                meet ^= low\n        if not per_vertex:\n            continue\n        ordered = sorted(per_vertex.values(), reverse=True)\n        for q, t in enumerate(ordered, start=1):\n            val = t + (q + 1) // 2 - 2\n            if val > best:\n                best = val\n        if deadline is not None and time.monotonic() > deadline:\n            censored = True\n            break\n    return best, {\"censored\": censored, \"cliques\": len(cliques), \"omega\": omega}\n\n\ndef pendant_candidate(graph, matrix, budget):\n    \"\"\"`learning.bound_harness` candidate: Lemma P in optimum units (`pathwidth + 1`).\"\"\"\n    import time\n\n    value, info = pendant_graph_bound(graph, deadline=time.monotonic() + budget.seconds)\n    if info[\"censored\"]:\n        budget.exhausted = True\n    return value + 1, {\"censored_eval\": info[\"censored\"], \"cliques\": info[\"cliques\"]}\n# ----------------------------------------------------------------------------\n\n_CS_CLASS = re.compile(r\"^(Random-\\d+-\\d+-\\d+)-\\d+_\\d+$\")\n\n\ndef collection_of(source_file: str, instance_name: str) -> tuple[str, str]:\n    \"\"\"(collection, class): the collection from the directory of the source\n    file; the class is the Chu & Stuckey `Random-n-m-d` for that collection,\n    the Harvey file stem (`wbo_10_10`) for Harvey, and the collection otherwise.\"\"\"\n    parts = Path(source_file).parts\n    directory = parts[-2] if len(parts) >= 2 else \"\"\n    names = {\"SCOOP\": \"SCOOP\", \"Faggioli_Bentivoglio\": \"Faggioli-Bentivoglio\", \"Chu_Stuckey\": \"Chu & Stuckey\",\n             \"Harvey\": \"Harvey\", \"Simonis\": \"Simonis\", \"Shaw\": \"Shaw\", \"Wilson\": \"Wilson\", \"Miller\": \"Miller\",\n             \"Challenge\": \"Challenge\"}\n    collection = names.get(directory, directory)\n    if collection == \"Chu & Stuckey\":\n        match = _CS_CLASS.match(instance_name)\n        return collection, match.group(1) if match else instance_name\n    if collection == \"Harvey\":\n        return collection, Path(source_file).stem\n    return collection, collection\n\n\ndef solution_record(instance: MOSPInstance, solutions_dir: Path = SOLUTIONS_DIR) -> tuple[float, str]:\n    \"\"\"(value, provenance) of the instance's cached solution, read from the file\n    (`solutions/` is the source of truth; `instances.csv` is a feature table\n    from 2026-09-25 and lags it -- four 125 x 125 instances certified in\n    October 2026 are `solution` there). `(nan, \"\")` where there is no file.\"\"\"\n    import json\n    from satisfiability.mosp_solver import _solution_path\n    path = _solution_path(instance, solutions_dir)\n    if not path.exists():\n        return np.nan, \"\"\n    with open(path) as handle:\n        record = json.load(handle)\n    return float(record[\"mosp_value\"]), str(record.get(\"provenance\", \"\"))","is_error":false}]},"parent_tool_use_id":null,"session_id":"337b02a4-72b3-460f-a353-9223c6e3809d","uuid":"036efb7b-4161-4043-a6e8-ab1c69a74195","timestamp":"2026-11-02T21:43:23.310Z","t