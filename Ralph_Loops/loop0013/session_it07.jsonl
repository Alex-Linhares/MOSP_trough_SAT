ssert oracle.calls == 0 and oracle.skipped_large == 1","+    # the recorded layout restricted to a set is an upper bound; the greedy layout is off above greedy_max_m","+    oracle2 = ob.LeafOracle(adj, 1.0, position=list(range(n)), greedy_max_m=0)","+    assert oracle2.upper((1 << n) - 1) <= n - 1","+","+","+def test_open_class_graphs_reads_the_24_with_layouts_of_the_recorded_width():","+    from learning.obstruction_ledger import open_class_graphs","+","+    recs = open_class_graphs(check_representative=False)","+    assert len(recs) == 24","+    for r in recs:","+        assert r[\"layout\"] is not None and r[\"layout_vs\"] == r[\"width\"], r[\"id\"]","+        assert len(r[\"edges\"]) == r[\"m\"] and len(r[\"adj\"]) == r[\"n\"]","+    tree = next(r for r in recs if r[\"names\"] == \"BalancedTree_3_5\")","+    assert (tree[\"n\"], tree[\"m\"]) == (364, 363)","+","+","+@pytest.mark.skipif(not (OPEN / \"joined.csv\").exists(), reason=\"item 07 run files not present\")","+def test_committed_open_run_files_carry_no_floor_above_a_recorded_width():","+    j = pd.read_csv(OPEN / \"joined.csv\")","+    assert len(j) == 24","+    assert not j[\"above_width\"].any()","+    assert (j[\"e_ceiling_pw\"].dropna() <= j.loc[j[\"e_ceiling_pw\"].notna(), \"width\"]).all()","+    tree = j[j[\"names\"] == \"BalancedTree_3_5\"].iloc[0]","+    assert tree[\"theorem_pw\"] == 5 and tree[\"closed\"]","+    rows = pd.read_csv(OPEN / \"results_obstruction.csv\")","+    assert list(rows.columns) == om.OPEN_FIELDS","+    assert (rows[\"lower\"] >= rows[\"width\"]).all() and (rows[\"width\"] == rows[\"recorded\"]).all()","+    if (OPEN / \"checker_verdicts.csv\").exists():","+        v = pd.read_csv(OPEN / \"checker_verdicts.csv\")","+        assert (v[\"verdict\"] == \"verified\").all(), v[v[\"verdict\"] != \"verified\"]"]}],"created":true}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/tests/test_obstruction_open.py"]}},"tool_result_meta":[{"id":"toolu_019Bf97qt6HP1Q8WmHtihbnF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
