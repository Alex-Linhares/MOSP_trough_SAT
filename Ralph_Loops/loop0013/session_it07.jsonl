r[\"cls\"]].append(r)\n        for members in by.values():\n            members.sort(key=lambda r: (PRIORITY[r[\"collection\"]], r[\"source\"], r[\"name\"]))\n        cls_of_id = {f\"pwc-{i + 1:05d}\": c for i, c in enumerate(class_order(by))}\n        base = {(v[\"source\"], v[\"name\"]): v for v in read_csv(VALUES_CSV)\n                if not v[\"evidence\"].startswith(\"reports/scratch/\")}\n        for cid in wanted:\n            rep, _ = representative(by[cls_of_id[cid]], base)\n            n_rep, e_rep = load(rep)\n            rep_of[cid] = (rep, n_rep, {(min(a, b), max(a, b)) for a, b in e_rep})\n    out = []\n    for cid, t in wanted.items():\n        rec = recs[cid]\n        n = int(rec[\"n\"])\n        edges = [(int(a), int(b)) for a, b in rec[\"edges\"]]\n        adj = adjacency_from_edges(n, edges)\n        lay = [int(v) for v in (rec.get(\"layout\") or [])]\n        layout, vs = None, None\n        if sorted(lay) == list(range(n)):\n            for cand in (lay[::-1], lay):\n                v = _prefix_vs(adj, cand)\n                if v == int(rec[\"width\"]):\n                    layout, vs = cand, v\n                    break\n        row = {\"id\": cid, \"names\": t[\"names\"], \"collections\": t[\"collections\"], \"n\": n, \"m\": len(edges),\n               \"width\": int(rec[\"width\"]), \"lower\": t.get(\"lower\"), \"lower_source\": t.get(\"lower_source\"),\n               \"provenance\": rec.get(\"provenance\"), \"edges\": edges, \"adj\": adj, \"layout\": layout,\n               \"layout_vs\": vs, \"record_layout_len\": len(lay)}\n        if check_representative:\n            rep, n_rep, e_rep = rep_of[cid]\n            row[\"representative\"] = {\"collection\": rep[\"collection\"], \"source\": rep[\"source\"], \"name\": rep[\"name\"]}\n            row[\"representative_matches_record\"] = (n_rep == n and e_rep == {(min(a, b), max(a, b)) for a, b in edges})\n        out.append(row)\n    return out\n\n\ndef _prefix_vs(adj: list[int], order: list[int]) -> int:\n    \"\"\"Vertex separation under the prefix definition: the largest number of\n    placed vertices with a neighbour outside the prefix.\"\"\"\n    placed, best = 0, 0\n    full = (1 << len(adj)) - 1\n    for v in order:\n        placed |= 1 << v\n        rest = full & ~placed\n        best = max(best, sum(1 for u in range(len(adj)) if (placed >> u) & 1 and adj[u] & rest))\n    return best\n\n\n'''\nassert marker in s\ns = s.replace(marker, add + marker, 1)\np.write_text(s)\nEOF\ntime python3 -c \"\nfrom learning.obstruction_ledger import open_class_graphs\nrows = open_class_graphs()\nfor r in rows:\n    print(r['id'], r['names'][:30], r['n'], r['m'], 'w', r['width'], 'lo', r['lower'], 'vs', r['layout_vs'], 'rep', r['representative_matches_record'], r['representative']['name'][:30])\n\"","description":"Add the open-class loader to the ledger and test it on the 24"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":2024,"cache_read_input_tokens":200859,"cache_creation":{"ephemeral_5m_input_tokens":2024,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1591906-103f-4e8b-927d-a1cad21e52cc","uuid":"e9621538-7f22-4346-993f-ae52a6892420","timestamp":"2026-11-03T07:31:27.932Z","request_id":"req_011CgfbybhKxkxJwKfacsL3i","wire_tool_inputs":{"toolu_01HzZMQiy5QBcE7Tsy3gUgdG":{"command":"cd /home/al/dev/MOSP && python3 - <<'EOF'\nfrom pathlib import Path\np = Path(\"learning/obstruction_ledger.py\")\ns = p.read_text()\nmarker = \"def build_targets() -> dict:\"\nadd = '''def open_class_graphs(ids: list[str] | None = None, check_representative: bool = True) -> list[dict]:\n    \"\"\"Item 07: the 24 open dataset classes of `targets.json` as graphs. Each\n    record carries t