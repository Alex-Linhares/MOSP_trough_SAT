g. Instances are not","+    started once the budgets committed exceed `core_hours`.\"\"\"","+    from learning.obstruction_ledger import open_class_graphs","+","+    OPEN_OUT.mkdir(parents=True, exist_ok=True)","+    recs = open_class_graphs(ids, check_representative=False)","+    done = set(pd.read_csv(OPEN_MINOR_CSV)[\"id\"]) if OPEN_MINOR_CSV.exists() else set()","+    jobs = [(r, seconds, cap, rng_seed) for r in recs if r[\"id\"] not in done and r[\"names\"] != \"BalancedTree_3_5\"]","+    jobs.sort(key=lambda j: -j[0][\"n\"])","+    if core_hours is not None:","+        keep = int(core_hours * 3600 // seconds)","+        if keep < len(jobs):","+            (OPEN_OUT / \"minor_not_reached.txt\").write_text(\"\".join(j[0][\"id\"] + \"\\n\" for j in jobs[keep:]))","+            jobs = jobs[:keep]","+    log(f\"open: {len(recs)} classes, {len(jobs)} to run, {workers} workers, {seconds:g} s each (ladder then search), \"","+        f\"C cap {cap:g} s, minors at {OPEN_FRACTIONS[0]:.0%}-{OPEN_FRACTIONS[1]:.0%} of n, core-hours cap {core_hours}, \"","+        f\"binary {binary_sha256()[:16]}\", OPEN_OUT / \"run.log\")","+    t0 = time.monotonic()","+    with Pool(workers) as pool:","+        for k, row in enumerate(pool.imap_unordered(_open_job, jobs, chunksize=1), 1):","+            pd.DataFrame([row]).to_csv(OPEN_MINOR_CSV, mode=\"a\", header=not OPEN_MINOR_CSV.exists(), index=False)","+            log(f\"  {k}/{len(jobs)} {row['id']} n={row['n']} width {row['width']} floor {row['lower']}: ladder \"","+                f\"{row['ladder_floor'] - 1} search {row['m_pathwidth']} (m {row['search_m']}, {row['search_source']}), \"","+                f\"{row['ladder_calls'] + row['search_calls']} C calls, {row['seconds']} s\", OPEN_OUT / \"run.log\")","+    frame = pd.read_csv(OPEN_MINOR_CSV).drop_duplicates(\"id\", keep=\"last\")","+    frame.to_csv(OPEN_MINOR_CSV, index=False)","+    log(f\"open done: {len(frame)} rows, {time.monotonic() - t0:.0f} s wall\", OPEN_OUT / \"run.