ote\": \"a family B certificate; paper1.dataset.fold reads proof=minor only\"})","+                    nodes, secs = 0, float(cert.get(\"seconds\") or 0)","+            order = rec[\"layout\"][::-1]      # the dataset's orientation: prefix boundary |N(T) \\ T|","+            rows.append({\"id\": r[\"id\"], \"collections\": r[\"collections\"].replace(\"; \", \"|\"), \"names\": r[\"names\"],","+                         \"n\": r[\"n\"], \"m\": r[\"m\"], \"recorded\": r[\"width\"], \"started_from_layout\": False,","+                         \"width\": int(r[\"width\"]), \"proof\": proof, \"lower\": int(r[\"best_new_floor_pw\"]), \"nodes\": nodes,","+                         \"seconds\": secs, \"finished\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"), \"status\": \"ok\",","+                         \"order\": json.dumps(order), \"minor\": minor})","+        elif r[\"above_record\"]:","+            fam = r[\"best_family\"]","+            cert_rel = r[\"m_certificate\"] if fam == \"M\" else (r[\"b_certificate\"] if fam == \"B\" else \"\")","+            lows.append({\"id\": r[\"id\"], \"names\": r[\"names\"], \"n\": r[\"n\"], \"m\": r[\"m\"], \"recorded_width\": r[\"width\"],","+                         \"recorded_floor\": r[\"lower\"], \"new_floor\": int(r[\"best_new_floor_pw\"]), \"family\": fam,","+                         \"certificate\": cert_rel, \"checker_verdict\": verdict.get(r[\"id\"], \"not checked\")})","+    out = pd.DataFrame(rows, columns=OPEN_FIELDS)","+    out.to_csv(OPEN_OUT / \"results_obstruction.csv\", index=False)","+    low = pd.DataFrame(lows, columns=[\"id\", \"names\", \"n\", \"m\", \"recorded_width\", \"recorded_floor\", \"new_floor\", \"family\",","+                                      \"certificate\", \"checker_verdict\"])","+    low.to_csv(OPEN_OUT / \"lower_bounds.csv\", index=False)","+    return out, low","+","+","+def _open_check_job(args) -> dict:","+    cid, inst, cert, kind = args","+    sys.path.insert(0, str(ROOT / \"paper1\"))","+    import obstruction_check as oc","+","+    t0 = time.monotonic()","+    if kind == \"minor\":","+        res = oc.check_minor(Path(inst), Path(cert), c_cap=OPEN_C_CAP * 5, rulefree=True, rulefree_cap=120.0)","+    else:","+        res = oc.check_branch(Path(inst), Path(cert), c_cap=OPEN_C_CAP * 5)","+    bad = [c[\"check\"] for c in res[\"checks\"] if not c[\"ok\"]]","+    return {\"id\": cid, \"kind\": kind, \"certificate\": str(Path(cert).relative_to(ROOT)), \"verdict\": res[\"verdict\"],","+            \"pathwidth_proved\": (res.get(\"proves\") or {}).get(\"pathwidth_at_least\"),","+            \"c_status\": res.get(\"c_status\"), \"c_width\": res.get(\"c_width\"), \"rulefree\": res.get(\"rulefree\"),","+            \"nodes_checked\": res.get(\"nodes_checked\"), \"c_reruns\": res.get(\"c_reruns\"),","+            \"contradiction\": bool(res.get(\"contradiction\")), \"failed_checks\": \"; \".join(bad),","+            \"seconds\": round(time.monotonic() - t0, 1)}","+","+","+def open_check_all(workers: int = 4) -> pd.DataFrame:","+    \"\"\"Every certificate of the item through the independent checker: the","+    tree (`check-branch`, no C), every M certificate (`check-minor`, the C","+    re-proof at cap x5, rule-free where the minor has at most 80 vertices)","+    and every B certificate with a value (`check-branch`).\"\"\"","+    jobs = []","+    tree = OPEN_OUT / \"tree_certificate.json\"","+    if tree.exists():","+        jobs.append((\"pwc-15933\", OPEN_OUT / \"tree_instance.txt\", tree, \"branch\"))","+    for d in sorted(OPEN_CERT_DIR.glob(\"pwc-*\")):","+        if (d / \"minor.json\").exists():","+            jobs.append((d.name, d / \"instance.txt\", d / \"minor.json\", \"minor\"))","+        if (d / \"branch.json\").exists():","+            jobs.append((d.name, d / \"instance.txt\", d / \"branch.json\", \"branch\"))","+    log(f\"open check: {len(jobs)} certificates, {workers} workers\", OPEN_OUT / \"run.log\")","+    with Pool(workers) as pool:","+        rows = list(pool.imap_unordered(_open_check_job, jobs))","+    frame = pd.DataFrame(rows).sort_values([\"id\", \"kind\"])","+    frame.to_csv(OPEN_OUT / \"checker_verdicts.csv\", index=False)","+    log(f\"open check: {int((frame['verdict'] == 'verified').sum())} of {len(frame)} verified\", OPEN_OUT / \"run.log\")","+    return frame","+","+","+def write_open_tables() -> str:","+    j = open_joined()","+    checker = pd.read_csv(OPEN_OUT / \"checker_verdicts.csv\") if (OPEN_OUT / \"checker_verdicts.csv\").exists() else None","+    if checker is not None:","+        cv = checker[checker[\"kind\"] == \"minor\"].set_index(\"id\")[\"verdict\"] if \"kind\" in checker else pd.Series(dtype=str)","+        j[\"m_checker\"] = j[\"id\"].map(cv)","+        bv = checker[checker[\"kind\"] == \"branch\"].set_index(\"id\")[\"verdict\"]","+        j[\"b_checker\"] = j[\"id\"].map(bv)","+    j.to_csv(OPEN_OUT / \"joined.csv\", index=False)","+    rows, low = write_open_rows(j, checker)","+    cols = [\"id\", \"names\", \"n\", \"m\", \"width\", \"lower\", \"e_ceiling_pw\", \"m_floor_pw\", \"m_ladder_pw\", \"m_minor_vertices\",","+            \"b_floor_pw\", \"b_potential\", \"theorem_pw\", \"best_new_floor_pw\", \"best_family\", \"above_record\", \"closed\"]","+    cols = [c for c in cols if c in j.columns]","+    tab = j[cols].copy()","+    for c in (\"e_ceiling_pw\", \"m_floor_pw\", \"m_ladder_pw\", \"b_floor_pw\", \"b_potential\", \"theorem_pw\", \"best_new_floor_pw\",","+              \"m_minor_vertices\"):","+        if c in tab:","+            tab[c] = tab[c].map(lambda x: \"\" if pd.isna(x) else str(int(x)))","+    md = [\"## Item 07 tables (pathwidth units: a dataset class's width is a pathwidth)\", \"\",","+          \"### (a) The 24 open classes: record, E ceiling, M floor, B floor, theorem, best new floor\", \"\",","+          _md(tab), \"\",","+          \"### (b) Counts\", \"\",","+          f\"- classes: {len(j)}; closed by this item: {int(j['closed'].sum())} ({', '.join(j.loc[j['closed'], 'id'])})\",","+          f\"- new floor above the recorded floor: {int(j['above_record'].sum())}; above the recorded width: {int(j['above_width'].sum())} (must be 0)\",","+          f\"- E ceiling below the recorded width (Harper cannot close the class under any computation): \"","+          f\"{int(j['e_ceiling_below_width'].sum())} of {int(j['e_ceiling_pw'].notna().sum())} with a ceiling\",","+          f\"- M floor = width − 1: {int((j['m_floor_pw'] == j['width'] - 1).sum())}; M floor above the recorded floor: \"","+          f\"{int((j['m_floor_pw'] > j['lower']).sum())}; search above the ladder: {int((j['m_floor_pw'] > j['m_ladder_pw']).sum())}\",","+          f\"- B with a linked triple: {int(j['b_floor_pw'].notna().sum())}; B above the recorded floor: \"","+          f\"{int((j['b_floor_pw'] > j['lower']).sum())}\",","+          f\"- evidence rows written: {len(rows)} (results_obstruction.csv); non-closing floors: {len(low)} (lower_bounds.csv)\", \"\"]","+    if checker is not None:","+        md += [\"### (c) Checker\", \"\", _md(checker[[\"id\", \"kind\", \"verdict\", \"pathwidth_proved\", \"c_status\", \"rulefree\",","+                                                   \"nodes_checked\", \"c_reruns\", \"seconds\"]]), \"\"]","+    (OPEN_OUT / \"tables.md\").write_text(\"\\n\".join(md))","+    return \"\\n\".join(md)","+","+"," def main() -> None:","     ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\\n\")[0])","-    ap.add_argument(\"--stage\", choices=(\"validate\", \"run\", \"ridge\", \"check\", \"tables\", \"open\"), required=True)","+    ap.add_argument(\"--stage\", choices=(\"validate\", \"run\", \"ridge\", \"check\", \"tables\", \"open\", \"open-check\", \"open-tables\"), required=True)","     ap.add_argument(\"--out\", default=\"04_minor\", help=\"output directory under reports/scratch/obstruction_search/\")","     ap.add_argument(\"--targets\", default=\"gap338\", help=\"comma-separated target sets (their union)\")",