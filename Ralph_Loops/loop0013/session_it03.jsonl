{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgfBhDXqX9cf6JvwW6e6U","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01P1VLZX4tK24dUE4q57Ldf9","name":"Write","input":{"file_path":"/home/al/dev/MOSP/reports/scratch/obstruction_search/03_sat/recheck_certificates.py","content":"\"\"\"Item 03: every certificate the run left under `certificates/<instance>/`\nthrough `paper1/obstruction_check.py::check_expansion` (the checker that\nshares nothing with the search but the contract), one row each in\n`checker_verdicts.csv`: instance, certificate path, (t, b), the bound it\nproves, the checker's verdict and seconds. Run as\n`nice -n 19 python3 reports/scratch/obstruction_search/03_sat/recheck_certificates.py --workers 8`.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport importlib.util\nimport time\nfrom multiprocessing import Pool\nfrom pathlib import Path\n\nimport pandas as pd\n\nROOT = Path(__file__).resolve().parents[4]\nHERE = Path(__file__).parent\nCHECKER = ROOT / \"paper1\" / \"obstruction_check.py\"\n\n\ndef _checker():\n    spec = importlib.util.spec_from_file_location(\"obstruction_check\", CHECKER)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\n\ndef _one(cert: Path) -> dict:\n    oc = _checker()\n    t0 = time.monotonic()\n    res = oc.check_expansion(cert.parent / \"instance.mosp\", cert, timeout=1800.0)\n    failed = [c[\"check\"] for c in res[\"checks\"] if not c[\"ok\"]]\n    return {\"instance_name\": res.get(\"instance_name\"), \"n\": res.get(\"n\"), \"t\": res.get(\"t\"), \"b\": res.get(\"b\"),\n            \"certificate\": str(cert.relative_to(ROOT)), \"verdict\": res[\"verdict\"],\n            \"drat_trim\": res.get(\"drat_trim\", \"\"), \"check_seconds\": res.get(\"check_seconds\", 0.0),\n            \"wall_seconds\": round(time.monotonic() - t0, 3),\n            \"mosp_at_least\": res.get(\"proves\", {}).get(\"mosp_at_least\"),\n            \"failed_checks\": \";\".join(failed)}\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--workers\", type=int, default=8)\n    args = ap.parse_args()\n    certs = sorted(HERE.glob(\"certificates/*/t*_b*.json\"))\n    print(f\"{len(certs)} certificates\")\n    t0 = time.monotonic()\n    with Pool(args.workers) as pool:\n        rows = list(pool.imap_unordered(_one, certs, chunksize=1))\n    out = pd.DataFrame(rows).sort_values([\"instance_name\", \"t\", \"b\"])\n    out.to_csv(HERE / \"checker_verdicts.csv\", index=False)\n    print(out[\"verdict\"].value_counts().to_string())\n    print(f\"{time.monotonic() - t0:.0f} s wall; check seconds total {out['check_seconds'].sum():.0f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":3065,"cache_read_input_tokens":207659,"cache_creation":{"ephemeral_5m_input_tokens":3065,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"016f94eb-fb83-436d-85e8-020ffffecefd","uuid":"047da72d-2740-4c25-a0b5-deb814929309","timestamp":"2026-11-03T02:13:22.468Z","request_id":"req_011CgfBhDBjtU1s7SrCnrU7Q","wire_tool_inputs":{"toolu_01P1VLZX4tK24dUE4q57Ldf9":{"file_path":"/home/al/dev/MOSP/reports/scratch/obstruction_search/03_sat/recheck_certificates.py","content":"\"\"\"Item 03: every certificate the run left under `certificates/<instance>/`\nthrough `paper1/obstruction_check.py::check_expansion` (the checker that\nshares nothing with the search but the contract), one row each in\n`checker_verdicts.csv`: instance, certificate path, (t, b), the bound it\nproves, the checker's verdict and seconds. Run as\n`nice -n 19 python3 reports/scratch/obstruction_search/03_sat/recheck_certificates.py --workers 8`.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport importlib.util\nimport time\nfrom multiprocessing import Pool\nfrom pathlib import Path\n\nimport pandas as pd\n\nROOT = Path(__file__).resolve().parents[4]\nHERE = Path(__file__).parent\nCHECKER = ROOT / \"paper1\" / \"obstruction_check.py\"\n\n\ndef _checker():\n    spec = importlib.util.spec_from_file_location(\"obstruction_check\", CHECKER)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\n\ndef _one(cert: Path) -> dict:\n    oc = _checker()\n    t0 = time.monotonic()\n    res = oc.check_expansion(cert.parent / \"instance.mosp\", cert, timeout=1800.0)\n    failed = [c[\"check\"] for c in res[\"checks\"] if not c[\"ok\"]]\n    return {\"instance_name\": res.get(\"instance_name\"), \"n\": res.get(\"n\"), \"t\": res.get(\"t\"), \"b\": res.get(\"b\"),\n            \"certificate\": str(cert.relative_to(ROOT)), \"verdict\": res[\"verdict\"],\n            \"drat_trim\": res.get(\"drat_trim\", \"\"), \"check_seconds\": res.get(\"check_seconds\", 0.0),\n            \"wall_seconds\": round(time.monotonic() - t0, 3),\n            \"mosp_at_least\": res.get(\"proves\", {}).get(\"mosp_at_least\"),\n            \"failed_checks\": \";\".join(failed)}\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--workers\", type=int, default=8)\n    args = ap.parse_args()\n    certs = sorted(HERE.glob(\"certificates/*/t*_b*.json\"))\n    print(f\"{len(certs)} certificates\")\n    t0 = time.monotonic()\n    with Pool(args.workers) as pool:\n        rows = list(pool.imap_unordered(_one, certs, chunksize=1))\n    out = pd.DataFrame(rows).sort_values([\"instance_name\", \"t\", \"b\"])\n    out.to_csv(HERE / \"checker_verdicts.csv\", index=False)\n    print(out[\"verdict\"].value_counts().to_string())\n    print(f\"{time.monotonic() - t0:.0f} s wall; check seconds total {out['check_seconds'].sum():.0f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}}}
