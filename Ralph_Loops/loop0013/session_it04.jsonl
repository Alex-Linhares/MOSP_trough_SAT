 program, rule-free)","+# ----------------------------------------------------------------------------","+","+DEFAULT_C_BINARY = ROOT / \"pathwidth_solver\" / \"cli\" / \"pathwidth\"","+RULEFREE_DIR = ROOT / \"reports\" / \"scratch\" / \"minor_certificates\"","+MINOR_THEOREMS = (\"pathwidth_gt_of_minorOf / pathwidth_minorOf_le (lean/MOSPFormalization/Minor.lean); \"","+                  \"mospValue_eq_pathwidth_add_one (lean/MOSPFormalization/MOSPGraph.lean)\")","+","+","+def read_edges(path: Path) -> tuple[str, int, list[tuple[int, int]]]:","+    \"\"\"An edge list: \"n e\" then e lines \"u v\", 0-based.\"\"\"","+    text = Path(path).read_text().split()","+    n, e = int(text[0]), int(text[1])","+    vals = [int(x) for x in text[2:2 + 2 * e]]","+    if len(vals) != 2 * e:","+        raise ValueError(\"edge list is short\")","+    return Path(path).stem, n, [(a, b) for a, b in zip(vals[0::2], vals[1::2])]","+","+","+def graph_from_rows(rows: list[list[int]]) -> dict[int, set[int]]:","+    closed = closed_neighbourhoods(rows)","+    return {u: set(closed[u]) - {u} for u in range(len(rows))}","+","+","+def graph_from_edges(n: int, edges: list[tuple[int, int]]) -> dict[int, set[int]]:","+    G = {u: set() for u in range(n)}","+    for a, b in edges:","+        if a != b:","+            G[a].add(b)","+            G[b].add(a)","+    return G","+","+","+def edges_sha256(m: int, edges) -> str:","+    edges = sorted((min(a, b), max(a, b)) for a, b in edges)","+    text = f\"{m} {len(edges)}\\n\" + \"\".join(f\"{a} {b}\\n\" for a, b in edges)","+    return hashlib.sha256(text.encode()).hexdigest()","+","+","+def graph_edges(G: dict[int, set[int]]) -> list[tuple[int, int]]:","+    return sorted((a, b) for a in G for b in G[a] if a < b)","+","+","+def replay_minor(G: dict[int, set[int]], seq) -> tuple[dict[int, set[int]], dict[int, set[int]]]:","+    \"\"\"Replay `[v, u]` pairs (contract `v` into `u`; `[v, -1]` deletes an","+    isolated `v`), raising ValueError at the first pair that is not an edge of","+    the current graph. Returns the minor over the surviving labels and the","+    branch sets.\"\"\"","+    H = {v: set(N) for v, N in G.items()}","+    branch = {v: {v} for v in G}","+    for step, pair in enumerate(seq):","+        v, u = int(pair[0]), int(pair[1])","+        if v not in H:","+            raise ValueError(f\"step {step}: {v} is not in the current graph\")","+        if u == -1:","+            if H[v]:","+                raise ValueError(f\"step {step}: deleting {v}, which has {len(H[v])} neighbours\")","+            del H[v]","+            del branch[v]","+            continue","+        if u == v or u not in H or u not in H[v]:","+            raise ValueError(f\"step {step}: ({v}, {u}) is not an edge of the current graph\")","+        for w in H[v]:","+            H[w].discard(v)","+            if w != u:","+                H[w].add(u)","+                H[u].add(w)","+        del H[v]","+        H[u].discard(u)","+        H[u].discard(v)","+        branch[u] |= branch.pop(v)","+    return H, branch","+","+","+def quotient_by_branch_sets(G: dict[int, set[int]], branch: dict[int, set[int]]) -> dict[int, set[int]]:","+    rep = {x: r for r, B in branch.items() for x in B}","+    if sorted(rep) != sorted(G):","+        raise ValueError(\"branch sets do not partition the vertex set\")","+    Q = {r: set() for r in branch}","+    for a in G:","+        for b in G[a]:","+            if rep[a] != rep[b]:","+                Q[rep[a]].add(rep[b])","+    return Q","+","+","+def relabel(H: dict[int, set[int]]) -> tuple[list[int], list[tuple[int, int]]]:","+    labels = sorted(H)","+    index = {r: i for i, r in enumerate(labels)}","+    return labels, sorted((index[a], index[b]) for a in H for b in H[a] if a < b)","+","+","+def graph6_encode(m: int, edges: list[tuple[int, int]]) -> str:","+    \"\"\"graph6 (McKay): N(m) then the upper triangle column by column, 6 bits","+    per character, offset 63. Own code; `m < 63` uses the one-byte size.\"\"\"","+    if m <= 62:","+        head = chr(m + 63)","+    elif m <= 258047:","+        head = \"~\" + \"\".join(chr(((m >> s) & 63) + 63) for s in (12, 6, 0))","+    else:","+        raise ValueError(\"too many vertices\")","+    adj = [set() for _ in range(m)]","+    for a, b in edges:","+        adj[a].add(b)","+        adj[b].add(a)","+    bits_ = []","+    for j in range(1, m):","+        for i in range(j):","+            bits_.append(1 if j in adj[i] else 0)","+    while len(bits_) % 6:","+        bits_.append(0)","+    body = \"\".join(chr(int(\"\".join(map(str, bits_[k:k + 6])), 2) + 63) for k in range(0, len(bits_), 6))","+    return head + body","+","+","+def run_pathwidth_c(g6: str, cap: float, binary: Path) -> dict:","+    cmd = [\"nice\", \"-n\", \"19\", str(binary), \"-t\", f\"{cap:g}\", \"-l\", \"-v\", \"-m\", \"min_vertices=1000000\"]","+    t0 = time.monotonic()","+    proc = subprocess.run(cmd, input=g6 + \"\\n\", capture_output=True, text=True, timeout=cap * 10 + 60)","+    out = {\"stdout\": proc.stdout.strip().splitlines(), \"stderr\": proc.stderr.strip().splitlines(),","+           \"returncode\": proc.returncode, \"seconds\": time.monotonic() - t0, \"width\": None, \"status\": None, \"lower\": None}","+    for line in out[\"stdout\"]:","+        parts = line.split()","+        if parts and parts[0] == \"pathwidth\" and len(parts) >= 3:","+            out[\"width\"], out[\"status\"] = int(parts[1]), parts[2]","+    for line in out[\"stderr\"]:","+        for tok in line.split():","+            if tok.startswith(\"lower=\"):","+                out[\"lower\"] = int(tok[6:])","+    return out","+","+","+def _limit_memory(bytes_: int):","+    def pre():","+        try:","+            import resource","+            resource.setrlimit(resource.RLIMIT_AS, (bytes_, bytes_))","+        except Exception:","+            pass","+        try:","+            os.nice(19)","+        except Exception:","+            pass","+    return pre","+","+","+def rulefree_refutation(m: int, edges: list[tuple[int, int]], w: int, cap: float, src_dir: Path = RULEFREE_DIR,","+                        max_states: int = 100_000_000, memory_bytes: int = 8 << 30) -> dict:","+    \"\"\"`vsmemo -o -w F` refuting `pw <= w` on the minor, then `checkF`; both","+    compiled from `src_dir` into a temporary directory. Returns the outcome:","+    `verified`, `unknown` (vsmemo gave no answer in the budget), `sat`","+    (vsmemo found a layout of width `w`: the claim is false), `failed`","+    (checkF rejected the family) or `skipped`.\"\"\"","+    vs, cf = src_dir / \"vsmemo.c\", src_dir / \"checkF.c\"","+    if not (vs.exists() and cf.exists()) or m > 192:","+        return {\"rulefree\": \"skipped\", \"reason\": \"sources missing or m > 192\"}","+    t0 = time.monotonic()","+    with tempfile.TemporaryDirectory() as tmp:","+        tmp = Path(tmp)","+        for src, exe in ((vs, \"vsmemo\"), (cf, \"checkF\")):","+            r = subprocess.run([\"gcc\", \"-O2\", \"-o\", str(tmp / exe), str(src)], capture_output=True, text=True)","+            if r.returncode != 0:","+                return {\"rulefree\": \"skipped\", \"reason\": f\"gcc failed on {src.name}: {r.stderr[-200:]}\"}","+        edge_file = tmp / \"edges.txt\"","+        edge_file.write_text(f\"{m} {len(edges)}\\n\" + \"\".join(f\"{a} {b}\\n\" for a, b in edges))","+        fam = tmp / \"F.bin\"","+        try:","+            r = subprocess.run([str(tmp / \"vsmemo\"), str(edge_file), str(w), \"-o\", \"-t\", f\"{cap:g}\", \"-m\", str(max_states),","+                                \"-w\", str(fam)], capture_output=True, text=True, timeout=cap + 120,","+                               preexec_fn=_limit_memory(memory_bytes))","+        except subprocess.TimeoutExpired:","+            return {\"rulefree\": \"unknown\", \"reason\": \"vsmemo timed out\", \"rulefree_seconds\": time.monotonic() - t0}","+        first = (r.stdout.strip().splitlines() or [\"\"])[0]","+        i