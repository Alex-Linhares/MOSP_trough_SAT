{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N5cWZPqdkisNHGNdooZeKX","type":"tool_result","content":"\"\"\"loop0013 item 02: `learning.obstruction_expansion` — the exact profile\nagainst a Python reference and against `expansion_bound`'s levels, the two\ntheorems on small graphs (the exact Harper and empty-pair values never exceed\n`vs + 1`), the ceiling between the exact bound and the optimum on the small\ncorpus instances, the empty-pair ceiling formula, label invariance of the\nsearch, the harness candidate's validity, and the committed files.\"\"\"\nfrom __future__ import annotations\n\nimport random\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom learning import obstruction_expansion as oe\n\nSCRATCH = Path(__file__).resolve().parents[1] / \"reports\" / \"scratch\" / \"obstruction_search\"\n\n\ndef _random_closed(rng: random.Random, n: int, p: float) -> list[int]:\n    adj = [0] * n\n    for u in range(n):\n        for v in range(u + 1, n):\n            if rng.random() < p:\n                adj[u] |= 1 << v\n                adj[v] |= 1 << u\n    return oe.closed_masks(adj)\n\n\n@pytest.fixture(scope=\"module\")\ndef small_corpus():\n    \"\"\"The first 60 `targets.small` instances with matrix, optimum and witness.\"\"\"\n    if not oe.TARGETS_JSON.exists() or not oe.LEDGER_CORPUS.exists():\n        pytest.skip(\"item 01's ledger is not on disk\")\n    led = oe.ledger().set_index(\"instance_name\")\n    names = oe.target_names(\"small\")[:60]\n    inst = oe.corpus_instances()\n    out = []\n    for nm in names:\n        sol = oe.solution_record(nm)\n        out.append((nm, np.asarray(inst[nm][1].matrix, dtype=int), int(led.loc[nm, \"optimum\"]),\n                    sol[\"ordering\"] if sol else None))\n    return out\n\n\n# ----------------------------------------------------------------------------\n# the exact profile\n# ----------------------------------------------------------------------------\n\n\ndef test_exact_profile_matches_python_reference():\n    rng = random.Random(11)\n    for _ in range(150):\n        n = rng.randint(1, 10)\n        closed = _random_closed(rng, n, rng.choice([0.15, 0.4, 0.8]))\n        prof = oe.exact_profile(closed)\n        assert prof.values == oe.exact_profile_reference(closed)\n        for t in range(1, n + 1):\n            assert prof.sets[t].bit_count() == t\n52:def test_exact_profile_matches_python_reference():\n64:def test_exact_harper_and_empty_pair_never_exceed_vs_plus_one():\n84:def test_exact_profile_agrees_with_expansion_bound_levels(small_corpus):\n116:def test_opening_layout_has_vertex_separation_optimum_minus_one(small_corpus):\n128:def test_ceiling_between_exact_bound_and_optimum(small_corpus):\n144:def test_empty_pair_ceiling_is_n_minus_2s_minus_1():\n155:def test_search_is_label_invariant_up_to_the_seed(small_corpus):\n178:def test_harper_floor_candidate_is_valid_and_is_expansion_bound(small_corpus):\n195:def test_committed_ceiling_and_floor_files():\n241:def test_sat_encoding_agrees_with_enumeration():\n262:def test_profile_floor_and_mark_levels():\n283:def test_certificate_verifies_and_a_damaged_one_is_rejected(tmp_path):\n334:def test_checker_cnf_hash_equals_the_search_cnf_hash(small_corpus):\n352:def test_checker_shares_only_the_spec():\n363:def test_committed_sat_files():\ndef check_expansion(instance_path: Path, certificate_path: Path, drat_trim: Path = DEFAULT_DRAT_TRIM,\n                    timeout: float | None = None) -> dict:\n    \"\"\"Every check, as a dict; `verdict` is `verified` only when all pass.\"\"\"\n    result: dict = {\"instance\": str(instance_path), \"certificate\": str(certificate_path), \"checks\": [], \"verdict\": \"\"}\n    cert = json.loads(Path(certificate_path).read_text())\n    name, rows = read_mosp(Path(instance_path))\n    n = len(rows)\n    t, b = int(cert[\"t\"]), int(cert[\"b\"])\n    result.update({\"instance_name\": name, \"n\": n, \"t\": t, \"b\": b})\n\n    def check(label: str, ok: bool, detail: str = \"\") -> bool:\n        result[\"checks\"].append({\"check\": label, \"ok\": bool(ok), \"detail\": detail})\n        return bool(ok)\n\n    ok = check(\"encoding is expansion-cnf-1\", cert.get(\"encoding\") == \"expansion-cnf-1\", str(cert.get(\"encoding\")))\n    ok &= check(\"instance size matches\", n == int(cert[\"n\"]), f\"file n={n}, certificate n={cert['n']}\")\n    digest_rows = rows_sha256(rows)\n    ok &= check(\"instance rows SHA-256 matches\", digest_rows == cert.get(\"matrix_sha256\"),\n                f\"{digest_rows[:16]}… vs {str(cert.get('matrix_sha256'))[:16]}…\")\n    ok &= check(\"(t, b) in range\", 1 <= t <= n and 0 <= b <= n - 1, f\"t={t}, b={b}, n={n}\")\n    if not ok:\n        result[\"verdict\"] = \"rejected\"\n        return result\n    closed = closed_neighbourhoods(rows)\n    clauses, nv = expansion_cnf(closed, t, b)\n    digest = cnf_sha256(clauses, nv)\n    result.update({\"cnf_variables\": nv, \"cnf_clauses\": len(clauses), \"cnf_sha256\": digest})\n    ok &= check(\"CNF SHA-256 matches the certificate\", digest == cert.get(\"cnf_sha256\"),\n                f\"{digest[:16]}… vs {str(cert.get('cnf_sha256'))[:16]}…\")\n    ok &= check(\"CNF size matches\", nv == int(cert.get(\"cnf_variables\", -1)) and len(clauses) == int(cert.get(\"cnf_clauses\", -1)),\n                f\"{nv} variables, {len(clauses)} clauses\")\n    proof_file = cert.get(\"proof_file\")\n    if not proof_file:\n        ok &= check(\"proof present\", False, \"the certificate names no proof file (hash only)\")\n        result[\"verdict\"] = \"rejected\"\n        return result\n    proof_path = Path(certificate_path).parent / proof_file\n    if not proof_path.exists():\n        ok &= check(\"proof present\", False, f\"{proof_path} missing\")\n        result[\"verdict\"] = \"rejected\"\n        return result\n    with gzip.open(proof_path, \"rb\") as fh:\n        proof = fh.read()\n    proof_digest = hashlib.sha256(proof).hexdigest()\n    ok &= check(\"proof SHA-256 matches\", proof_digest == cert.get(\"proof_sha256\"),\n                f\"{proof_digest[:16]}… vs {str(cert.get('proof_sha256'))[:16]}…, {len(proof)} bytes\")\n    if not Path(drat_trim).exists():\n        ok &= check(\"drat-trim available\", False, str(drat_trim))\n        result[\"verdict\"] = \"rejected\"\n        return result\n    verdict, seconds, tail = run_drat_trim(dimacs(clauses, nv), proof, Path(drat_trim), timeout)\n    result.update({\"drat_trim\": verdict, \"check_seconds\": seconds, \"drat_trim_output\": tail})\n    ok &= check(\"drat-trim verifies the proof on the regenerated CNF\", verdict == \"verified\", verdict)\n    result[\"verdict\"] = \"verified\" if ok else \"rejected\"\n    if ok:\n        result[\"proves\"] = {\"f_t_at_least\": b + 1, \"pathwidth_at_least\": b + 1 - t, \"mosp_at_least\": b + 2 - t,\n                            \"statement\": f\"no set of {t} customers has a closed neighbourhood of at most {b} \"\n                                         f\"customers, so pathwidth >= {b + 1 - t} and MOSP >= {b + 2 - t}\",\n                            \"theorems\": THEOREMS}\n    return result\n\n\ndef main(argv: list[str] | None = None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\\n\")[0])\n    sub = ap.add_subparsers(dest=\"command\", required=True)\n    ce = sub.add_parser(\"check-expansion\", help=\"check a family E certificate: CNF hash, DRAT proof, the bound\")\n    ce.add_argument(\"instance\")\n    ce.add_argument(\"certificate\")\n    ce.add_argument(\"--drat-trim\", default=str(DEFAULT_DRAT_TRIM))\n    ce.add_argument(\"--timeout\", type=float, default=None)\n    ce.add_argument(\"--json\", action=\"store_true\")\n    args = ap.parse_args(argv)\n    if args.command == \"check-expansion\":\n        res = check_expansion(Path(args.instance), Path(args.certificate), Path(args.drat_trim), args.timeout)\n        if args.json:\n            print(json.dumps(res, indent=1))\n        else:\n            print(f\"instance {res.get('instance_name')!r} (n = {res.get('n')}), certificate (t, b) = ({res.get('t')}, {res.get('b')})\")\n            for c in res[\"checks\"]:\n                print(f\"  [{'ok' if c['ok'] else 'FAIL'}] {c['check']}: {c['detail']}\")\n            print(f\"verdict: {res['verdict']}\")\n            if res[\"verdict\"] == \"verified\":\n                p = res[\"proves\"]\n                print(f\"proves: {p['statement']}\")\n                print(f\"rests on: {p['theorems']}\")\n        return 0 if res[\"verdict\"] == \"verified\" else 1\n    return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","is_error":false}]},"parent_tool_use_id":null,"session_id":"9f928aeb-dd8b-4eb2-ae60-0ddf3b071136","uuid":"e2aa8eb5-846a-4911-96e3-5213eb8ce8d2","timestamp":"2026-11-03T03:27:19.022Z","tool_use_result":{"stdout":"\"\"\"loop0013 item 02: `learning.obstruction_expansion` — the exact profile\nagainst a Python reference and against `expansion_bound`'s levels, the two\ntheorems on small graphs (the exact Harper and empty-pair values never exceed\n`vs + 1`), the ceiling between the exact bound and the optimum on the small\ncorpus instances, the empty-pair ceiling formula, label invariance of the\nsearch, the harness candidate's validity, and the committed files.\"\"\"\nfrom __future__ import annotations\n\nimport random\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom learning import obstruction_expansion as oe\n\nSCRATCH = Path(__file__).resolve().parents[1] / \"reports\" / \"scratch\" / \"obstruction_search\"\n\n\ndef _random_closed(rng: random.Random, n: int, p: float) -> list[int]:\n    adj = [0] * n\n    for u in range(n):\n        for v in range(u + 1, n):\n            if rng.random() < p:\n                adj[u] |= 1 << v\n                adj[v] |= 1 << u\n    return oe.closed_masks(adj)\n\n\n@pytest.fixture(scope=\"module\")\ndef small_corpus():\n    \"\"\"The fir