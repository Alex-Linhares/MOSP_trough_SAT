MS}\n    return result\n\n'''\nsrc = src.replace(\"\\ndef main(argv: list[str] | None = None) -> int:\\n\", addition + \"\\ndef main(argv: list[str] | None = None) -> int:\\n\")\n\n# 3. CLI\nsrc = src.replace('''    args = ap.parse_args(argv)\n    if args.command == \"check-expansion\":''', '''    cm = sub.add_parser(\"check-minor\", help=\"check a family M certificate: replay, quotient hash, the C program, rule-free\")\n    cm.add_argument(\"instance\")\n    cm.add_argument(\"certificate\")\n    cm.add_argument(\"--c-binary\", default=str(DEFAULT_C_BINARY))\n    cm.add_argument(\"--c-cap\", type=float, default=10.0)\n    cm.add_argument(\"--no-rulefree\", action=\"store_true\")\n    cm.add_argument(\"--rulefree-cap\", type=float, default=300.0)\n    cm.add_argument(\"--json\", action=\"store_true\")\n    args = ap.parse_args(argv)\n    if args.command == \"check-minor\":\n        res = check_minor(Path(args.instance), Path(args.certificate), args.c_cap, Path(args.c_binary),\n                          not args.no_rulefree, args.rulefree_cap)\n        if args.json:\n            print(json.dumps(res, indent=1))\n        else:\n            print(f\"instance {res.get('instance_name')!r} (n = {res.get('n')}), minor m = {res.get('m')}, \"\n                  f\"claimed floor {res.get('floor_claimed')}\")\n            for c in res[\"checks\"]:\n                print(f\"  [{'ok' if c['ok'] else 'FAIL'}] {c['check']}: {c['detail']}\")\n            print(f\"verdict: {res['verdict']} (rule-free: {res.get('rulefree')})\")\n            if res[\"verdict\"] == \"verified\":\n                print(f\"proves: {res['proves']['statement']}\")\n                print(f\"rests on: {res['proves']['theorems']}\")\n        return 0 if res[\"verdict\"] == \"verified\" else 1\n    if args.command == \"check-expansion\":''')\nsrc = src.replace(\"import argparse\\nimport gzip\\nimport hashlib\\nimport json\\nimport subprocess\\n\",\n                  \"import argparse\\nimport gzip\\nimport hashlib\\nimport json\\nimport os\\nimport subprocess\\n\")\np.write_text(src)\nprint(\"ok\")\nEOF\ngrep -n \"^import\\|^from\" paper1/obstruction_check.py && python3 -c \"\nimport sys; sys.path.insert(0,'paper1'); import obstruction_check as oc, networkx as nx\nimport random\nrng=random.Random(3)\nfor _ in range(300):\n    m=rng.randint(1,70); edges=[(a,b) for a in range(m) for b in range(a+1,m) if rng.random()<0.3]\n    G=nx.Graph(); G.add_nodes_from(range(m)); G.add_edges_from(edges)\n    assert oc.graph6_encode(m,edges)==nx.to_graph6_bytes(G,nodes=range(m),header=False).decode().strip(), m\nprint('graph6 ok')\"","description":"Add check-minor to the checker and test its graph6 encoder against networkx"}},"wire_ingest_context":{"toolu_019Kiwgu57gHWudub8ZbFjtU":{"cwd":"/home/al/dev/MOSP"}}}
