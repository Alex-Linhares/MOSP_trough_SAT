ead(path)","+            if x is not None:","+                e_before = _max_into(e_before, x.set_index(\"instance_name\")[col])","+        bracket = int((c2.set_index(\"instance_name\")[\"ceiling\"].reindex(g338.index) - e_before > 0).sum())","+        g = i3[i3.instance_name.isin(g338.index)]","         settled = int(g[\"argmax_settled\"].astype(bool).sum())","-        n338 = int(f.is_gap338.sum())","         out.append({\"family\": \"E, the exact half\", \"criterion\": \"SAT settles the argmax level on < 50% of the 338 within budget\",","-                    \"number\": f\"{settled} of {n338} ({100 * settled / n338:.1f}%); of the {len(g)} gap instances with a bracket reached, {settled} ({100 * settled / max(len(g), 1):.1f}%)\",","-                    \"verdict\": \"met\" if settled / n338 < 0.5 else \"not met\", \"source\": \"03_sat/instances.csv\"})","+                    \"number\": f\"{settled} of {n338} ({100 * settled / n338:.1f}%); {settled} of the {bracket} with a bracket \"","+                              f\"({100 * settled / max(bracket, 1):.1f}%), {len(g)} of them reached\",","+                    \"verdict\": \"met\" if settled / n338 < 0.5 else \"not met\", \"source\": \"03_sat/instances.csv, 02_expansion/ceiling.csv\"})","     beats = 0","     ran = 0","     for path in (SCRATCH / \"04_minor\" / \"search.csv\", SCRATCH / \"05_minor_scale\" / \"search.csv\"):"]},{"oldStart":397,"oldLines":10,"newStart":207,"newLines":10,"lines":["         p = SCRATCH / item / \"run.log\"","         if not p.exists():","             return \"\"","-        hits = [ln.strip() for ln in p.read_text().splitlines() if \"core-hour\" in ln]","         nums = []","-        for ln in hits:","-            nums += re.findall(r\"([0-9]+\\.[0-9]+) core-hours\", ln)","+        for ln in p.read_text().splitlines():","+            if \"this run\" in ln or \"instance time\" in ln or re.search(r\"core-hours?$\", ln.strip()):","+                nums += re.findall(r\"([0-9]+\\.[0-9]+) c