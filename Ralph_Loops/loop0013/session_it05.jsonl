on_isolated_deletion():\n80:def test_checker_accepts_deletion_of_a_contracted_component():\n104:def test_quotient_equals_relaxation_minor_groups_on_50_instances(corpus):\n126:def test_retargeted_pair_is_repaired_or_dropped():\n147:def test_lifted_layout_never_exceeds_the_original_vertex_separation():\n171:def test_lifted_witness_skip_never_skips_an_improving_minor(corpus):\n209:def test_c_program_agrees_with_brute_force_on_small_minors():\n229:def test_certificate_round_trips_through_the_checker(corpus, tmp_path):\n280:def test_checker_graph6_and_hash_agree_with_the_search():\n290:def test_checker_imports_nothing_from_the_project():\n301:def test_committed_run_files():\n=== 2-2 in verification ===\n=== m70 keys ===\n{'claim': 'pw(G) >= 20: pw(H) <= 19 is refuted on the minor H', 'graph': 'Random-125-125-2-3_0', 'n': 125, 'edges_G': 330, 'm': 70, 'rule': 'least-c', 'w': 19, 'contraction_sequence': 'list55', 'contraction_sequence_note': \"pairs [keep, absorbed] in G's labels; each step contracts a current edge\", 'branch_sets': 'list70', 'minor_labels': 'list70', 'minor_edges': 'list250', 'minor_sha256': '1213f70e292808fcae28ca05d4a2e381be88d9770a92931f10d28742cbc4c7f7', 'comparison': 'branch sets equal to Random-125-125-2-3_0_minor70_least-c.json'}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NUqGPxKRwFxHtNQ2SfdEUP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
