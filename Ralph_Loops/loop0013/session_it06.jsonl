{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EUPVLeQcMNhK7ntzStFhmk","type":"tool_result","content":"\"\"\"Item 05: the search's minor floor through `learning.bound_harness`'s\nvalidity stage on the corpus, written to this directory. The candidate is a\n*lookup*: the harness hands it a matrix, it finds the instance by the SHA-256\nof the rows among the run's certificate directories\n(`certificates/<instance>/instance.mosp` and `ridge/<instance>/instance.mosp`) and returns that instance's\n`floor` from `search.json` (the ridge stage's floor where both exist and it is larger); an instance the run did not cover gets the\ntrivial 1. So \"above optimum\" being 0 checks every floor the item produced\nagainst the certified optimum, on the harness's own reading of the corpus.\n\nRun as `nice -n 19 python3 reports/scratch/obstruction_search/05_minor_scale/run_harness.py --workers 8`.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\n\nROOT = Path(__file__).resolve().parents[4]\nsys.path.insert(0, str(ROOT))\n\nfrom learning import bound_harness as bh  # noqa: E402\n\nHERE = Path(__file__).parent\nOUT_CSV = HERE / \"harness_values.csv\"\n_LOOKUP: dict[str, tuple[str, int]] | None = None\n\n\ndef _rows_sha256(matrix) -> str:\n    matrix = np.asarray(matrix, dtype=int)\n    text = \"\".join(\" \".join(str(int(v)) for v in row) + \"\\n\" for row in matrix)\n    return hashlib.sha256(text.encode()).hexdigest()\n\n\ndef _lookup() -> dict[str, tuple[str, int]]:\n    global _LOOKUP\n    if _LOOKUP is None:\n        table: dict[str, tuple[str, int]] = {}\n        dirs = [d for sub in (\"certificates\", \"ridge\") if (HERE / sub).exists() for d in (HERE / sub).iterdir()]\n        for d in dirs:\n            inst, cert = d / \"instance.mosp\", d / \"search.json\"\n            if not (inst.exists() and cert.exists()):\n                continue\n            lines = inst.read_text().splitlines()\n            n = int(lines[1].split()[0])\n            rows = [[int(x) for x in ln.split()] for ln in lines[2:2 + n]]\n            rec = json.loads(cert.read_text())\n            key = _rows_sha256(rows)\n            if key not in table or int(rec[\"floor\"]) > table[key][1]:\n                table[key] = (lines[0].strip(), int(rec[\"floor\"]))\n        _LOOKUP = table\n    return _LOOKUP\n\n\ndef minor_floor(graph, matrix, budget) -> tuple[int, dict]:\n    \"\"\"Family M's searched floor from the item 05 run, by lookup; 1 where the run has no record.\"\"\"\n    hit = _lookup().get(_rows_sha256(matrix))\n    if hit is None:\n        return 1, {\"source\": \"none\"}\n    return hit[1], {\"source\": \"minor_run\", \"instance\": hit[0]}\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--workers\", type=int, default=8)\n    ap.add_argument(\"--wall\", type=float, default=None)\n    args = ap.parse_args()\n    bh.CANDIDATES[\"minor_floor\"] = minor_floor\n    frame = bh.run_validity(args.workers, (\"minor_floor\",), out_csv=OUT_CSV, sources=(\"corpus\",), wall=args.wall)\n    table = bh.validity_table(frame)\n    print(table.to_string())\n    HERE.joinpath(\"harness_table.md\").write_text(table.to_markdown(index=False) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n----\n    adj = [0] * n\n    for u in range(n):\n        for v in range(u + 1, n):\n            if rng.random() < p:\n                adj[u] |= 1 << v\n                adj[v] |= 1 << u\n    return adj\n\n\n@pytest.fixture(scope=\"module\")\ndef corpus():\n    \"\"\"The first 50 `targets.small` instances with matrix, optimum and witness.\"\"\"\n    if not om.TARGETS_JSON.exists() or not om.LEDGER_CORPUS.exists():\n        pytest.skip(\"item 01's ledger is not on disk\")\n    led = om.ledger().set_index(\"instance_name\")\n    names = om.target_names(\"small\")[:50]\n    inst = om.corpus_instances()\n    out = []\n    for nm in 