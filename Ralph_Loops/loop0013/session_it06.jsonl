 score_of(ctx, top, S2, best_value)\\n\")\nassert s.count(\"score_of(ctx, top, S, best_value)\") == 1 and s.count(\"score_of(ctx, top, S2, best_value)\") == 1\n\n# 5. branch_search: need at the family pass; the potential diag; local search re-evaluation\nold = '''        ctx.stats[\"separators_evaluated\"] += 1\n        value, node, diag = value_at(ctx, top, S, depth - 1)\n        scored.append(((value, diag[\"n_comps_nontrivial\"], diag[\"n_comps\"], -popcount(S)), S))\n'''\nnew = '''        ctx.stats[\"separators_evaluated\"] += 1\n        value, node, diag = value_at(ctx, top, S, depth - 1, best_value)\n        scored.append(((value, diag[\"potential\"], diag[\"n_comps_nontrivial\"], diag[\"n_comps\"], -popcount(S)), S))\n'''\nassert s.count(old) == 1; s = s.replace(old, new)\nold = '''        if lS is not None:\n            value, node, _ = value_at(ctx, top, lS, depth - 1)\n'''\nnew = '''        if lS is not None:\n            value, node, _ = value_at(ctx, top, lS, depth - 1, best_value)\n'''\nassert s.count(old) == 1; s = s.replace(old, new)\nold = '''            ctx.memo = {k: v for k, v in ctx.memo.items() if k[0] not in improved}\n            value, node, _ = value_at(ctx, top, best_S, 0)\n'''\nnew = '''            ctx.memo = {k: v for k, v in ctx.memo.items() if k[0] not in improved}\n            value, node, _ = value_at(ctx, top, best_S, 0, best_value)\n'''\nassert s.count(old) == 1; s = s.replace(old, new)\n# best_value semantics: value = k + 1 (0 when none). need_k = best_value means k >= best_value <=> k + 1 > best_value. ok.\n\n# 6. _job: always a certificate column\nold = '''    row.update({k: st[k] for k in (\"separators_family\", \"separators_evaluated\", \"separators_with_3_comps\",\n                                   \"local_starts\", \"local_moves\", \"censored\", \"c_calls\", \"c_seconds\",\n                                   \"minor_calls\", \"leaves_cached\", \"seconds\")})\n'''\nnew = '''    row.update({k: st[k] for k in (\"separators_fami