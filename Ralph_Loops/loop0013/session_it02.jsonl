s_instances()\\nfor nm in [\\\"Random-125-125-2-2_0\\\", \\\"Random-125-125-8-5_0\\\", \\\"SP4\\\"]:\\n    mat = inst[nm][1].matrix\\n    sol = oe.solution_record(nm)\\n    print(nm, \\\"ordering len\\\", len(sol[\\\"ordering\\\"]), \\\"m\\\", mat.shape[1])\\n    t0=time.time()\\n    row = oe._ceiling_job((nm, mat.tolist(), sol[\\\"ordering\\\"], int(led.loc[nm,\\\"optimum\\\"]), 30.0, 1))\\n    print({k:v for k,v in row.items()}, time.time()-t0)\\nEOF\",\"description\":\"Smoke-test the exact profile against the reference and the search on three large instances\"}},\"wire_ingest_context\":{\"toolu_01PGawcDk9jxR9PbQk7D7Efp\":{\"cwd\":\"/home/al/dev/MOSP\"}}}","+{\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"blgd3dv1w\",\"run_id\":\"0mvzzffy8-1dbad2c6\",\"tool_use_id\":\"toolu_01PGawcDk9jxR9PbQk7D7Efp\",\"description\":\"Smoke-test the exact profile against the reference and the search on three large instances\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"04dfce23-eae9-4ad2-85cb-4201d5c728e1\",\"session_id\":\"921105de-7582-4dc2-9639-7c302ae07177\"}","+{\"type\":\"system\",\"subtype\":\"task_notification\",\"task_id\":\"blgd3dv1w\",\"run_id\":\"0mvzzffy8-1dbad2c6\",\"tool_use_id\":\"toolu_01PGawcDk9jxR9PbQk7D7Efp\",\"status\":\"completed\",\"output_file\":\"\",\"summary\":\"Smoke-test the exact profile against the reference and the search on three large instances\",\"uuid\":\"7a9d0c5a-4772-42b1-9561-63fe24fb923a\",\"session_id\":\"921105de-7582-4dc2-9639-7c302ae07177\"}"]}]},{"filePath":"/home/al/dev/MOSP/reports/scratch/obstruction_search/02_expansion/sets/Random-125-125-2-2_0.json","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":1,"lines":["+{\"instance_name\": \"Random-125-125-2-2_0\", \"n\": 125, \"optimum\": 25, \"ceiling\": 23, \"t_star\": 46, \"fhat\": [0, 2, 4, 5, 7, 9, 10, 12, 14, 15, 16, 17, 19, 21, 22, 24, 25, 27, 29, 30, 31, 32, 34, 35, 37, 39, 40, 42, 43, 45, 46, 48, 49, 51, 52, 54, 55, 56, 57, 59, 60, 61