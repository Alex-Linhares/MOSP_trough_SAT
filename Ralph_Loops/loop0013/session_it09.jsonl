action_seq(adj, full)\nH2=apply_seq(adj, full); S2=((1<<n)-1)&~removed(full)\nprint('extension', ext, 'mmd+ best', best, 'final survivors', bin(S2).count('1'), 'min degree', min_degree_in(H2,S2))\nm2,Hm=induced(H2,S2); print('pw of final minor (DP)', vs(m2,Hm) if m2<=16 else 'n/a')\njson.dump({'sequence_record': seq, 'extension_least_c': ext, 'full_sequence': full, 'min_degree_record_minor': min_degree_in(H,S),\n           'degeneracy_record_minor': degeneracy(H,S), 'min_degree_final': min_degree_in(H2,S2), 'final_survivors': [v for v in range(n) if S2>>v&1]},\n          open('reports/scratch/obstruction_search/09_lean/warwick_extension.json','w'), indent=1)\nedges=sorted((a,b) for a in range(n) for b in range(n) if a<b and adj[a]>>b&1)\nlean=f\"\"\"import MOSPFormalization.ObstructionCertificate\nopen MOSPFormalization\nnamespace Warwick\ndef edges : List (ℕ × ℕ) := {edges}\ndef G : SimpleGraph (Fin {n}) := SimpleGraph.fromRel fun a b => (a.val, b.val) ∈ edges\ninstance : DecidableRel G.Adj := fun a b =>\n  inferInstanceAs (Decidable (a ≠ b ∧ ((a.val, b.val) ∈ edges ∨ (b.val, a.val) ∈ edges)))\ndef seq : List (Fin {n} × Option (Fin {n})) := {str([(v, f'some {u}') for v,u in full]).replace(\"'\",\"\")}\nset_option maxRecDepth 100000 in\ntheorem seq_checked : checkSeq G seq = true := by decide +kernel\nset_option maxRecDepth 100000 in\ntheorem seq_minDegree : minDegreeOfMinor G seq = {min_degree_in(H2,S2)} := by decide +kernel\ntheorem seven_le_pathwidth : 7 ≤ pathwidth G :=\n  pathwidth_ge_of_checkSeq G seq seq_checked (by rw [seq_minDegree])\nend Warwick\n\"\"\"\nopen('reports/scratch/obstruction_search/09_lean/warwick_full.lean','w').write(lean)\nEOF\ncd lean && (time timeout 900 lake env lean ../reports/scratch/obstruction_search/09_lean/warwick_full.lean) 2>&1 | tail -5","description":"Extend the record's sequence by least-c contractions to min degree 7 and decide it in Lean","timeout":960000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"sto