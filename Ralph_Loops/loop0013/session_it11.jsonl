{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017dz2jxgmG958HJ3czPip3s","type":"tool_result","content":"def minor_graph(cur: list[int], alive: int) -> tuple[list[int], list[tuple[int, int]]]:\n    \"\"\"Relabel the surviving representatives `0..m-1` in increasing label\n    order; returns the labels and the relabelled edge list.\"\"\"\n    labels = bits(alive)\n    index = {v: i for i, v in enumerate(labels)}\n    edges = [(index[a], index[b]) for a in labels for b in bits(cur[a]) if a < b]\n    return labels, sorted(edges)\n\n\ndef minor_masks(m: int, edges: list[tuple[int, int]]) -> list[int]:\n    adj = [0] * m\n    for a, b in edges:\n        adj[a] |= 1 << b\n        adj[b] |= 1 << a\n    return adj\n\n\ndef graph6(m: int, edges: list[tuple[int, int]]) -> str:\n    import networkx as nx\n\n    G = nx.Graph()\n    G.add_nodes_from(range(m))\n    G.add_edges_from(edges)\n    return nx.to_graph6_bytes(G, nodes=range(m), header=False).decode().strip()\n\n\ndef repair(adj: list[int], seq: list[tuple[int, int]]) -> list[tuple[int, int]]:\ndef closed_masks(adj: list[int]) -> list[int]:\n    \"\"\"Closed neighbourhoods `N[v]` from open ones.\"\"\"\n    return [a | (1 << v) for v, a in enumerate(adj)]\n\n\ndef closed_masks_from_matrix(matrix) -> list[int]:\n    return closed_masks(adjacency_from_matrix(np.asarray(matrix, dtype=int)))\n\n\ndef _words(n: int) -> int:\n    return max(1, (n + 63) // 64)\n65:    def from_matrix(matrix: List[List[int]] | np.ndarray, name: str = \"\") -> MOSPInstance:\n66-        \"\"\"Create an instance from a binary matrix.\"\"\"\n67-        matrix = np.array(matrix, dtype=np.int8)\n68-        n_customers, n_patterns = matrix.shape\n69-        return MOSPInstance(\n70-            matrix=matrix,\n71-            n_customers=n_customers,\n             instance_name  gap_best  best  e_floor  e_ceiling  b_value\n3674  Random-100-100-4-1_0         1    45     34.0       44.0      NaN\n3676  Random-100-100-4-3_0         1