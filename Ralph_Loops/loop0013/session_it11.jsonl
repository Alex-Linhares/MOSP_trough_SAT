rs, (\"combo_floor\",), out_csv=OUT_CSV, sources=(\"corpus\",), wall=args.wall)\n    table = bh.validity_table(frame)\n    print(table.to_string())\n    HERE.joinpath(\"harness_table.md\").write_text(table.to_markdown(index=False) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\necho ok; tail -3 reports/scratch/obstruction_search/11_combo_scan.out; uptime","description":"Write the harness lookup script for the item and check the scan's log"}},"wire_ingest_context":{"toolu_01VefdKkdG2wsFy8g6pkQBaS":{"cwd":"/home/al/dev/MOSP"}}}
