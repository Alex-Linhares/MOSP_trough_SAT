(G, cert[\"sequence\"], deleted)","+        ok &= check(\"every pair is an edge of the current graph at its step\", True,","+                    f\"{len(cert['sequence'])} steps, {len(deleted)} isolated deletions\")","+    except (ValueError, KeyError, IndexError, TypeError) as exc:","+        ok &= check(\"every pair is an edge of the current graph at its step\", False, str(exc))","+        result[\"verdict\"] = \"rejected\"","+        return result","+    try:","+        Q = quotient_by_branch_sets(G, branch, deleted)","+        ok &= check(\"quotient by branch sets equals the replayed minor\", Q == H)","+    except ValueError as exc:","+        ok &= check(\"quotient by branch sets equals the replayed minor\", False, str(exc))","+    labels, edges = relabel(H)","+    m = len(labels)","+    result[\"m\"] = m","+    h = edges_sha256(m, edges)","+    ok &= check(\"minor size matches\", m == int(cert.get(\"m\", -1)), f\"replayed m={m}, certificate m={cert.get('m')}\")","+    ok &= check(\"minor labels match\", labels == [int(x) for x in cert.get(\"minor_labels\", [])])","+    ok &= check(\"minor edge-list SHA-256 matches\", h == cert.get(\"minor_sha256\"),","+                f\"{h[:16]}… vs {str(cert.get('minor_sha256'))[:16]}…\")","+    if not ok:","+        result[\"verdict\"] = \"rejected\"","+        return result","+    kind = cert.get(\"inner_kind\")","+    inner_path = Path(certificate_path).parent / str(cert.get(\"inner_certificate\"))","+    ok &= check(\"inner certificate present\", inner_path.exists(), str(inner_path))","+    if not ok:","+        result[\"verdict\"] = \"rejected\"","+        return result","+    proved = -1","+    with tempfile.TemporaryDirectory() as td:","+        if kind == \"branch\":","+            ep = Path(td) / \"minor.txt\"","+            ep.write_text(f\"{m} {len(edges)}\\n\" + \"\".join(f\"{a} {b}\\n\" for a, b in edges))","+            inner = check_branch(ep, inner_path, c_cap=c_cap, c_binary=c_binary)","+            ok &= check(\"inner branch certificate verified on the minor written here\", inner[\"verdict\"] == \"verified\",","+                        f\"check-branch {inner['verdict']}; first failure: \"","+                        f\"{next((c['check'] for c in inner['checks'] if not c['ok']), '')}\")","+            proved = int((inner.get(\"proves\") or {}).get(\"pathwidth_at_least\", -1))","+        elif kind == \"expansion\":","+            mp = Path(td) / \"minor.mosp\"","+            erows = edge_pattern_rows(m, edges)","+            mp.write_text(f\"minor[{m}]\\n{m} {len(erows[0])}\\n\" + \"\".join(\" \".join(map(str, r)) + \"\\n\" for r in erows))","+            inner = check_expansion(mp, inner_path, drat_trim=drat_trim, timeout=timeout)","+            ok &= check(\"inner expansion certificate verified on the minor written here\", inner[\"verdict\"] == \"verified\",","+                        f\"check-expansion {inner['verdict']}; first failure: \"","+                        f\"{next((c['check'] for c in inner['checks'] if not c['ok']), '')}\")","+            proved = int((inner.get(\"proves\") or {}).get(\"pathwidth_at_least\", -1))","+        else:","+            ok &= check(\"known inner kind\", False, str(kind))","+            inner = None","+    result[\"inner\"] = {\"verdict\": inner[\"verdict\"], \"checks\": len(inner[\"checks\"])} if inner else None","+    ok &= check(f\"the inner certificate proves pathwidth(minor) >= {claim}\", proved >= claim, f\"proves {proved}\")","+    result[\"verdict\"] = \"verified\" if ok else \"rejected\"","+    if ok:","+        result[\"proves\"] = {\"pathwidth_at_least\": claim, \"mosp_at_least\": claim + 1,","+                            \"statement\": f\"the {kind} certificate proves pathwidth(minor) >= {claim} on a contraction \"","+                                         f\"minor of G, so pathwidth(G) >= {claim} and MOSP >= {claim + 1}\",","+                            \"theorems\": COMBO_THEOREMS}","+    return result","+","+"," def main(argv: list[str] | None = None) -> int:","     ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\\n\")[0])","     sub = ap.add_subparsers(dest=\"command\", required=True)"]},{"oldStart":829,"oldLines":7,"newStart":955,"newLines":30,"lines":["     cb.add_argument(\"--c-cap\", type=float, default=25.0)","     cb.add_argument(\"--rulefree\", action=\"store_true\", help=\"rule-free check of minor leaves (vsmemo + checkF)\")","     cb.add_argument(\"--json\", action=\"store_true\")","+    cc = sub.add_parser(\"check-combo\", help=\"check an F5 certificate: a family E or B certificate on a contraction minor\")","+    cc.add_argument(\"instance\")","+    cc.add_argument(\"certificate\")","+    cc.add_argument(\"--c-binary\", default=str(DEFAULT_C_BINARY))","+    cc.add_argument(\"--c-cap\", type=float, default=25.0)","+    cc.add_argument(\"--drat-trim\", default=str(DEFAULT_DRAT_TRIM))","+    cc.add_argument(\"--timeout\", type=float, default=None)","+    cc.add_argument(\"--json\", action=\"store_true\")","     args = ap.parse_args(argv)","+    if args.command == \"check-combo\":","+        res = check_combo(Path(args.instance), Path(args.certificate), args.c_cap, Path(args.c_binary),","+                          Path(args.drat_trim), args.timeout)","+        if args.json:","+            print(json.dumps(res, indent=1))","+        else:","+            print(f\"instance {res.get('instance_name')!r} (n = {res.get('n')}), minor m = {res.get('m')}, \"","+                  f\"inner {res.get('inner_kind')}, claimed floor {res.get('floor_claimed')}\")","+            for c in res[\"checks\"]:","+                print(f\"  [{'ok' if c['ok'] else 'FAIL'}] {c['check']}: {c['detail']}\")","+            print(f\"verdict: {res['verdict']}\")","+            if res[\"verdict\"] == \"verified\":","+                print(f\"proves: {res['proves']['statement']}\")","+                print(f\"rests on: {res['proves']['theorems']}\")","+        return 0 if res[\"verdict\"] == \"verified\" else 1","     if args.command == \"check-branch\":","         res = check_branch(Path(args.instance), Path(args.certificate), args.c_cap, Path(args.c_binary), args.rulefree)","         if args.json:"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/paper1/obstruction_check.py"]}},"tool_result_meta":[{"id":"toolu_01XDeXGchb7wEe5QPy4ySNUw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
