{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0188f9986tydjHzQtmiAzM4y","type":"tool_result","content":"def cap_for(n: int) -> float:\n    for hi, cap in CAP_BY_SIZE:\n        if n <= hi:\n            return cap\n    return CAP_BY_SIZE[-1][1]\n\n\ndef budget_for(n: int, seconds: tuple[int, ...]) -> int:\n    \"\"\"`seconds` lists the budget per band (n <= 40, 41-60, 61-100, 101+);\n    a shorter tuple repeats its last entry.\"\"\"\n    for i, hi in enumerate(BUDGET_BANDS):\n        if n <= hi:\n            return int(seconds[min(i, len(seconds) - 1)])\n    return int(seconds[-1])\n\n\nRULES = (\"min-d\", \"least-c\")\nLADDER_FRACTIONS = (0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95)\nRESTART_FRACTIONS = (0.50, 0.60, 0.70, 0.80, 0.90, 0.95)\nTENURE = 10\nMOVES_PER_RESTART = 25\nC_CAP_SECONDS = 2.0      # per C call at n <= 60 (plan §0.5 (e))\nMIN_MINOR = 3\n\n\n152:RULES = (\"min-d\", \"least-c\")\n153:LADDER_FRACTIONS = (0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95)\n154:RESTART_FRACTIONS = (0.50, 0.60, 0.70, 0.80, 0.90, 0.95)\n155:TENURE = 10\n156:MOVES_PER_RESTART = 25\n157:C_CAP_SECONDS = 2.0      # per C call at n <= 60 (plan §0.5 (e))\n158:MIN_MINOR = 3\ndef quotient_by_branch_sets(G: dict[int, set[int]], branch: dict[int, set[int]],\n                            deleted: set[int] = frozenset()) -> dict[int, set[int]]:\n    \"\"\"The quotient from the branch sets alone; the branch sets and the\n    deleted (isolated) vertices must partition the vertex set.\"\"\"\n    rep = {x: r for r, B in branch.items() for x in B}\n    if sorted(list(rep) + list(deleted)) != sorted(G) or set(rep) & set(deleted):\n        raise ValueError(\"branch sets and deleted vertices do not partition the vertex set\")\n    Q = {r: set() for r in branch}\n    for a in G:\n        if a in deleted:\n            continue\n        for b in G[a]:\n            if rep[a] != rep[b]:\n                Q[rep[a]].add(rep[b])\n    return Q\n\n\ndef relabel(H: dict[int, set[int]]) -> tuple[list[int], list[tuple[int, int]]]:\n    labels = sorted(H)\n    index = {r: i for i, r in enumerate(labels)}\n    return labels, sorted((index[a], index[b]) for a in H for b in H[a] if a < b)\n\n\ndef graph6_encode(m: int, edges: list[tuple[int, int]]) -> str:\n    \"\"\"graph6 (McKay): N(m) then the upper triangle column by column, 6 bits\n    per character, offset 63. Own code; `m < 63` uses the one-byte size.\"\"\"\n    if m <= 62:\n        head = chr(m + 63)\n    elif m <= 258047:\n        head = \"~\" + \"\".join(chr(((m >> s) & 63) + 63) for s in (12, 6, 0))\n    else:\n        raise ValueError(\"too many vertices\")\n    adj = [set() for _ in range(m)]\n    for a, b in edges:\n        adj[a].add(b)\n        adj[b].add(a)\n    bits_ = []\n    for j in range(1, m):\n        for i in range(j):\n            bits_.append(1 if j in adj[i] else 0)\n    while len(bits_) % 6:\n        bits_.append(0)\n    body = \"\".join(chr(int(\"\".join(map(str, bits_[k:k + 6])), 2) + 63) for k in range(0, len(bits_), 6))\n    return head + body\n\n\ndef run_pathwidth_c(g6: str, cap: float, binary: Path) -> dict:\ndef solution_record(name: str) -> dict | None:\n    from satisfiability.mosp_solver import _solution_path\n    from mosp.instance import MOSPInstance\n\n    path = _solution_path(MOSPInstance.from_matrix([[1]], name=name), SOLUTIONS_DIR)\n    if not path.exists():\n        return None\n    return json.loads(path.read_text())\n\n\ndef safe_name(name: str) -> str:\n    return \"\".join(c if c.isalnum() or c in \"-_.\" else \"_\" for c in (name or \"unnamed\"))\n\n\n# ----------------------------------------------------------------------------\n# the profile: exact and searched\n# ----------------------------------------------------------------------------\n\n\n@dataclass\nclass Profile:\ndef matrix_sha256(matrix) -> str:\n    \"\"\"SHA-256 of the 0/1 rows as the standard `.mosp` format writes them.\"\"\"\n    matrix = np.asarray(matrix, dtype=int)\n    text = \"\".join(\" \".join(str(int(v)) for v in row) + \"\\n\" for row in matrix)\n    return hashlib.sha256(text.encode()).hexdigest()\n\n\ndef write_standard_instance(path: Path, name: str, matrix) -> None:\n    matrix = np.asarray(matrix, dtype=int)\n    lines = [name, f\"{matrix.shape[0]} {matrix.shape[1]}\"]\n    lines += [\" \".join(str(int(v)) for v in row) for row in matrix]\n    path.write_text(\"\\n\".join(lines) + \"\\n\")\n\n\ndef _drat_trim_path() -> Path:\n131:def adjacency_from_edges(n: int, edges) -> list[int]:\n132-    \"\"\"Open neighbourhoods as bit masks (loops and repeats ignored).\"\"\"\n133-    adj = [0] * n\n134-    for u, v in edges:\n135-        if u == v:\n136-            continue\n137-        adj[u] |= 1 << v\n138-        adj[v] |= 1 << u\n139-    return adj\n140-\n141-\n142:def adjacency_from_matrix(matrix: np.ndarray) -> list[int]:\n143-    \"\"\"The MOSP graph of a 0/1 matrix (rows customers): a clique per pattern.\"\"\"\n144-    matrix = np.asarray(matrix)\n145-    n = matrix.shape[0]\n146-    adj = [0] * n\n147-    for col in range(matrix.shape[1]):\n148-        holders = np.flatnonzero(matrix[:, col])\n149-        together = 0\n150-        for c in holders:\n151-            together |= 1 << int(c)\n152-        for c in holders:\n153-            adj[int(c)] |= together & ~(1 << int(c))\n154-    return adj\n--\n342:def corpus_instances() -> dict[str, tuple[Path, object]]:\n343-    from learning.dataset import enumerate_instances\n344-\n345-    found: dict[str, tuple[Path, object]] = {}\n346-    for path, inst in enumerate_instances():\n347-        found.setdefault(inst.name, (path, inst))\n348-    return found\n349-\n350-\n351-def read_record() -> pd.DataFrame:\n352-    \"\"\"`instances.csv` joined with the invariants, Lemma P, the minor\n353-    certificates and the provenance in `solutions/`; no computation.\"\"\"\n354-    from satisfiability.mosp_solver import _solution_path","is_error":false}]},"parent_tool_