t writes them.\"\"\"\n    matrix = np.asarray(matrix, dtype=int)\n    text = \"\".join(\" \".join(str(int(v)) for v in row) + \"\\n\" for row in matrix)\n    return hashlib.sha256(text.encode()).hexdigest()\n\n\ndef write_standard_instance(path: Path, name: str, matrix) -> None:\n    matrix = np.asarray(matrix, dtype=int)\n    lines = [name, f\"{matrix.shape[0]} {matrix.shape[1]}\"]\n    lines += [\" \".join(str(int(v)) for v in row) for row in matrix]\n    path.write_text(\"\\n\".join(lines) + \"\\n\")\n\n\ndef _drat_trim_path() -> Path:\n131:def adjacency_from_edges(n: int, edges) -> list[int]:\n132-    \"\"\"Open neighbourhoods as bit masks (loops and repeats ignored).\"\"\"\n133-    adj = [0] * n\n134-    for u, v in edges:\n135-        if u == v:\n136-            continue\n137-        adj[u] |= 1 << v\n138-        adj[v] |= 1 << u\n139-    return adj\n140-\n141-\n142:def adjacency_from_matrix(matrix: np.ndarray) -> list[int]:\n143-    \"\"\"The MOSP graph of a 0/1 matrix (rows customers): a clique per pattern.\"\"\"\n144-    matrix = np.asarray(matrix)\n145-    n = matrix.shape[0]\n146-    adj = [0] * n\n147-    for col in range(matrix.shape[1]):\n148-        holders = np.flatnonzero(matrix[:, col])\n149-        together = 0\n150-        for c in holders:\n151-            together |= 1 << int(c)\n152-        for c in holders:\n153-            adj[int(c)] |= together & ~(1 << int(c))\n154-    return adj\n--\n342:def corpus_instances() -> dict[str, tuple[Path, object]]:\n343-    from learning.dataset import enumerate_instances\n344-\n345-    found: dict[str, tuple[Path, object]] = {}\n346-    for path, inst in enumerate_instances():\n347-        found.setdefault(inst.name, (path, inst))\n348-    return found\n349-\n350-\n351-def read_record() -> pd.DataFrame:\n352-    \"\"\"`instances.csv` joined with the invariants, Lemma P, the minor\n353-    certificates and the provenance in `solutions/`; no computation.\"\"\"\n354-    from satisfiability.mosp_solver import _