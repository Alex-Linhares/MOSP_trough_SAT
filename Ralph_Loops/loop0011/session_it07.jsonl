{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R5P4cgsGPMLpTsQLXfBmdq","type":"tool_result","content":"def test_the_constants_are_ordered():\n    for c in (2.5, 3.0, 4.0, 6.0, 10.0, 16.0):\n        bs = beta_star_gnp(c)\n        lo, hi = rate_bracket(c * (1 - bs))\n        assert lo <= ldp_rate(c * (1 - bs), 0.5) <= hi + 1e-12\n        b_cited = beta_sep(c)\n        b_hi = beta_sep(c, lambda cp: rate_bracket(cp)[1])\n        assert bs <= b_cited <= b_hi\n        assert beta_closed(c) >= bs\n    # the separator count is positive strictly above 2 ln 2 and zero below (cited rate)\n    assert beta_sep(1.2) == 0.0\n    assert beta_sep(2.0) > 0.0\n    assert beta_star_gnp(2.0) == 0.0\n\n\ndef test_ldp_rate_zero_at_the_giant_and_positive_below_half():\n    assert ldp_rate(3.0, 0.5) == pytest.approx(0.18309, abs=1e-4)\n    assert ldp_rate(10.0, 0.5) == pytest.approx(1.81023, abs=1e-4)\n    assert ldp_rate(1.2, 0.5) == 0.0\n    assert ldp_rate(3.0, 0.99) == 0.0\n    assert 0 < ldp_rate(3.0, 0.7) < ldp_rate(3.0, 0.5)\n\n\ndef test_combined_exponent_reduces_to_the_separator_form_at_the_corner():\n    # at s = β the window is the balanced bipartition (u = ½) and the exponent is\n    # H(β) + 2β ln q((1−β)/2) − (1−β) J(c′, ½)\n    c, b = 6.0, 0.18\n    J = lambda cp, u: 0.5 + 0.1 * u\n    v = combined_exponent(c, b, b, J)\n    q = math.log(-math.expm1(-c * (1 - b) / 2))\n    H = -b * math.log(b) - (1 - b) * math.log(1 - b)\n    assert v == pytest.approx(H + 2 * b * q - (1 - b) * J(c * (1 - b), 0.5), abs=1e-12)\n    assert combined_exponent(c, b, b + 0.01, J) == -math.inf\n    assert 0 < beta_combined(c, J) < 1\n\n\ndef test_edwards_mcdermid_and_the_slope_conversion():\n    assert [round(edwards_mcdermid_poisson(c), 3) for c in (3, 6, 10)] == [0.183, 0.458, 0.656]\n    assert exponent_slope_at(6.0, beta_star_gnp(6.0)) == pytest.approx(3.38, abs=0.02)\n    assert exponent_slope_at(10.0, beta_star_gnp(10.0)) == pytest.approx(3.30, abs=0.02)\n-----\n\"\"\"The deterministic structures of the separator first moment (loop0011 item 02;\n`reports/separator_moment.md` §2).\n\nA layout of vertex separation `≤ k < n` forces, with `N = n − k` and\n`t = ⌈N/2⌉`:\n\n* **L1, the balanced separator at exact sizes** — disjoint `A, R, S` with\n  `A ∪ R ∪ S = V`, `|A| = t`, `|R| = N − t`, `|S| = k`, no `A–R` edge;\n* **L1′, the separator events** — a `k`-set `S` whose removal leaves components\n  that can be grouped into two sides of sizes `t` and `N − t` (`E_bip`), hence\n  no component larger than `t` (`E_relax`, strictly weaker);\n* **L2, the closed pair** — an empty pair `(A*, R*)` with `A* = V ∖ N[R*]`,\n  `R* = V ∖ N[A*]`, sides at least the forced sizes and `|S*| ≤ k`, reached\n  from any exact-size pair by the alternating closure, which stops after one\n  round (`R₁ = V ∖ N[A]`, `A₁ = V ∖ N[R₁]`, and then `R₂ = R₁`).\n\nGraphs are adjacency bit masks (`adj[v]` has bit `u` iff `u ~ v`), vertex sets\nare bit masks. Everything here is exact and enumerative; nothing is\nprobabilistic. Checked on every graph to 9 vertices, 20,000 random graphs at\n10–12 and 2,000 random covers at ≤ 10 customers by\n`reports/scratch/separator_moment/02_lemmas/check.py`.\n\"\"\"\nfrom __future__ import annotations\n\nimport math\nimport random\nfrom itertools import combinations\nfrom math import comb\nfrom typing import Iterator\n\nimport numpy as np\n\n__all__ = [\n    \"forced_sizes\", \"vertex_separation\", \"closed_nbhd\", \"open_nbhd\",\n    \"is_empty_pair\", \"count_exact_pairs\", \"exact_pairs\", \"components\",\n    \"separator_events\", \"count_separators\", \"close_pair\", \"closure_sequence\",\n    \"is_closed_pair\", \"closed_pairs\", \"popcount\", \"mosp_masks\",\n    \"pattern_meets_both\", \"shares_pattern\",\n    # item 03: the clumping decomposed\n    \"small_nbhd_sets\", \"enumerate_empty_pairs\", \"separators_of\",\n    \"closed_pairs_pruned\", \"closure_image\", \"move_classes\", \"overlap_tables\",\n    \"second_moment_rate_gnp\", \"second_moment_exact_gnp\", \"second_moment_enum_gnp\",\n    \"gnp_masks\",\n    # item 04: the planted cluster\n    \"beta_star_gnp\", \"plant_pair\", \"plant_cover\", \"overlap_table\", \"hamming_distance\",\n    \"lq_sides\", \"second_moment_exact_cover\", \"planted_mean_gnp\", \"planted_mean_cover\",\n    # item 05: the inner probability, exactly\n    \"connected_probs\", \"log_connected\", \"partitions\", \"log_prob_partition\",\n    \"log_prob_bip\", \"log_prob_rel\", \"log_prob_bip_enum\", \"log_prob_bip_mc\",\n    \"log_connected_enum\", \"log_connected_mc\", \"log_product_bound\",\n]\n\n\n-----\n    for d in range(0, dmax + 1):\n        if d >= 3:\n            out += math.exp(lp) * g[d]\n        lp += math.log(c) - math.log(d + 1)\n    return out","is_error":false}]},"parent_tool_use_id":null,"session_id":"d18e1e5c-be10-4026-a9cc-cded248cca2c","uuid":"41d34ea2-4bb4-4d6d-a8d9-54840e2389ce","timestamp":"2026-11-01T18:10:46.697Z","tool_use_result":{"stdout":"def test_the_constants_are_ordered():\n    for c in (2.5, 3.0, 4.0, 6.0, 10.0, 16.0):\n        bs = beta_star_gnp(c)\n        lo, hi = rate_bracket(c * (1 - bs))\n        assert lo <= ldp_rate(c * (1 - bs), 0.5) <= hi + 1e-12\n        b_cited = beta_sep(c)\n        b_hi = beta_sep(c, lambda cp: rate_bracket(cp)[1])\n        assert bs <= b_cited <= b_hi\n        assert beta_closed(c) >= bs\n    # the separator count is positive strictly above 2 ln 2 and zero below (cited rate)\n    assert beta_sep(1.2) == 0.0\n    assert beta_sep(2.0) > 0.0\n    assert beta_star_gnp(2.0) == 0.0\n\n\ndef test_ldp_rate_zero_at_the_giant_and_positive_below_half():\n    assert ldp_rate(3.0, 0.5) == pytest.approx(0.18309, abs=1e-4)\n    assert ldp_rate(10.0, 0.5) == pytest.approx(1.81023, abs=1e-4)\n    assert ldp_rate(1.2, 0.5) == 0.0\n    assert ldp_rate(3.0, 0.99) == 0.0\n    assert 0 < ldp_rate(3.0, 0.7) < ldp_rate(3.0, 0.5)\n\n\ndef test_combined_exponent_reduces_to_the_separator_form_at_the_corner():\n    # at s = β