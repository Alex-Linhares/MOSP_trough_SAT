(x + y) * H2(x / (x + y)) if x + y > 0 else 0.0","+        return -g + flip_cover_tail_exponent(x, y, alpha, rho, sigma, mu, sizes)","+","+    best = (-math.inf, 0.0, 0.0)","+    for i in range(grid + 1):","+        for j in range(grid + 1):","+            x, y = alpha * i / grid, rho * j / grid","+            v = obj(x, y)","+            if v > best[0]:","+                best = (v, x, y)","+    from scipy.optimize import minimize","+    res = minimize(lambda z: -obj(z[0], z[1]), [best[1], best[2]], method=\"Nelder-Mead\",","+                   options={\"xatol\": 1e-6, \"fatol\": 1e-10, \"maxiter\": 400})","+    if -res.fun > best[0]:","+        best = (-float(res.fun), float(min(max(res.x[0], 0.0), alpha)), float(min(max(res.x[1], 0.0), rho)))","+    return H + best[0], best[1], best[2]","+","+","+def flip_cover_exponent_beta(beta: float, mu: float, sizes) -> float:","+    a = (1 - beta) / 2","+    return flip_cover_exponent_na(a, a, beta, mu, sizes)[0]","+","+","+def beta_flip_cover(mu: float, sizes) -> float:","+    \"\"\"`β_flip(d, μ)`: the root in `β` of the weighted count's exponent.\"\"\"","+    return _root_beta_bisect(lambda b: flip_cover_exponent_beta(b, mu, sizes), tol=1e-5)","+","+","+def flip_log_bound_fast(n: int, k: int, sizes) -> tuple[float, float]:","+    \"\"\"`flip_log_bound` with the Möbius inversion in integers over a common","+    denominator and separated into its two one-dimensional sums (`n = 125`","+    in seconds).\"\"\"","+    from fractions import Fraction","+    from learning.first_moment import lchoose","+    N, t = forced_sizes(n, k)","+    a, r = t, N - t","+    s = n - a - r","+    hist = _hist(sizes)","+    Bn = [[0] * (r + 1) for _ in range(a + 1)]","+    for u in range(a + 1):","+        for up in range(r + 1):","+            v = comb(a, u) * comb(r, up)","+            for sz, cnt in hist.items():","+                allowed = comb(a - u + s, sz) + u * comb(s, sz - 1) + comb(r - up + s, sz) + up * comb(s, sz - 1) - comb(s, sz)","+                v *= allowed ** cnt","+            Bn[u][up] = v","+    # inner inversion over u′ for every (u, i′), then over u for every (i, i′)","+    inner = [[0] * (r + 1) for _ in range(a + 1)]","+    for u in range(a + 1):","+        row = Bn[u]","+        for ip in range(r + 1):","+            acc = 0","+            for up in range(ip, r + 1):","+                term = comb(up, ip) * row[up]","+                acc += -term if (up - ip) & 1 else term","+            inner[u][ip] = acc","+    Pn = [[0] * (r + 1) for _ in range(a + 1)]","+    for ip in range(r + 1):","+        for i in range(a + 1):","+            acc = 0","+            for u in range(i, a + 1):","+                term = comb(u, i) * inner[u][ip]","+                acc += -term if (u - i) & 1 else term","+            Pn[i][ip] = acc","+    logD = sum(cnt * math.log(comb(n, sz)) for sz, cnt in hist.items())","+    EY = Fraction(0)","+    EX = 0","+    for i in range(a + 1):","+        for ip in range(r + 1):","+            if Pn[i][ip] < 0:","+                raise ArithmeticError(\"negative probability numerator\")","+            EY += Fraction(Pn[i][ip], comb(i + ip, i))","+            EX += Pn[i][ip]","+    lp = lchoose(n, t) + lchoose(n - t, r)","+    lY = lp + (math.log(EY.numerator) - math.log(EY.denominator) - logD) if EY > 0 else -math.inf","+    lX = lp + (math.log(EX) - logD) if EX > 0 else -math.inf","+    return lY, lX"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/learning/separator_moment.py"]}},"tool_result_meta":[{"id":"toolu_01YWMsgSNu3vhuWmTDDP6FKd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
