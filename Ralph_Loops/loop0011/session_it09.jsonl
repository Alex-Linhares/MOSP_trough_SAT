igma: float, mu: float, sizes, grid: int = 8):\n2062:def flip_cover_exponent_beta(beta: float, mu: float, sizes) -> float:\n2067:def beta_flip_cover(mu: float, sizes) -> float:\n2076:def flip_log_bound_fast(n: int, k: int, sizes) -> tuple[float, float]:\n2147:def connected_probs_exact(N: int, p) -> list:\n2161:def prob_relax_exact(N: int, p, M: int, C: list | None = None):\n2177:def prob_bip_exact(N: int, p, t: int | None = None, C: list | None = None):\n2206:def pair_count_exact(n: int, k: int, p):\n2214:def closed_count_exact(n: int, k: int, p):\n2230:def weighted_graph_count(N: int, p, event) -> \"Fraction\":\n2244:def isolated_in(adj: list[int], A: int) -> int:\n2256:def flip_swaps(adj: list[int], A: int, R: int) -> list[tuple[int, int]]:\n2274:def flip_count(adj: list[int], A: int, R: int) -> tuple[int, int, int]:\n2280:def weighted_count(pairs, Z) -> \"Fraction\":\n----\n38:    beta_star_gnp, closed_pairs_pruned, closure_image, enumerate_empty_pairs, forced_sizes, gnp_masks,\n39:    hamming_distance, mosp_masks, move_classes, overlap_table, plant_cover, plant_pair, planted_mean_cover,\n58:FIELDS = [\"source\", \"cell\", \"n\", \"c\", \"beta_label\", \"beta_nominal\", \"k\", \"beta\", \"N\", \"t\", \"r\", \"sample\", \"seed\",\n64:def seed_of(src: str, n: int, c: int, beta_label: str, i: int) -> int:\n68:def cells() -> list[dict]:\n86:def planted_instance(cell: dict, i: int):\n87:    \"\"\"The planted graph (adjacency masks), the planted pair and the seed.\"\"\"\n93:    seed = seed_of(cell[\"source\"], n, cell[\"c\"], cell[\"beta_label\"], i)\n95:        adj = plant_pair(gnp_masks(n, cell[\"c\"] / n, seed), A, R)\n97:        M = plant_cover(n, n, COVER_D, A, R, np.random.default_rng(seed))\n99:    return adj, (A, R), seed\n102:def planted_one(job):\n108:    adj, P0, seed = planted_instance(cell, i)\n113:               beta_nominal=cell[\"beta_nominal\"], k=k, beta=round(k / n, 4), N=N, t=t, r=r, sample=i, seed=seed,\n123:        pairs = enumerate_empty_pairs(adj, k, MAX_PAIRS)\n177:        rng = np.random.default_rng(seed)\n195:def stage_run(workers: int, per_cell: int, probe: bool = False) -> None:\n254:def ols(x, y):\n265:def stage_stats() -> None:\n388:def stage_draw() -> None:\n427:def main() -> None:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UBNGS7vzyfWvEMx6YxFGwe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
