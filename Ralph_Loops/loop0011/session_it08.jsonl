n                assert (ia, ir) == (popcount(IA), popcount(IR)) and Z == comb(ia + ir, ia)\n                assert sw[0] == (A, R) and len(sw) == len(set(sw)) == Z                     # injective\n                assert all(Q in pset for Q in sw)                                           # exact-size empty pairs\n                assert all(popcount(Q[0]) == popcount(A) and popcount(Q[1]) == popcount(R)\n                           and is_empty_pair(adj, *Q) for Q in sw)\n                assert 1 <= Z <= X and 1 <= Zm[(A, R)] <= X\n            Yf = weighted_count(ps, lambda P: flip_count(adj, *P)[2])\n            Ym = weighted_count(ps, lambda P: Zm[P])\n            assert 1 <= Yf <= X and Ym == len(size) <= X                                    # Lemma W\n    with pytest.raises(ValueError):\n        weighted_count([(1, 2)], lambda P: 0)\nEOF\ntimeout 900 python3 -m pytest tests/test_separator_moment.py -q -k \"gilbert or theorems_S or flip_lemma\" 2>&1 | tail -5; echo ----; tail -5 reports/scratch/separator_moment/08_theorems/check.log","description":"Append item 08 tests, run them, and peek at the background check"}},"wire_ingest_context":{"toolu_017fyCmfZDCFZKWH4vkf7aCz":{"cwd":"/home/al/dev/MOSP"}}}
