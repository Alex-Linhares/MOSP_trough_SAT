ize empty) pairs — the\n    connected components of the graph in which two pairs are adjacent when\n    their labellings `V → {A, R, S}` differ on at most two vertices. Returns\n    the class index of every pair (classes numbered from 0 in order of first\n    appearance); `X₄ = max + 1`.\"\"\"\n    full = (1 << n) - 1\n    index = {P: i for i, P in enumerate(pairs)}\n    parent = list(range(len(pairs)))\n\n    def find(i: int) -> int:\n        while parent[i] != i:\n            parent[i] = parent[parent[i]]\n            i = parent[i]\n        return i\n\n    def union(i: int, j: int) -> None:\n        ri, rj = find(i), find(j)\n        if ri != rj:\n            parent[max(ri, rj)] = min(ri, rj)\n\n    for i, (A, R) in enumerate(pairs):\n        S = full & ~(A | R)\n        av = [v for v in range(n) if A >> v & 1]\n        rv = [v for v in range(n) if R >> v & 1]\n        sv = [v for v in range(n) if S >> v & 1]\n        for a in av:\n            Aa = A & ~(1 << a)\n            for s in sv:                       # A ↔ S\n                j = index.get((Aa | (1 << s), R))\n                if j is not None:\n                    union(i, j)\n            for r in rv:                       # A ↔ R\n                j = index.get((Aa | (1 << r), (R & ~(1 << r)) | (1 << a)))\n                if j is not None:\n                    union(i, j)\n        for r in rv:\n            Rr = R & ~(1 << r)\n            for s in sv:                       # R ↔ S\n                j = index.get((A, Rr | (1 << s)))\n                if j is not None:\n                    union(i, j)\n    roots = {}\n    out = []\n    for i in range(len(pairs)):\n        r = find(i)\n        out.append(roots.setdefault(r, len(roots)))\n    return out\n\n\ndef overlap_tables(pairs: list[tuple[int, int]], n: int) -> np.ndarray:\n    \"\"\"For every ordered pair of *distinct* pairs `(P, P′)`, the `3 × 3`\n====\n            a = rng.randint(1, n - 1)\n            r = rng.randint(1, n - a)\n            A, R = (1 << a) - 1, ((1 << r) - 1) << a\n            counts = {}\n            tot = 0\n            for masks in all_covers(n, sizes):\n                tot += 1\n                if any(mk & A and mk & R for mk in masks):\n                    continue\n                iA = sum(1 for v in range(a) if not any((mk >> v & 1) and (mk & A & ~(1 << v)) for mk in masks))\n                iR = sum(1 for v in range(a, a + r) if not any((mk >> v & 1) and (mk & R & ~(1 << v)) for mk in masks))\n                counts[(iA, iR)] = counts.get((iA, iR), 0) + 1\n            pmf = flip_joint_pmf(n, a, r, sizes)\n            assert all(pmf[i][ip] == Fraction(counts.get((i, ip), 0), tot) for i in range(a + 1) for ip in range(r + 1))\n    for n, k in ((7, 2), (9, 3)):\n        sizes = [2, 3, 2, 4]\n        slow, fast = flip_log_bound(n, k, sizes), flip_log_bound_fast(n, k, sizes)\n        assert slow == pytest.approx(fast, abs=1e-9)\n        assert slow[0] <= slow[1] + 1e-12       # the weighted count never exceeds the pair count\n        assert slow[1] == pytest.approx(cover_log_pair_bound(n, k, sizes), abs=1e-9)\n    d, mu = 6, 1.0\n    b = beta_star_cover(mu, {d: 1})\n    a = (1 - b) / 2\n    v, x, y = flip_cover_exponent_na(a, a, b, mu, {d: 1}, grid=4)\n    assert -0.02 < v < 0.0 and 0 <= x <= a and 0 <= y <= a\n\n\ndef test_rig_giant_and_the_half_giant_line():\n    assert rig_giant(0.5, {2: 1}) == 0.0                       # branching factor exactly 1\n    assert rig_branching_factor(0.5, {2: 1}) == pytest.approx(1.0)\n    assert rig_giant(0.25, {3: 1}) > 0 and rig_giant(1.0, {2: 1}) == pytest.approx(0.7968, abs=1e-3)\n    th = rig_giant(1.0, {6: 1})\n    assert 1 - th == pytest.approx(math.exp(-6 * (1 - (1 - th) ** 5)), abs=1e-9)\n    for mu in (0.25, 0.5, 1.0, 2.0):\n        d = half_giant_line(mu)\n        e = mu * (d - 1)\n        e_g = (math.sqrt(mu * mu + 4 * mu) - mu) / 2\n        assert e_g < e < 1.0\n        assert rig_giant(mu, {d: 1}) == pytest.approx(0.5, abs=1e-6)\n    assert 0 < edwards_mcdermid_cover(1.0, {6: 1}) < 1\n====\n#!/usr/bin/env python3\n\"\"\"Regression gate for loop0011 (the separator first moment).\n\nPasses only if all five hold:\n1. `lake build` in lean/ succeeds;\n2. every `.lean` file under lean/MOSPFormalization/ (top level, Complex/ and\n   Search/) is imported by lean/MOSPFormalization.lean, so the build really\n   checks it;\n3. the number of `sorry` in Lean *code* (comments and docstrings stripped) is\n   at most the baseline (0: the development has none since Appendix E) plus\n   the entries in allowed_sorries.txt, and no `axiom` declaration exists;\n4. `python -m pytest tests/ -q -x` passes, and so does `pytest` in\n   pathwidth_solver/;\n5. the paper builds with no undefined references (`make -C paper1/latex check`).\n\n    python3 Ralph_Loops/loop0011/gate.py\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nREPO = HERE.parents[1]\nLEAN = REPO / \"lean\"\nBASELINE_SORRIES = 0\nALLOWED = HERE / \"allowed_sorries.txt\"\nPAPER = REPO / \"paper1\" / \"latex\"\n\n\ndef strip_comments(src: str) -> str:\n    out, i, depth = [], 0, 0\n    while i < len(src):\n        if src.startswith(\"/-\", i):\n            depth += 1; i += 2; continue\n        if depth and src.startswith(\"-/\", i):\n            depth -= 1; i += 2; continue\n        if depth:\n21:import subprocess\n33:def strip_comments(src: str) -> str:\n53:def main() -> int:\n55:    b = subprocess.run([\"lake\", \"build\"], cwd=LEAN, capture_output=True, text=True, errors=\"replace\")\n83:    t = subprocess.run([sys.executable, \"-m\", \"pytest\", \"tests/\", \"-q\", \"-x\"], cwd=REPO,\n88:    w = subprocess.run([sys.executable, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\"],\n94:    m = subprocess.run([\"make\", \"check\"], cwd=PAPER, capture_output=True, text=True, errors=\"replace\")\n====\n\"\"\"Brute-force check of the deterministic lemmas L1, L1′,