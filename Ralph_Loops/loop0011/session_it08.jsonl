ask >> i & 1:\n                adj[u] |= 1 << v\n                adj[v] |= 1 << u\n        yield adj\n\n\ndef random_graph(n, p, seed):\n    rng = random.Random(seed)\n    adj = [0] * n\n    for u, v in combinations(range(n), 2):\n        if rng.random() < p:\n            adj[u] |= 1 << v\n            adj[v] |= 1 << u\n    return adj\n\n\ndef test_vertex_separation_agrees_with_the_two_other_implementations():\n    for n in range(1, 6):\n        for adj in all_labelled_graphs(n):\n            G = nx.Graph()\n            G.add_nodes_from(range(n))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01ULncuFDzFX2h1b3ALHZa52","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
