d(set(pw))} }\")\n        p = Fraction(3, 10)\n        for k in range(n):\n            t = (n - k + 1) // 2\n            lhs = sum(1 for w in pw if w <= k)\n            rhs = comb(n, t) * comb(n - t, t - 1) * 2 ** (C - t * (t - 1))\n            ok = lhs <= rhs\n            # corollary 1 (multiplied through)\n            ok1 = lhs * 2 ** (t * (t - 1)) <= comb(n, t) * comb(n - t, t - 1) * 2 ** C\n            # weighted corollary at p = 3/10\n            wsum = sum(p ** len(e) * (1 - p) ** (C - len(e))\n                       for w, e in zip(pw, edge_sets) if w <= k)\n            wrhs = comb(n, t) * comb(n - t, t - 1) * (1 - p) ** (t * (t - 1))\n            ok2 = wsum <= wrhs\n            if not (ok and ok1 and ok2):\n                violations += 1\n            print(f\"  k={k} t={t}: #{{pw<=k}}={lhs} <= C({n},{t})*C({n-t},{t-1})\"\n                  f\"*2^({C}-{t*(t-1)})={rhs} {'OK' if ok else 'VIOLATION'};\"\n                  f\" mult {'OK' if ok1 else 'VIOLATION'};\"\n                  f\" weighted(p=0.3) {float(wsum):.6f} <= {float(wrhs):.6f}\"\n                  f\" {'OK' if ok2 else 'VIOLATION'}\")\n        # card_graphs_avoiding: for every disjoint (A, R), count graphs with no A-R edge\n        if n <= 5:\n            checked = 0\n            for A in itertools.chain.from_iterable(\n                    itertools.combinations(range(n), a) for a in range(n + 1)):\n                rest = [v for v in range(n) if v not in A]\n                for R in itertools.chain.from_iterable(\n                        itertools.combinations(rest, r) for r in range(len(rest) + 1)):\n                    cnt = sum(1 for e in edge_sets\n                              if not any((a, r) in e or (r, a) in e\n                                         for a in A for r in R))\n                    expect = 2 ** (C - len(A) * len(R))\n                    if cnt != expect:\n                        violations += 1\n                        print(f\"  AVOID VIOLATION A={A} R={R}: {cnt} != {expect}\")\n                    checked += 1\n            print(f\"  card_graphs_avoiding: {checked} disjoint (A, R) pairs checked, \"\n                  f\"all equal to 2^(C(n,2) - |A||R|)\")\n    print(f\"violations: {violations}\")\n\n\nif __name__ == \"__main__\":\n    main()\n====\n64:def popcount(x: int) -> int:\n68:def forced_sizes(n: int, k: int) -> tuple[int, int]:\n76:def vertex_separation(adj: list[int]) -> int:\n102:def closed_nbhd(adj: list[int], A: int) -> int:\n113:def open_nbhd(adj: list[int], A: int) -> int:\n118:def is_empty_pair(adj: list[int], A: int, R: int) -> bool:\n123:def count_exact_pairs(adj: list[int], k: int) -> int:\n137:def exact_pairs(adj: list[int], k: int) -> Iterator[tuple[int, int]]:\n152:def components(adj: list[int], mask: int) -> list[int]:\n171:def _subset_sum(sizes: list[int], target: int) -> bool:\n180:def separator_events(adj: list[int], S: int, k: int) -> tuple[bool, bool]:\n193:def count_separators(adj: list[int], k: int) -> tuple[int, int]:\n205:def closure_sequence(adj: list[int], A: int, R: int, rounds: int = 2) -> list[tuple[int, int]]:\n222:def close_pair(adj: list[int], A: int, R: int, side: str = \"A\") -> tuple[int, int]:\n236:def is_closed_pair(adj: list[int], A: int, R: int) -> bool:\n244:def closed_pairs(adj: list[int], k: int) -> list[tuple[int, int]]:\n267:def mosp_masks(matrix: np.ndarray) -> list[int]:\n280:def pattern_meets_both(matrix: np.ndarray, A: int, R: int) -> bool:\n290:def shares_pattern(matrix: np.ndarray, c: int, A: int) -> bool:\n312:def small_nbhd_sets(adj: list[int], limit: int, min_size: int = 0,\n340:def enumerate_empty_pairs(adj: list[int], k: int, max_pairs: int | None = None) -> list[tuple[int, int]]:\n360:def separators_of(pairs: Iterator[tuple[int, int]] | list[tuple[int, int]], n: int) -> set[int]:\n367:def closed_pairs_pruned(adj: list[int], k: int, max_sets: int | None = None) -> list[tuple[int, int]]:\n383:def closure_image(adj: list[int], pairs, side: str = \"A\") -> set[tuple[int, int