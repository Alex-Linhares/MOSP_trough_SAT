{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016FdpMmrjuxSajh4LVkSfey","type":"tool_result","content":" 13:58:42 up 13 days,  2:03,  1 user,  load average: 0.30, 1.39, 10.15\nsolved g_n16_c8\nsolved g_n16_c6\nsolved g_n16_c4\n6548 instances written\nstage solve: 7 s\n\nreal\t0m6.988s\nuser\t0m33.963s\nsys\t0m1.506s","is_error":false}]},"parent_tool_use_id":null,"session_id":"99e0a273-33c3-4f3b-baa2-104bceac5e28","uuid":"9dac3cc4-66e8-41ed-ab26-902a77e70e9b","timestamp":"2026-11-01T13:58:49.103Z","tool_use_result":{"stdout":" 13:58:42 up 13 days,  2:03,  1 user,  load average: 0.30, 1.39, 10.15\nsolved g_n16_c8\nsolved g_n16_c6\nsolved g_n16_c4\n6548 instances written\nstage solve: 7 s\n\nreal\t0m6.988s\nuser\t0m33.963s\nsys\t0m1.506s","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":true,"bashEditDiff":{"files":[{"filePath":"/home/al/dev/MOSP/reports/scratch/separator_moment/03_clumping/run.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":370,"lines":["+\"\"\"loop0011 item 03: the clumping decomposed — exact-size empty pairs `X₁`,","+distinct separators `X₂`, closed pairs `X₃` (and the closure image `X₃′`) and","+move-classes `X₄` on graphs with exact pathwidth (`reports/separator_moment.md` §3).","+","+    nice -n 19 python3 reports/scratch/separator_moment/03_clumping/run.py --workers 8","+    (stages: solve, count, rates, overlap; `--stage` runs one)","+","+Stage `solve` draws fresh `G(n, c/n)` at `n ∈ {14, …, 24}`, `c ∈ {4, 6, 8, 10}`,","+200 per cell (seed = CRC of the cell and index), proves the width with the C","+program `pathwidth_solver/cli/pathwidth -l -t 60` (layout kept) and, at","+`n ≤ 16`, checks it against the subset DP; it also lists the pilot's `n = 20`","+graphs at `c ∈ {4, 6, 8, 10}` (widths on record, `reports/scratch/gnp_pilot/results.csv`)","+and the certified `fixed` covers of `learning/data/ensemble/results.csv` at","+`n ∈ {10, 15, 20, 25}`, `d ∈ {4, 6}`, `m = n` (`pw = optimum − 1`). Nothing on","+record is re-solved. Stage `count` enumerates the four counts at","+`k = pw − 1, pw, pw + 1, pw + 2`; `rates` fits the slopes; `overlap`","+histograms the overlap tables of pairs of pairs at `n = 20`, `c = 10`.","+\"\"\"","+from __future__ import annotations","+","+import argparse","+import csv","+import math","+import os","+import subprocess","+import sys","+import time","+import zlib","+from multiprocessing import Pool","+from pathlib import Path","+","+import networkx as nx","+import numpy as np","+","+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))","+","+from learning.separator_moment import (  # noqa: E402","+    closed_pairs, closed_pairs_pruned, closure_image, count_exact_pairs, enumerate_empty_pairs,","+    forced_sizes, gnp_masks, mosp_masks, move_classes, overlap_tables, popcount,","+    second_moment_rate_gnp, separators_of, vertex_separation,","+)","+","+HERE = Path(__file__).resolve().parent","+ROOT = Path(__file__).resolve().parents[4]","+CLI = ROOT / \"pathwidth_solver/cli/pathwidth\"","+PILOT = ROOT / \"reports/scratch/gnp_pilot/results.csv\"","+ENSEMBLE = ROOT / \"learning/data/ensemble/results.csv\"","+","+SIZES = [14, 16, 18, 20, 22, 24]","+CS = [4, 6, 8, 10]","+PER_CELL = 200","+COVER_N = [10, 15, 20, 25]","+COVER_D = [4, 6]","+MAX_PAIRS = 2_000_000       # above this X₁ is counted by binomials and the rest skipped","+MAX_X4_PAIRS = 400_000      # above this the move-classes are skipped","+MAX_SETS = 3_000_000        # the pruned family for X₃","+","+INST_FIELDS = [\"source\", \"cell\", \"n\", \"c\", \"sample\", \"seed\", \"edges\", \"pw\", \"status\", \"dp_pw\", \"layout\"]","+COUNT_FIELDS = [\"source\", \"cell\", \"n\", \"c\", \"sample\", \"pw\", \"k\", \"N\", \"t\", \"X1\", \"X2\", \"X3\", \"X3p\", \"X3_check\", \"X4\", \"seconds\", \"note\"]","+","+","+def fresh_seed(n: int, c: int, i: int) -> int:","+    return zlib.crc32(f\"sep03:{n}:{c}:{i}\".encode()) & 0x7FFFFFFF","+","+","+def g6(n: int, p: float, seed: int) -> str:","+    return nx.to_graph6_bytes(nx.gnp_random_graph(n, p, seed=seed), header=False).decode().strip()","+","+","+def run_cli(lines: list[str], budget: int = 60) -> list[tuple[int, str, str]]:","+    out = subprocess.run([str(CLI), \"-l\", \"-t\", str(budget)], input=\"\\n\".join(lines) + \"\\n\",","+                         capture_output=True, text=True, check=True).stdout.splitlines()","+    res = []","+    it = iter(out)","+    for a in it:","+        b = next(it)","+        _, w, status = a.split()","+        res.append((int(w), status, b.split(\" \", 1)[1]))","+    return res","+","+","+def solve_cell(args):","+    n, c = args","+    seeds = [fresh_seed(n, c, i) for i in range(PER_CELL)]","+    lines = [g6(n, c / n, s) for s in seeds]","+    res = run_cli(lines)","+    rows = []","+    for i, (s, (w, status, layout)) in enumerate(zip(seeds, res)):","+        adj = gnp_masks(n, c / n, s)","+        dp = vertex_separation(adj) if n <= 16 else \"\"","+        if dp != \"\" and dp != w:","+            raise RuntimeError(f\"DP {dp} != C {w} at n={n} c={c} seed={s}\")","+        rows.append(dict(source=\"fresh\", cell=f\"g_n{n}_c{c}\", n=n, c=c, sample=i, seed=s,","+                         edges=sum(popcount(a) for a in adj) // 2, pw=w, status=status, dp_pw=dp, layout=layout))","+    return rows","+","+","+def stage_solve(workers: int) -> None:","+    rows = []","+    with Pool(workers) as pool:","+        for r in pool.imap_unordered(solve_cell, [(n, c) for n in SIZES for c in CS]):","+            rows += r","+            print(f\"solved {r[0]['cell']}\", flush=True)","+    with PILOT.open() as f:","+        for r in csv.DictReader(f):","+            if int(r[\"n\"]) == 20 and float(r[\"c\"]) in CS and r[\"status\"] in (\"bound\", \"refutation\", \"minor\"):","+                c = int(float(r[\"c\"]))","+                rows.append(dict(source=\"pilot\", cell=f\"p_n20_c{c}\", n=20, c=c, sample=int(r[\"sample\"]),","+                                 seed=int(r[\"seed\"]), edges=int(r[\"m\"]), pw=int(r[\"width\"]), status=r[\"status\"],","+                                 dp_pw=\"\", layout=r[\"layout\"]))","+    with ENSEMBLE.open() as f:","+        for r in csv.DictReader(f):","+            if r[\"generator\"] == \"fixed\" and r[\"m\"] == r[\"n\"] and int(r[\"n\"]) in COVER_N \\","+                    and float(r[\"param\"]) in COVER_D and r[\"certified\"] == \"True\":","+                rows.append(dict(source=\"cover\", cell=r[\"cell\"], n=int(r[\"n\"]), c=int(float(r[\"param\"])),","+                                 sample=int(r[\"index\"]), seed=int(r[\"seed\"]), edges=\"\", pw=int(r[\"optimum\"]) - 1,","+                                 status=\"certified\", dp_pw=\"\", layout=\"\"))","+    rows.sort(key=lambda r: (r[\"source\"], r[\"n\"], r[\"c\"], r[\"sample\"]))","+    with (HERE / \"instances.csv\").open(\"w\", newline=\"\") as f:","+        w = csv.DictWriter(f, INST_FIELDS)","+        w.writeheader()","+        w.writerows(rows)","+    print(f\"{len(rows)} instances written\")","+","+","+def masks_of(r: dict) -> list[int]:","+    n = int(r[\"n\"])","+    if r[\"source\"] == \"cover\":","+        from learning.ensemble import Cell, generate","+        inst = generate(Cell.parse(f\"f:{n}:{n}:{r['c']}\"), int(r[\"sample\"]))","+        return mosp_masks(inst.matrix)","+    return gnp_masks(n, float(r[\"c\"]) / n, int(r[\"seed\"]))","+","+","+def count_one(r: dict) -> list[dict]:","+    n, pw = int(r[\"n\"]), int(r[\"pw\"])","+    adj = masks_of(r)","+    if r[\"source\"] == \"cover\":","+        # the certified optimum is pw + 1; cross-check the DP where it is cheap","+        if n <= 16:","+            assert vertex_separation(adj) == pw, (r[\"cell\"], r[\"sample\"])","+    out = []","+    for k in (pw - 1, pw, pw + 1, pw + 2):","+        if k < 0 or k >= n:","+            continue","+        t0 = time.monotonic()","+        N, t = forced_sizes(n, k)","+        row = dict(source=r[\"source\"], cell=r[\"cell\"], n=n, c=r[\"c\"], sample=r[\"sample\"], pw=pw, k=k, N=N, t=t,","+                   X1=\"\", X2=\"\", X3=\"\", X3p=\"\", X3_check=\"\", X4=\"\", seconds=\"\", note=\"\")","+        try:","+            pairs = enumerate_empty_pairs(adj, k, MAX_PAIRS)","+        except OverflowError:","+            row[\"X1\"] = count_exact_pairs(adj, k)","+            row[\"note\"] = \"X1 by binomials; X2, X3, X4 skipped (pairs > cap)\"","+            row[\"seconds\"] = round(time.monotonic() - t0, 3)","+            out.append(row)","+            continue","+        row[\"X1\"] = len(pairs)","+        row[\"X2\"] = len(separators_of(pairs, n))","+        try:","+            X3 = closed_pairs_pruned(adj, k, MAX_SETS)","+            row[\"X3\"] = len(X3)","+            if n <= 16 and k == pw:","+                row[\"X3_check\"] = len(closed_pairs(adj, k))","+                assert row[\"X3_check\"] == row[\"X3\"], (r[\"cell\"], r[\"sample\"])","+        except OverflowError:","+            row[\"note\"] += \"X3 skipped (sets > cap); \"","+        row[\"X3p\"] = len(closure_image(adj, pairs))","+        if len(pairs) <= MAX_X4_PAIRS:","+            row[\"X4\"] = max(move_classes(pairs, n)) + 1 if pairs else 0","+        else:","+            row[\"note\"] += \"X4 skipped (pairs > cap); \"","+        row[\"seconds\"] = round(time.monotonic() - t0, 3)","+        out.append(row)","+    return out","+","+","+def stage_count(workers: int) -> None:","+    with (HERE / \"instances.csv\").open() as f:","+        rows = list(csv.DictReader(f))","+    # hardest first so the pool's tail is short","+    rows.sort(key=lambda r: (-int(r[\"n\"]), int(r[\"c\"])))","+    done = 0","+    t0 = time.monotonic()","+    with (HERE / \"counts.csv\").open(\"w\", newline=\"\") as f, Pool(workers) as pool:","+        w = csv.DictWriter(f, COUNT_FIELDS)","+        w.writeheader()","+        for res in pool.imap_unordered(count_one, rows, chunksize=4):","+            w.writerows(res)","+            done += 1","+            if done % 200 == 0:","+                f.flush()","+                print(f\"counted {done}/{len(rows)} in {time.monotonic() - t0:.0f} s\", flush=True)","+    print(f\"counted {done} instances in {time.monotonic() - t0:.0f} s\")","+","+","+def ols(x: np.ndarray, y: np.ndarray) -> tuple[float, float]:","+    \"\"\"Slope and its standard error of `y` on `x` (ordinary least squares).\"\"\"","+    x = np.asarray(x, float)","+    y = np.asarray(y, float)","+    xm = x - x.mean()","+    slope = float((xm * (y - y.mean())).sum() / (xm ** 2).sum())","+    resid = y - y.mean() - slope * xm","+    dof = max(len(x) - 2, 1)","+    se = math.sqrt(float((resid ** 2).sum() / dof / (xm ** 2).sum()))","+    return slope, se","+","+","+def stage_rates() -> None:","+    import pandas as pd","+    df = pd.read_csv(HERE / \"counts.csv\")","+    df[\"dk\"] = df[\"k\"] - df[\"pw\"]","+    for col in (\"X1\", \"X2\", \"X3\", \"X3p\", \"X4\"):","+        df[col] = pd.to_numeric(df[col], errors=\"coerce\")","+    for col in (\"X2\", \"X3\", \"X3p\", \"X4\"):","+        df[f\"r_{col}\"] = np.log(df[\"X1\"] / df[col])","+    df[\"lX1\"] = np.log(df[\"X1\"].where(df[\"X1\"] > 0))","+    cells = []","+    for (src, n, c, dk), g in df.groupby([\"source\", \"n\", \"c\", \"dk\"]):","+        pos = g[g[\"X1\"] > 0]","+        row = dict(source=src, n=n, c=c, dk=dk, instances=len(g), X1_positive=len(pos),","+                   share_X1_zero=round(1 - len(pos) / len(g), 4),","+                   pw_mean=round(g[\"pw\"].mean(), 3), beta_mean=round((g[\"pw\"] / g[\"n\"]).mean(), 4),","+                   X1_gm=round(float(np.exp(pos[\"lX1\"].mean())), 2) if len(pos) else \"\",","+                   X1_med=pos[\"X1\"].median() if len(pos) else \"\",","+                   X1_max=pos[\"X1\"].max() if len(pos) else \"\")","+        for col in (\"X2\", \"X3\", \"X3p\", \"X4\"):","+            v = pos[f\"r_{col}\"].dropna()","+            row[f\"{col}_n\"] = len(v)","+            row[f\"lr_{col}_mean\"] = round(float(v.mean()), 4) if len(v) else \"\"","+            row[f\"lr_{col}_se\"] = round(float(v.std(ddof=1) / math.sqrt(len(v))), 4) if len(v) > 1 else \"\"","+            row[f\"r_{col}_gm\"] = round(float(np.exp(v.mean())), 3) if len(v) else \"\"","+            row[f\"r_{col}_med\"] = round(float(np.exp(v.median())), 3) if len(v) else \"\"","+            row[f\"r_{col}_max\"] = round(float(np.exp(v.max())), 3) if len(v) else \"\"","+        row[\"seconds_mean\"] = round(g[\"seconds\"].mean(), 3)","+        cells.append(row)","+    cells = pd.DataFrame(cells)","+    cells.to_csv(HERE / \"cells.csv\", index=False)","+    slopes = []","+    for (src, c, dk), g in df.groupby([\"source\", \"c\", \"dk\"]):","+        if src == \"pilot\":","+            continue","+        pos = g[g[\"X1\"] > 0]","+        row = dict(source=src, c=c, dk=dk, instances=len(pos), n_min=g[\"n\"].min(), n_max=g[\"n\"].max())","+        s, se = ols(pos[\"n\"], pos[\"lX1\"])","+        row[\"slope_lX1\"], row[\"se_lX1\"] = round(s, 4), round(se, 4)","+        for col in (\"X2\", \"X3\", \"X3p\", \"X4\"):","+            v = pos[[\"n\", f\"r_{col}\"]].dropna()","+            if len(v) > 2:","+                s, se = ols(v[\"n\"], v[f\"r_{col}\"])","+                row[f\"slope_{col}\"], row[f\"se_{col}\"] = round(s, 4), round(se, 4)","+            else:","+                row[f\"slope_{col}\"], row[f\"se_{col}\"] = \"\", \"\"","+        slopes.append(row)","+    slopes = pd.DataFrame(slopes)","+    slopes.to_csv(HERE / \"slopes.csv\", index=False)","+    # the second-moment prediction at the cells' mean β, G(n, c/n)","+    sm = []","+    for c in CS:","+        for n in SIZES:","+            g = df[(df.source == \"fresh\") & (df.n == n) & (df.c == c) & (df.dk == 0)]","+            beta = float((g[\"pw\"] / g[\"n\"]).mean())","+            a = (1 - beta) / 2","+            sup, twog, table = second_moment_rate_gnp(a, c)","+            sm.append(dict(c=c, n=n, beta_mean=round(beta, 4), a=round(a, 4), g_a=round(twog / 2, 4),","+                           sup=round(sup, 4), ratio_exponent=round(sup - twog, 4),","+                           **{f\"T_{lab}\": round(float(x), 4) for lab, x in zip(","+                               [\"AA\", \"AR\", \"AS\", \"RA\", \"RR\", \"RS\", \"SA\", \"SR\", \"SS\"], table)}))","+    pd.DataFrame(sm).to_csv(HERE / \"second_moment_gnp.csv\", index=False)","+    with (HERE / \"rates.log\").open(\"w\") as f:","+        print(cells.to_string(), file=f)","+        print(file=f)","+        print(slopes.to_string(), file=f)","+        print(file=f)","+        print(pd.DataFrame(sm).to_string(), file=f)","+    print(slopes.to_string())","+","+","+def stage_overlap(graphs: int = 20) -> None:","+    import pandas as pd","+    with (HERE / \"instances.csv\").open() as f:","+        rows = [r for r in csv.DictReader(f) if r[\"source\"] == \"fresh\" and r[\"n\"] == \"20\" and r[\"c\"] == \"10\"]","+    rows = rows[:graphs]","+    n = 20","+    hist_cols = [\"AA\", \"AR\", \"AS\", \"RA\", \"RR\", \"RS\", \"SA\", \"SR\", \"SS\"]","+    allt = []","+    per_graph = []","+    for r in rows:","+        adj = masks_of(r)","+        pw = int(r[\"pw\"])","+        pairs = enumerate_empty_pairs(adj, pw)","+        T = overlap_tables(pairs, n)","+        allt.append(T)","+        per_graph.append(dict(sample=r[\"sample\"], pw=pw, X1=len(pairs), pairs_of_pairs=len(T),","+                              **{f\"mean_{c}\": round(float(T[:, i].mean() / n), 4) if len(T) else \"\" for i, c in enumerate(hist_cols)}))","+    T = np.concatenate(allt) / n","+    pd.DataFrame(per_graph).to_csv(HERE / \"overlap_per_graph.csv\", index=False)","+    beta = float(np.mean([int(r[\"pw\"]) / n for r in rows]))","+    a = (1 - beta) / 2","+    sup, twog, ext = second_moment_rate_gnp(a, 10)","+    prod = np.array([a * a, a * a, a * (1 - 2 * a), a * a, a * a, a * (1 - 2 * a), a * (1 - 2 * a), a * (1 - 2 * a), (1 - 2 * a) ** 2])","+    summary = pd.DataFrame({","+        \"cell\": hist_cols,","+        \"measured_mean\": T.mean(axis=0).round(4),","+        \"measured_median\": np.median(T, axis=0).round(4),","+        \"measured_p90\": np.quantile(T, 0.9, axis=0).round(4),","+        \"extremal_table\": ext.round(4),","+        \"product_table\": prod.round(4),","+    })","+    summary.to_csv(HERE / \"overlap_summary.csv\", index=False)","+    # the histogram of the three A-row cells","+    edges = np.arange(0, 1.0001, 1 / n) - 0.5 / n","+    hist = pd.DataFrame({\"bin_lo\": edges[:-1].round(4), \"bin_hi\": edges[1:].round(4)})","+    for i, c in enumerate(hist_cols):","+        hist[c] = np.histogram(T[:, i], bins=edges)[0]","+    hist.to_csv(HERE / \"overlap_hist.csv\", index=False)","+    with (HERE / \"overlap.log\").open(\"w\") as f:","+        print(f\"{len(rows)} graphs at n = 20, c = 10; mean beta = {beta:.4f}, a = {a:.4f}; \"","+              f\"{len(T)} ordered pairs of distinct pairs\", file=f)","+        print(f\"second moment at a: sup = {sup:.4f}, 2g = {twog:.4f}, ratio exponent = {sup - twog:.4f}\", file=f)","+        print(summary.to_string(), file=f)","+        print(pd.DataFrame(per_graph).to_string(), file=f)","+    draw(T, ext, prod, n, hist_cols)","+    print(summary.to_string())","+","+","+def draw(T: np.ndarray, ext: np.ndarray, prod: np.ndarray, n: int, cols: list[str]) -> None:","+    import matplotlib","+    matplotlib.use(\"Agg\")","+    import matplotlib.pyplot as plt","+    fig, axes = plt.subplots(1, 3, figsize=(10.5, 3.2), sharey=True)","+    labels = {\"AA\": \"|A ∩ A′| / n\", \"AR\": \"|A ∩ R′| / n\", \"AS\": \"|A ∩ S′| / n\"}","+    edges = np.arange(0, 1.0001, 1 / n) - 0.5 / n","+    for ax, c in zip(axes, [\"AA\", \"AR\", \"AS\"]):","+        i = cols.index(c)","+        ax.hist(T[:, i], bins=edges, color=\"#2a78d6\", edgecolor=\"#fcfcfb\", linewidth=0.8, density=True)","+        ax.axvline(ext[i], color=\"#eb6834\", linewidth=2, label=\"extremal table\")","+        ax.axvline(prod[i], color=\"#1baf7a\", linewidth=2, linestyle=\"--\", label=\"product table\")","+        ax.set_xlabel(labels[c], color=\"#0b0b0b\")","+        ax.set_xlim(-0.03, 0.75)","+        for s in (\"top\", \"right\"):","+            ax.spines[s].set_visible(False)","+        ax.spines[\"left\"].set_color(\"#c3c2b7\")","+        ax.spines[\"bottom\"].set_color(\"#c3c2b7\")","+        ax.tick_params(colors=\"#52514e\")","+        ax.grid(axis=\"y\", color=\"#e6e5e1\", linewidth=0.6)","+        ax.set_axisbelow(True)","+    axes[0].set_ylabel(\"density over ordered pairs of distinct pairs\", color=\"#52514e\")","+    axes[0].legend(frameon=False, fontsize=8)","+    fig.tight_layout()","+    fig.savefig(HERE / \"overlap_hist.png\", dpi=160)","+    plt.close(fig)","+","+","+def main() -> None:","+    ap = argparse.ArgumentParser()","+    ap.add_argument(\"--workers\", type=int, default=8)","+    ap.add_argument(\"--stage\", choices=[\"solve\", \"count\", \"rates\", \"overlap\"], default=None)","+    a = ap.parse_args()","+    os.nice(19)","+    stages = [a.stage] if a.stage else [\"solve\", \"count\", \"rates\", \"overlap\"]","+    for s in stages:","+        t0 = time.monotonic()","+        {\"solve\": lambda: stage_solve(a.workers), \"count\": lambda: stage_count(a.workers),","+         \"rates\": stage_rates, \"overlap\": stage_overlap}[s]()","+        print(f\"stage {s}: {time.monotonic() - t0:.0f} s\", flush=True)","+","+","+if __name__ == \"__main__\":","+    main()"]}],"created":true},{"filePath":"/home/al/dev/MOSP/Ralph_Loops/loop0011/session_it03.jsonl","hunks":[{"oldStart":226,"oldLines":3,"newStart":226,"newLines":5,"lines":[" {\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5-1\",\"id\":\"msg_011CgcKp97J8vB6c1fJUrVDs\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":1097,\"cache_read_input_tokens\":139305,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1097,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"cdae3a4c-4732-4e01-8ac1-f035632387fb\",\"timestamp\":\"2026-11-01T13:57:25.225Z\",\"request_id\":\"req_011CgcKp8hFCVc4RQQ9LEcM3\",\"thinking_duration_ms\":1233,\"thinking_display\":\"updates\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5-1\",\"id\":\"msg_011CgcKp97J8vB6c1fJUrVDs\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now the run script with stages `solve`, `count`, `rates`, `overlap`.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":1097,\"cache_read_input_tokens\":139305,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1097,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"43dcf2b0-3028-4bc1-b489-57b332c78c67\",\"timestamp\":\"2026-11-01T13:57:25.226Z\",\"request_id\":\"req_011CgcKp8hFCVc4RQQ9LEcM3\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5-1\",\"id\":\"msg_011CgcKp97J8vB6c1fJUrVDs\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_016FdpMmrjuxSajh4LVkSfey\",\"name\":\"Bash\",\"input\":{\"command\":\"mkdir -p reports/scratch/separator_moment/03_clumping && cat > reports/scratch/separator_moment/03_clumping/run.py <<'EOF'\\n\\\"\\\"\\\"loop0011 item 03: the clumping decomposed — exact-size empty pairs `X₁`,\\ndistinct separators `X₂`, closed pairs `X₃` (and the closure image `X₃′`) and\\nmove-classes `X₄` on graphs with exact pathwidth (`reports/separator_moment.md` §3).\\n\\n    nice -n 19 python3 reports/scratch/separator_moment/03_clumping/run.py --workers 8\\n    (stages: solve, count, rates, overlap; `--stage` runs one)\\n\\nStage `solve` draws fresh `G(n, c/n)` at `n ∈ {14, …, 24}`, `c ∈ {4, 6, 8, 10}`,\\n200 per cell (seed = CRC of the cell and index), proves the width with the C\\nprogram `pathwidth_solver/cli/pathwidth -l -t 60` (layout kept) and, at\\n`n ≤ 16`, checks it against the subset DP; it also lists the pilot's `n = 20`\\ngraphs at `c ∈ {4, 6, 8, 10}` (widths on record, `reports/scratch/gnp_pilot/results.csv`)\\nand the certified `fixed` covers of `learning/data/ensemble/results.csv` at\\n`n ∈ {10, 15, 20, 25}`, `d ∈ {4, 6}`, `m = n` (`pw = optimum − 1`). Nothing on\\nrecord is re-solved. Stage `count` enumerates the four counts at\\n`k = pw − 1, pw, pw + 1, pw + 2`; `rates` fits the slopes; `overlap`\\nhistograms the overlap tables of pairs of pairs at `n = 20`, `c = 10`.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport csv\\nimport math\\nimport os\\nimport subprocess\\nimport sys\\nimport time\\nimport zlib\\nfrom multiprocessing import Pool\\nfrom pathlib import Path\\n\\nimport networkx as nx\\nimport numpy as np\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parents[4]))\\n\\nfrom learning.separator_moment import (  # noqa: E402\\n    closed_pairs, closed_pairs_pruned, closure_image, count_exact_pairs, enumerate_empty_pairs,\\n    forced_sizes, gnp_masks, mosp_masks, move_classes, overlap_tables, popcount,\\n    second_moment_rate_gnp, separators_of, vertex_separation,\\n)\\n\\nHERE = Path(__file__).resolve().parent\\nROOT = Path(__file__).resolve().parents[4]\\nCLI = ROOT / \\\"pathwidth_solver/cli/pathwidth\\\"\\nPILOT = ROOT / \\\"reports/scratch/gnp_pilot/results.csv\\\"\\nENSEMBLE = ROOT / \\\"learning/data/ensemble/results.csv\\\"\\n\\nSIZES = [14, 16, 18, 20, 22, 24]\\nCS = [4, 6, 8, 10]\\nPER_CELL = 200\\nCOVER_N = [10, 15, 20, 25]\\nCOVER_D = [4, 6]\\nMAX_PAIRS = 2_000_000       # above this X₁ is counted by binomials and the rest skipped\\nMAX_X4_PAIRS = 400_000      # above this the move-classes are skipped\\nMAX_SETS = 3_000_000        # the pruned family for X₃\\n\\nINST_FIELDS = [\\\"source\\\", \\\"cell\\\", \\\"n\\\", \\\"c\\\", \\\"sample\\\", \\\"seed\\\", \\\"edges\\\", \\\"pw\\\", \\\"status\\\", \\\"dp_pw\\\", \\\"layout\\\"]\\nCOUNT_FIELDS = [\\\"source\\\", \\\"cell\\\", \\\"n\\\", \\\"c\\\", \\\"sample\\\", \\\"pw\\\", \\\"k\\\", \\\"N\\\", \\\"t\\\", \\\"X1\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X3_check\\\", \\\"X4\\\", \\\"seconds\\\", \\\"note\\\"]\\n\\n\\ndef fresh_seed(n: int, c: int, i: int) -> int:\\n    return zlib.crc32(f\\\"sep03:{n}:{c}:{i}\\\".encode()) & 0x7FFFFFFF\\n\\n\\ndef g6(n: int, p: float, seed: int) -> str:\\n    return nx.to_graph6_bytes(nx.gnp_random_graph(n, p, seed=seed), header=False).decode().strip()\\n\\n\\ndef run_cli(lines: list[str], budget: int = 60) -> list[tuple[int, str, str]]:\\n    out = subprocess.run([str(CLI), \\\"-l\\\", \\\"-t\\\", str(budget)], input=\\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\",\\n                         capture_output=True, text=True, check=True).stdout.splitlines()\\n    res = []\\n    it = iter(out)\\n    for a in it:\\n        b = next(it)\\n        _, w, status = a.split()\\n        res.append((int(w), status, b.split(\\\" \\\", 1)[1]))\\n    return res\\n\\n\\ndef solve_cell(args):\\n    n, c = args\\n    seeds = [fresh_seed(n, c, i) for i in range(PER_CELL)]\\n    lines = [g6(n, c / n, s) for s in seeds]\\n    res = run_cli(lines)\\n    rows = []\\n    for i, (s, (w, status, layout)) in enumerate(zip(seeds, res)):\\n        adj = gnp_masks(n, c / n, s)\\n        dp = vertex_separation(adj) if n <= 16 else \\\"\\\"\\n        if dp != \\\"\\\" and dp != w:\\n            raise RuntimeError(f\\\"DP {dp} != C {w} at n={n} c={c} seed={s}\\\")\\n        rows.append(dict(source=\\\"fresh\\\", cell=f\\\"g_n{n}_c{c}\\\", n=n, c=c, sample=i, seed=s,\\n                         edges=sum(popcount(a) for a in adj) // 2, pw=w, status=status, dp_pw=dp, layout=layout))\\n    return rows\\n\\n\\ndef stage_solve(workers: int) -> None:\\n    rows = []\\n    with Pool(workers) as pool:\\n        for r in pool.imap_unordered(solve_cell, [(n, c) for n in SIZES for c in CS]):\\n            rows += r\\n            print(f\\\"solved {r[0]['cell']}\\\", flush=True)\\n    with PILOT.open() as f:\\n        for r in csv.DictReader(f):\\n            if int(r[\\\"n\\\"]) == 20 and float(r[\\\"c\\\"]) in CS and r[\\\"status\\\"] in (\\\"bound\\\", \\\"refutation\\\", \\\"minor\\\"):\\n                c = int(float(r[\\\"c\\\"]))\\n                rows.append(dict(source=\\\"pilot\\\", cell=f\\\"p_n20_c{c}\\\", n=20, c=c, sample=int(r[\\\"sample\\\"]),\\n                                 seed=int(r[\\\"seed\\\"]), edges=int(r[\\\"m\\\"]), pw=int(r[\\\"width\\\"]), status=r[\\\"status\\\"],\\n                                 dp_pw=\\\"\\\", layout=r[\\\"layout\\\"]))\\n    with ENSEMBLE.open() as f:\\n        for r in csv.DictReader(f):\\n            if r[\\\"generator\\\"] == \\\"fixed\\\" and r[\\\"m\\\"] == r[\\\"n\\\"] and int(r[\\\"n\\\"]) in COVER_N \\\\\\n                    and float(r[\\\"param\\\"]) in COVER_D and r[\\\"certified\\\"] == \\\"True\\\":\\n                rows.append(dict(source=\\\"cover\\\", cell=r[\\\"cell\\\"], n=int(r[\\\"n\\\"]), c=int(float(r[\\\"param\\\"])),\\n                                 sample=int(r[\\\"index\\\"]), seed=int(r[\\\"seed\\\"]), edges=\\\"\\\", pw=int(r[\\\"optimum\\\"]) - 1,\\n                                 status=\\\"certified\\\", dp_pw=\\\"\\\", layout=\\\"\\\"))\\n    rows.sort(key=lambda r: (r[\\\"source\\\"], r[\\\"n\\\"], r[\\\"c\\\"], r[\\\"sample\\\"]))\\n    with (HERE / \\\"instances.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.DictWriter(f, INST_FIELDS)\\n        w.writeheader()\\n        w.writerows(rows)\\n    print(f\\\"{len(rows)} instances written\\\")\\n\\n\\ndef masks_of(r: dict) -> list[int]:\\n    n = int(r[\\\"n\\\"])\\n    if r[\\\"source\\\"] == \\\"cover\\\":\\n        from learning.ensemble import Cell, generate\\n        inst = generate(Cell.parse(f\\\"f:{n}:{n}:{r['c']}\\\"), int(r[\\\"sample\\\"]))\\n        return mosp_masks(inst.matrix)\\n    return gnp_masks(n, float(r[\\\"c\\\"]) / n, int(r[\\\"seed\\\"]))\\n\\n\\ndef count_one(r: dict) -> list[dict]:\\n    n, pw = int(r[\\\"n\\\"]), int(r[\\\"pw\\\"])\\n    adj = masks_of(r)\\n    if r[\\\"source\\\"] == \\\"cover\\\":\\n        # the certified optimum is pw + 1; cross-check the DP where it is cheap\\n        if n <= 16:\\n            assert vertex_separation(adj) == pw, (r[\\\"cell\\\"], r[\\\"sample\\\"])\\n    out = []\\n    for k in (pw - 1, pw, pw + 1, pw + 2):\\n        if k < 0 or k >= n:\\n            continue\\n        t0 = time.monotonic()\\n        N, t = forced_sizes(n, k)\\n        row = dict(source=r[\\\"source\\\"], cell=r[\\\"cell\\\"], n=n, c=r[\\\"c\\\"], sample=r[\\\"sample\\\"], pw=pw, k=k, N=N, t=t,\\n                   X1=\\\"\\\", X2=\\\"\\\", X3=\\\"\\\", X3p=\\\"\\\", X3_check=\\\"\\\", X4=\\\"\\\", seconds=\\\"\\\", note=\\\"\\\")\\n        try:\\n            pairs = enumerate_empty_pairs(adj, k, MAX_PAIRS)\\n        except OverflowError:\\n            row[\\\"X1\\\"] = count_exact_pairs(adj, k)\\n            row[\\\"note\\\"] = \\\"X1 by binomials; X2, X3, X4 skipped (pairs > cap)\\\"\\n            row[\\\"seconds\\\"] = round(time.monotonic() - t0, 3)\\n            out.append(row)\\n            continue\\n        row[\\\"X1\\\"] = len(pairs)\\n        row[\\\"X2\\\"] = len(separators_of(pairs, n))\\n        try:\\n            X3 = closed_pairs_pruned(adj, k, MAX_SETS)\\n            row[\\\"X3\\\"] = len(X3)\\n            if n <= 16 and k == pw:\\n                row[\\\"X3_check\\\"] = len(closed_pairs(adj, k))\\n                assert row[\\\"X3_check\\\"] == row[\\\"X3\\\"], (r[\\\"cell\\\"], r[\\\"sample\\\"])\\n        except OverflowError:\\n            row[\\\"note\\\"] += \\\"X3 skipped (sets > cap); \\\"\\n        row[\\\"X3p\\\"] = len(closure_image(adj, pairs))\\n        if len(pairs) <= MAX_X4_PAIRS:\\n            row[\\\"X4\\\"] = max(move_classes(pairs, n)) + 1 if pairs else 0\\n        else:\\n            row[\\\"note\\\"] += \\\"X4 skipped (pairs > cap); \\\"\\n        row[\\\"seconds\\\"] = round(time.monotonic() - t0, 3)\\n        out.append(row)\\n    return out\\n\\n\\ndef stage_count(workers: int) -> None:\\n    with (HERE / \\\"instances.csv\\\").open() as f:\\n        rows = list(csv.DictReader(f))\\n    # hardest first so the pool's tail is short\\n    rows.sort(key=lambda r: (-int(r[\\\"n\\\"]), int(r[\\\"c\\\"])))\\n    done = 0\\n    t0 = time.monotonic()\\n    with (HERE / \\\"counts.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f, Pool(workers) as pool:\\n        w = csv.DictWriter(f, COUNT_FIELDS)\\n        w.writeheader()\\n        for res in pool.imap_unordered(count_one, rows, chunksize=4):\\n            w.writerows(res)\\n            done += 1\\n            if done % 200 == 0:\\n                f.flush()\\n                print(f\\\"counted {done}/{len(rows)} in {time.monotonic() - t0:.0f} s\\\", flush=True)\\n    print(f\\\"counted {done} instances in {time.monotonic() - t0:.0f} s\\\")\\n\\n\\ndef ols(x: np.ndarray, y: np.ndarray) -> tuple[float, float]:\\n    \\\"\\\"\\\"Slope and its standard error of `y` on `x` (ordinary least squares).\\\"\\\"\\\"\\n    x = np.asarray(x, float)\\n    y = np.asarray(y, float)\\n    xm = x - x.mean()\\n    slope = float((xm * (y - y.mean())).sum() / (xm ** 2).sum())\\n    resid = y - y.mean() - slope * xm\\n    dof = max(len(x) - 2, 1)\\n    se = math.sqrt(float((resid ** 2).sum() / dof / (xm ** 2).sum()))\\n    return slope, se\\n\\n\\ndef stage_rates() -> None:\\n    import pandas as pd\\n    df = pd.read_csv(HERE / \\\"counts.csv\\\")\\n    df[\\\"dk\\\"] = df[\\\"k\\\"] - df[\\\"pw\\\"]\\n    for col in (\\\"X1\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n        df[col] = pd.to_numeric(df[col], errors=\\\"coerce\\\")\\n    for col in (\\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n        df[f\\\"r_{col}\\\"] = np.log(df[\\\"X1\\\"] / df[col])\\n    df[\\\"lX1\\\"] = np.log(df[\\\"X1\\\"].where(df[\\\"X1\\\"] > 0))\\n    cells = []\\n    for (src, n, c, dk), g in df.groupby([\\\"source\\\", \\\"n\\\", \\\"c\\\", \\\"dk\\\"]):\\n        pos = g[g[\\\"X1\\\"] > 0]\\n        row = dict(source=src, n=n, c=c, dk=dk, instances=len(g), X1_positive=len(pos),\\n                   share_X1_zero=round(1 - len(pos) / len(g), 4),\\n                   pw_mean=round(g[\\\"pw\\\"].mean(), 3), beta_mean=round((g[\\\"pw\\\"] / g[\\\"n\\\"]).mean(), 4),\\n                   X1_gm=round(float(np.exp(pos[\\\"lX1\\\"].mean())), 2) if len(pos) else \\\"\\\",\\n                   X1_med=pos[\\\"X1\\\"].median() if len(pos) else \\\"\\\",\\n                   X1_max=pos[\\\"X1\\\"].max() if len(pos) else \\\"\\\")\\n        for col in (\\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n            v = pos[f\\\"r_{col}\\\"].dropna()\\n            row[f\\\"{col}_n\\\"] = len(v)\\n            row[f\\\"lr_{col}_mean\\\"] = round(float(v.mean()), 4) if len(v) else \\\"\\\"\\n            row[f\\\"lr_{col}_se\\\"] = round(float(v.std(ddof=1) / math.sqrt(len(v))), 4) if len(v) > 1 else \\\"\\\"\\n            row[f\\\"r_{col}_gm\\\"] = round(float(np.exp(v.mean())), 3) if len(v) else \\\"\\\"\\n            row[f\\\"r_{col}_med\\\"] = round(float(np.exp(v.median())), 3) if len(v) else \\\"\\\"\\n            row[f\\\"r_{col}_max\\\"] = round(float(np.exp(v.max())), 3) if len(v) else \\\"\\\"\\n        row[\\\"seconds_mean\\\"] = round(g[\\\"seconds\\\"].mean(), 3)\\n        cells.append(row)\\n    cells = pd.DataFrame(cells)\\n    cells.to_csv(HERE / \\\"cells.csv\\\", index=False)\\n    slopes = []\\n    for (src, c, dk), g in df.groupby([\\\"source\\\", \\\"c\\\", \\\"dk\\\"]):\\n        if src == \\\"pilot\\\":\\n            continue\\n        pos = g[g[\\\"X1\\\"] > 0]\\n        row = dict(source=src, c=c, dk=dk, instances=len(pos), n_min=g[\\\"n\\\"].min(), n_max=g[\\\"n\\\"].max())\\n        s, se = ols(pos[\\\"n\\\"], pos[\\\"lX1\\\"])\\n        row[\\\"slope_lX1\\\"], row[\\\"se_lX1\\\"] = round(s, 4), round(se, 4)\\n        for col in (\\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n            v = pos[[\\\"n\\\", f\\\"r_{col}\\\"]].dropna()\\n            if len(v) > 2:\\n                s, se = ols(v[\\\"n\\\"], v[f\\\"r_{col}\\\"])\\n                row[f\\\"slope_{col}\\\"], row[f\\\"se_{col}\\\"] = round(s, 4), round(se, 4)\\n            else:\\n                row[f\\\"slope_{col}\\\"], row[f\\\"se_{col}\\\"] = \\\"\\\", \\\"\\\"\\n        slopes.append(row)\\n    slopes = pd.DataFrame(slopes)\\n    slopes.to_csv(HERE / \\\"slopes.csv\\\", index=False)\\n    # the second-moment prediction at the cells' mean β, G(n, c/n)\\n    sm = []\\n    for c in CS:\\n        for n in SIZES:\\n            g = df[(df.source == \\\"fresh\\\") & (df.n == n) & (df.c == c) & (df.dk == 0)]\\n            beta = float((g[\\\"pw\\\"] / g[\\\"n\\\"]).mean())\\n            a = (1 - beta) / 2\\n            sup, twog, table = second_moment_rate_gnp(a, c)\\n            sm.append(dict(c=c, n=n, beta_mean=round(beta, 4), a=round(a, 4), g_a=round(twog / 2, 4),\\n                           sup=round(sup, 4), ratio_exponent=round(sup - twog, 4),\\n                           **{f\\\"T_{lab}\\\": round(float(x), 4) for lab, x in zip(\\n                               [\\\"AA\\\", \\\"AR\\\", \\\"AS\\\", \\\"RA\\\", \\\"RR\\\", \\\"RS\\\", \\\"SA\\\", \\\"SR\\\", \\\"SS\\\"], table)}))\\n    pd.DataFrame(sm).to_csv(HERE / \\\"second_moment_gnp.csv\\\", index=False)\\n    with (HERE / \\\"rates.log\\\").open(\\\"w\\\") as f:\\n        print(cells.to_string(), file=f)\\n        print(file=f)\\n        print(slopes.to_string(), file=f)\\n        print(file=f)\\n        print(pd.DataFrame(sm).to_string(), file=f)\\n    print(slopes.to_string())\\n\\n\\ndef stage_overlap(graphs: int = 20) -> None:\\n    import pandas as pd\\n    with (HERE / \\\"instances.csv\\\").open() as f:\\n        rows = [r for r in csv.DictReader(f) if r[\\\"source\\\"] == \\\"fresh\\\" and r[\\\"n\\\"] == \\\"20\\\" and r[\\\"c\\\"] == \\\"10\\\"]\\n    rows = rows[:graphs]\\n    n = 20\\n    hist_cols = [\\\"AA\\\", \\\"AR\\\", \\\"AS\\\", \\\"RA\\\", \\\"RR\\\", \\\"RS\\\", \\\"SA\\\", \\\"SR\\\", \\\"SS\\\"]\\n    allt = []\\n    per_graph = []\\n    for r in rows:\\n        adj = masks_of(r)\\n        pw = int(r[\\\"pw\\\"])\\n        pairs = enumerate_empty_pairs(adj, pw)\\n        T = overlap_tables(pairs, n)\\n        allt.append(T)\\n        per_graph.append(dict(sample=r[\\\"sample\\\"], pw=pw, X1=len(pairs), pairs_of_pairs=len(T),\\n                              **{f\\\"mean_{c}\\\": round(float(T[:, i].mean() / n), 4) if len(T) else \\\"\\\" for i, c in enumerate(hist_cols)}))\\n    T = np.concatenate(allt) / n\\n    pd.DataFrame(per_graph).to_csv(HERE / \\\"overlap_per_graph.csv\\\", index=False)\\n    beta = float(np.mean([int(r[\\\"pw\\\"]) / n for r in rows]))\\n    a = (1 - beta) / 2\\n    sup, twog, ext = second_moment_rate_gnp(a, 10)\\n    prod = np.array([a * a, a * a, a * (1 - 2 * a), a * a, a * a, a * (1 - 2 * a), a * (1 - 2 * a), a * (1 - 2 * a), (1 - 2 * a) ** 2])\\n    summary = pd.DataFrame({\\n        \\\"cell\\\": hist_cols,\\n        \\\"measured_mean\\\": T.mean(axis=0).round(4),\\n        \\\"measured_median\\\": np.median(T, axis=0).round(4),\\n        \\\"measured_p90\\\": np.quantile(T, 0.9, axis=0).round(4),\\n        \\\"extremal_table\\\": ext.round(4),\\n        \\\"product_table\\\": prod.round(4),\\n    })\\n    summary.to_csv(HERE / \\\"overlap_summary.csv\\\", index=False)\\n    # the histogram of the three A-row cells\\n    edges = np.arange(0, 1.0001, 1 / n) - 0.5 / n\\n    hist = pd.DataFrame({\\\"bin_lo\\\": edges[:-1].round(4), \\\"bin_hi\\\": edges[1:].round(4)})\\n    for i, c in enumerate(hist_cols):\\n        hist[c] = np.histogram(T[:, i], bins=edges)[0]\\n    hist.to_csv(HERE / \\\"overlap_hist.csv\\\", index=False)\\n    with (HERE / \\\"overlap.log\\\").open(\\\"w\\\") as f:\\n        print(f\\\"{len(rows)} graphs at n = 20, c = 10; mean beta = {beta:.4f}, a = {a:.4f}; \\\"\\n              f\\\"{len(T)} ordered pairs of distinct pairs\\\", file=f)\\n        print(f\\\"second moment at a: sup = {sup:.4f}, 2g = {twog:.4f}, ratio exponent = {sup - twog:.4f}\\\", file=f)\\n        print(summary.to_string(), file=f)\\n        print(pd.DataFrame(per_graph).to_string(), file=f)\\n    draw(T, ext, prod, n, hist_cols)\\n    print(summary.to_string())\\n\\n\\ndef draw(T: np.ndarray, ext: np.ndarray, prod: np.ndarray, n: int, cols: list[str]) -> None:\\n    import matplotlib\\n    matplotlib.use(\\\"Agg\\\")\\n    import matplotlib.pyplot as plt\\n    fig, axes = plt.subplots(1, 3, figsize=(10.5, 3.2), sharey=True)\\n    labels = {\\\"AA\\\": \\\"|A ∩ A′| / n\\\", \\\"AR\\\": \\\"|A ∩ R′| / n\\\", \\\"AS\\\": \\\"|A ∩ S′| / n\\\"}\\n    edges = np.arange(0, 1.0001, 1 / n) - 0.5 / n\\n    for ax, c in zip(axes, [\\\"AA\\\", \\\"AR\\\", \\\"AS\\\"]):\\n        i = cols.index(c)\\n        ax.hist(T[:, i], bins=edges, color=\\\"#2a78d6\\\", edgecolor=\\\"#fcfcfb\\\", linewidth=0.8, density=True)\\n        ax.axvline(ext[i], color=\\\"#eb6834\\\", linewidth=2, label=\\\"extremal table\\\")\\n        ax.axvline(prod[i], color=\\\"#1baf7a\\\", linewidth=2, linestyle=\\\"--\\\", label=\\\"product table\\\")\\n        ax.set_xlabel(labels[c], color=\\\"#0b0b0b\\\")\\n        ax.set_xlim(-0.03, 0.75)\\n        for s in (\\\"top\\\", \\\"right\\\"):\\n            ax.spines[s].set_visible(False)\\n        ax.spines[\\\"left\\\"].set_color(\\\"#c3c2b7\\\")\\n        ax.spines[\\\"bottom\\\"].set_color(\\\"#c3c2b7\\\")\\n        ax.tick_params(colors=\\\"#52514e\\\")\\n        ax.grid(axis=\\\"y\\\", color=\\\"#e6e5e1\\\", linewidth=0.6)\\n        ax.set_axisbelow(True)\\n    axes[0].set_ylabel(\\\"density over ordered pairs of distinct pairs\\\", color=\\\"#52514e\\\")\\n    axes[0].legend(frameon=False, fontsize=8)\\n    fig.tight_layout()\\n    fig.savefig(HERE / \\\"overlap_hist.png\\\", dpi=160)\\n    plt.close(fig)\\n\\n\\ndef main() -> None:\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--workers\\\", type=int, default=8)\\n    ap.add_argument(\\\"--stage\\\", choices=[\\\"solve\\\", \\\"count\\\", \\\"rates\\\", \\\"overlap\\\"], default=None)\\n    a = ap.parse_args()\\n    os.nice(19)\\n    stages = [a.stage] if a.stage else [\\\"solve\\\", \\\"count\\\", \\\"rates\\\", \\\"overlap\\\"]\\n    for s in stages:\\n        t0 = time.monotonic()\\n        {\\\"solve\\\": lambda: stage_solve(a.workers), \\\"count\\\": lambda: stage_count(a.workers),\\n         \\\"rates\\\": stage_rates, \\\"overlap\\\": stage_overlap}[s]()\\n        print(f\\\"stage {s}: {time.monotonic() - t0:.0f} s\\\", flush=True)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\nEOF\\nuptime && cd reports/scratch/separator_moment/03_clumping && time nice -n 19 python3 run.py --stage solve --workers 8 2>&1 | tail -5\",\"description\":\"Write run.py and run the solve stage\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":1097,\"cache_read_input_tokens\":139305,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1097,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"6e082410-82af-460d-a022-ee572576f236\",\"timestamp\":\"2026-11-01T13:58:42.084Z\",\"request_id\":\"req_011CgcKp8hFCVc4RQQ9LEcM3\",\"wire_tool_inputs\":{\"toolu_016FdpMmrjuxSajh4LVkSfey\":{\"command\":\"cd /home/al/dev/MOSP && mkdir -p reports/scratch/separator_moment/03_clumping && cat > reports/scratch/separator_moment/03_clumping/run.py <<'EOF'\\n\\\"\\\"\\\"loop0011 item 03: the clumping decomposed — exact-size empty pairs `X₁`,\\ndistinct separators `X₂`, closed pairs `X₃` (and the closure image `X₃′`) and\\nmove-classes `X₄` on graphs with exact pathwidth (`reports/separator_moment.md` §3).\\n\\n    nice -n 19 python3 reports/scratch/separator_moment/03_clumping/run.py --workers 8\\n    (stages: solve, count, rates, overlap; `--stage` runs one)\\n\\nStage `solve` draws fresh `G(n, c/n)` at `n ∈ {14, …, 24}`, `c ∈ {4, 6, 8, 10}`,\\n200 per cell (seed = CRC of the cell and index), proves the width with the C\\nprogram `pathwidth_solver/cli/pathwidth -l -t 60` (layout kept) and, at\\n`n ≤ 16`, checks it against the subset DP; it also lists the pilot's `n = 20`\\ngraphs at `c ∈ {4, 6, 8, 10}` (widths on record, `reports/scratch/gnp_pilot/results.csv`)\\nand the certified `fixed` covers of `learning/data/ensemble/results.csv` at\\n`n ∈ {10, 15, 20, 25}`, `d ∈ {4, 6}`, `m = n` (`pw = optimum − 1`). Nothing on\\nrecord is re-solved. Stage `count` enumerates the four counts at\\n`k = pw − 1, pw, pw + 1, pw + 2`; `rates` fits the slopes; `overlap`\\nhistograms the overlap tables of pairs of pairs at `n = 20`, `c = 10`.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport csv\\nimport math\\nimport os\\nimport subprocess\\nimport sys\\nimport time\\nimport zlib\\nfrom multiprocessing import Pool\\nfrom pathlib import Path\\n\\nimport networkx as nx\\nimport numpy as np\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parents[4]))\\n\\nfrom learning.separator_moment import (  # noqa: E402\\n    closed_pairs, closed_pairs_pruned, closure_image, count_exact_pairs, enumerate_empty_pairs,\\n    forced_sizes, gnp_masks, mosp_masks, move_classes, overlap_tables, popcount,\\n    second_moment_rate_gnp, separators_of, vertex_separation,\\n)\\n\\nHERE = Path(__file__).resolve().parent\\nROOT = Path(__file__).resolve().parents[4]\\nCLI = ROOT / \\\"pathwidth_solver/cli/pathwidth\\\"\\nPILOT = ROOT / \\\"reports/scratch/gnp_pilot/results.csv\\\"\\nENSEMBLE = ROOT / \\\"learning/data/ensemble/results.csv\\\"\\n\\nSIZES = [14, 16, 18, 20, 22, 24]\\nCS = [4, 6, 8, 10]\\nPER_CELL = 200\\nCOVER_N = [10, 15, 20, 25]\\nCOVER_D = [4, 6]\\nMAX_PAIRS = 2_000_000       # above this X₁ is counted by binomials and the rest skipped\\nMAX_X4_PAIRS = 400_000      # above this the move-classes are skipped\\nMAX_SETS = 3_000_000        # the pruned family for X₃\\n\\nINST_FIELDS = [\\\"source\\\", \\\"cell\\\", \\\"n\\\", \\\"c\\\", \\\"sample\\\", \\\"seed\\\", \\\"edges\\\", \\\"pw\\\", \\\"status\\\", \\\"dp_pw\\\", \\\"layout\\\"]\\nCOUNT_FIELDS = [\\\"source\\\", \\\"cell\\\", \\\"n\\\", \\\"c\\\", \\\"sample\\\", \\\"pw\\\", \\\"k\\\", \\\"N\\\", \\\"t\\\", \\\"X1\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X3_check\\\", \\\"X4\\\", \\\"seconds\\\", \\\"note\\\"]\\n\\n\\ndef fresh_seed(n: int, c: int, i: int) -> int:\\n    return zlib.crc32(f\\\"sep03:{n}:{c}:{i}\\\".encode()) & 0x7FFFFFFF\\n\\n\\ndef g6(n: int, p: float, seed: int) -> str:\\n    return nx.to_graph6_bytes(nx.gnp_random_graph(n, p, seed=seed), header=False).decode().strip()\\n\\n\\ndef run_cli(lines: list[str], budget: int = 60) -> list[tuple[int, str, str]]:\\n    out = subprocess.run([str(CLI), \\\"-l\\\", \\\"-t\\\", str(budget)], input=\\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\",\\n                         capture_output=True, text=True, check=True).stdout.splitlines()\\n    res = []\\n    it = iter(out)\\n    for a in it:\\n        b = next(it)\\n        _, w, status = a.split()\\n        res.append((int(w), status, b.split(\\\" \\\", 1)[1]))\\n    return res\\n\\n\\ndef solve_cell(args):\\n    n, c = args\\n    seeds = [fresh_seed(n, c, i) for i in range(PER_CELL)]\\n    lines = [g6(n, c / n, s) for s in seeds]\\n    res = run_cli(lines)\\n    rows = []\\n    for i, (s, (w, status, layout)) in enumerate(zip(seeds, res)):\\n        adj = gnp_masks(n, c / n, s)\\n        dp = vertex_separation(adj) if n <= 16 else \\\"\\\"\\n        if dp != \\\"\\\" and dp != w:\\n            raise RuntimeError(f\\\"DP {dp} != C {w} at n={n} c={c} seed={s}\\\")\\n        rows.append(dict(source=\\\"fresh\\\", cell=f\\\"g_n{n}_c{c}\\\", n=n, c=c, sample=i, seed=s,\\n                         edges=sum(popcount(a) for a in adj) // 2, pw=w, status=status, dp_pw=dp, layout=layout))\\n    return rows\\n\\n\\ndef stage_solve(workers: int) -> None:\\n    rows = []\\n    with Pool(workers) as pool:\\n        for r in pool.imap_unordered(solve_cell, [(n, c) for n in SIZES for c in CS]):\\n            rows += r\\n            print(f\\\"solved {r[0]['cell']}\\\", flush=True)\\n    with PILOT.open() as f:\\n        for r in csv.DictReader(f):\\n            if int(r[\\\"n\\\"]) == 20 and float(r[\\\"c\\\"]) in CS and r[\\\"status\\\"] in (\\\"bound\\\", \\\"refutation\\\", \\\"minor\\\"):\\n                c = int(float(r[\\\"c\\\"]))\\n                rows.append(dict(source=\\\"pilot\\\", cell=f\\\"p_n20_c{c}\\\", n=20, c=c, sample=int(r[\\\"sample\\\"]),\\n                                 seed=int(r[\\\"seed\\\"]), edges=int(r[\\\"m\\\"]), pw=int(r[\\\"width\\\"]), status=r[\\\"status\\\"],\\n                                 dp_pw=\\\"\\\", layout=r[\\\"layout\\\"]))\\n    with ENSEMBLE.open() as f:\\n        for r in csv.DictReader(f):\\n            if r[\\\"generator\\\"] == \\\"fixed\\\" and r[\\\"m\\\"] == r[\\\"n\\\"] and int(r[\\\"n\\\"]) in COVER_N \\\\\\n                    and float(r[\\\"param\\\"]) in COVER_D and r[\\\"certified\\\"] == \\\"True\\\":\\n                rows.append(dict(source=\\\"cover\\\", cell=r[\\\"cell\\\"], n=int(r[\\\"n\\\"]), c=int(float(r[\\\"param\\\"])),\\n                                 sample=int(r[\\\"index\\\"]), seed=int(r[\\\"seed\\\"]), edges=\\\"\\\", pw=int(r[\\\"optimum\\\"]) - 1,\\n                                 status=\\\"certified\\\", dp_pw=\\\"\\\", layout=\\\"\\\"))\\n    rows.sort(key=lambda r: (r[\\\"source\\\"], r[\\\"n\\\"], r[\\\"c\\\"], r[\\\"sample\\\"]))\\n    with (HERE / \\\"instances.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.DictWriter(f, INST_FIELDS)\\n        w.writeheader()\\n        w.writerows(rows)\\n    print(f\\\"{len(rows)} instances written\\\")\\n\\n\\ndef masks_of(r: dict) -> list[int]:\\n    n = int(r[\\\"n\\\"])\\n    if r[\\\"source\\\"] == \\\"cover\\\":\\n        from learning.ensemble import Cell, generate\\n        inst = generate(Cell.parse(f\\\"f:{n}:{n}:{r['c']}\\\"), int(r[\\\"sample\\\"]))\\n        return mosp_masks(inst.matrix)\\n    return gnp_masks(n, float(r[\\\"c\\\"]) / n, int(r[\\\"seed\\\"]))\\n\\n\\ndef count_one(r: dict) -> list[dict]:\\n    n, pw = int(r[\\\"n\\\"]), int(r[\\\"pw\\\"])\\n    adj = masks_of(r)\\n    if r[\\\"source\\\"] == \\\"cover\\\":\\n        # the certified optimum is pw + 1; cross-check the DP where it is cheap\\n        if n <= 16:\\n            assert vertex_separation(adj) == pw, (r[\\\"cell\\\"], r[\\\"sample\\\"])\\n    out = []\\n    for k in (pw - 1, pw, pw + 1, pw + 2):\\n        if k < 0 or k >= n:\\n            continue\\n        t0 = time.monotonic()\\n        N, t = forced_sizes(n, k)\\n        row = dict(source=r[\\\"source\\\"], cell=r[\\\"cell\\\"], n=n, c=r[\\\"c\\\"], sample=r[\\\"sample\\\"], pw=pw, k=k, N=N, t=t,\\n                   X1=\\\"\\\", X2=\\\"\\\", X3=\\\"\\\", X3p=\\\"\\\", X3_check=\\\"\\\", X4=\\\"\\\", seconds=\\\"\\\", note=\\\"\\\")\\n        try:\\n            pairs = enumerate_empty_pairs(adj, k, MAX_PAIRS)\\n        except OverflowError:\\n            row[\\\"X1\\\"] = count_exact_pairs(adj, k)\\n            row[\\\"note\\\"] = \\\"X1 by binomials; X2, X3, X4 skipped (pairs > cap)\\\"\\n            row[\\\"seconds\\\"] = round(time.monotonic() - t0, 3)\\n            out.append(row)\\n            continue\\n        row[\\\"X1\\\"] = len(pairs)\\n        row[\\\"X2\\\"] = len(separators_of(pairs, n))\\n        try:\\n            X3 = closed_pairs_pruned(adj, k, MAX_SETS)\\n            row[\\\"X3\\\"] = len(X3)\\n            if n <= 16 and k == pw:\\n                row[\\\"X3_check\\\"] = len(closed_pairs(adj, k))\\n                assert row[\\\"X3_check\\\"] == row[\\\"X3\\\"], (r[\\\"cell\\\"], r[\\\"sample\\\"])\\n        except OverflowError:\\n            row[\\\"note\\\"] += \\\"X3 skipped (sets > cap); \\\"\\n        row[\\\"X3p\\\"] = len(closure_image(adj, pairs))\\n        if len(pairs) <= MAX_X4_PAIRS:\\n            row[\\\"X4\\\"] = max(move_classes(pairs, n)) + 1 if pairs else 0\\n        else:\\n            row[\\\"note\\\"] += \\\"X4 skipped (pairs > cap); \\\"\\n        row[\\\"seconds\\\"] = round(time.monotonic() - t0, 3)\\n        out.append(row)\\n    return out\\n\\n\\ndef stage_count(workers: int) -> None:\\n    with (HERE / \\\"instances.csv\\\").open() as f:\\n        rows = list(csv.DictReader(f))\\n    # hardest first so the pool's tail is short\\n    rows.sort(key=lambda r: (-int(r[\\\"n\\\"]), int(r[\\\"c\\\"])))\\n    done = 0\\n    t0 = time.monotonic()\\n    with (HERE / \\\"counts.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f, Pool(workers) as pool:\\n        w = csv.DictWriter(f, COUNT_FIELDS)\\n        w.writeheader()\\n        for res in pool.imap_unordered(count_one, rows, chunksize=4):\\n            w.writerows(res)\\n            done += 1\\n            if done % 200 == 0:\\n                f.flush()\\n                print(f\\\"counted {done}/{len(rows)} in {time.monotonic() - t0:.0f} s\\\", flush=True)\\n    print(f\\\"counted {done} instances in {time.monotonic() - t0:.0f} s\\\")\\n\\n\\ndef ols(x: np.ndarray, y: np.ndarray) -> tuple[float, float]:\\n    \\\"\\\"\\\"Slope and its standard error of `y` on `x` (ordinary least squares).\\\"\\\"\\\"\\n    x = np.asarray(x, float)\\n    y = np.asarray(y, float)\\n    xm = x - x.mean()\\n    slope = float((xm * (y - y.mean())).sum() / (xm ** 2).sum())\\n    resid = y - y.mean() - slope * xm\\n    dof = max(len(x) - 2, 1)\\n    se = math.sqrt(float((resid ** 2).sum() / dof / (xm ** 2).sum()))\\n    return slope, se\\n\\n\\ndef stage_rates() -> None:\\n    import pandas as pd\\n    df = pd.read_csv(HERE / \\\"counts.csv\\\")\\n    df[\\\"dk\\\"] = df[\\\"k\\\"] - df[\\\"pw\\\"]\\n    for col in (\\\"X1\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n        df[col] = pd.to_numeric(df[col], errors=\\\"coerce\\\")\\n    for col in (\\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n        df[f\\\"r_{col}\\\"] = np.log(df[\\\"X1\\\"] / df[col])\\n    df[\\\"lX1\\\"] = np.log(df[\\\"X1\\\"].where(df[\\\"X1\\\"] > 0))\\n    cells = []\\n    for (src, n, c, dk), g in df.groupby([\\\"source\\\", \\\"n\\\", \\\"c\\\", \\\"dk\\\"]):\\n        pos = g[g[\\\"X1\\\"] > 0]\\n        row = dict(source=src, n=n, c=c, dk=dk, instances=len(g), X1_positive=len(pos),\\n                   share_X1_zero=round(1 - len(pos) / len(g), 4),\\n                   pw_mean=round(g[\\\"pw\\\"].mean(), 3), beta_mean=round((g[\\\"pw\\\"] / g[\\\"n\\\"]).mean(), 4),\\n                   X1_gm=round(float(np.exp(pos[\\\"lX1\\\"].mean())), 2) if len(pos) else \\\"\\\",\\n                   X1_med=pos[\\\"X1\\\"].median() if len(pos) else \\\"\\\",\\n                   X1_max=pos[\\\"X1\\\"].max() if len(pos) else \\\"\\\")\\n        for col in (\\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n            v = pos[f\\\"r_{col}\\\"].dropna()\\n            row[f\\\"{col}_n\\\"] = len(v)\\n            row[f\\\"lr_{col}_mean\\\"] = round(float(v.mean()), 4) if len(v) else \\\"\\\"\\n            row[f\\\"lr_{col}_se\\\"] = round(float(v.std(ddof=1) / math.sqrt(len(v))), 4) if len(v) > 1 else \\\"\\\"\\n            row[f\\\"r_{col}_gm\\\"] = round(float(np.exp(v.mean())), 3) if len(v) else \\\"\\\"\\n            row[f\\\"r_{col}_med\\\"] = round(float(np.exp(v.median())), 3) if len(v) else \\\"\\\"\\n            row[f\\\"r_{col}_max\\\"] = round(float(np.exp(v.max())), 3) if len(v) else \\\"\\\"\\n        row[\\\"seconds_mean\\\"] = round(g[\\\"seconds\\\"].mean(), 3)\\n        cells.append(row)\\n    cells = pd.DataFrame(cells)\\n    cells.to_csv(HERE / \\\"cells.csv\\\", index=False)\\n    slopes = []\\n    for (src, c, dk), g in df.groupby([\\\"source\\\", \\\"c\\\", \\\"dk\\\"]):\\n        if src == \\\"pilot\\\":\\n            continue\\n        pos = g[g[\\\"X1\\\"] > 0]\\n        row = dict(source=src, c=c, dk=dk, instances=len(pos), n_min=g[\\\"n\\\"].min(), n_max=g[\\\"n\\\"].max())\\n        s, se = ols(pos[\\\"n\\\"], pos[\\\"lX1\\\"])\\n        row[\\\"slope_lX1\\\"], row[\\\"se_lX1\\\"] = round(s, 4), round(se, 4)\\n        for col in (\\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\"):\\n            v = pos[[\\\"n\\\", f\\\"r_{col}\\\"]].dropna()\\n            if len(v) > 2:\\n                s, se = ols(v[\\\"n\\\"], v[f\\\"r_{col}\\\"])\\n                row[f\\\"slope_{col}\\\"], row[f\\\"se_{col}\\\"] = round(s, 4), round(se, 4)\\n            else:\\n                row[f\\\"slope_{col}\\\"], row[f\\\"se_{col}\\\"] = \\\"\\\", \\\"\\\"\\n        slopes.append(row)\\n    slopes = pd.DataFrame(slopes)\\n    slopes.to_csv(HERE / \\\"slopes.csv\\\", index=False)\\n    # the second-moment prediction at the cells' mean β, G(n, c/n)\\n    sm = []\\n    for c in CS:\\n        for n in SIZES:\\n            g = df[(df.source == \\\"fresh\\\") & (df.n == n) & (df.c == c) & (df.dk == 0)]\\n            beta = float((g[\\\"pw\\\"] / g[\\\"n\\\"]).mean())\\n            a = (1 - beta) / 2\\n            sup, twog, table = second_moment_rate_gnp(a, c)\\n            sm.append(dict(c=c, n=n, beta_mean=round(beta, 4), a=round(a, 4), g_a=round(twog / 2, 4),\\n                           sup=round(sup, 4), ratio_exponent=round(sup - twog, 4),\\n                           **{f\\\"T_{lab}\\\": round(float(x), 4) for lab, x in zip(\\n                               [\\\"AA\\\", \\\"AR\\\", \\\"AS\\\", \\\"RA\\\", \\\"RR\\\", \\\"RS\\\", \\\"SA\\\", \\\"SR\\\", \\\"SS\\\"], table)}))\\n    pd.DataFrame(sm).to_csv(HERE / \\\"second_moment_gnp.csv\\\", index=False)\\n    with (HERE / \\\"rates.log\\\").open(\\\"w\\\") as f:\\n        print(cells.to_string(), file=f)\\n        print(file=f)\\n        print(slopes.to_string(), file=f)\\n        print(file=f)\\n        print(pd.DataFrame(sm).to_string(), file=f)\\n    print(slopes.to_string())\\n\\n\\ndef stage_overlap(graphs: int = 20) -> None:\\n    import pandas as pd\\n    with (HERE / \\\"instances.csv\\\").open() as f:\\n        rows = [r for r in csv.DictReader(f) if r[\\\"source\\\"] == \\\"fresh\\\" and r[\\\"n\\\"] == \\\"20\\\" and r[\\\"c\\\"] == \\\"10\\\"]\\n    rows = rows[:graphs]\\n    n = 20\\n    hist_cols = [\\\"AA\\\", \\\"AR\\\", \\\"AS\\\", \\\"RA\\\", \\\"RR\\\", \\\"RS\\\", \\\"SA\\\", \\\"SR\\\", \\\"SS\\\"]\\n    allt = []\\n    per_graph = []\\n    for r in rows:\\n        adj = masks_of(r)\\n        pw = int(r[\\\"pw\\\"])\\n        pairs = enumerate_empty_pairs(adj, pw)\\n        T = overlap_tables(pairs, n)\\n        allt.append(T)\\n        per_graph.append(dict(sample=r[\\\"sample\\\"], pw=pw, X1=len(pairs), pairs_of_pairs=len(T),\\n                              **{f\\\"mean_{c}\\\": round(float(T[:, i].mean() / n), 4) if len(T) else \\\"\\\" for i, c in enumerate(hist_cols)}))\\n    T = np.concatenate(allt) / n\\n    pd.DataFrame(per_graph).to_csv(HERE / \\\"overlap_per_graph.csv\\\", index=False)\\n    beta = float(np.mean([int(r[\\\"pw\\\"]) / n for r in rows]))\\n    a = (1 - beta) / 2\\n   