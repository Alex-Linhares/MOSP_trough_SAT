eration, n<=16, k=pw) agreed on:\\\", (df.X3_check.notna()).sum(), \\\"rows; mismatches:\\\", ((df.X3_check.notna()) & (df.X3_check != df.X3)).sum())\\nprint(\\\"\\\\n== pilot vs fresh at n = 20 (k = pw): pw mean, X1 gm, ratios ==\\\")\\nfor c in [4,6,8,10]:\\n    for src in [\\\"fresh\\\",\\\"pilot\\\"]:\\n        x = d[(d.n==20)&(d.c==c)&(d.source==src)]\\n        print(src, c, len(x), round(x.pw.mean(),3), round(np.exp(np.log(x.X1).mean()),2), round(np.exp(np.log(x.r2).mean()),3), round(np.exp(np.log(x.r3).mean()),3), round(np.exp(np.log(x.r4).mean()),3))\\nprint(\\\"\\\\n== seconds total ==\\\", df.seconds.sum())\\nEOF\",\"description\":\"Grid-check the maximiser, parity split, pilot overlap\",\"timeout\":600000}}}","+{\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"bzgak693e\",\"run_id\":\"0mvxwf7ws-739a8be8\",\"tool_use_id\":\"toolu_017U1j2B81EX5qcKYohv7nBF\",\"description\":\"Grid-check the maximiser, parity split, pilot overlap\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"dd658ab4-c5f8-451c-b308-633b96c8a53c\",\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\"}","+{\"type\":\"tool_progress\",\"tool_use_id\":\"toolu_017U1j2B81EX5qcKYohv7nBF-heartbeat-0\",\"tool_name\":\"Bash\",\"parent_tool_use_id\":\"toolu_017U1j2B81EX5qcKYohv7nBF\",\"elapsed_time_seconds\":30,\"heartbeat\":true,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"d3908a31-df29-423d-b373-81eda86c4171\"}","+{\"type\":\"tool_progress\",\"tool_use_id\":\"toolu_017U1j2B81EX5qcKYohv7nBF-heartbeat-1\",\"tool_name\":\"Bash\",\"parent_tool_use_id\":\"toolu_017U1j2B81EX5qcKYohv7nBF\",\"elapsed_time_seconds\":60,\"heartbeat\":true,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"7b582fff-fce2-484e-857d-0dbe3632e52a\"}","+{\"type\":\"tool_progress\",\"tool_use_id\":\"toolu_017U1j2B81EX5qcKYohv7nBF-heartbeat-2\",\"tool_name\":\"Bash\",\"parent_tool_use_id\":\"toolu_017U1j2B81EX5qcKYohv7nBF\",\"elapsed_time_seconds\":90,\"heartbea