   if size == max_size:","+            return","+        for v in range(start, n):","+            u = union | adj[v] | (1 << v)","+            if popcount(u) <= limit:","+                dfs(v + 1, chosen | (1 << v), size + 1, u)","+","+    dfs(0, 0, 0, 0)","+    return out","+","+","+def enumerate_empty_pairs(adj: list[int], k: int, max_pairs: int | None = None) -> list[tuple[int, int]]:","+    \"\"\"Every ordered exact-size empty pair `(A, R)` at width `k` (`|A| = t`,","+    `|R| = N − t`, `R ∩ N[A] = ∅`), by the pruned search over `t`-sets `A` with","+    `|N[A]| ≤ n − (N − t)` and then every `(N − t)`-subset of `V ∖ N[A]`. The","+    same list as `exact_pairs`, faster when few `t`-sets qualify.\"\"\"","+    n = len(adj)","+    N, t = forced_sizes(n, k)","+    full = (1 << n) - 1","+    r = N - t","+    out: list[tuple[int, int]] = []","+    for A in small_nbhd_sets(adj, n - r, t, t):","+        outside = full & ~closed_nbhd(adj, A)","+        verts = [v for v in range(n) if outside >> v & 1]","+        for rc in combinations(verts, r):","+            out.append((A, sum(1 << v for v in rc)))","+        if max_pairs is not None and len(out) > max_pairs:","+            raise OverflowError(f\"more than {max_pairs} exact-size pairs\")","+    return out","+","+","+def separators_of(pairs: Iterator[tuple[int, int]] | list[tuple[int, int]], n: int) -> set[int]:","+    \"\"\"The distinct separators `S = V ∖ (A ∪ R)` of a list of pairs (`X₂` when","+    the pairs are all exact-size empty pairs, by L1′ c).\"\"\"","+    full = (1 << n) - 1","+    return {full & ~(A | R) for A, R in pairs}","+","+","+def closed_pairs_pruned(adj: list[int], k: int, max_sets: int | None = None) -> list[tuple[int, int]]:","+    \"\"\"`X₃` as `closed_pairs` but by the pruned search: a closed pair of the","+    forced sizes has `|A| ≥ t` and `|N[A]| = n − |R| ≤ n − (N − t)`, so `A` is","+    in the down-closed family of `small_nbhd_sets`; then `R = V ∖ N[A]` and the","+    pair is closed iff `A = V ∖ N[R]`. Works beyond `n = 16`.\"\"\"","+    n = len(adj)","+    N, t = forced_sizes(n, k)","+    full = (1 << n) - 1","+    out = []","+    for A in small_nbhd_sets(adj, n - (N - t), t, max_sets=max_sets):","+        R = full & ~closed_nbhd(adj, A)","+        if A == full & ~closed_nbhd(adj, R):","+            out.append((A, R))","+    return out","+","+","+def closure_image(adj: list[int], pairs, side: str = \"A\") -> set[tuple[int, int]]:","+    \"\"\"`X₃′`: the set of closed pairs reached from the given pairs by","+    `close_pair` (the `A`-first map by default).\"\"\"","+    return {close_pair(adj, A, R, side) for A, R in pairs}","+","+","+def move_classes(pairs: list[tuple[int, int]], n: int) -> list[int]:","+    \"\"\"`X₄`: the move-classes of a list of (exact-size empty) pairs — the","+    connected components of the graph in which two pairs are adjacent when","+    their labellings `V → {A, R, S}` differ on at most two vertices. Returns","+    the class index of every pair (classes numbered from 0 in order of first","+    appearance); `X₄ = max + 1`.\"\"\"","+    full = (1 << n) - 1","+    index = {P: i for i, P in enumerate(pairs)}","+    parent = list(range(len(pairs)))","+","+    def find(i: int) -> int:","+        while parent[i] != i:","+            parent[i] = parent[parent[i]]","+            i = parent[i]","+        return i","+","+    def union(i: int, j: int) -> None:","+        ri, rj = find(i), find(j)","+        if ri != rj:","+            parent[max(ri, rj)] = min(ri, rj)","+","+    for i, (A, R) in enumerate(pairs):","+        S = full & ~(A | R)","+        av = [v for v in range(n) if A >> v & 1]","+        rv = [v for v in range(n) if R >> v & 1]","+        sv = [v for v in range(n) if S >> v & 1]","+        for a in av:","+            Aa = A & ~(1 << a)","+            for s in sv:                       # A ↔ S","+                j = index.get((Aa | (1 << s), R))","+                if j is not None:","+                    union(i, j)","+            for r in rv:                       # A ↔ R","+                j = index.get((Aa | (1 << r), (R & ~(1 << r)) | (1 << a)))","+                if j is not None:","+                    union(i, j)","+        for r in rv:","+            Rr = R & ~(1 << r)","+            for s in sv:                       # R ↔ S","+                j = index.get((A, Rr | (1 << s)))","+                if j is not None:","+                    union(i, j)","+    roots = {}","+    out = []","+    for i in range(len(pairs)):","+        r = find(i)","+        out.append(roots.setdefault(r, len(roots)))","+    return out","+","+","+def overlap_tables(pairs: list[tuple[int, int]], n: int) -> np.ndarray:","+    \"\"\"For every ordered pair of *distinct* pairs `(P, P′)`, the `3 × 3`","+    overlap table `(|A ∩ A′|, |A ∩ R′|, |A ∩ S′|, |R ∩ A′|, |R ∩ R′|, |R ∩ S′|,","+    |S ∩ A′|, |S ∩ R′|, |S ∩ S′|)` as an integer array of shape `(X₁(X₁ − 1), 9)`.\"\"\"","+    full = (1 << n) - 1","+    rows = []","+    cls = [(A, R, full & ~(A | R)) for A, R in pairs]","+    for i, P in enumerate(cls):","+        for j, Q in enumerate(cls):","+            if i == j:","+                continue","+            rows.append([popcount(x & y) for x in P for y in Q])","+    return np.array(rows, dtype=int).reshape(-1, 9)","+","+","+# --- the second moment of the pair count on G(n, p) -----------------------------","+#","+# Two pairs `(A, R)`, `(A′, R′)` are empty together iff no edge lies in","+# `A × R ∪ A′ × R′`, whose size is `|A||R| + |A′||R′| − |A ∩ A′||R ∩ R′| −","+# |A ∩ R′||R ∩ A′|` (an unordered pair lies in both products iff it joins","+# `A ∩ A′` to `R ∩ R′` or `A ∩ R′` to `R ∩ A′`). So `E[X²]` is a sum over the","+# `3 × 3` overlap table of a multinomial times `(1 − p)^{that size}`, and with","+# `p = c/n` and both sides `a n` its exponent per vertex at a table of fractions","+# `T` is `H(T) − c (2a² − T_AA′ T_RR′ − T_AR′ T_RA′)`.","+","+","+def _entropy(T: np.ndarray) -> float:","+    T = np.asarray(T, dtype=float)","+    pos = T[T > 1e-300]","+    return float(-(pos * np.log(pos)).sum())","+","+","+def gnp_pair_rate(a: float, c: float) -> float:","+    \"\"\"`g(a)`: the exponent per vertex of `E[X]` on `G(n, c/n)` with both sides","+    `a n`: `H(a, a, 1 − 2a) − c a²`.\"\"\"","+    return _entropy(np.array([a, a, 1 - 2 * a])) - c * a * a","+","+","+def second_moment_rate_gnp(a: float, c: float, starts: int = 16, seed: int = 0) -> tuple[float, float, np.ndarray]:","+    \"\"\"The asymptotic exponent of `E[X²]` on `G(n, c/n)` (sup over the overlap","+    table of two pairs with both sides `a n`) beside `2 g(a)`; their difference","+    is the exponent of `E[X²] / E[X]²`. Returns `(sup, 2 g(a), table)` with the","+    table in the order of `overlap_tables` (`AA′, AR′, AS′, RA′, RR′, RS′, SA′,","+    SR′, SS′`). The Bernoulli form of `learning.first_moment.second_moment_rate`.\"\"\"","+    from scipy.optimize import minimize","+","+    def table(v):","+        aa, ar, ra, rr = v","+        ao = a - aa - ar","+        ro = a - ra - rr","+        oa = a - aa - ra","+        orr = a - ar - rr","+        oo = 1 - 2 * a - oa - orr","+        return np.array([aa, ar, ao, ra, rr, ro, oa, orr, oo])","+","+    def exponent(v):","+        T = table(v)","+        return _entropy(T) - c * (2 * a * a - T[0] * T[4] - T[1] * T[3])","+","+    f = lambda v: -exponent(v)  # noqa: E731","+    cons = {\"type\": \"ineq\", \"fun\": lambda v: table(v)}","+    rng = np.random.default_rng(seed)","+    prod = np.array([a * a, a * a, a * a, a * a])","+    best_v, best = prod, exponent(prod)","+    pts = [prod, np.array([0.0, a, a, 0.0]) * 0.9, np.array([a, 0.0, 0.0, a]) * 0.9]","+    pts += [rng.uniform(0, a, 4) for _ in range(starts)]","+    for v0 in pts:","+        if np.any(table(v0) < 0):","+            v0 = prod * rng.uniform(0.5, 1.5)","+            if np.any(table(v0) < 0):","+                continue","+        res = minimize(f, v0, method=\"SLSQP\", constraints=[cons], options={\"maxiter\": 500, \"ftol\": 1e-13})","+        if np.all(table(res.x) >= -1e-9):","+            val = exponent(res.x)","+            if val > best:","+                best, best_v = val, res.x","+    return float(best), 2 * gnp_pair_rate(a, c), table(best_v)","+","+","+def second_moment_exact_gnp(n: int, t: int, r: int, p: float) -> tuple[float, float, float]:","+    \"\"\"`(log E[X], log E[X²], E[X²] / E[X]²)` for `X` the number of ordered empty","+    pairs `(A, R)`, `|A| = t`, `|R| = r`, of `G(n, p)`, exactly, by the sum over","+    the `3 × 3` overlap table.\"\"\"","+    from math import lgamma","+    o = n - t - r","+    if o < 0:","+        return math.inf, math.inf, math.nan","+    lq1 = math.log1p(-p)","+    logEX = lgamma(n + 1) - lgamma(t + 1) - lgamma(r + 1) - lgamma(o + 1) + t * r * lq1","+    terms = []","+    for aa in range(t + 1):","+        for ar in range(t - aa + 1):","+            ao = t - aa - ar","+            for ra in range(min(r, t - aa) + 1):","+                for rr in range(min(r - ra, r - ar) + 1):","+                    ro = r - ra - rr","+                    oa = t - aa - ra","+                    orr = r - ar - rr","+                    oo = o - oa - orr","+                    if oo < 0:","+                        continue","+                    cells = (aa, ar, ao, ra, rr, ro, oa, orr, oo)","+                    logmult = lgamma(n + 1) - sum(lgamma(x + 1) for x in cells)","+                    forbidden = 2 * t * r - aa * rr - ar * ra","+                    terms.append(logmult + forbidden * lq1)","+    m = max(terms)","+    logEX2 = m + math.log(sum(math.exp(x - m) for x in terms))","+    return logEX, logEX2, math.exp(logEX2 - 2 * logEX)","+","+","+def second_moment_enum_gnp(n: int, t: int, r: int, p: float) -> tuple[float, float]:","+    \"\"\"`(E[X], E[X²])` by enumerating every ordered pair of pairs and summing","+    `(1 − p)^{|A × R ∪ A′ × R′|}`; the check of `second_moment_exact_gnp` (`n ≤ 10`).\"\"\"","+    verts = range(n)","+    pairs = []","+    for ac in combinations(verts, t):","+        A = sum(1 << v for v in ac)","+        rest = [v for v in verts if not A >> v & 1]","+        for rc in combinations(rest, r):","+            pairs.append((A, sum(1 << v for v in rc)))","+    EX = len(pairs) * (1 - p) ** (t * r)","+    EX2 = 0.0","+    for A, R in pairs:","+        for A2, R2 in pairs:","+            forb = 2 * t * r - popcount(A & A2) * popcount(R & R2) - popcount(A & R2) * popcount(R & A2)","+            EX2 += (1 - p) ** forb","+    return EX, EX2","+","+","+def gnp_masks(n: int, p: float, seed: int) -> list[int]:","+    \"\"\"Adjacency masks of `networkx.gnp_random_graph(n, p, seed=seed)` (the","+    pilot's generator, `reports/scratch/gnp_pilot/pilot.py`).\"\"\"","+    import networkx as nx","+    G = nx.gnp_random_graph(n, p, seed=seed)","+    adj = [0] * n","+    for u, v in G.edges():","+        adj[u] |= 1 << v","+        adj[v] |= 1 << u","+    return adj"]}]},{"filePath":"/home/al/dev/MOSP/Ralph_Loops/loop0011/session_it03.jsonl","hunks":[{"oldStart":195,"oldLines":3,"newStart":195,"newLines":5,"lines":[" {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":245,\"estimated_tokens_delta\":175,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"64697928-3936-40c4-adc0-b854d606194f\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5-1\",\"id\":\"msg_011CgcKcnAQGn33hbf7PRHtN\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"I'll now add the required functions to `learning/separator_moment.py`: pruned pair/closed-pair enumeration, move-classes via union–find, the Bernoulli second moment (asymptotic rate, finite-n sum, and a verification enumeration), and the overlap tables.\\n\\n\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":3451,\"cache_read_input_tokens\":123570,\"cache_creation\":{\"ephemeral_5m_input_tokens\":3451,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"a24e40bd-b5d3-4c42-bfea-7e31afced005\",\"timestamp\":\"2026-11-01T13:56:07.908Z\",\"request_id\":\"req_011CgcKcmisPa1e33BzGRJFd\",\"narration_block_indexes\":[0],\"thinking_duration_ms\":1,\"thinking_display\":\"updates\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5-1\",\"id\":\"msg_011CgcKcnAQGn33hbf7PRHtN\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01C5FjY9TyKPxDs5eULemPmU\",\"name\":\"Bash\",\"input\":{\"command\":\"python3 - <<'EOF'\\nimport re\\np = \\\"learning/separator_moment.py\\\"\\ns = open(p).read()\\ns = s.replace('''__all__ = [\\n    \\\"forced_sizes\\\", \\\"vertex_separation\\\", \\\"closed_nbhd\\\", \\\"open_nbhd\\\",\\n    \\\"is_empty_pair\\\", \\\"count_exact_pairs\\\", \\\"exact_pairs\\\", \\\"components\\\",\\n    \\\"separator_events\\\", \\\"count_separators\\\", \\\"close_pair\\\", \\\"closure_sequence\\\",\\n    \\\"is_closed_pair\\\", \\\"closed_pairs\\\", \\\"popcount\\\", \\\"mosp_masks\\\",\\n    \\\"pattern_meets_both\\\", \\\"shares_pattern\\\",\\n]''', '''__all__ = [\\n    \\\"forced_sizes\\\", \\\"vertex_separation\\\", \\\"closed_nbhd\\\", \\\"open_nbhd\\\",\\n    \\\"is_empty_pair\\\", \\\"count_exact_pairs\\\", \\\"exact_pairs\\\", \\\"components\\\",\\n    \\\"separator_events\\\", \\\"count_separators\\\", \\\"close_pair\\\", \\\"closure_sequence\\\",\\n    \\\"is_closed_pair\\\", \\\"closed_pairs\\\", \\\"popcount\\\", \\\"mosp_masks\\\",\\n    \\\"pattern_meets_both\\\", \\\"shares_pattern\\\",\\n    # item 03: the clumping decomposed\\n    \\\"small_nbhd_sets\\\", \\\"enumerate_empty_pairs\\\", \\\"separators_of\\\",\\n    \\\"closed_pairs_pruned\\\", \\\"closure_image\\\", \\\"move_classes\\\", \\\"overlap_tables\\\",\\n    \\\"second_moment_rate_gnp\\\", \\\"second_moment_exact_gnp\\\", \\\"second_moment_enum_gnp\\\",\\n    \\\"gnp_masks\\\",\\n]''')\\ns += '''\\n\\n# --- item 03: the clumping decomposed ------------------------------------------\\n#\\n# `X₁` exact-size empty pairs, `X₂` distinct separators among them (= the\\n# `k`-sets in `E_bip`, L1′ c), `X₃` closed pairs of the forced sizes, `X₃′` the\\n# image of the exact-size pairs under the `A`-first closure, `X₄` move-classes:\\n# the connected components of the graph on exact-size pairs in which two pairs\\n# are adjacent when their class labellings `V → {A, R, S}` differ on at most two\\n# vertices (at exact sizes that is exactly one swap of two vertices between two\\n# classes; a single vertex changing class would change the sizes).\\n\\n\\ndef small_nbhd_sets(adj: list[int], limit: int, min_size: int = 0,\\n                    max_size: int | None = None, max_sets: int | None = None) -> list[int]:\\n    \\\"\\\"\\\"Every vertex set `A` with `|N[A]| ≤ limit` and `min_size ≤ |A| ≤ max_size`,\\n    by a depth-first search in index order; the family `{A : |N[A]| ≤ limit}` is\\n    closed under subsets, so pruning a branch whose closed neighbourhood is\\n    already too large is exact (the cut of `expansion_bound._f_exact`, listing\\n    the sets instead of minimising). Raises `OverflowError` past `max_sets`.\\\"\\\"\\\"\\n    n = len(adj)\\n    if max_size is None:\\n        max_size = n\\n    out: list[int] = []\\n\\n    def dfs(start: int, chosen: int, size: int, union: int) -> None:\\n        if size >= min_size:\\n            out.append(chosen)\\n            if max_sets is not None and len(out) > max_sets:\\n                raise OverflowError(f\\\"more than {max_sets} sets with |N[A]| <= {limit}\\\")\\n        if size == max_size:\\n            return\\n        for v in range(start, n):\\n            u = union | adj[v] | (1 << v)\\n            if popcount(u) <= limit:\\n                dfs(v + 1, chosen | (1 << v), size + 1, u)\\n\\n    dfs(0, 0, 0, 0)\\n    return out\\n\\n\\ndef enumerate_empty_pairs(adj: list[int], k: int, max_pairs: int | None = None) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"Every ordered exact-size empty pair `(A, R)` at width `k` (`|A| = t`,\\n    `|R| = N − t`, `R ∩ N[A] = ∅`), by the pruned search over `t`-sets `A` with\\n    `|N[A]| ≤ n − (N − t)` and then every `(N − t)`-subset of `V ∖ N[A]`. The\\n    same list as `exact_pairs`, faster when few `t`-sets qualify.\\\"\\\"\\\"\\n    n = len(adj)\\n    N, t = forced_sizes(n, k)\\n    full = (1 << n) - 1\\n    r = N - t\\n    out: list[tuple[int, int]] = []\\n    for A in small_nbhd_sets(adj, n - r, t, t):\\n        outside = full & ~closed_nbhd(adj, A)\\n        verts = [v for v in range(n) if outside >> v & 1]\\n        for rc in combinations(verts, r):\\n            out.append((A, sum(1 << v for v in rc)))\\n        if max_pairs is not None and len(out) > max_pairs:\\n            raise OverflowError(f\\\"more than {max_pairs} exact-size pairs\\\")\\n    return out\\n\\n\\ndef separators_of(pairs: Iterator[tuple[int, int]] | list[tuple[int, int]], n: int) -> set[int]:\\n    \\\"\\\"\\\"The distinct separators `S = V ∖ (A ∪ R)` of a list of pairs (`X₂` when\\n    the pairs are all exact-size empty pairs, by L1′ c).\\\"\\\"\\\"\\n    full = (1 << n) - 1\\n    return {full & ~(A | R) for A, R in pairs}\\n\\n\\ndef closed_pairs_pruned(adj: list[int], k: int, max_sets: int | None = None) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"`X₃` as `closed_pairs` but by the pruned search: a closed pair of the\\n    forced sizes has `|A| ≥ t` and `|N[A]| = n − |R| ≤ n − (N − t)`, so `A` is\\n    in the down-closed family of `small_nbhd_sets`; then `R = V ∖ N[A]` and the\\n    pair is closed iff `A = V ∖ N[R]`. Works beyond `n = 16`.\\\"\\\"\\\"\\n    n = len(adj)\\n    N, t = forced_sizes(n, k)\\n    full = (1 << n) - 1\\n    out = []\\n    for A in small_nbhd_sets(adj, n - (N - t), t, max_sets=max_sets):\\n        R = full & ~closed_nbhd(adj, A)\\n        if A == full & ~closed_nbhd(adj, R):\\n            out.append((A, R))\\n    return out\\n\\n\\ndef closure_image(adj: list[int], pairs, side: str = \\\"A\\\") -> set[tuple[int, int]]:\\n    \\\"\\\"\\\"`X₃′`: the set of closed pairs reached from the given pairs by\\n    `close_pair` (the `A`-first map by default).\\\"\\\"\\\"\\n    return {close_pair(adj, A, R, side) for A, R in pairs}\\n\\n\\ndef move_classes(pairs: list[tuple[int, int]], n: int) -> list[int]:\\n    \\\"\\\"\\\"`X₄`: the move-classes of a list of (exact-size empty) pairs — the\\n    connected components of the graph in which two pairs are adjacent when\\n    their labellings `V → {A, R, S}` differ on at most two vertices. Returns\\n    the class index of every pair (classes numbered from 0 in order of first\\n    appearance); `X₄ = max + 1`.\\\"\\\"\\\"\\n    full = (1 << n) - 1\\n    index = {P: i for i, P in enumerate(pairs)}\\n    parent = list(range(len(pairs)))\\n\\n    def find(i: int) -> int:\\n        while parent[i] != i:\\n            parent[i] = parent[parent[i]]\\n            i = parent[i]\\n        return i\\n\\n    def union(i: int, j: int) -> None:\\n        ri, rj = find(i), find(j)\\n        if ri != rj:\\n            parent[max(ri, rj)] = min(ri, rj)\\n\\n    for i, (A, R) in enumerate(pairs):\\n        S = full & ~(A | R)\\n        av = [v for v in range(n) if A >> v & 1]\\n        rv = [v for v in range(n) if R >> v & 1]\\n        sv = [v for v in range(n) if S >> v & 1]\\n        for a in av:\\n            Aa = A & ~(1 << a)\\n            for s in sv:                       # A ↔ S\\n                j = index.get((Aa | (1 << s), R))\\n                if j is not None:\\n                    union(i, j)\\n            for r in rv:                       # A ↔ R\\n                j = index.get((Aa | (1 << r), (R & ~(1 << r)) | (1 << a)))\\n                if j is not None:\\n                    union(i, j)\\n        for r in rv:\\n            Rr = R & ~(1 << r)\\n            for s in sv:                       # R ↔ S\\n                j = index.get((A, Rr | (1 << s)))\\n                if j is not None:\\n                    union(i, j)\\n    roots = {}\\n    out = []\\n    for i in range(len(pairs)):\\n        r = find(i)\\n        out.append(roots.setdefault(r, len(roots)))\\n    return out\\n\\n\\ndef overlap_tables(pairs: list[tuple[int, int]], n: int) -> np.ndarray:\\n    \\\"\\\"\\\"For every ordered pair of *distinct* pairs `(P, P′)`, the `3 × 3`\\n    overlap table `(|A ∩ A′|, |A ∩ R′|, |A ∩ S′|, |R ∩ A′|, |R ∩ R′|, |R ∩ S′|,\\n    |S ∩ A′|, |S ∩ R′|, |S ∩ S′|)` as an integer array of shape `(X₁(X₁ − 1), 9)`.\\\"\\\"\\\"\\n    full = (1 << n) - 1\\n    rows = []\\n    cls = [(A, R, full & ~(A | R)) for A, R in pairs]\\n    for i, P in enumerate(cls):\\n        for j, Q in enumerate(cls):\\n            if i == j:\\n                continue\\n            rows.append([popcount(x & y) for x in P for y in Q])\\n    return np.array(rows, dtype=int).reshape(-1, 9)\\n\\n\\n# --- the second moment of the pair count on G(n, p) -----------------------------\\n#\\n# Two pairs `(A, R)`, `(A′, R′)` are empty together iff no edge lies in\\n# `A × R ∪ A′ × R′`, whose size is `|A||R| + |A′||R′| − |A ∩ A′||R ∩ R′| −\\n# |A ∩ R′||R ∩ A′|` (an unordered pair lies in both products iff it joins\\n# `A ∩ A′` to `R ∩ R′` or `A ∩ R′` to `R ∩ A′`). So `E[X²]` is a sum over the\\n# `3 × 3` overlap table of a multinomial times `(1 − p)^{that size}`, and with\\n# `p = c/n` and both sides `a n` its exponent per vertex at a table of fractions\\n# `T` is `H(T) − c (2a² − T_AA′ T_RR′ − T_AR′ T_RA′)`.\\n\\n\\ndef _entropy(T: np.ndarray) -> float:\\n    T = np.asarray(T, dtype=float)\\n    pos = T[T > 1e-300]\\n    return float(-(pos * np.log(pos)).sum())\\n\\n\\ndef gnp_pair_rate(a: float, c: float) -> float:\\n    \\\"\\\"\\\"`g(a)`: the exponent per vertex of `E[X]` on `G(n, c/n)` with both sides\\n    `a n`: `H(a, a, 1 − 2a) − c a²`.\\\"\\\"\\\"\\n    return _entropy(np.array([a, a, 1 - 2 * a])) - c * a * a\\n\\n\\ndef second_moment_rate_gnp(a: float, c: float, starts: int = 16, seed: int = 0) -> tuple[float, float, np.ndarray]:\\n    \\\"\\\"\\\"The asymptotic exponent of `E[X²]` on `G(n, c/n)` (sup over the overlap\\n    table of two pairs with both sides `a n`) beside `2 g(a)`; their difference\\n    is the exponent of `E[X²] / E[X]²`. Returns `(sup, 2 g(a), table)` with the\\n    table in the order of `overlap_tables` (`AA′, AR′, AS′, RA′, RR′, RS′, SA′,\\n    SR′, SS′`). The Bernoulli form of `learning.first_moment.second_moment_rate`.\\\"\\\"\\\"\\n    from scipy.optimize import minimize\\n\\n    def table(v):\\n        aa, ar, ra, rr = v\\n        ao = a - aa - ar\\n        ro = a - ra - rr\\n        oa = a - aa - ra\\n        orr = a - ar - rr\\n        oo = 1 - 2 * a - oa - orr\\n        return np.array([aa, ar, ao, ra, rr, ro, oa, orr, oo])\\n\\n    def exponent(v):\\n        T = table(v)\\n        return _entropy(T) - c * (2 * a * a - T[0] * T[4] - T[1] * T[3])\\n\\n    f = lambda v: -exponent(v)  # noqa: E731\\n    cons = {\\\"type\\\": \\\"ineq\\\", \\\"fun\\\": lambda v: table(v)}\\n    rng = np.random.default_rng(seed)\\n    prod = np.array([a * a, a * a, a * a, a * a])\\n    best_v, best = prod, exponent(prod)\\n    pts = [prod, np.array([0.0, a, a, 0.0]) * 0.9, np.array([a, 0.0, 0.0, a]) * 0.9]\\n    pts += [rng.uniform(0, a, 4) for _ in range(starts)]\\n    for v0 in pts:\\n        if np.any(table(v0) < 0):\\n            v0 = prod * rng.uniform(0.5, 1.5)\\n            if np.any(table(v0) < 0):\\n                continue\\n        res = minimize(f, v0, method=\\\"SLSQP\\\", constraints=[cons], options={\\\"maxiter\\\": 500, \\\"ftol\\\": 1e-13})\\n        if np.all(table(res.x) >= -1e-9):\\n            val = exponent(res.x)\\n            if val > best:\\n                best, best_v = val, res.x\\n    return float(best), 2 * gnp_pair_rate(a, c), table(best_v)\\n\\n\\ndef second_moment_exact_gnp(n: int, t: int, r: int, p: float) -> tuple[float, float, float]:\\n    \\\"\\\"\\\"`(log E[X], log E[X²], E[X²] / E[X]²)` for `X` the number of ordered empty\\n    pairs `(A, R)`, `|A| = t`, `|R| = r`, of `G(n, p)`, exactly, by the sum over\\n    the `3 × 3` overlap table.\\\"\\\"\\\"\\n    from math import lgamma\\n    o = n - t - r\\n    if o < 0:\\n        return math.inf, math.inf, math.nan\\n    lq1 = math.log1p(-p)\\n    logEX = lgamma(n + 1) - lgamma(t + 1) - lgamma(r + 1) - lgamma(o + 1) + t * r * lq1\\n    terms = []\\n    for aa in range(t + 1):\\n        for ar in range(t - aa + 1):\\n            ao = t - aa - ar\\n            for ra in range(min(r, t - aa) + 1):\\n                for rr in range(min(r - ra, r - ar) + 1):\\n                    ro = r - ra - rr\\n                    oa = t - aa - ra\\n                    orr = r - ar - rr\\n                    oo = o - oa - orr\\n                    if oo < 0:\\n                        continue\\n                    cells = (aa, ar, ao, ra, rr, ro, oa, orr, oo)\\n                    logmult = lgamma(n + 1) - sum(lgamma(x + 1) for x in cells)\\n                    forbidden = 2 * t * r - aa * rr - ar * ra\\n                    terms.append(logmult + forbidden * lq1)\\n    m = max(terms)\\n    logEX2 = m + math.log(sum(math.exp(x - m) for x in terms))\\n    return logEX, logEX2, math.exp(logEX2 - 2 * logEX)\\n\\n\\ndef second_moment_enum_gnp(n: int, t: int, r: int, p: float) -> tuple[float, float]:\\n    \\\"\\\"\\\"`(E[X], E[X²])` by enumerating every ordered pair of pairs and summing\\n    `(1 − p)^{|A × R ∪ A′ × R′|}`; the check of `second_moment_exact_gnp` (`n ≤ 10`).\\\"\\\"\\\"\\n    verts = range(n)\\n    pairs = []\\n    for ac in combinations(verts, t):\\n        A = sum(1 << v for v in ac)\\n        rest = [v for v in verts if not A >> v & 1]\\n        for rc in combinations(rest, r):\\n            pairs.append((A, sum(1 << v for v in rc)))\\n    EX = len(pairs) * (1 - p) ** (t * r)\\n    EX2 = 0.0\\n    for A, R in pairs:\\n        for A2, R2 in pairs:\\n            forb = 2 * t * r - popcount(A & A2) * popcount(R & R2) - popcount(A & R2) * popcount(R & A2)\\n            EX2 += (1 - p) ** forb\\n    return EX, EX2\\n\\n\\ndef gnp_masks(n: int, p: float, seed: int) -> list[int]:\\n    \\\"\\\"\\\"Adjacency masks of `networkx.gnp_random_graph(n, p, seed=seed)` (the\\n    pilot's generator, `reports/scratch/gnp_pilot/pilot.py`).\\\"\\\"\\\"\\n    import networkx as nx\\n    G = nx.gnp_random_graph(n, p, seed=seed)\\n    adj = [0] * n\\n    for u, v in G.edges():\\n        adj[u] |= 1 << v\\n        adj[v] |= 1 << u\\n    return adj\\n'''\\ns = s.replace(\\\"from itertools import combinations\\\\nfrom math import comb\\\\n\\\", \\\"import math\\\\nfrom itertools import combinations\\\\nfrom math import comb\\\\n\\\")\\nopen(p, \\\"w\\\").write(s)\\nEOF\\npython3 - <<'EOF'\\nimport time, random\\nfrom learning.separator_moment import *\\nfrom learning.separator_moment import gnp_masks\\nadj = gnp_masks(20, 0.5, 1)\\nt0=time.time(); k = vertex_separation(adj); print(\\\"pw\\\", k, time.time()-t0)\\nfor kk in [k-1,k,k+1,k+2]:\\n    t0=time.time()\\n    P = enumerate_empty_pairs(adj, kk)\\n    assert len(P) == count_exact_pairs(adj, kk) == sum(1 for _ in exact_pairs(adj, kk))\\n    X2 = len(separators_of(P, 20)); X2b = count_separators(adj, kk)[0] if kk<=k else None\\n    X3 = len(closed_pairs_pruned(adj, kk)); X3b = len(closed_pairs(adj, kk)) if kk<=k else None\\n    X3p = len(closure_image(adj, P)); X4 = max(move_classes(P, 20))+1 if P else 0\\n    print(kk, len(P), X2, X2b, X3, X3b, X3p, X4, round(time.time()-t0,2))\\nprint(second_moment_exact_gnp(10,3,2,0.3)); print(second_moment_enum_gnp(10,3,2,0.3))\\nprint(second_moment_rate_gnp(0.3, 10))\\nEOF\",\"description\":\"Add item 03 functions and smoke-test them\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":3451,\"cache_read_input_tokens\":123570,\"cache_creation\":{\"ephemeral_5m_input_tokens\":3451,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"99e0a273-33c3-4f3b-baa2-104bceac5e28\",\"uuid\":\"594e9b0e-c55e-45f2-874b-f1b93072b3f5\",\"timestamp\":\"2026-11-01T13:57:05.698Z\",\"request_id\":\"req_011CgcKcmisPa1e33BzGRJFd\",\"wire_tool_inputs\":{\"toolu_01C5FjY9TyKPxDs5eULemPmU\":{\"command\":\"cd /home/al/dev/MOSP && python3 - <<'EOF'\\nimport re\\np = \\\"learning/separator_moment.py\\\"\\ns = open(p).read()\\ns = s.replace('''__all__ = [\\n    \\\"forced_sizes\\\", \\\"vertex_separation\\\", \\\"closed_nbhd\\\", \\\"open_nbhd\\\",\\n    \\\"is_empty_pair\\\", \\\"count_exact_pairs\\\", \\\"exact_pairs\\\", \\\"components\\\",\\n    \\\"separator_events\\\", \\\"count_separators\\\", \\\"close_pair\\\", \\\"closure_sequence\\\",\\n    \\\"is_closed_pair\\\", \\\"closed_pairs\\\", \\\"popcount\\\", \\\"mosp_masks\\\",\\n    \\\"pattern_meets_both\\\", \\\"shares_pattern\\\",\\n]''', '''__all__ = [\\n    \\\"forced_sizes\\\", \\\"vertex_separation\\\", \\\"closed_nbhd\\\", \\\"open_nbhd\\\",\\n    \\\"is_empty_pair\\\", \\\"count_exact_pairs\\\", \\\"exact_pairs\\\", \\\"components\\\",\\n    \\\"separator_events\\\", \\\"count_separators\\\", \\\"close_pair\\\", \\\"closure_sequence\\\",\\n    \\\"is_closed_pair\\\", \\\"closed_pairs\\\", \\\"popcount\\\", \\\"mosp_masks\\\",\\n    \\\"pattern_meets_both\\\", \\\"shares_pattern\\\",\\n    # item 03: the clumping decomposed\\n    \\\"small_nbhd_sets\\\", \\\"enumerate_empty_pairs\\\", \\\"separators_of\\\",\\n    \\\"closed_pairs_pruned\\\", \\\"closure_image\\\", \\\"move_classes\\\", \\\"overlap_tables\\\",\\n    \\\"second_moment_rate_gnp\\\", \\\"second_moment_exact_gnp\\\", \\\"second_moment_enum_gnp\\\",\\n    \\\"gnp_masks\\\",\\n]''')\\ns += '''\\n\\n# --- item 03: the clumping decomposed ------------------------------------------\\n#\\n# `X₁` exact-size empty pairs, `X₂` distinct separators among them (= the\\n# `k`-sets in `E_bip`, L1′ c), `X₃` closed pairs of the forced sizes, `X₃′` the\\n# image of the exact-size pairs under the `A`-first closure, `X₄` move-classes:\\n# the connected components of the graph on exact-size pairs in which two pairs\\n# are adjacent when their class labellings `V → {A, R, S}` differ on at most two\\n# vertices (at exact sizes that is exactly one swap of two vertices between two\\n# classes; a single vertex changing class would change the sizes).\\n\\n\\ndef small_nbhd_sets(adj: list[int], limit: int, min_size: int = 0,\\n                    max_size: int | None = None, max_sets: int | None = None) -> list[int]:\\n    \\\"\\\"\\\"Every vertex set `A` with `|N[A]| ≤ limit` and `min_size ≤ |A| ≤ max_size`,\\n    by a depth-first search in index order; the family `{A : |N[A]| ≤ limit}` is\\n    closed under subsets, so pruning a branch whose closed neighbourhood is\\n    already too large is exact (the cut of `expansion_bound._f_exact`, listing\\n    the sets instead of minimising). Raises `OverflowError` past `max_sets`.\\\"\\\"\\\"\\n    n = len(adj)\\n    if max_size is None:\\n        max_size = n\\n    out: list[int] = []\\n\\n    def dfs(start: int, chosen: int, size: int, union: int) -> None:\\n        if size >= min_size:\\n            out.append(chosen)\\n            if max_sets is not None and len(out) > max_sets:\\n                raise OverflowError(f\\\"more than {max_sets} sets with |N[A]| <= {limit}\\\")\\n        if size == max_size:\\n            return\\n        for v in range(start, n):\\n            u = union | adj[v] | (1 << v)\\n            if popcount(u) <= limit:\\n                dfs(v + 1, chosen | (1 << v), size + 1, u)\\n\\n    dfs(0, 0, 0, 0)\\n    return out\\n\\n\\ndef enumerate_empty_pairs(adj: list[int], k: int, max_pairs: int | None = None) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"Every ordered exact-size empty pair `(A, R)` at width `k` (`|A| = t`,\\n    `|R| = N − t`, `R ∩ N[A] = ∅`), by the pruned search over `t`-sets `A` with\\n    `|N[A]| ≤ n − (N − t)` and then every `(N − t)`-subset of `V ∖ N[A]`. The\\n    same list as `exact_pairs`, faster when few `t`-sets qualify.\\\"\\\"\\\"\\n    n = len(adj)\\n    N, t = forced_sizes(n, k)\\n    full = (1 << n) - 1\\n    r = N - t\\n    out: list[tuple[int, int]] = []\\n    for A in small_nbhd_sets(adj, n - r, t, t):\\n        outside = full & ~closed_nbhd(adj, A)\\n        verts = [v for v in range(n) if outside >> v & 1]\\n        for rc in combinations(verts, r):\\n            out.append((A, sum(1 << v for v in rc)))\\n        if max_pairs is not None and len(out) > max_pairs:\\n            raise OverflowError(f\\\"more than {max_pairs} exact-size pairs\\\")\\n    return out\\n\\n\\ndef separators_of(pairs: Iterator[tuple[int, int]] | list[tuple[int, int]], n: int) -> set[int]:\\n    \\\"\\\"\\\"The distinct separators `S = V ∖ (A ∪ R)` of a list of pairs (`X₂` when\\n    the pairs are all exact-size empty pairs, by L1′ c).\\\"\\\"\\\"\\n    full = (1 << n) - 1\\n    return {full & ~(A | R) for A, R in pairs}\\n\\n\\ndef closed_pairs_pruned(adj: list[int], k: int, max_sets: int | None = None) -> list[tuple[int, int]]:\\n    \\\"\\\"\\\"`X₃` as `closed_pairs` but by the pruned search: a closed pair of the\\n    forced sizes has `|A| ≥ t` and `|N[A]| = n − |R| ≤ n − (N − t)`, so `A` is\\n    in the down-closed family of `small_nbhd_sets`; then `R = V ∖ N[A]` and the\\n    pair is closed iff `A = V ∖ N[R]`. Works beyond `n = 16`.\\\"\\\"\\\"\\n    n = len(adj)\\n    N, t = forced_sizes(n, k)\\n    full = (1 << n) - 1\\n    out = []\\n    for A in small_nbhd_sets(adj, n - (N - t), t, max_sets=max_sets):\\n        R = full & ~closed_nbhd(adj, A)\\n        if A == full & ~closed_nbhd(adj, R):\\n            out.append((A, R))\\n    return out\\n\\n\\ndef closure_image(adj: list[int], pairs, side: str = \\\"A\\\") -> set[tuple[int, int]]:\\n    \\\"\\\"\\\"`X₃′`: the set of closed pairs reached from the given pairs by\\n    `close_pair` (the `A`-first map by default).\\\"\\\"\\\"\\n    return {close_pair(adj, A, R, side) for A, R in pairs}\\n\\n\\ndef move_classes(pairs: list[tuple[int, int]], n: int) -> list[int]:\\n    \\\"\\\"\\\"`X₄`: the move-classes of a list of (exact-size empty) pairs — the\\n    connected components of the graph in which two pairs are adjacent when\\n    their labellings `V → {A, R, S}` differ on at most two vertices. Returns\\n    the class index of every pair (classes numbered from 0 in order of first\\n    appearance); `X₄ = max + 1`.\\\"\\\"\\\"\\n    full = (1 << n) - 1\\n    index = {P: i for i, P in enumerate(pairs)}\\n    parent = list(range(len(pairs)))\\n\\n    def find(i: int) -> int:\\n        while parent[i] != i:\\n            parent[i] = parent[parent[i]]\\n            i = parent[i]\\n        return i\\n\\n    def union(i: int, j: int) -> None:\\n        ri, rj = find(i), find(j)\\n        if ri != rj:\\n            parent[max(ri, rj)] = min(ri, rj)\\n\\n    for i, (A, R) in enumerate(pairs):\\n        S = full & ~(A | R)\\n        av = [v for v in range(n) if A >> v & 1]\\n        rv = [v for v in range(n) if R >> v & 1]\\n        sv = [v for v in range(n) if S >> v & 1]\\n        for a in av:\\n            Aa = A & ~(1 << a)\\n            for s in sv:                       # A ↔ S\\n                j = index.get((Aa | (1 << s), R))\\n                if j is not None:\\n                    union(i, j)\\n            for r in rv:                       # A ↔ R\\n                j = index.get((Aa | (1 << r), (R & ~(1 << r)) | (1 << a)))\\n                if j is not None:\\n                    union(i, j)\\n        for r in rv:\\n            Rr = R & ~(1 << r)\\n            for s in sv:                       # R ↔ S\\n                j = index.get((A, Rr | (1 << s)))\\n                if j is not None:\\n                    union(i, j)\\n    roots = {}\\n    out = []\\n    for i in range(len(pairs)):\\n        r = find(i)\\n        out.append(roots.setdefault(r, len(roots)))\\n    return out\\n\\n\\ndef overlap_tables(pairs: list[tuple[int, int]], n: int) -> np.ndarray:\\n    \\\"\\\"\\\"For every ordered pair of *distinct* pairs `(P, P′)`, the `3 × 3`\\n    overlap table `(|A ∩ A′|, |A ∩ R′|, |A ∩ S′|, |R ∩ A′|, |R ∩ R′|, |R ∩ S′|,\\n    |S ∩ A′|, |S ∩ R′|, |S ∩ S′|)` as an integer array of shape `(X₁(X₁ − 1), 9)`.\\\"\\\"\\\"\\n    full = (1 << n) - 1\\n    rows = []\\n    cls = [(A, R, full & ~(A | R)) for A, R in pairs]\\n    for i, P in enumerate(cls):\\n        for j, Q in enumerate(cls):\\n            if i == j:\\n                continue\\n            rows.append([popcount(x & y) for x in P for y in Q])\\n    return np.array(rows, dtype=int).reshape(-1, 9)\\n\\n\\n# --- the second moment of the pair count on G(n, p) -----------------------------\\n#\\n# Two pairs `(A, R)`, `(A′, R′)` are empty together iff no edge lies in\\n# `A × R ∪ A′ × R′`, whose size is `|A||R| + |A′||R′| − |A ∩ A′||R ∩ R′| −\\n# |A ∩ R′||R ∩ A′|` (an unordered pair lies in both products iff it joins\\n# `A ∩ A′` to `R ∩ R′` or `A ∩ R′` to `R ∩ A′`). So `E[X²]` is a sum over the\\n# `3 × 3` overlap table of a multinomial times `(1 − p)^{that size}`, and with\\n# `p = c/n` and both sides `a n` its exponent per vertex at a table of fractions\\n# `T` is `H(T) − c (2a² − T_AA′ T_RR′ − T_AR′ T_RA′)`.\\n\\n\\ndef _entropy(T: np.ndarray) -> float:\\n    T = np.asarray(T, dtype=float)\\n    pos = T[T > 1e-300]\\n    return float(-(pos * np.log(pos)).sum())\\n\\n\\ndef gnp_pair_rate(a: float, c: float) -> float:\\n    \\\"\\\"\\\"`g(a)`: the exponent per vertex of `E[X]` on `G(n, c/n)` with both sides\\n    `a n`: `H(a, a, 1 − 2a) − c a²`.\\\"\\\"\\\"\\n    return _entropy(np.array([a, a, 1 - 2 * a])) - c * a * a\\n\\n\\ndef second_moment_rate_gnp(a: float, c: float, starts: int = 16, seed: int = 0) -> tuple[float, float, np.ndarray]:\\n    \\\"\\\"\\\"The asymptotic exponent of `E[X²]` on `G(n, c/n)` (sup over the overlap\\n    table of two pairs with both sides `a n`) beside `2 g(a)`; their difference\\n    is the exponent of `E[X²] / E[X]²`. Returns `(sup, 2 g(a), table)` with the\\n    table in the order of `overlap_tables` (`AA′, AR′, AS′, RA′, RR′, RS′, SA′,\\n    SR′, SS′`). The Bernoulli form of `learning.first_moment.second_moment_rate`.\\\"\\\"\\\"\\n    from scipy.optimize import minimize\\n\\n    def table(v):\\n        aa, ar, ra, rr = v\\n        ao = a - aa - ar\\n        ro = a - ra - rr\\n        oa = a - aa - ra\\n        orr = a - ar - rr\\n        oo = 1 - 2 * a - oa - orr\\n        return np.array([aa, ar, ao, ra, rr, ro, oa, orr, oo])\\n\\n    def exponent(v):\\n        T = table(v)\\n        return _entropy(T) - c * (2 * a * a - T[0] * T[4] - T[1] * T[3])\\n\\n    f = lambda v: -exponent(v)  # noqa: E731\\n    cons = {\\\"type\\\": \\\"ineq\\\", \\\"fun\\\": lambda v: table(v)}\\n    rng = np.random.default_rng(seed)\\n    prod = np.array([a * a, a * a, a * a, a * a])\\n    best_v, best = prod, exponent(prod)\\n    pts = [prod, np.array([0.0, a, a, 0.0]) * 0.9, np.array([a, 0.0, 0.0, a]) * 0.9]\\n    pts += [rng.uniform(0, a, 4) for _ in range(starts)]\\n    for v0 in pts:\\n        if np.any(table(v0) < 0):\\n            v0 = prod * rng.uniform(0.5, 1.5)\\n            if np.any(table(v0) < 0):\\n                continue\\n        res = minimize(f, v0, method=\\\"SLSQP\\\", constraints=[cons], options={\\\"maxiter\\\": 500, \\\"ftol\\\": 1e-13})\\n        if np.all(table(res.x) >= -1e-9):\\n            val = exponent(res.x)\\n            if val > best:\\n                best, best_v = val, res.x\\n    return float(best), 2 * gnp_pair_rate(a, c), table(best_v)\\n\\n\\ndef second_moment_exact_gnp(n: int, t: int, r: int, p: float) -> tuple[float, float, float]:\\n    \\\"\\\"\\\"`(log E[X], log E[X²], E[X²] / E[X]²)` for `X` the number of ordered empty\\n    pairs `(A, R)`, `|A| = t`, `|R| = r`, of `G(n, p)`, exactly, by the sum over\\n    the `3 × 3` overlap table.\\\"\\\"\\\"\\n    from math import lgamma\\n    o = n - t - r\\n    if o < 0:\\n        return math.inf, math.inf, math.nan\\n    lq1 = math.log1p(-p)\\n    logEX = lgamma(n + 1) - lgamma(t + 1) - lgamma(r + 1) - lgamma(o + 1) + t * r * lq1\\n    terms = []\\n    for aa in range(t + 1):\\n        for ar in range(t - aa + 1):\\n            ao = t - aa - ar\\n            for ra in range(min(r, t - aa) + 1):\\n                for rr in range(min(r - ra, r - ar) + 1):\\n                    ro = r - ra - rr\\n                    oa = t - aa - ra\\n                    orr = r - ar - rr\\n                    oo = o - oa - orr\\n                    if oo < 0:\\n                        continue\\n                    cells = (aa, ar, ao, ra, rr, ro, oa, orr, oo)\\n                    logmult = lgamma(n + 1) - sum(lgamma(x + 1) for x in cells)\\n                    forbidden = 2 * t * r - aa * rr - ar * ra\\n                    terms.append(logmult + forbidden * lq1)\\n    m = max(terms)\\n    logEX2 = m + math.log(sum(math.exp(x - m) for x in terms))\\n    return logEX, logEX2, math.exp(logEX2 - 2 * logEX)\\n\\n\\ndef second_moment_enum_gnp(n: int, t: int, r: int, p: float) -> tuple[float, float]:\\n    \\\"\\\"\\\"`(E[X], E[X²])` by enumerating every ordered pair of pairs and summing\\n    `(1 − p)^{|A × R ∪ A′ × R′|}`; the check of `second_moment_exact_gnp` (`n ≤ 10`).\\\"\\\"\\\"\\n    verts = range(n)\\n    pairs = []\\n    for ac in combinations(verts, t):\\n        A = sum(1 << v for v in ac)\\n        rest = [v for v in verts if not A >> v & 1]\\n        for rc in combinations(rest, r):\\n            pairs.append((A, sum(1 << v for v in rc)))\\n    EX = len(pairs) * (1 - p) ** (t * r)\\n    EX2 = 0.0\\n    for A, R in pairs:\\n        for A2, R2 in pairs:\\n            forb = 2 * t * r - popcount(A & A2) * popcount(R & R2) - popcount(A & R2) * popcount(R & A2)\\n            EX2 += (1 - p) ** forb\\n    return EX, EX2\\n\\n\\ndef gnp_masks(n: int, p: float, seed: int) -> list[int]:\\n    \\\"\\\"\\\"Adjacency masks of `networkx.gnp_random_graph(n, p, seed=seed)` (the\\n    pilot's generator, `reports/scratch/gnp_pilot/pilot.py`).\\\"\\\"\\\"\\n    import networkx as nx\\n    G = nx.gnp_random_graph(n, p, seed=seed)\\n    adj = [0] * n\\n    for u, v in G.edges():\\n        adj[u] |= 1 << v\\n        adj[v] |= 1 << u\\n    return adj\\n'''\\ns = s.replace(\\\"from itertools import combinations\\\\nfrom math import comb\\\\n\\\", \\\"import math\\\\nfrom itertools import combinations\\\\nfrom math import comb\\\\n\\\")\\nopen(p, \\\"w\\\").write(s)\\nEOF\\npython3 - <<'EOF'\\nimport time, random\\nfrom learning.separator_moment import *\\nfrom learning.separator_moment import gnp_masks\\nadj = gnp_masks(20, 0.5, 1)\\nt0=time.time(); k = vertex_separation(adj); print(\\\"pw\\\", k, time.time()-t0)\\nfor kk in [k-1,k,k+1,k+2]:\\n    t0=time.time()\\n    P = enumerate_empty_pairs(adj, kk)\\n    assert len(P) == count_exact_pairs(adj, kk) == sum(1 for _ in exact_pairs(adj, kk))\\n    X2 = len(separators_of(P, 20)); X2b = count_separators(adj, kk)[0] if kk<=k else None\\n    X3 = len(closed_pairs_pruned(adj, kk)); X3b = len(closed_pairs(adj, kk)) if kk<=k else None\\n    X3p = len(closure_image(adj, P)); X4 = max(move_classes(P, 20))+1 if P else 0\\n    print(kk, len(P), X2, X2b, X3, X3b, X3p, X4, round(time.time()-t0,2))\\nprint(second_moment_exact_gnp(10,3,2,0.3)); print(second_moment_enum_gnp(10,3,2,0.3))\\nprint(second_moment_rate_gnp(0.3, 10))\\nEOF\",\"description\":\"Add item 03 functions and smoke-test them\"}},\"wire_ingest_context\":