from pathlib import Path","+","+import numpy as np","+import pandas as pd","+","+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))","+from learning.separator_moment import _entropy, second_moment_rate_gnp  # noqa: E402","+","+HERE = Path(__file__).resolve().parent","+","+print(\"== grid check of the SLSQP maximiser (4 free cells on a 61^4 grid) ==\")","+","+","+def expo(v, a, c):","+    aa, ar, ra, rr = v","+    T = np.array([aa, ar, a - aa - ar, ra, rr, a - ra - rr, a - aa - ra, a - ar - rr,","+                  1 - 2 * a - (a - aa - ra) - (a - ar - rr)])","+    if np.any(T < -1e-12):","+        return -np.inf","+    return _entropy(np.clip(T, 0, None)) - c * (2 * a * a - T[0] * T[4] - T[1] * T[3])","+","+","+for a, c in [(0.2188, 10), (0.3452, 4), (0.2755, 6), ((1 - 0.3371) / 2, 10), ((1 - 0.1706) / 2, 6)]:","+    g = np.linspace(0, a, 61)","+    best = (-np.inf, None)","+    for v in itertools.product(g, g, g, g):","+        e = expo(v, a, c)","+        if e > best[0]:","+            best = (e, v)","+    sup, twog, T = second_moment_rate_gnp(a, c)","+    print(f\"a={a:.4f} c={c}: grid max {best[0]:.5f} at {np.round(best[1], 4)}; SLSQP {sup:.5f} \"","+          f\"table AA,AR,RA,RR = {np.round(T[[0, 1, 3, 4]], 4)}; ratio exp {sup - twog:.4f}\")","+","+print(\"\\n== ratio exponent at beta* on G(n, c/n) ==\")","+for c, bs in [(4, 0.061), (6, 0.1706), (8, 0.263), (10, 0.3371)]:","+    a = (1 - bs) / 2","+    sup, twog, T = second_moment_rate_gnp(a, c)","+    print(f\"c={c} beta*={bs} a={a:.4f}: g={twog / 2:.5f} sup={sup:.4f} ratio exponent={sup - twog:.4f} table={np.round(T, 3)}\")","+","+print(\"\\n== parity of N and X1/X2 at k = pw ==\")","+df = pd.read_csv(HERE / \"counts.csv\")","+d = df[(df.k == df.pw)].copy()","+d[\"Neven\"] = (d.N % 2 == 0)","+d[\"r2\"] = d.X1 / d.X2","+d[\"r3\"] = d.X1 / d.X3","+d[\"r4\"] = d.X1 / d.X4","+gm = lambda x: np.exp(np.log(x).mean())  # noqa: E731","+g = d.groupby([\"source\", \"c\", \"Neven\"]).agg(n_inst=(\"X1\", \"siz