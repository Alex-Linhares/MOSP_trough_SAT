eck_lean.main() == 0\\n    assert len(check_lean.cited()) > 50\\n\\n\\ndef test_every_doi_is_in_the_checked_cache():\\n    \\\"\\\"\\\"Offline: each DOI of refs.bib was fetched and compared by check_refs.\\\"\\\"\\\"\\n    cache = json.loads(check_refs.CACHE.read_text())\\n    entries = check_refs.entries(check_refs.BIB.read_text())\\n    dois = [e[\\\"doi\\\"].lower() for e in entries if e.get(\\\"doi\\\")]\\n    assert len(dois) >= 30\\n    assert all(d in cache for d in dois)\\n\\n\\ndef test_every_citation_key_is_in_the_bibliography():\\n    keys = {e[\\\"key\\\"] for e in check_refs.entries(check_refs.BIB.read_text())}\\n    cited = set()\\n    for f in list(HERE.glob(\\\"sec*.tex\\\")) + [HERE / \\\"main.tex\\\"]:\\n        for arg in re.findall(r\\\"\\\\\\\\cite[tp]?\\\\*?(?:\\\\[[^\\\\]]*\\\\])*\\\\{([^}]*)\\\\}\\\", f.read_text()):\\n            cited.update(k.strip() for k in arg.split(\\\",\\\"))\\n    assert cited <= keys, cited - keys\\n\\n\\ndef test_cost_table_reproduces_the_recorded_ratios():\\n----\\n63-the sharp worst case `log₃((6N + 3)/5) ≈ 0.63 log₂ N` of `TreeBound.lean`.\\n64-Nothing was found for random recursive trees or binary search trees. **The\\n65:most consequential single finding is on the upper side**: Edwards & McDermid\\n66-(2015), read in the accepted manuscript, prove\\n67-`pw(G) ≤ Σ_{d ≥ 3} g_{1/6}(d) · n_d + o(n)` with an explicit recurrence for\\n68-`g_{1/6}`, and on Poisson(`c`) degrees this gives **`pw/n ≤ 0.183, 0.458,\\n69-0.656` at `c = 3, 6, 10`**, below every upper bound in the survey's §7(a)\\n70-table (0.260, 0.520, 0.760) at every `c` from 2 to about 32, and within a\\n71-factor 1.6–1.85 of the fitted slopes. On the clique-cover cells of\\n--\\n104-| 15 | Kneis, Mölle, Richter & Rossmanith 2009, *SIAM J. Discrete Math.* 23(1):407–427, DOI 10.1137/080715482 | every graph | `pw ≤ m/5.769 + O(log n)`; `m/5.217 + 3` with all bags sharing a large common set (abstract, read through Crossref; `13/75 = 1/5.769` confirmed by 1