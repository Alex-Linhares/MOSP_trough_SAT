LeeLeeOum2012,\n699:@book{CoverThomas2006,\n708:@article{Gao2012,\n716:@article{ChouKoHoChen2008,\n----\n\"\"\"Check that every Lean name the draft cites is declared (loop0008 item 08).\n\n    python -m paper1.latex.check_lean\n\nCollects the names in `\\\\leannames{...}` (Appendix A) and `\\\\lean{...}`, and in `\\\\path{...}` cells of the section\nfiles, and looks for a declaration of each (theorem, lemma, def, abbrev,\nstructure, inductive, instance, or a structure field) under\n`lean/MOSPFormalization/`. A dotted name such as `NetGateMatrix.tracks_eq_mospValue`\nis matched on its last component inside a file that mentions the prefix.\nExits non-zero if a name is not found. It checks existence, not that the\ntheorem states what the text says; that was checked by reading.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nLEAN = HERE.parents[1] / \"lean\" / \"MOSPFormalization\"\nDECL = re.compile(r\"^\\s*(?:@\\[[^\\]]*\\]\\s*)?(?:private\\s+|protected\\s+|noncomputable\\s+)*\"\n                  r\"(?:theorem|lemma|def|abbrev|structure|inductive|instance|class)\\s+([^\\s:({\\[]+)\",\n                  re.M)\nFIELD = re.compile(r\"^\\s{2,}(\\w+)\\s*:\", re.M)\n\n\ndef cited() -> set[str]:\n    names: set[str] = set()\n    for f in sorted(HERE.glob(\"sec*.tex\")):\n        text = f.read_text()\n        for arg in re.findall(r\"\\\\lean(?:names)?\\{([^}]*)\\}\", text):\n            names.update(n.strip() for n in arg.split(\",\"))\n        for arg in re.findall(r\"\\\\path\\{([^}]*)\\}\", text):\n            if re.fullmatch(r\"[A-Za-z_.']+\", arg) and not arg.endswith((\".lean\", \"/\")):\n                names.add(arg)\n    return {n for n in names if n}\n\n\ndef main() -> int:\n    files = {p: p.read_text() for p in LEAN.rglob(\"*.lean\")}\n    declared: dict[str, list[Path]] = {}\n    for p, text in files.items():\n        for m in DECL.finditer(text):\n            declared.setdefault(m.group(1).split(\".\")[-1], []).append(p)\n        for m in FIELD.finditer(text):\n            declared.setdefault(m.group(1), []).append(p)\n    missing = []\n    for name in sorted(cited()):\n        last = name.split(\".\")[-1]\n        prefix = name.split(\".\")[0] if \".\" in name else None\n        hits = declared.get(last, [])\n        if prefix:\n            hits = [p for p in hits if prefix in files[p]]\n        print(f\"{'ok ' if hits else 'MISSING'} {name}\"\n              + (f\"  ({hits[0].relative_to(LEAN)})\" if hits else \"\"))\n        if not hits:\n            missing.append(name)\n    print(f\"{len(cited())} names cited, {len(missing)} not found\")\n    return 1 if missing else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n----\n12:def test_every_cited_lean_name_is_declared():\n17:def test_every_doi_is_in_the_checked_cache():\n26:def test_every_citation_key_is_in_the_bibliography():\n35:def test_cost_table_reproduces_the_recorded_ratios():\n42:def test_certificates_table_reproduces_the_recorded_totals():\n48:def test_every_cited_theorem_has_an_axiom_line():\n83:def test_phase_diagram_csv_matches_its_sources():\n131:def test_excess_table_comes_from_the_csv():","is_error":false}]},"parent_tool_use_id":null,"session_id":"705e2dc1-3bd5-4ca7-a2e8-b0a1809ff2f3","uuid":"cbaae940-6888-4d14-b226-43a022167979","timestamp":"2026-11-01T22:59:55.027Z","tool_use_result":{"stdout":"  doi     = {10.1016/S0012-365X(00)00278-8}\n}\n\n@article{PerarnauSerra2014,\n  author  = {Perarnau, Guillem and Serra, Oriol},\n  title   = {On the tree-depth of random graphs},\n  journal = {Discrete Applied Mathematics},\n  volume  = {168}, pages = {119--126}, year = {2014},\n  doi     = {10.1016/j.dam.2012.10.031}\n}\n\n@article{LeeLeeOum2012,\n  author  = {Lee, Choongbum and Lee, Joonkyung and Oum, Sang-il},\n  title   = {Rank-width of random graphs},\n  journal = {Journal of Graph Theory},\n  volume  = {70}, number = {3}, pages = {339--347}, year = {2012},\n  doi     = {10.1002/jgt.20620}\n}\n\n@book{CoverThomas2006,\n  author    = {Cover, Thomas M. and Thomas, Joy A.},\n  title     = {Elements of Information Theory},\n  edition   = {2nd},\n  publisher = {Wiley},\n  year      = {2006},\n  doi       = {10.1002/047174882X}\n}\n\n@article{Gao2012,\n  author  = {Gao, Yong},\n  title   = {Treewidth of {E}rd{\\H{o}}s--{R}{\\'e}nyi random graphs, random intersection graphs, and scale-free random graphs},\n  journal = {Discrete Applied Mathematics},\n  volume  = {160}, number = {4--5}, pages = {566--578}, year = {2012},\n  doi     = {10.1016/j.dam.2011.10.013}\n}\n\n@article{ChouKoHoChen2008,\n  author  = {Chou, Hsin-Hung and Ko, Ming-Tat and Ho, Chin-Wen and Chen, Gen-Huey},\n  title   = {Node-searching problem on block graphs},\n  journal = {Discrete Applied Mathematics},\n  volume  = {156}, number = {1}, pages = {55--75}, year = {2008},\n  doi     = {10.1016/j.dam.2007.08.007}\n}\n----\n580:@inproceedings{PySAT2018,\n591:@article{McKayPiperno2014,\n602:@techreport{DeGiovanni2010,\n612:@article{DeGiovanni2013a,\n624:@article{DeGiovanni2013b,\n636:@book{Knuth2015,\n644:@article{Harper1966,\n655:@article{ChandranKavitha2006,\n667:@article{Turner1986,\n675:@article{DiazPetitSernaTrevisan2001,\n683:@article{PerarnauSerra2014,\n691:@article{LeeLeeOum2012,\n699:@book{CoverThomas2006,\n708:@article{Gao2012,\n716:@article{ChouKoHoChen2008,\n----\n\"\"\"Check that every Lean name the draft cites is declared (loop0008 item 08).\n\n    python -m paper1.latex.check_lean\n\nCollects the names in `\\\\leannames{...}` (Appendix A) and `\\\\lean{...}`, and in `\\\\path{...}` cells of the section\nfiles, and looks for a declaration of each (theorem, lemma, def, abbrev,\nstructure, inductive, instance, or a structure field) under\n`lean/MOSPFormalization/`. A dotted name such as `NetGateMatrix.tracks_eq_mospValue`\nis matched on its last component inside a file that mentions the prefix.\nExits non-zero if a name is not found. It checks existence, not that the\ntheorem states what the text says; that was checked by reading.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nLEAN = HERE.parents[1] / \"lean\" / \"MOSPFormalization\"\nDECL = re.compile(r\"^\\s*(?:@\\[[^\\]]*\\]\\s*)?(?:private\\s+|protected\\s+|noncomputable\\s+)*\"\n                  r\"(?:theorem|lemma|def|abbrev|structure|inductive|instance|class)\\s+([^\\s:({\\[]+)\",\n                  re.M)\nFIELD = re.compile(r\"^\\s{2,}(\\w+)\\s*:\", re.M)\n\n\ndef cited() -> set[str]:\n    names: set[str] = set()\n    for f in sorted(HERE.glob(\"sec*.tex\")):\n        text = f.read_text()\n        for arg in re.findall(r\"\\\\lean(?:names)?\\{([^}]*)\\}\", text):\n            names.update(n.strip() for n in arg.split(\",\"))\n        for arg in re.findall(r\"\\\\path\\{([^}]*)\\}\", text):\n            if re.fullmatch(r\"[A-Za-z_.']+\", arg) and not arg.endswith((\".lean\", \"/\")):\n                names.add(arg)\n    return {n for n in names if n}\n\n\ndef main() -> int:\n    files = {p: p.read_text() for p in LEAN.rglob(\"*.lean\")}\n    declared: dict[str, list[Path]] = {}\n    for p, text in files.items():\n        for m in DECL.finditer(text):\n            declared.setdefault(m.group(1).split(\".\")[-1], []).append(p)\n        for m in FIELD.finditer(text):\n            declared.setdefault(m.group(1), []).append(p)\n    missing = []\n    for name in sorted(cited()):\n        last = name.split(\".\")[-1]\n        prefix = name.split(\".\")[0] if \".\" in name else None\n        hits = declared.get(last, [])\n        if prefix:\n            hits = [p for p in hits if prefix in files[p]]\n        print(f\"{'ok ' if hits else 'MISSING'} {name}\"\n              + (f\"  ({hits[0].relative_to(LEAN)})\" if hits else \"\"))\n        if not hits:\n            missing.append(name)\n    print(f\"{len(cited())} names cited, {len(missing)} not found\")\n    return 1 if missing else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n----\n12:def test_every_cited_lean_name_is_declared():\n17:def test_every_doi_is_in_the_checked_cache():\n26:def test_every_citation_key_is_in_the_bibliography():\n35:def test_cost_table_reproduces_the_recorded_ratios():\n42:def test_certificates_table_reproduces_the_recorded_totals():\n48:def test_every_cited_theorem_has_an_axiom_line():\n83:def test_phase_diagram_csv_matches_its_sources():\n131:def test_excess_table_comes_from_the_csv():","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01V2cSQFMbodCnx3y6eGJboJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
