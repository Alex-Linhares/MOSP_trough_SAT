 by","+  simp only [closedIndices, mem_sigma, mem_filter, mem_univ, true_and, mem_powerset]","+","+/-- The graphs on `V` for which `(A, R)` is a closed pair. -/","+noncomputable def closedPairGraphs (A R : Finset V) : Finset (SimpleGraph V) := by","+  classical exact univ.filter (fun G => IsClosedPair G A R)","+","+open scoped Classical in","+theorem mem_closedPairGraphs {A R : Finset V} {G : SimpleGraph V} :","+    G ∈ closedPairGraphs A R ↔ IsClosedPair G A R := by","+  simp [closedPairGraphs]","+","+open scoped Classical in","+/-- **The union bound of Theorem Cl.** `P(pathwidth ≤ k) ≤ Σ_{(A, R) : |A| ≥ t, |R| ≥ r} P((A, R) is closed)`,","+the sum over the ordered disjoint pairs of at least the forced sizes. The independence step —","+that the inner sum is `(1 − p)^(|A||R|) ((1 − (1 − p)^|A|)(1 − (1 − p)^|R|))^|S|` — is on paper","+(`reports/separator_moment.md` §8.2). -/","+theorem weightedSum_graphsOfPathwidthLe_le_sum_closedPairs (p : ℝ) (hp0 : 0 ≤ p) (hp1 : p ≤ 1)","+    (k : ℕ) (hk : k < Fintype.card V) :","+    ∑ G ∈ graphsOfPathwidthLe (V := V) k, gnpWeight p G ≤","+      ∑ q ∈ closedIndices (V := V) ((Fintype.card V - k + 1) / 2) ((Fintype.card V - k) / 2),","+        ∑ G ∈ closedPairGraphs q.1 q.2, gnpWeight p G := by","+  set t := (Fintype.card V - k + 1) / 2","+  set r := (Fintype.card V - k) / 2","+  calc ∑ G ∈ graphsOfPathwidthLe (V := V) k, gnpWeight p G","+      ≤ ∑ G ∈ (closedIndices (V := V) t r).biUnion (fun q => closedPairGraphs q.1 q.2),","+          gnpWeight p G := by","+        refine sum_le_sum_of_subset_of_nonneg (fun G hG => ?_)","+          (fun G _ _ => gnpWeight_nonneg hp0 hp1 G)","+        obtain ⟨A, R, hcl, _, hA, hR, _⟩ :=","+          exists_closedPair_of_pathwidth_le G k (mem_graphsOfPathwidthLe.1 hG) hk","+        refine mem_biUnion.2 ⟨⟨A, R⟩, mem_closedIndices.2 ⟨hA, ?_, hR⟩, mem_closedPairGraphs.2 hcl⟩","+        intro x hx","+        rw [mem_sdiff]","+        exact ⟨mem_univ x, fun hxA =>","+          Finset.disjoint_left.1 hcl.disjoint_and_isEmptyPair.1 hxA hx⟩","+    _ ≤ _ := sum_biUnion_le_sum_of_nonneg _ _ _ (gnpWeight_nonneg hp0 hp1)","+","+end ClosedUnion","+","+/-! ### Lemma Fl: the flips of an empty pair -/","+","+section Flips","+","+variable (G : SimpleGraph V) [DecidableRel G.Adj]","+","+/-- The vertices of `A` with no neighbour in `A`: isolated in `G[A]`. -/","+def isolatedIn (A : Finset V) : Finset V := A.filter (fun v => ∀ a ∈ A, ¬ G.Adj v a)","+","+theorem isolatedIn_subset (A : Finset V) : isolatedIn G A ⊆ A := filter_subset _ _","+","+theorem not_adj_of_mem_isolatedIn {A : Finset V} {v a : V} (hv : v ∈ isolatedIn G A)","+    (ha : a ∈ A) : ¬ G.Adj v a :=","+  (mem_filter.1 hv).2 a ha","+","+/-- The flip of `(A, R)` along `J ⊆ I_A`, `J' ⊆ I_R`: `((A ∖ J) ∪ J', (R ∖ J') ∪ J)`. -/","+def flipPair (A R J J' : Finset V) : Σ _ : Finset V, Finset V :=","+  ⟨(A \\ J) ∪ J', (R \\ J') ∪ J⟩","+","+/-- **Lemma Fl, emptiness**: the flipped pair is empty (four cases). -/","+theorem flipPair_isEmptyPair {A R J J' : Finset V} (he : IsEmptyPair G A R)","+    (hJ : J ⊆ isolatedIn G A) (hJ' : J' ⊆ isolatedIn G R) :","+    IsEmptyPair G ((A \\ J) ∪ J') ((R \\ J') ∪ J) := by","+  intro x hx y hy hadj","+  rcases mem_union.1 hx with hx | hx <;> rcases mem_union.1 hy with hy | hy","+  · exact he x (mem_sdiff.1 hx).1 y (mem_sdiff.1 hy).1 hadj","+  · exact not_adj_of_mem_isolatedIn G (hJ hy) (mem_sdiff.1 hx).1 (G.adj_symm hadj)","+  · exact not_adj_of_mem_isolatedIn G (hJ' hx) (mem_sdiff.1 hy).1 hadj","+  · exact he y (isolatedIn_subset G A (hJ hy)) x (isolatedIn_subset G R (hJ' hx)) (G.adj_symm hadj)","+","+/-- **Lemma Fl, disjointness**: the flipped sides are disjoint. -/","+theorem flipPair_disjoint {A R J J' : Finset V} (hAR : Disjoint A R)","+    (hJ : J ⊆ isolatedIn G A) (hJ' : J' ⊆ isolatedIn G R) :","+    Disjoint ((A \\ J) ∪ J') ((R \\ J') ∪ J) := by","+  have hJA : J ⊆ A := hJ.trans (isolatedIn_subset G A)","+  have hJ'R : J' ⊆ R := hJ'.trans (isolatedIn_subset G R)","+  rw [Finset.disjoint_left]","+  intro x hx hy","+  rcases mem_union.1 hx with hx | hx <;> rcases mem_union.1 hy with hy | hy","+  · exact Finset.disjoint_left.1 hAR (mem_sdiff.1 hx).1 (mem_sdiff.1 hy).1","+  · exact (mem_sdiff.1 hx).2 hy","+  · exact (mem_sdiff.1 hy).2 hx","+  · exact Finset.disjoint_left.1 hAR (hJA hy) (hJ'R hx)","+","+/-- **Lemma Fl, sizes**: the flipped sides have the sizes of the original ones. -/","+theorem card_flipPair {A R J J' : Finset V} (hAR : Disjoint A R)","+    (hJ : J ⊆ isolatedIn G A) (hJ' : J' ⊆ isolatedIn G R) (hcard : J.card = J'.card) :","+    ((A \\ J) ∪ J').card = A.card ∧ ((R \\ J') ∪ J).card = R.card := by","+  have hJA : J ⊆ A := hJ.trans (isolatedIn_subset G A)","+  have hJ'R : J' ⊆ R := hJ'.trans (isolatedIn_subset G R)","+  have h1 : Disjoint (A \\ J) J' :=","+    Finset.disjoint_of_subset_left sdiff_subset (Finset.disjoint_of_subset_right hJ'R hAR)","+  have h2 : Disjoint (R \\ J') J :=","+    Finset.disjoint_of_subset_left sdiff_subset (Finset.disjoint_of_subset_right hJA hAR.symm)","+  rw [card_union_of_disjoint h1, card_union_of_disjoint h2, card_sdiff_of_subset hJA,","+    card_sdiff_of_subset hJ'R]","+  have := card_le_card hJA","+  have := card_le_card hJ'R","+  omega","+","+/-- **Lemma Fl, injectivity**: `(J, J')` is recovered from the flipped pair as","+`(R* ∩ A, A* ∩ R)`. -/","+theorem flipPair_injOn {A R : Finset V} (hAR : Disjoint A R) :","+    Set.InjOn (fun JJ : Finset V × Finset V => flipPair A R JJ.1 JJ.2)","+      ((isolatedIn G A).powerset ×ˢ (isolatedIn G R).powerset : Finset (Finset V × Finset V)) := by","+  have key : ∀ J J' : Finset V, J ⊆ isolatedIn G A → J' ⊆ isolatedIn G R →","+      ((R \\ J') ∪ J) ∩ A = J ∧ ((A \\ J) ∪ J') ∩ R = J' := by","+    intro J J' hJ hJ'","+    have hJA : J ⊆ A := hJ.trans (isolatedIn_subset G A)","+    have hJ'R : J' ⊆ R := hJ'.trans (isolatedIn_subset G R)","+    constructor","+    · rw [union_inter_distrib_right, inter_eq_left.2 hJA]","+      have : (R \\ J') ∩ A = ∅ := by","+        rw [← Finset.disjoint_iff_inter_eq_empty]","+        exact Finset.disjoint_of_subset_left sdiff_subset hAR.symm","+      rw [this, empty_union]","+    · rw [union_inter_distrib_right, inter_eq_left.2 hJ'R]","+      have : (A \\ J) ∩ R = ∅ := by","+        rw [← Finset.disjoint_iff_inter_eq_empty]","+        exact Finset.disjoint_of_subset_left sdiff_subset hAR","+      rw [this, empty_union]","+  rintro ⟨J₁, J₁'⟩ h₁ ⟨J₂, J₂'⟩ h₂ heq","+  simp only [coe_product, Set.mem_prod, mem_coe, mem_powerset] at h₁ h₂","+  simp only [flipPair, Sigma.mk.injEq, heq_eq_eq] at heq","+  obtain ⟨hA₁, hR₁⟩ := key J₁ J₁' h₁.1 h₁.2","+  obtain ⟨hA₂, hR₂⟩ := key J₂ J₂' h₂.1 h₂.2","+  rw [Prod.mk.injEq]","+  constructor","+  · rw [← hA₁, ← hA₂, heq.2]","+  · rw [← hR₁, ← hR₂, heq.1]","+","+/-- The flips of `(A, R)`: the pairs reached by exchanging equally many isolated vertices. -/","+def flips (A R : Finset V) : Finset (Σ _ : Finset V, Finset V) :=","+  (((isolatedIn G A).powerset ×ˢ (isolatedIn G R).powerset).filter","+    (fun JJ => JJ.1.card = JJ.2.card)).image (fun JJ => flipPair A R JJ.1 JJ.2)","+","+/-- `(A, R)` is its own flip along `(∅, ∅)`. -/","+theorem one_le_card_flips (A R : Finset V) : 1 ≤ (flips G A R).card := by","+  refine card_pos.2 ⟨⟨A, R⟩, mem_image.2 ⟨(∅, ∅), ?_, ?_⟩⟩","+  · simp","+  · simp [flipPair]","+","+/-- **Lemma Fl, admissibility**: every flip of an empty pair of `pairIndices t r` is an","+empty pair of `pairIndices t r`, and the flips are distinct, so their number is at most the","+number of empty pairs. -/","+theorem card_flips_le {t r : ℕ} {A R : Finset V} (hq : (⟨A, R⟩ : Σ _ : Finset V, Finset V) ∈ pairIndices t r)","+    (he : IsEmptyPair G A R) :","+    (flips G A R).card ≤","+      ((pairIndices (V := V) t r).filter (fun q => IsEmptyPair G q.1 q.2)).card := by","+  obtain ⟨hA, hRA, hR⟩ := mem_pairIndices.1 hq","+  have hAR : Disjoint A R := by","+    rw [Finset.disjoint_left]","+    exact fun x hx hxR => (mem_sdiff.1 (hRA hxR)).2 hx","+  unfold flips","+  rw [card_image_of_injOn ((flipPair_injOn G hAR).mono (coe_subset.2 (filter_subset _ _)))]","+  refine card_le_card_of_injOn (fun JJ => flipPair A R JJ.1 JJ.2) ?_","+    ((flipPair_injOn G hAR).mono (coe_subset.2 (filter_subset _ _)))","+  intro JJ hJJ","+  simp only [coe_filter, coe_product, Set.mem_setOf_eq, Set.mem_prod, mem_coe,","+    mem_powerset] at hJJ","+  obtain ⟨⟨hJ, hJ'⟩, hcard⟩ := hJJ","+  obtain ⟨h1, h2⟩ := card_flipPair G hAR hJ hJ' hcard","+  rw [mem_coe, mem_filter, mem_pairIndices]","+  refine ⟨⟨by rw [flipPair]; simpa using h1 ▸ hA, ?_, by rw [flipPair]; simpa using h2 ▸ hR⟩,","+    flipPair_isEmptyPair G he hJ hJ'⟩","+  intro x hx","+  rw [mem_sdiff]","+  exact ⟨mem_univ x, fun hxA => Finset.disjoint_left.1 (flipPair_disjoint G hAR hJ hJ') hxA hx⟩","+","+end Flips","+","+/-! ### L1′ d: `3K₂` is in `E_relax` and not in `E_bip` at `k = 0` -/","+","+section ThreeK2","+","+/-- Three disjoint edges on six vertices: `03`, `14`, `25`. -/","+def threeK2 : SimpleGraph (Fin 6) :=","+  SimpleGraph.fromEdgeSet {s(0, 3), s(1, 4), s(2, 5)}","+","+/-- The partner of a vertex of `3K₂`. -/","+def threeK2Partner (i : Fin 6) : Fin 6 := if i.val < 3 then i + 3 else i - 3","+","+theorem threeK2_adj_iff (u v : Fin 6) : threeK2.Adj u v ↔ v = threeK2Partner u := by","+  revert u v; decide","+","+/-- **L1′ d, the bipartition half**: with `k = 0` and `S = ∅`, `3K₂` has no empty pair with","+sides of sizes `3` and `3` (no sub-family of the component sizes `2, 2, 2` sums to `3`). -/","+theorem not_isBalancedBip_threeK2 : ¬ IsBalancedBip threeK2 ∅ 0 := by","+  decide","+","+/-- A walk of `3K₂` from `u` stays in `{u, partner u}`. -/","+theorem threeK2_walk_support {u v : Fin 6} (p : threeK2.Walk u v) :","+    v = u ∨ v = threeK2Partner u := by","+  induction p with","+  | nil => exact Or.inl rfl","+  | @cons x y z hxy q ih =>","+    rw [threeK2_adj_iff] at hxy","+    have hpp : threeK2Partner (threeK2Partner x) = x := by revert x; decide","+    rcases ih with rfl | rfl","+    · exact Or.inr hxy","+    · rw [hxy, hpp]; exact Or.inl rfl","+","+/-- **L1′ d, the relaxed half**: every component of `3K₂ − ∅` has at most `2 ≤ 3 = t`","+vertices. -/","+theorem card_componentOff_threeK2_le (v : Fin 6) :","+    (componentOff threeK2 ∅ v).card ≤ (Fintype.card (Fin 6) - 0 + 1) / 2 := by","+  have hsub : componentOff threeK2 ∅ v ⊆ {v, threeK2Partner v} := by","+    intro w hw","+    classical","+    obtain ⟨p, _⟩ := (mem_filter.1 hw).2","+    rcases threeK2_walk_support p with rfl | rfl","+    · exact mem_insert_self _ _","+    · exact mem_insert_of_mem (mem_singleton_self _)","+  calc (componentOff threeK2 ∅ v).card ≤ ({v, threeK2Partner v} : Finset (Fin 6)).card :=","+        card_le_card hsub","+    _ ≤ 2 := card_le_two","+    _ ≤ (Fintype.card (Fin 6) - 0 + 1) / 2 := by simp","+","+end ThreeK2","+"," end MOSPFormalization"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/lean/MOSPFormalization/SeparatorMoment.lean"]}},"tool_result_meta":[{"id":"toolu_017i5DbP5hDAH7rNTVoG4PJn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
