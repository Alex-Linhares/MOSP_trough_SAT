0934729,241,9,8,9,3,3,3,1,0,0,0,0,0,8,8,8,0.002,\r","+cover,f_n28_d6_star+0.1,28,6,star+0.1,0.6132,17,0.6071,11,6,5,1,1782849887,254,7,6,7,1,1,1,7,0,0,6,6,6,0,0,0,0.001,\r","+cover,f_n28_d6_star+0.1,28,6,star+0.1,0.6132,17,0.6071,11,6,5,2,1934455013,238,53,52,41,15,15,8,24,0,0,5,17,26,35,26,35,0.003,\r","+gnp,g_n32_c6_star,32,6,star,0.1706,5,0.1562,27,14,13,0,2011920344,64,83,82,30,18,18,5,59,0,0,55,61,61,21,21,21,2.022,\r","+gnp,g_n32_c6_star,32,6,star,0.1706,5,0.1562,27,14,13,2,434444020,66,79,78,32,27,27,7,47,0,0,28,47,47,31,31,31,2.204,\r","+gnp,g_n32_c6_star+0.1,32,6,star+0.1,0.2706,9,0.2812,23,12,11,2,1308193866,65,14123,14122,7084,2115,2115,878,13081,0,0,43,254,851,13868,5614,13868,4.546,\r","+gnp,g_n32_c6_star+0.1,32,6,star+0.1,0.2706,9,0.2812,23,12,11,1,1425024496,65,174722,174721,77982,4142,4142,967,173605,0,0,48,1909,7475,172812,97441,172812,11.649,\r","+gnp,g_n32_c6_star,32,6,star,0.1706,5,0.1562,27,14,13,1,15484750,45,584,583,97,466,466,122,158,0,0,37,177,221,406,211,406,14.784,\r"]}],"created":true},{"filePath":"/home/al/dev/MOSP/Ralph_Loops/loop0011/session_it04.jsonl","hunks":[{"oldStart":215,"oldLines":3,"newStart":215,"newLines":5,"lines":[" {\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":1550,\"estimated_tokens_delta\":100,\"session_id\":\"c07fd41f-299e-4cab-b619-bc06f0f4c852\",\"uuid\":\"ebe8b73d-b8c6-4394-b40d-949e2cc94d1e\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5-1\",\"id\":\"msg_011CgcVGNYT2e6LCXPKzsd2n\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":1287,\"cache_read_input_tokens\":154528,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1287,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"c07fd41f-299e-4cab-b619-bc06f0f4c852\",\"uuid\":\"15d8f900-aaa5-4207-92c2-f689a459b953\",\"timestamp\":\"2026-11-01T16:01:44.375Z\",\"request_id\":\"req_011CgcVGNBcdphHoub1TbAG4\",\"thinking_duration_ms\":23385,\"thinking_display\":\"updates\"}"," {\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5-1\",\"id\":\"msg_011CgcVGNYT2e6LCXPKzsd2n\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01P71NzTPJ4StibFxusbnxMp\",\"name\":\"Bash\",\"input\":{\"command\":\"mkdir -p reports/scratch/separator_moment/04_planted && cat > reports/scratch/separator_moment/04_planted/run.py <<'EOF'\\n\\\"\\\"\\\"loop0011 item 04: the planted cluster — condition on one exact-size empty pair\\nand count the other exact-size empty pairs, their distance from the planted\\npair and the mechanism (`reports/separator_moment.md` §4).\\n\\n    nice -n 19 python3 reports/scratch/separator_moment/04_planted/run.py --workers 8\\n    (stages: run, stats, draw; `--stage` runs one; `--probe` times the largest cells)\\n\\nPlanting. `G(n, c/n)` with the edges between a fixed `A` (`|A| = t`) and `R`\\n(`|R| = N − t`) deleted — the law of `G(n, c/n)` given `(A, R)` empty — at\\n`n ∈ {16, 20, 24, 28, 32}`, `c ∈ {6, 10}`, `β ∈ {β*(c), β*(c) + 0.1}` rounded\\nto `k = round(β n)`, 200 per cell; and the cover model at `(d, μ) = (6, 1)`,\\n`n ∈ {16, 20, 24, 28}`, `m = n` patterns each a uniform 6-set among those\\nmeeting at most one side. No pathwidth is computed: the planted pair makes\\n`X ≥ 1` by construction. Counting: every exact-size empty pair by item 03's\\nenumerator, `X′ = X − 1`, the overlap table of each with the planted pair, the\\nseparators, closed pairs and move-classes of item 03. The planted mean is\\n`E[X′ | P₀ empty] = E[X²]/E[X] − 1`, exactly at the cell's `(n, t, r)`.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport csv\\nimport math\\nimport os\\nimport sys\\nimport time\\nimport zlib\\nfrom collections import Counter\\nfrom multiprocessing import Pool\\nfrom pathlib import Path\\n\\nimport numpy as np\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parents[4]))\\n\\nfrom learning.first_moment import beta_star, second_moment_rate  # noqa: E402\\nfrom learning.separator_moment import (  # noqa: E402\\n    beta_star_gnp, closed_pairs_pruned, closure_image, enumerate_empty_pairs, forced_sizes, gnp_masks,\\n    hamming_distance, mosp_masks, move_classes, overlap_table, plant_cover, plant_pair, planted_mean_cover,\\n    planted_mean_gnp, popcount, second_moment_rate_gnp, separators_of,\\n)\\n\\nHERE = Path(__file__).resolve().parent\\n\\nGNP_N = [16, 20, 24, 28, 32]\\nGNP_C = [6, 10]\\nCOVER_N = [16, 20, 24, 28]\\nCOVER_D = 6\\nPER_CELL = 200\\nBETAS = {\\\"star\\\": 0.0, \\\"star+0.1\\\": 0.1}\\nEPS = (0.05, 0.1, 0.2, 0.3)\\nFAR = 0.2                     # a pair is \\\"far\\\" when its Hamming distance from the planted pair exceeds FAR·n\\nMAX_PAIRS = 2_000_000         # above this the row is censored (X′ > cap)\\nMAX_X4_PAIRS = 300_000        # above this the move-classes are skipped\\nMAX_SETS = 3_000_000          # the pruned family for X₃\\nMECH_SAMPLE = 200_000         # far pairs examined for the mechanism, at most (sampled beyond)\\n\\nFIELDS = [\\\"source\\\", \\\"cell\\\", \\\"n\\\", \\\"c\\\", \\\"beta_label\\\", \\\"beta_nominal\\\", \\\"k\\\", \\\"beta\\\", \\\"N\\\", \\\"t\\\", \\\"r\\\", \\\"sample\\\", \\\"seed\\\",\\n          \\\"edges\\\", \\\"X\\\", \\\"Xp\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\", \\\"class_planted\\\", \\\"has_reverse\\\",\\n          *[f\\\"within_{e}\\\" for e in EPS], \\\"far\\\", \\\"far_reversed\\\", \\\"mech_pairs\\\", \\\"seconds\\\", \\\"note\\\"]\\n\\n\\ndef seed_of(src: str, n: int, c: int, beta_label: str, i: int) -> int:\\n    return zlib.crc32(f\\\"sep04:{src}:{n}:{c}:{beta_label}:{i}\\\".encode()) & 0x7FFFFFFF\\n\\n\\ndef cells() -> list[dict]:\\n    out = []\\n    for n in GNP_N:\\n        for c in GNP_C:\\n            bs = beta_star_gnp(c)\\n            for lab, off in BETAS.items():\\n                k = int(round((bs + off) * n))\\n                out.append(dict(source=\\\"gnp\\\", cell=f\\\"g_n{n}_c{c}_{lab}\\\", n=n, c=c, beta_label=lab,\\n                                beta_nominal=round(bs + off, 4), k=k))\\n    bs = beta_star(1.0, {COVER_D: 1})\\n    for n in COVER_N:\\n        for lab, off in BETAS.items():\\n            k = int(round((bs + off) * n))\\n            out.append(dict(source=\\\"cover\\\", cell=f\\\"f_n{n}_d{COVER_D}_{lab}\\\", n=n, c=COVER_D, beta_label=lab,\\n                            beta_nominal=round(bs + off, 4), k=k))\\n    return out\\n\\n\\ndef planted_instance(cell: dict, i: int):\\n    \\\"\\\"\\\"The planted graph (adjacency masks), the planted pair and the seed.\\\"\\\"\\\"\\n    n, k = cell[\\\"n\\\"], cell[\\\"k\\\"]\\n    N, t = forced_sizes(n, k)\\n    r = N - t\\n    A = (1 << t) - 1\\n    R = ((1 << r) - 1) << t\\n    seed = seed_of(cell[\\\"source\\\"], n, cell[\\\"c\\\"], cell[\\\"beta_label\\\"], i)\\n    if cell[\\\"source\\\"] == \\\"gnp\\\":\\n        adj = plant_pair(gnp_masks(n, cell[\\\"c\\\"] / n, seed), A, R)\\n    else:\\n        M = plant_cover(n, n, COVER_D, A, R, np.random.default_rng(seed))\\n        adj = mosp_masks(M)\\n    return adj, (A, R), seed\\n\\n\\ndef planted_one(job):\\n    cell, i = job\\n    n, k = cell[\\\"n\\\"], cell[\\\"k\\\"]\\n    N, t = forced_sizes(n, k)\\n    r = N - t\\n    t0 = time.monotonic()\\n    adj, P0, seed = planted_instance(cell, i)\\n    A, R = P0\\n    full = (1 << n) - 1\\n    S = full & ~(A | R)\\n    row = dict(source=cell[\\\"source\\\"], cell=cell[\\\"cell\\\"], n=n, c=cell[\\\"c\\\"], beta_label=cell[\\\"beta_label\\\"],\\n               beta_nominal=cell[\\\"beta_nominal\\\"], k=k, beta=round(k / n, 4), N=N, t=t, r=r, sample=i, seed=seed,\\n               edges=sum(popcount(a) for a in adj) // 2, note=\\\"\\\")\\n    extras = dict(dist=Counter(), mech=Counter(), base=Counter(), far_table=np.zeros(9, dtype=np.int64),\\n                  near_table=np.zeros(9, dtype=np.int64))\\n    # the degree law of S vertices into each side, once per instance\\n    sv = [v for v in range(n) if S >> v & 1]\\n    for s in sv:\\n        extras[\\\"base\\\"][(\\\"S->A_opp\\\", popcount(adj[s] & R))] += 1   # opposite side when joining A is R\\n        extras[\\\"base\\\"][(\\\"S->R_opp\\\", popcount(adj[s] & A))] += 1\\n    try:\\n        pairs = enumerate_empty_pairs(adj, k, MAX_PAIRS)\\n    except OverflowError:\\n        row.update(X=f\\\">{MAX_PAIRS}\\\", Xp=f\\\">{MAX_PAIRS - 1}\\\", note=\\\"censored: pairs > cap\\\", seconds=round(time.monotonic() - t0, 3))\\n        return row, extras\\n    assert P0 in pairs, \\\"the planted pair is not an exact-size empty pair\\\"\\n    X = len(pairs)\\n    row[\\\"X\\\"], row[\\\"Xp\\\"] = X, X - 1\\n    row[\\\"X2\\\"] = len(separators_of(pairs, n))\\n    try:\\n        row[\\\"X3\\\"] = len(closed_pairs_pruned(adj, k, MAX_SETS))\\n    except OverflowError:\\n        row[\\\"X3\\\"] = \\\"\\\"\\n        row[\\\"note\\\"] += \\\"X3 skipped; \\\"\\n    row[\\\"X3p\\\"] = len(closure_image(adj, pairs))\\n    row[\\\"has_reverse\\\"] = int((R, A) in set(pairs))\\n    if X <= MAX_X4_PAIRS:\\n        cls = move_classes(pairs, n)\\n        row[\\\"X4\\\"] = max(cls) + 1\\n        c0 = cls[pairs.index(P0)]\\n        row[\\\"class_planted\\\"] = sum(1 for c in cls if c == c0)\\n    else:\\n        row[\\\"X4\\\"] = row[\\\"class_planted\\\"] = \\\"\\\"\\n        row[\\\"note\\\"] += \\\"X4 skipped; \\\"\\n    within = [0] * len(EPS)\\n    far = far_rev = 0\\n    far_list = []\\n    for Q in pairs:\\n        if Q == P0:\\n            continue\\n        T = overlap_table(P0, Q, n)\\n        d = n - T[0] - T[4] - T[8]\\n        extras[\\\"dist\\\"][d] += 1\\n        for j, e in enumerate(EPS):\\n            if d <= e * n:\\n                within[j] += 1\\n        if d > FAR * n:\\n            far += 1\\n            far_rev += T[3] >= T[0]\\n            far_list.append((Q, T))\\n        else:\\n            extras[\\\"near_table\\\"] += np.array(T)\\n    for j, e in enumerate(EPS):\\n        row[f\\\"within_{e}\\\"] = within[j]\\n    row[\\\"far\\\"], row[\\\"far_reversed\\\"] = far, far_rev\\n    # the mechanism on far pairs: which S vertices joined a side, and their degree into the opposite side\\n    if len(far_list) > MECH_SAMPLE:\\n        rng = np.random.default_rng(seed)\\n        idx = rng.choice(len(far_list), MECH_SAMPLE, replace=False)\\n        far_list = [far_list[j] for j in idx]\\n        row[\\\"note\\\"] += \\\"mechanism sampled; \\\"\\n    row[\\\"mech_pairs\\\"] = len(far_list)\\n    for Q, T in far_list:\\n        extras[\\\"far_table\\\"] += np.array(T)\\n        A2, R2 = Q\\n        for s in sv:\\n            if A2 >> s & 1:\\n                extras[\\\"mech\\\"][(\\\"S->A_opp\\\", popcount(adj[s] & R))] += 1\\n            elif R2 >> s & 1:\\n                extras[\\\"mech\\\"][(\\\"S->R_opp\\\", popcount(adj[s] & A))] += 1\\n    row[\\\"seconds\\\"] = round(time.monotonic() - t0, 3)\\n    return row, extras\\n\\n\\ndef stage_run(workers: int, per_cell: int, probe: bool = False) -> None:\\n    cs = cells()\\n    if probe:\\n        cs = [c for c in cs if c[\\\"n\\\"] == max(GNP_N) or (c[\\\"source\\\"] == \\\"cover\\\" and c[\\\"n\\\"] == max(COVER_N))]\\n        per_cell = 3\\n    jobs = [(c, i) for c in cs for i in range(per_cell)]\\n    jobs.sort(key=lambda j: (-j[0][\\\"n\\\"], j[0][\\\"beta_label\\\"]))   # hardest first\\n    dist = {}\\n    mech = {}\\n    base = {}\\n    tables = {}\\n    out = HERE / (\\\"probe.csv\\\" if probe else \\\"planted.csv\\\")\\n    t0 = time.monotonic()\\n    done = 0\\n    with out.open(\\\"w\\\", newline=\\\"\\\") as f, Pool(workers) as pool:\\n        w = csv.DictWriter(f, FIELDS)\\n        w.writeheader()\\n        for row, ex in pool.imap_unordered(planted_one, jobs, chunksize=1):\\n            w.writerow(row)\\n            key = row[\\\"cell\\\"]\\n            dist.setdefault(key, Counter()).update(ex[\\\"dist\\\"])\\n            mech.setdefault(key, Counter()).update(ex[\\\"mech\\\"])\\n            base.setdefault(key, Counter()).update(ex[\\\"base\\\"])\\n            tb = tables.setdefault(key, {\\\"far\\\": np.zeros(9, dtype=np.int64), \\\"near\\\": np.zeros(9, dtype=np.int64)})\\n            tb[\\\"far\\\"] += ex[\\\"far_table\\\"]\\n            tb[\\\"near\\\"] += ex[\\\"near_table\\\"]\\n            done += 1\\n            if done % 100 == 0 or probe:\\n                f.flush()\\n                print(f\\\"{done}/{len(jobs)} in {time.monotonic() - t0:.0f} s: {key} #{row['sample']} X'={row['Xp']} \\\"\\n                      f\\\"{row['seconds']} s {row['note']}\\\", flush=True)\\n    if probe:\\n        return\\n    with (HERE / \\\"distance_hist.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.writer(f)\\n        w.writerow([\\\"cell\\\", \\\"distance\\\", \\\"pairs\\\"])\\n        for key in sorted(dist):\\n            for d in sorted(dist[key]):\\n                w.writerow([key, d, dist[key][d]])\\n    with (HERE / \\\"mechanism.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.writer(f)\\n        w.writerow([\\\"cell\\\", \\\"population\\\", \\\"move\\\", \\\"degree_opposite_side\\\", \\\"count\\\"])\\n        for key in sorted(mech):\\n            for (mv, dg), cnt in sorted(mech[key].items()):\\n                w.writerow([key, \\\"moved_in_far_pairs\\\", mv, dg, cnt])\\n            for (mv, dg), cnt in sorted(base[key].items()):\\n                w.writerow([key, \\\"all_S_vertices\\\", mv, dg, cnt])\\n    cols = [\\\"AA\\\", \\\"AR\\\", \\\"AS\\\", \\\"RA\\\", \\\"RR\\\", \\\"RS\\\", \\\"SA\\\", \\\"SR\\\", \\\"SS\\\"]\\n    with (HERE / \\\"overlap_far_near.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.writer(f)\\n        w.writerow([\\\"cell\\\", \\\"which\\\", *[f\\\"sum_{c}\\\" for c in cols]])\\n        for key in sorted(tables):\\n            for which in (\\\"far\\\", \\\"near\\\"):\\n                w.writerow([key, which, *tables[key][which].tolist()])\\n    print(f\\\"run: {done} instances in {time.monotonic() - t0:.0f} s\\\")\\n\\n\\ndef ols(x, y):\\n    x = np.asarray(x, float)\\n    y = np.asarray(y, float)\\n    xm = x - x.mean()\\n    slope = float((xm * (y - y.mean())).sum() / (xm ** 2).sum())\\n    resid = y - y.mean() - slope * xm\\n    dof = max(len(x) - 2, 1)\\n    se = math.sqrt(float((resid ** 2).sum() / dof / (xm ** 2).sum()))\\n    return slope, se\\n\\n\\ndef stage_stats() -> None:\\n    import pandas as pd\\n    df = pd.read_csv(HERE / \\\"planted.csv\\\")\\n    df[\\\"censored\\\"] = df[\\\"Xp\\\"].astype(str).str.startswith(\\\">\\\")\\n    for col in (\\\"X\\\", \\\"Xp\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\", \\\"class_planted\\\"):\\n        df[col] = pd.to_numeric(df[col], errors=\\\"coerce\\\")\\n    rows = []\\n    for key, g in df.groupby(\\\"cell\\\", sort=False):\\n        c0 = g.iloc[0]\\n        n, k, t, r = int(c0[\\\"n\\\"]), int(c0[\\\"k\\\"]), int(c0[\\\"t\\\"]), int(c0[\\\"r\\\"])\\n        src, c = c0[\\\"source\\\"], int(c0[\\\"c\\\"])\\n        a = (1 - k / n) / 2\\n        if src == \\\"gnp\\\":\\n            pred = planted_mean_gnp(n, t, r, c / n)\\n            sup, twog, _ = second_moment_rate_gnp(a, c)\\n        else:\\n            pred = planted_mean_cover(n, t, r, {COVER_D: n})\\n            sup, twog, _ = second_moment_rate(a, 1.0, {COVER_D: 1})\\n        xp = g[\\\"Xp\\\"]\\n        cen = int(g[\\\"censored\\\"].sum())\\n        ok = g[~g[\\\"censored\\\"]]\\n        med = float(xp.median()) if cen < len(g) / 2 else math.nan\\n        pos = ok[ok[\\\"Xp\\\"] > 0]\\n        tot_pairs = float(ok[\\\"Xp\\\"].sum())\\n        row = dict(source=src, cell=key, n=n, c=c, beta_label=c0[\\\"beta_label\\\"], k=k, beta=round(k / n, 4),\\n                   a=round(a, 4), N=n - k, t=t, r=r, instances=len(g), censored=cen,\\n                   share_zero=round(float((ok[\\\"Xp\\\"] == 0).mean()), 4),\\n                   Xp_median=med, Xp_p10=float(xp.quantile(0.1)), Xp_p90=float(xp.quantile(0.9)),\\n                   Xp_max=float(ok[\\\"Xp\\\"].max()),\\n                   Xp_gm_pos=round(float(np.exp(np.log(pos[\\\"Xp\\\"]).mean())), 2) if len(pos) else math.nan,\\n                   Xp_mean=round(float(ok[\\\"Xp\\\"].mean()), 2),\\n                   Xp_mean_se=round(float(ok[\\\"Xp\\\"].std(ddof=1) / math.sqrt(len(ok))), 2),\\n                   Xp_pred=round(pred, 2),\\n                   log_med_over_n=round(math.log(med) / n, 4) if med and med > 0 else (-math.inf if med == 0 else math.nan),\\n                   log_mean_over_n=round(math.log(ok[\\\"Xp\\\"].mean()) / n, 4) if ok[\\\"Xp\\\"].mean() > 0 else math.nan,\\n                   log_pred_over_n=round(math.log(pred) / n, 4),\\n                   asym_pred_exponent=round(sup - twog / 2, 4),\\n                   ratio_X_X2=round(float(np.exp(np.log(ok[\\\"X\\\"] / ok[\\\"X2\\\"]).mean())), 3),\\n                   ratio_X_X3=round(float(np.exp(np.log(ok[\\\"X\\\"] / ok[\\\"X3\\\"]).dropna().mean())), 3),\\n                   ratio_X_X4=round(float(np.exp(np.log(ok[\\\"X\\\"] / ok[\\\"X4\\\"]).dropna().mean())), 3),\\n                   class_planted_median=float(ok[\\\"class_planted\\\"].median()),\\n                   class_planted_max=float(ok[\\\"class_planted\\\"].max()),\\n                   has_reverse_share=round(float(ok[\\\"has_reverse\\\"].mean()), 3))\\n        for e in EPS:\\n            row[f\\\"share_within_{e}\\\"] = round(float(ok[f\\\"within_{e}\\\"].sum() / tot_pairs), 4) if tot_pairs else math.nan\\n        row[\\\"share_far\\\"] = round(float(ok[\\\"far\\\"].sum() / tot_pairs), 4) if tot_pairs else math.nan\\n        fs = float(ok[\\\"far\\\"].sum())\\n        row[\\\"far_reversed_share\\\"] = round(float(ok[\\\"far_reversed\\\"].sum() / fs), 4) if fs else math.nan\\n        row[\\\"seconds_mean\\\"] = round(float(g[\\\"seconds\\\"].mean()), 3)\\n        row[\\\"seconds_max\\\"] = round(float(g[\\\"seconds\\\"].max()), 3)\\n        rows.append(row)\\n    cells_df = pd.DataFrame(rows)\\n    cells_df.to_csv(HERE / \\\"cells.csv\\\", index=False)\\n    # growth in n: the cell medians, and the per-instance log X′ (X′ > 0)\\n    slopes = []\\n    for (src, c, lab), g in cells_df.groupby([\\\"source\\\", \\\"c\\\", \\\"beta_label\\\"]):\\n        g = g.sort_values(\\\"n\\\")\\n        row = dict(source=src, c=c, beta_label=lab, n_min=int(g[\\\"n\\\"].min()), n_max=int(g[\\\"n\\\"].max()))\\n        gm = g[g[\\\"Xp_median\\\"] > 0]\\n        if len(gm) >= 3:\\n            s, se = ols(gm[\\\"n\\\"], np.log(gm[\\\"Xp_median\\\"]))\\n            row[\\\"slope_log_median\\\"], row[\\\"se_log_median\\\"] = round(s, 4), round(se, 4)\\n        s, se = ols(g[\\\"n\\\"], np.log(g[\\\"Xp_pred\\\"]))\\n        row[\\\"slope_log_pred\\\"], row[\\\"se_log_pred\\\"] = round(s, 4), round(se, 4)\\n        s, se = ols(g[\\\"n\\\"], np.log(g[\\\"Xp_mean\\\"]))\\n        row[\\\"slope_log_mean\\\"], row[\\\"se_log_mean\\\"] = round(s, 4), round(se, 4)\\n        inst = df[(df.source == src) & (df.c == c) & (df.beta_label == lab) & (~df.censored) & (df.Xp > 0)]\\n        s, se = ols(inst[\\\"n\\\"], np.log(inst[\\\"Xp\\\"]))\\n        row[\\\"slope_log_Xp_inst\\\"], row[\\\"se_log_Xp_inst\\\"], row[\\\"inst\\\"] = round(s, 4), round(se, 4), len(inst)\\n        last = g.iloc[-1]\\n        row[\\\"largest_n\\\"] = int(last[\\\"n\\\"])\\n        row[\\\"log_med_over_n_at_largest\\\"] = last[\\\"log_med_over_n\\\"]\\n        row[\\\"log_pred_over_n_at_largest\\\"] = last[\\\"log_pred_over_n\\\"]\\n        row[\\\"fork_ratio\\\"] = round(last[\\\"log_med_over_n\\\"] / last[\\\"log_pred_over_n\\\"], 3) if last[\\\"log_pred_over_n\\\"] > 0 and np.isfinite(last[\\\"log_med_over_n\\\"]) else last[\\\"log_med_over_n\\\"]\\n        slopes.append(row)\\n    slopes = pd.DataFrame(slopes)\\n    slopes.to_csv(HERE / \\\"slopes.csv\\\", index=False)\\n    # the mechanism: mean degree into the opposite side of moved S vertices against all S vertices\\n    mech = pd.read_csv(HERE / \\\"mechanism.csv\\\")\\n    mrows = []\\n    for key, g in mech.groupby(\\\"cell\\\", sort=False):\\n        row = dict(cell=key)\\n        for pop in (\\\"moved_in_far_pairs\\\", \\\"all_S_vertices\\\"):\\n            h = g[g.population == pop]\\n            tot = h[\\\"count\\\"].sum()\\n            if tot:\\n                row[f\\\"{pop}_mean_deg_opp\\\"] = round(float((h[\\\"degree_opposite_side\\\"] * h[\\\"count\\\"]).sum() / tot), 3)\\n                row[f\\\"{pop}_share_deg0\\\"] = round(float(h[h.degree_opposite_side == 0][\\\"count\\\"].sum() / tot), 4)\\n                row[f\\\"{pop}_share_deg_le1\\\"] = round(float(h[h.degree_opposite_side <= 1][\\\"count\\\"].sum() / tot), 4)\\n                row[f\\\"{pop}_count\\\"] = int(tot)\\n        mrows.append(row)\\n    mech_df = pd.DataFrame(mrows)\\n    mech_df.to_csv(HERE / \\\"mechanism_summary.csv\\\", index=False)\\n    with (HERE / \\\"run.log\\\").open(\\\"w\\\") as f:\\n        print(cells_df.to_string(), file=f)\\n        print(file=f)\\n        print(slopes.to_string(), file=f)\\n        print(file=f)\\n        print(mech_df.to_string(), file=f)\\n    print(cells_df[[\\\"cell\\\", \\\"instances\\\", \\\"censored\\\", \\\"share_zero\\\", \\\"Xp_median\\\", \\\"Xp_mean\\\", \\\"Xp_mean_se\\\", \\\"Xp_pred\\\",\\n                    \\\"log_med_over_n\\\", \\\"log_mean_over_n\\\", \\\"log_pred_over_n\\\", \\\"share_far\\\", \\\"far_reversed_share\\\"]].to_string())\\n    print(slopes.to_string())\\n    print(mech_df.to_string())\\n\\n\\ndef stage_draw() -> None:\\n    import matplotlib\\n    matplotlib.use(\\\"Agg\\\")\\n    import matplotlib.pyplot as plt\\n    import pandas as pd\\n    hist = pd.read_csv(HERE / \\\"distance_hist.csv\\\")\\n    cells_df = pd.read_csv(HERE / \\\"cells.csv\\\")\\n    picks = [(\\\"g_n32_c6_star\\\", \\\"G(n, 6/n), β*\\\"), (\\\"g_n32_c6_star+0.1\\\", \\\"G(n, 6/n), β* + 0.1\\\"),\\n             (\\\"g_n32_c10_star\\\", \\\"G(n, 10/n), β*\\\"), (\\\"g_n32_c10_star+0.1\\\", \\\"G(n, 10/n), β* + 0.1\\\"),\\n             (\\\"f_n28_d6_star\\\", \\\"cover (6, 1), β*\\\"), (\\\"f_n28_d6_star+0.1\\\", \\\"cover (6, 1), β* + 0.1\\\")]\\n    fig, axes = plt.subplots(2, 3, figsize=(12.5, 6.2), sharey=False)\\n    for ax, (key, label) in zip(axes.flat, picks):\\n        h = hist[hist.cell == key]\\n        n = int(cells_df[cells_df.cell == key][\\\"n\\\"].iloc[0])\\n        tot = h[\\\"pairs\\\"].sum()\\n        ax.bar(h[\\\"distance\\\"] / n, h[\\\"pairs\\\"] / tot, width=0.9 / n, color=\\\"#2a78d6\\\", edgecolor=\\\"#fcfcfb\\\", linewidth=0.6)\\n        ax.axvline(FAR, color=\\\"#eb6834\\\", linewidth=2, label=\\\"far / near\\\")\\n        ax.set_xlabel(f\\\"Hamming distance from the planted pair / n   ({label}, n = {n})\\\", color=\\\"#0b0b0b\\\", fontsize=9)\\n        ax.set_xlim(-0.02, 1.0)\\n        for s in (\\\"top\\\", \\\"right\\\"):\\n            ax.spines[s].set_visible(False)\\n        ax.spines[\\\"left\\\"].set_color(\\\"#c3c2b7\\\")\\n        ax.spines[\\\"bottom\\\"].set_color(\\\"#c3c2b7\\\")\\n        ax.tick_params(colors=\\\"#52514e\\\")\\n        ax.grid(axis=\\\"y\\\", color=\\\"#e6e5e1\\\", linewidth=0.6)\\n        ax.set_axisbelow(True)\\n    axes[0, 0].set_ylabel(\\\"share of the other pairs\\\", color=\\\"#52514e\\\")\\n    axes[1, 0].set_ylabel(\\\"share of the other pairs\\\", color=\\\"#52514e\\\")\\n    axes[0, 0].legend(frameon=False, fontsize=8)\\n    fig.tight_layout()\\n    fig.savefig(HERE / \\\"distance_hist.png\\\", dpi=160)\\n    plt.close(fig)\\n    print(\\\"drawn distance_hist.png\\\")\\n\\n\\ndef main() -> None:\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--workers\\\", type=int, default=8)\\n    ap.add_argument(\\\"--per-cell\\\", type=int, default=PER_CELL)\\n    ap.add_argument(\\\"--stage\\\", choices=[\\\"run\\\", \\\"stats\\\", \\\"draw\\\"], default=None)\\n    ap.add_argument(\\\"--probe\\\", action=\\\"store_true\\\")\\n    a = ap.parse_args()\\n    os.nice(19)\\n    if a.probe:\\n        stage_run(a.workers, a.per_cell, probe=True)\\n        return\\n    stages = [a.stage] if a.stage else [\\\"run\\\", \\\"stats\\\", \\\"draw\\\"]\\n    for s in stages:\\n        t0 = time.monotonic()\\n        {\\\"run\\\": lambda: stage_run(a.workers, a.per_cell), \\\"stats\\\": stage_stats, \\\"draw\\\": stage_draw}[s]()\\n        print(f\\\"stage {s}: {time.monotonic() - t0:.0f} s\\\", flush=True)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\nEOF\\nuptime && cd reports/scratch/separator_moment/04_planted && timeout 900 nice -n 19 python3 run.py --probe --workers 6 2>&1 | tail -30\",\"description\":\"Write the run script and time the largest cells\",\"timeout\":960000},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":1287,\"cache_read_input_tokens\":154528,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1287,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\",\"speed\":\"standard\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"c07fd41f-299e-4cab-b619-bc06f0f4c852\",\"uuid\":\"40ca0d41-ee8a-4021-a05a-d6f798739b94\",\"timestamp\":\"2026-11-01T16:03:08.862Z\",\"request_id\":\"req_011CgcVGNBcdphHoub1TbAG4\",\"wire_tool_inputs\":{\"toolu_01P71NzTPJ4StibFxusbnxMp\":{\"command\":\"cd /home/al/dev/MOSP && mkdir -p reports/scratch/separator_moment/04_planted && cat > reports/scratch/separator_moment/04_planted/run.py <<'EOF'\\n\\\"\\\"\\\"loop0011 item 04: the planted cluster — condition on one exact-size empty pair\\nand count the other exact-size empty pairs, their distance from the planted\\npair and the mechanism (`reports/separator_moment.md` §4).\\n\\n    nice -n 19 python3 reports/scratch/separator_moment/04_planted/run.py --workers 8\\n    (stages: run, stats, draw; `--stage` runs one; `--probe` times the largest cells)\\n\\nPlanting. `G(n, c/n)` with the edges between a fixed `A` (`|A| = t`) and `R`\\n(`|R| = N − t`) deleted — the law of `G(n, c/n)` given `(A, R)` empty — at\\n`n ∈ {16, 20, 24, 28, 32}`, `c ∈ {6, 10}`, `β ∈ {β*(c), β*(c) + 0.1}` rounded\\nto `k = round(β n)`, 200 per cell; and the cover model at `(d, μ) = (6, 1)`,\\n`n ∈ {16, 20, 24, 28}`, `m = n` patterns each a uniform 6-set among those\\nmeeting at most one side. No pathwidth is computed: the planted pair makes\\n`X ≥ 1` by construction. Counting: every exact-size empty pair by item 03's\\nenumerator, `X′ = X − 1`, the overlap table of each with the planted pair, the\\nseparators, closed pairs and move-classes of item 03. The planted mean is\\n`E[X′ | P₀ empty] = E[X²]/E[X] − 1`, exactly at the cell's `(n, t, r)`.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport csv\\nimport math\\nimport os\\nimport sys\\nimport time\\nimport zlib\\nfrom collections import Counter\\nfrom multiprocessing import Pool\\nfrom pathlib import Path\\n\\nimport numpy as np\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parents[4]))\\n\\nfrom learning.first_moment import beta_star, second_moment_rate  # noqa: E402\\nfrom learning.separator_moment import (  # noqa: E402\\n    beta_star_gnp, closed_pairs_pruned, closure_image, enumerate_empty_pairs, forced_sizes, gnp_masks,\\n    hamming_distance, mosp_masks, move_classes, overlap_table, plant_cover, plant_pair, planted_mean_cover,\\n    planted_mean_gnp, popcount, second_moment_rate_gnp, separators_of,\\n)\\n\\nHERE = Path(__file__).resolve().parent\\n\\nGNP_N = [16, 20, 24, 28, 32]\\nGNP_C = [6, 10]\\nCOVER_N = [16, 20, 24, 28]\\nCOVER_D = 6\\nPER_CELL = 200\\nBETAS = {\\\"star\\\": 0.0, \\\"star+0.1\\\": 0.1}\\nEPS = (0.05, 0.1, 0.2, 0.3)\\nFAR = 0.2                     # a pair is \\\"far\\\" when its Hamming distance from the planted pair exceeds FAR·n\\nMAX_PAIRS = 2_000_000         # above this the row is censored (X′ > cap)\\nMAX_X4_PAIRS = 300_000        # above this the move-classes are skipped\\nMAX_SETS = 3_000_000          # the pruned family for X₃\\nMECH_SAMPLE = 200_000         # far pairs examined for the mechanism, at most (sampled beyond)\\n\\nFIELDS = [\\\"source\\\", \\\"cell\\\", \\\"n\\\", \\\"c\\\", \\\"beta_label\\\", \\\"beta_nominal\\\", \\\"k\\\", \\\"beta\\\", \\\"N\\\", \\\"t\\\", \\\"r\\\", \\\"sample\\\", \\\"seed\\\",\\n          \\\"edges\\\", \\\"X\\\", \\\"Xp\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\", \\\"class_planted\\\", \\\"has_reverse\\\",\\n          *[f\\\"within_{e}\\\" for e in EPS], \\\"far\\\", \\\"far_reversed\\\", \\\"mech_pairs\\\", \\\"seconds\\\", \\\"note\\\"]\\n\\n\\ndef seed_of(src: str, n: int, c: int, beta_label: str, i: int) -> int:\\n    return zlib.crc32(f\\\"sep04:{src}:{n}:{c}:{beta_label}:{i}\\\".encode()) & 0x7FFFFFFF\\n\\n\\ndef cells() -> list[dict]:\\n    out = []\\n    for n in GNP_N:\\n        for c in GNP_C:\\n            bs = beta_star_gnp(c)\\n            for lab, off in BETAS.items():\\n                k = int(round((bs + off) * n))\\n                out.append(dict(source=\\\"gnp\\\", cell=f\\\"g_n{n}_c{c}_{lab}\\\", n=n, c=c, beta_label=lab,\\n                                beta_nominal=round(bs + off, 4), k=k))\\n    bs = beta_star(1.0, {COVER_D: 1})\\n    for n in COVER_N:\\n        for lab, off in BETAS.items():\\n            k = int(round((bs + off) * n))\\n            out.append(dict(source=\\\"cover\\\", cell=f\\\"f_n{n}_d{COVER_D}_{lab}\\\", n=n, c=COVER_D, beta_label=lab,\\n                            beta_nominal=round(bs + off, 4), k=k))\\n    return out\\n\\n\\ndef planted_instance(cell: dict, i: int):\\n    \\\"\\\"\\\"The planted graph (adjacency masks), the planted pair and the seed.\\\"\\\"\\\"\\n    n, k = cell[\\\"n\\\"], cell[\\\"k\\\"]\\n    N, t = forced_sizes(n, k)\\n    r = N - t\\n    A = (1 << t) - 1\\n    R = ((1 << r) - 1) << t\\n    seed = seed_of(cell[\\\"source\\\"], n, cell[\\\"c\\\"], cell[\\\"beta_label\\\"], i)\\n    if cell[\\\"source\\\"] == \\\"gnp\\\":\\n        adj = plant_pair(gnp_masks(n, cell[\\\"c\\\"] / n, seed), A, R)\\n    else:\\n        M = plant_cover(n, n, COVER_D, A, R, np.random.default_rng(seed))\\n        adj = mosp_masks(M)\\n    return adj, (A, R), seed\\n\\n\\ndef planted_one(job):\\n    cell, i = job\\n    n, k = cell[\\\"n\\\"], cell[\\\"k\\\"]\\n    N, t = forced_sizes(n, k)\\n    r = N - t\\n    t0 = time.monotonic()\\n    adj, P0, seed = planted_instance(cell, i)\\n    A, R = P0\\n    full = (1 << n) - 1\\n    S = full & ~(A | R)\\n    row = dict(source=cell[\\\"source\\\"], cell=cell[\\\"cell\\\"], n=n, c=cell[\\\"c\\\"], beta_label=cell[\\\"beta_label\\\"],\\n               beta_nominal=cell[\\\"beta_nominal\\\"], k=k, beta=round(k / n, 4), N=N, t=t, r=r, sample=i, seed=seed,\\n               edges=sum(popcount(a) for a in adj) // 2, note=\\\"\\\")\\n    extras = dict(dist=Counter(), mech=Counter(), base=Counter(), far_table=np.zeros(9, dtype=np.int64),\\n                  near_table=np.zeros(9, dtype=np.int64))\\n    # the degree law of S vertices into each side, once per instance\\n    sv = [v for v in range(n) if S >> v & 1]\\n    for s in sv:\\n        extras[\\\"base\\\"][(\\\"S->A_opp\\\", popcount(adj[s] & R))] += 1   # opposite side when joining A is R\\n        extras[\\\"base\\\"][(\\\"S->R_opp\\\", popcount(adj[s] & A))] += 1\\n    try:\\n        pairs = enumerate_empty_pairs(adj, k, MAX_PAIRS)\\n    except OverflowError:\\n        row.update(X=f\\\">{MAX_PAIRS}\\\", Xp=f\\\">{MAX_PAIRS - 1}\\\", note=\\\"censored: pairs > cap\\\", seconds=round(time.monotonic() - t0, 3))\\n        return row, extras\\n    assert P0 in pairs, \\\"the planted pair is not an exact-size empty pair\\\"\\n    X = len(pairs)\\n    row[\\\"X\\\"], row[\\\"Xp\\\"] = X, X - 1\\n    row[\\\"X2\\\"] = len(separators_of(pairs, n))\\n    try:\\n        row[\\\"X3\\\"] = len(closed_pairs_pruned(adj, k, MAX_SETS))\\n    except OverflowError:\\n        row[\\\"X3\\\"] = \\\"\\\"\\n        row[\\\"note\\\"] += \\\"X3 skipped; \\\"\\n    row[\\\"X3p\\\"] = len(closure_image(adj, pairs))\\n    row[\\\"has_reverse\\\"] = int((R, A) in set(pairs))\\n    if X <= MAX_X4_PAIRS:\\n        cls = move_classes(pairs, n)\\n        row[\\\"X4\\\"] = max(cls) + 1\\n        c0 = cls[pairs.index(P0)]\\n        row[\\\"class_planted\\\"] = sum(1 for c in cls if c == c0)\\n    else:\\n        row[\\\"X4\\\"] = row[\\\"class_planted\\\"] = \\\"\\\"\\n        row[\\\"note\\\"] += \\\"X4 skipped; \\\"\\n    within = [0] * len(EPS)\\n    far = far_rev = 0\\n    far_list = []\\n    for Q in pairs:\\n        if Q == P0:\\n            continue\\n        T = overlap_table(P0, Q, n)\\n        d = n - T[0] - T[4] - T[8]\\n        extras[\\\"dist\\\"][d] += 1\\n        for j, e in enumerate(EPS):\\n            if d <= e * n:\\n                within[j] += 1\\n        if d > FAR * n:\\n            far += 1\\n            far_rev += T[3] >= T[0]\\n            far_list.append((Q, T))\\n        else:\\n            extras[\\\"near_table\\\"] += np.array(T)\\n    for j, e in enumerate(EPS):\\n        row[f\\\"within_{e}\\\"] = within[j]\\n    row[\\\"far\\\"], row[\\\"far_reversed\\\"] = far, far_rev\\n    # the mechanism on far pairs: which S vertices joined a side, and their degree into the opposite side\\n    if len(far_list) > MECH_SAMPLE:\\n        rng = np.random.default_rng(seed)\\n        idx = rng.choice(len(far_list), MECH_SAMPLE, replace=False)\\n        far_list = [far_list[j] for j in idx]\\n        row[\\\"note\\\"] += \\\"mechanism sampled; \\\"\\n    row[\\\"mech_pairs\\\"] = len(far_list)\\n    for Q, T in far_list:\\n        extras[\\\"far_table\\\"] += np.array(T)\\n        A2, R2 = Q\\n        for s in sv:\\n            if A2 >> s & 1:\\n                extras[\\\"mech\\\"][(\\\"S->A_opp\\\", popcount(adj[s] & R))] += 1\\n            elif R2 >> s & 1:\\n                extras[\\\"mech\\\"][(\\\"S->R_opp\\\", popcount(adj[s] & A))] += 1\\n    row[\\\"seconds\\\"] = round(time.monotonic() - t0, 3)\\n    return row, extras\\n\\n\\ndef stage_run(workers: int, per_cell: int, probe: bool = False) -> None:\\n    cs = cells()\\n    if probe:\\n        cs = [c for c in cs if c[\\\"n\\\"] == max(GNP_N) or (c[\\\"source\\\"] == \\\"cover\\\" and c[\\\"n\\\"] == max(COVER_N))]\\n        per_cell = 3\\n    jobs = [(c, i) for c in cs for i in range(per_cell)]\\n    jobs.sort(key=lambda j: (-j[0][\\\"n\\\"], j[0][\\\"beta_label\\\"]))   # hardest first\\n    dist = {}\\n    mech = {}\\n    base = {}\\n    tables = {}\\n    out = HERE / (\\\"probe.csv\\\" if probe else \\\"planted.csv\\\")\\n    t0 = time.monotonic()\\n    done = 0\\n    with out.open(\\\"w\\\", newline=\\\"\\\") as f, Pool(workers) as pool:\\n        w = csv.DictWriter(f, FIELDS)\\n        w.writeheader()\\n        for row, ex in pool.imap_unordered(planted_one, jobs, chunksize=1):\\n            w.writerow(row)\\n            key = row[\\\"cell\\\"]\\n            dist.setdefault(key, Counter()).update(ex[\\\"dist\\\"])\\n            mech.setdefault(key, Counter()).update(ex[\\\"mech\\\"])\\n            base.setdefault(key, Counter()).update(ex[\\\"base\\\"])\\n            tb = tables.setdefault(key, {\\\"far\\\": np.zeros(9, dtype=np.int64), \\\"near\\\": np.zeros(9, dtype=np.int64)})\\n            tb[\\\"far\\\"] += ex[\\\"far_table\\\"]\\n            tb[\\\"near\\\"] += ex[\\\"near_table\\\"]\\n            done += 1\\n            if done % 100 == 0 or probe:\\n                f.flush()\\n                print(f\\\"{done}/{len(jobs)} in {time.monotonic() - t0:.0f} s: {key} #{row['sample']} X'={row['Xp']} \\\"\\n                      f\\\"{row['seconds']} s {row['note']}\\\", flush=True)\\n    if probe:\\n        return\\n    with (HERE / \\\"distance_hist.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.writer(f)\\n        w.writerow([\\\"cell\\\", \\\"distance\\\", \\\"pairs\\\"])\\n        for key in sorted(dist):\\n            for d in sorted(dist[key]):\\n                w.writerow([key, d, dist[key][d]])\\n    with (HERE / \\\"mechanism.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.writer(f)\\n        w.writerow([\\\"cell\\\", \\\"population\\\", \\\"move\\\", \\\"degree_opposite_side\\\", \\\"count\\\"])\\n        for key in sorted(mech):\\n            for (mv, dg), cnt in sorted(mech[key].items()):\\n                w.writerow([key, \\\"moved_in_far_pairs\\\", mv, dg, cnt])\\n            for (mv, dg), cnt in sorted(base[key].items()):\\n                w.writerow([key, \\\"all_S_vertices\\\", mv, dg, cnt])\\n    cols = [\\\"AA\\\", \\\"AR\\\", \\\"AS\\\", \\\"RA\\\", \\\"RR\\\", \\\"RS\\\", \\\"SA\\\", \\\"SR\\\", \\\"SS\\\"]\\n    with (HERE / \\\"overlap_far_near.csv\\\").open(\\\"w\\\", newline=\\\"\\\") as f:\\n        w = csv.writer(f)\\n        w.writerow([\\\"cell\\\", \\\"which\\\", *[f\\\"sum_{c}\\\" for c in cols]])\\n        for key in sorted(tables):\\n            for which in (\\\"far\\\", \\\"near\\\"):\\n                w.writerow([key, which, *tables[key][which].tolist()])\\n    print(f\\\"run: {done} instances in {time.monotonic() - t0:.0f} s\\\")\\n\\n\\ndef ols(x, y):\\n    x = np.asarray(x, float)\\n    y = np.asarray(y, float)\\n    xm = x - x.mean()\\n    slope = float((xm * (y - y.mean())).sum() / (xm ** 2).sum())\\n    resid = y - y.mean() - slope * xm\\n    dof = max(len(x) - 2, 1)\\n    se = math.sqrt(float((resid ** 2).sum() / dof / (xm ** 2).sum()))\\n    return slope, se\\n\\n\\ndef stage_stats() -> None:\\n    import pandas as pd\\n    df = pd.read_csv(HERE / \\\"planted.csv\\\")\\n    df[\\\"censored\\\"] = df[\\\"Xp\\\"].astype(str).str.startswith(\\\">\\\")\\n    for col in (\\\"X\\\", \\\"Xp\\\", \\\"X2\\\", \\\"X3\\\", \\\"X3p\\\", \\\"X4\\\", \\\"class_planted\\\"):\\n        df[col] = pd.to_numeric(df[col], errors=\\\"coerce\\\")\\n    rows = []\\n    for key, g in df.groupby(\\\"cell\\\", sort=False):\\n        c0 = g.iloc[0]\\n        n, k, t, r = int(c0[\\\"n\\\"]), int(c0[\\\"k\\\"]), int(c0[\\\"t\\\"]), int(c0[\\\"r\\\"])\\n        src, c = c0[\\\"source\\\"], int(c0[\\\"c\\\"])\\n        a = (1 - k / n) / 2\\n        if src == \\\"gnp\\\":\\n            pred = planted_mean_gnp(n, t, r, c / n)\\n            sup, twog, _ = second_moment_rate_gnp(a, c)\\n        else:\\n            pred = planted_mean_cover(n, t, r, {COVER_D: n})\\n            sup, twog, _ = second_moment_rate(a, 1.0, {COVER_D: 1})\\n        xp = g[\\\"Xp\\\"]\\n        cen = int(g[\\\"censored\\\"].sum())\\n        ok = g[~g[\\\"censored\\\"]]\\n        med = float(xp.median()) if cen < len(g) / 2 else math.nan\\n        pos = ok[ok[\\\"Xp\\\"] > 0]\\n        tot_pairs = float(ok[\\\"Xp\\\"].sum())\\n        row = dict(source=src, cell=key, n=n, c=c, beta_label=c0[\\\"beta_label\\\"], k=k, beta=round(k / n, 4),\\n                   a=round(a, 4), N=n - k, t=t, r=r, instances=len(g), censored=cen,\\n                   share_zero=round(float((ok[\\\"Xp\\\"] == 0).mean()), 4),\\n                   Xp_median=med, Xp_p10=float(xp.quantile(0.1)), Xp_p90=float(xp.quantile(0.9)),\\n                   Xp_max=float(ok[\\\"Xp\\\"].max()),\\n                   Xp_gm_pos=round(float(np.exp(np.log(pos[\\\"Xp\\\"]).mean())), 2) if len(pos) else math.nan,\\n                   Xp_mean=round(float(ok[\\\"Xp\\\"].mean()), 2),\\n                   Xp_mean_se=round(float(ok[\\\"Xp\\\"].std(ddof=1) / math.sqrt(len(ok))), 2),\\n                   Xp_pred=round(pred, 2),\\n                   log_med_over_n=round(math.log(med) / n, 4) if med and med > 0 else (-math.inf if med == 0 else math.nan),\\n                   log_mean_over_n=round(math.log(ok[\\\"Xp\\\"].mean()) / n, 4) if ok[\\\"Xp\\\"].mean() > 0 else math.nan,\\n                   log_pred_over_n=round(math.log(pred) / n, 4),\\n                   asym_pred_exponent=round(sup - twog / 2, 4),\\n                   ratio_X_X2=round(float(np.exp(np.log(ok[\\\"X\\\"] / ok[\\\"X2\\\"]).mean())), 3),\\n                   ratio_X_X3=round(float(np.exp(np.log(ok[\\\"X\\\"] / ok[\\\"X3\\\"]).dropna().mean())), 3),\\n                   ratio_X_X4=round(float(np.exp(np.log(ok[\\\"X\\\"] / ok[\\\"X4\\\"]).dropna().mean())), 3),\\n                   class_planted_median=float(ok[\\\"class_planted\\\"].median()),\\n                   class_planted_max=float(ok[\\\"class_planted\\\"].max()),\\n                   has_reverse_share=round(float(ok[\\\"has_reverse\\\"].mean()), 3))\\n        for e in EPS:\\n            row[f\\\"share_within_{e}\\\"] = round(float(ok[f\\\"within_{e}\\\"].sum() / tot_pairs), 4) if tot_pairs else math.nan\\n        row[\\\"share_far\\\"] = round(float(ok[\\\"far\\\"].sum() / tot_pairs), 4) if tot_pairs else math.nan\\n        fs = float(ok[\\\"far\\\"].sum())\\n        row[\\\"far_reversed_share\\\"] = round(float(ok[\\\"far_reversed\\\"].sum() / fs), 4) if fs else math.nan\\n        row[\\\"seconds_mean\\\"] = round(float(g[\\\"seconds\\\"].mean()), 3)\\n        row[\\\"seconds_max\\\"] = round(float(g[\\\"seconds\\\"].max()), 3)\\n        rows.append(row)\\n    cells_df = pd.DataFrame(rows)\\n    cells_df.to_csv(HERE / \\\"cells.csv\\\", index=False)\\n    # growth in n: the cell medians, and the per-instance log X′ (X′ > 0)\\n    slopes = []\\n    for (src, c, lab), g in cells_df.groupby([\\\"source\\\", \\\"c\\\", \\\"beta_label\\\"]):\\n        g = g.sort_values(\\\"n\\\")\\n        row = dict(source=src, c=c, beta_label=lab, n_min=int(g[\\\"n\\\"].min()), n_max=int(g[\\\"n\\\"].max()))\\n        gm = g[g[\\\"Xp_median\\\"] > 0]\\n        if len(gm) >= 3:\\n            s, se = ols(gm[\\\"n\\\"], np.log(gm[\\\"Xp_median\\\"]))\\n            row[\\\"slope_log_median\\\"], row[\\\"se_log_median\\\"] = round(s, 4), round(se, 4)\\n        s, se = ols(g[\\\"n\\\"], np.log(g[\\\"Xp_pred\\\"]))\\n        row[\\\"slope_log_pred\\\"], row[\\\"se_log_pred\\\"] = round(s, 4), round(se, 4)\\n        s, se = ols(g[\\\"n\\\"], np.log(g[\\\"Xp_mean\\\"]))\\n        row[\\\"slope_log_mean\\\"], row[\\\"se_log_mean\\\"] = round(s, 4), round(se, 4)\\n        inst = df[(df.source == src) & (df.c == c) & (df.beta_label == lab) & (~df.censored) & (df.Xp > 0)]\\n        s, se = ols(inst[\\\"n\\\"], np.log(inst[\\\"Xp\\\"]))\\n        row[\\\"slope_log_Xp_inst\\\"], row[\\\"se_log_Xp_inst\\\"], row[\\\"inst\\\"] = round(s, 4), round(se, 4), len(inst)\\n        last = g.iloc[-1]\\n        row[\\\"largest_n\\\"] = int(last[\\\"n\\\"])\\n        row[\\\"log_med_over_n_at_largest\\\"] = last[\\\"log_med_over_n\\\"]\\n        row[\\\"log_pred_over_n_at_largest\\\"] = last[\\\"log_pred_over_n\\\"]\\n        row[\\\"fork_ratio\\\"] = round(last[\\\"log_med_over_n\\\"] / last[\\\"log_pred_over_n\\\"], 3) if last[\\\"log_pred_over_n\\\"] > 0 and np.isfinite(last[\\\"log_med_over_n\\\"]) else last[\\\"log_med_over_n\\\"]\\n        slopes.append(row)\\n    slopes = pd.DataFrame(slopes)\\n    slopes.to_csv(HERE / \\\"slopes.csv\\\", index=False)\\n    # the mechanism: mean degree into the opposite side of moved S vertices against all S vertices\\n    mech = pd.read_csv(HERE / \\\"mechanism.csv\\\")\\n    mrows = []\\n    for key, g in mech.groupby(\\\"cell\\\", sort=False):\\n        row = dict(cell=key)\\n        for pop in (\\\"moved_in_far_pairs\\\", \\\"all_S_vertices\\\"):\\n            h = g[g.population == pop]\\n            tot = h[\\\"count\\\"].sum()\\n            if tot:\\n                row[f\\\"{pop}_mean_deg_opp\\\"] = round(float((h[\\\"degree_opposite_side\\\"] * h[\\\"count\\\"]).sum() / tot), 3)\\n                row[f\\\"{pop}_share_deg0\\\"] = round(float(h[h.degree_opposite_side == 0][\\\"count\\\"].sum() / tot), 4)\\n                row[f\\\"{pop}_share_deg_le1\\\"] = round(float(h[h.degree_opposite_side <= 1][\\\"count\\\"].sum() / tot), 4)\\n                row[f\\\"{pop}_count\\\"] = int(tot)\\n        mrows.append(row)\\n    mech_df = pd.DataFrame(mrows)\\n    mech_df.to_csv(HERE / \\\"mechanism_summary.csv\\\", index=False)\\n    with (HERE / \\\"run.log\\\").open(\\\"w\\\") as f:\\n        print(cells_df.to_string(), file=f)\\n        print(file=f)\\n        print(slopes.to_string(), file=f)\\n        print(file=f)\\n        print(mech_df.to_string(), file=f)\\n    print(cells_df[[\\\"cell\\\", \\\"instances\\\", \\\"censored\\\", \\\"share_zero\\\", \\\"Xp_median\\\", \\\"Xp_mean\\\", \\\"Xp_mean_se\\\", \\\"Xp_pred\\\",\\n                    \\\"log_med_over_n\\\", \\\"log_mean_over_n\\\", \\\"log_pred_over_n\\\", \\\"share_far\\\", \\\"far_reversed_share\\\"]].to_string())\\n    print(slopes.to_string())\\n    print(mech_df.to_string())\\n\\n\\ndef stage_draw() -> None:\\n    import matplotlib\\n    matplotlib.use(\\\"Agg\\\")\\n    import matplotlib.pyplot as plt\\n    import pandas as pd\\n    hist = pd.read_csv(HERE / \\\"distance_hist.csv\\\")\\n    cells_df = pd.read_csv(HERE / \\\"cells.csv\\\")\\n    picks = [(\\\"g_n32_c6_star\\\", \\\"G(n, 6/n), β*\\\"), (\\\"g_n32_c6_star+0.1\\\", \\\"G(n, 6/n), β* + 0.1\\\"),\\n             (\\\"g_n32_c10_star\\\", \\\"G(n, 10/n), β*\\\"), (\\\"g_n32_c10_star+0.1\\\", \\\"G(n, 10/n), β* + 0.1\\\"),\\n             (\\\"f_n28_d6_star\\\", \\\"cover (6, 1), β*\\\"), (\\\"f_n28_d6_star+0.1\\\", \\\"cover (6, 1), β* + 0.1\\\")]\\n    fig, axes = plt.subplots(2, 3, figsize=(12.5, 6.2), sharey=False)\\n    for ax, (key, label) in zip(axes.flat, picks):\\n        h = hist[hist.cell == key]\\n        n = int(cells_df[cells_df.cell == key][\\\"n\\\"].iloc[0])\\n        tot = h[\\\"pairs\\\"].sum()\\n        ax.bar(h[\\\"distance\\\"] / n, h[\\\"pairs\\\"] / tot, width=0.9 / n, color=\\\"#2a78d6\\\", edgecolor=\\\"#fcfcfb\\\", linewidth=0.6)\\n        ax.axvline(FAR, color=\\\"#eb6834\\\", linewidth=2, label=\\\"far / near\\\")\\n        ax.set_xlabel(f\\\"Hamming distance from the planted pair / n   ({label}, n = {n})\\\", color=\\\"#0b0b0b\\\", fontsize=9)\\n        ax.set_xlim(-0.02, 1.0)\\n        for s in (\\\"top\\\", \\\"right\\\"):\\n            ax.spines[s].set_visible(False)\\n        ax.spines[\\\"left\\\"].set_color(\\\"#c3c2b7\\\")\\n        ax.spines[\\\"bottom\\\"].set_color(\\\"#c3c2b7\\\")\\n        ax.tick_params(colors=\\\"#52514e\\\")\\n        ax.grid(axis=\\\"y\\\", color=\\\"#e6e5e1\\\", linewidth=0.6)\\n        ax.set_axisbelow(True)\\n    axes[0, 0].set_ylabel(\\\"share of the other pairs\\\", color=\\\"#52514e\\\")\\n    axes[1, 0].set_ylabel(\\\"share of the other pairs\\\", color=\\\"#52514e\\\")\\n    axes[0, 0].legend(frameon=False, fontsize=8)\\n    fig.tight_layout()\\n    fig.savefig(HERE / \\\"distance_hist.png\\\", dpi=160)\\n    plt.close(fig)\\n    print(\\\"drawn distance_hist.png\\\")\\n\\n\\ndef main() -> None:\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--workers\\\", type=int, default=8)\\n    ap.add_argument(\\\"--per-cell\\\", type=int, default=PER_CELL)\\n    ap.add_argument(\\\"--stage\\\", choices=[\\\"run\\\", \\\"stats\\\", \\\"draw\\\"], default=None)\\n    ap.add_argument(\\\"--probe\\\", action=\\\"store_true\\\")\\n    a = ap.parse_args()\\n    os.nice(19)\\n    if a.probe:\\n        stage_run(a.workers, a.per_cell, probe=True)\\n        return\\n    stages = [a.stage] if a.stage else [\\\"run\\\", \\\"stats\\\", \\\"draw\\\"]\\n    for s in stages:\\n        t0 = time.monotonic()\\n        {\\\"run\\\": lambda: stage_run(a.workers, a.per_cell), \\\"stats\\\": stage_stats, \\\"draw\\\": stage_draw}[s]()\\n        print(f\\\"stage {s}: {time.monotonic() - t0:.0f} s\\\", flush=True)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\nEOF\\nuptime && cd reports/scratch/separator_moment/04_planted && timeout 900 nice -n 19 python3 run.py --probe --workers 6 2>&1 | tail -30\",\"description\":\"Write the run script and time the largest cells\",\"timeout\":960000}},\"wire_ingest_context\":{\"toolu_01P71NzTPJ4StibFxusbnxMp\":{\"cwd\":\"/home/al/dev/MOSP\"}}}","+{\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"bzvmi255y\",\"run_id\":\"0mvy0rf5q-e46f6835\",\"tool_use_id\":\"toolu_01P71NzTPJ4StibFxusbnxMp\",\"description\":\"Write the run script and time the largest cells\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"a6c46512-078b-4a57-be05-5e53b45f10db\",\"session_id\":\"c07fd41f-299e-4cab-b619-bc06f0f4c852\"}","+{\"type\":\"system\",\"subtype\":\"task_notification\",\"task_id\":\"bzvmi255y\",\"run_id\":\"0mvy0rf5q-e46f6835\",\"tool_use_id\":\"toolu_01P71NzTPJ4StibFxusbnxMp\",\"status\":\"completed\",\"output_file\":\"\",\"summary\":\"Write the run script and time the largest cells\",\"uuid\":\"bffe1e3d-f43e-4452-b73a-e00cd5b8363f\",\"session_id\":\"c07fd41f-299e-4cab-b619-bc06f0f4c852\"}"]}]}],"moreFiles":1,"changedFiles":["/home/al/dev/MOSP/reports/scratch/separator_moment/04_planted/run.py","/home/al/dev/MOSP/reports/scratch/separator_moment/04_planted/probe.csv","/home/al/dev/MOSP/Ralph_Loops/loop0011/session_it04.jsonl"]}},"tool_result_meta":[{"id":"toolu_01P71NzTPJ4StibFxusbnxMp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
