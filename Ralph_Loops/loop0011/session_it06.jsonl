lueError(\"the parts must sum to N\")\n    if logC is None:\n        logC = log_connected(N, p)\n    lq_ = _log_q(p)\n    out = math.lgamma(N + 1) + ((N * N - sum(s * s for s in parts)) / 2) * lq_\n    mult: dict[int, int] = {}\n    for s in parts:\n        mult[s] = mult.get(s, 0) + 1\n    for s, m in mult.items():\n        out += m * (logC[s] - math.lgamma(s + 1)) - math.lgamma(m + 1)\n    return out\n\n\ndef _lse(values) -> float:\n    vals = [v for v in values if v != -math.inf]\n    if not vals:\n        return -math.inf\n    mx = max(vals)\n    return mx + math.log(sum(math.exp(v - mx) for v in vals))\n\n\ndef _coefficient_table(N: int, a: list[float], max_part: int) -> list[list[float]]:\n    \"\"\"`W[r][s] = log [x^r] exp(Σ_{u ≤ s} e^{a(u)} x^u)` for `r ≤ N`, `s ≤ max_part`:\n    the weight of all partitions of `r` into parts `≤ s`, by the recursion on\n    the multiplicity of the largest part.\"\"\"\n    W = [[-math.inf] * (max_part + 1) for _ in range(N + 1)]\n    for s in range(max_part + 1):\n        W[0][s] = 0.0\n    for s in range(1, max_part + 1):\n        for r in range(1, N + 1):\n            terms = [W[r][s - 1]]\n            m = 1\n            while m * s <= r:\n                terms.append(m * a[s] - math.lgamma(m + 1) + W[r - m * s][s - 1])\n                m += 1\n            W[r][s] = _lse(terms)\n    return W\n\n\n----\n\"\"\"loop0011 item 05: the inner probability P_N(E_bip) of G(N, p), exactly.\n\nStages (all run by default; `--stage check|inner|rates|draw`):\n  check  Gilbert's recursion against enumeration (j <= 6) and Monte Carlo (j = 20);\n         the partition law sums to 1 (N <= 20); P_N(E_bip) against enumeration of\n         every labelled graph (N <= 7) and Monte Carlo (N = 20, p = 0.1);\n         P(E_bip) <= P(E_relax) <= 1 and P(E_bip) <= product bound on a grid.\n  inner  at the pilot cells (n = 60, 120; c = 3, 4, 6, 8, 10), every k: the pair\n         bound of finite_bound.py, the exact-size pair bound, the separator bound\n 