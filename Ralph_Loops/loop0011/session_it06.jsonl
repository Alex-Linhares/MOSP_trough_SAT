2 - 0.1, 0.62, \"2 ln 2\", color=muted, fontsize=8, ha=\"right\", rotation=90, va=\"bottom\")","+    ax.text(4 * LN2 + 0.1, 0.62, \"4 ln 2\", color=muted, fontsize=8, ha=\"left\", rotation=90, va=\"bottom\")","+    ax.text(cs[-1] + 0.3, f(\"edwards_mcdermid\")[-1], \"E–M\", color=text, fontsize=9, va=\"center\")","+    ax.text(cs[-1] + 0.3, f(\"beta_star\")[-1], \"β*, β_sep,\\nβ_closed\", color=text, fontsize=8, va=\"center\")","+    ax.set_xlim(1, 22.5)","     ax.set_ylim(0, 0.85)","-    ax.set_xlabel(\"c  (mean degree of G(n, c/n))\", color=text)","     ax.set_ylabel(\"β  (pathwidth per vertex)\", color=text)","-    for s in (\"top\", \"right\"):","-        ax.spines[s].set_visible(False)","-    for s in (\"left\", \"bottom\"):","-        ax.spines[s].set_color(muted)","-    ax.tick_params(colors=muted)","-    ax.grid(axis=\"y\", color=\"#e6e5e1\", lw=0.8)","-    ax.set_axisbelow(True)","-    ax.legend(loc=\"upper left\", fontsize=7.5, frameon=False, bbox_to_anchor=(0.0, 1.0))","+    ax.legend(loc=\"lower right\", fontsize=7.5, frameon=False)","+    # right: the gains over β*","+    gap = [(float(r[\"c\"]), float(r[\"slope_fitted\"]) - float(r[\"beta_star\"])) for r in rows if r[\"slope_fitted\"] not in (\"nan\", \"\")]","+    bx.fill_between(cs, [0] * len(cs), [h - s for h, s in zip(f(\"beta_sep_bracket_hi\"), f(\"beta_star\"))],","+                    color=col[\"sep\"], alpha=0.12, lw=0, label=\"bracket on β_sep − β*\")","+    bx.plot([x for x, _ in gap], [y for _, y in gap], ls=\"none\", marker=\"o\", ms=7, mfc=col[\"slope\"], mec=surface, mew=1.5,","+            label=\"fitted slope − β* (the gap to the data)\")","+    bx.plot(cs, [v - s for v, s in zip(f(\"beta_comb_fitted\"), f(\"beta_star\"))], color=col[\"comb\"], lw=2,","+            label=\"β_comb − β* (combined; fitted tilted rate)\")","+    bx.plot(cs, [v - s for v, s in zip(f(\"beta_closed\"), f(\"beta_star\"))], color=col[\"closed\"], lw=2, label=\"β_closed − β*\")","+    bx.plot(cs, [v - s for v, s