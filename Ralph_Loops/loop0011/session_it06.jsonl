ray]:\n\"\"\"Check, before it is quoted, the rate function for the size of the largest\ncomponent of G(n, c/n) in the form O'Connell (1998) gives it, as restated by\nPuhalskii (2005, Ann. Probab. 33, remark after Corollary 2.5; his (2.13)-(2.14)):\n\n    K_rho(u) = u log(rho u / (1 - e^{-rho u})) - rho u^2 / 2,\n    L_c(u)   = (1 - u) log(1 - u) + (c - log c) u - c u^2 / 2,\n    I_c^beta(u) = k K_c(u) + L_c(k u)   for u in [x_k, x_{k-1}],  x_0 = 1,\n    x_k the solution of x / (1 - e^{-c x}) = 1 - k x.\n\nTwo things are checked numerically (item 01 of loop0011, 2026-11-01):\n(1) I vanishes at the law-of-large-numbers point u* = 1 - rho, 1 - u* = e^{-c u*};\n(2) inf over u <= 1/2 of I is positive iff c > 2 ln 2, i.e. iff u* > 1/2.\nNothing here is a theorem of ours; it is a sanity check of a quotation.\n\"\"\"\nimport math\n\ndef K(rho, u):\n    if u == 0: return 0.0\n    return u * math.log(rho * u / (1 - math.exp(-rho * u))) - rho * u * u / 2\n\ndef L(c, u):\n    return (1 - u) * math.log(1 - u) + (c - math.log(c)) * u - c * u * u / 2 if u < 1 else (c - math.log(c)) - c / 2\n\ndef x_k(c, k):\n    # solve x/(1-e^{-cx}) = 1 - k x on (0, 1/k) by bisection; LHS - RHS increasing\n    lo, hi = 1e-12, 1.0 / k - 1e-12\n    f = lambda x: x / (1 - math.exp(-c * x)) - (1 - k * x)\n    if f(lo) > 0: return 0.0\n    for _ in range(200):\n        mid = (lo + hi) / 2\n        if f(mid) > 0: hi = mid\n        else: lo = mid\n    return (lo + hi) / 2\n\ndef I(c, u):\n    if u <= 0: return L(c, max(0.0, 1 - 1 / c))\n    k = 1\n    while True:\n        xk, xk1 = x_k(c, k), (1.0 if k == 1 else x_k(c, k - 1))\n        if xk <= u <= xk1 + 1e-15:\n            return k * K(c, u) + L(c, k * u)\n        k += 1\n        if k > 10000: return float('nan')\n\ndef giant(c):\n    if c <= 1: return 0.0\n    lo, hi = 1e-12, 1 - 1e-12\n    for _ in range(200):\n        mid = (lo + hi) / 2\n        if 1 - mid - math.exp(-c * mid) > 0: lo = mid\n        else: hi = mid\n    return (lo + hi) / 2\n\nif __name__ == \"__main__\":\n  print(\"c  u*=giant  I(u*)  x_1  I(1/2)  min_{u<=1/2} I  c>2ln2\")\n  for c in [1.2, 1.386, 1.4, 1.5, 2.0, 2.772, 3.0, 4.0, 4.98, 6.0, 8.0, 10.0]:\n      us = giant(c)\n      grid = [i / 2000 for i in range(1, 1001)]\n      m = min(I(c, u) for u in grid)\n      print(f\"{c:5.3f} {us:.4f} {I(c, us):+.2e} {x_k(c,1):.4f} {I(c,0.5):+.5f} {m:+.5f} {c > 2*math.log(2)}\")\n\"\"\"Preview for items 05-06, from the quoted rate function only (rate_check.py):\nthe *relaxed* separator first moment\n\n    P(pw(G(n, c/n)) <= k) <= C(n, k) * P_N(largest component of G(N, c'/N) <= N/2),\n    N = n - k, c' = c (1 - beta), k = beta n,\n\nwith the inner probability replaced by its LDP rate I^beta_{c'}(1/2) (O'Connell 1998 as\nrestated by Puhalskii 2005): exponent per vertex of n\n\n    g_relax(beta) = H(beta) - (1 - beta) * I^beta_{c(1-beta)}(1/2),   H = binary entropy in nats,\n\nagainst the pair count's  g_pair(beta) = H(a, a, 1-2a) - c a^2, a = (1-beta)/2.  Roots and the\ngain in nats per vertex at beta*.  A preview: asymptotic, from a quotation, relaxed event; item 06\ncomputes the real thing and this file is superseded by it.\n\"\"\"\nimport math, sys\nsys.path.insert(0, 'reports/scratch/separator_moment')\nfrom rate_check import I, giant\n\ndef H2(b): return -b*math.log(b) - (1-b)*math.log(1-b)\ndef H3(a): return -2*a*math.log(a) - (1-2*a)*math.log(1-2*a)\ndef g_pair(c, b): a = (1-b)/2; return H3(a) - c*a*a\ndef g_relax(c, b): return H2(b) - (1-b)*I(c*(1-b), 0.5)\n\ndef root(f, lo=1e-4, hi=0.95):\n    # first beta (scanning up) where f crosses from negative to positive\n    prev = f(lo)\n    if prev >= 0: return 0.0\n    b = lo\n    while b < hi:\n        nb = b + 0.0005\n        v = f(nb)\n        if v >= 0:\n            for _ in range(60):\n                mid = (b+nb)/2\n                if f(mid) >= 0: nb = mid\n                else: b = mid\n            return (b+nb)/2\n        b = nb\n    return float('nan')\n\nprint(\"c   beta*_pair  beta_relax  gain(beta)  g_pair(beta*)  g_relax(beta*)  slope_pair  threshold c(1-b)=2ln2?\")\nfor c in [2.0, 2.5, 2.772, 3.0, 3.5, 4.0, 5.0, 6.0, 8.0, 10.0, 12.0, 16.0, 20.0]:\n    bp = root(lambda b: g_pair(c, b)); br = root(lambda b: g_relax(c, b))\n    bb = bp if bp > 0 else 0.001\n    sl = (g_pair(c, bb+1e-4) - g_pair(c, bb-1e-4))/2e-4\n    print(f\"{c:5.2f}  {bp:.4f}     {br:.4f}     {br-bp:+.4f}    {g_pair(c,bb):+.4f}       {g_relax(c,bb):+.4f}      {sl:.2f}\")\nprint(\"threshold of the relaxed separator count: the largest c with beta_relax = 0 is where c = 2 ln 2 =\", round(2*math.log(2),4))\nc   beta*_pair  beta_relax  gain(beta)  g_pair(beta*)  g_relax(beta*)  slope_pair  threshold c(1-b)=2ln2?\n 2.00  0.0000     0.0056     +0.0056    +0.2014       -0.0280      7.21\n 2.50  0.0000     0.0185     +0.0185    +0.0766       -0.0923      7.46\n 2.77  0.0000     0.0279     +0.0279    +0.0087       -0.1352      7.60\n 3.00  0.0087     0.0368     +0.0281    -0.0000       -0.1270      5.53\n 3.50  0.0337     0.0587     +0.0251    +0.0000       -0.0984      4.35\n 4.00  0.0613     0.0827     +0.0214    -0.0000       -0.0779      3.91\n 5.00  0.1175     0.1328     +0.0153    -0.0000       -0.0515      3.53\n 6.00  0.1706     0.1817     +0.0111    -0.0000       -0.0360      3.38\n 8.00  0.2628     0.2690     +0.0062    -0.0000       -0.0198      3.29\n10.00  0.3371     0.3409     +0.0038    -0.0000       -0.0123      3.30\n12.00  0.3973     0.3998     +0.0025    +0.0000       -0.0082      3.34\n16.00  0.4882     0.4895     +0.0013    -0.0000       -0.0043      3.45\n20.00  0.5535     0.5542     +0.0007    -0.0000       -0.0026      3.56\nthreshold of the relaxed separator count: the largest c with beta_relax = 0 is where c = 2 ln 2 = 1.3863","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WJZBjsbLX7DyPqZWhygT9C","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
