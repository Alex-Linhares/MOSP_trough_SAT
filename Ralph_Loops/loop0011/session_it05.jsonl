e r['lower'])] += 1\n    print(f\"  n={n}: exact {dict(sorted(ex.items()))}; unproved lower bounds {dict(sorted(lo.items()))}\")\n\nprint(\"\\nFrom which n on is B(n, floor(beta n), c/n) < 1 for all larger n (checked to 3000), c = 10?\")\nc = 10\nbs = beta_star(c)\nfor beta in (bs / 2, 0.25, 0.30, 0.33):\n    first = next((n for n in range(12, 3000) if all(logB(m, int(beta * m), c / m) < 0 for m in range(n, n + 60))), None)\n    print(f\"  beta = {beta:.4f}: from n = {first}\")\nprint(\"And the relaxed bound (A) < 1, c = 10?\")\nfor beta in (bs / 2, 0.25, 0.30):\n    first = next((n for n in range(12, 20000) if all(logA(m, int(beta * m), c) < 0 for m in range(n, n + 60))), None)\n    print(f\"  beta = {beta:.4f}: from n = {first}\")\n----LOG----\npilot statuses: ['bound', 'minor', 'refutation', 'upper']\n\n   n    c  k:B<1  k:B<.01  k:A<1  beta*n  pilot N  exact  min pw(exact)  min LB(unproved)\n  60    3      1       -1     -1    0.52      136    136              5              None\n  60    4      5        3      0    3.68      136    136              8              None\n  60    6     11       11      6   10.24      134    134             16              None\n  60    8     17       17     11   15.77      132    132             20              None\n  60   10     23       21     15   20.23      133    133             25              None\n 120    3      1        1     -1    1.04       13      3             11                12\n 120    4      9        7      3    7.36       13      0           None                17\n 120    6     21       21     15   20.48       13      0           None                25\n 120    8     33       33     26   31.54       13      0           None                34\n 120   10     43       41     35   40.45       13      0           None                41\n\nn = 60, c = 10: the bound B(k) for k = 0..30, and the relaxed bound (A):\n  k= 0  t=30  log10 B =   -50.338   B = 4.595e-51    log10 A =  -39.576\n  k= 1  t=30  log10 B =   -50.33