{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013XLizmWyzpG8Y1e95fwwbD","type":"tool_result","content":"# --- section 4: cost -------------------------------------------------------\n\ndef _mosp_pairs(stage: str, config: str):\n    d = defaultdict(dict)\n    with open(DATA / f\"solver_fix_cost_{stage}.csv\") as f:\n        for r in csv.DictReader(f):\n            if r[\"config\"] == config:\n                d[(r[\"instance_name\"], r[\"k\"])][r[\"setting\"]] = r\n    total = both = 0\n    old = rep = 0\n    worst = 0.0\n    for v in d.values():\n        if len(v) < 2:\n            continue\n        total += 1\n        o, r = v[\"old\"], v[\"repaired\"]\n        if o[\"status\"] in DONE and r[\"status\"] in DONE:\n            both += 1\n            old += int(o[\"nodes\"])\n            rep += int(r[\"nodes\"])\n            if int(o[\"nodes\"]):\n                worst = max(worst, int(r[\"nodes\"]) / int(o[\"nodes\"]))\n    return total, both, old, rep, worst\n\n\ndef _pw_pairs():\n    rows = list(csv.DictReader(open(DATA / \"solver_fix_cost_pw.csv\")))\n    # a job writes its two rows together; the pair is the row order (as solver_fix_cost_tables)\n    total = both = old = rep = 0\n    for i in range(0, len(rows), 2):\n        a, b = rows[i], rows[i + 1]\n        assert {a[\"setting\"], b[\"setting\"]} == {\"old\", \"repaired\"}\n        o, r = (a, b) if a[\"setting\"] == \"old\" else (b, a)\n        total += 1\n        if o[\"proof\"] in (\"refutation\", \"bound\") and r[\"proof\"] in (\"refutation\", \"bound\"):\n            both += 1\n            old += int(o[\"nodes\"])\n            rep += int(r[\"nodes\"])\n    return total, both, old, rep\n\n\ndef cost_table() -> str:\n    lines = []\n    for stage, config, label, size in [\n        (\"mosp40\", \"default\", \"MOSP corpus, \\\\texttt{default}\", \"9--40\"),\n        (\"mosp40\", \"csearch\", \"MOSP corpus, \\\\texttt{csearch}\", \"9--40\"),\n        (\"cs\", \"csearch\", \"Chu \\\\& Stuckey classes\", \"50--100\"),\n        (\"cs125\", \"csearch\", \"Chu \\\\& Stuckey classes, cap $2\\\\times10^8$ nodes\", \"125\"),\n    ]:\n        total, both, old, rep, worst = _mosp_pairs(stage, config)\n        lines.append(f\"{label} & {size} & {_n(both)} of {_n(total)} & {_n(old)} & {_n(rep)} & \"\n                     f\"{rep / old:.5f} & {worst:.3f} \\\\\\\\\")\n    total, both, old, rep = _pw_pairs()\n    lines.append(f\"Graph pathwidth, whole descents & 4--2{{,}}916 & {_n(both)} of {_n(total)} & \"\n                 f\"{_n(old)} & {_n(rep)} & {rep / old:.3f} & -- \\\\\\\\\")\n    body = [\"\\\\begin{tabular}{@{}llrrrrr@{}}\", \"\\\\toprule\",\n            \"Where & Vertices & Pairs finished & Nodes, published & Nodes, repaired & Ratio & \"\n            \"Worst pair \\\\\\\\\", \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    return _write(\"cost.tex\", \"paper2/data/solver_fix_cost_{mosp40,cs,cs125,pw}.csv\", body)\n\n\n# --- section 4: the root split ----------------------------------------------\n\ndef split_table() -> str:\n    from paper2.solver_fix_split import RESULTS, TASKS, _read_rows, targets\n    rows = _read_rows(TASKS)\n    finished = {r[\"instance_name\"]: r for r in _read_rows(RESULTS)}\n    lines = []\n    for t in targets():\n        name = t[\"instance_name\"]\n        mine = [r for r in rows if r[\"instance_name\"] == name and int(r[\"k\"]) == t[\"k\"]]\n        done = [r for r in mine if r[\"kind\"] == \"task\" and r[\"status\"] == \"unsat\"]\n        secs = sum(float(r[\"seconds\"] or 0) for r in mine)\n        if name in finished:\n            state, nodes = \"refuted\", int(finished[name][\"total_nodes\"])\n        else:\n            state = \"in flight\" if mine else \"not started\"\n            nodes = sum(int(r[\"nodes\"]) for r in done)\n        mant, exp = f\"{nodes:.2e}\".split(\"e\")\n        lines.append(f\"\\\\texttt{{{name.replace('_', chr(92) + '_')}}} & {t['value']} & {t['k']} & {state} & {_n(len(done))} & \"\n                     f\"${mant}\\\\times10^{{{int(exp)}}}$ & {secs / 3600:.1f} \\\\\\\\\")\n    stamp = max((r.get(\"finished\") or r.get(\"time\") or \"\" for r in rows), default=\"\")\n    body = [\"\\\\begin{tabular}{@{}lrrlrrr@{}}\", \"\\\\toprule\",\n            \"Instance & Value & $k$ & State & Tasks refuted & Nodes & Core-hours \\\\\\\\\",\n            \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\",\n            f\"% read {datetime.now():%Y-%m-%d %H:%M}; last task stamp {stamp}\"]\n    return _write(\"split.tex\", \"paper2/data/solver_fix_split_{tasks,results}.csv, \"\n                  f\"read {datetime.now():%Y-%m-%d %H:%M}\", body)\n\n\n# --- section 4: certificates -------------------------------------------------\n\nBANDS = [(9, 10), (11, 20), (21, 30), (31, 40), (41, 50), (51, 60), (61, 75)]\n\n\ndef certificates_table() -> str:\n    rows = list(csv.DictReader(open(DATA / \"certificates\" / \"repaired.csv\")))\n    lines = []\n    tot = Counter()\n    for config in (\"csearch\", \"default\"):\n        for lo, hi in BANDS:\n            x = [r for r in rows if r[\"config\"] == config and lo <= int(r[\"n\"]) <= hi]\n            if not x or (config == \"default\" and hi <= 40):\n                continue\n            ref = [r for r in x if r[\"status\"] == \"unsat\"]\n            ok = [r for r in ref if r[\"check_ok\"] == \"True\"]\n            rej = [r for r in ref if r[\"check_ok\"] == \"False\"]\n            gz = sorted(int(r[\"gz_bytes\"]) for r in ref)\n            ms = sorted(1000 * float(r[\"check_seconds\"]) for r in ref)\n            med = lambda v: statistics.median(v) if v else 0  # noqa: E731\n            lines.append(f\"{lo}--{hi} & \\\\texttt{{{config}}} & {_n(len(x))} & {_n(len(ok))} & \"\n                         f\"{len(rej)} & {_n(len(x) - len(ref))} & \"\n                         f\"{_n(sum(int(r['steps_definite']) for r in ok))} & \"\n                         f\"{_n(sum(int(r['steps_better']) for r in ok