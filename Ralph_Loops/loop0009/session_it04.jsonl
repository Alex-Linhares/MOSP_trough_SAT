{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XM1A6QFoDMnzGKgDVRuJH8","type":"tool_result","content":"\"\"\"Paper 2's tables, generated from the recorded data (loop0008 item 08).\n\n    python -m paper2.latex.make_tables          # writes paper2/latex/tables/*.tex\n\nReads only; writes nothing outside `paper2/latex/tables/`. Every table the\nLaTeX draft inputs from `tables/` comes from here, and each file says in a\ncomment which records it was made from.\n\n- `names.tex`        section 2: name usage and citations (`paper2.section2_figures.numbers`,\n                     from the OpenAlex caches of 2026-09-29);\n- `cost.tex`         section 4: nodes, repaired against published rules\n                     (`paper2/data/solver_fix_cost_{mosp40,cs,cs125,pw}.csv`);\n- `split.tex`        section 4: the re-certifications of the root split\n                     (`paper2/data/solver_fix_split_{tasks,results}.csv`, read as they are now);\n- `certificates.tex` section 4: certificates under the repaired rules\n                     (`paper2/data/certificates/repaired.csv`);\n- `dataset.tex`      section 4: the dataset by collection\n                     (`paper2/data/dataset/classes.csv.gz`, `index.csv.gz`).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport statistics\nimport gzip\nfrom collections import Counter, defaultdict\nfrom datetime import datetime\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nDATA = ROOT / \"paper2\" / \"data\"\nOUT = Path(__file__).resolve().parent / \"tables\"\n\nDONE = {\"sat\", \"unsat\"}\n\n\ndef _n(x: int) -> str:\n    \"\"\"An integer with thin-space-free comma thousands, as the prose has it.\"\"\"\n    return f\"{x:,}\"\n\n\ndef _write(name: str, source: str, body: list[str]) -> str:\n    OUT.mkdir(exist_ok=True)\n    text = \"\\n\".join([f\"% Generated by python -m paper2.latex.make_tables. Source: {source}.\",\n                      \"% Do not edit by hand.\", *body]) + \"\\n\"\n    (OUT / name).write_text(text)\n    return text\n\n\n# --- section 2 -------------------------------------------------------------\n\nORDER = [  # (key in numbers()[\"names\"], printed name, Table 1 ref keys, discipline)\n    (\"graph path-width\", \"Path-width\", [\"13\"], \"graph theory\"),\n    (\"gate matrix layout\", \"Gate matrix layout\", [\"6\", \"8\"], \"VLSI\"),\n    (\"PLA folding\", \"PLA folding\", [\"6\"], \"VLSI\"),\n    (\"MOSP\", \"MOSP\", [\"1\", \"4\"], \"operations research\"),\n    (\"vertex separation\", \"Vertex separation\", [\"13\"], \"graph theory\"),\n    (\"edge search game\", \"Edge search\", [\"10\"], \"graph theory\"),\n    (\"node search game\", \"Node search\", [\"9\"], \"graph theory\"),\n    (\"one-dimensional logic\", \"One-dimensional logic\", [\"7\"], \"VLSI\"),\n    (\"interval thickness\", \"Interval thickness\", [\"5\"], \"graph theory\"),\n    (\"narrowness\", \"Narrowness\", [\"11\"], \"graph theory\"),\n    (\"split bandwidth\", \"Split bandwidth\", [\"12\"], \"graph theory\"),\n    (\"edge separation\", \"Edge separation\", [\"14\"], \"graph theory\"),\n]\nCITE = {\"1\": \"Yanasse1997b\", \"4\": \"LY2002ref4\", \"5\": \"LY2002ref5\", \"6\": \"LY2002ref6\",\n        \"7\": \"LY2002ref7\", \"8\": \"LY2002ref8\", \"9\": \"LY2002ref9\", \"10\": \"LY2002ref10\",\n        \"11\": \"LY2002ref11\", \"12\": \"LY2002ref12\", \"13\": \"LY2002ref13\", \"14\": \"LY2002ref14\"}\n\n\ndef names_table() -> str:\n    from paper2.section2_figures import QUERIES, numbers\n    num = numbers()\n    disc_of = {k: d for k, _, d, _ in QUERIES}\n    words = {\"GT\": \"graph theory\", \"VLSI\": \"VLSI\", \"OR\": \"operations research\"}\n    n, cited = num[\"names\"], num[\"cited_by\"]\n    rows = []\n    for key, label, refs, _ in ORDER:\n        disc = words[disc_of[key]]\n        c = \" / \".join(_n(cited[r]) if r in cited else \"--\" for r in refs)\n        src = \"; \".join(f\"\\\\citet{{{CITE[r]}}}\" for r in refs)\n        rel = _n(n[key][\"relevant\"])\n        if key == \"graph path-width\":\n            rel += \"$^{a}$\"\n        rows.append(f\"{label} & {disc} & {rel} & {_n(n[key]['hits'])} & {src} & {c} \\\\\\\\\")\n    pw = n[\"graph path-width\"]\n    small = sum(v[\"relevant\"] for k, v in n.items() if k != \"graph path-width\")\n    body = [\n        \"\\\\begin{tabular}{@{}llrrp{4.6cm}r@{}}\",\n        \"\\\\toprule\",\n        \"Problem & Discipline & Relevant & Hits & Table~1 reference & Citations \\\\\\\\\",\n        \"\\\\midrule\", *rows, \"\\\\midrule\",\n        f\"All twelve & & {_n(pw['relevant'] + small)} & {_n(num['hits_total'])} & & \\\\\\\\\",\n        \"\\\\bottomrule\", \"\\\\end{tabular}\",\n        f\"% check: other eleven = {small}; pathwidth distinct = {pw['distinct']}; \"\n        f\"fetched {num['candidates_fetched']}, citations {num['citations_fetched']}\",\n    ]\n    return _write(\"names.tex\", \"paper2.section2_figures.numbers() (OpenAlex caches, \"\n                  f\"{num['candidates_fetched']})\", body)\n\n\n# --- section 4: cost -------------------------------------------------------\n\n    lines.append(\"\\\\midrule\")\n    lines.append(\"All & \" + \" & \".join(\"\" if i == 1 else _n(tot[i]) for i in range(7)) + \" \\\\\\\\\")\n    body = [\"\\\\begin{tabular}{@{}lrrrrrrr@{}}\", \"\\\\toprule\",\n            \"Collection & Files & Classes & Owned & Refutation & Bound & Upper bound & \"\n            \"No witnessed value \\\\\\\\\", \"\\\\midrule\", *lines, \"\\\\bottomrule\", \"\\\\end{tabular}\"]\n    return _write(\"dataset.tex\", \"paper2/data/dataset/{index,classes}.csv.gz\", body)\n\n\ndef main() -> None:\n    for f in (names_table, cost_table, split_table, certificates_table, dataset_table):\n        text = f()\n        print(text.splitlines()[0])\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"Paper 2's LaTeX draft: its generated tables, its Lean names, its bibliography (loop0008 item 08).\"\"\"\n\nimport json\nimport re\nfrom pathlib import Path\n\nfrom paper2.latex import check_lean, check_refs, make_tables\n\nHERE = Path(make_tables.__file__).resolve().parent\n\n\ndef test_every_cited_lean_name_is_declared():\n    assert check_lean.main() == 0\n    assert len(check_lean.cited()) > 50\n\n\ndef test_every_doi_is_in_the_checked_cache():\n    \"\"\"Offline: each DOI of refs.bib was fetched and compared by check_refs.\"\"\"\n    cache = json.loads(check_refs.CACHE.read_text())\n    entries = check_refs.entries(check_refs.BIB.read_text())\n    dois = [e[\"doi\"].lower() for e in entries if e.get(\"doi\")]\n    assert len(dois) >= 30\n    assert all(d in cache for d in dois)\n\n\ndef test_every_citation_key_is_in_the_bibliography():\n    keys = {e[\"key\"] for e in check_refs.entries(check_refs.BIB.read_text())}\n    cited = set()\n    for f in list(HERE.glob(\"sec*.tex\")) + [HERE / \"main.tex\"]:\n        for arg in re.findall(r\"\\\\cite[tp]?\\*?(?:\\[[^\\]]*\\])*\\{([^}]*)\\}\", f.read_text()):\n            cited.update(k.strip() for k in arg.split(\",\"))\n    assert cited <= keys, cited - keys\n\n\ndef test_cost_table_reproduces_the_recorded_ratios():\n    text = make_tables.cost_table()\n    assert \"1.00003\" in text and \"1.00004\" in text      # MOSP corpus, revised_algorithm.md 4.6.2\n    assert \"118 of 125\" in text and \"1.00303\" in text   # 50-100 customers\n    assert \"731 of 880\" in text and \"1.020\" in text     # graph pathwidth, solver_fix.md table 4\n\n\ndef test_certificates_table_reproduces_the_recorded_totals():\n    text = make_tables.certificates_table()\n    assert \"% total csearch: 6275 of 6286 verified, 0 rejected\" in text\n    assert \"% total default: 6276 of 6286 verified, 0 rejected\" in text\n\n\ndef test_every_cited_theorem_has_an_axiom_line():\n    \"\"\"Coverage half of check_axioms; the Lean half runs in the gate's build.\"\"\"\n    from paper2.latex import check_axioms\n    assert check_axioms.uncovered() == []","is_error":false}]},"parent_tool_use_id":null