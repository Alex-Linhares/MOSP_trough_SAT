cex:definite} the endpoint test passes and the commitment fails} \\leannames{cex_isDefinite_not_isCommittable} \\\\\n90:\\leanentry{existscommit}{The published premise gives a commitment to the least-border set} \\leannames{exists_isCommittable_of_isDefinite} \\\\\n91:\\leanentry{commit234}{In Counterexample~\\ref{cex:definite} that set is $\\{2,3,4\\}$} \\leannames{cex_isCommittable_234} \\\\\n92:\\leanentry{depth1}{A commitment of depth one holds iff $\\open(q,S)\\le1$} \\leannames{isCommittable_insert_iff} \\\\\n93:\\leanentry{greedy}{The greedy step of Coudert, Mazauric and Nisse is that condition} \\leannames{isGreedyStep_iff} \\\\\n94:\\leangroup{Table~\\ref{tab:dictionary}, the dictionary}\n95:\\leanentry{dict1}{Table~\\ref{tab:dictionary}: closing order from $\\emptyset$} \\leannames{orderOfLayout} \\\\\n96:\\leanentry{dict2}{Table~\\ref{tab:dictionary}: open stacks $b(T)$} \\leannames{openStacks_eq_card_boundary} \\\\\n97:\\leanentry{dict3}{Table~\\ref{tab:dictionary}: $\\cost(T,c)$} \\leannames{stepCost_eq_card_boundary_add_one} \\\\\n98:\\leanentry{dict4}{Table~\\ref{tab:dictionary}: $\\Sol_k(\\emptyset)$} \\leannames{searchSol_empty_iff_pathwidth_add_one_le} \\\\\n99:\\leanentry{dict5}{Table~\\ref{tab:dictionary}: free closure $\\cl(T)$} \\leannames{mem_cl_iff} \\\\\n100:\\leanentry{dict6}{Table~\\ref{tab:dictionary}: definite move, repaired} \\leannames{isHereditarilyDefinite_iff_isCommittable} \\\\","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
