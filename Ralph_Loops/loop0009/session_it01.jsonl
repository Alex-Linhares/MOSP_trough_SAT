cutable, \"-m\", \"pytest\", \"tests/\", \"-q\", \"-x\"], cwd=REPO,\n                       capture_output=True, text=True)\n    print(\"\\n\".join((t.stdout + t.stderr).splitlines()[-5:]))\n    if t.returncode != 0:\n        print(\"GATE FAIL: pytest\"); ok = False\n    # The pathwidth solver is fixed by this loop too, so its own suite is part of the gate.\n    w = subprocess.run([sys.executable, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\"],\n                       cwd=REPO / \"pathwidth_solver\", capture_output=True, text=True)\n    print(\"\\n\".join((w.stdout + w.stderr).splitlines()[-3:]))\n    if w.returncode != 0:\n        print(\"GATE FAIL: pathwidth_solver pytest\"); ok = False\n    # The paper must build cleanly: no undefined references, citations or overfull boxes.\n    m = subprocess.run([\"make\", \"check\"], cwd=REPO / \"paper2\" / \"latex\", capture_output=True, text=True)\n    print(\"\\n\".join((m.stdout + m.stderr).splitlines()[-3:]))\n    if m.returncode != 0:\n        print(\"GATE FAIL: paper2/latex make check\"); ok = False\n    print(\"GATE PASS\" if ok else \"GATE FAIL\")\n    return 0 if ok else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
