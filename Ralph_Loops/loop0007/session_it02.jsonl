t8), n_customers=len(matrix),\n                        n_patterns=len(matrix[0]), name=job[\"instance_name\"])\n\n\n140:def certified_targets(instance_dir: Path, solutions_dir: Path,\n141-                      max_customers: int, limit: int | None = None) -> list[tuple]:\n142-    \"\"\"Every certified instance small enough to run, as picklable job tuples.\"\"\"\n143-    jobs = []\n144-    for filepath, instance in enumerate_instances(instance_dir):\n145-        if instance.n_customers > max_customers or instance.n_patterns == 0:\n146-            continue\n147-        path = _solution_path(instance, solutions_dir)\n148-        if not path.exists():\n149-            continue\n150-        data = json.loads(path.read_text())\n151-        if data.get(\"provenance\") not in CERTIFIED:\n152-            continue\n153-        optimum = int(data[\"mosp_value\"])\n154-        if optimum <= 1:\n155-            continue          # nothing to refute below 1\n156-        collection = filepath.parts[2] if len(filepath.parts) > 2 else \"\"\n157-        jobs.append((instance.matrix.tolist(), instance.name, str(filepath),\n158-                     collection, optimum, None))\n159-    if limit is not None:\n160-        jobs = jobs[:limit]\n161-    return jobs\n162-\n163-\n164-def run(jobs: list[tuple], deadline_seconds: float, workers: int) -> pd.DataFrame:\n165-    jobs = [job[:5] + (deadline_seconds,) for job in jobs]\n166-    if workers <= 1:\n167-        rows = [row for job in jobs for row in _job(job)]\n168-    else:\n169-        with multiprocessing.Pool(workers) as pool:\n170-            rows = [row for out in pool.imap_unordered(_job, jobs, chunksize=8)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
