0 * i + hash(family) % 997, count) for i in range(workers)]''','''        offset = {\\\"gadget\\\": 1, \\\"sparse\\\": 2, \\\"cover\\\": 3}[family]\\n        jobs += [(family, 1000 * i + offset, count) for i in range(workers)]''')\\np.write_text(s)\\nEOF\\ntimeout 900 python -m paper2.solver_fix_recheck --stage validate --workers 3 --count 5 2>&1 | grep -E '^ \\\"|oracle|mism|fail_nodes'\",\"uuid\":\"957a9e3d-337a-467f-a1a9-8d5f9ef295d8\",\"session_id\":\"9a0accfe-dabc-426e-a5e6-0e90cd196e4f\"}"]}]},{"filePath":"/home/al/dev/MOSP/paper2/data/solver_fix_recheck_validate.json","hunks":[{"oldStart":4,"oldLines":23,"newStart":4,"newLines":14,"lines":["   \"same_search\": 90,","   \"same_branches\": 90,","   \"same_fail\": 90,","-  \"fail_nodes\": 9,","-  \"fail_runs\": 7,","-  \"fail_unsat_runs\": 1,","+  \"fail_nodes\": 5,","+  \"fail_runs\": 4,","+  \"fail_unsat_runs\": 2,","   \"mismatch\": [],","+  \"oracle_checked\": 1050,","+  \"oracle_disagree\": 0,","   \"graphs\": 15","  },","- \"pinned\": {","-  \"calls\": 128,","-  \"same_search\": 128,","-  \"same_branches\": 128,","-  \"same_fail\": 128,","-  \"fail_nodes\": 31,","-  \"fail_runs\": 28,","-  \"fail_unsat_runs\": 0,","-  \"mismatch\": [],","-  \"graphs\": 5","- },","  \"sparse\": {","   \"calls\": 90,","   \"same_search\": 90,"]},{"oldStart":30,"oldLines":6,"newStart":21,"newLines":8,"lines":["   \"fail_runs\": 0,","   \"fail_unsat_runs\": 0,","   \"mismatch\": [],","+  \"oracle_checked\": 985,","+  \"oracle_disagree\": 0,","   \"graphs\": 15","  },","  \"cover\": {"]},{"oldStart":41,"oldLines":6,"newStart":34,"newLines":21,"lines":["   \"fail_runs\": 0,","   \"fail_unsat_runs\": 0,","   \"mismatch\": [],","+  \"oracle_checked\": 570,","+  \"oracle_disagree\": 0,","   \"graphs\": 15","+ },","+ \"pinned\": {","+  \"calls\": 128,","+  \"same_search\": 128,","+  \"same_branches\": 128,","+  \"same_fail\": 128,","+  \"fail_nodes\": 31,","+  \"fail_runs\": 28,","+  \"fail_unsat_runs\": 0,","+  \"mismatch\": [],","