frame)","+    if len(long):","+        lines += [\"## Needs a long run\", \"\",","+                  \"Censored under the repaired solver. `lower bound` is the node count the \"","+                  \"censored call reached, a lower bound on its tree. `price` is the largest of \"","+                  \"that, the cost model's `csearch` prediction (trained on pre-2026-09-26 \"","+                  \"counts) and the `recertify` count (first-fix code); the 2026-09-26 fix \"","+                  \"made ridge refutations 2-20x larger, so the price is itself low. Hours \"","+                  f\"at {NODES_PER_SECOND:.2g} nodes/s on one core.\", \"\",","+                  long.to_markdown(index=False, floatfmt=\".3g\"), \"\"]","+        long.to_csv(DATA / \"solver_fix_recheck_long.csv\", index=False)","     out.write_text(\"\\n\".join(lines) + \"\\n\")","     print(g.to_string())","     print(f\"wrote {out}\")"]}]},{"filePath":"/home/al/dev/MOSP/paper2/data/solver_fix_recheck.csv","hunks":[{"oldStart":1,"oldLines":116,"newStart":1,"newLines":116,"lines":[" instance_name,value,n_customers,n_patterns,theorem2,price_nodes,price_source,repaired_status,repaired_nodes,repaired_seconds,audit_status,audit_nodes_run,audit_seconds,audit_nodes_fail,cert_status,cert_branches,check_ok,repaired_nodes_checked,cert_fail_nodes,verdict","-Random-40-40-6-2_0,30,40,40,off,220.0,item04,unsat,220.0,0.001,unsat,220.0,0.001,0.0,unsat,222.0,True,223.0,0.0,re-checked","-Random-40-40-6-4_0,29,40,40,off,415.0,item04,unsat,415.0,0.001,unsat,415.0,0.002,0.0,unsat,421.0,True,422.0,0.0,re-checked","-Random-50-50-10-2_0,43,50,50,off,47.0,item04,unsat,47.0,0.001,unsat,47.0,0.001,0.0,unsat,47.0,True,48.0,0.0,re-checked","-Random-50-50-10-4_0,45,50,50,off,25.0,item04,unsat,25.0,0.001,unsat,25.0,0.001,0.0,unsat,25.0,True,26.0,0.0,re-checked","-Random-50-50-2-5_0,14,50,50,off,32076.0,item04,unsat,32076.0,0.056,unsat,42171.0,0.057,15.0,unsat,111511.0,True,111512.0,20.0,re-checked","-Random-50-50-4-2_0,25,50,50,of