r cexGraph 6 L {2} ∅ = {0} := by\n  unfold codeFullFilter fullFilter\n  split_ifs with h\n  · congr 1\n  · exact absurd (by decide +kernel) h","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
