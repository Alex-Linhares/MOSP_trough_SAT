V} (cite : V → V → Prop)\n258:theorem definite_link {k : ℕ} {S : Finset V} {q r : V} (hq : IsHereditarilyDefinite G S q)\n273:theorem exec_repairedFullFilter_narrowness {k L : ℕ} {M' : Set (Finset V)}\n280:theorem exec_repairedFullFilter_pathwidth [Nonempty V] {k L : ℕ} {M' : Set (Finset V)}\n293:theorem exec_repairedFullFilter_mospValue (M : MOSPInstance C Pt) [DecidableRel M.requires]\n302:theorem exec_repairedFullFilter_mospGraph_pathwidth (M : MOSPInstance C Pt)\n318:theorem codeFullFilter_playable (k L : ℕ) : FilterPlayable G k (codeFullFilter G k L) := by\n326:def CodeFilterSound (k L : ℕ) : Prop := FilterSound G k (codeFullFilter G k L)\n330:def CodeRunSound (k L : ℕ) (M' : Set (Finset V)) : Prop :=\n334:definite customer (item 08's repair); if it does not fire, every customer the better move drops\n337:def CodeNodeRepaired (k L : ℕ) (S Q : Finset V) : Prop :=\n351:theorem nodeSoundAt_codeFullFilter_of_repaired {k L : ℕ} {S Q : Finset V}\n383:theorem codeExec_sound_of_runSound {k L : ℕ} {M' : Set (Finset V)}\n388:theorem codeExec_sound_of_codeFilterSound {k L : ℕ} {M' : Set (Finset V)}\n394:theorem codeExec_sound_of_repaired {k L : ℕ} {M' : Set (Finset V)}\n402:theorem codeExec_pathwidth_of_runSound [Nonempty V] {k L : ℕ} {M' : Set (Finset V)}\n415:theorem codeExec_mospValue_of_runSound (M : MOSPInstance C Pt) [DecidableRel M.requires]\n423:theorem codeExec_mospValue_of_repaired (M : MOSPInstance C Pt) [DecidableRel M.requires]\n435:theorem codeFullFilter_cex (L : ℕ) : codeFullFilter cexGraph 6 L {2} ∅ = {0} := by\n444:theorem not_codeFilterSound_cexGraph (L : ℕ) : ¬ CodeFilterSound cexGraph 6 L := by","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
