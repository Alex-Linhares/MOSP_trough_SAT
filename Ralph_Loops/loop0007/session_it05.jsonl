d.DataFrame, workers: int = 16, deadline: float = DEADLINE,\n434:    def _flush() -> None:\n462:def variant_targets(jobs: list[dict], cheap_seconds: float = VARIANT_CHEAP_SECONDS,\n480:def _variant_job(args) -> list[dict]:\n498:def run_variants(jobs: list[dict], workers: int = 16, deadline: float = VARIANT_DEADLINE,\n534:def summaries(rows: pd.DataFrame) -> pd.DataFrame:\n550:def audit_table(rows: pd.DataFrame, summary: pd.DataFrame) -> pd.DataFrame:\n575:def censoring_table(rows: pd.DataFrame) -> pd.DataFrame:\n598:def spread_table(rows: pd.DataFrame, which: str = \"lo\", by: str = \"band\",\n645:def config_agreement_table(rows: pd.DataFrame) -> pd.DataFrame:\n665:def variant_tables(vrows: pd.DataFrame) -> dict[str, pd.DataFrame]:\n698:def _md(frame: pd.DataFrame, floatfmt: str = \".3g\") -> str:\n704:def write_tables(rows_csv: Path = ROWS_CSV, price_csv: Path = PRICE_CSV,\n748:def main() -> None:\n750:    parser.add_argument(\"--stage\", choices=(\"price\", \"run\", \"variants\", \"tables\"), default=\"price\")\n751:    parser.add_argument(\"--source\", choices=(\"all\", \"campaign\", \"corpus\"), default=\"all\")\n752:    parser.add_argument(\"--workers\", type=int, default=16)\n753:    parser.add_argument(\"--deadline\", type=float, default=DEADLINE)\n754:    parser.add_argument(\"--budget\", type=float, default=BUDGET_CORE_HOURS, help=\"core-hours\")\n755:    parser.add_argument(\"--reserve\", type=float, default=0.0,\n757:    parser.add_argument(\"--wall\", type=float, default=None, help=\"wall-clock seconds for the stage\")\n758:    parser.add_argument(\"--limit\", type=int, default=None)\n92:RESULTS_CSV = ENSEMBLE_DIR / \"results.csv\"\n93:ROWS_CSV = ENSEMBLE_DIR / \"differential.csv.gz\"\n94:SUMMARY_CSV = ENSEMBLE_DIR / \"differential_summary.csv\"\n95:PARTIAL_CSV = Path(\"learning/data/differential_partial.csv\")\n299:def campaign_targets(results_csv: Path = RESULTS_CSV, limit: int | None = None,\n356:        deadline: float | None = 60.0, partial: Path = PARTIAL_CSV,\n357:        rows_csv: Path = ROWS_CSV, summary_csv: Path = SUMMARY_CSV,\n541:def write_tables(rows_csv: Path = ROWS_CSV, summary_csv: Path = SUMMARY_CSV,\n584:def recertify_drawn(summary_csv: Path = SUMMARY_CSV, rows_csv: Path = ROWS_CSV,\n585:                    results_csv: Path = RESULTS_CSV, instance_dir: Path = DEFAULT_INSTANCE_DIR,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
