.sum(), (t[R1]==t[R2]).sum(), (t[R1]>t[R2]).sum()))\nlex = [c for c in t.columns if c.startswith(\"lex:\")]\nrows=[]\nfor c in lex+[\"mcn\"]:\n    e=t[c].to_numpy()-truth; rows.append((c, np.abs(e).mean(), (e==0).mean(), e.max()))\nd = pd.DataFrame(rows, columns=[\"rule\",\"mae\",\"exact\",\"worst\"]).sort_values(\"mae\")\nd[\"first\"] = d.rule.str.replace(\"lex:\",\"\").str.split(\",\").str[0]\nprint(\"--- best rule per first key\")\nprint(d.groupby(\"first\").agg(best_mae=(\"mae\",\"min\"), n=(\"mae\",\"size\")).sort_values(\"best_mae\").to_string())\nprint(\"--- rank of MCN among\", len(d), \":\", int((d.mae < d.loc[d.rule==\"mcn\",\"mae\"].iloc[0]).sum())+1)\nprint(\"--- worst instances for R2\")\nt2 = t.assign(err=t[R2]-t.optimum).sort_values(\"err\", ascending=False)\nprint(t2[[\"instance_name\",\"n_customers\",\"optimum\",R2,\"lgbm\",\"mcn\",\"source_file\"]].head(8).to_string())\nprint(\"--- collections: MAE per source dir\")\nt = t.assign(coll=t.source_file.str.split(\"/\").str[-2])\ng = t.groupby(\"coll\").apply(lambda s: pd.Series({\"n\":len(s), \"mcn\":np.abs(s.mcn-s.optimum).mean(), \"lgbm\":np.abs(s.lgbm-s.optimum).mean(), \"R2\":np.abs(s[R2]-s.optimum).mean(), \"fiedler\":np.abs(s.fiedler-s.optimum).mean()}))\nprint(g.round(3).to_string())\nEOF","description":"Time cs-dfs and analyse the per-instance results","timeout":620000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":4826,"cache_read_input_tokens":118022,"cache_creation":{"ephemeral_5m_input_tokens":4826,"ephemeral_1h_input_tokens":0},"output_tokens":10,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5a589f77-2584-4577-8831-52251d2454c1","uuid":"52d975af-5b6a-4233-abcc-dc651f1ef07d","timestamp":"2026-09-25T21:06:19.531Z","request_id":"req_011CfQqYfCpwxfmAfpPS91sz","w