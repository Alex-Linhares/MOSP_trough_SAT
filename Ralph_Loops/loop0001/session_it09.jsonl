and\nfor c in [\"fiedler\",\"fiedler-rev\",\"rcm\",\"cuthill-mckee\",\"bfs-fifo\"]:\n    e=t[c].to_numpy()-tr; print(f\"{c:15s} mae {np.abs(e).mean():.3f} exact {(e==0).mean():.3f} within1 {(e<=1).mean():.3f}\")\n# sizes covered\nprint(\"n range\", t.n_customers.min(), t.n_customers.max(), \"<=30:\", (t.n_customers<=30).sum())\n# rank of R2 among all lex rules pooled\nlex=[c for c in t.columns if c.startswith(\"lex:\")]\nranked=sorted(lex, key=mae); print(\"rank R2:\", ranked.index(R2)+1, \"rank R1:\", ranked.index(R1)+1, \"rank R2m:\", ranked.index(R2m)+1, \"of\", len(lex))\nprint(\"top3\", [(r, round(mae(r),3)) for r in ranked[:3]])\nEOF","description":"Head-to-head counts, per-collection errors and hygiene checks","timeout":320000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":2794,"cache_read_input_tokens":138222,"cache_creation":{"ephemeral_5m_input_tokens":2794,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5a589f77-2584-4577-8831-52251d2454c1","uuid":"13767020-d6d2-48eb-aa3e-84472f21243d","timestamp":"2026-09-25T21:12:52.659Z","request_id":"req_011CfQr4fs6MbzCrFFWjePqi","wire_tool_inputs":{"toolu_01HZPLHKq3iPQYLRbi29PvpH":{"command":"cd /home/al/dev/MOSP && git status --short solutions/ | wc -l; git status --short | grep -v Ralph_Loops; pgrep -f benchmarks.recertify | wc -l; date; timeout 300 python - <<'EOF'\nimport numpy as np, pandas as pd\nf = pd.read_csv(\"learning/data/distil.csv\"); t = f[f.role==\"test\"].copy()\ntr = t.optimum.to_numpy()\nR2 = \"lex:min newly_opened,max remaining_degree\"; R1 = \"lex:min newly_opened\"\nR2m = \"lex:min newly_opened,min remaining_degree\"\ndef mae(c): return float(np.abs(t[c].to_numpy()-tr).mean())\nfor c in [R1, R2, R2m, \"lex:max already