ean degree at its \"\n             f\"m = n ridge value ({dg_txt}). Open triangles: censored medians, lower bounds.\",\n             fontsize=9, color=\"#3a3a38\", ha=\"center\")\n    fig.tight_layout(rect=(0, 0.07, 1, 1))\n    path.parent.mkdir(parents=True, exist_ok=True)\n    fig.savefig(path, dpi=140, facecolor=\"white\")\n    plt.close(fig)\n    return path\n\n\n'''\nsrc = src[:old_start] + new + src[old_end:]\nsrc = src.replace('''    fig_path = figure(cells, peaks, deg_target=deg_target)''',\n'''    excess_target = {g: calibrate(peaks, \"excess\", g) for g in (\"fixed\", \"bernoulli\")}\n    fig_path = figure(cells, peaks, deg_target=deg_target, excess_target=excess_target)''')\nsrc = src.replace('''\"thresholds\": thr, \"deg_target\": deg_target}''', '''\"thresholds\": thr, \"deg_target\": deg_target, \"excess_target\": excess_target}''')\nopen('learning/ridge_theory.py','w').write(src)\nEOF\ntail -2 learning/data/ensemble/ridge_cliques.log; wc -l learning/data/ensemble/ridge_clique_excess.csv 2>/dev/null","description":"Rewrite figure function; check clique run"}},"wire_ingest_context":{"toolu_019VFLKg3o3vKe6BcrgMjQQN":{"cwd":"/home/al/dev/MOSP"}}}
