odes_csearch\": 10 ** (a + b * n) - (1 if minus_one else 0),\n                         \"status_default\": \"unsat\", \"status_csearch\": \"unsat\", \"col_mean\": 3.0,\n                         \"g_components\": 1, \"complete_graph\": False, \"graph_cert\": f\"c{n}{i}\", \"row_mean\": 3.0,\n                         \"total_seconds\": 0.1})\n====FIG\n576:    import matplotlib\n577:    matplotlib.use(\"Agg\")\n578:    import matplotlib.pyplot as plt\n579:    from matplotlib.colors import Normalize\n588:    fig, axes = plt.subplots(2, 4, figsize=(17, 8.2), gridspec_kw={\"height_ratios\": [1, 1.15]})\n590:    cmap = plt.get_cmap(\"Blues\")\n633:    ramp = plt.get_cmap(\"Blues\")\n699:    fig.savefig(path, dpi=150, facecolor=fig.get_facecolor())\n700:    plt.close(fig)\nconcentration.png\nhardness_map.png\ninstance_space.png\nscale_test.png\n====DEG\n94:def refutation_kwargs(instance: MOSPInstance, config: str) -> dict:\n95-    \"\"\"The keyword arguments `decide` gets under a named configuration.\"\"\"\n96-    if config == \"default\":\n97-        return {}\n98-    if config == \"csearch\":\n99-        from satisfiability.customer_search import sparse_enough_for_better_move\n100-\n101-        return {\"better_move\": sparse_enough_for_better_move(instance),\n102-                \"better_move_dominators\": 0}\n103-    raise ValueError(f\"unknown configuration {config!r}; one of {CONFIGS}\")\n104-\n105-\n106:def refute(instance: MOSPInstance, optimum: int, config: str = \"default\",\n107-           deadline_seconds: float | None = None) -> dict:\n108-    \"\"\"Decide `optimum - 1` once and return what it cost.\n109-\n110-    `status` is `\"unsat\"` when the search agrees the value is optimal, `\"sat\"`\n111-    when the stored optimum is wrong (the search found a better order), and\n112-    `\"unknown\"` when the deadline expired. `nodes` is always a count, including\n113-    on a timeout: a censored observation still says how far the search got.\n114-    \"\"\"\n115-    