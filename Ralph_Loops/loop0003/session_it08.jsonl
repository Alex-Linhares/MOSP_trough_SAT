\n            return None\n        # `cs_decide_fan` is `cs_decide` plus the fan-order flag; the C keeps\n        # the old entry point for processes that loaded the library before\n        # the flag existed.\n        lib.cs_decide_fan.restype = ctypes.c_int\n        lib.cs_decide_fan.argtypes = [\n            ctypes.c_int, ctypes.c_int,                 # n, k\n            ctypes.POINTER(ctypes.c_uint64),            # neighbourhoods\n            ctypes.c_longlong, ctypes.c_double,         # max_nodes, seconds\n            ctypes.c_int, ctypes.c_int, ctypes.c_int,   # subset, definite, memo\n            ctypes.c_int, ctypes.c_longlong,            # restrict, memo_limit\n190:def mosp_lower_bound(instance: MOSPInstance, max_t: int = 4,\n191-                     time_budget: float | None = 5.0) -> int:\n192-    \"\"\"The bound alone, for callers that do not want the evidence.\"\"\"\n193-    return expansion_bound(instance, max_t=max_t, time_budget=time_budget).value\n41:def _lower_bound(\n42-    instance: MOSPInstance,\n43-    clique_budget: float = 5.0,\n44-    expansion_t: int = 8,\n45-    expansion_budget: float | None = None,\n46-) -> int:\n47-    \"\"\"Compute a lower bound on MOSP from the largest clique found.\n48-\n49-    In the MOSP graph (nodes are customers, an edge iff some pattern is\n50-    required by both — Yanasse 1997c), any clique C forces |C| simultaneously\n51-    open stacks:\n52-\n53-        Let c be the customer of C that closes earliest. Every other c' in C\n54-        shares some pattern p with c. Since c closes at step t, all of c's\n55-        patterns including p are produced by t, so c' has opened by t; and c'\n56-        closes after c. So every customer of C is open at step t.\n57-\n58-    Hence MOSP >= omega(G). This argument is direct and does not rely on the\n59-    MOSP = pathwidth + 1 equality.\n60-\n61-    Each pattern is itself a clique, so the maximum patterns-per-customer count\n62-    is the special case of this bound over sing