 min-fill certified (from §6): 10/17; now:\\\", (g[g.n_customers<=20].pw_gt_tw==\\\"yes\\\").sum())\\ngapall=c[(c.n_customers<=20)&c.tw_exact]; print(\\\"n<=20 corpus: pw>tw on\\\", (gapall.pw>gapall.tw_lo).sum(), \\\"of\\\", len(gapall))\\nj=pd.concat([pd.read_csv(p) for p in sorted(ex.ENSEMBLE.glob(\\\"extremal_jobs*.csv\\\"))]); print(\\\"jobs\\\", len(j), \\\"evals\\\", j.evaluations.sum(), \\\"hours\\\", round(j.seconds.sum()/3600,2))\\nprint(j.groupby(\\\"objective\\\").agg(evals=(\\\"evaluations\\\",\\\"sum\\\"), hours=(\\\"seconds\\\", lambda s: round(s.sum()/3600,2))))\\nprint(\\\"disagree max\\\", j[j.objective==\\\"disagree\\\"].best_value.max(), \\\"any disagree in any objective's best:\\\", (j.best_disagree>0).sum())\\nEOF\\ntimeout 900 python -m pytest tests/ -q -x 2>&1 | tail -2\",\"description\":\"File sizes, final numbers, full test suite\",\"timeout\":900000},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":32,\"cache_creation_input_tokens\":1909,\"cache_read_input_tokens\":216568,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1909,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"1a1aa369-628d-42d0-acdd-5e46ea204a37\",\"uuid\":\"cdecc539-4a0d-4e5e-9a43-a0e76df5b42f\",\"timestamp\":\"2026-09-26T16:52:54.677Z\",\"request_id\":\"req_011CfSQ48BpsmnkTsr1F4rz3\",\"wire_tool_inputs\":{\"toolu_016V2BUk3PUUMgxfZ4o6ivUC\":{\"command\":\"cd /home/al/dev/MOSP && du -ch learning/data/ensemble/extremal_* | tail -1; ls -la learning/data/ensemble/extremal_*; du -sh --apparent-size learning/data/ensemble; git status --short | grep -v Ralph_Loops; python - <<'EOF'\\nimport pandas as pd\\nfrom learning import extremal as ex\\nb=pd.read_csv(ex.BEST_CSV)\\nprint(b.pivot(index=\\\"n\\\