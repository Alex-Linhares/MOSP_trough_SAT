<'EOF'\nimport time, numpy as np\nfrom learning.ensemble import Cell, generate\nfrom learning.degeneracy import Compact, closing_weights, lattice_minimum\nfrom learning.graph_story import recover, relabel, same_labelled_graph\ninst = generate(Cell(\"bernoulli\", 15, 30, 0.2), 3)\nt=time.time(); comp = Compact(inst); s, c = closing_weights(comp); print(\"weights\", time.time()-t, comp.a)\nt=time.time(); print(lattice_minimum(s, comp.a), lattice_minimum(c, comp.a), time.time()-t)\nt=time.time(); r = recover(inst, \"greedy\", 0); print(\"greedy\", time.time()-t, r is not None and same_labelled_graph(inst, r))\ninst40 = generate(Cell(\"fixed\", 40, 40, 3), 3)\nt=time.time(); r = recover(inst40, \"greedy\", 0); print(\"greedy40\", time.time()-t, r is not None and same_labelled_graph(inst40, r))\nfrom satisfiability.customer_search import decide\nt=time.time(); \nfor _ in range(100): decide(inst40, 5)\nprint(\"decide overhead x100\", time.time()-t)\nEOF","description":"Time the oracle, re-covering and decide overhead"}},"wire_ingest_context":{"toolu_013ghNvNsV5dXQMJhCTWrejt":{"cwd":"/home/al/dev/MOSP"}}}
