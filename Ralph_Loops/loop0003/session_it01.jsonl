\n    restrict: bool = False,\n    subset_rule: bool = True,\n    definite_move: bool = True,\n    old_move: bool = True,\n    memo: bool = True,\n    max_nodes: int | None = None,\n    deadline: float | None = None,\n    memo_limit: int = 4_000_000,\n    native: bool = True,\n    branch: \"Callable[[int, int, list[tuple[int, int]]], list[tuple[int, int]]] | None\" = None,\n    expansion_prune: bool = False,\n    **kwargs: object,\n) -> Decision:\n    \"\"\"Decide \"MOSP(instance) <= k?\" by searching customer closing orders.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
