{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NpdjzQLoCNo7mPNpo9TNYB","type":"tool_result","content":"70:ENSEMBLE_DIR = Path(\"learning/data/ensemble\")\n71:RESULTS_CSV = ENSEMBLE_DIR / \"results.csv\"\n72:RECOVER_CSV = ENSEMBLE_DIR / \"recover.csv.gz\"\n73:RELABEL_CSV = ENSEMBLE_DIR / \"relabel.csv.gz\"\n74:LATTICE_CSV = ENSEMBLE_DIR / \"recover_lattice.csv\"\n75:RECOVER_SOLUTIONS = ENSEMBLE_DIR / \"recover_solutions\"\n76:CANONICAL_CSV = Path(\"learning/data/canonical.csv\")\n77:NODE_COUNTS_CSV = Path(\"learning/data/node_counts.csv\")\n78:TABLES = Path(\"reports/graph_story_tables.md\")\n80:METHODS = (\"split\", \"merge\", \"greedy\")\n81:CONFIGS = (\"default\", \"csearch\")\n82:BASE_SIZES = (10, 15, 20, 25, 30, 35, 40)\n83:LATTICE_MAX_N = 15\n92:GRAPH_ONLY_INVARIANTS = (\"tw_min_fill\", \"tw_min_degree\", \"bw_rcm\", \"spectral_radius\",\n94:GRAPH_ONLY_BOUNDS = (\"lb_contraction\",)\n97:def feature_sets(with_optimum: bool = True) -> dict[str, list[str]]:\n112:def _masks(instance: MOSPInstance) -> list[int]:\n118:def _columns(matrix: np.ndarray) -> list[tuple[int, ...]]:\n122:def _edge_cover(columns: list[tuple[int, ...]]) -> dict[tuple[int, int], int]:\n131:def _is_clique(vertices, masks: list[int]) -> bool:\n140:def _from_columns(columns: list[tuple[int, ...]], n: int, name: str) -> MOSPInstance:\n147:def split_product(instance: MOSPInstance, rng: np.random.Generator, name: str) -> MOSPInstance | None:\n181:def merge_products(instance: MOSPInstance, rng: np.random.Generator, name: str) -> MOSPInstance | None:\n213:def greedy_recover(instance: MOSPInstance, rng: np.random.Generator, name: str) -> MOSPInstance:\n244:def recover(instance: MOSPInstance, method: str, k: int) -> MOSPInstance | None:\n266:def relabel(instance: MOSPInstance, k: int) -> tuple[MOSPInstance, np.ndarray]:\n276:def same_labelled_graph(a: MOSPInstance, b: MOSPInstance) -> bool:\n285:def _generate_base(row) -> MOSPInstance:\n292:def select_bases(results: pd.DataFrame, per_n: int = 60, sizes=BASE_SIZES,\n316:def _refute_both(instance: MOSPInstance, optimum: int, deadline: float | None) -> dict:\n329:def _recover_job(args) -> list[dict]:\n382:def _relabel_job(args) -> list[dict]:\n398:def _lattice_job(args) -> list[dict]:\n424:def _pool_map(fn, jobs, workers: int):\n434:def _write(rows: list[dict], csv: Path) -> pd.DataFrame:\n441:def run_recover(bases: pd.DataFrame, workers: int, per_method: int = 3,\n454:def run_relabel(bases: pd.DataFrame, workers: int, per_base: int = 10,\n463:def run_lattice(bases: pd.DataFrame, workers: int, per_method: int = 3,\n478:def _log_ratio(new: pd.Series, base: pd.Series) -> pd.Series:\n482:def paired_table(frame: pd.DataFrame) -> pd.DataFrame:\n----\ndef relabel(instance: MOSPInstance, k: int) -> tuple[MOSPInstance, np.ndarray]:\n    \"\"\"Rows permuted (customers renamed), columns too; same matrix class.\"\"\"\n    seed = zlib.crc32(f\"{instance.name}|relabel|{k}\".encode())\n    rng = np.random.default_rng(seed)\n    perm = rng.permutation(instance.n_customers)\n    cols = rng.permutation(instance.n_patterns)\n    matrix = np.asarray(instance.matrix)[perm][:, cols]\n    return MOSPInstance.from_matrix(matrix, name=f\"{instance.name}__relabel{k}\"), perm\n\n\ndef same_labelled_graph(a: MOSPInstance, b: MOSPInstance) -> bool:\ndef relabel_table(frame: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Per size: how much the node count moves under a random relabelling of\n    the same matrix -- the floor for any label-free predictor.\"\"\"\n    rows = []\n    for n, d in frame.groupby(\"n\"):\n        rec = {\"n\": n, \"bases\": d.base_name.nunique(), \"relabellings\": int((d.k >= 0).sum())}\n        for config in CONFIGS:\n            col = f\"nodes_{config}\"\n            g = d.groupby(\"base_name\")[col]\n            base = d[d.k < 0].set_index(\"base_name\")[col]\n            lo, hi = g.min(), g.max()\n            spread = np.log10(1.0 + hi.astype(float)) - np.log10(1.0 + lo.astype(float))\n            logs = np.log10(1.0 + d[col].astype(float))\n            within_std = logs.groupby(d.base_name).std(ddof=0)\n            dev = (logs - logs.groupby(d.base_name).transform(\"median\")).abs()\n            rec[f\"{config}: bases with any change\"] = int((hi != lo).sum())\n            rec[f\"{config}: max/min ratio median\"] = float((10 ** spread).median())\n            rec[f\"{config}: max/min ratio p90\"] = float((10 ** spread).quantile(0.9))\n            rec[f\"{config}: max/min ratio max\"] = float((10 ** spread).max())\n            rec[f\"{config}: within-base std log10\"] = float(within_std.mean())\n            rec[f\"{config}: MAD log10 (floor)\"] = float(dev.mean())\n            rec[f\"{config}: base nodes median\"] = float(base.median())\n        rows.append(rec)\n    return pd.DataFrame(rows)\n\n\ndef lattice_table(frame: pd.DataFrame) -> pd.DataFrame:","is_error":false}]},"parent_tool_use_id":null,"session_id":"30535d1e-d827-4beb-9156-6f6f8f09fdc9","uuid":"1a63efda-eef5-4663-a1f4-32f77be48633","timestamp":"2026-09-26T12:56:49.308Z","tool_use_result":{"stdout":"70:ENSEMBLE_DIR = Path(\"learning/data/ensemble\")\n71:RESULTS_CSV = ENSEMBLE_DIR / \"results.csv\"\n72:RECOVER_CSV = ENSEMBLE_DIR / \"recover.csv.gz\"\n73:RELABEL_CSV = ENSEMBLE_DIR / \"relabel.csv.gz\"\n74:LATTICE_CSV = ENSEMBLE_DIR / \"recover_lattice.csv\"\n75:RECOVER_SOLUTIONS = ENSEMBLE_DIR / \"recover_solutions\"\n76:CANONICAL_CSV = Path(\"learning/data/canonical.csv\")\n77:NODE_COUNTS_CSV = Path(\"learning/data/node_counts.csv\")\n78:TABLES = Path(\"reports/graph_story_tables.md\")\n80:METHODS = (\"split\", \"merge\", \"greedy\")\n81:CONFIGS = (\"default\", \"csearch\")\n82:BASE_SIZES = (10, 15, 20, 25, 30, 35, 40)\n83:LATTICE_MAX_N = 15\n92:GRAPH_ONLY_INVARIANTS = (\"tw_min_fill\", \"tw_min_degree\", \"bw_rcm\", \"spectral_radius\",\n94:GRAPH_ONLY_BOUNDS = (\"lb_contraction\",)\n97:def feature_sets(with_optimum: bool = True) -> dict[str, list[str]]:\n112:def _masks(instance: MOSPInstance) ->