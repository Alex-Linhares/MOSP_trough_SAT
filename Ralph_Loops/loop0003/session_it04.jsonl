ows_csv, index=False, compression=\"gzip\")\n    summary.to_csv(summary_csv, index=False)\n    return frame, summary\n\n\n# ----------------------------------------------------------------------------\n# tables\n# ----------------------------------------------------------------------------\n\n\ndef _band(n: int) -> str:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
