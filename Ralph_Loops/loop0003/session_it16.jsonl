{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K4jmm4DX2PejG7mXBFQw3D","type":"tool_result","content":"def compute_pathwidth(G: nx.Graph) -> tuple[int, list[int]]:\n    \"\"\"Compute the exact pathwidth and a witness linear ordering.\n\n    Args:\n        G: A NetworkX graph.\n\n    Returns:\n        (pathwidth, ordering) where ordering is a list of vertices\n        achieving the optimal vertex separation = pathwidth.\n\n    Raises:\n        ValueError: If the graph has more than 25 vertices.\n    \"\"\"\n    nodes = sorted(G.nodes())\n    n = len(nodes)\n\n    if n == 0:\n        return 0, []\n    if n == 1:\n        return 0, list(nodes)\n\n---\n67:HAVE_NAUTY = _pynauty is not None\n68-DATA_DIR = Path(\"learning/data\")\n69-DEFAULT_CSV = DATA_DIR / \"canonical.csv\"\n70-WL_ITERATIONS = 3\n71-\n72-__all__ = [\n73-    \"HAVE_NAUTY\",\n--\n114:def wl_hash(adjacency: dict[int, list[int]], iterations: int = WL_ITERATIONS) -> str:\n115-    \"\"\"Weisfeiler--Lehman hash of the MOSP graph. Isolated nodes count.\"\"\"\n116-    graph = nx.Graph()\n117-    graph.add_nodes_from(adjacency)\n118-    graph.add_edges_from((u, v) for u, vs in adjacency.items() for v in vs if u < v)\n119-    return nx.weisfeiler_lehman_graph_hash(graph, iterations=iterations)\n120-\n--\n126:def nauty_graph_certificate(adjacency: dict[int, list[int]]) -> str | None:\n127-    \"\"\"Level 3: canonical certificate of the MOSP graph, or None without nauty.\n128-\n129-    nauty's certificate is canonical among graphs on the same number of\n130-    vertices, so the vertex count is folded into the digest.\n131-    \"\"\"\n132-    if not HAVE_NAUTY:\n---\nb'Bg\\n'\n1253\n>A nauty-geng -d0D9 n=10 e=0-45\n>Z 12005168 graphs generated in 1.62 sec\n\nreal\t0m1.620s\nuser\t0m1.618s\nsys\t0m0.002s","is_error":false}]},"parent_tool_use_id":null,"session_id":"f1c5ce58-56d5-4562-84ae-5b3ca08c38a5","uuid":"3e93b9d9-8a25-4d03-8ac0-4a44e6ef9bbd","timestamp":"2026-09-26T19:39:17.908Z","tool_