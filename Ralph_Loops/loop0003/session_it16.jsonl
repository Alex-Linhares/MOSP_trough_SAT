.argtypes = [ctypes.c_int, ctypes.POINTER(ctypes.c_uint64),\n                                  ctypes.c_int, ctypes.c_longlong, ctypes.c_longlong,\n                                  ctypes.POINTER(ctypes.c_int),\n                                  ctypes.POINTER(ctypes.c_longlong)]\n        _library = lib\n        return lib\n\n\n# ----------------------------------------------------------------------------\n# adjacency helpers\n# ----------------------------------------------------------------------------\n\n\ndef masks_from_graph(graph) -> list[int]:\n    \"\"\"Neighbour bitmasks of a networkx graph whose nodes are 0..n−1 (self excluded).\"\"\"\n    n = graph.number_of_nodes()\n    masks = [0] * n\n    for u, v in graph.edges():\n        if u == v:\n            continue\n        masks[u] |= 1 << v\n        masks[v] |= 1 << u\n    return masks\n\n\ndef masks_from_matrix(matrix) -> list[int]:\n    \"\"\"Neighbour bitmasks of the MOSP graph of a customer × product 0/1 matrix.\"\"\"\n    import numpy as np\n\n    m = np.asarray(matrix, dtype=np.int64)\n    n = m.shape[0]\n    masks = [0] * n\n    for col in range(m.shape[1]):\n        members = [int(i) for i in np.flatnonzero(m[:, col])]\n        bits = 0\n        for i in members:\n            bits |= 1 << i\n        for i in members:\n            masks[i] |= bits & ~(1 << i)\n    return masks","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
