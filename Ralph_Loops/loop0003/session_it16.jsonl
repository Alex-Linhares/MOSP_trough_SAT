(minimal[mcols]) if not minimal.empty else \"(none)\", \"\"]\n                drawn = pd.concat([small, minimal.head(40)])\n            else:\n                drawn = small\n        else:\n            drawn = small\n        for rec in drawn.itertuples(index=False):\n            lines += [f\"### n = {rec.n}, `{rec.graph6}`\", \"\", \"```\", *_draw(rec.graph6), \"```\", \"\"]\n            if hasattr(rec, \"matrix_key\") and isinstance(rec.matrix_key, str):\n                lines += [\"MOSP instance (products = maximal cliques):\", \"\", \"```\",\n                          *(\" \".join(r) for r in rec.matrix_key.split(\"/\")), \"```\", \"\"]"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":644,"cache_read_input_tokens":189644,"cache_creation":{"ephemeral_5m_input_tokens":644,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f1c5ce58-56d5-4562-84ae-5b3ca08c38a5","uuid":"84553fc9-f497-4e91-b64c-d8c936a28df0","timestamp":"2026-09-26T20:14:55.217Z","request_id":"req_011CfSfTwHQeWNqaMLinvvPV","wire_tool_inputs":{"toolu_01Ax7K8AjdAggVpjkh33mUA9":{"file_path":"/home/al/dev/MOSP/learning/pwtw_exhaust.py","old_string":"    if not found.empty:\n        lines += [\"## Every graph with pw − tw ≥ 2\", \"\", _md(found[cols]), \"\",\n                  \"## Subgraph containment among the graphs found (row ⊆ column)\", \"\",\n                  _md(containment_table(found)), \"\"]\n        for rec in found.itertuples(index=False):\n            lines += [f\"### n = {rec.n}, `{rec.graph6}`\", \"\", \"```\", *_draw(rec.graph6), \"```\", \"\"]\n            if hasattr(rec, \"matrix_key\") and isinstance(rec.matrix_key, str):\n                lines += [\"MOSP instance (products = maximal cliques):\", \"\", \"```\",\n 