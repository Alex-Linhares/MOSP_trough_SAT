{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q7KEyACM6PunSeQkKSgw5i","type":"tool_result","content":"/-- `G − X`: every edge at a vertex of `X` deleted, `X` kept isolated. -/\ndef isolateSet (G : SimpleGraph V) (X : Finset V) : SimpleGraph V where\n  Adj a b := G.Adj a b ∧ a ∉ X ∧ b ∉ X\n  symm := ⟨fun _ _ ⟨h, ha, hb⟩ => ⟨h.symm, hb, ha⟩⟩\n  loopless := ⟨fun a h => G.loopless.irrefl a h.1⟩\n\ninstance instDecidableRelIsolateSetAdj (G : SimpleGraph V) [DecidableRel G.Adj] (X : Finset V) :\n    DecidableRel (isolateSet G X).Adj :=\n  fun a b => inferInstanceAs (Decidable (G.Adj a b ∧ a ∉ X ∧ b ∉ X))\n\ntheorem isolateSet_adj (G : SimpleGraph V) (X : Finset V) (a b : V) :\n    (isolateSet G X).Adj a b ↔ G.Adj a b ∧ a ∉ X ∧ b ∉ X := Iff.rfl\n\ntheorem isolateSet_le (G : SimpleGraph V) (X : Finset V) : isolateSet G X ≤ G :=\n  fun _ _ h => h.1\n\ntheorem isolateSet_empty (G : SimpleGraph V) : isolateSet G ∅ = G := by\n  ext a b; simp [isolateSet_adj]\n\ntheorem isolateSet_singleton (G : SimpleGraph V) (w : V) : isolateSet G {w} = isolate G w := by\n  ext a b; simp [isolateSet_adj, isolate_adj]\n\n331:theorem exists_adj (h : SPStep G v H) : ∃ x, G.Adj v x := by\n332-  cases h with\n333-  | pendant hx _ => exact ⟨_, hx⟩\n334-  | suppress hx _ _ _ _ => exact ⟨_, hx⟩\n464:theorem ndeg_eq_zero (h : SPReduces G H) {u : V} (hu : ndeg G u = 0) : ndeg H u = 0 :=\n465-  Nat.le_zero.1 (hu ▸ h.ndeg_le u)\n466-\n---MATHLIB\n140:lemma edge_adj (v w : V) : (edge s t).Adj v w ↔ (v = s ∧ w = t ∨ v = t ∧ w = s) ∧ v ≠ w := by\n141-  rw [edge, fromEdgeSet_adj, Set.mem_singleton_iff, Sym2.eq_iff]\n142-\nlean/.lake/packages/mathlib/Mathlib/Data/Finset/Card.lean:598:theorem card_sdiff_of_subset (h : s ⊆ t) : #(t \\ s) = #t - #s := by\nlean/.lake/packages/mathlib/Mathlib/Data/Finset/Card.lean:603:theorem card_sdiff : #(t \\ s) = #t - #(s ∩ t) := by\n1796:theorem tree_pathwidth_le_log (T : SimpleGraph V) (hT : T.IsTree) :\n1797-    pathwidth T ≤ Nat.log 3 (2 * Fintype.card V + 1) := by\n1798-  set k := Nat.log 3 (2 * Fintype.card V + 1) with hk\n---TESTTEMPLATE\ndef test_pathwidth_assembly_proved_names_are_theorems_in_the_lean_file():\n    \"\"\"Every name `learning.sandwich` audits for `Pathwidth.lean` is declared there as a\n    theorem (namespaces resolved); the file has no `sorry` and no `axiom`; the two hypotheses\n    are `def … : Prop` and are never asserted (no `theorem` or `instance` proving them); the\n    root module imports the file; `paper1/axiom_check.lean` prints the axioms of every\n    theorem; the final theorems carry exactly the hypotheses the report's table lists.\"\"\"\n    import learning.sandwich as sw\n    src = PATHWIDTH_LEAN.read_text()\n    code = re.sub(r\"/-.*?-/\", \"\", src, flags=re.S)\n    ns, declared, defs = [], set(), set()\n    for line in code.splitlines():\n        m = re.match(r\"^namespace\\s+(\\S+)\", line)\n        if m:\n            ns.append(m.group(1))\n            continue\n        m = re.match(r\"^end\\s+(\\S+)\", line)\n        if m and ns and ns[-1] == m.group(1):\n            ns.pop()\n            continue\n        m = re.match(r\"^theorem\\s+([^\\s:({\\[]+)\", line)\n        if m:\n            declared.add(\".\".join(ns[1:] + [m.group(1)]))\n        m = re.match(r\"^def\\s+([^\\s:({\\[]+)\", line)\n        if m:\n            defs.add(m.group(1))\n    assert set(sw.PATHWIDTH_ASSEMBLY_PROVED) == {\"DegreeBound.\" + n for n in declared}\n    assert len(sw.PATHWIDTH_ASSEMBLY_PROVED) == len(declared) == 21\n    assert set(sw.PATHWIDTH_ASSEMBLY_PROVED) <= set(sw.ALL_PROVED)\n    assert defs == {\"CubicPathwidthBound\", \"ReductionPathwidthBound\"}\n    assert \"def CubicPathwidthBound (τ : ℕ → ℚ) : Prop :=\" in src\n    assert \"def ReductionPathwidthBound (ρ : ℕ → ℚ) : Prop :=\" in src\n    code = re.sub(r\"--.*\", \"\", code)\n    assert \"sorry\" not in code\n    assert not re.search(r\"^\\s*axiom\\b\", code, re.M)\n    assert not re.search(r\"^\\s*instance\\b\", code, re.M)\n    # the hypotheses are never concluded: no statement has them to the right of its last `:`\n    for thm in re.findall(r\"^theorem\\s[\\s\\S]*?:= by\", code, re.M):\n        head = thm.split(\":=\")[0]\n        conclusion = head.split(\" :\\n\")[-1] if \" :\\n\" in head else head.rsplit(\":\", 1)[-1]\n        assert \"CubicPathwidthBound\" not in conclusion and \\\n            \"ReductionPathwidthBound\" not in conclusion, thm[:80]\n    root = (PATHWIDTH_LEAN.parents[2] / \"MOSPFormalization.lean\").read_text()\n    assert \"import MOSPFormalization.DegreeBound.Pathwidth\\n\" in root\n    axioms = (PATHWIDTH_LEAN.parents[3] / \"paper1\" / \"axiom_check.lean\").read_text()\n    for n in sw.PATHWIDTH_ASSEMBLY_PROVED:\n        assert f\"#print axioms MOSPFormalization.{n}\\n\" in axioms, n\n    for n in (\"pathwidth_le_potentialMinus_of_hypotheses\", \"pathwidth_le_degreeSum_of_hypotheses\",\n              \"pathwidth_le_histogram_of_hypotheses\", \"pathwidth_basic_le\", \"pathwidth_bot\",\n              \"pathwidth_le_pathwidth_isolateSet_add_card\"):\n        assert f\"DegreeBound.{n}\" in sw.PATHWIDTH_ASSEMBLY_PROVED\n    hyp = \"(h1 : CubicPathwidthBound.{u} τ)\\n    (h3 : ReductionPathwidthBound.{u} ρ) \" \\\n          \"(hτ : Monotone τ) (hτ0 : ∀ n, 0 ≤ τ n)\"\n    assert src.count(hyp) == 7\n    assert \"+ τ (Fintype.card V) + 2 * ρ (Fintype.card V) + 1\" in src\n    assert \"+ τ (Fintype.card V) + 3 * ρ (Fintype.card V) + 1\" in src\n\n\n# --- item 10: the write-up --------------------------------------------------\n# (`reports/edwards_mcdermid.md` §0 and §10; the paper's Appendix A rows and\n# Appendix E paragraph; four references with DOIs checked by `check_refs`.)\n\n---SANDWICH\nPATHWIDTH_ASSEMBLY_PROVED = (\n    \"DegreeBound.ReductionPathwidthBound.nonneg\",\n    \"DegreeBound.pathwidth_bot\",\n    \"DegreeBound.pathwidth_induce_compl_le_isolateSet\",\n    \"DegreeBound.pathwidth_le_pathwidth_isolateSet_add_card\",\n    \"DegreeBound.pathwidth_le_pathwidth_isolate_add_one\",\n    \"DegreeBound.pathwidth_le_rat_of_forall_connected\",\n    \"DegreeBound.coe_compFinset\",\n    \"DegreeBound.connected_induce_compFinset\",\n    \"DegreeBound.degree_induce_of_forall_adj_mem\",\n    \"DegreeBound.degree_induce_compFinset\",\n    \"DegreeBound.subset_compFinset_of_connected\",\n    \"DegreeBound.pathwidth_induce_compFinset_le_restrict\",\n    \"DegreeBound.induce_eq_bot_of_forall_degree_eq_zero\",\n    \"DegreeBound.compPotential_le_potentialMinus\",\n    \"DegreeBound.pathwidth_induce_compFinset_le\",\n    \"DegreeBound.pathwidth_basic_le\",\n    \"DegreeBound.pathwidth_le_of_isReductionSet\",\n    \"DegreeBound.pathwidth_le_potentialMinus_of_hypotheses\",\n    \"DegreeBound.pathwidth_le_potential_of_hypotheses\",\n    \"DegreeBound.pathwidth_le_degreeSum_of_hypotheses\",\n    \"DegreeBound.pathwidth_le_histogram_of_hypotheses\",\n)\n#: Every proved name the axiom check asks for.\nALL_PROVED = (PROVED + FOREST_COVER_PROVED + PENDANT_PROVED + SEPARATOR_PROVED + DEGREE_BOUND_PROVED\n              + CUT_LEMMA_PROVED + POTENTIAL_PROVED + SP_REDUCTION_PROVED + STEP_PROVED\n              + REDUCTION_THEOREM_PROVED + PATHWIDTH_ASSEMBLY_PROVED)\n#: Statements committed with `sorry`: none since 2026-10-31.\n---PY\ndef reduce(adj: list[int]) -> tuple[list[int], int]:\n    \"\"\"The reduced graph `r(G)` of paper Section 3.2, on the same vertex set\n    with the removed vertices isolated, and the mask of removed vertices.\n\n    The four operations, applied while a vertex of degree ≤ 2 remains:\n    (1) delete an isolated vertex; (2) delete a vertex of degree 1; (3) a vertex\n    of degree 2 with non-adjacent neighbours `x, y`: delete it and add `xy`;\n    (4) a vertex of degree 2 with adjacent neighbours: delete it. Here an\n    already-isolated vertex is left in place (it is \"deleted\" in the paper's\n    sense: it contributes nothing), and a vertex that becomes isolated is\n    recorded as removed. The result is unique (the paper, p. 8) so the order\n    in which the bucket is drained does not matter for the output.\n\n    Linear in the number of steps: degrees are kept in an array and only the\n    neighbours of the deleted vertex are touched.\n    \"\"\"\n    n = len(adj)\n    adj = list(adj)\n    deg = [a.bit_count() for a in adj]\ndef step_vertices(adj: list[int]) -> list[int]:\n    \"\"\"The vertices at which an `SPStep` applies: degree 1 or 2. (A vertex of\n    degree 0 is already \"deleted\"; isolating it would be the identity, which is\n    why the Lean step relation is defined for degrees 1 and 2 only.)\"\"\"\n    return [v for v in range(len(adj)) if 1 <= adj[v].bit_count() <= 2]\n\n\ndef sp_step(adj: list[int], v: int) -> list[int]:\n    \"\"\"One series-parallel operation at `v` (degree 1 or 2): operation 2 deletes\n    a degree-1 vertex; operation 3 suppresses a degree-2 vertex with\n    non-adjacent neighbours `x, y` (adds `xy`); operation 4 deletes a degree-2\n    vertex with adjacent neighbours. The removed vertex is left isolated.\"\"\"\n    d = adj[v].bit_count()\n    if d not in (1, 2):\n        raise ValueError(f\"no series-parallel step at a vertex of degree {d}\")\n    nb = adj[v]\n    out = isolate(adj, v)\n    if d == 2:\n        low = nb & -nb\n        x = low.bit_length() - 1\n        y = (nb ^ low).bit_length() - 1\n        if not (adj[x] >> y) & 1:\n            out[x] |= 1 << y\n            out[y] |= 1 << x\n    return out\n\n\ndef reduce_random(adj: list[int], rng) -> list[int]:\ndef parse_g6(line: str) -> tuple[int, list[int]]:\n    \"\"\"A graph6 line (`nauty-geng` output) as `(n, adjacency bit masks)`.\"\"\"\n    b = line.strip().encode()\n    n = b[0] - 63\n    bitlist: list[int] = []\n    for ch in b[1:]:\n        v = ch - 63\n        bitlist += [(v >> i) & 1 for i in range(5, -1, -1)]\n    adj = [0] * n\n    k = 0\n    for j in range(1, n):\n        for i in range(j):\n            if bitlist[k]:\n                adj[i] |= 1 << j\n                adj[j] |= 1 << i\n            k += 1\n    return n, adj","is_error":false}]},"parent_tool_use_id":null,"session_id":"729a31ea-6900-48bd-999c-66286e063162","uuid":"f5a0de3c-cd0b-446d-a7e1-68bb47c99f5b","timestamp":"2026-11-02T07:01:00.399Z","tool_use_result":{"stdout":"/-- `G − X`: every edge at a vertex of `X` deleted, `X` kept isolated. -/\ndef isolateSet (G : SimpleGraph V) (X : Finset V) : SimpleGraph V where\n  Adj a b := G.Adj a b ∧ a ∉ X ∧ b ∉ X\n  symm := ⟨fun _ _ ⟨h, ha, hb⟩ => ⟨h.symm, hb, ha⟩⟩\n  loopless := ⟨fun a h => G.loopless.irrefl a h.1⟩\n\ninstance instDecidableRelIsolateSetAdj (G : SimpleGraph V) [DecidableRel G.Adj] (X : Finset V) :\n    DecidableRel (isolateSet G X).Adj :=\n  fun a b => inferInstanceAs (Decidable (G.Adj a b ∧ a ∉ X ∧ b ∉ X))\n\ntheorem isolateSet_adj (G : SimpleGraph V) (X : Finset V) (a b : V) :\n    (isolateSet G X).Adj a b ↔ G.Adj a b ∧ a ∉ X ∧ b ∉ X := Iff.rfl\n\ntheorem isolateSet_le (G : SimpleGraph V) (X : Finset V) : isolateSet G X ≤ G :=\n  fun _ _ h => h.1\n\ntheorem isolateSet_empty (G : SimpleGraph V) : isolateSet G ∅ = G := by\n  ext a b; simp [isolateSet_adj]\n\ntheorem isolateSet_singleton (G : SimpleGraph V) (w : V) : isolateSet G {w} = isolate G w := by\n  ext a b; simp [isolateSet_adj, isolate_adj]\n\n331:theorem exists_adj (h : SPStep G v H) : ∃ x, G.Adj v x := by\n332-  cases h with\n333-  | pendant hx _ => exact ⟨_, hx⟩\n334-  | suppress hx _ _ _ _ => exact ⟨_, hx⟩\n464:theorem ndeg_eq_zero (h : SPReduces G H) {u : V} (hu : ndeg G u = 0) : ndeg H u = 0 :=\n465-  Nat.le_zero.1 (hu ▸ h.ndeg_le u)\n466-\n---MATHLIB\n140:lemma edge_adj (v w : V) : (edge s t).Adj v w ↔ (v = s ∧ w = t ∨ v = t ∧ w = s) ∧ v ≠ w := by\n141-  rw [edge, fromEdgeSet_adj, Set.mem_singleton_iff, Sym2.eq_iff]\n142-\nlean/.lake/packages/mathlib/Mathlib/Data/Finset/Card.lean:598:theorem card_sdiff_of_subset (h : s ⊆ t) : #(t \\ s) = #t - #s := by\nlean/.lake/packages/mathlib/Mathlib/Data/Finset/Card.lean:603:theorem card_sdiff : #(t \\ s) = #t - #(s ∩ t