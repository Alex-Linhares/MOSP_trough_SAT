set`, `degree_induce_compFinset`,\",\n              \"* Components: `connected_induce_compFinset`, `degree_induce_of_forall_adj_mem`,\\n  `degree_induce_compFinset`,\")\nopen(p, \"w\").write(s)\nEOF\ntime lake build MOSPFormalization.DegreeBound.Pathwidth 2>&1 | grep -v \"TreeBound\\|Hint\\|Note:\\|\\[apply\\]\\|^\\s*$\\|linter can be disabled\" | tail -30","description":"Replace the degree lemma with the bijection proof and rebuild","timeout":900000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":3720,"cache_read_input_tokens":261294,"cache_creation":{"ephemeral_5m_input_tokens":3720,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6b8bb938-d2d7-4b06-928c-41c6584adc85","uuid":"0031d9b3-d872-4121-9dbd-ae41ae4be1f7","timestamp":"2026-11-02T05:47:54.407Z","request_id":"req_011CgdaGt44X7C7LFWuRt6LC","wire_tool_inputs":{"toolu_013oe8nQvuxywnFhw1C2czjD":{"command":"cd /home/al/dev/MOSP/lean && python3 - <<'EOF'\nimport re\np = \"MOSPFormalization/DegreeBound/Pathwidth.lean\"\ns = open(p).read()\nold = s[s.index(\"/-- Degrees inside a component are the degrees in `G`\"):s.index(\"/-- A connected vertex set lies inside the component\")]\nnew = '''/-- Degrees in an induced subgraph: if every neighbour of `v` lies in `s`, the degree of `v` in\n`G[s]` is its degree in `G` (by the bijection `a ↦ ↑a` of neighbour finsets; Mathlib's\n`degree_induce_of_neighborSet_subset` is the same statement under a `DecidablePred`-built\n`Fintype` instance that does not unify with the one of a coerced finset). -/\ntheorem degree_induce_of_forall_adj_mem {s : Set V} [Fintype ↥s] (v : ↥s)\n    (h : ∀ u, G.Adj v u → u ∈ s) :\n    (G.induce s).degree v = G.degree v := by\n  rw [← SimpleGraph.card_neighb