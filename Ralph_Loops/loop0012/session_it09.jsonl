{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TyRQcu4mFjTZkdgTGa9xbk","type":"tool_result","content":"  · exact hf.injOn\n\nend PathDecomposition\n\n/-- An injective graph homomorphism `H →g G` (an isomorphism onto a subgraph of\n`G`) gives `pathwidth H ≤ pathwidth G`. -/\ntheorem pathwidth_le_of_injective {W : Type*} [Fintype W] [DecidableEq W]\n    {G : SimpleGraph V} {H : SimpleGraph W} (f : H →g G) (hf : Function.Injective f) :\n    pathwidth H ≤ pathwidth G :=\n  pathwidth_le_of_forall_decomposition fun P => ⟨P.comap f, P.comap_width_le f hf⟩\n\n/-- **Edge deletion**: a subgraph on the same vertices has no larger pathwidth. -/\ntheorem pathwidth_mono {G H : SimpleGraph V} (h : H ≤ G) : pathwidth H ≤ pathwidth G :=\n  pathwidth_le_of_injective ⟨id, fun hab => h hab⟩ Function.injective_id\n\n/-- **Vertex deletion**: an induced subgraph has no larger pathwidth. -/\ntheorem pathwidth_induce_le (G : SimpleGraph V) (S : Set V) [DecidablePred (· ∈ S)] :\n    pathwidth (G.induce S) ≤ pathwidth G :=\n  pathwidth_le_of_injective (SimpleGraph.Embedding.induce S).toHom Subtype.val_injective\n\n/-- Isomorphic graphs have equal pathwidth. -/\ntheorem pathwidth_eq_of_iso {W : Type*} [Fintype W] [DecidableEq W]\n    {G : SimpleGraph V} {H : SimpleGraph W} (e : G ≃g H) : pathwidth G = pathwidth H :=\n  le_antisymm (pathwidth_le_of_injective e.toEmbedding.toHom e.injective)\n    (pathwidth_le_of_injective e.symm.toEmbedding.toHom e.symm.injective)\n\n/-! ### Edge contraction -/\n\n/-- Contract `v` into `u`: `u` keeps its label and gains the neighbours of `v`,\nand `v` is left isolated. Matches `_contract(adj, alive, v, u)` in\n`pathwidth_solver/pathwidth/minor.py` on every vertex other than `v`. -/\ndef contractEdge (G : SimpleGraph V) (u v : V) : SimpleGraph V where\n  Adj x y := x ≠ y ∧ x ≠ v ∧ y ≠ v ∧\n    (G.Adj x y ∨ (x = u ∧ G.Adj v y) ∨ (y = u ∧ G.Adj v x))\n  symm := by\n    constructor\n    intro x y ⟨hxy, hx, hy, h⟩\n    refine ⟨hxy.symm, hy, hx, ?_⟩\n    rcases h with h | ⟨rfl, h⟩ | ⟨rfl, h⟩\n    · exact Or.inl h.symm\n    · exact Or.inr (Or.inr ⟨rfl, h⟩)\n    · exact Or.inr (Or.inl ⟨rfl, h⟩)\n  loopless := ⟨fun _ h => h.1 rfl⟩\n\n/-- Delete every edge at `v`, leaving it isolated: vertex deletion on a fixed\nvertex type (the code's step `(v, -1)`). -/\ndef isolate (G : SimpleGraph V) (v : V) : SimpleGraph V where\n  Adj x y := G.Adj x y ∧ x ≠ v ∧ y ≠ v\n  symm := ⟨fun _ _ ⟨h, hx, hy⟩ => ⟨h.symm, hy, hx⟩⟩\n  loopless := ⟨fun x h => G.loopless.irrefl x h.1⟩\n\ntheorem isolate_le (G : SimpleGraph V) (v : V) : isolate G v ≤ G := fun _ _ h => h.1\n\n----PW\nnamespace MOSPFormalization\n\nvariable {V : Type*} [Fintype V] [DecidableEq V]\nvariable (G : SimpleGraph V)\n\n/-- The pathwidth of a graph: minimum width over all path decompositions. -/\nnoncomputable def pathwidth : ℕ :=\n  sInf (Set.range (fun P : PathDecomposition G => P.width))\n\n/-- Pathwidth is at most the width of any specific decomposition. -/\ntheorem pathwidth_le_width (P : PathDecomposition G) :\n    pathwidth G ≤ P.width := by\n  apply Nat.sInf_le\n  exact ⟨P, rfl⟩\n\n/-- Pathwidth is at most `Fintype.card V - 1` (trivial decomposition). -/\ntheorem pathwidth_le_card_sub_one :\n    pathwidth G ≤ Fintype.card V - 1 := by\n  calc pathwidth G ≤ (PathDecomposition.trivial G).width := pathwidth_le_width G _\n    _ = Fintype.card V - 1 := PathDecomposition.trivial_width G\n\nend MOSPFormalization\n----SPR\n\n/-- `G − X`: every edge at a vertex of `X` deleted, `X` kept isolated. -/\ndef isolateSet (G : SimpleGraph V) (X : Finset V) : SimpleGraph V where\n  Adj a b := G.Adj a b ∧ a ∉ X ∧ b ∉ X\n  symm := ⟨fun _ _ ⟨h, ha, hb⟩ => ⟨h.symm, hb, ha⟩⟩\n  loopless := ⟨fun a h => G.loopless.irrefl a h.1⟩\n\ninstance instDecidableRelIsolateSetAdj (G : SimpleGraph V) [DecidableRel G.Adj] (X : Finset V) :\n    DecidableRel (isolateSet G X).Adj :=\n  fun a b => inferInstanceAs (Decidable (G.Adj a b ∧ a ∉ X ∧ b ∉ X))\n\ntheorem isolateSet_adj (G : SimpleGraph V) (X : Finset V) (a b : V) :\n    (isolateSet G X).Adj a b ↔ G.Adj a b ∧ a ∉ X ∧ b ∉ X := Iff.rfl\n\ntheorem isolateSet_le (G : SimpleGraph V) (X : Finset V) : isolateSet G X ≤ G :=\n  fun _ _ h => h.1\n\ntheorem isolateSet_empty (G : SimpleGraph V) : isolateSet G ∅ = G := by\n  ext a b; simp [isolateSet_adj]\n\ntheorem isolateSet_singleton (G : SimpleGraph V) (w : V) : isolateSet G {w} = isolate G w := by\n  ext a b; simp [isolateSet_adj, isolate_adj]\n\ntheorem isolateSet_insert (G : SimpleGraph V) (w : V) (X : Finset V) :\n    isolateSet G (insert w X) = isolate (isolateSet G X) w := by\n  ext a b; simp only [isolateSet_adj, isolate_adj, Finset.mem_insert, not_or]; tauto\n\ntheorem isolateSet_comm_isolate (G : SimpleGraph V) (X : Finset V) (w : V) :\n    isolateSet (isolate G w) X = isolate (isolateSet G X) w := by\n  ext a b; simp only [isolateSet_adj, isolate_adj]; tauto\n\ntheorem ndeg_isolateSet_le (G : SimpleGraph V) (X : Finset V) (u : V) :\n    ndeg (isolateSet G X) u ≤ ndeg G u :=\n  ndeg_le_of_le (isolateSet_le G X) u\n\n/-- `G|S`: the edges inside `S`, every other vertex isolated (the paper's component `G_i`\nkept on the vertex type `V`). -/\ndef restrict (G : SimpleGraph V) (S : Set V) : SimpleGraph V where\n  Adj a b := G.Adj a b ∧ a ∈ S ∧ b ∈ S\n  symm := ⟨fun _ _ ⟨h, ha, hb⟩ => ⟨h.symm, hb, ha⟩⟩\n  loopless := ⟨fun a h => G.loopless.irrefl a h.1⟩\n\ntheorem restrict_adj (G : SimpleGraph V) (S : Set V) (a b : V) :\n    (restrict G S).Adj a b ↔ G.Adj a b ∧ a ∈ S ∧ b ∈ S := Iff.rfl\n\ntheorem restrict_le (G : SimpleGraph V) (S : Set V) : restrict G S ≤ G := fun _ _ h => h.1\n\ntheorem restrict_eq_self {G : SimpleGraph V} {S : Set V} (h : ∀ a b, G.Adj a b → a ∈ S ∧ b ∈ S) :\n    restrict G S = G := by\n  ext a b; simp only [restrict_adj]\n  exact ⟨fun h => h.1, fun hab => ⟨hab, h a b hab⟩⟩\n\n/-- When no edge crosses `S`, `G` is the disjoint union of `G|S` and `G|Sᶜ`. -/\ntheorem restrict_sup_restrict_compl {G : SimpleGraph V} {S : Set V}\n    (h :