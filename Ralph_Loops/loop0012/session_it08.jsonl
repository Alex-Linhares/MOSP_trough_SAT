"","+    import random","+    from learning.edwards_mcdermid import fminus, is_basic, is_reduced, isolate_set, support","+    rng = random.Random(808)","+    done = disconnected = 0","+    for _ in range(300):","+        n1 = rng.randint(4, 7)","+        a1 = _random_connected_min3(rng, n1)","+        if rng.random() < 0.5:","+            n2 = rng.randint(4, 6)","+            a2 = _random_connected_min3(rng, n2)","+            adj = a1 + [0] * n2","+            other = [0] * n1 + [a << n1 for a in a2]","+            # SUP: reduced and basic pass to the union; f⁻ adds","+            assert is_reduced([x | y for x, y in zip(adj, other)])","+            if is_basic(adj) and is_basic(other):","+                assert is_basic([x | y for x, y in zip(adj, other)])","+            assert fminus([x | y for x, y in zip(adj, other)]) == fminus(adj) + fminus(other)","+            adj = [x | y for x, y in zip(adj, other)]","+            disconnected += 1","+        assert is_reduced(adj) and any(adj)","+        X, B = _lean_recursion(adj, rng)","+        done += 1","+        assert X & ~support(adj) == 0","+        assert any(B) and is_reduced(B) and is_basic(B)","+        assert X.bit_count() + fminus(B) <= fminus(adj)","+        assert _sp_reaches(isolate_set(adj, X), B)","+    assert done == 300 and disconnected >= 100","+","+","+def test_item08_brute_force_log_has_no_violation():","+    \"\"\"The exhaustive check to 9 vertices (`08_reduction/check.py`) was run and found nothing;","+    its T1 count is item 02's (89,972 reduced non-empty graphs), and the disconnected case of","+    the induction fired on the random disjoint unions.\"\"\"","+    import json","+    p = REDUCTION_THEOREM_LEAN.parents[3] / \"reports/scratch/edwards_mcdermid/08_reduction/summary.json\"","+    if not p.exists():","+        pytest.skip(\"brute-force summary not present\")","+    s = json.loads(p.read_text())","+    assert s[\"violations\"] == 0","+    assert s[\"total\"][\"T1\"] == 89972 and s[\"total\"][\"graphs\"] == 288266","+    assert s[\"total\"][\"CP_components\"] == 290103","+    assert s[\"pairs\"][\"union_case_disconnected\"] >= 1000","+    assert s[\"total\"][\"rec_calls\"] == s[\"total\"][\"case_basic\"] + s[\"total\"][\"case_disconnected\"] + s[\"total\"][\"case_connected\"]","+","+","+def test_reduction_theorem_proved_names_are_theorems_in_the_lean_file():","+    \"\"\"Every name `learning.sandwich` audits for `ReductionTheorem.lean` is declared there as a","+    theorem (namespaces resolved); the file has no `sorry` and no `axiom`; the root module","+    imports it; `paper1/axiom_check.lean` prints the axioms of every one; T1 is stated with","+    `IsSPReduced G` and `G ≠ ⊥` and no confluence hypothesis.\"\"\"","+    import learning.sandwich as sw","+    src = REDUCTION_THEOREM_LEAN.read_text()","+    code = re.sub(r\"/-.*?-/\", \"\", src, flags=re.S)","+    ns, declared = [], set()","+    for line in code.splitlines():","+        m = re.match(r\"^namespace\\s+(\\S+)\", line)","+        if m:","+            ns.append(m.group(1))","+            continue","+        m = re.match(r\"^end\\s+(\\S+)\", line)","+        if m and ns and ns[-1] == m.group(1):","+            ns.pop()","+            continue","+        m = re.match(r\"^theorem\\s+([^\\s:({\\[]+)\", line)","+        if m:","+            declared.add(\".\".join(ns[1:] + [m.group(1)]))","+    assert set(sw.REDUCTION_THEOREM_PROVED) == {\"DegreeBound.\" + n for n in declared}","+    assert len(sw.REDUCTION_THEOREM_PROVED) == len(declared) == 41","+    assert set(sw.REDUCTION_THEOREM_PROVED) <= set(sw.ALL_PROVED)","+    code = re.sub(r\"--.*\", \"\", code)","+    assert \"sorry\" not in code","+    assert not re.search(r\"^\\s*axiom\\b\", code, re.M)","+    root = (REDUCTION_THEOREM_LEAN.parents[2] / \"MOSPFormalization.lean\").read_text()","+    assert \"import MOSPFormalization.DegreeBound.ReductionTheorem\\n\" in root","+    axioms = (REDUCTION_THEOREM_LEAN.parents[3] / \"paper1\" / \"axiom_check.lean\").read_text()","+    for n in sw.REDUCTION_THEOREM_PROVED:","+        assert f\"#print axioms MOSPFormalization.{n}\\n\" in axioms, n","+    for n in (\"exists_reduction_set\", \"exists_reduction_set_and\", \"isReductionSet_insert\",","+              \"isReductionSet_sup\", \"isBasic_sup\", \"isSPReduced_sup\", \"compPotential_cubic\",","+              \"compPotential_ge_five_sixths\", \"isBasic_component\"):","+        assert f\"DegreeBound.{n}\" in sw.REDUCTION_THEOREM_PROVED","+    assert \"structure IsReductionSet\" in src","+    assert \"(hG : IsSPReduced G)\\n    (hne : G ≠ ⊥)\" in src","+    assert \"Confluence\" not in code and \"hstep\" not in code"]}]}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/tests/test_edwards_mcdermid.py"]}},"tool_result_meta":[{"id":"toolu_01Y9YCSyb1J7KwBRtrs64xXW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
