otential_cubic\\ncompPotential_ge_five_sixths compPotential_cubic_or_ge_five_sixths IsReductionSet.card_le_potentialMinus\\nIsReductionSet.congr_left isReductionSet_empty isReductionSet_insert isReductionSet_sup\\nexists_reduction_set_of_split exists_reduction_set_of_card exists_reduction_set exists_reduction_set_and\\\"\\\"\\\".split()\\nassert len(names) == 41\\nblock = '#: `DegreeBound/ReductionTheorem.lean` (loop0012 item 08): Theorem 3.2 and its lemmas.\\\\nREDUCTION_THEOREM_PROVED = (\\\\n' + \\\"\\\".join(f'    \\\"DegreeBound.{n}\\\",\\\\n' for n in names) + ')\\\\n'\\nnew = block + '''#: Every proved name the axiom check asks for.\\nALL_PROVED = (PROVED + FOREST_COVER_PROVED + PENDANT_PROVED + SEPARATOR_PROVED + DEGREE_BOUND_PROVED\\n              + CUT_LEMMA_PROVED + POTENTIAL_PROVED + SP_REDUCTION_PROVED + STEP_PROVED\\n              + REDUCTION_THEOREM_PROVED)\\n'''\\nassert old in s\\nopen(p, \\\"w\\\").write(s.replace(old, new))\\nprint(\\\"sandwich.py edited\\\")\\nEOF\\n(nice -n 19 python3 -m learning.sandwich --stage lean) > reports/scratch/edwards_mcdermid/08_reduction/sandwich_lean.log 2>&1; tail -3 reports/scratch/edwards_mcdermid/08_reduction/sandwich_lean.log; grep -c \\\"ReductionTheorem\\\\|exists_reduction_set\\\" reports/scratch/edwards_mcdermid/08_reduction/sandwich_lean.log; (nice -n 19 python3 -m learning.sandwich --stage degree_bound) > reports/scratch/edwards_mcdermid/08_reduction/sandwich.log 2>&1; tail -2 reports/scratch/edwards_mcdermid/08_reduction/sandwich.log; git status --short reports/sandwich_tables.md\",\"description\":\"Append axiom lines, run axiom audit, register names in sandwich, run its stages\",\"timeout\":900000}},\"wire_ingest_context\":{\"toolu_013VDEkB6NeAWLJuxWbFt2nt\":{\"cwd\":\"/home/al/dev/MOSP\"}}}","+{\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"bdbkjnpjo\",\"run_id\":\"0mvysre14-bc2a3b6b\",\"tool_use_id\":\"toolu_013VDEkB6NeAWLJuxWbFt2nt\",\"description\":\"Append axiom lines, run axiom aud