ecidableEq W]\nMOSPFormalization/Pathwidth.lean:21:noncomputable def pathwidth : ℕ :=\nMOSPFormalization/TreeBound.lean:234:theorem pathwidth_le_pathwidth_induce_add_card_compl (S : Finset V) :\nMOSPFormalization/TreeBound.lean:241:theorem pathwidth_le_pathwidth_erase_add_one (v : V) :\nMOSPFormalization/TreeBound.lean:351:theorem pathwidth_induce_union_le_max (A B : Finset V) (hAB : Disjoint A B)\nMOSPFormalization/TreeBound.lean:637:theorem pathwidth_induce_le_of_forall_connected (S : Finset V) (k : ℕ)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PKdM8dUW87LMFY9c5yJFAv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
