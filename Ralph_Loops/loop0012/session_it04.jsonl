","+","+  C2s  BisectionTree (min budgets per level)   pw(G) ≤ k + Σ_i b_i","+  C2m  BisectionTreeMax (max budgets)          pw(G) ≤ k + Σ_i b_i","+  C2   the item's factor-2 form                pw(G) ≤ k + 2 Σ_i b_i","+","+A violation prints the graph (graph6 or edge list) and stops.","+","+    nice -n 19 python3 reports/scratch/edwards_mcdermid/04_cut/check.py --max-n 7 --workers 8","+\"\"\"","+from __future__ import annotations","+","+import argparse","+import collections","+import json","+import random","+import subprocess","+import sys","+import time","+from multiprocessing import Pool","+","+sys.path.insert(0, \"/home/al/dev/MOSP\")","+","+from learning.edwards_mcdermid import (  # noqa: E402","+    bisection_bound, bits, boundary_to, parse_g6, pathwidth_induced, separator_cut_bound,","+)","+from learning.first_moment import vertex_separation_brute  # noqa: E402","+","+HERE = \"/home/al/dev/MOSP/reports/scratch/edwards_mcdermid/04_cut\"","+RANDOM_GRAPHS = 2000","+TREES_PER_GRAPH = 4","+","+","+def submasks(S: int):","+    T = S","+    while True:","+        yield T","+        if T == 0:","+            break","+        T = (T - 1) & S","+","+","+def one(arg: tuple[int, str]) -> dict:","+    idx, line = arg","+    n, adj = parse_g6(line)","+    full = (1 << n) - 1","+    cnt: collections.Counter = collections.Counter()","+    slack: collections.Counter = collections.Counter()","+    viol: list[str] = []","+    pwc = {S: pathwidth_induced(adj, S) for S in range(1 << n)}","+    pw_of = pwc.__getitem__","+","+    def bad(tag: str, what: str) -> None:","+        viol.append(f\"{tag} n={n} g6={line.strip()} {what}\")","+","+    for U in range(1 << n):","+        for T in submasks(U):","+            # M and L1r on every T ⊆ U","+            cnt[\"M\"] += 1","+            if not pw_of(T) <= pw_of(U):","+                bad(\"M\", f\"T={T:b} U={U:b}\")","+            cnt[\"L1r\"] += 1","+            if not pw_of(U) <= pw_of(T) + (U & ~T).bit_count():","+                