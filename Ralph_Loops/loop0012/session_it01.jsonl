l(adj[v].bit_count() == 3 for v in vs)","+","+","+# ----------------------------------------------------------------------------","+# the series-parallel reduction","+# ----------------------------------------------------------------------------","+","+","+def reduce(adj: list[int]) -> tuple[list[int], int]:","+    \"\"\"The reduced graph `r(G)` of paper Section 3.2, on the same vertex set","+    with the removed vertices isolated, and the mask of removed vertices.","+","+    The four operations, applied while a vertex of degree ≤ 2 remains:","+    (1) delete an isolated vertex; (2) delete a vertex of degree 1; (3) a vertex","+    of degree 2 with non-adjacent neighbours `x, y`: delete it and add `xy`;","+    (4) a vertex of degree 2 with adjacent neighbours: delete it. Here an","+    already-isolated vertex is left in place (it is \"deleted\" in the paper's","+    sense: it contributes nothing), and a vertex that becomes isolated is","+    recorded as removed. The result is unique (the paper, p. 8) so the order","+    in which the bucket is drained does not matter for the output.","+","+    Linear in the number of steps: degrees are kept in an array and only the","+    neighbours of the deleted vertex are touched.","+    \"\"\"","+    n = len(adj)","+    adj = list(adj)","+    deg = [a.bit_count() for a in adj]","+    removed = 0","+    for v in range(n):","+        if deg[v] == 0:","+            removed |= 1 << v","+    stack = [v for v in range(n) if 0 < deg[v] <= 2]","+    while stack:","+        v = stack.pop()","+        if (removed >> v) & 1 or deg[v] > 2:","+            continue","+        nb = adj[v]","+        if deg[v] == 0:","+            removed |= 1 << v","+            continue","+        if deg[v] == 1:","+            x = nb.bit_length() - 1","+            adj[x] &= ~(1 << v)","+            adj[v] = 0","+            deg[v] = 0","+            deg[x] -= 1","+            removed |= 1 << v","+            if deg[x] <= 2:","+                stack.append(x)","+            continue","+        # degree 2","+        low = nb & -nb","+        x = low.bit_length() - 1","+        y = (nb ^ low).bit_length() - 1","+        adj[x] &= ~(1 << v)","+        adj[y] &= ~(1 << v)","+        adj[v] = 0","+        deg[v] = 0","+        removed |= 1 << v","+        if (adj[x] >> y) & 1:","+            # operation 4: neighbours adjacent, both lose one","+            deg[x] -= 1","+            deg[y] -= 1","+        else:","+            # operation 3: suppress, degrees of x and y unchanged","+            adj[x] |= 1 << y","+            adj[y] |= 1 << x","+        if deg[x] <= 2:","+            stack.append(x)","+        if deg[y] <= 2:","+            stack.append(y)","+    return adj, removed","+","+","+# ----------------------------------------------------------------------------","+# the terms of Corollary 5.2 and Theorem 5.3","+# ----------------------------------------------------------------------------","+","+","+def histogram_term(adj: list[int]) -> Fraction:","+    \"\"\"`Σ_{d ≥ 3} g(d) n_d(G)`, the unreduced form (the right-hand side of","+    Corollary 5.2's displayed line).\"\"\"","+    return sum((g(d) for d in degrees(adj)), Fraction(0))","+","+","+def main_term(adj: list[int], reduced: tuple[list[int], int] | None = None) -> Fraction:","+    \"\"\"`Σ_{v ∈ V(r(G))} g(d_{r(G)}(v))`, the reduced form (the main term of","+    Corollary 5.2). Pass `reduce(adj)` to avoid recomputing it.\"\"\"","+    radj, _ = reduced if reduced is not None else reduce(adj)","+    return histogram_term(radj)","+","+","+def average_degree(adj: list[int]) -> Fraction:","+    n = len(adj)","+    if n == 0:","+        return Fraction(0)","+    return Fraction(2 * edge_count(adj), n)","+","+","+def average_degree_term(adj: list[int]) -> Fraction:","+    \"\"\"`g(d̄) · n` with the paper's linear interpolation (Theorem 5.3's main","+    term). Meaningful when `G` is connected or `d̄ ≥ 5`; computed regardless.\"\"\"","+    return g_real(average_degree(adj)) * len(adj)","+","+","+def f_potential(adj: list[int]) -> Fraction:","+    \"\"\"`f(G) = Σ_v g(d(v))` (the paper's `f_α`, `α = 1/6`).\"\"\"","+    return histogram_term(adj)","+","+","+def fminus(adj: list[int]) -> Fraction:","+    \"\"\"`f⁻(G) = f(G) − Σ_{components C of the support} g'(δ(C))` (paper p. 7,","+    per component, as the Lean design fixes it). Isolated vertices are","+    singleton components with `g'(0) = 0`. The paper defines it for minimum","+    degree ≥ 3; the formula is evaluated on any graph.\"\"\"","+    total = f_potential(adj)","+    for comp in components(adj):","+        total -= g_prime(min_degree(adj, comp))","+    return total","+","+","+# ----------------------------------------------------------------------------","+# the Poisson evaluation and Fomin–Høie's explicit budget","+# ----------------------------------------------------------------------------","+","+","+def poisson_value(c: float, tail: float = 1e-15) -> float:","+    \"\"\"`Σ_d P(Poisson(c) = d) g(d)`: Corollary 5.2's main term per vertex on","+    `G(n, c/n)` in the limit, where the degree law is Poisson(`c`).\"\"\"","+    if c < 0:","+        raise ValueError(\"c must be non-negative\")","+    if c == 0:","+        return 0.0","+    total = 0.0","+    p = math.exp(-c)","+    d = 0","+    while True:","+        if d >= 3:","+            total += p * float(g(d))","+        d += 1","+        p *= c / d","+        if d > c and p < tail:","+            break","+    return total","+","+","+def fomin_hoie_n_eps(eps: float) -> float:","+    \"\"\"`n_ε = (8/ε) ln(1/ε) (1 + 1/ε²)` from the proof of Fomin & Høie's Theorem 5.\"\"\"","+    return (8 / eps) * math.log(1 / eps) * (1 + 1 / eps ** 2)","+","+","+def fomin_hoie_budget(n: int) -> float:","+    \"\"\"`τ_FH(n) = min{ε n : n > n_ε} + 1/6`: the smallest explicit error term","+    Fomin & Høie's Theorem 5 offers at size `n`, read as a budget for the","+    cubic base case `pw ≤ N/6 − 1/6 + τ(N)` (plan §0.3). `n_ε` decreases in","+    `ε` on (0, 1), so the minimum is at the smallest admissible `ε`, found by","+    bisection.\"\"\"","+    if n <= 0:","+        return 1 / 6","+    lo, hi = 1e-9, 1.0 - 1e-12","+    if n > fomin_hoie_n_eps(lo):","+        return lo * n + 1 / 6","+    for _ in range(200):","+        mid = (lo + hi) / 2","+        if n > fomin_hoie_n_eps(mid):","+            hi = mid","+        else:","+            lo = mid","+    return hi * n + 1 / 6"]}],"created":true}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/learning/edwards_mcdermid.py"]}},"tool_result_meta":[{"id":"toolu_012QYqwKDzGf6jHBx4ipQ3sc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
