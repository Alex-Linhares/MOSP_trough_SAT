nectedComponent} g' (minDeg G C)` as\n    `Potential.lean` defines it: `potential = Σ_v g (deg v)` over every vertex, the sum over\n    every component including the singletons of isolated vertices, `minDeg` the minimum\n    degree on the component; `g`, `g'` from the Lean transcription.\"\"\"\n    n = len(adj)\n    total = sum((g_lean(a.bit_count()) for a in adj), Fraction(0))\n    seen = 0\n    for v in range(n):\n        if (seen >> v) & 1:\n            continue\n        comp = _reach_mask(adj, v)\n        seen |= comp\n        total -= g_prime_lean(min(adj[u].bit_count() for u in range(n) if (comp >> u) & 1))\n    return total\n\n\ndef vertex_term_sum_lean(adj: list[int]) -> Fraction:\n    \"\"\"`Σ_v vertexTerm G v`, `vertexTerm G v = g (deg v) − g' (minDeg C_v) / |C_v|`\n    (`potentialMinus_eq_sum_vertexTerm`).\"\"\"\n    n = len(adj)\n    total = Fraction(0)\n    for v in range(n):\n        comp = _reach_mask(adj, v)\n        md = min(adj[u].bit_count() for u in range(n) if (comp >> u) & 1)\n        total += g_lean(adj[v].bit_count()) - g_prime_lean(md) / comp.bit_count()\n    return total\n\n\ndef _random_graph_with_isolated(rng, n: int) -> list[int]:\n    adj = [0] * n\n    live = [v for v in range(n) if rng.random() < 0.8]\n    p = rng.choice([0.2, 0.5, 0.8])\n    for i, u in enumerate(live):\n        for v in live[i + 1:]:\n            if rng.random() < p:\n                adj[u] |= 1 << v\n                adj[v] |= 1 << u\n    return adj\n'''\nanchor='\\n\\ndef degree_bound_check(max_n: int = 200) -> pd.DataFrame:'\nassert anchor in s\ns=s.replace(anchor, helpers+anchor)\nold='''    row(\"Lemma 8.5: g(n+1)/(n+1) < g(n)/n\", \"g_div_lt_g_div\", range(5, max_n),\n        lambda n: g_lean(n + 1) / (n + 1) < g_lean(n) / n)\n    return pd.DataFrame(rows)'''\nnew='''    row(\"Lemma 8.5: g(n+1)/(n+1) < g(n)/n\", \"g_div_lt_g_div\", range(5, max_n),\n        lambda n: g_lean(n + 1) / (n + 1) < g_lean(n) / n)\n    # item 05: `Potential.lean`'s `f⁻` against `learning.edwards_mcdermid.fminus` on 500\n    # random graphs (1–12 vertices, isolated vertices present), and its per-vertex form\n    from learning.edwards_mcdermid import fminus as fminus_py, support as support_py\n    import random as _random\n    rng = _random.Random(1105)\n    graphs = [_random_graph_with_isolated(rng, rng.randint(1, 12)) for _ in range(500)]\n    rows.append({\"statement\": \"f⁻ (Lean definition, transcribed) = fminus (Python), 500 random graphs\",\n                 \"Lean\": \"potentialMinus\", \"n\": \"1–12 vertices\", \"checked\": len(graphs),\n                 \"holds\": sum(1 for a in graphs if potential_minus_lean(a) == fminus_py(a))})\n    rows.append({\"statement\": \"f⁻ = Σ_v vertexTerm (the per-vertex form), 500 random graphs\",\n                 \"Lean\": \"potentialMinus_eq_sum_vertexTerm\", \"n\": \"1–12 vertices\",\n                 \"checked\": len(graphs),\n                 \"holds\": sum(1 for a in graphs if potential_minus_lean(a) == vertex_term_sum_lean(a))})\n    unions = []\n    for _ in range(500):\n        n = rng.randint(2, 12)\n        verts = list(range(n))\n        rng.shuffle(verts)\n        k = rng.randint(0, n)\n        g1, g2 = [0] * n, [0] * n\n        for part, adj in ((verts[:k], g1), (verts[k:], g2)):\n            p = rng.choice([0.3, 0.6, 0.9])\n            for i, u in enumerate(part):\n                for v in part[i + 1:]:\n                    if rng.random() < p:\n                        adj[u] |= 1 << v\n                        adj[v] |= 1 << u\n        assert support_py(g1) & support_py(g2) == 0\n        unions.append((g1, g2))\n    rows.append({\"statement\": \"f⁻(G₁ ⊔ G₂) = f⁻(G₁) + f⁻(G₂), disjoint supports, 500 random unions\",\n                 \"Lean\": \"potentialMinus_add\", \"n\": \"2–12 vertices\", \"checked\": len(unions),\n                 \"holds\": sum(1 for g1, g2 in unions\n                              if potential_minus_lean([a | b for a, b in zip(g1, g2)])\n                              == potential_minus_lean(g1) + potential_minus_lean(g2))})\n    return pd.DataFrame(rows)'''\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\n\n# tests\np='tests/test_edwards_mcdermid.py'; t=open(p).read()\nt=t.replace(\"    assert len(frame) == 16\\n\",\"    assert len(frame) == 19\\n    item05 = frame[frame.Lean.isin([\\\"potentialMinus\\\", \\\"potentialMinus_eq_sum_vertexTerm\\\",\\n                                    \\\"potentialMinus_add\\\"])]\\n    assert len(item05) == 3 and (item05.checked == 500).all()\\n\")\nt += '''\n\n# ----------------------------------------------------------------------------\n# item 05: `lean/MOSPFormalization/DegreeBound/Potential.lean`\n# ----------------------------------------------------------------------------\n\nPOTENTIAL_LEAN = WEIGHTS_LEAN.parent / \"Potential.lean\"\n\n\ndef test_potential_minus_lean_transcription_agrees_with_fminus():\n    \"\"\"The Lean `potentialMinus` (transcribed) equals the Python `fminus` and its per-vertex\n    form on random graphs with isolated vertices; additivity holds on disjoint unions.\"\"\"\n    import random\n    import learning.sandwich as sw\n    from learning.edwards_mcdermid import fminus, support\n    rng = random.Random(505)\n    for _ in range(200):\n        n = rng.randint(1, 11)\n        adj = sw._random_graph_with_isolated(rng, n)\n        assert sw.potential_minus_lean(adj) == fminus(adj)\n        assert sw.potential_minus_lean(adj) == sw.vertex_term_sum_lean(adj)\n        # a disjoint union with a second random graph on the complementary vertices\n        s = support(adj)\n        rest = [v for v in range(n) if not (s >> v) & 1]\n        g2 = [0] * n\n        for i, u in enumerate(rest):\n            for v in rest[i + 1:]:\n                if rng.random() < 0.6:\n                    g2[u] |= 1 << v\n                    g2[v] |= 1 << u\n        union = [a | b for a, b in zip(adj, g2)]\n        assert sw.potential_minus_lean(union) == sw.potential_minus_lean(adj) + sw.potential_minus_lean(g2)\n\n\ndef test_potential_proved_names_are_theorems_in_the_lean_file():\n    \"\"\"Every name `learning.sandwich` audits for `Potential.lean` is declared there as a\n    theorem; the file has no `sorry` and no `axiom`; the root module imports it; and\n    `paper1/axiom_check.lean` prints the axioms of every one.\"\"\"\n    import learning.sandwich as sw\n    src = POTENTIAL_LEAN.read_text()\n    declared = set(re.findall(r\"^(?:@\\\\[simp\\\\] )?theorem\\\\s+([^\\\\s:({\\\\[]+)\", src, re.M))\n    missing = [n for n in sw.POTENTIAL_PROVED if n.split(\".\")[-1] not in declared]\n    assert not missing, missing\n    assert all(n.startswith(\"DegreeBound.\") for n in sw.POTENTIAL_PROVED)\n    assert set(sw.POTENTIAL_PROVED) <= set(sw.ALL_PROVED)\n    assert len(sw.POTENTIAL_PROVED) == len(declared) == 54\n    code = re.sub(r\"/-.*?-/\", \"\", src, flags=re.S)\n    code = re.sub(r\"--.*\", \"\", code)\n    assert \"sorry\" not in code\n    assert not re.search(r\"^\\\\s*axiom\\\\b\", code, re.M)\n    root = (POTENTIAL_LEAN.parents[2] / \"MOSPFormalization.lean\").read_text()\n    assert \"import MOSPFormalization.DegreeBound.Potential\\\\n\" in root\n    axioms = (POTENTIAL_LEAN.parents[3] / \"paper1\" / \"axiom_check.lean\").read_text()\n    for n in sw.POTENTIAL_PROVED:\n        assert f\"#print axioms MOSPFormalization.{n}\\\\n\" in axioms, n\n    for n in (\"degree_isolate\", \"potential_isolate\", \"potential_isolate_le_sub_one\",\n              \"potential_isolate_regular\", \"potentialMinus_le_potential\",\n              \"potentialMinus_eq_sum_compPotential\", \"compPotential_nonneg\",\n              \"potentialMinus_eq_sum_vertexTerm\", \"potentialMinus_le_F\",\n              \"potentialMinus_eq_F_of_connected\", \"potentialMinus_add\",\n              \"potentialMinus_cubic\", \"potentialMinus_ge_five_sixths\"):\n        assert f\"DegreeBound.{n}\" in sw.POTENTIAL_PROVED\n'''\nopen(p,'w').write(t)\nprint(\"edited\")\nEOF\ngrep -n 'Fracti