t(1, 12)","+        p = rng.choice([0.2, 0.4, 0.6, 0.8, 0.95])","+        iso = rng.randint(0, min(3, n - 1)) if n > 1 else 0","+        graphs.append(random_graph(rng, n, p, iso))","+    for adj in graphs:","+        n = len(adj)","+        deg = degrees(adj)","+        f_G = f_potential(adj)","+        fm = fminus(adj)","+        Delta = max(deg)","+        for w in range(n):","+            H = isolate(adj, w)","+            dH = degrees(H)","+            for v in range(n):","+                cnt[\"D1\"] += 1","+                want = 0 if v == w else (deg[v] - 1 if (adj[w] >> v) & 1 else deg[v])","+                if dH[v] != want:","+                    fail(\"D1\", adj, f\"w={w} v={v}\")","+            cnt[\"P1\"] += 1","+            rhs = f_G - g(deg[w]) - sum((g_prime(deg[v]) for v in bits(adj[w])), Fraction(0))","+            if f_potential(H) != rhs:","+                fail(\"P1\", adj, f\"w={w}\")","+            reduced = all(d == 0 or d >= 3 for d in deg)","+            if reduced and deg[w] == Delta and Delta >= 4:","+                if any(deg[v] <= Delta - 1 for v in bits(adj[w])):","+                    cnt[\"P2\"] += 1","+                    if not f_potential(H) <= f_G - 1:","+                        fail(\"P2\", adj, f\"w={w}\")","+            if deg[w] == Delta and Delta >= 4 and all(deg[v] == Delta for v in bits(adj[w])):","+                cnt[\"P2n\"] += 1","+                if f_potential(H) != f_G - 1 + g_prime(Delta - 1) - g_prime(Delta):","+                    fail(\"P2n\", adj, f\"w={w} (neighbours-only regular identity)\")","+        cnt[\"V1\"] += 1","+        if fm != sum((vertex_term(adj, v) for v in range(n)), Fraction(0)):","+            fail(\"V1\", adj, \"per-vertex form\")","+        comps = components(adj, support_only=False)","+        cnt[\"V2\"] += 1","+        if fm != sum((comp_potential(adj, C) for C in comps), Fraction(0)):","+            fail(\"V2\", adj, \"per-component form\")","+        for C in comps:","+            cnt[\"V2nonneg\"] += 1","+            if comp_potential(adj, C) < 0:","+                fail(\"V2nonneg\", adj, f\"C={C}\")","+        cnt[\"M1\"] += 1","+        if not fm <= f_G:","+            fail(\"M1\", adj, \"\")","+        cnt[\"M2\"] += 1","+        if not fm <= F_global(adj):","+            fail(\"M2\", adj, \"\")","+        if support_connected(adj):","+            cnt[\"M3\"] += 1","+            if fm != F_global(adj):","+                fail(\"M3\", adj, \"connected support\")","+            if all(d == 0 or d >= 3 for d in deg) and Delta >= 4:","+                cnt[\"B2\"] += 1","+                if not fm >= Fraction(5, 6):","+                    fail(\"B2\", adj, f\"fminus={fm}\")","+","+    # ---- disjoint unions: A1 ------------------------------------------------","+    for _ in range(2000):","+        n = rng.randint(2, 12)","+        verts = list(range(n))","+        rng.shuffle(verts)","+        k = rng.randint(0, n)","+        A, B = verts[:k], verts[k:]","+        G1, G2 = [0] * n, [0] * n","+        for part, G in ((A, G1), (B, G2)):","+            p = rng.choice([0.3, 0.6, 0.9])","+            for i, u in enumerate(part):","+                for v in part[i + 1:]:","+                    if rng.random() < p:","+                        G[u] |= 1 << v","+                        G[v] |= 1 << u","+        assert support(G1) & support(G2) == 0","+        G = [G1[v] | G2[v] for v in range(n)]","+        cnt[\"A1\"] += 1","+        if fminus(G) != fminus(G1) + fminus(G2):","+            fail(\"A1\", (G1, G2), f\"{fminus(G)} != {fminus(G1)} + {fminus(G2)}\")","+        for u in range(n):","+            ru, r1, r2 = reach_mask(G, u), reach_mask(G1, u), reach_mask(G2, u)","+            cnt[\"A1reach\"] += 1","+            if ru != (r1 | r2):","+                fail(\"A1reach\", (G1, G2), f\"u={u}\")","+","+    # ---- cubic: B1 ----------------------------------------------------------","+    for _ in range(600):","+        n_cubic = rng.choice([4, 6, 8, 10, 12])","+        n_total = rng.randint(n_cubic, 14)","+        adj = random_cubic(rng, n_cubic, n_total)","+        if adj is None:","+            continue","+        cnt[\"B1\"] += 1","+        if fminus(adj) != Fraction(n_cubic, 6) - Fraction(1, 6):","+            fail(\"B1\", adj, f\"fminus={fminus(adj)} N={n_cubic}\")","+","+    elapsed = time.time() - t0","+    say(f\"counts: {dict(cnt)}\")","+    say(f\"violations: {len(bad)}\")","+    say(f\"elapsed: {elapsed:.1f} s\")","+    json.dump({\"counts\": dict(cnt), \"violations\": len(bad), \"elapsed_s\": elapsed,","+               \"seed\": 20261102, \"n_max\": 12, \"graphs\": 3000, \"unions\": 2000},","+              open(f\"{HERE}/summary.json\", \"w\"), indent=1)","+    return 1 if bad else 0","+","+","+if __name__ == \"__main__\":","+    sys.exit(main())"]}],"created":true},{"filePath":"/home/al/dev/MOSP/reports/scratch/edwards_mcdermid/05_potential/check.log","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":3,"lines":["+counts: {'D1': 163341, 'P1': 19619, 'V1': 3000, 'V2': 3000, 'V2nonneg': 8016, 'M1': 3000, 'M2': 3000, 'M3': 2199, 'P2': 2109, 'B2': 811, 'P2n': 777, 'A1': 2000, 'A1reach': 14148, 'B1': 599}","+violations: 0","+elapsed: 0.4 s"]}],"created":true},{"filePath":"/home/al/dev/MOSP/reports/scratch/edwards_mcdermid/05_potential/summary.json","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":24,"lines":["+{","+ \"counts\": {","+  \"D1\": 163341,","+  \"P1\": 19619,","+  \"V1\": 3000,","+  \"V2\": 3000,","+  \"V2nonneg\": 8016,","+  \"M1\": 3000,","+  \"M2\": 3000,","+  \"M3\": 2199,","+  \"P2\": 2109,","+  \"B2\": 811,","+  \"P2n\": 777,","+  \"A1\": 2000,","+  \"A1reach\": 14148,","+  \"B1\": 599","+ },","+ \"violations\": 0,","+ \"elapsed_s\": 0.4397389888763428,","+ \"seed\": 20261102,","+ \"n_max\": 12,","+ \"graphs\": 3000,","+ \"unions\": 2000","+}","\\ No newline at end of file"]}],"created":true}],"moreFiles":0,"changedFiles":["/home/al/dev/MOSP/reports/scratch/edwards