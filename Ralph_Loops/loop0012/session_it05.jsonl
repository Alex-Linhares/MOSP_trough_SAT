{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018VvZBqXdopnzLQs8mLwr3b","type":"tool_result","content":"67:import MOSPFormalization.DegreeBound.Weights\n68:import MOSPFormalization.DegreeBound.CutLemma\n69:import MOSPFormalization.DegreeBound.Potential\n===AXIOM_SAMPLE\n390:-- loop0012 item 03: the Edwards–McDermid weights `g = g_{1/6}` and `g'` (`DegreeBound/Weights.lean`):\n393:#print axioms MOSPFormalization.DegreeBound.g_zero\n394:#print axioms MOSPFormalization.DegreeBound.g_one\n371\n===SANDWICH_TUPLES\n    \"weightedSum_graphsOfPathwidthLe_le_closedPairFormula\",\n)\n#: loop0012 item 03 (`DegreeBound/Weights.lean`): the Edwards–McDermid weights `g = g_{1/6}`\n#: and `g'` — the recurrence (W1), the table to `d = 9`, Lemma 8.3 (`g` non-decreasing, W2),\n#: Lemma 8.4 (`g'` non-increasing from 3, W3), property 6 (W4), the bounds `0 ≤ g < 1`,\n#: `0 ≤ g' ≤ 1/6`, `g' ≤ g` (W5), Lemma 8.1 (the closed form) and Lemma 8.5.\nDEGREE_BOUND_PROVED = (\n    \"DegreeBound.g_zero\",\n    \"DegreeBound.g_one\",\n    \"DegreeBound.g_two\",\n    \"DegreeBound.g_three\",\n    \"DegreeBound.g_add_four\",\n    \"DegreeBound.g_add_four_mul\",\n    \"DegreeBound.g_recurrence\",\n    \"DegreeBound.g_four\",\n    \"DegreeBound.g_five\",\nCUT_LEMMA_PROVED = (\n    \"boundaryTo_subset\",\n    \"boundary_subset\",\n    \"mem_boundaryTo\",\n    \"mem_boundary\",\n    \"boundary_eq_boundaryTo_compl\",\n    \"not_adj_of_mem_sdiff_boundaryTo\",\n    \"pathwidth_induce_mono\",\n    \"pathwidth_induce_univ\",\n    \"pathwidth_induce_le_induce_add_card_sdiff\",\n    \"pathwidth_induce_union_le_max_add_boundaryTo\",\n    \"pathwidth_induce_union_le_max_add_min\",\n    \"pathwidth_le_max_add_min_boundary\",\n    \"pathwidth_le_cut\",\n    \"bisectionTree_nil\",\n    \"bisectionTree_cons\",\n    \"pathwidth_induce_le_of_bisectionTree\",\n    \"pathwidth_le_of_bisectionTree\",\n    \"bisectionTree_of_bisectionTreeMax\",\n    \"pathwidth_le_of_bisectionTreeMax\",\n    \"pathwidth_le_of_bisectionTreeMax_two_mul\",\n)\n#: Every proved name the axiom check asks for.\nALL_PROVED = (PROVED + FOREST_COVER_PROVED + PENDANT_PROVED + SEPARATOR_PROVED + DEGREE_BOUND_PROVED\n              + CUT_LEMMA_PROVED)\n#: Statements committed with `sorry`: none since 2026-10-31.\nSTATED: tuple[str, ...] = ()\n\n===TEST_NAMES\ndef test_degree_bound_stage_has_no_violation():\n    import learning.sandwich as sw\n    frame = sw.degree_bound_check(60)\n    assert (frame.checked == frame.holds).all(), frame[frame.checked != frame.holds]\n    assert len(frame) == 16\n\n\ndef test_degree_bound_proved_names_are_theorems_in_the_lean_file():\n    \"\"\"Every name `learning.sandwich` audits for `Weights.lean` is declared there as a\n    theorem; the file has no `sorry` and no `axiom`; the root module imports it; and\n    `paper1/axiom_check.lean` prints the axioms of every one.\"\"\"\n    import learning.sandwich as sw\n    src = WEIGHTS_LEAN.read_text()\n    declared = set(re.findall(r\"^(?:@\\[simp\\] )?theorem\\s+([^\\s:({\\[]+)\", src, re.M))\n    missing = [n for n in sw.DEGREE_BOUND_PROVED if n.split(\".\")[-1] not in declared]\n    assert not missing, missing\n    assert all(n.startswith(\"DegreeBound.\") for n in sw.DEGREE_BOUND_PROVED)\n    assert set(sw.DEGREE_BOUND_PROVED) <= set(sw.ALL_PROVED)\n    code = re.sub(r\"/-.*?-/\", \"\", src, flags=re.S)\n    code = re.sub(r\"--.*\", \"\", code)\n    assert \"sorry\" not in code\n    assert not re.search(r\"^\\s*axiom\\b\", code, re.M)\n    root = (WEIGHTS_LEAN.parents[2] / \"MOSPFormalization.lean\").read_text()\n    assert \"import MOSPFormalization.DegreeBound.Weights\\n\" in root\n    axioms = (WEIGHTS_LEAN.parents[3] / \"paper1\" / \"axiom_check.lean\").read_text()\n    for n in sw.DEGREE_BOUND_PROVED:\n        assert f\"#print axioms MOSPFormalization.{n}\\n\" in axioms, n\n    for n in (\"g_recurrence\", \"g_monotone\", \"g'_antitone_of_three_le\", \"one_sub_g_eq\",\n              \"g_closed_form\", \"g