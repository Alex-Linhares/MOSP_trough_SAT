[\"case_A\"] += 1","+                if not j4 >= g_prime(delta):","+                    bad(\"A_j4\", f\"w={w}\")","+                continue","+            cnt[\"case_B\"] += 1","+            if delta != 3:","+                bad(\"B_delta3\", f\"w={w} δ={delta}\")","+            mins = [v for v in supp if deg[v] == delta]","+            if not all((adj[w] >> v) & 1 for v in mins):","+                bad(\"B_adj\", f\"w={w}: a degree-3 vertex not adjacent to w\")","+            if any(deg[v] >= 4 for v in nbrs):","+                cnt[\"case_B1\"] += 1","+                if not j4 >= g_prime(D - 1):","+                    bad(\"B1_j4\", f\"w={w}\")","+                continue","+            cnt[\"case_B2\"] += 1","+            if S != D * g_prime(3):","+                bad(\"B2_S\", f\"w={w}\")","+            us = [u for u in range(n) if ds[u] > 0]","+            if not us:","+                bad(\"B2_u\", f\"w={w}\")","+            for u in us:","+                if (adj[w] >> u) & 1 or u == w:","+                    bad(\"B2_adj\", f\"w={w} u={u}\")","+                if dp[u] != deg[u] or dp[u] < 3:","+                    bad(\"B2_deg\", f\"w={w} u={u}\")","+            if not j4 >= g_prime(D):","+                bad(\"B2_j4\", f\"w={w}\")","+    return {\"cnt\": cnt, \"viol\": viol}","+","+","+def geng(n: int) -> list[str]:","+    return subprocess.run([\"nauty-geng\", \"-q\", \"-c\", \"-d3\", str(n)], capture_output=True,","+                          text=True, check=True).stdout.splitlines()","+","+","+def main() -> None:","+    ap = argparse.ArgumentParser()","+    ap.add_argument(\"--max-n\", type=int, default=9)","+    ap.add_argument(\"--workers\", type=int, default=8)","+    a = ap.parse_args()","+    log = open(f\"{HERE}/check.log\", \"w\")","+","+    def say(s: str = \"\") -> None:","+        print(s, flush=True)","+        log.write(s + \"\\n\")","+        log.flush()","+","+    say(f\"# item 07 brute-force check, {time.strftime('%Y-%m-%d %H:%M:%S UT