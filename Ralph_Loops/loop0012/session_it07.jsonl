tep\n    have hKb : ∀ a b', K.Adj a b' → ∀ z, ¬ b.Adj a z := fun a b' hab' =>\n      SPReduces.not_adj_of_not_adj hGb (hK a b' hab')\n    exact SPReduces.tail ih (hv.sup_of_disjoint hKb)\n\n/-- R5 in the vocabulary of supports. -/\ntheorem sup_of_disjoint_supp [Decidab","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/al/.claude/projects/-home-al-dev-MOSP/a0876bac-7461-4cfb-84fd-1d355ecb73ab/tool-results/bb0d1mtwe.txt","persistedOutputSize":30427},"tool_result_meta":[{"id":"toolu_01XDBGJtPUsp7juir2dngZ5x","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
