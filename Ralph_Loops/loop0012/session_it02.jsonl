isolate(cur, w))","+","+","+def pathwidth_induced(adj: list[int], S: int) -> int:","+    \"\"\"Vertex separation (= pathwidth) of `G[S]` by the subset DP over the","+    submasks of `S` (`|S| ≤ 16` or so).\"\"\"","+    if S == 0:","+        return 0","+    f = {0: 0}","+    T = (0 - S) & S","+    while True:","+        rest = S & ~T","+        cost = 0","+        U = T","+        while U:","+            low = U & -U","+            U ^= low","+            if adj[low.bit_length() - 1] & rest:","+                cost += 1","+        best = None","+        U = T","+        while U:","+            low = U & -U","+            U ^= low","+            c = f[T ^ low]","+            if best is None or c < best:","+                best = c","+        f[T] = cost if cost > best else best","+        if T == S:","+            break","+        T = (T - S) & S","+    return f[S]"]}]},{"filePath":"/home/al/dev/MOSP/reports/scratch/edwards_mcdermid/02_lemmas/check.py","hunks":[{"oldStart":63,"oldLines":8,"newStart":63,"newLines":10,"lines":[" sys.path.insert(0, \"/home/al/dev/MOSP\")"," "," from learning.edwards_mcdermid import (  # noqa: E402","-    alternating_factorial, bits, components, degrees, edge_count, f_potential,","-    fminus, g, g_closed_form, g_prime, is_cubic, is_reduced, min_degree, reduce,","+    F_global, alternating_factorial, bits, components, degrees, edge_count, f_potential,","+    fminus, g, g_closed_form, g_prime, global_min_degree, is_basic, is_basic_component,","+    is_cubic, is_reduced, isolate, isolate_set, paper_choice, pathwidth_induced, reduce,","+    reduce_random, restrict, sp_step, step_vertices, support,"," )"," "," HERE = \"/home/al/dev/MOSP/reports/scratch/edwards_mcdermid/02_lemmas\""]},{"oldStart":101,"oldLines":140,"newStart":103,"newLines":17,"lines":[" "," "," def pw_induced(adj: list[int], S: int) -> int:","-    \"\"\"Vertex separation (= pathwidth) of G[S], by the subset DP over the","-    submasks of S in increasing numeric order.\"\"\"",