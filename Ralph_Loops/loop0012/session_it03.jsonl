e: n g'(n) = (n − 3) g'(n − 1) + g'(n − 2)\", \"g'_recurrence\",\n        range(5, max_n + 1),\n        lambda n: n * g_prime_lean(n) == (n - 3) * g_prime_lean(n - 1) + g_prime_lean(n - 2))\n    row(\"Lemma 8.4 sandwich: g'(n)/3 ≤ g'(n+1) ≤ g'(n)\", \"g'_aux\", range(3, max_n),\n        lambda n: g_prime_lean(n) / 3 <= g_prime_lean(n + 1) <= g_prime_lean(n))\n    row(\"W3: g' non-increasing from 3\", \"g'_antitone_of_three_le\", range(3, max_n),\n        lambda n: g_prime_lean(n + 1) <= g_prime_lean(n))\n    row(\"W4: 1 − g(n) = (n − 1) g'(n) + g'(n − 1)\", \"one_sub_g_eq\", range(4, max_n + 1),\n        lambda n: 1 - g_lean(n) == (n - 1) * g_prime_lean(n) + g_prime_lean(n - 1))\n    row(\"W5: 0 ≤ g(n) < 1\", \"g_nonneg, g_lt_one\", range(max_n + 1),\n        lambda n: 0 <= g_lean(n) < 1)\n    row(\"W5: 0 ≤ g'(n) ≤ 1/6\", \"g'_nonneg, g'_le_sixth\", range(max_n + 1),\n        lambda n: 0 <= g_prime_lean(n) <= Fraction(1, 6))\n    row(\"g'(n) ≤ g(n)\", \"g'_le_g\", range(max_n + 1), lambda n: g_prime_lean(n) <= g_lean(n))\n    row(\"Lemma 8.1: g(n) = (7/2) A(n)/n! + (3/2)(−1)^n/n! − 5/2\", \"g_closed_form\",\n        range(2, max_n + 1),\n        lambda n: g_lean(n) == Fraction(7, 2) * alt_factorial_lean(n) / math.factorial(n)\n        + Fraction(3, 2) * (-1) ** n / math.factorial(n) - Fraction(5, 2) == g_closed_form(n))\n    row(\"Lemma 8.5: g(n+1)/(n+1) < g(n)/n\", \"g_div_lt_g_div\", range(5, max_n),\n        lambda n: g_lean(n + 1) / (n + 1) < g_lean(n) / n)\n    return pd.DataFrame(rows)\n'''\nanchor = \"\\n\\n# ----------------------------------------------------------------------------\\n# The Lean side\\n\"\nassert s.count(anchor) == 1; s = s.replace(anchor, trans + anchor)\n# imports\ns = s.replace(\"import argparse\\nimport itertools\\n\", \"import argparse\\nimport functools\\nimport itertools\\nimport math\\n\", 1)\ns = s.replace(\"import time\\nfrom pathlib import Path\\n\", \"import time\\nfrom fractions import Fraction\\nfrom pathlib import Path\\n\", 1)\n# choices and stage\ns = s.replace('choices=[\"all\", \"brute\", \"lean\", \"corpus\", \"forest\", \"separator\"],',\n              'choices=[\"all\", \"brute\", \"lean\", \"corpus\", \"forest\", \"separator\", \"degree_bound\"],', 1)\ns = s.replace('    ap.add_argument(\"--max-n\", type=int, default=5)\\n',\n              '    ap.add_argument(\"--max-n\", type=int, default=5)\\n'\n              '    ap.add_argument(\"--max-degree\", type=int, default=200,\\n'\n              '                    help=\"largest n for --stage degree_bound\")\\n', 1)\nstage = '''    if args.stage in (\"all\", \"degree_bound\"):\n        t0 = time.time()\n        frame = degree_bound_check(args.max_degree)\n        bad = frame[frame.checked != frame.holds]\n        ok &= bad.empty\n        sections += [\"## `DegreeBound/Weights.lean` against `learning.edwards_mcdermid` \"\n                     \"(loop0012 item 03)\", \"\",\n                     f\"`g` as Lean defines it (four cases and `g (n + 4)`), transcribed and compared \"\n                     f\"with the Python `g` in exact rationals to `n = {args.max_degree}`, and every \"\n                     f\"statement of the file on the range Lean states it, {time.time() - t0:.1f} s. \"\n                     \"`holds` must equal `checked` on every row.\", \"\",\n                     _md(frame), \"\"]\n        print(frame.to_string(index=False))\n        print(f\"degree bound: {int(frame.checked.sum())} checks, \"\n              f\"{int((frame.checked - frame.holds).sum())} violations\")\n\n    if args.stage in (\"all\", \"lean\"):\n'''\nold = '    if args.stage in (\"all\", \"lean\"):\\n'\nassert s.count(old) == 1; s = s.replace(old, stage)\n# docstring list of stages\ns = s.replace(\"    python -m learning.sandwich --stage corpus\\n\",\n              \"    python -m learning.sandwich --stage corpus\\n    python -m learning.sandwich --stage degree_bound\\n\", 1)\nsw.write_text(s)\n# 3. tests\ntt = Path(\"tests/test_edwards_mcdermid.py\"); u = tt.read_text().rstrip(\"\\n\") + \"\\n\"\nu += '''\n\n# ---------------------------------------------------------------------------\n# item 03: `lean/MOSPFormalization/DegreeBound/Weights.lean` against the Python\n# ---------------------------------------------------------------------------\n\nimport re  # noqa: E402\nfrom pathlib import Path  # noqa: E402\n\nWEIGHTS_LEAN = Path(__file__).resolve().parents[1] / \"lean\" / \"MOSPFormalization\" / \\\\\n    \"DegreeBound\" / \"Weights.lean\"\n\n\ndef test_weights_lean_transcription_agrees_to_200():\n    \"\"\"`g` as `Weights.lean` defines it (transcribed in `learning.sandwich.g_lean`) equals\n    the Python `g` to `n = 200` in exact rationals, and so do `g'` and the closed form.\"\"\"\n    import learning.sandwich as sw\n    for n in range(201):\n        assert sw.g_lean(n) == g(n), n\n        assert sw.g_prime_lean(n) == g_prime(n), n\n    for n in range(2, 60):\n        assert sw.alt_factorial_lean(n) == alternating_factorial(n), n\n\n\ndef test_degree_bound_stage_has_no_violation():\n    import learning.sandwich as sw\n    frame = sw.degree_bound_check(60)\n    assert (frame.checked == frame.holds).all(), frame[frame.checked != frame.holds]\n    assert len(frame) == 16\n\n\ndef test_degree_bound_proved_names_are_theorems_in_the_lean_file():\n    \"\"\"Every name `learning.sandwich` audits for `Weights.lean` is declared there as a\n    theorem; the file has no `sorry` and no `axiom`; the root module imports it; and\n    `paper1/axiom_check.lean` prints the axioms of every one.\"\"\"\n    import learning.sandwich as sw\n    src = WEIGHTS_LEAN.read_text()\n    declared = set(re.findall(r\"^(?:@\\\\[simp\\\\] )?theorem\\\\s+([^\\\\s:({\\\\[]+)\", src, re.M))\n    missing = [n for n in sw.DEGREE_BOUND_PROVED if n.split(\".\")[-1] not in declared]\n    assert not missing, missing\n    assert all(n.startswith(\"DegreeBound.\") for n in sw.DEGREE_BOUND_PROVED)\n    assert set(sw.DEGREE_BOUND_PROVED) <= set(sw.ALL_PROVED)\n    code = re.sub(r\"/-.*?-/\", \"\", src, flags=re.S)\n    code = re.sub(r\"--.*\", \"\", code)\n    assert \"sorry\" not in code\n    assert not re.search(r\"^\\\\s*axiom\\\\b\", code, re.M)\n    root = (WEIGHTS_LEAN.parents[2] / \"MOSPFormalization.lean\").read_text()\n    assert \"import MOSPFormalization.DegreeBound.Weights\\\\n\" in root\n    axioms = (WEIGHTS_LEAN.parents[3] / \"paper1\" / \"axiom_check.lean\").read_text()\n    for n in sw.DEGREE_BOUND_PROVED:\n        assert f\"#print axioms MOSPFormalization.{n}\\\\n\" in axioms, n\n    for n in (\"g_recurrence\", \"g_monotone\", \"g'_antitone_of_three_le\", \"one_sub_g_eq\",\n              \"g_closed_form\", \"g_div_lt_g_div\"):\n        assert f\"DegreeBound.{n}\" in sw.DEGREE_BOUND_PROVED\n'''\ntt.write_text(u)\nprint(len(names), \"names\")\nEOF\ngrep -n \"^from learning.edwards_mcdermid import\" -A 12 tests/test_edwards_mcdermid.py | head -30","description":"Append axiom-check lines, add the sandwich stage and name list, append tests"}},"wire_ingest_context":{"toolu_018Y8XQSxGAdGtjaW3RRBJWn":{"cwd":"/home/al/dev/MOSP"}}}
