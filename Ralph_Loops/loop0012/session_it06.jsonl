List (V × Option V) → SimpleGraph V\n297:def IsContractionSeq : SimpleGraph V → List (V × Option V) → Prop\n302:def removed (seq : List (V × Option V)) : Finset V := (seq.map Prod.fst).toFinset\n306:def minorOf (G : SimpleGraph V) (seq : List (V × Option V)) :\n310:theorem pathwidth_applyStep_le (G : SimpleGraph V) (s : V × Option V) (hs : StepValid G s) :\n317:theorem pathwidth_applySeq_le (G : SimpleGraph V) (seq : List (V × Option V))\n325:theorem pathwidth_minorOf_le (G : SimpleGraph V) (seq : List (V × Option V))\n333:theorem pathwidth_le_of_le_minorOf (G : SimpleGraph V) (seq : List (V × Option V))\n338:/-- **The certificate theorem**: if the minor of a legal contraction sequence has\n341:theorem pathwidth_gt_of_minorOf (G : SimpleGraph V) (seq : List (V × Option V))\n346:/-- The certificate theorem for a minor given on its own vertex type (the code's\n348:theorem pathwidth_gt_of_iso_minorOf {W : Type*} [Fintype W] [DecidableEq W]\n365:theorem lt_mospValue_of_minorOf (seq : List (C × Option C))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QtEL1UhLsCPYmJBwKKTSXV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
