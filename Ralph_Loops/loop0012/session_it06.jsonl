{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012nR9YbffjaPSUrqmW8iihK","type":"tool_result","content":"theorem cases_tail : ReflTransGen r a b → b = a ∨ ∃ c, ReflTransGen r a c ∧ r c b :=\n  (cases_tail_iff r a b).1\n\n@[elab_as_elim]\ntheorem head_induction_on {motive : ∀ a : α, ReflTransGen r a b → Prop} {a : α}\n    (h : ReflTransGen r a b) (refl : motive b refl)\n    (head : ∀ {a c} (h' : r a c) (h : ReflTransGen r c b), motive c h → motive a (h.head h')) :\n    motive a h := by\n  induction h with\n  | refl => exact refl\n  | @tail b c _ hbc ih =>\n  apply ih\n  · exact head hbc _ refl\n  · exact fun h1 h2 ↦ head h1 (h2.tail hbc)\n\n@[elab_as_elim]\ntheorem trans_induction_on {motive : ∀ {a b : α}, ReflTransGen r a b → Prop} {a b : α}\n    (h : ReflTransGen r a b) (refl : ∀ a, @motive a a refl)\n    (single : ∀ {a b} (h : r a b), motive (single h))\n    (trans : ∀ {a b c} (h₁ : ReflTransGen r a b) (h₂ : ReflTransGen r b c), motive h₁ → motive h₂ →\n      motive (h₁.trans h₂)) : motive h := by\nnamespace ConnectedComponent\n\n/-- The set of vertices in a connected component of a graph. -/\ndef supp (C : G.ConnectedComponent) :=\n  { v | G.connectedComponentMk v = C }\n\n@[ext]\ntheorem supp_injective :\n    Function.Injective (ConnectedComponent.supp : G.ConnectedComponent → Set V) := by\n  refine ConnectedComponent.ind₂ ?_\n  simp only [ConnectedComponent.supp, Set.ext_iff, ConnectedComponent.eq, Set.mem_ofPred_eq]\n  intro v w h\n  rw [reachable_comm, h]\n\n@[simp]\ntheorem supp_inj {C D : G.ConnectedComponent} : C.supp = D.supp ↔ C = D :=\n  ConnectedComponent.supp_injective.eq_iff\n\ninstance : SetLike G.ConnectedComponent V where\n  coe := ConnectedComponent.supp\n  coe_injective := ConnectedComponent.supp_injective\n\n@[simp]\ntheorem mem_supp_iff (C : G.ConnectedComponent) (v : V) :\n    v ∈ C.supp ↔ G.connectedComponentMk v = C :=\n  Iff.rfl\n\nlemma mem_supp_congr_adj {v w : V} (c : G.ConnectedComponent) (hadj : G.Adj v w) :\n    v ∈ c.supp ↔ w ∈ c.supp := by\n  simp only [ConnectedComponent.mem_supp_iff] at *\n  constructor <;> intro h <;> simp only [← h] <;> apply connectedComponentMk_eq_of_adj\n\n/-- The graph with a single `s-t` edge. It is empty iff `s = t`. -/\ndef edge : SimpleGraph V := fromEdgeSet {s(s, t)}\n\n@[grind =]\nlemma edge_adj (v w : V) : (edge s t).Adj v w ↔ (v = s ∧ w = t ∨ v = t ∧ w = s) ∧ v ≠ w := by\n  rw [edge, fromEdgeSet_adj, Set.mem_singleton_iff, Sym2.eq_iff]\n\nlemma adj_edge {v w : V} : (edge s t).Adj v w ↔ s(s, t) = s(v, w) ∧ v ≠ w := by\n  grind\n\nlemma edge_comm : edge s t = edge t s := by\n  rw [edge, edge, Sym2.eq_swap]\n\n@[simp] lemma edge_le : edge s t ≤ G ↔ {s(s, t)} \\ Sym2.diagSet ⊆ G.edgeSet := by simp [edge]\n\nvariable [DecidableEq V] in\ninstance : DecidableRel (edge s t).Adj := fun _ _ ↦ by\n  rw [edge_adj]; infer_instance\n\n@[simp]\nlemma edge_self_eq_bot : edge s s = ⊥ := by\n  ext; rw [edge_adj]; simp_all\n\nlemma sup_edge_self : G ⊔ edge s s = G := by simp\n\n===IMPORTS\n67:import MOSPFormalization.DegreeBound.Weights\n68:import MOSPFormalization.DegreeBound.CutLemma\n69:import MOSPFormalization.DegreeBound.Potential\n===AXIOM\n#print axioms MOSPFormalization.DegreeBound.potentialMinus_le_potential\n#print axioms MOSPFormalization.DegreeBound.potentialMinus_eq_sum_compPotential\n#print axioms MOSPFormalization.DegreeBound.compPotential_nonneg\n#print axioms MOSPFormalization.DegreeBound.potentialMinus_nonneg\n#print axioms MOSPFormalization.DegreeBound.potentialMinus_eq_sum_vertexTerm\n#print axioms MOSPFormalization.DegreeBound.pos_degree_of_reachable_of_ne\n#print axioms MOSPFormalization.DegreeBound.eq_of_reachable_of_degree_eq_zero\n#print axioms MOSPFormalization.DegreeBound.compFinset_eq_singleton_of_degree_eq_zero\n#print axioms MOSPFormalization.DegreeBound.minDeg_eq_zero_of_degree_eq_zero\n#print axioms MOSPFormalization.DegreeBound.vertexTerm_eq_zero_of_degree_eq_zero\n#print axioms MOSPFormalization.DegreeBound.compFinset_s