// The equivalence chain of Table 1 (Linhares & Yanasse 2002), as proved in
// lean/MOSPFormalization/ (loop0005). Section 3 of the paper; see
// paper1/equivalences.md, "The chain".
//
//   dot -Tpdf paper1/figures/equivalence_chain.dot -o paper1/figures/equivalence_chain.pdf
//   dot -Tpng -Gdpi=150 paper1/figures/equivalence_chain.dot -o paper1/figures/equivalence_chain.png
//
// Edge styles: solid = exact identity, proved; dashed = inequality or band,
// proved; dotted = LaPaugh's es = pes (a named Prop, not proved; no row needs it);
// red = Table 1's claim is false (counterexample proved). Every label names the
// Lean theorem. Hypotheses in brackets.
graph chain {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.9, pad=0.2];
  node  [shape=box, style="rounded", fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=8];

  PW  [label="pw(G)\npathwidth\n[13]", style="rounded,bold,filled", fillcolor="#eeeeee"];
  VS  [label="vs(G)\nvertex separation\n[13]"];

  subgraph cluster_matrix {
    label="matrix problems (G = MOSP / net graph)"; fontname="Helvetica"; fontsize=9; style=dashed; color="#999999";
    Z   [label="Z(M)\nMOSP\n[1], [4]"];
    T   [label="t(M)\ngate matrix layout\n[6], [8]"];
    L   [label="tracks(A)\none-dimensional logic\n[7]"];
    MF  [label="multiple folding\n[6]"];
    PLA [label="simple PLA folding\n[6]", color="#b22222", fontcolor="#b22222"];
  }

  subgraph cluster_search {
    label="graph searching"; fontname="Helvetica"; fontsize=9; style=dashed; color="#999999";
    MNS [label="mns(G)\nmonotone node search"];
    NS  [label="ns(G)\nnode search\n[9], [10]"];
    PES [label="pes(G)\nprogressive edge search"];
    ES  [label="es(G)\nedge search\n[10]"];
  }

  TH  [label="θ(G)\ninterval thickness\n[5] not held; [6], [9]"];
  NU  [label="ν(G)\nnarrowness\n[11]"];
  SB  [label="sb(G)\nsplit bandwidth\n[12]"];
  VSG [label="VSG(G)\nLengauer's vertex game\n[14]"];
  CW  [label="cw(G), mcw(G)\n(modified) cutwidth\n[14], cited as edge separation", color="#b22222", fontcolor="#b22222"];

  // exact identities
  VS  -- PW  [label="vs = pw\nvertexSeparation_eq_pathwidth"];
  Z   -- PW  [label="Z = pw + 1  [M ≠ 0]\nmospValue_eq_pathwidth_add_one"];
  T   -- Z   [label="t = Z  [M ≠ 0]\ntracks_eq_mospValue"];
  L   -- TH  [label="tracks = θ(H)  [every net has a gate]\ntracks_eq_intervalThickness"];
  MF  -- T   [label="= t\nfoldTracks_eq_tracks"];
  TH  -- PW  [label="θ = pw + 1  [V ≠ ∅]\nintervalThickness_eq_pathwidth_add_one"];
  NU  -- PW  [label="ν = pw + 1  [V ≠ ∅]\nnarrowness_eq_pathwidth_add_one"];
  MNS -- VS  [label="mns = vs + 1  [≥ 1 edge]\nmonotoneNodeSearch_eq_vertexSeparation_add_one"];
  MNS -- TH  [label="mns = θ  [≥ 1 edge]\nmonotoneNodeSearch_eq_intervalThickness"];
  VSG -- VS  [label="VSG = max(1, vs)\nvsg_eq_max"];

  // inequalities and bands, proved
  SB  -- PW  [style=dashed, label="pw ≤ sb ≤ pw + 1\npathwidth_le_splitBandwidth_le_pathwidth_add_one"];
  PES -- VS  [style=dashed, label="vs ≤ pes ≤ vs + 2\nvertexSeparation_le_progressiveEdgeSearch_le_add_two"];
  ES  -- VS  [style=dashed, label="vs ≤ es ≤ vs + 2\nvertexSeparation_le_edgeSearch_le_add_two"];

  NS  -- MNS [label="ns = mns\nnodeSearchMonotonicity"];
  NS  -- VS  [label="ns = vs + 1  [≥ 1 edge]\nnodeSearch_eq_vertexSeparation_add_one"];

  // the remaining monotonicity half: a named Prop, not proved
  ES  -- PES [style=dotted, label="es = pes\nEdgeSearchMonotonicity (gap)"];

  // Table 1 claims that are false
  PLA -- T   [color="#b22222", fontcolor="#b22222", label="✗ gap unbounded, also connected\nplaTracks_idMatrix_unbounded,\nplaTracks_pathMatrix_unbounded"];
  CW  -- PW  [color="#b22222", fontcolor="#b22222", label="✗ unbounded on stars\ncutwidth_unbounded,\nmodCutwidth_unbounded"];
}
